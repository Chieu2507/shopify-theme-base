# Copy this file to shopify.theme.toml locally. Do not commit theme IDs or access credentials.

[environments.jovie]
store = "omnise-themes-omniselle"
theme = "YOUR_JOVIE_THEME_ID"
listing = "jovie"

[environments.noryvelle]
store = "noryvelle-fashion"
theme = "YOUR_NORYVELLE_THEME_ID"
listing = "noryvelle"
