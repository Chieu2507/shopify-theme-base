  {
    "name": "Cart",
    "settings": [
      {
        "type": "header",
        "content": "Cart behavior"
      },
      {
        "type": "select",
        "id": "cart_action",
        "label": "Cart opens as",
        "options": [
          { "value": "page", "label": "Page" },
          { "value": "drawer", "label": "Drawer" }
        ],
        "default": "drawer"
      },
      {
        "type": "color_scheme",
        "id": "cart_drawer_color_scheme",
        "label": "Color scheme",
        "default": "scheme-1",
        "visible_if": "{{ settings.cart_action == 'drawer' }}"
      },
      {
        "type": "range",
        "id": "cart_drawer_width",
        "label": "Desktop drawer width",
        "min": 360,
        "max": 600,
        "step": 10,
        "unit": "px",
        "default": 450,
        "visible_if": "{{ settings.cart_action == 'drawer' }}"
      },
      {
        "type": "checkbox",
        "id": "cart_auto_open",
        "label": "Open drawer after adding a product",
        "default": true,
        "visible_if": "{{ settings.cart_action == 'drawer' }}"
      },
      {
        "type": "header",
        "content": "Product display"
      },
      {
        "type": "select",
        "id": "cart_product_title_case",
        "label": "Product title case",
        "options": [
          { "value": "none", "label": "Original" },
          { "value": "uppercase", "label": "Uppercase" }
        ],
        "default": "none"
      },
      {
        "type": "select",
        "id": "cart_price_font",
        "label": "Price font",
        "options": [
          { "value": "body", "label": "Body" },
          { "value": "subheading", "label": "Utility / label" },
          { "value": "heading", "label": "Display / heading" },
          { "value": "accent", "label": "Accent / italic" }
        ],
        "default": "subheading"
      },
      {
        "type": "range",
        "id": "cart_image_radius",
        "label": "Product image corners",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "Drawer tools"
      },
      {
        "type": "checkbox",
        "id": "cart_drawer_show_note",
        "label": "Show order note",
        "default": true,
        "visible_if": "{{ settings.cart_action == 'drawer' }}"
      },
      {
        "type": "checkbox",
        "id": "cart_drawer_note_expanded",
        "label": "Keep order note expanded",
        "default": false,
        "visible_if": "{{ settings.cart_action == 'drawer' and settings.cart_drawer_show_note }}"
      },
      {
        "type": "checkbox",
        "id": "cart_drawer_show_discount",
        "label": "Show discount code field",
        "default": true,
        "visible_if": "{{ settings.cart_action == 'drawer' }}"
      },
      {
        "type": "checkbox",
        "id": "cart_show_accelerated_checkout",
        "label": "Show accelerated checkout buttons",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_drawer_show_recommendations",
        "label": "Show product suggestions",
        "default": true,
        "visible_if": "{{ settings.cart_action == 'drawer' }}"
      },
      {
        "type": "range",
        "id": "cart_drawer_recommendations_limit",
        "label": "Number of product suggestions",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 4,
        "visible_if": "{{ settings.cart_action == 'drawer' and settings.cart_drawer_show_recommendations }}"
      },
      {
        "type": "url",
        "id": "cart_drawer_empty_link",
        "label": "Empty cart shopping link",
        "default": "/collections/all",
        "visible_if": "{{ settings.cart_action == 'drawer' }}"
      }
    ]
  },
