{% doc %}
  Renders the product purchase controls.

  @param {product} product
  @param {variant} variant
  @param {block} block
  @param {form} form
  @param {string} form_id
{% enddoc %}
<div class="product-buy-buttons product-buy-buttons--{{ block.settings.button_layout | default: 'inline' }}{% unless block.settings.show_quantity %} product-buy-buttons--without-quantity{% endunless %}" {{ block.shopify_attributes }} data-product-buy-buttons>
  {% render 'selling-plan-picker', product: product %}
  {% render 'gift-card-recipient-form', product: product %}
  {% if block.settings.show_quantity != false %}{% render 'quantity-selector', variant: variant, block: block, form_id: form_id %}{% endif %}
  <button class="product-buy-buttons__add" type="submit" name="add" data-add-to-cart{% unless variant.available %} disabled{% endunless %}>
    <span data-add-to-cart-label data-add-to-cart-added-label="{{ 'product.added' | t | escape }}">{% if variant.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</span>
    <span class="product-buy-buttons__spinner" data-add-to-cart-spinner aria-hidden="true"></span>
  </button>
  {% if block.settings.show_dynamic_checkout != false %}
    {% unless product.gift_card? %}{{ form | payment_button }}{% endunless %}
  {% endif %}
  <p
    class="product-buy-buttons__inventory-warning"
    data-product-inventory-warning
    data-message-one="{{ 'product.inventory_warning_one' | t | escape }}"
    data-message-other="{{ 'product.inventory_warning_other' | t | escape }}"
    role="alert"
    aria-live="assertive"
    hidden
  ></p>
</div>
