{% doc %}
  Renders the four-point spark separator sourced from the Figma scrolling text component.

  @param {string} [class] - Optional class added to the SVG.
  @param {string} [title] - Optional accessible title. The icon is decorative when omitted.

  @example
  {% render 'spark-icon', class: 'marquee-media__image' %}
{% enddoc %}

<svg
  class="{{ class }}"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  {% if title != blank %}
    role="img"
    aria-label="{{ title | escape }}"
  {% else %}
    aria-hidden="true"
  {% endif %}
>
  <path
    d="M12 1C12.28 7.1 16.94 11.72 23 12C16.94 12.28 12.28 16.9 12 23C11.72 16.9 7.06 12.28 1 12C7.06 11.72 11.72 7.1 12 1Z"
    stroke="currentColor"
    stroke-width="1"
    stroke-linejoin="round"
  />
</svg>
