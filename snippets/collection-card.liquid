{% doc %}
  Renders a card from a collection resource and Collection card settings.

  @param {collection} [collection] - Collection resource supplied by the parent list
  @param {object} [card_block] - Collection Card Theme Block settings and editor attributes
  @param {string} [attributes] - Optional Theme Editor attributes override
{% enddoc %}
{% liquid
  assign image = collection.featured_image | default: collection.image
  assign scheme = card_block.settings.color_scheme | default: 'scheme-1'
  if card_block.settings.color_scheme.id != blank
    assign scheme = card_block.settings.color_scheme.id
  endif
  assign collection_card_editor_attributes = card_block.shopify_attributes
  if attributes != blank
    assign collection_card_editor_attributes = attributes
  endif
%}
<article class="collection-card-kernel{% if card_block.settings.color_type == 'color_scheme' %} color-scheme section-color-scope {{ scheme }}{% endif %} collection-card-kernel--{{ card_block.settings.placement | default: 'below_image' }} collection-card-kernel--{{ card_block.settings.ratio | default: 'original' }}" style="--card-border:{{ card_block.settings.border_thickness | default: 0 }}px;--card-align:{{ card_block.settings.alignment | default: 'left' }};--card-padding-top:{{ card_block.settings.padding_top | default: 16 }}px;--card-padding-bottom:{{ card_block.settings.padding_bottom | default: 0 }}px;"{% if collection_card_editor_attributes != blank %} {{ collection_card_editor_attributes }}{% endif %}>
  <a class="collection-card-kernel__link" href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}"><div class="collection-card-kernel__media{% if image == blank %} placeholder-image{% endif %}">{% if image != blank %}{{ image | image_url: width: 1200 | image_tag: alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</div><div class="collection-card-kernel__content"><h3>{{ collection.title | default: 'collection_list.default_title' | t | escape }}</h3></div></a>
</article>
{% stylesheet %}.collection-card-kernel{overflow:hidden;border:var(--card-border) solid var(--border-color);border-radius:var(--card-radius);background:var(--background-color)}.collection-card-kernel__link{display:block;height:100%;color:inherit;text-decoration:none}.collection-card-kernel__media{overflow:hidden}.collection-card-kernel--square .collection-card-kernel__media{aspect-ratio:1}.collection-card-kernel--portrait .collection-card-kernel__media{aspect-ratio:2/3}.collection-card-kernel__media img,.collection-card-kernel__media svg{display:block;width:100%;height:100%;object-fit:cover}.collection-card-kernel__content{padding:var(--card-padding-top) 0 var(--card-padding-bottom);text-align:var(--card-align)}.collection-card-kernel__content h3{margin:0}.collection-card-kernel--on_image{position:relative}.collection-card-kernel--on_image .collection-card-kernel__content{position:absolute;inset:auto 0 0;padding:1.6rem;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.65))}{% endstylesheet %}
