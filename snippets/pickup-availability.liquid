{% if variant.store_availabilities.size > 0 %}
  <section class="product-pickup-availability__content" aria-label="Pickup availability">
    <h3 class="product-pickup-availability__heading">Pickup available</h3>
    <ul role="list">
      {% for availability in variant.store_availabilities %}
        <li>
          <strong>{{ availability.location.name | escape }}</strong>
          <span>{% if availability.available %}Ready for pickup{% else %}Unavailable{% endif %}</span>
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
