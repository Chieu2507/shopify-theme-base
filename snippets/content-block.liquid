{% doc %}
  Renders the shared Heading and Text theme-block UI with size-based typography,
  responsive layout and spacing.

  @param {object} block - The theme block object.
  @param {string} content - Rich text to render.
  @param {string} kind - Either "heading", "text", or "label".
  @param {string} default_preset - Fallback typography preset.
  @param {string} default_font - Font role used by custom typography.
  @param {string} [force_preset] - Optional typography preset that overrides saved block settings.
  @param {boolean} [include_shopify_attributes] - Whether to attach editor attributes to the rendered typography block.

  @example
  {% render 'content-block',
    block: block,
    content: block.settings.text,
    kind: 'text',
    default_preset: 'md',
    default_font: 'body'
  %}
{% enddoc %}

{% liquid
  assign preset = block.settings.type_preset | default: default_preset
  if force_preset != blank
    assign preset = force_preset
  endif

  assign typography_class = ''
  assign use_inline_typography = false
  if kind == 'heading'
    case preset
      when 'h0', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'h7'
        assign typography_class = 'heading-' | append: preset | append: ' heading-text'
      when 'subheading'
        assign typography_class = 'subheading-text'
      when 'custom'
        assign typography_class = 'heading-custom heading-text'
        assign use_inline_typography = true
    endcase
  elsif kind == 'text' or kind == 'label'
    case preset
      when 'lg'
        assign typography_class = 'body-p0 body-text'
      when 'md', 'paragraph'
        assign typography_class = 'body-p1 body-text'
      when 'sm'
        assign typography_class = 'body-p2 body-text'
      when 'xs'
        assign typography_class = 'body-p3 body-text'
      when 'label'
        assign typography_class = 'label-text'
      when 'subheading'
        assign typography_class = 'subheading-text'
      when 'custom'
        assign typography_class = 'body-custom body-text'
        assign use_inline_typography = true
    endcase
  endif

  assign font_role = block.settings.font | default: default_font
  assign font_family = 'var(--font-body--family)'
  assign font_style = 'var(--font-body--style)'
  assign font_weight = 'var(--font-body--weight)'
  assign font_size = 'var(--font-body-base)'
  assign font_size_mobile = 'var(--font-body-base)'
  assign line_height = 'var(--body-line-height)'
  assign letter_spacing = 'var(--body-letter-spacing)'
  assign text_case = 'none'
  assign heading_tag = block.settings.heading_tag | default: 'h2'

  if preset == 'custom'
    if font_role == 'heading'
      assign font_family = 'var(--font-heading--family)'
      assign font_style = 'var(--font-heading--style)'
      assign font_weight = 'var(--font-heading--weight)'
    else
      assign font_family = 'var(--font-body--family)'
      assign font_style = 'var(--font-body--style)'
      assign font_weight = 'var(--font-body--weight)'
    endif

    if block.settings.font_weight != blank
      if block.settings.font_weight != 'inherit'
        assign font_weight = block.settings.font_weight
      endif
    endif

    assign font_size = block.settings.font_size | default: 15 | append: 'px'
    assign font_size_mobile = block.settings.font_size_mobile | default: 15 | append: 'px'
    assign custom_line_height = block.settings.line_height | default: 'normal'
    assign line_height = 'var(--leading-' | append: custom_line_height | append: ')'
  endif

  assign width = block.settings.width | default: 'fit-content'
  assign width_mobile = block.settings.width_mobile | default: width
  assign width_class = 'fit'
  if width == '100%'
    assign width_class = 'fill'
  endif
  assign width_mobile_class = 'fit'
  if width_mobile == '100%'
    assign width_mobile_class = 'fill'
  endif

  assign color_class = 'heading'
  if block.settings.color == 'subtext'
    assign color_class = 'text'
  endif

  assign alignment = block.settings.alignment | default: 'left'
  assign padding_block_start = block.settings['padding-block-start']
  assign padding_block_end = block.settings['padding-block-end']
  assign padding_inline_start = block.settings['padding-inline-start']
  assign padding_inline_end = block.settings['padding-inline-end']
  assign has_spacing_settings = false
  if padding_block_start != blank or padding_block_end != blank or padding_inline_start != blank or padding_inline_end != blank
    assign has_spacing_settings = true
  endif
  assign padding_top = block.settings.padding_top | default: 0
  assign padding_bottom = block.settings.padding_bottom | default: 0
  assign padding_left = block.settings.padding_left | default: 0
  assign padding_right = block.settings.padding_right | default: 0
  assign mobile_scale = block.settings.mobile_scale | default: 100
  assign padding_scale = block.settings.mobile_scale | default: 100 | divided_by: 100.0
  assign padding_top_mobile = padding_top | times: padding_scale
  assign padding_bottom_mobile = padding_bottom | times: padding_scale
  assign padding_left_mobile = padding_left | times: padding_scale
  assign padding_right_mobile = padding_right | times: padding_scale

  assign has_padding = false
  if padding_top != 0 or padding_bottom != 0 or padding_left != 0 or padding_right != 0
    assign has_padding = true
  endif

  assign has_mobile_padding = false
  if has_padding and mobile_scale != 100
    assign has_mobile_padding = true
  endif

  assign has_mobile_font_size = false
  if use_inline_typography and font_size_mobile != font_size
    assign has_mobile_font_size = true
  endif

  assign responsive_scope = block.id | default: kind
  if kind == 'heading' and typography_class != blank
    capture rendered_content
      render 'typography-content', content: content, heading_class: typography_class
    endcapture
  else
    assign rendered_content = content
  endif
  if block.settings.disable_line_break_mobile
    assign line_break_markup = '<span class="content-block__line-break"><br></span>'
    assign rendered_content = rendered_content | replace: '<br>', line_break_markup
    assign rendered_content = rendered_content | replace: '<br/>', line_break_markup
    assign rendered_content = rendered_content | replace: '<br />', line_break_markup
  endif

  assign has_block_markup = false
  if content contains '<p' or content contains '<h1' or content contains '<h2' or content contains '<h3'
    assign has_block_markup = true
  elsif content contains '<h4' or content contains '<h5' or content contains '<h6'
    assign has_block_markup = true
  elsif content contains '<ul' or content contains '<ol' or content contains '<blockquote'
    assign has_block_markup = true
  endif
  assign needs_heading_wrapper = false
  if kind == 'heading' and has_block_markup == false
    assign needs_heading_wrapper = true
  endif
%}

{% if content != blank %}
  {% if has_mobile_padding or has_mobile_font_size %}
    <style>
      @media screen and (max-width: 749px) {
        [data-type-block-id="{{ responsive_scope | escape }}"] {
          {% if has_mobile_padding %}
            padding: {{ padding_top_mobile }}px {{ padding_right_mobile }}px {{ padding_bottom_mobile }}px {{ padding_left_mobile }}px !important;
          {% endif %}
          {% if has_mobile_font_size %}
            font-size: {{ font_size_mobile }} !important;
          {% endif %}
        }
      }
    </style>
  {% endif %}
  <div
    class="content-block spacing-style content-block--{{ kind }} content-block--preset-{{ preset }} content-block--width-{{ width_class }} content-block--width-mobile-{{ width_mobile_class }} content-block--color-{{ color_class }}{% if kind == 'heading' %} content-heading content-heading--{{ alignment }}{% else %} text-block content-text content-text--{{ alignment }} rte{% endif %}{% if typography_class != blank %} {{ typography_class }}{% endif %}{% if use_inline_typography %} content-block--inline-typography{% endif %}{% if block.settings.disable_line_break_mobile %} content-block--disable-mobile-breaks{% endif %}"
    {% if has_mobile_padding or has_mobile_font_size %}data-type-block-id="{{ responsive_scope | escape }}"{% endif %}
    {% if has_spacing_settings or has_padding or use_inline_typography %}
      style="
        {% if has_spacing_settings %}
          {% render 'spacing-style', settings: block.settings %}
        {% endif %}
        {% if has_padding %}
          padding: {{ padding_top }}px {{ padding_right }}px {{ padding_bottom }}px {{ padding_left }}px;
        {% endif %}
        {% if use_inline_typography %}
          font-family: {{ font_family }};
          font-style: {{ font_style }};
          font-weight: {{ font_weight }};
          font-size: {{ font_size }};
          line-height: {{ line_height }};
          letter-spacing: {{ letter_spacing }};
          text-transform: {{ text_case }};
        {% endif %}
      "
    {% endif %}
    {% if include_shopify_attributes != false %}{{ block.shopify_attributes }}{% endif %}
  >
    {% if kind == 'heading' %}
      {% if needs_heading_wrapper %}
        <{{ heading_tag }} class="{{ typography_class }}">{{ rendered_content }}</{{ heading_tag }}>
      {% else %}
        {{ rendered_content }}
      {% endif %}
    {% else %}
      {{ rendered_content }}
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .content-block {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: 0;
    color: var(--color-heading);
    text-wrap: pretty;
  }

  .content-block.content-block--width-fit {
    width: fit-content;
  }

  .content-block.content-block--width-fill {
    width: 100%;
  }

  .content-block.content-block--color-text {
    color: var(--color-text);
  }

  .content-block--inline-typography {
    font-synthesis: weight;
  }

  .content-block--inline-typography
    :is(p, h1, h2, h3, h4, h5, h6) {
    font-family: inherit !important;
    font-size: inherit !important;
    font-style: inherit !important;
    font-weight: inherit !important;
    letter-spacing: inherit !important;
    line-height: inherit !important;
    text-transform: inherit !important;
  }

  .content-block > :first-child {
    margin-block-start: 0;
  }

  .content-block > :last-child {
    margin-block-end: 0;
  }

  @media screen and (max-width: 749px) {
    .content-block.content-block--width-mobile-fit {
      width: fit-content;
    }

    .content-block.content-block--width-mobile-fill {
      width: 100%;
    }

    .content-block--disable-mobile-breaks .content-block__line-break br {
      display: none;
    }

    .content-block--disable-mobile-breaks .content-block__line-break::after {
      content: ' ';
    }
  }

{% endstylesheet %}
