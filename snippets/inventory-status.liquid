{% if variant != blank %}
  <p class="product-inventory" data-inventory-status {{ block.shopify_attributes }}>
    {% if variant.available %}
      <span class="product-inventory__dot" aria-hidden="true"></span>
      {% if variant.inventory_management and variant.inventory_quantity > 0 and variant.inventory_quantity <= 10 %}
        <span data-inventory-message>Only {{ variant.inventory_quantity }} left</span>
      {% else %}
        <span data-inventory-message>In stock</span>
      {% endif %}
    {% else %}
      <span data-inventory-message>Sold out</span>
    {% endif %}
  </p>
{% endif %}
