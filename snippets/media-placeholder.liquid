{% doc %}
  Renders a lightweight decorative Shopify placeholder SVG.

  @param {string} class_name - CSS class applied to the placeholder.
  @param {string} [placeholder_name] - Accepted for backwards compatibility; all placeholders use the shared outline illustration.
  @param {string} [asset_name] - Accepted legacy asset filename; all placeholders use the shared outline illustration.
  @example
  {% render 'media-placeholder', class_name: 'product-card__placeholder' %}
{% enddoc %}

{% liquid
  assign media_placeholder_legacy_value = placeholder_name | default: asset_name
%}

{{ 'image' | placeholder_svg_tag: class_name }}
