{% doc %}
  Renders a lightweight decorative Shopify placeholder SVG.

  @param {string} class_name - CSS class applied to the placeholder.
  @param {string} [placeholder_name] - Accepted for backwards compatibility. Placeholders are rendered with the shared outline illustration.
  @param {string} [asset_name] - Deprecated legacy asset filename. It is accepted for backwards compatibility.

  @example
  {% render 'media-placeholder', class_name: 'product-card__placeholder', placeholder_name: 'product-1' %}
{% enddoc %}

