{% doc %}
  Renders a semantic Shopify outline illustration for missing media.

  @param {string} class_name - CSS class applied to the placeholder.
  @param {string} [placeholder_name] - Shopify placeholder type: image, product, collection, video, or lifestyle.
  @param {string} [asset_name] - Legacy filename mapped to a semantic Shopify placeholder type.
  @example
  {% render 'media-placeholder', class_name: 'product-card__placeholder' %}
{% enddoc %}

{% liquid
  assign media_placeholder_name = placeholder_name | default: 'image'

  if asset_name contains 'product-'
    assign media_placeholder_name = asset_name | remove: 'placeholder-image-' | remove: '.svg'
  elsif asset_name contains 'collection-'
    assign media_placeholder_name = asset_name | remove: 'placeholder-image-' | remove: '.svg'
  elsif placeholder_name == 'collection'
    assign media_placeholder_name = 'collection-1'
  elsif asset_name contains 'video' or placeholder_name == 'video'
    assign media_placeholder_name = 'image'
  elsif asset_name contains 'default-4' or asset_name contains 'default-5'
    assign media_placeholder_name = 'lifestyle-2'
  elsif asset_name contains 'default'
    assign media_placeholder_name = 'image'
  endif
%}

{{ media_placeholder_name | placeholder_svg_tag: class_name }}
