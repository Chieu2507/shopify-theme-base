{% doc %}
  Native GET search filters and sorting, usable without JavaScript.
  Shopify search owns available facets, sort options and matching counts.
  @param {object} search - Current search resource
  @param {object} section - Search section settings and unique ID
  @param {string} search_types - Requested resource types, joined by commas
  @param {string} sort_by - Current sort order
{% enddoc %}
{% liquid
  assign has_filters = false
  if section.settings.enable_filtering and search.filters.size > 0
    assign has_filters = true
  endif
  assign encoded_terms = search.terms | url_encode
  assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last'
  if search_types != blank
    assign clear_url = clear_url | append: '&type=' | append: search_types
  endif
  assign sort_id = 'SearchSort-' | append: section.id
  assign sort_label = 'collection.sort_by' | t | remove: ':' | strip
  assign active_filter_count = 0
  for filter in search.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
%}
{% if has_filters or section.settings.enable_sorting or active_filter_count > 0 %}
<div class="search-page__toolbar">
  <form action="{{ routes.search_url }}" method="get" class="search-page__filter-form">
    <input type="hidden" name="q" value="{{ search.terms | escape }}">
    <input type="hidden" name="options[prefix]" value="last">
    {% if search_types != blank %}<input type="hidden" name="type" value="{{ search_types | escape }}">{% endif %}
    {% if section.settings.enable_sorting %}
      {% render 'form-field', id: sort_id, name: 'sort_by', label: sort_label, control: 'select', options: search.sort_options, selected: sort_by %}
    {% else %}
      <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">
    {% endif %}
    {% if has_filters %}
    <details class="search-page__filters">
      <summary class="body-text body-md">{{ 'collection.filters' | t }}{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}</summary>
      <div class="search-page__filter-groups">
        {% for filter in search.filters %}
          <fieldset class="search-page__filter-group">
            <legend class="body-text body-md">{{ filter.label | escape }}</legend>
            {% case filter.type %}
              {% when 'boolean', 'list' %}
                <div class="search-page__filter-values">
                  {% for value in filter.values %}
                    <label class="search-page__filter-value body-text body-sm">
                      <input type="checkbox" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}"{% if value.active %} checked{% elsif value.count == 0 %} disabled{% endif %}>
                      <span>{{ value.label | escape }} ({{ value.count }})</span>
                    </label>
                  {% endfor %}
                </div>
              {% when 'price_range' %}
                {% liquid
                  assign min_id = 'SearchMin-' | append: section.id | append: '-' | append: forloop.index
                  assign max_id = 'SearchMax-' | append: section.id | append: '-' | append: forloop.index
                  assign min_label = 'collection.price_from' | t
                  assign max_label = 'collection.price_to' | t
                  assign min_value = filter.min_value.value | money_without_currency | replace: ',', ''
                  assign max_value = filter.max_value.value | money_without_currency | replace: ',', ''
                  if filter.min_value.value == nil
                    assign min_value = ''
                  endif
                  if filter.max_value.value == nil
                    assign max_value = ''
                  endif
                %}
                {% render 'form-field', id: min_id, name: filter.min_value.param_name, label: min_label, value: min_value, inputmode: 'decimal' %}
                {% render 'form-field', id: max_id, name: filter.max_value.param_name, label: max_label, value: max_value, inputmode: 'decimal' %}
            {% endcase %}
          </fieldset>
        {% endfor %}
      </div>
    </details>
    {% else %}
      {% for filter in search.filters %}
        {% for value in filter.active_values %}<input type="hidden" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}">{% endfor %}
        {% if filter.min_value.value != nil %}<input type="hidden" name="{{ filter.min_value.param_name | escape }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">{% endif %}
        {% if filter.max_value.value != nil %}<input type="hidden" name="{{ filter.max_value.param_name | escape }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">{% endif %}
      {% endfor %}
    {% endif %}
    {% if has_filters %}{% assign apply_label = 'collection.apply_filters' | t: count: search.results_count %}{% else %}{% assign apply_label = 'collection.apply_sort' | t %}{% endif %}
    {% if has_filters or section.settings.enable_sorting %}{% render 'theme-button', label: apply_label, type: 'submit', variant: 'secondary' %}{% endif %}
  </form>
  {% if active_filter_count > 0 %}
    <div class="search-page__active-filters body-text body-sm">
      {% for filter in search.filters %}
        {% for value in filter.active_values %}<a href="{{ value.url_to_remove | escape }}">{{ filter.label | escape }}: {{ value.label | escape }} <span aria-hidden="true">×</span></a>{% endfor %}
        {% if filter.min_value.value != nil or filter.max_value.value != nil %}<a href="{{ filter.url_to_remove | escape }}">{{ filter.label | escape }} <span aria-hidden="true">×</span></a>{% endif %}
      {% endfor %}
      <a href="{{ clear_url | escape }}">{{ 'collection.clear_all' | t }}</a>
    </div>
  {% endif %}
</div>
{% endif %}
