{% doc %}
  Renders a theme button or link using the global Button settings.

  The snippet controls visual treatment only. The caller remains responsible for
  choosing the correct semantic element and for supplying an accessible label.

  @param {string} label - Visible button label
  @param {string} [url] - Link destination. Omit for a button element
  @param {string} [type] - Button type when url is omitted
  @param {string} [class] - Additional classes
  @param {boolean} [disabled] - Whether the button is disabled
  @param {boolean} [loading] - Whether the button is busy while preserving its width
  @param {string} [variant] - Optional visual variant: primary, secondary, or tertiary
  @param {string} [icon] - Optional inline Heroicons key or legacy alias: arrow-right/arrow or shopping-bag/cart
  @param {string} [icon_position] - Icon position: before or after
  @param {string} [icon_size] - Icon size: inherit or custom
  @param {number} [icon_width] - Custom icon width in pixels
  @param {boolean} [icon_only] - Hide the visible label when the icon is the control
  @param {boolean} [open_in_new_tab] - Whether links should open in a new tab

  @example
  {% render 'theme-button', label: 'Shop now', url: routes.all_products_collection_url %}
  {% render 'theme-button', label: 'Add to cart', type: 'submit' %}
{% enddoc %}

{% liquid
  assign button_variant = variant | default: 'primary'
  case button_variant
    when 'solid'
      assign button_variant = 'primary'
    when 'outline'
      assign button_variant = 'secondary'
    when 'text'
      assign button_variant = 'tertiary'
  endcase
  unless button_variant == 'primary' or button_variant == 'secondary' or button_variant == 'tertiary'
    assign button_variant = 'primary'
  endunless

  assign button_icon_position = icon_position | default: 'after'
  unless button_icon_position == 'before' or button_icon_position == 'after'
    assign button_icon_position = 'after'
  endunless

  assign button_icon_size = icon_size | default: 'inherit'
  unless button_icon_size == 'inherit' or button_icon_size == 'custom'
    assign button_icon_size = 'inherit'
  endunless

  assign button_icon_width = icon_width | default: 20 | plus: 0
  if button_icon_width < 12 or button_icon_width > 32
    assign button_icon_width = 20
  endif

  assign button_icon_name = icon
  unless button_icon_name == blank or button_icon_name == 'arrow' or button_icon_name == 'arrow-right' or button_icon_name == 'cart' or button_icon_name == 'shopping-bag'
    assign button_icon_name = blank
  endunless

  assign button_class = 'btn btn-' | append: button_variant | append: ' btn--' | append: button_variant
  if loading
    assign button_class = button_class | append: ' btn--loading'
  endif
  if class != blank
    assign button_class = button_class | append: ' ' | append: class
  endif

%}

{% capture button_icon_markup %}
  {% if button_icon_name == 'arrow' or button_icon_name == 'arrow-right' %}
    <span
      class="btn__icon{% if button_icon_size == 'custom' %} btn__icon--custom{% endif %}"
      {% if button_icon_size == 'custom' %}style="--button-icon-width: {{ button_icon_width }}px;"{% endif %}
      aria-hidden="true"
    >
      {% render 'icon', icon: 'arrow-right', bare: true %}
    </span>
  {% elsif button_icon_name == 'cart' or button_icon_name == 'shopping-bag' %}
    <span
      class="btn__icon{% if button_icon_size == 'custom' %} btn__icon--custom{% endif %}"
      {% if button_icon_size == 'custom' %}style="--button-icon-width: {{ button_icon_width }}px;"{% endif %}
      aria-hidden="true"
    >
      {% render 'icon', icon: 'shopping-bag', bare: true %}
    </span>
  {% endif %}
{% endcapture %}

{% capture button_content %}
  <span class="btn__label{% if button_icon_name != blank %} btn__label--icon{% endif %}">
    {% if button_icon_name != blank and button_icon_position == 'before' %}{{ button_icon_markup }}{% endif %}
    <span class="btn__text{% if icon_only %} visually-hidden{% endif %}">{{ label | escape }}</span>
    {% if button_icon_name != blank and button_icon_position == 'after' %}{{ button_icon_markup }}{% endif %}
  </span>
{% endcapture %}

{% if url != blank %}
  <a
    class="{{ button_class | strip }}"
    href="{{ url }}"
    {% if loading %}aria-busy="true"{% endif %}
    {% if open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
    {% if disabled %}aria-disabled="true" tabindex="-1"{% endif %}
  >
    {{ button_content }}
    {% if loading %}
      <span class="btn__spinner" aria-hidden="true"></span>
      <span class="visually-hidden">{{ 'accessibility.loading' | t }}</span>
    {% endif %}
  </a>
{% else %}
  <button
    class="{{ button_class | strip }}"
    type="{{ type | default: 'button' }}"
    {% if disabled or loading %}disabled{% endif %}
    {% if loading %}aria-busy="true"{% endif %}
  >
    {{ button_content }}
    {% if loading %}
      <span class="btn__spinner" aria-hidden="true"></span>
      <span class="visually-hidden">{{ 'accessibility.loading' | t }}</span>
    {% endif %}
  </button>
{% endif %}
