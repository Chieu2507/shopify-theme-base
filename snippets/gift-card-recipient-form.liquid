{% doc %}
  Renders the Shopify gift card recipient properties for gift card products.

  @param {product} product
{% enddoc %}
{% if product.gift_card? %}
  <details class="gift-card-recipient-form">
    <summary>{{ 'gift_card.recipient_toggle' | t }}</summary>
    <div class="gift-card-recipient-form__fields">
      <label class="gift-card-recipient-form__toggle">
        <input type="checkbox" name="properties[__shopify_send_gift_card_to_recipient]" value="if_present">
        <span>{{ 'gift_card.recipient_toggle' | t }}</span>
      </label>
      <label>
        <span>{{ 'gift_card.recipient_email' | t }}</span>
        <input type="email" name="properties[Recipient email]" autocomplete="email">
      </label>
      <label>
        <span>{{ 'gift_card.recipient_name' | t }}</span>
        <input type="text" name="properties[Recipient name]" autocomplete="name">
      </label>
      <label>
        <span>{{ 'gift_card.recipient_message' | t }}</span>
        <textarea name="properties[Message]" rows="3" maxlength="200"></textarea>
      </label>
      <label>
        <span>{{ 'gift_card.recipient_send_on' | t }}</span>
        <input type="date" name="properties[Send on]">
      </label>
    </div>
  </details>
{% endif %}
