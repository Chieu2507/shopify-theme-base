{% liquid
  assign default_color_scheme = settings.color_schemes | first

  assign card_radius = 0
  if settings.media_card_radius_style == 'rounded'
    assign card_radius = 8
  endif

  assign button_radius = 0
  if settings.button_radius_style == 'rounded'
    assign button_radius = 6
  elsif settings.button_radius_style == 'pill'
    assign button_radius = 9999
  endif

  assign badge_radius = 0
  if settings.badge_radius_style == 'rounded'
    assign badge_radius = 4
  elsif settings.badge_radius_style == 'pill'
    assign badge_radius = 9999
  endif

  assign form_radius = 0
  if settings.form_radius_style == 'rounded'
    assign form_radius = settings.input_corner_radius | at_least: 4
  elsif settings.form_radius_style == 'pill'
    assign form_radius = 9999
  endif

  assign variant_picker_radius = 0
  if settings.variant_picker_radius_style == 'rounded'
    assign variant_picker_radius = settings.variant_picker_corner_radius | default: 6 | at_least: 4
  elsif settings.variant_picker_radius_style == 'pill'
    assign variant_picker_radius = 9999
  endif

  assign primary_button_font_family = 'var(--font-body--family)'
  assign primary_button_font_style = 'var(--font-body--style)'
  assign primary_button_font_weight = 'var(--font-body--weight)'
  if settings.primary_button_font == 'heading'
    assign primary_button_font_family = 'var(--font-heading--family)'
    assign primary_button_font_style = 'var(--font-heading--style)'
    assign primary_button_font_weight = 'var(--font-heading--weight)'
  endif

  assign secondary_button_font_family = 'var(--font-body--family)'
  assign secondary_button_font_style = 'var(--font-body--style)'
  assign secondary_button_font_weight = 'var(--font-body--weight)'
  if settings.secondary_button_font == 'heading'
    assign secondary_button_font_family = 'var(--font-heading--family)'
    assign secondary_button_font_style = 'var(--font-heading--style)'
    assign secondary_button_font_weight = 'var(--font-heading--weight)'
  endif

  assign tertiary_button_font_family = 'var(--font-body--family)'
  assign tertiary_button_font_style = 'var(--font-body--style)'
  assign tertiary_button_font_weight = 'var(--font-body--weight)'
  if settings.tertiary_button_font == 'heading'
    assign tertiary_button_font_family = 'var(--font-heading--family)'
    assign tertiary_button_font_style = 'var(--font-heading--style)'
    assign tertiary_button_font_weight = 'var(--font-heading--weight)'
  endif

  assign h1_text_case = 'none'
  if settings.h1_case_choice == 'uppercase'
    assign h1_text_case = 'uppercase'
  endif
  assign h2_text_case = 'none'
  if settings.h2_case_choice == 'uppercase'
    assign h2_text_case = 'uppercase'
  endif
  assign h3_text_case = 'none'
  if settings.h3_case_choice == 'uppercase'
    assign h3_text_case = 'uppercase'
  endif
  assign h4_text_case = 'none'
  if settings.h4_case_choice == 'uppercase'
    assign h4_text_case = 'uppercase'
  endif
  assign h5_text_case = 'none'
  if settings.h5_case_choice == 'uppercase'
    assign h5_text_case = 'uppercase'
  endif
  assign h6_text_case = 'none'
  if settings.h6_case_choice == 'uppercase'
    assign h6_text_case = 'uppercase'
  endif
  assign subheading_text_case = 'none'
  if settings.subheading_case_choice == 'uppercase'
    assign subheading_text_case = 'uppercase'
  endif

%}

{% style %}
  {{ settings.body_font | font_face: font_display: 'swap' }}
  {{ settings.body_font | font_modify: 'weight', '500' | font_face: font_display: 'swap' }}
  {{ settings.body_font | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}
  {{ settings.body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.subheading_font | font_face: font_display: 'swap' }}
  {{ settings.heading_font | font_face: font_display: 'swap' }}
  {{ settings.accent_font | font_face: font_display: 'swap' }}
  {{ settings.accent_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    /* Spinel type tokens exported from the Desktop and Mobile Figma modes. */
    --spinel-type-family-display: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    --spinel-type-family-body: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
    --spinel-type-family-accent: {{ settings.accent_font.family }}, {{ settings.accent_font.fallback_families }};
    --spinel-type-style-display: {{ settings.heading_font.style }};
    --spinel-type-style-body-regular: {{ settings.body_font.style }};
    --spinel-type-style-body-medium: normal;
    --spinel-type-style-body-semibold: normal;
    --spinel-type-style-body-italic: italic;
    --spinel-type-style-accent-italic: italic;

    --spinel-type-size-display-xl: 72px;
    --spinel-type-size-display-lg: 60px;
    --spinel-type-size-display-md: 48px;
    --spinel-type-size-heading-xl: 44px;
    --spinel-type-size-heading-lg: 36px;
    --spinel-type-size-heading-md: 32px;
    --spinel-type-size-heading-sm: 28px;
    --spinel-type-size-heading-xs: 22px;
    --spinel-type-size-body-lg: 18px;
    --spinel-type-size-body-md: 16px;
    --spinel-type-size-body-sm: 14px;
    --spinel-type-size-body-xs: 12px;
    --spinel-type-size-label: 10px;
    --spinel-type-size-action: 12px;
    --spinel-type-size-price-lg: 24px;
    --spinel-type-size-price-md: 18px;
    --spinel-type-size-wordmark: 48px;
    --spinel-type-size-product-title: 18px;

    --spinel-type-line-display-xl: 76px;
    --spinel-type-line-display-lg: 64px;
    --spinel-type-line-display-md: 52px;
    --spinel-type-line-heading-xl: 48px;
    --spinel-type-line-heading-lg: 42px;
    --spinel-type-line-heading-md: 38px;
    --spinel-type-line-heading-sm: 34px;
    --spinel-type-line-heading-xs: 28px;
    --spinel-type-line-body-lg: 28px;
    --spinel-type-line-body-md: 24px;
    --spinel-type-line-body-sm: 20px;
    --spinel-type-line-body-xs: 16px;
    --spinel-type-line-label: 14px;
    --spinel-type-line-action: 16px;
    --spinel-type-line-price-lg: 28px;
    --spinel-type-line-price-md: 22px;
    --spinel-type-line-wordmark: 48px;
    --spinel-type-line-product-title: 24px;

    --spinel-type-tracking-display: -0.8px;
    --spinel-type-tracking-heading: -0.2px;
    --spinel-type-tracking-body: 0px;
    --spinel-type-tracking-label: 1.1px;
    --spinel-type-tracking-action: 0.8px;
    --spinel-type-tracking-wordmark: 2px;

    --font-body--family: var(--spinel-type-family-body);
    --font-body--style: var(--spinel-type-style-body-regular);
    --font-body--weight: {{ settings.body_font.weight }};
    --font-subheading--family: {{ settings.subheading_font.family }}, {{ settings.subheading_font.fallback_families }};
    --font-subheading--style: {{ settings.subheading_font.style }};
    --font-subheading--weight: {{ settings.subheading_font.weight }};
    --font-heading--family: var(--spinel-type-family-display);
    --font-heading--style: var(--spinel-type-style-display);
    --font-heading--weight: {{ settings.heading_font.weight }};
    --font-accent--family: var(--spinel-type-family-accent);
    --font-accent--style: italic;
    --font-accent--weight: {{ settings.accent_font.weight }};
    --font-h1--family: var(--font-{{ settings.h1_font }}--family);
    --font-h1--style: var(--font-{{ settings.h1_font }}--style);
    --font-h1--weight: var(--font-{{ settings.h1_font }}--weight);
    --font-h2--family: var(--font-{{ settings.h2_font }}--family);
    --font-h2--style: var(--font-{{ settings.h2_font }}--style);
    --font-h2--weight: var(--font-{{ settings.h2_font }}--weight);
    --font-h3--family: var(--font-{{ settings.h3_font }}--family);
    --font-h3--style: var(--font-{{ settings.h3_font }}--style);
    --font-h3--weight: var(--font-{{ settings.h3_font }}--weight);
    --font-h4--family: var(--font-{{ settings.h4_font }}--family);
    --font-h4--style: var(--font-{{ settings.h4_font }}--style);
    --font-h4--weight: var(--font-{{ settings.h4_font }}--weight);
    --font-h5--family: var(--font-{{ settings.h5_font }}--family);
    --font-h5--style: var(--font-{{ settings.h5_font }}--style);
    --font-h5--weight: var(--font-{{ settings.h5_font }}--weight);
    --font-h6--family: var(--font-{{ settings.h6_font }}--family);
    --font-h6--style: var(--font-{{ settings.h6_font }}--style);
    --font-h6--weight: var(--font-{{ settings.h6_font }}--weight);
    --font-paragraph--family: var(--font-{{ settings.paragraph_font }}--family);
    --font-paragraph--style: var(--font-{{ settings.paragraph_font }}--style);
    --font-paragraph--weight: var(--font-{{ settings.paragraph_font }}--weight);
    --font-subheading-preset--family: var(--font-{{ settings.subheading_preset_font }}--family);
    --font-subheading-preset--style: var(--font-{{ settings.subheading_preset_font }}--style);
    --font-subheading-preset--weight: var(--font-{{ settings.subheading_preset_font }}--weight);
    --heading-text-case: {{ h1_text_case }};
    --tracking-tight: -0.8px;
    --tracking-snug: -0.2px;
    --tracking-normal: 0px;
    --tracking-open: 0.8px;
    --tracking-loose: 1.1px;
    --tracking-2: 2px;
    --tracking-04: 0.4px;
    --tracking-display: var(--spinel-type-tracking-display);
    --tracking-heading: var(--spinel-type-tracking-heading);
    --tracking-body: var(--spinel-type-tracking-body);
    --tracking-label: var(--spinel-type-tracking-label);
    --tracking-action: var(--spinel-type-tracking-action);
    --tracking-wordmark: var(--spinel-type-tracking-wordmark);

    --font-body-small: var(--spinel-type-size-body-sm);
    --font-body-base: {{ settings.body_text_size_mobile }}px;
    --font-body-large: var(--spinel-type-size-body-lg);
    --font-caption: var(--spinel-type-size-body-xs);
    --body-line-height: {{ settings.body_text_line_height_range | divided_by: 100.0 }};
    --body-letter-spacing: {% if settings.body_text_tracking_range == -0.8 %}var(--tracking-tight){% elsif settings.body_text_tracking_range == -0.2 %}var(--tracking-snug){% elsif settings.body_text_tracking_range == 0 %}var(--tracking-normal){% elsif settings.body_text_tracking_range == 0.8 %}var(--tracking-open){% elsif settings.body_text_tracking_range == 1.1 %}var(--tracking-loose){% else %}{{ settings.body_text_tracking_range }}px{% endif %};
    --font-subheading-size: {{ settings.subheading_size_mobile }}px;
    --font-subheading-line-height: {{ settings.subheading_line_height_range | divided_by: 100.0 }};
    --font-subheading-letter-spacing: {% if settings.subheading_tracking_range == -0.8 %}var(--tracking-tight){% elsif settings.subheading_tracking_range == -0.2 %}var(--tracking-snug){% elsif settings.subheading_tracking_range == 0 %}var(--tracking-normal){% elsif settings.subheading_tracking_range == 0.8 %}var(--tracking-open){% elsif settings.subheading_tracking_range == 1.1 %}var(--tracking-loose){% else %}{{ settings.subheading_tracking_range }}px{% endif %};
    --font-subheading-text-case: {{ subheading_text_case }};

    --leading-tight: 1.1;
    --leading-snug: 1.2;
    --leading-normal: 1.4;
    --leading-relaxed: 1.5;
    --leading-loose: 1.6;
    --leading-120: 1.2;
    --leading-130: 1.3;
    --leading-140: 1.4;
    --leading-150: 1.5;

    --font-h1-size: {{ settings.h1_size_mobile }}px;
    --font-h1-line-height: {{ settings.h1_line_height_range | divided_by: 100.0 }};
    --font-h1-letter-spacing: {% if settings.h1_tracking_range == -0.8 %}var(--tracking-tight){% elsif settings.h1_tracking_range == -0.2 %}var(--tracking-snug){% elsif settings.h1_tracking_range == 0 %}var(--tracking-normal){% elsif settings.h1_tracking_range == 0.8 %}var(--tracking-open){% elsif settings.h1_tracking_range == 1.1 %}var(--tracking-loose){% else %}{{ settings.h1_tracking_range }}px{% endif %};
    --font-h1-text-case: {{ h1_text_case }};
    --font-h2-size: {{ settings.h2_size_mobile }}px;
    --font-h2-line-height: {{ settings.h2_line_height_range | divided_by: 100.0 }};
    --font-h2-letter-spacing: {% if settings.h2_tracking_range == -0.8 %}var(--tracking-tight){% elsif settings.h2_tracking_range == -0.2 %}var(--tracking-snug){% elsif settings.h2_tracking_range == 0 %}var(--tracking-normal){% elsif settings.h2_tracking_range == 0.8 %}var(--tracking-open){% elsif settings.h2_tracking_range == 1.1 %}var(--tracking-loose){% else %}{{ settings.h2_tracking_range }}px{% endif %};
    --font-h2-text-case: {{ h2_text_case }};
    --font-h3-size: {{ settings.h3_size_mobile }}px;
    --font-h3-line-height: {{ settings.h3_line_height_range | divided_by: 100.0 }};
    --font-h3-letter-spacing: {% if settings.h3_tracking_range == -0.8 %}var(--tracking-tight){% elsif settings.h3_tracking_range == -0.2 %}var(--tracking-snug){% elsif settings.h3_tracking_range == 0 %}var(--tracking-normal){% elsif settings.h3_tracking_range == 0.8 %}var(--tracking-open){% elsif settings.h3_tracking_range == 1.1 %}var(--tracking-loose){% else %}{{ settings.h3_tracking_range }}px{% endif %};
    --font-h3-text-case: {{ h3_text_case }};
    --font-h4-size: {{ settings.h4_size_mobile }}px;
    --font-h4-line-height: {{ settings.h4_line_height_range | divided_by: 100.0 }};
    --font-h4-letter-spacing: {% if settings.h4_tracking_range == -0.8 %}var(--tracking-tight){% elsif settings.h4_tracking_range == -0.2 %}var(--tracking-snug){% elsif settings.h4_tracking_range == 0 %}var(--tracking-normal){% elsif settings.h4_tracking_range == 0.8 %}var(--tracking-open){% elsif settings.h4_tracking_range == 1.1 %}var(--tracking-loose){% else %}{{ settings.h4_tracking_range }}px{% endif %};
    --font-h4-text-case: {{ h4_text_case }};
    --font-h5-size: {{ settings.h5_size_mobile }}px;
    --font-h5-line-height: {{ settings.h5_line_height_range | divided_by: 100.0 }};
    --font-h5-letter-spacing: {% if settings.h5_tracking_range == -0.8 %}var(--tracking-tight){% elsif settings.h5_tracking_range == -0.2 %}var(--tracking-snug){% elsif settings.h5_tracking_range == 0 %}var(--tracking-normal){% elsif settings.h5_tracking_range == 0.8 %}var(--tracking-open){% elsif settings.h5_tracking_range == 1.1 %}var(--tracking-loose){% else %}{{ settings.h5_tracking_range }}px{% endif %};
    --font-h5-text-case: {{ h5_text_case }};
    --font-h6-size: {{ settings.h6_size_mobile }}px;
    --font-h6-line-height: {{ settings.h6_line_height_range | divided_by: 100.0 }};
    --font-h6-letter-spacing: {% if settings.h6_tracking_range == -0.8 %}var(--tracking-tight){% elsif settings.h6_tracking_range == -0.2 %}var(--tracking-snug){% elsif settings.h6_tracking_range == 0 %}var(--tracking-normal){% elsif settings.h6_tracking_range == 0.8 %}var(--tracking-open){% elsif settings.h6_tracking_range == 1.1 %}var(--tracking-loose){% else %}{{ settings.h6_tracking_range }}px{% endif %};
    --font-h6-text-case: {{ h6_text_case }};

    --page-width: {{ settings.max_page_width }};
    --page-margin: max({{ settings.min_page_margin }}px, {{ settings.page_margin_mobile }}px);

    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-heading: {{ settings.foreground_color }};
    --color-text: {{ settings.foreground_color }};
    --color-sale-price: {{ settings.sale_price_color }};
    --color-sale-badge-background: {{ settings.sale_badge_background }};
    --color-sale-badge-text: {{ settings.sale_badge_text }};
    --color-sold-out-badge-background: {{ settings.sold_out_badge_background }};
    --color-sold-out-badge-text: {{ settings.sold_out_badge_text }};
    --color-primary-button: {{ default_color_scheme.settings.primary_button }};
    --color-primary-button-label: {{ default_color_scheme.settings.primary_button_label }};
    --color-primary-button-outline: {{ default_color_scheme.settings.primary_button_outline }};
    --color-secondary-button: {{ default_color_scheme.settings.secondary_button }};
    --color-secondary-button-label: {{ default_color_scheme.settings.secondary_button_label }};
    --color-secondary-button-outline: {{ default_color_scheme.settings.secondary_button_outline }};
    --color-tertiary-button: {{ default_color_scheme.settings.tertiary_button }};
    --color-variant-border: color-mix(in srgb, {{ default_color_scheme.settings.variant_border }} 42%, {{ settings.background_color }});

    --radius-card: {{ card_radius }}px;
    --radius-button: {{ button_radius }}px;
    --radius-badge: {{ badge_radius }}px;
    --radius-form: {{ form_radius }}px;
    --style-border-radius-inputs: var(--radius-form);
    --radius-variant-picker: {{ variant_picker_radius }}px;
    --style-border-radius-variants: var(--radius-variant-picker);

    --control-height: {{ settings.control_height_mobile }}px;
    --button-inline-padding: {{ settings.button_padding_mobile }}px;
    --button-primary-font-family: {{ primary_button_font_family }};
    --button-primary-font-style: {{ primary_button_font_style }};
    --button-primary-font-weight: {{ primary_button_font_weight }};
    --button-primary-text-case: {{ settings.primary_button_text_transform }};
    --button-primary-border-width: {{ settings.primary_button_border_width }}px;
    --button-secondary-font-family: {{ secondary_button_font_family }};
    --button-secondary-font-style: {{ secondary_button_font_style }};
    --button-secondary-font-weight: {{ secondary_button_font_weight }};
    --button-secondary-text-case: {{ settings.secondary_button_text_transform }};
    --button-secondary-border-width: {{ settings.secondary_button_border_width }}px;
    --button-tertiary-font-family: {{ tertiary_button_font_family }};
    --button-tertiary-font-style: {{ tertiary_button_font_style }};
    --button-tertiary-font-weight: {{ tertiary_button_font_weight }};
    --button-tertiary-text-case: {{ settings.tertiary_button_text_transform }};
    --button-tertiary-border-color: {% if settings.tertiary_button_underline %}currentcolor{% else %}transparent{% endif %};
    --button-tertiary-underline-offset: {{ settings.tertiary_button_underline_offset }}px;
    --motion-duration: {% if settings.enable_motion %}160ms{% else %}0ms{% endif %};
    --disabled-opacity: {{ settings.disabled_opacity | divided_by: 100.0 }};
  }

  {% for scheme in settings.color_schemes %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --gradient-background: {{ scheme.settings.background_gradient | default: scheme.settings.background }};
      --color-heading: {{ scheme.settings.heading }};
      --color-text: {{ scheme.settings.text }};
      --color-foreground: {{ scheme.settings.text }};
      --color-variant-overlay: {{ scheme.settings.variant_overlay }};
      --color-variant-border: color-mix(in srgb, {{ scheme.settings.variant_border }} 42%, {{ scheme.settings.background }});
      --color-variant-bar-background: {{ scheme.settings.variant_bar_background }};
      --color-variant-component-background: {{ scheme.settings.variant_component_background }};
      --color-primary-button: {{ scheme.settings.primary_button }};
      --color-primary-button-label: {{ scheme.settings.primary_button_label }};
      --color-primary-button-outline: {{ scheme.settings.primary_button_outline }};
      --color-secondary-button: {{ scheme.settings.secondary_button }};
      --color-secondary-button-label: {{ scheme.settings.secondary_button_label }};
      --color-secondary-button-outline: {{ scheme.settings.secondary_button_outline }};
      --color-tertiary-button: {{ scheme.settings.tertiary_button }};
      --color-shadow: {{ scheme.settings.shadow }};
    }
  {% endfor %}

  @media screen and (min-width: 750px) {
    :root {
      --spinel-type-size-display-xl: 124px;
      --spinel-type-size-display-lg: 88px;
      --spinel-type-size-display-md: 64px;
      --spinel-type-size-heading-xl: 56px;
      --spinel-type-size-heading-lg: 48px;
      --spinel-type-size-heading-md: 40px;
      --spinel-type-size-heading-sm: 32px;
      --spinel-type-size-heading-xs: 24px;
      --spinel-type-size-body-lg: 18px;
      --spinel-type-size-body-md: 16px;
      --spinel-type-size-body-sm: 14px;
      --spinel-type-size-body-xs: 12px;
      --spinel-type-size-label: 10px;
      --spinel-type-size-action: 12px;
      --spinel-type-size-price-lg: 28px;
      --spinel-type-size-price-md: 20px;
      --spinel-type-size-wordmark: 72px;
      --spinel-type-size-product-title: 20px;

      --spinel-type-line-display-xl: 128px;
      --spinel-type-line-display-lg: 96px;
      --spinel-type-line-display-md: 72px;
      --spinel-type-line-heading-xl: 64px;
      --spinel-type-line-heading-lg: 56px;
      --spinel-type-line-heading-md: 48px;
      --spinel-type-line-heading-sm: 40px;
      --spinel-type-line-heading-xs: 32px;
      --spinel-type-line-body-lg: 28px;
      --spinel-type-line-body-md: 24px;
      --spinel-type-line-body-sm: 20px;
      --spinel-type-line-body-xs: 16px;
      --spinel-type-line-label: 14px;
      --spinel-type-line-action: 16px;
      --spinel-type-line-price-lg: 32px;
      --spinel-type-line-price-md: 24px;
      --spinel-type-line-wordmark: 72px;
      --spinel-type-line-product-title: 26px;

      --spinel-type-tracking-display: -1.5px;
      --spinel-type-tracking-heading: -0.5px;
      --spinel-type-tracking-body: 0px;
      --spinel-type-tracking-label: 1.2px;
      --spinel-type-tracking-action: 0.8px;
      --spinel-type-tracking-wordmark: 3px;

      --tracking-tight: -1.5px;
      --tracking-snug: -0.5px;
      --tracking-normal: 0px;
      --tracking-open: 0.8px;
      --tracking-loose: 1.2px;

      --font-body-base: {{ settings.body_text_size_desktop }}px;
      --font-h1-size: {{ settings.h1_size_desktop }}px;
      --font-h2-size: {{ settings.h2_size_desktop }}px;
      --font-h3-size: {{ settings.h3_size_desktop }}px;
      --font-h4-size: {{ settings.h4_size_desktop }}px;
      --font-h5-size: {{ settings.h5_size_desktop }}px;
      --font-h6-size: {{ settings.h6_size_desktop }}px;
      --font-subheading-size: {{ settings.subheading_size_desktop }}px;
      --page-margin: max({{ settings.min_page_margin }}px, {{ settings.page_margin_tablet }}px);
      --control-height: {{ settings.control_height_desktop }}px;
      --button-inline-padding: {{ settings.button_padding_desktop }}px;
    }
  }

