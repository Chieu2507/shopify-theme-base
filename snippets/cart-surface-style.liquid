{% doc %}Cart panel appearance using shared semantic scheme tokens. @param {object} settings - Block settings.{% enddoc %}
--cart-surface-padding: {% case settings.padding %}{% when 'none' %}0{% when 'small' %}12px{% when 'large' %}32px{% else %}20px{% endcase %}; --cart-surface-border: {{ settings.border_width }}px; --cart-surface-shadow: {% case settings.shadow %}{% when 'none' %}none{% when 'sm' %}0 3px 12px{% when 'md' %}0 6px 24px{% else %}0 1px 5px{% endcase %};
