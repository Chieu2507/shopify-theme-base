{% assign cart_drawer_scheme = settings.cart_drawer_color_scheme.id | default: settings.cart_drawer_color_scheme | default: 'scheme-1' %}
<cart-drawer
  id="CartDrawer"
  class="cart-drawer color-scheme color-{{ cart_drawer_scheme }}"
  data-cart-drawer
  style="--cart-drawer-width: {{ settings.cart_drawer_width | default: 450 }}px;"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-recommendations-enabled="{{ settings.cart_drawer_show_recommendations }}"
  data-recommendations-limit="{{ settings.cart_drawer_recommendations_limit | default: 4 }}"
  data-discount-enabled="{{ settings.cart_drawer_show_discount }}"
  data-order-note-enabled="{{ settings.cart_drawer_show_order_note }}"
  data-empty-label="{{ 'cart_drawer.empty' | t | default: 'Your cart is empty' | escape }}"
  hidden
>
  <button class="cart-drawer__backdrop" type="button" aria-label="{{ 'cart_drawer.close' | t | default: 'Close cart' | escape }}" data-cart-drawer-close></button>
  <span class="cart-drawer__backdrop-pointer modal-close-button close-icon" aria-hidden="true"></span>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <header class="cart-drawer__header">
      <h2 id="CartDrawerTitle" class="cart-drawer__title">{{ 'cart_drawer.title' | t | default: 'Cart' | escape }}</h2>
      <button class="cart-drawer__close modal-close-button close-icon" type="button" aria-label="{{ 'cart_drawer.close' | t | default: 'Close cart' | escape }}" data-cart-drawer-close></button>
    </header>

    <div class="cart-drawer__body">
      <p class="cart-drawer__status" data-cart-drawer-status role="status" aria-live="polite" hidden></p>
      <div class="cart-drawer__loading" data-cart-drawer-loading hidden aria-hidden="true"><span class="cart-drawer__loading-spinner"></span></div>
      <div class="cart-drawer__items" data-cart-drawer-items></div>
      <section class="cart-drawer__recommendations" data-cart-drawer-recommendations hidden aria-labelledby="CartDrawerRecommendationsTitle">
        <div class="cart-drawer__section-heading">
          <h3 id="CartDrawerRecommendationsTitle">{{ 'cart_drawer.complete_with' | t | default: 'Complete with' | escape }}</h3>
          <div class="cart-drawer__recommendation-dots" data-cart-drawer-recommendation-dots aria-hidden="true"></div>
        </div>
        <div class="cart-drawer__recommendation-list" data-cart-drawer-recommendation-list></div>
      </section>
    </div>

    <footer class="cart-drawer__footer" data-cart-drawer-footer hidden>
      {% if settings.cart_drawer_show_order_note %}
        <details class="cart-drawer__note">
          <summary>{{ 'cart_drawer.order_note' | t | default: 'Add order note' | escape }}</summary>
          <textarea rows="3" data-cart-drawer-note aria-label="{{ 'cart_drawer.order_note' | t | default: 'Add order note' | escape }}" placeholder="{{ 'cart_drawer.note_placeholder' | t | default: 'Add a note to your order' | escape }}"></textarea>
          <button type="button" class="cart-drawer__text-button" data-cart-drawer-save-note>{{ 'cart_drawer.save_note' | t | default: 'Save note' | escape }}</button>
        </details>
      {% endif %}

      <p class="cart-drawer__tax-note">{{ 'cart_drawer.taxes_note' | t | default: 'Taxes and shipping calculated at checkout' | escape }}</p>
      {% if settings.cart_drawer_show_discount %}
        <form class="cart-drawer__discount" data-cart-drawer-discount>
          <label class="visually-hidden" for="CartDrawerDiscount">{{ 'cart_drawer.discount_code' | t | default: 'Discount code' | escape }}</label>
          <input id="CartDrawerDiscount" type="text" name="discount" autocomplete="off" placeholder="{{ 'cart_drawer.discount_code' | t | default: 'Discount code' | escape }}">
          <button type="submit" class="cart-drawer__text-button">{{ 'cart_drawer.apply' | t | default: 'Apply' | escape }}</button>
        </form>
      {% endif %}
      <p class="cart-drawer__message" data-cart-drawer-message role="status" aria-live="polite" hidden></p>
      <div class="cart-drawer__total"><span>{{ 'cart_drawer.total' | t | default: 'Total' | escape }}</span><strong data-cart-drawer-total></strong></div>
      <a class="cart-drawer__checkout" href="{{ routes.checkout_url | default: '/checkout' }}" data-cart-drawer-checkout>{{ 'cart_drawer.checkout' | t | default: 'Checkout' | escape }}<span aria-hidden="true"> · </span><span data-cart-drawer-checkout-total></span></a>
      <a class="cart-drawer__view-cart" href="{{ routes.cart_url }}">{{ 'cart_drawer.view_cart' | t | default: 'View cart' | escape }}</a>
    </footer>
  </aside>
</cart-drawer>
