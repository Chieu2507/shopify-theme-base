{% doc %}
  Renders the reusable Product Card quick-add action.

  The component owns the add-to-cart form and delegates button markup and
  visual treatment to the shared theme-button snippet.

  @param {number} variant_id - Variant ID submitted to the cart endpoint
  @param {string} label - Accessible and visible button label
  @param {string} [style] - Button style: icon or text
  @param {boolean} [full_width] - Whether the action fills its wrapper
  @param {string} [color_scheme] - Color scheme class for the action
  @param {string} [motion_speed] - Motion token: fast, standard, or slow

  @example
  {% render 'product-card-quick-add', variant_id: product.selected_or_first_available_variant.id, label: 'Add to cart' %}
{% enddoc %}

{% liquid
  assign quick_add_style = style | default: 'text'
  unless quick_add_style == 'icon' or quick_add_style == 'text'
    assign quick_add_style = 'text'
  endunless

  assign quick_add_motion_speed = motion_speed | default: 'standard'
  case quick_add_motion_speed
    when 'fast', 'slow'
    when 'standard'
    else
      assign quick_add_motion_speed = 'standard'
  endcase

  assign quick_add_class = 'product-card__action product-card__quick-add product-card__action--motion-' | append: quick_add_motion_speed
  if full_width != false
    assign quick_add_class = quick_add_class | append: ' product-card__quick-add--full'
  endif
%}

<div class="{{ quick_add_class }}{% if color_scheme != blank %} {{ color_scheme }}{% endif %}" data-product-card-quick-add-wrapper>
  <form action="{{ routes.cart_add_url }}" method="post" data-product-card-quick-add>
    <input type="hidden" name="id" value="{{ variant_id }}">
    {% if quick_add_style == 'icon' %}
      {% render 'theme-button',
        label: label,
        type: 'submit',
        variant: 'primary',
        icon: 'cart',
        icon_only: true,
        motion_speed: quick_add_motion_speed,
        class: 'product-card__quick-add-button btn--icon'
      %}
    {% else %}
      {% render 'theme-button',
        label: label,
        type: 'submit',
        variant: 'primary',
        motion_speed: quick_add_motion_speed,
        class: 'product-card__quick-add-button'
      %}
    {% endif %}
  </form>
</div>
