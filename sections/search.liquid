{% comment %}
  Search results page for products, collections, pages, and articles.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{% liquid
  assign search_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign search_scheme = section.settings.color_scheme.id
  endif
  assign search_scheme = search_scheme | default: 'scheme-1' | handleize
  assign search_page_label = 'search.title' | t
  assign search_page_placeholder = 'search.placeholder' | t

  assign escaped_search_terms = search.terms | escape
  assign search_input_id = 'SearchPageInput-' | append: section.id
  assign search_types = search.types | join: ','
  assign search_sort = search.sort_by | default: search.default_sort_by
  assign search_article_label = 'search.blog_posts' | t
%}

{% style %}
  #shopify-section-{{ section.id }} { background: {{ section.settings.background_color | default: section.settings.color_scheme.settings.background }}; }
{% endstyle %}
{% paginate search.results by section.settings.results_per_page %}
{% liquid
  assign product_count = 0
  assign collection_count = 0
  assign page_count = 0
  assign article_count = 0

  if search.performed
    for result in search.results
      case result.object_type
        when 'product'
          assign product_count = product_count | plus: 1
        when 'collection'
          assign collection_count = collection_count | plus: 1
        when 'page'
          assign page_count = page_count | plus: 1
        when 'article'
          assign article_count = article_count | plus: 1
      endcase
    endfor
  endif

  assign active_result_type = 'products'
  if product_count == 0
    if collection_count > 0
      assign active_result_type = 'collections'
    elsif page_count > 0 or article_count > 0
      assign active_result_type = 'pages'
    endif
  endif
%}
<div
  class="section-spacing search-page__spacing color-scheme section-color-scope {{ search_scheme }}"
  data-search-page
  style="--search-padding-top: {{ section.settings.padding_top }}px; --search-padding-bottom: {{ section.settings.padding_bottom }}px; --search-columns: {{ section.settings.columns_desktop }}; --search-columns-mobile: {{ section.settings.columns_mobile }};"
>
  <div class="container {% if section.settings.section_width == 'full' %}full-width{% else %}page-width{% endif %} search-page__container">
    <div class="search-page__header">
      <h1 class="search-page__title heading-text heading-xl heading-mobile-lg">{{ 'search.title' | t }}</h1>

      <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
        <button class="search-page__submit" type="submit" aria-label="{{ 'search.submit' | t | escape }}">
          {% render 'icon', icon: 'magnifying-glass', bare: true %}
        </button>
        {% render 'form-field',
          id: search_input_id,
          name: 'q',
          label: search_page_label,
          type: 'search',
          value: search.terms,
          placeholder: search_page_placeholder,
          hide_label: true,
          class: 'search-page__field body-text body-xl'
        %}
        <button class="search-page__clear overlay-close" type="button" data-search-page-clear aria-label="{{ 'search.clear' | t | escape }}" hidden>
          {% render 'icon', icon: 'x-mark', bare: true, class: 'overlay-close__icon' %}
        </button>
        <input type="hidden" name="options[prefix]" value="last">
        {% if search_types != blank %}<input type="hidden" name="type" value="{{ search_types | escape }}">{% endif %}
      </form>
    </div>

    {% unless search.performed %}
      {% if section.settings.show_recently_viewed %}
        <div class="search-page__recently-viewed" data-recently-viewed data-limit="{{ section.settings.recently_viewed_limit }}" hidden>
          <h2 class="heading-text heading-md">{{ 'search.recently_viewed' | t }}</h2>
          <div class="search-page__product-grid" data-recently-viewed-grid></div>
        </div>
      {% endif %}
    {% endunless %}
    {% if search.performed %}
      {% render 'search-filters', search: search, section: section, search_types: search_types, sort_by: search_sort %}
      {% if search.results_count == 0 %}
        <p class="search-page__empty body-text body-md">{{ 'search.no_results_html' | t: terms: escaped_search_terms }}</p>
      {% else %}
        <p class="search-page__summary body-text body-md" role="status">
          {{ 'search.results_for_html' | t: terms: escaped_search_terms, count: search.results_count }}
        </p>

        <div class="search-page__results">

          <div class="search-page__tabs scrollbar scrollbar--horizontal" role="tablist" aria-label="{{ 'search.title' | t | escape }}">
            {% if product_count > 0 %}
              <button
                id="SearchPageTabProducts-{{ section.id }}"
                class="search-page__tab eyebrow-text"
                type="button"
                role="tab"
                aria-selected="{% if active_result_type == 'products' %}true{% else %}false{% endif %}"
                aria-controls="SearchPagePanelProducts-{{ section.id }}"
                data-search-page-tab="products"
              >
                {{ 'search.products' | t }}
              </button>
            {% endif %}
            {% if collection_count > 0 %}
              <button
                id="SearchPageTabCollections-{{ section.id }}"
                class="search-page__tab eyebrow-text"
                type="button"
                role="tab"
                aria-selected="{% if active_result_type == 'collections' %}true{% else %}false{% endif %}"
                aria-controls="SearchPagePanelCollections-{{ section.id }}"
                data-search-page-tab="collections"
              >
                {{ 'search.collections' | t }}
              </button>
            {% endif %}
            {% if page_count > 0 or article_count > 0 %}
              <button
                id="SearchPageTabPages-{{ section.id }}"
                class="search-page__tab eyebrow-text"
                type="button"
                role="tab"
                aria-selected="{% if active_result_type == 'pages' %}true{% else %}false{% endif %}"
                aria-controls="SearchPagePanelPages-{{ section.id }}"
                data-search-page-tab="pages"
              >
                {{ 'search.pages' | t }}
              </button>
            {% endif %}
          </div>


            {% if product_count > 0 %}
              <div
                id="SearchPagePanelProducts-{{ section.id }}"
                class="search-page__panel"
                role="tabpanel"
                aria-labelledby="SearchPageTabProducts-{{ section.id }}"
                data-search-page-panel="products"

              >
                <div class="search-page__product-grid">
                  {% for result in search.results %}
                    {% if result.object_type == 'product' %}
                      {% render 'product-card', product: result, class: 'search-page__product-card' %}
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if collection_count > 0 %}
              <div
                id="SearchPagePanelCollections-{{ section.id }}"
                class="search-page__panel"
                role="tabpanel"
                aria-labelledby="SearchPageTabCollections-{{ section.id }}"
                data-search-page-panel="collections"

              >
                <div class="search-page__collection-grid">
                  {% for result in search.results %}
                    {% if result.object_type == 'collection' %}
                      {% assign collection_image = result.featured_image | default: result.image %}
                      <a class="search-page__collection-card" href="{{ result.url }}">
                        {% if collection_image != blank %}
                          {% render 'image', image: collection_image, width: 800, height: 800, crop: 'center', class: 'search-page__collection-image' %}
                        {% else %}
                          <div class="search-page__collection-image search-page__collection-placeholder placeholder-image" aria-hidden="true">
                            {{ 'collection-1' | placeholder_svg_tag }}
                          </div>
                        {% endif %}
                        <span class="search-page__collection-title accent-text body-sm">{{ result.title | escape }}</span>
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if page_count > 0 or article_count > 0 %}
              <div
                id="SearchPagePanelPages-{{ section.id }}"
                class="search-page__panel"
                role="tabpanel"
                aria-labelledby="SearchPageTabPages-{{ section.id }}"
                data-search-page-panel="pages"

              >
                <ul class="search-page__page-list">
                  {% for result in search.results %}
                    {% if result.object_type == 'page' or result.object_type == 'article' %}
                      <li>
                        <a href="{{ result.url }}">
                          <span class="search-page__page-title body-text body-md">{{ result.title | escape }}</span>
                          {% if result.object_type == 'article' %}
                            <span class="search-page__page-type eyebrow-text">{{ result.blog.title | default: search_article_label | escape }}</span>
                          {% endif %}
                        </a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            {% if paginate.pages > 1 %}
              <nav class="search-page__pagination" aria-label="{{ 'accessibility.pagination' | t | escape }}">
                {{ paginate | default_pagination }}
              </nav>
            {% endif %}

        </div>
      {% endif %}
    {% endif %}
  </div>
</div>
{% endpaginate %}
<script src="{{ 'search-page.js' | asset_url }}" defer></script>

{% stylesheet %}
  .search-page__spacing {
    min-height: 50vh;
    padding-block: var(--search-padding-top, 60px) var(--search-padding-bottom, 60px);
    background-color: var(--background-color);
  }

  .search-page__container {
    min-width: 0;
  }

  .search-page__header {
    display: grid;
    gap: 2.5rem;
    max-width: 62rem;
    margin-inline: auto;
  }

  .search-page__title { text-align: center; }

  .search-page__form {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.75rem;
    padding-inline: 0;
    padding-inline: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: var(--input-radius);
  }

  .search-page__form:focus-within {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .search-page__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .search-page__submit svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .search-page__clear { flex: 0 0 auto; }
  .search-page__clear[hidden] { display: none; }

  .search-page__field {
    min-width: 0;
    flex: 1 1 auto;
  }

  .search-page__field .form__label {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .search-page__field .form__control {
    width: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    color: inherit;
    font: inherit;
  }

  .search-page__field .form__control::-webkit-search-cancel-button,
  .search-page__field .form__control::-webkit-search-decoration,
  .search-page__field .form__control::-webkit-search-results-button,
  .search-page__field .form__control::-webkit-search-results-decoration {
    display: none;
    appearance: none;
    -webkit-appearance: none;
  }

  .search-page__field .form__control::-ms-clear {
    display: none;
    width: 0;
    height: 0;
  }

  .search-page__summary,
  .search-page__empty {
    margin-block-start: 3rem;
    color: color-mix(in srgb, currentColor 70%, transparent);
    text-align: center;
  }

  .search-page__results {
    margin-block-start: 3rem;
  }

  .search-page__tabs {
    display: flex;
    gap: 2.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .search-page__tab {
    position: relative;
    padding: 0 0 1rem;
    border: 0;
    background: transparent;
    color: color-mix(in srgb, currentColor 55%, transparent);
    white-space: nowrap;
  }

  .search-page__tab[aria-selected='true'] {
    color: inherit;
  }

  .search-page__tab[aria-selected='true']::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    height: 1px;
    background: currentColor;
    content: '';
  }

  .search-page__panel {
    padding-block-start: 2.5rem;
  }

  .search-page__panel[hidden] {
    display: none;
  }

  .search-page__product-grid,
  .search-page__collection-grid {
    display: grid;
    grid-template-columns: repeat(var(--search-columns, 4), minmax(0, 1fr));
    gap: var(--layout-grid-gap);
  }

  .search-page__collection-card {
    display: grid;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .search-page__collection-image {
    display: block;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .search-page__collection-placeholder > svg {
    width: 100%;
    height: 100%;
  }

  .search-page__collection-title {
  }

  .search-page__page-list {
    display: grid;
    max-width: 44rem;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search-page__page-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    color: inherit;
    text-decoration: none;
  }

  .search-page__page-type {
    color: color-mix(in srgb, currentColor 60%, transparent);
  }

  .search-page__pagination {
    grid-column: 1 / -1;
    margin-block-start: 3rem;
  }

  .search-page__tabs { display: none; }
  .search-page--enhanced .search-page__tabs { display: flex; }
  .search-page__page-title { overflow-wrap: anywhere; }
  .search-page__toolbar { margin-block: 2rem; }
  .search-page__recently-viewed { margin-block-start: 3rem; }
  .search-page__recently-viewed[hidden] { display: none; }
  .search-page__recently-viewed h2 { margin-block-end: 1.5rem; }
  .search-page__filter-form { display: flex; flex-wrap: wrap; align-items: end; gap: 1rem; }
  .search-page__filter-form > .form__field { min-width: 12rem; }
  .search-page__filters { flex: 1 1 auto; }
  .search-page__filters[open] { flex-basis: 100%; order: 2; }
  .search-page__filters[open] ~ .btn { order: 3; }
  .search-page__filters > summary { padding-block: 1rem; cursor: pointer; }
  .search-page__filter-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1.5rem; padding-block: 1rem; }
  .search-page__filter-group { min-width: 0; margin: 0; border: 1px solid var(--border-color); padding: 1rem; }
  .search-page__filter-values { display: grid; gap: .75rem; max-height: 18rem; overflow: auto; }
  .search-page__filter-value { display: flex; align-items: center; gap: .5rem; }
  .search-page__active-filters { display: flex; flex-wrap: wrap; gap: 1rem; margin-block-start: 1rem; }
  @media (min-width: 768px) and (max-width: 1149.98px) {
    .search-page__spacing { padding-block: calc(var(--search-padding-top, 60px) * .75) calc(var(--search-padding-bottom, 60px) * .75); }
    .search-page__product-grid, .search-page__collection-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 767.98px) {
    .search-page__spacing {
      padding-block: calc(var(--search-padding-top, 60px) * .5) calc(var(--search-padding-bottom, 60px) * .5);
    }

    .search-page__form {
      min-height: 4rem;
    }

    .search-page__product-grid,
    .search-page__collection-grid {
      grid-template-columns: repeat(var(--search-columns-mobile, 2), minmax(0, 1fr));
      gap: 1rem;
    }

    .search-page__page-list a {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
    }
  }
{% endstylesheet %}



{% schema %}
{
  "name": "t:general.search",
  "class": "section-search",
  "enabled_on": {
    "templates": [
      "search"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full_width"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:labels.search_results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 20
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed",
      "label": "t:labels.search_recently_viewed",
      "default": true
    },
    {
      "type": "range",
      "id": "recently_viewed_limit",
      "label": "t:labels.search_recently_viewed_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.show_recently_viewed }}"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:labels.search_enable_filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:labels.search_enable_sorting",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "alpha": true
    },
    {
      "type": "header",
      "content": "t:general.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:social_links_settings.top_padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:social_links_settings.bottom_padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ]
}
{% endschema %}
