{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<div class="section-color-scope {{ section.settings.color_scheme | default: 'scheme-1' }}">
  <h1>{{ 'search.title' | t }}</h1>

{% assign search_label = 'search.submit' | t %}
{% assign search_placeholder = 'search.placeholder' | t %}
<form class="form__wrapper search-form" action="{{ routes.search_url }}" method="get" role="search">
  <div class="form__fields">
    {% render 'form-field',
      id: 'search-q',
      name: 'q',
      label: search_label,
      type: 'search',
      value: search.terms,
      placeholder: search_placeholder
    %}
    {% render 'theme-button', label: search_label, type: 'submit' %}
  </div>
</form>

  {% if search.performed %}
  {% if search.results_count == 0 %}
    <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
  {% else %}
    <p>{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

    <div class="search-results">
      {% paginate search.results by 20 %}
        {% # Search result items may be an article, a page, or a product. %}
        {% for result in search.results %}
          {% if result.object_type == 'product' %}
            {% render 'product-card', product: result, class: 'search-result-product' %}
          {% else %}
            <div class="search-result">
              {% assign featured_image = result.featured_image | default: result.image %}
              {% if featured_image %}
                {% render 'image', class: 'search-result__image', image: featured_image, url: result.url, width: 400 %}
              {% endif %}
              <div class="search-result__content">
                <p>
                  {{ result.title | link_to: result.url }}
                  {% if result.price != blank %}
                    {% render 'price', item: result, context: 'product-card', class: 'search-result__price' %}
                  {% endif %}
                </p>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {{ paginate | default_pagination }}
      {% endpaginate %}
    </div>
  {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .search-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--layout-grid-gap);
  }
  .search-form .form__fields {
    display: flex;
    align-items: end;
    gap: 1rem;
    margin-block: 1.5rem;
  }
  .search-form .form__field {
    flex: 1;
  }
  @media (max-width: 767px) {
    .search-form .form__fields {
      display: grid;
    }
  }
  .search-results .prev,
  .search-results .page,
  .search-results .next {
    grid-column: 1 / -1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
