{% render 'section-stylesheet', asset: 'section-countdown-timer.css', defer_on_home: true %}

<section
  class="countdown-timer countdown-timer--blocks color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} countdown-timer--full full-width{% endif %} countdown-timer--mobile-{{ section.settings.mobile_alignment }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --countdown-timer-column-gap: {{ section.settings.column_gap }}px; --countdown-timer-mobile-row-gap: {{ section.settings.mobile_row_gap }}px;"
  data-deferred-module="{{ 'section-countdown-timer.js' | asset_url }}"
>
  <div class="countdown-timer__inner section-spacing">
    <div class="countdown-timer__content countdown-timer__heading-block">
      {% content_for 'block', type: 'group', id: 'content' %}
    </div>

    {% content_for 'block', type: '_countdown-clock', id: 'countdown' %}

    <div class="countdown-timer__button-block">
      {% content_for 'block', type: 'button', id: 'button' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .countdown-timer--blocks .countdown-timer__inner {
    grid-template: 'content timer button' auto / minmax(220px, 1fr) auto minmax(140px, 1fr);
  }

  .countdown-timer--blocks .countdown-timer__content {
    min-width: 0;
    align-self: center;
    grid-area: content;
  }

  .countdown-timer--blocks .countdown-timer__content > .spinel-group {
    width: 100%;
  }

  .countdown-timer--blocks .countdown-timer__content .typography-block--text {
    max-width: 390px;
  }

  .countdown-timer--blocks
    .countdown-timer__content
    .typography-block--text.typography-block--preset-default
    .typography-block__content,
  .countdown-timer--blocks
    .countdown-timer__content
    .typography-block--text.typography-block--preset-default
    .typography-block__content
    :is(p, h1, h2, h3, h4, h5, h6) {
    font-size: var(--font-body-small);
    line-height: 1.5;
  }

  .countdown-timer--blocks .countdown-timer__button-block > .shopify-block,
  .countdown-timer--blocks .countdown-timer__button-block .content-button {
    width: auto;
  }

  @media screen and (max-width: 899px) {
    .countdown-timer--blocks .countdown-timer__inner {
      grid-template:
        'content timer' auto
        'button button' auto /
        minmax(200px, 1fr) auto;
    }
  }

  @media screen and (max-width: 749px) {
    .countdown-timer--blocks .countdown-timer__inner {
      grid-template:
        'content' auto
        'timer' auto
        'button' auto /
        minmax(0, 1fr);
    }

    .countdown-timer--blocks.countdown-timer--mobile-left
      .countdown-timer__content
      .typography-block {
      align-self: flex-start;
    }

    .countdown-timer--blocks.countdown-timer--mobile-center
      .countdown-timer__content
      .typography-block {
      align-self: center;
    }

    .countdown-timer--blocks.countdown-timer--mobile-right
      .countdown-timer__content
      .typography-block {
      align-self: flex-end;
    }

    .countdown-timer--blocks.countdown-timer--mobile-left
      .countdown-timer__content
      .typography-block__content,
    .countdown-timer--blocks.countdown-timer--mobile-left
      .countdown-timer__content
      .typography-block__content
      :is(p, h1, h2, h3, h4, h5, h6) {
      text-align: left;
    }

    .countdown-timer--blocks.countdown-timer--mobile-center
      .countdown-timer__content
      .typography-block__content,
    .countdown-timer--blocks.countdown-timer--mobile-center
      .countdown-timer__content
      .typography-block__content
      :is(p, h1, h2, h3, h4, h5, h6) {
      text-align: center;
    }

    .countdown-timer--blocks.countdown-timer--mobile-right
      .countdown-timer__content
      .typography-block__content,
    .countdown-timer--blocks.countdown-timer--mobile-right
      .countdown-timer__content
      .typography-block__content
      :is(p, h1, h2, h3, h4, h5, h6) {
      text-align: right;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown timer blocks",
  "tag": "section",
  "class": "section-countdown-timer",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 64
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "mobile_row_gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Mobile row gap",
      "default": 28
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "group"
    },
    {
      "type": "_countdown-clock"
    },
    {
      "type": "button"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  },
  "presets": [
    {
      "name": "Countdown timer blocks",
      "category": "Marketing",
      "blocks": [
        {
          "type": "group",
          "id": "content",
          "static": true,
          "settings": {
            "block_style": "group",
            "flow": "vertical",
            "stack_alignment": "stretch",
            "stack_distribution": "flex-start",
            "gap": 8,
            "phone_flow": "vertical",
            "phone_alignment": "stretch",
            "phone_distribution": "flex-start",
            "gap_mobile": 28,
            "desktop_width": "stretch",
            "phone_width": "stretch"
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "<h2>Spring Sale</h2>",
                "type_preset": "h3",
                "color": "text",
                "width": "100%",
                "width_mobile": "100%",
                "alignment": "left"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Get 15% off on all products – limited time only!</p>",
                "type_preset": "default",
                "color": "subtext",
                "width": "100%",
                "width_mobile": "100%",
                "alignment": "left"
              }
            }
          ]
        },
        {
          "type": "_countdown-clock",
          "id": "countdown",
          "static": true,
          "settings": {
            "days_label": "Days",
            "hours_label": "Hours",
            "minutes_label": "Minutes",
            "seconds_label": "Seconds",
            "aria_label": "Spring Sale countdown",
            "completion_behavior": "message",
            "completion_message": "Spring Sale ended"
          }
        },
        {
          "type": "button",
          "id": "button",
          "static": true,
          "settings": {
            "label": "Shop now",
            "style": "primary",
            "alignment": "left"
          }
        }
      ]
    }
  ]
}
{% endschema %}
