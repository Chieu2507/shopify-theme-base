<section class="size-chart-page">
  <div class="size-chart-page__inner">
    <header class="size-chart-page__header">
      <p class="size-chart-page__eyebrow">Jewellery sizing</p>
      <h1>{{ page.title | default: 'Size guide' | escape }}</h1>
      <p>Use the measurements below to find the right fit. Product pages show the sizes available for each individual piece.</p>
    </header>

    <section class="size-chart-page__group" aria-labelledby="SizeChartRings">
      <div class="size-chart-page__group-heading">
        <h2 id="SizeChartRings">Rings</h2>
        <p>Measure the inside diameter of a ring that fits comfortably, then match it to the US size offered on our ring styles.</p>
      </div>
      <div class="size-chart-page__table-wrap" tabindex="0">
        <table>
          <caption class="visually-hidden">Ring size conversion</caption>
          <thead><tr><th scope="col">US size</th><th scope="col">Inside diameter</th><th scope="col">Circumference</th></tr></thead>
          <tbody>
            <tr><td>4</td><td>14.9 mm</td><td>46.8 mm</td></tr>
            <tr><td>5</td><td>15.7 mm</td><td>49.3 mm</td></tr>
            <tr><td>6</td><td>16.5 mm</td><td>51.9 mm</td></tr>
            <tr><td>7</td><td>17.3 mm</td><td>54.4 mm</td></tr>
            <tr><td>8</td><td>18.1 mm</td><td>57.0 mm</td></tr>
            <tr><td>9</td><td>18.9 mm</td><td>59.5 mm</td></tr>
            <tr><td>10</td><td>19.8 mm</td><td>62.1 mm</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="size-chart-page__group" aria-labelledby="SizeChartBracelets">
      <div class="size-chart-page__group-heading">
        <h2 id="SizeChartBracelets">Bracelets</h2>
        <p>Measure around your wrist, then add 0.5–1 in (1–2.5 cm) for a comfortable fit. Available product lengths currently include 6.5, 7 and 7.5 in.</p>
      </div>
      <div class="size-chart-page__table-wrap" tabindex="0">
        <table>
          <caption class="visually-hidden">Bracelet length conversion</caption>
          <thead><tr><th scope="col">Bracelet length</th><th scope="col">Length in centimetres</th><th scope="col">Suggested wrist circumference</th></tr></thead>
          <tbody>
            <tr><td>6.5 in</td><td>16.5 cm</td><td>Up to 15.2 cm / 6 in</td></tr>
            <tr><td>7 in</td><td>17.8 cm</td><td>Up to 16.5 cm / 6.5 in</td></tr>
            <tr><td>7.5 in</td><td>19.1 cm</td><td>Up to 17.8 cm / 7 in</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="size-chart-page__group" aria-labelledby="SizeChartNecklaces">
      <div class="size-chart-page__group-heading">
        <h2 id="SizeChartNecklaces">Necklaces</h2>
        <p>Length is measured end to end, including the clasp. Some necklaces have an adjustable 16–18 in chain.</p>
      </div>
      <div class="size-chart-page__table-wrap" tabindex="0">
        <table>
          <caption class="visually-hidden">Necklace length conversion</caption>
          <thead><tr><th scope="col">Length</th><th scope="col">Length in centimetres</th><th scope="col">Fit</th></tr></thead>
          <tbody>
            <tr><td>16 in</td><td>40.6 cm</td><td>Close to the collarbone</td></tr>
            <tr><td>16–18 in adjustable</td><td>40.6–45.7 cm</td><td>Adjustable collarbone length</td></tr>
            <tr><td>18 in</td><td>45.7 cm</td><td>At the collarbone</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="size-chart-page__group size-chart-page__group--notes" aria-labelledby="SizeChartOther">
      <div class="size-chart-page__group-heading">
        <h2 id="SizeChartOther">Earrings, charms &amp; jewellery sets</h2>
        <p>Earrings and charms are currently offered without a size selection. For jewellery sets, please use the fit information shown on each individual component product page.</p>
      </div>
    </section>

    {% if page.content != blank %}
      <div class="size-chart-page__additional rte">{{ page.content }}</div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .size-chart-page { background: var(--color-background); color: var(--color-text); }
  .size-chart-page__inner { width: min(100%, 1080px); margin-inline: auto; padding: clamp(56px, 9vw, 120px) var(--page-margin); }
  .size-chart-page__header { max-width: 700px; margin-bottom: clamp(48px, 7vw, 88px); }
  .size-chart-page__eyebrow { margin: 0 0 14px; font-size: var(--font-eyebrow-size); letter-spacing: var(--font-eyebrow-letter-spacing); text-transform: var(--font-eyebrow-text-case); }
  .size-chart-page__header h1, .size-chart-page__group h2 { margin: 0; color: var(--color-heading); font-family: var(--font-heading--family); font-weight: var(--font-heading--weight); }
  .size-chart-page__header h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1; }
  .size-chart-page__header p:not(.size-chart-page__eyebrow) { max-width: 62ch; margin: 20px 0 0; line-height: 1.65; }
  .size-chart-page__group { padding-block: clamp(32px, 5vw, 56px); border-top: 1px solid var(--color-variant-border); }
  .size-chart-page__group-heading { display: grid; grid-template-columns: minmax(180px, .7fr) minmax(0, 1.3fr); gap: 28px; margin-bottom: 28px; }
  .size-chart-page__group h2 { font-size: clamp(26px, 3vw, 38px); line-height: 1.1; }
  .size-chart-page__group p { max-width: 58ch; margin: 0; line-height: 1.65; }
  .size-chart-page__table-wrap { overflow-x: auto; scrollbar-width: thin; }
  .size-chart-page table { width: 100%; min-width: 580px; border-collapse: collapse; text-align: left; }
  .size-chart-page th, .size-chart-page td { border-bottom: 1px solid var(--color-variant-border); padding: 16px 12px; font-size: var(--font-body-small); line-height: 1.45; }
  .size-chart-page th { color: var(--color-heading); font-size: var(--font-caption); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .size-chart-page td:first-child { color: var(--color-heading); font-weight: 600; }
  .size-chart-page__group--notes { padding-bottom: 0; }
  .size-chart-page__additional { max-width: 700px; margin-top: 48px; }
  @media screen and (max-width: 749px) { .size-chart-page__inner { padding-block: 56px; } .size-chart-page__group-heading { grid-template-columns: 1fr; gap: 16px; } .size-chart-page th, .size-chart-page td { padding: 14px 10px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Size chart",
  "tag": "section",
  "class": "section-size-chart",
  "enabled_on": { "templates": ["page"] },
  "settings": [],
  "presets": [{ "name": "Size chart" }]
}
{% endschema %}
