{% render 'section-stylesheet', asset: 'section-image-with-text.css', defer_on_home: true %}

{% liquid
  assign image_with_text_background = section.settings.background_color
  assign image_with_text_collage_border = section.settings.background_color
  if image_with_text_background == blank
    assign image_with_text_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
    assign image_with_text_collage_border = section.settings.color_scheme.settings.background
  endif
%}

{% capture image_with_text_hero_block %}
  {% content_for 'block', type: 'media', id: 'hero_image' %}
{% endcapture %}
{% capture image_with_text_portrait_block %}
  {% content_for 'block', type: 'media', id: 'portrait_image' %}
{% endcapture %}
{% capture image_with_text_sketch_block %}
  {% content_for 'block', type: 'media', id: 'sketch_image' %}
{% endcapture %}
{% capture image_with_text_detail_block %}
  {% content_for 'block', type: 'media', id: 'detail_image' %}
{% endcapture %}
{% capture image_with_text_location_label %}
  {% content_for 'block', type: 'label', id: 'location_label' %}
{% endcapture %}
{% capture image_with_text_copy_label %}
  {% content_for 'block', type: 'label', id: 'copy_label' %}
{% endcapture %}
{% capture image_with_text_meta_heading %}
  {% content_for 'block', type: 'heading', id: 'meta_heading' %}
{% endcapture %}
{% capture image_with_text_meta_text %}
  {% content_for 'block', type: 'text', id: 'meta_text' %}
{% endcapture %}
{% capture image_with_text_eyebrow %}
  {% content_for 'block', type: 'label', id: 'eyebrow' %}
{% endcapture %}
{% capture image_with_text_heading %}
  {% content_for 'block', type: 'heading', id: 'heading' %}
{% endcapture %}
{% capture image_with_text_highlight_heading %}
  {% content_for 'block', type: 'heading', id: 'highlight_heading' %}
{% endcapture %}
{% capture image_with_text_text %}
  {% content_for 'block', type: 'text', id: 'text' %}
{% endcapture %}
{% capture image_with_text_button %}
  {% content_for 'block', type: 'button', id: 'button' %}
{% endcapture %}
{% capture image_with_text_section_header %}
  {% content_for 'block', type: '_section-header', id: 'section_header' %}
{% endcapture %}
{% assign image_with_text_has_section_header = image_with_text_section_header | strip %}
{% assign image_with_text_has_copy_label = image_with_text_copy_label | strip %}
{% assign image_with_text_has_meta_heading = image_with_text_meta_heading | strip %}
{% assign image_with_text_has_meta_text = image_with_text_meta_text | strip %}

{% style %}
  #shopify-section-{{ section.id }} { background: {{ image_with_text_background }}; }
  #shopify-section-{{ section.id }} .image-with-text { background: transparent; }
{% endstyle %}

<div
  class="image-with-text image-with-text--layout-{{ section.settings.layout | default: 'standard' }} image-with-text--media-{{ section.settings.media_position }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} image-with-text--full full-width{% endif %}"
  style="--image-with-text-column-gap: {{ section.settings.column_gap }}px; --image-with-text-story-height: {{ section.settings.story_collage_height | default: 580 }}px; --image-with-text-collage-border: {{ image_with_text_collage_border }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="image-with-text__inner section-spacing">
    {% if section.settings.layout == 'atelier-grid' %}
      <header class="image-with-text__atelier-header" data-reveal-group>
        {% if image_with_text_has_section_header != blank %}
          <div class="image-with-text__section-header" data-reveal-item style="--reveal-order: 0;">
            {{ image_with_text_section_header }}
          </div>
        {% else %}
          <div class="image-with-text__atelier-eyebrow" data-reveal-item style="--reveal-order: 0;">
            {{ image_with_text_eyebrow }}
          </div>
          <div class="image-with-text__atelier-heading" data-reveal-item style="--reveal-order: 1;">
            {{ image_with_text_heading }}
          </div>
        {% endif %}
      </header>

      <div class="image-with-text__atelier-grid" data-reveal-group>
        <div class="image-with-text__atelier-media image-with-text__atelier-media--hero" data-reveal-item style="--reveal-order: 0;">
          {{ image_with_text_hero_block }}
        </div>
        <div class="image-with-text__atelier-meta" data-reveal-item style="--reveal-order: 1;">
          {{ image_with_text_location_label }}
          {% if image_with_text_has_meta_heading != blank or image_with_text_has_meta_text != blank %}
            <div class="image-with-text__atelier-meta-content">
              {% if image_with_text_has_meta_heading != blank %}
                <div class="image-with-text__atelier-meta-heading">
                  {{ image_with_text_meta_heading }}
                </div>
              {% endif %}
              {% if image_with_text_has_meta_text != blank %}
                <div class="image-with-text__atelier-meta-text">
                  {{ image_with_text_meta_text }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
        <div class="image-with-text__atelier-media image-with-text__atelier-media--sketch" data-reveal-item style="--reveal-order: 2;">
          {{ image_with_text_sketch_block }}
        </div>
        <div class="image-with-text__atelier-media image-with-text__atelier-media--detail" data-reveal-item style="--reveal-order: 3;">
          {{ image_with_text_detail_block }}
        </div>
        <div class="image-with-text__atelier-copy" data-reveal-item style="--reveal-order: 4;">
          {% if image_with_text_has_copy_label != blank %}
            <div class="image-with-text__atelier-copy-label">
              {{ image_with_text_copy_label }}
            </div>
          {% endif %}
          <div class="image-with-text__atelier-copy-heading">
            {{ image_with_text_highlight_heading }}
          </div>
          <div class="image-with-text__atelier-copy-text">
            {{ image_with_text_text }}
          </div>
          <div class="image-with-text__atelier-copy-button">
            {{ image_with_text_button }}
          </div>
        </div>
        <div class="image-with-text__atelier-media image-with-text__atelier-media--portrait" data-reveal-item style="--reveal-order: 5;">
          {{ image_with_text_portrait_block }}
        </div>
      </div>
    {% elsif section.settings.layout == 'story-collage' %}
      <div class="image-with-text__story-collage" data-reveal-group>
        <div class="image-with-text__story-media image-with-text__story-media--main" data-reveal-item style="--reveal-order: 0;">
          {{ image_with_text_hero_block }}
        </div>
        <div class="image-with-text__story-media image-with-text__story-media--detail" data-reveal-item style="--reveal-order: 1;">
          {{ image_with_text_detail_block }}
        </div>
        <div class="image-with-text__story-media image-with-text__story-media--portrait" data-reveal-item style="--reveal-order: 2;">
          {{ image_with_text_portrait_block }}
        </div>
        <div class="image-with-text__story-location" data-reveal-item style="--reveal-order: 3;">
          {{ image_with_text_location_label }}
        </div>
      </div>
    {% else %}
      <div class="image-with-text__media-collage">
        <div class="image-with-text__media image-with-text__media--base">
          {{ image_with_text_hero_block }}
        </div>
      </div>
    {% endif %}

    {% unless section.settings.layout == 'atelier-grid' %}
    <div class="image-with-text__content image-with-text__content--{{ section.settings.content_alignment }}">
      {% if image_with_text_has_section_header != blank %}
        <div class="image-with-text__section-header">
          {{ image_with_text_section_header }}
        </div>
      {% else %}
        {% unless section.settings.layout == 'story-collage' %}
          <div class="image-with-text__heading-block image-with-text__heading">
            {{ image_with_text_eyebrow }}
          </div>
        {% endunless %}
        <div class="image-with-text__heading-block image-with-text__heading">
          {{ image_with_text_heading }}
        </div>
        {% unless section.settings.layout == 'story-collage' %}
          <div class="image-with-text__heading-block image-with-text__heading">
            {{ image_with_text_highlight_heading }}
          </div>
        {% endunless %}
        <div class="image-with-text__text">
          {{ image_with_text_text }}
        </div>
        <div class="image-with-text__button-block">
          {{ image_with_text_button }}
        </div>
      {% endif %}
    </div>
    {% endunless %}

  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "image-with-text-section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "standard", "label": "Image and text" }, { "value": "story-collage", "label": "Story collage" }, { "value": "atelier-grid", "label": "Atelier grid" }], "default": "standard" },
    { "type": "select", "id": "media_position", "label": "Media position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "text_alignment", "id": "content_alignment", "label": "Content alignment", "default": "left" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }], "default": "page" },
    { "type": "range", "id": "column_gap", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Content column gap", "default": 40 },
    { "type": "range", "id": "story_collage_height", "min": 420, "max": 760, "step": 20, "unit": "px", "label": "Desktop collage height", "default": 580, "visible_if": "{{ section.settings.layout == 'story-collage' }}" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "background_color", "label": "Background color", "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme." },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "_section-header" }
  ],
  "enabled_on": { "templates": ["index", "product", "page"] },
  "presets": [
    {
      "name": "Image with text",
      "category": "Editorial content",
      "settings": {
        "layout": "standard",
        "media_position": "left",
        "content_alignment": "left",
        "section_width": "page",
        "column_gap": 64,
        "padding_top": 96,
        "padding_bottom": 96,
        "color_scheme": "scheme-1"
      },
      "blocks": [
        { "type": "media", "id": "hero_image", "static": true, "settings": { "ratio": "portrait" } },
        {
          "type": "_section-header",
          "id": "section_header",
          "static": true,
          "settings": { "content_alignment": "left", "content_width": 560 },
          "blocks": [
            { "type": "label", "settings": { "text": "<p>Savoir-faire</p>", "alignment": "left" } },
            { "type": "heading", "settings": { "heading": "<h2>The house know-how</h2>", "type_preset": "h3", "alignment": "left" } },
            { "type": "section-header-divider", "settings": { "height": 28 } },
            { "type": "text", "settings": { "text": "<p>From carbon line to articulated curve.</p>", "type_preset": "sm", "alignment": "left" } },
            { "type": "button", "settings": { "label": "Discover the story", "style": "tertiary", "icon": "button-arrow" } }
          ]
        }
      ]
    },
    {
      "name": "Image with text — Atelier grid",
      "category": "Editorial content",
      "settings": {
        "layout": "atelier-grid",
        "media_position": "left",
        "content_alignment": "left",
        "section_width": "page",
        "column_gap": 40,
        "padding_top": 96,
        "padding_bottom": 96,
        "color_scheme": "scheme-1"
      },
      "blocks": [
        { "type": "media", "id": "hero_image", "static": true, "settings": { "ratio": "landscape" } },
        { "type": "media", "id": "detail_image", "static": true, "settings": { "ratio": "square" } },
        { "type": "media", "id": "sketch_image", "static": true, "settings": { "ratio": "portrait" } },
        { "type": "media", "id": "portrait_image", "static": true, "settings": { "ratio": "landscape" } },
        { "type": "label", "id": "location_label", "static": true, "settings": { "text": "<p>Label</p>" } },
        { "type": "heading", "id": "meta_heading", "static": true, "settings": { "heading": "<h2>Made to last.</h2>", "type_preset": "h5" } },
        { "type": "text", "id": "meta_text", "static": true, "settings": { "text": "<p>Thoughtful details, refined for everyday rituals.</p>", "type_preset": "sm", "width": "100%" } },
        { "type": "label", "id": "copy_label", "static": true, "settings": { "text": "<p>Label</p>" } },
        { "type": "heading", "id": "highlight_heading", "static": true, "settings": { "heading": "<h2>Tell your story</h2>", "type_preset": "h4" } },
        { "type": "text", "id": "text", "static": true, "settings": { "text": "<p>Use this text to share information about your brand with your customers.</p>", "type_preset": "md", "width": "100%" } },
        { "type": "button", "id": "button", "static": true, "settings": { "label": "Learn more", "style": "primary" } },
        {
          "type": "_section-header",
          "id": "section_header",
          "static": true,
          "settings": { "content_alignment": "center", "content_width": 760 },
          "blocks": [
            { "type": "label", "settings": { "text": "<p>Savoir-faire</p>", "alignment": "center" } },
            { "type": "heading", "settings": { "heading": "<h2>The house know-how</h2>", "type_preset": "h3", "alignment": "center" } },
            { "type": "section-header-divider" },
            { "type": "text", "settings": { "text": "<p>From carbon line to articulated curve.</p>", "type_preset": "sm", "alignment": "center" } }
          ]
        }
      ]
    },
    {
      "name": "Image with text — Story collage",
      "category": "Editorial content",
      "settings": {
        "layout": "story-collage",
        "media_position": "left",
        "content_alignment": "left",
        "section_width": "page",
        "column_gap": 64,
        "story_collage_height": 580,
        "padding_top": 96,
        "padding_bottom": 96,
        "color_scheme": "scheme-1"
      },
      "blocks": [
        { "type": "media", "id": "hero_image", "static": true, "settings": { "ratio": "portrait" } },
        { "type": "media", "id": "detail_image", "static": true, "settings": { "ratio": "landscape" } },
        { "type": "media", "id": "portrait_image", "static": true, "settings": { "ratio": "portrait" } },
        { "type": "media", "id": "sketch_image", "static": true, "settings": { "ratio": "portrait" } },
        { "type": "label", "id": "location_label", "static": true, "settings": { "text": "<p>OUR STORY · MADE WITH INTENTION</p>", "reveal_type": "fade-up", "reveal_delay": 300 } },
        {
          "type": "_section-header",
          "id": "section_header",
          "static": true,
          "settings": { "content_alignment": "left", "content_width": 560 },
          "blocks": [
            { "type": "label", "settings": { "text": "<p>Savoir-faire</p>", "alignment": "left" } },
            { "type": "heading", "settings": { "heading": "<h2>Crafted for the<br>Quiet Hours</h2>", "type_preset": "h3", "alignment": "left" } },
            { "type": "section-header-divider", "settings": { "height": 28 } },
            { "type": "text", "settings": { "text": "<p>From carbon line to articulated curve.</p>", "type_preset": "sm", "alignment": "left" } }
          ]
        },
        { "type": "text", "id": "text", "static": true, "settings": { "text": "<p>Use this space to introduce your brand and the ideas behind your collection. Share the details, materials, or craft that make your work distinctive.</p><p>Keep the story concise and personal, then link customers to the page where they can learn more.</p>", "type_preset": "sm", "width": "100%", "reveal_type": "fade-up", "reveal_delay": 150 } },
        { "type": "button", "id": "button", "static": true, "settings": { "label": "Our story", "style": "secondary", "icon": "arrow-right", "reveal_type": "fade-up", "reveal_delay": 300 } }
      ]
    }
  ]
}
{% endschema %}
