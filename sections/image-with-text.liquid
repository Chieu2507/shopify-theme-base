{% render 'section-stylesheet', asset: 'section-image-with-text.css', defer_on_home: true %}

{% liquid
  assign media_count = section.blocks | where: 'type', 'media' | size
  assign content_count = section.blocks.size | minus: media_count
  assign primary_media = section.blocks | where: 'type', 'media' | first
%}

{% if media_count > 0 or content_count > 0 %}
  <section
    class="image-with-text image-with-text--media-{{ section.settings.media_position }} image-with-text--media-count-{{ media_count }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} image-with-text--full full-width{% endif %}"
    style="--image-with-text-column-gap: {{ section.settings.column_gap }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="image-with-text__inner section-spacing">
      {% if media_count > 0 %}
        <div
          class="image-with-text__media-collage image-with-text__media-collage--{{ primary_media.settings.desktop_image_ratio }} image-with-text__media-collage--mobile-{{ primary_media.settings.mobile_image_ratio }}"
          style="--image-with-text-collage-ratio: {{ primary_media.settings.image.aspect_ratio | default: 0.8 }};"
        >
          {% assign media_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'media' %}
              {% liquid
                assign media_index = media_index | plus: 1
                assign media_role = 'base'
                if media_index > 1
                  assign media_role = 'foreground'
                endif
                assign media_alt = block.settings.alt | default: block.settings.image.alt
                assign media_aria_label = media_alt
                if media_aria_label == blank
                  assign media_aria_label = 'accessibility.view_image' | t
                endif
                assign placeholder_asset = 'placeholder-image-default-1.svg'
                if media_role == 'foreground'
                  assign placeholder_asset = 'placeholder-image-default-2.svg'
                endif
              %}
              {% if block.settings.link != blank %}
                <a
                  href="{{ block.settings.link }}"
                  class="image-with-text__media image-with-text__media--{{ media_role }} image-with-text__media--{{ block.settings.desktop_image_ratio }} image-with-text__media--mobile-{{ block.settings.mobile_image_ratio }}"
                  style="--image-with-text-focal-point: {{ block.settings.focal_point }}; --image-with-text-media-ratio: {{ block.settings.image.aspect_ratio | default: 0.8 }};"
                  aria-label="{{ media_aria_label | escape }}"
                  {{ block.shopify_attributes }}
                >
              {% else %}
                <div
                  class="image-with-text__media image-with-text__media--{{ media_role }} image-with-text__media--{{ block.settings.desktop_image_ratio }} image-with-text__media--mobile-{{ block.settings.mobile_image_ratio }}"
                  style="--image-with-text-focal-point: {{ block.settings.focal_point }}; --image-with-text-media-ratio: {{ block.settings.image.aspect_ratio | default: 0.8 }};"
                  {{ block.shopify_attributes }}
                >
              {% endif %}
                  {% render 'responsive-media',
                    image: block.settings.image,
                    max_width: 1200,
                    widths: '320, 480, 640, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 42vw, (min-width: 750px) 48vw, 82vw',
                    class: 'image-with-text__image',
                    loading: 'lazy',
                    alt: media_alt,
                    placeholder_asset: placeholder_asset,
                    placeholder_class: 'image-with-text__placeholder'
                  %}
              {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if content_count > 0 %}
        <div class="image-with-text__content image-with-text__content--{{ section.settings.content_alignment }}">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'heading' %}
                {% if block.settings.heading != blank %}
                  {% assign heading_class = 'image-with-text__heading-block image-with-text__heading' %}
                  {% if block.settings.type_preset == 'subheading' %}
                    {% assign heading_class = 'image-with-text__subheading' %}
                  {% endif %}
                  <div class="{{ heading_class }}">
                    {% render 'typography-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h2', default_font: 'heading' %}
                  </div>
                {% endif %}

              {% when 'text' %}
                {% if block.settings.text != blank %}
                  <div class="image-with-text__text">
                    {% render 'typography-block', block: block, content: block.settings.text, kind: 'text', default_preset: 'paragraph', default_font: 'body' %}
                  </div>
                {% endif %}

              {% when 'button' %}
                {% if block.settings.label != blank and block.settings.link != blank %}
                  <div class="image-with-text__button-block" {{ block.shopify_attributes }}>
                    {% render 'cta', label: block.settings.label, url: block.settings.link, style: block.settings.style %}
                  </div>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}



{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "image-with-text-section",
  "max_blocks": 7,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 40
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Media",
      "limit": 2,
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "select",
          "id": "desktop_image_ratio",
          "label": "Desktop image ratio",
          "options": [
            {
              "value": "auto",
              "label": "Original"
            },
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            },
            {
              "value": "landscape",
              "label": "Landscape"
            }
          ],
          "default": "portrait"
        },
        {
          "type": "select",
          "id": "mobile_image_ratio",
          "label": "Mobile image ratio",
          "options": [
            {
              "value": "auto",
              "label": "Original"
            },
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            },
            {
              "value": "landscape",
              "label": "Landscape"
            }
          ],
          "default": "portrait"
        },
        {
          "type": "text",
          "id": "focal_point",
          "label": "Focal point",
          "default": "center center",
          "info": "Use CSS object-position, for example: 50% 40%."
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 2,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "t:typography_blocks.text",
          "default": "t:typography_defaults.heading"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.preset",
          "options": [
            {
              "value": "paragraph",
              "label": "t:typography_options.paragraph"
            },
            {
              "value": "subheading",
              "label": "t:typography_options.subheading"
            },
            {
              "value": "h1",
              "label": "t:typography_options.h1"
            },
            {
              "value": "h2",
              "label": "t:typography_options.h2"
            },
            {
              "value": "h3",
              "label": "t:typography_options.h3"
            },
            {
              "value": "h4",
              "label": "t:typography_options.h4"
            },
            {
              "value": "h5",
              "label": "t:typography_options.h5"
            },
            {
              "value": "h6",
              "label": "t:typography_options.h6"
            }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "color",
          "label": "t:typography_blocks.color",
          "options": [
            {
              "value": "text",
              "label": "t:typography_options.text"
            },
            {
              "value": "subtext",
              "label": "t:typography_options.subtext"
            }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        },
        {
          "type": "header",
          "content": "t:typography_blocks.layout"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:typography_blocks.width",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "t:typography_blocks.width_mobile",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "text_alignment",
          "id": "alignment",
          "label": "t:typography_blocks.alignment",
          "default": "left",
          "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:typography_blocks.text",
          "default": "<p>We select materials for their character and durability, creating pieces designed to be used every day.</p>"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.preset",
          "options": [
            {
              "value": "paragraph",
              "label": "t:typography_options.paragraph"
            },
            {
              "value": "subheading",
              "label": "t:typography_options.subheading"
            },
            {
              "value": "h1",
              "label": "t:typography_options.h1"
            },
            {
              "value": "h2",
              "label": "t:typography_options.h2"
            },
            {
              "value": "h3",
              "label": "t:typography_options.h3"
            },
            {
              "value": "h4",
              "label": "t:typography_options.h4"
            },
            {
              "value": "h5",
              "label": "t:typography_options.h5"
            },
            {
              "value": "h6",
              "label": "t:typography_options.h6"
            }
          ],
          "default": "paragraph"
        },
        {
          "type": "select",
          "id": "color",
          "label": "t:typography_blocks.color",
          "options": [
            {
              "value": "text",
              "label": "t:typography_options.text"
            },
            {
              "value": "subtext",
              "label": "t:typography_options.subtext"
            }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Read more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "tertiary",
              "label": "Tertiary"
            }
          ],
          "default": "tertiary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "category": "Editorial content",
      "blocks": [
        {
          "type": "media"
        },
        {
          "type": "media"
        },
        {
          "type": "heading",
          "settings": {
            "heading": "<p>Our mission</p>",
            "type_preset": "subheading"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "<h2>More Than Beauty, A Philosophy</h2>",
            "type_preset": "h2"
          }
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
