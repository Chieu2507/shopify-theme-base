{% unless section.settings.layout == 'marquee' %}
  {% render 'swiper-stylesheet' %}
{% endunless %}

{% comment %}
  Keep the announcement-bar destinations optional in Shopify's global Footer
  settings. These fallbacks keep the social icons linked when those settings
  are still blank, without adding required URL settings to this section.
{% endcomment %}

{% liquid
  assign announcement_item_count = 0

  for block in section.blocks
    case block.type
      when 'text_slide'
        if block.settings.text != blank
          assign announcement_item_count = announcement_item_count | plus: 1
        endif
    endcase
  endfor

  assign announcement_x_url = settings.x_url | default: 'https://x.com'
  assign announcement_facebook_url = settings.facebook_url | default: 'https://www.facebook.com'
  assign announcement_pinterest_url = settings.pinterest_url | default: 'https://www.pinterest.com'
  assign announcement_instagram_url = settings.instagram_url | default: 'https://www.instagram.com'
  assign announcement_social_count = 4
  assign announcement_layout = section.settings.layout | default: 'slider'
  assign announcement_module = 'section-announcement-bar.js'
  assign show_side_content = false

  if announcement_layout == 'marquee'
    assign announcement_module = 'section-marquee.js'
  elsif section.settings.section_width == 'page'
    assign show_side_content = true
  endif

  assign show_navigation = false
  if announcement_layout == 'slider' and announcement_item_count > 1
    assign show_navigation = true
  endif

  assign announcement_total_display = announcement_item_count
  if announcement_item_count < 10
    assign announcement_total_display = '0' | append: announcement_item_count
  endif
%}

{% if section.blocks.size > 0 %}
  <announcement-bar
    class="announcement-bar announcement-bar--{{ announcement_layout }} announcement-bar--{{ section.settings.section_width | default: 'full' }} color-scheme color-{{ section.settings.color_scheme.id }} full-width"
    style="--announcement-bar-height: {{ section.settings.height_desktop }}px; --announcement-bar-height-mobile: {{ section.settings.height_mobile }}px;"
    data-section-id="{{ section.id }}"
    data-behavior="{% if section.settings.enable_rotation %}rotate{% else %}show_all{% endif %}"
    data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
    data-layout="{{ announcement_layout }}"
    data-deferred-module="{{ announcement_module | asset_url }}"
    aria-label="{{ 'announcement_bar.announcement' | t | escape }}"
  >
    <div class="announcement-bar__inner{% if show_side_content %} announcement-bar__inner--contained{% endif %}">
      {% if announcement_layout == 'marquee' %}
        <theme-marquee
          class="announcement-bar__marquee marquee marquee--direction-{{ section.settings.marquee_direction }}{% if section.settings.marquee_pause_on_hover %} marquee--pause-on-hover{% endif %}"
          style="--marquee-duration: {{ section.settings.marquee_speed }}s; --marquee-item-gap: 32px; --marquee-min-height: var(--announcement-bar-height); --marquee-min-height-mobile: var(--announcement-bar-height-mobile); --marquee-item-alignment: center;"
        >
          <div class="marquee__viewport">
            <div class="marquee__track">
              <div class="marquee__group">
                {% for block in section.blocks %}
                  {% if block.type == 'text_slide' and block.settings.text != blank %}
                    <div class="announcement-bar__marquee-item" {{ block.shopify_attributes }}>
                      {% render 'typography-block',
                        block: block,
                        content: block.settings.text,
                        kind: 'text',
                        default_preset: 'paragraph',
                        default_font: 'body',
                        include_shopify_attributes: false
                      %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </theme-marquee>
      {% else %}
      {% if show_side_content and announcement_social_count > 0 %}
        <nav class="announcement-bar__social" aria-label="{{ 'footer.social_links' | t | escape }}">
          <ul class="announcement-bar__social-list" role="list">
            {% if announcement_x_url != blank %}
              <li>
                <a class="announcement-bar__social-link" href="{{ announcement_x_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.x_twitter' | t | escape }}">
                  {% render 'social-icon', name: 'x' %}
                </a>
              </li>
            {% endif %}
            {% if announcement_facebook_url != blank %}
              <li>
                <a class="announcement-bar__social-link" href="{{ announcement_facebook_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.facebook' | t | escape }}">
                  {% render 'social-icon', name: 'facebook' %}
                </a>
              </li>
            {% endif %}
            {% if announcement_pinterest_url != blank %}
              <li>
                <a class="announcement-bar__social-link" href="{{ announcement_pinterest_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.pinterest' | t | escape }}">
                  {% render 'social-icon', name: 'pinterest' %}
                </a>
              </li>
            {% endif %}
            {% if announcement_instagram_url != blank %}
              <li>
                <a class="announcement-bar__social-link" href="{{ announcement_instagram_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.instagram' | t | escape }}">
                  {% render 'social-icon', name: 'instagram' %}
                </a>
              </li>
            {% endif %}
          </ul>
        </nav>
      {% endif %}

      {% if announcement_item_count > 0 %}
        <div class="announcement-bar__content">
          <div class="announcement-bar__message-row{% if show_navigation %} announcement-bar__message-row--with-controls{% endif %}"{% if show_navigation %} data-announcement-navigator{% endif %}>
            {% if show_navigation %}
              <nav class="announcement-bar__navigator" aria-label="{{ 'announcement_bar.slide_navigation' | t | escape }}">
                <button class="announcement-bar__navigator-arrow" type="button" data-announcement-step="-1" aria-label="{{ 'announcement_bar.previous_slide' | t | escape }}">
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m9.5 3-5 5 5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
                </button>
              </nav>
              <span class="announcement-bar__counter announcement-bar__counter--spacer" aria-hidden="true">
                <span>01</span><span aria-hidden="true"> / </span><span>{{ announcement_total_display }}</span>
              </span>
            {% endif %}

            <div class="announcement-bar__messages swiper" data-announcement-slider aria-live="polite">
              <div class="announcement-bar__slides swiper-wrapper">
                {% assign announcement_item_index = 0 %}
                {% for block in section.blocks %}
                  {% case block.type %}
                    {% when 'text_slide' %}
                      {% if block.settings.text != blank %}
                        <div
                          class="announcement-bar__item swiper-slide"
                          data-announcement-item
                          data-block-id="{{ block.id }}"
                          data-swiper-slide-index="{{ announcement_item_index }}"
                          {{ block.shopify_attributes }}
                        >
                          {% render 'typography-block',
                            block: block,
                            content: block.settings.text,
                            kind: 'text',
                            default_preset: 'paragraph',
                            default_font: 'body',
                            include_shopify_attributes: false
                          %}
                        </div>
                        {% assign announcement_item_index = announcement_item_index | plus: 1 %}
                      {% endif %}
                  {% endcase %}
                {% endfor %}
              </div>
            </div>

            {% if show_navigation %}
              <span class="announcement-bar__counter" aria-hidden="true">
                <span data-announcement-current>01</span><span aria-hidden="true"> / </span><span data-announcement-total>{{ announcement_total_display }}</span>
              </span>
              <nav class="announcement-bar__navigator" aria-label="{{ 'announcement_bar.slide_navigation' | t | escape }}">
                <button class="announcement-bar__navigator-arrow" type="button" data-announcement-step="1" aria-label="{{ 'announcement_bar.next_slide' | t | escape }}">
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m6.5 3 5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
                </button>
              </nav>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if show_side_content and section.settings.appointment_label != blank %}
        {% if section.settings.appointment_link != blank %}
          <a class="announcement-bar__appointment" href="{{ section.settings.appointment_link | escape }}">
            {{ section.settings.appointment_label | escape }} <span aria-hidden="true">↗</span>
          </a>
        {% else %}
          <span class="announcement-bar__appointment">
            {{ section.settings.appointment_label | escape }} <span aria-hidden="true">↗</span>
          </span>
        {% endif %}
      {% endif %}
      {% endif %}
    </div>
  </announcement-bar>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    position: relative;
    z-index: 22;
    display: block;
    width: 100%;
    min-height: var(--announcement-bar-height);
    background: var(--color-secondary-button, var(--gradient-background, var(--color-background)));
    color: var(--color-secondary-button-label, var(--color-text));
    font-family: var(--font-body--family);
    font-size: var(--spinel-type-size-label);
    line-height: var(--spinel-type-line-label);
    letter-spacing: var(--spinel-type-tracking-label);
    text-transform: uppercase;
  }

  .announcement-bar__inner {
    position: relative;
    display: grid;
    min-height: var(--announcement-bar-height);
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    padding-inline: 24px;
  }

  .announcement-bar__inner--contained {
    width: min(100%, var(--page-width));
    margin-inline: auto;
  }

  .announcement-bar--full .announcement-bar__inner {
    grid-template-columns: minmax(0, 1fr);
  }

  .announcement-bar__content {
    display: block;
    min-width: 0;
    grid-column: 2;
    grid-row: 1;
    text-align: center;
  }

  .announcement-bar--full .announcement-bar__content {
    width: 100%;
    grid-column: 1;
  }

  .announcement-bar--full .announcement-bar__message-row {
    display: grid;
    grid-template-columns: max-content max-content minmax(0, 1fr) max-content max-content;
  }

  .announcement-bar--full .announcement-bar__messages { width: 100%; }

  .announcement-bar--marquee .announcement-bar__inner {
    display: block;
    overflow: hidden;
    padding-inline: 0;
  }

  .announcement-bar__marquee,
  .announcement-bar__marquee .marquee__viewport {
    display: block;
    width: 100%;
    min-height: var(--announcement-bar-height-mobile);
    overflow: hidden;
  }

  .announcement-bar__marquee .marquee__track,
  .announcement-bar__marquee .marquee__group {
    display: flex;
    width: max-content;
    min-height: inherit;
    align-items: center;
  }

  .announcement-bar__marquee .marquee__track {
    gap: var(--marquee-item-gap);
    animation: announcement-bar-marquee-scroll var(--marquee-duration) linear infinite;
    animation-play-state: paused;
    will-change: transform;
  }

  .announcement-bar__marquee .marquee__group {
    flex-shrink: 0;
    gap: var(--marquee-item-gap);
  }

  .announcement-bar__marquee.is-active .marquee__track { animation-play-state: running; }
  .announcement-bar__marquee.marquee--direction-right .marquee__track { animation-direction: reverse; }
  .announcement-bar__marquee.marquee--pause-on-hover:hover .marquee__track,
  .announcement-bar__marquee.marquee--pause-on-hover:focus-within .marquee__track { animation-play-state: paused; }

  .announcement-bar__marquee-item {
    display: block;
    flex-shrink: 0;
    padding-inline: 4px;
    color: inherit;
    overflow: hidden;
  }

  .announcement-bar__marquee-item .typography-block__content,
  .announcement-bar__item .typography-block__content {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .announcement-bar__marquee-item .typography-block__content > p,
  .announcement-bar__item .typography-block__content > p {
    display: inline;
  }

  @keyframes announcement-bar-marquee-scroll {
    to { transform: translateX(calc(-50% - var(--marquee-item-gap) / 2)); }
  }

  .announcement-bar__appointment {
    min-width: 0;
    overflow: hidden;
    color: inherit;
    font-size: inherit;
    font-weight: 500;
    line-height: inherit;
    letter-spacing: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .announcement-bar__social { grid-column: 1; justify-self: start; }
  .announcement-bar__appointment { grid-column: 3; justify-self: end; }
  a.announcement-bar__appointment { cursor: pointer; }
  .announcement-bar__appointment:hover { text-decoration: underline; text-underline-offset: 3px; }
  .announcement-bar__appointment:focus-visible { outline: 1px solid currentcolor; outline-offset: 3px; }

  .announcement-bar__social-list {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .announcement-bar__social-link {
    display: inline-flex;
    width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
    color: inherit;
    transition: opacity 180ms ease;
  }

  .announcement-bar__social-link svg {
    display: block;
    width: 16px;
    height: 16px;
  }

  .announcement-bar__social-link:hover { opacity: 0.72; }
  .announcement-bar__social-link:focus-visible { outline: 1px solid currentcolor; outline-offset: 3px; }

  .announcement-bar__message-row {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .announcement-bar__messages {
    width: min(62vw, 560px);
    height: var(--announcement-bar-height);
    min-width: 0;
  }

  .announcement-bar__slides {
    align-items: center;
  }

  .announcement-bar__messages.swiper-vertical .announcement-bar__item {
    opacity: 0;
    pointer-events: none;
    transition-property: opacity;
    transition-duration: var(--announcement-bar-transition-duration, 420ms);
    transition-timing-function: ease;
    will-change: opacity;
  }

  .announcement-bar__messages.swiper-vertical .announcement-bar__item.swiper-slide-active {
    pointer-events: auto;
    opacity: 1;
  }

  .announcement-bar__messages .announcement-bar__item {
    display: flex;
    width: 100%;
    height: 100%;
    min-width: 0;
    align-items: center;
    justify-content: center;
    padding-inline: 4px;
    color: inherit;
    overflow: hidden;
  }

  .announcement-bar__item > .typography-block {
    min-width: 0;
    overflow: hidden;
  }

  .announcement-bar__item .typography-block__content {
    width: 100%;
    text-align: center;
  }

  .announcement-bar__navigator {
    display: contents;
  }

  .announcement-bar__navigator-arrow {
    display: grid;
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    place-items: center;
    opacity: 0.8;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .announcement-bar__navigator-arrow:hover {
    opacity: 1;
    transform: scale(1.06);
  }

  .announcement-bar__navigator-arrow svg { width: 12px; height: 12px; }

  .announcement-bar__navigator-arrow:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .announcement-bar__counter {
    color: var(--color-secondary-button-outline, currentcolor);
    font-size: var(--spinel-type-size-label);
    font-variant-numeric: tabular-nums;
    line-height: var(--spinel-type-line-label);
    letter-spacing: var(--spinel-type-tracking-label);
    white-space: nowrap;
  }

  .announcement-bar__counter--spacer { visibility: hidden; }

  @media (max-width: 899px) {
    .announcement-bar__social,
    .announcement-bar__appointment { display: none; }
  }

  @media (max-width: 749px) {
    .announcement-bar,
    .announcement-bar__inner {
      min-height: var(--announcement-bar-height-mobile);
    }

    .announcement-bar__inner {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: 12px;
    }

    .announcement-bar__content {
      width: 100%;
      grid-column: 1;
      overflow: hidden;
    }

    .announcement-bar__messages {
      width: calc(100vw - 124px);
      height: var(--announcement-bar-height-mobile);
    }

    .announcement-bar__message-row { gap: 8px; }

    .announcement-bar__navigator-arrow { width: 24px; height: 24px; flex-basis: 24px; }
    .announcement-bar__navigator-arrow svg { width: 10px; height: 10px; }
    .announcement-bar__counter { font-size: 9px; }
  }

  @media screen and (min-width: 750px) {
    .announcement-bar__marquee,
    .announcement-bar__marquee .marquee__viewport { min-height: var(--announcement-bar-height); }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__navigator-arrow,
    .announcement-bar__messages.swiper-vertical .announcement-bar__item,
    .announcement-bar__marquee .marquee__track {
      transition: none;
      animation-play-state: paused;
    }
  }
{% endstylesheet %}


{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Theme information"
    },
    {
      "type": "paragraph",
      "content": "Social icons display only when Type is set to Slider and Section width is set to Page width."
    },
    {
      "type": "header",
      "content": "Content",
      "visible_if": "{{ section.settings.layout == 'slider' and section.settings.section_width == 'page' }}"
    },
    {
      "type": "text",
      "id": "appointment_label",
      "label": "Right link label",
      "default": "PRIVATE APPOINTMENTS",
      "visible_if": "{{ section.settings.layout == 'slider' and section.settings.section_width == 'page' }}"
    },
    {
      "type": "url",
      "id": "appointment_link",
      "label": "Right link",
      "visible_if": "{{ section.settings.layout == 'slider' and section.settings.section_width == 'page' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Type",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "marquee",
          "label": "Infinite marquee"
        }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full",
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "header",
      "content": "Slider behavior",
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_rotation",
      "label": "Rotate",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 5,
      "visible_if": "{{ section.settings.layout == 'slider' and section.settings.enable_rotation }}"
    },
    {
      "type": "header",
      "content": "Marquee behavior",
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Marquee direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Marquee duration",
      "default": 35,
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "marquee_pause_on_hover",
      "label": "Pause marquee on hover or focus",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 37,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Desktop height",
      "default": 37
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 32,
      "max": 52,
      "step": 1,
      "unit": "px",
      "label": "Mobile height",
      "default": 32
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "text_slide",
      "name": "Text slide",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:typography_blocks.text",
          "default": "<p>Shipping options and pricing are calculated at checkout.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "category": "Marketing",
      "settings": {
        "appointment_label": "PRIVATE APPOINTMENTS",
        "height_desktop": 37,
        "height_mobile": 32,
        "color_scheme": "scheme-3"
      },
      "blocks": [
        { "type": "text_slide" }
      ]
    }
  ]
}
{% endschema %}
