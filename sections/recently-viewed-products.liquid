<section class="recently-viewed-products" data-section-id="{{ section.id }}" data-recently-viewed data-limit="{{ section.settings.limit }}" hidden>
  {% if section.settings.heading != blank %}
    <{{ section.settings.heading_tag | default: 'h2' }} class="recently-viewed-products__heading omnise-heading--{{ section.settings.heading_size | default: 'lg' }} heading--{{ section.settings.heading_size | default: 'lg' }}">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag | default: 'h2' }}>
  {% endif %}
  <div class="recently-viewed-products__list" data-recently-viewed-list></div>
</section>
{% schema %}
{
  "name": "Recently viewed products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "XX-large"
        },
        {
          "value": "h2",
          "label": "X-large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Recently viewed products",
      "category": "Product discovery"
    }
  ]
}
{% endschema %}
