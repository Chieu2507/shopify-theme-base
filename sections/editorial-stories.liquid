{% render 'section-stylesheet', asset: 'section-editorial-stories.css', defer_on_home: true %}
{% liquid
  assign all_posts_url = section.settings.button_link
  if all_posts_url == blank and section.settings.blog != blank
    assign all_posts_url = section.settings.blog.url
  endif
%}

<section class="np-stories full-width color-scheme color-{{ section.settings.color_scheme.id }}">
  <div class="np-stories__inner">
    <header class="np-stories__header">
      <div class="np-stories__heading-group">
        {% if section.settings.eyebrow != blank %}
          <p class="np-stories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="np-stories__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
      {% render 'cta',
        label: section.settings.button_label,
        url: all_posts_url,
        style: 'tertiary',
        class: 'np-stories__all-posts np-stories__all-posts--desktop'
      %}
    </header>

    <div class="np-stories__grid">
      {% for block in section.blocks %}
        {% liquid
          assign story_article = block.settings.article
          assign story_image = block.settings.image | default: story_article.image
          assign story_title = block.settings.title_override | default: story_article.title
          assign story_category = block.settings.category
          if story_category == blank and story_article != blank
            assign story_category = story_article.tags | first
          endif
          assign story_author = block.settings.author_override | default: story_article.author
          assign story_date = block.settings.date_override
          if story_date == blank and story_article != blank
            assign story_date = story_article.published_at | date: '%d %b %Y'
          endif
          assign story_url = block.settings.link | default: story_article.url
          assign story_alt = block.settings.image_alt | default: story_image.alt | default: story_title
        %}
        <article class="np-stories__card" {{ block.shopify_attributes }}>
          <div class="np-stories__media">
            {% if story_url != blank %}<a class="np-stories__media-link" href="{{ story_url }}" aria-label="{{ story_title | escape }}">{% endif %}
              {% if story_image != blank %}
                {% render 'responsive-image',
                  image: story_image,
                  max_width: 1200,
                  widths: '343, 480, 600, 750, 900, 1035, 1200',
                  sizes: '(min-width: 1200px) calc((min(100vw - 320px, 1600px) - 48px) / 3), (min-width: 750px) calc((100vw - 80px) / 2), calc(100vw - 32px)',
                  class: 'np-stories__image',
                  loading: 'lazy',
                  alt: story_alt
                %}
              {% else %}
                {% render 'media-placeholder', class_name: 'np-stories__placeholder', asset_name: 'placeholder-image-default-1.svg' %}
              {% endif %}
            {% if story_url != blank %}</a>{% endif %}
          </div>

          <div class="np-stories__info">
            <div class="np-stories__copy">
              {% if story_category != blank %}
                <p class="np-stories__category">{{ story_category | escape }}</p>
              {% endif %}
              {% if story_title != blank %}
                <h3 class="np-stories__title">
                  {% if story_url != blank %}<a href="{{ story_url }}">{% endif %}
                    {{ story_title | escape }}
                  {% if story_url != blank %}</a>{% endif %}
                </h3>
              {% endif %}
            </div>

            {% if story_author != blank or story_date != blank %}
              <p class="np-stories__meta">
                {% if story_author != blank %}<span>{{ story_author | escape }}</span>{% endif %}
                {% if story_author != blank and story_date != blank %}<span class="np-stories__meta-divider" aria-hidden="true"></span>{% endif %}
                {% if story_date != blank %}<span>{{ story_date | escape }}</span>{% endif %}
              </p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% render 'cta',
      label: section.settings.button_label,
      url: all_posts_url,
      style: 'tertiary',
      class: 'np-stories__all-posts np-stories__all-posts--mobile'
    %}
  </div>
</section>


{% schema %}
{
  "name": "Editorial stories",
  "tag": "section",
  "class": "section-noryvelle-stories",
  "max_blocks": 3,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Discover"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our stories"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "All posts"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link override"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category override"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "author_override",
          "label": "Author override"
        },
        {
          "type": "text",
          "id": "date_override",
          "label": "Date override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial stories",
      "category": "Editorial content",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "category": "Trending",
            "title_override": "Pastel Revival: A Subtle Statement of Power",
            "author_override": "Mia Torres",
            "date_override": "08 Oct 2025"
          }
        },
        {
          "type": "story",
          "settings": {
            "category": "Story",
            "title_override": "Behind the Craft: Inside the Atelier of MĀRA",
            "author_override": "Harper Lin",
            "date_override": "30 Sep 2025"
          }
        },
        {
          "type": "story",
          "settings": {
            "category": "Collections",
            "title_override": "The Essence of Minimal Luxury: MĀRA Fall/Winter 2025",
            "author_override": "Eleanor Hart",
            "date_override": "15 Sep 2025"
          }
        }
      ]
    }
  ]
}
{% endschema %}
