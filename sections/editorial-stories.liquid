{% liquid
  assign all_posts_url = section.settings.button_link
  if all_posts_url == blank and section.settings.blog != blank
    assign all_posts_url = section.settings.blog.url
  endif
%}

<section class="np-stories full-width color-scheme color-{{ section.settings.color_scheme.id }}">
  <div class="np-stories__inner">
    <header class="np-stories__header">
      <div class="np-stories__heading-group">
        {% if section.settings.eyebrow != blank %}
          <p class="np-stories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="np-stories__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
      {% render 'cta',
        label: section.settings.button_label,
        url: all_posts_url,
        style: 'tertiary',
        class: 'np-stories__all-posts np-stories__all-posts--desktop'
      %}
    </header>

    <div class="np-stories__grid">
      {% for block in section.blocks %}
        {% liquid
          assign story_article = block.settings.article
          assign story_image = block.settings.image | default: story_article.image
          assign story_title = block.settings.title_override | default: story_article.title
          assign story_category = block.settings.category
          if story_category == blank and story_article != blank
            assign story_category = story_article.tags | first
          endif
          assign story_author = block.settings.author_override | default: story_article.author
          assign story_date = block.settings.date_override
          if story_date == blank and story_article != blank
            assign story_date = story_article.published_at | date: '%d %b %Y'
          endif
          assign story_url = block.settings.link | default: story_article.url
          assign story_alt = block.settings.image_alt | default: story_image.alt | default: story_title
        %}
        <article class="np-stories__card" {{ block.shopify_attributes }}>
          <div class="np-stories__media">
            {% if story_url != blank %}<a class="np-stories__media-link" href="{{ story_url }}" aria-label="{{ story_title | escape }}">{% endif %}
              {% if story_image != blank %}
                {% render 'responsive-image',
                  image: story_image,
                  max_width: 1200,
                  widths: '343, 480, 600, 750, 900, 1035, 1200',
                  sizes: '(min-width: 1200px) calc((min(100vw - 320px, 1600px) - 48px) / 3), (min-width: 750px) calc((100vw - 80px) / 2), calc(100vw - 32px)',
                  class: 'np-stories__image',
                  loading: 'lazy',
                  alt: story_alt
                %}
              {% else %}
                {% render 'media-placeholder', class_name: 'np-stories__placeholder', asset_name: 'placeholder-image-default-1.svg' %}
              {% endif %}
            {% if story_url != blank %}</a>{% endif %}
          </div>

          <div class="np-stories__info">
            <div class="np-stories__copy">
              {% if story_category != blank %}
                <p class="np-stories__category">{{ story_category | escape }}</p>
              {% endif %}
              {% if story_title != blank %}
                <h3 class="np-stories__title">
                  {% if story_url != blank %}<a href="{{ story_url }}">{% endif %}
                    {{ story_title | escape }}
                  {% if story_url != blank %}</a>{% endif %}
                </h3>
              {% endif %}
            </div>

            {% if story_author != blank or story_date != blank %}
              <p class="np-stories__meta">
                {% if story_author != blank %}<span>{{ story_author | escape }}</span>{% endif %}
                {% if story_author != blank and story_date != blank %}<span class="np-stories__meta-divider" aria-hidden="true"></span>{% endif %}
                {% if story_date != blank %}<span>{{ story_date | escape }}</span>{% endif %}
              </p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% render 'cta',
      label: section.settings.button_label,
      url: all_posts_url,
      style: 'tertiary',
      class: 'np-stories__all-posts np-stories__all-posts--mobile'
    %}
  </div>
</section>

{% stylesheet %}
  .np-stories {
    display: block;
    padding: 96px 0;
    background: var(--color-background, #fff);
    color: #181818;
  }

  .np-stories__inner {
    display: flex;
    width: min(1600px, calc(100% - 96px));
    flex-direction: column;
    gap: 40px;
    margin: 0 auto;
  }

  .np-stories__header {
    display: flex;
    min-height: 67px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .np-stories__heading-group {
    display: flex;
    width: min(734px, 100%);
    flex-direction: column;
    gap: 8px;
  }

  .np-stories__eyebrow,
  .np-stories__heading {
    margin: 0;
    color: #181818;
    text-transform: uppercase;
  }

  .np-stories__eyebrow {
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-style: var(--font-heading--style);
    font-weight: 400;
    letter-spacing: 2px;
    line-height: 1.5;
  }

  .np-stories__heading {
    font-family: var(--font-heading--family);
    font-size: 32px;
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    letter-spacing: 2px;
    line-height: 1.2;
  }

  .np-stories__all-posts {
    color: #1e1e1e;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.6px;
    line-height: 1.5;
  }

  .np-stories__all-posts--mobile {
    display: none;
  }

  .np-stories__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .np-stories__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 20px;
    overflow: hidden;
  }

  .np-stories__media {
    width: 100%;
    overflow: hidden;
    aspect-ratio: 6 / 7;
    background: #f6f6f6;
  }

  .np-stories__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .np-stories__image,
  .np-stories__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .np-stories__media-link:focus-visible {
    outline: 2px solid #181818;
    outline-offset: -3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .np-stories__media-link:hover .np-stories__image {
      transform: scale(1.01);
    }
  }

  .np-stories__info {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .np-stories__copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .np-stories__category,
  .np-stories__title,
  .np-stories__meta {
    margin: 0;
  }

  .np-stories__category {
    color: #808080;
    font-family: var(--font-heading--family);
    font-size: 12px;
    font-style: var(--font-heading--style);
    font-weight: 500;
    letter-spacing: 1px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .np-stories__title {
    color: #181818;
    font-family: var(--font-heading--family);
    font-size: 20px;
    font-style: var(--font-heading--style);
    font-weight: 500;
    letter-spacing: 0.2px;
    line-height: 1.4;
  }

  .np-stories__title a {
    color: inherit;
    text-decoration: none;
  }

  .np-stories__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .np-stories__title a:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .np-stories__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #808080;
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-style: var(--font-heading--style);
    font-weight: 400;
    letter-spacing: 0.2px;
    line-height: 1.5;
  }

  .np-stories__meta-divider {
    width: 1px;
    height: 12px;
    background: #808080;
  }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .np-stories {
      padding: 64px 0;
    }

    .np-stories__inner {
      width: calc(100% - 60px);
    }

    .np-stories__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .np-stories {
      padding: 56px 0;
    }

    .np-stories__inner {
      width: calc(100% - 32px);
      align-items: center;
      gap: 28px;
    }

    .np-stories__header {
      min-height: 62px;
      justify-content: center;
      text-align: center;
    }

    .np-stories__heading-group {
      width: 100%;
      align-items: center;
      gap: 12px;
    }

    .np-stories__heading {
      font-size: 24px;
    }

    .np-stories__all-posts--desktop {
      display: none;
    }

    .np-stories__all-posts--mobile {
      display: inline-flex;
    }

    .np-stories__grid {
      width: 100%;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .np-stories__card {
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial stories",
  "tag": "section",
  "class": "section-noryvelle-stories",
  "max_blocks": 3,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Discover"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our stories"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "All posts"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link override"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category override"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "author_override",
          "label": "Author override"
        },
        {
          "type": "text",
          "id": "date_override",
          "label": "Date override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial stories",
      "category": "Editorial content",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "category": "Trending",
            "title_override": "Pastel Revival: A Subtle Statement of Power",
            "author_override": "Mia Torres",
            "date_override": "08 Oct 2025"
          }
        },
        {
          "type": "story",
          "settings": {
            "category": "Story",
            "title_override": "Behind the Craft: Inside the Atelier of MĀRA",
            "author_override": "Harper Lin",
            "date_override": "30 Sep 2025"
          }
        },
        {
          "type": "story",
          "settings": {
            "category": "Collections",
            "title_override": "The Essence of Minimal Luxury: MĀRA Fall/Winter 2025",
            "author_override": "Eleanor Hart",
            "date_override": "15 Sep 2025"
          }
        }
      ]
    }
  ]
}
{% endschema %}
