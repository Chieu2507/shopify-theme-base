{% render 'section-stylesheet', asset: 'section-shop-the-look.css', defer_on_home: true %}

{% liquid
  assign product_block_count = 0
  assign mobile_media_aspect_ratio = section.settings.mobile_image.aspect_ratio | default: section.settings.image.aspect_ratio | default: 1
  for block in section.blocks
    if block.type == 'product_hotspot'
      assign product_block_count = product_block_count | plus: 1
    endif
  endfor
%}

{% if product_block_count > 0 %}
  <shop-the-look
    data-deferred-module="{{ 'shop-the-look.js' | asset_url }}"
    class="shop-the-look color-scheme color-{{ section.settings.color_scheme.id }} full-width shop-the-look--media-{{ section.settings.media_position }}"
    style="--shop-the-look-height: {{ section.settings.height_desktop }}px; --shop-the-look-height-mobile: {{ section.settings.height_mobile }}px; --shop-the-look-content-padding: {{ section.settings.content_padding }}px; --shop-the-look-product-image-size: {{ section.settings.product_image_size }}px; --shop-the-look-mobile-media-ratio: {{ mobile_media_aspect_ratio }};"
  >
    <div class="shop-the-look__layout">
      <div class="shop-the-look__media-column">
        <div class="shop-the-look__visual">
          {% liquid
            assign editorial_image = section.settings.image | default: section.settings.mobile_image
            assign editorial_image_alt = editorial_image.alt
            assign mobile_focal_point = section.settings.mobile_focal_point
            if section.settings.mobile_image == blank or mobile_focal_point == blank
              assign mobile_focal_point = section.settings.focal_point
            endif
            capture editorial_image_style
              echo '--shop-the-look-desktop-focal-point: ' | append: section.settings.focal_point | append: '; '
              echo '--shop-the-look-mobile-focal-point: ' | append: mobile_focal_point | append: ';'
            endcapture
            if editorial_image_alt == blank
              assign editorial_image_alt = 'shop_the_look.editorial_image' | t
            endif
          %}
          <div class="shop-the-look__media">
            {% render 'responsive-media',
              image: editorial_image,
              mobile_image: section.settings.mobile_image,
              mobile_breakpoint: 989,
              max_width: 1920,
              mobile_max_width: 1200,
              widths: '480, 720, 960, 1200, 1440, 1920',
              mobile_widths: '360, 480, 640, 750, 960, 1200',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'shop-the-look__editorial-image',
              loading: 'lazy',
              alt: editorial_image_alt,
              style: editorial_image_style,
              placeholder_asset: 'placeholder-image-default-2.svg',
              placeholder_class: 'shop-the-look__placeholder'
            %}
          </div>

          <div class="shop-the-look__hotspots" role="tablist" aria-label="{{ 'shop_the_look.products' | t | escape }}">
            {% assign hotspot_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'product_hotspot' %}
                {% liquid
                  assign hotspot_label = block.settings.product.title
                  assign mobile_hotspot_x = block.settings.horizontal_position
                  assign mobile_hotspot_y = block.settings.vertical_position
                  if block.settings.enable_mobile_position
                    assign mobile_hotspot_x = block.settings.mobile_horizontal_position
                    assign mobile_hotspot_y = block.settings.mobile_vertical_position
                  endif
                  if hotspot_label == blank
                    assign hotspot_label = 'shop_the_look.product' | t
                  endif
                %}
                <button
                  class="shop-the-look__hotspot"
                  type="button"
                  role="tab"
                  id="ShopTheLookHotspot-{{ section.id }}-{{ block.id }}"
                  aria-controls="ShopTheLookProduct-{{ section.id }}-{{ block.id }}"
                  aria-label="{{ 'shop_the_look.select_product' | t: product: hotspot_label | escape }}"
                  aria-selected="{% if hotspot_index == 0 %}true{% else %}false{% endif %}"
                  tabindex="{% if hotspot_index == 0 %}0{% else %}-1{% endif %}"
                  style="--hotspot-x: {{ block.settings.horizontal_position }}%; --hotspot-y: {{ block.settings.vertical_position }}%; --hotspot-mobile-x: {{ mobile_hotspot_x }}%; --hotspot-mobile-y: {{ mobile_hotspot_y }}%;"
                  data-shop-the-look-hotspot
                  data-block-id="{{ block.id }}"
                >
                  <span aria-hidden="true"></span>
                </button>
                {% assign hotspot_index = hotspot_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="shop-the-look__mobile-preview" aria-live="polite" aria-atomic="true">
          {% assign preview_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'product_hotspot' %}
              {% liquid
                assign preview_product = block.settings.product
                assign preview_variant = preview_product.selected_or_first_available_variant
                assign preview_placeholder_index = preview_index | modulo: 6 | plus: 1
                assign preview_placeholder_asset_index = preview_placeholder_index | minus: 1 | modulo: 4 | plus: 1
                assign preview_placeholder_asset = 'placeholder-image-product-' | append: preview_placeholder_asset_index | append: '.svg'
              %}
              <a
                class="shop-the-look__mobile-preview-card"
                href="{{ preview_product.url | default: '#' }}"
                data-shop-the-look-preview
                data-block-id="{{ block.id }}"
                {% unless preview_index == 0 %}hidden{% endunless %}
              >
                <span class="shop-the-look__mobile-preview-media">
                  {% render 'responsive-media',
                    image: preview_product.featured_image,
                    max_width: 160,
                    widths: '80, 120, 160',
                    sizes: '64px',
                    class: 'shop-the-look__mobile-preview-image',
                    loading: 'lazy',
                    alt: preview_product.featured_image.alt,
                    placeholder_asset: preview_placeholder_asset,
                    placeholder_class: 'shop-the-look__mobile-preview-placeholder'
                  %}
                </span>
                <span class="shop-the-look__mobile-preview-details">
                  <span class="shop-the-look__mobile-preview-title">
                    {% if preview_product != blank %}
                      {{ preview_product.title | escape }}
                    {% else %}
                      {{ 'onboarding.product_title' | t }}
                    {% endif %}
                  </span>
                  <span class="shop-the-look__mobile-preview-price{% if preview_variant.compare_at_price > preview_variant.price %} shop-the-look__mobile-preview-price--sale{% endif %}">
                    {% render 'money', amount: preview_variant.price %}
                  </span>
                </span>
                {% render 'icon', name: 'chevron-right', class: 'shop-the-look__mobile-preview-arrow' %}
              </a>
              {% assign preview_index = preview_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="shop-the-look__content-column">
        <header class="section-header shop-the-look__header">
          <div class="shop-the-look__header-content">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'subheading' %}
                  {% if block.settings.heading != blank %}
                    <div class="shop-the-look__subheading">
                      {% render 'typography-block',
                        block: block,
                        content: block.settings.heading,
                        kind: 'heading',
                        default_preset: 'subheading',
                        default_font: 'heading'
                      %}
                    </div>
                  {% endif %}
                {% when 'heading' %}
                  {% if block.settings.heading != blank %}
                    <div class="shop-the-look__heading">
                      {% render 'typography-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h2', default_font: 'heading' %}
                    </div>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </div>
        </header>

        <div class="shop-the-look__spotlight">
          {% if product_block_count > 1 %}
            <button class="shop-the-look__arrow shop-the-look__arrow--previous" type="button" aria-label="{{ 'shop_the_look.previous_product' | t | escape }}" data-shop-the-look-previous>
              {% render 'icon', name: 'chevron-left' %}
            </button>
          {% endif %}

          <div class="shop-the-look__products swiper" data-shop-the-look-slider>
            <div class="swiper-wrapper">
              {% assign product_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'product_hotspot' %}
                  {% assign product_placeholder_index = product_index | plus: 1 %}
                  <div
                    class="shop-the-look__product-slide swiper-slide"
                    id="ShopTheLookProduct-{{ section.id }}-{{ block.id }}"
                    role="tabpanel"
                    aria-labelledby="ShopTheLookHotspot-{{ section.id }}-{{ block.id }}"
                    data-shop-the-look-product
                    data-block-id="{{ block.id }}"
                    {% unless product_index == 0 %}aria-hidden="true" inert{% endunless %}
                    {{ block.shopify_attributes }}
                  >
                    {% render 'product-card',
                      product: block.settings.product,
                      placeholder_index: product_placeholder_index,
                      sizes: '(max-width: 749px) 48vw, (min-width: 990px) 360px, 44vw',
                      show_badges: true,
                      show_compare_at_price: true,
                      show_variant_dots: true,
                      show_media_actions: true,
                      enable_quick_view: true
                    %}
                  </div>
                  {% assign product_index = product_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>
          </div>

          {% if product_block_count > 1 %}
            <button class="shop-the-look__arrow shop-the-look__arrow--next" type="button" aria-label="{{ 'shop_the_look.next_product' | t | escape }}" data-shop-the-look-next>
              {% render 'icon', name: 'chevron-right' %}
            </button>
          {% endif %}
        </div>

        {% if product_block_count > 1 %}
          <div class="shop-the-look__indicators" aria-hidden="true">
            {% assign indicator_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'product_hotspot' %}
                <span class="shop-the-look__indicator{% if indicator_index == 0 %} shop-the-look__indicator--active{% endif %}" data-shop-the-look-indicator></span>
                {% assign indicator_index = indicator_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </shop-the-look>
{% endif %}



{% schema %}
{
  "name": "Shop the look",
  "tag": "section",
  "class": "section-shop-the-look",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "product_image_size",
      "min": 160,
      "max": 360,
      "step": 20,
      "unit": "px",
      "label": "Product image size",
      "default": 240
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 24,
      "max": 96,
      "step": 8,
      "unit": "px",
      "label": "Content padding",
      "default": 48
    },
    {
      "type": "header",
      "content": "Editorial image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Recommended when the desktop crop does not fit the mobile layout. Uses the main image when left blank."
    },
    {
      "type": "text",
      "id": "focal_point",
      "label": "Focal point",
      "default": "center center",
      "info": "CSS object-position, for example: 50% 40%"
    },
    {
      "type": "text",
      "id": "mobile_focal_point",
      "label": "Mobile focal point",
      "default": "center center",
      "info": "Applied only when a mobile image is selected."
    },
    {
      "type": "header",
      "content": "Section height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 640,
      "max": 1200,
      "step": 40,
      "unit": "px",
      "label": "Desktop",
      "default": 960
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 360,
      "max": 560,
      "step": 40,
      "unit": "px",
      "label": "Mobile content",
      "default": 440
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "t:typography_blocks.text",
          "default": "t:typography_defaults.subheading"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.preset",
          "options": [
            {
              "value": "paragraph",
              "label": "t:typography_options.paragraph"
            },
            {
              "value": "subheading",
              "label": "t:typography_options.subheading"
            },
            {
              "value": "h1",
              "label": "t:typography_options.h1"
            },
            {
              "value": "h2",
              "label": "t:typography_options.h2"
            },
            {
              "value": "h3",
              "label": "t:typography_options.h3"
            },
            {
              "value": "h4",
              "label": "t:typography_options.h4"
            },
            {
              "value": "h5",
              "label": "t:typography_options.h5"
            },
            {
              "value": "h6",
              "label": "t:typography_options.h6"
            }
          ],
          "default": "subheading"
        },
        {
          "type": "select",
          "id": "color",
          "label": "t:typography_blocks.color",
          "options": [
            {
              "value": "text",
              "label": "t:typography_options.text"
            },
            {
              "value": "subtext",
              "label": "t:typography_options.subtext"
            }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        },
        {
          "type": "header",
          "content": "t:typography_blocks.layout"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:typography_blocks.width",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "t:typography_blocks.width_mobile",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "text_alignment",
          "id": "alignment",
          "label": "t:typography_blocks.alignment",
          "default": "left",
          "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "t:typography_blocks.text",
          "default": "<h2>Statement Stacks</h2>"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.preset",
          "options": [
            {
              "value": "paragraph",
              "label": "t:typography_options.paragraph"
            },
            {
              "value": "subheading",
              "label": "t:typography_options.subheading"
            },
            {
              "value": "h1",
              "label": "t:typography_options.h1"
            },
            {
              "value": "h2",
              "label": "t:typography_options.h2"
            },
            {
              "value": "h3",
              "label": "t:typography_options.h3"
            },
            {
              "value": "h4",
              "label": "t:typography_options.h4"
            },
            {
              "value": "h5",
              "label": "t:typography_options.h5"
            },
            {
              "value": "h6",
              "label": "t:typography_options.h6"
            }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "color",
          "label": "t:typography_blocks.color",
          "options": [
            {
              "value": "text",
              "label": "t:typography_options.text"
            },
            {
              "value": "subtext",
              "label": "t:typography_options.subtext"
            }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        }
      ]
    },
    {
      "type": "product_hotspot",
      "name": "Product hotspot",
      "settings": [
        {
          "type": "header",
          "content": "Product hotspot"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "horizontal_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 60
        },
        {
          "type": "range",
          "id": "vertical_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 58
        },
        {
          "type": "checkbox",
          "id": "enable_mobile_position",
          "label": "Custom mobile position",
          "info": "Set a different hotspot position for mobile screens.",
          "default": false
        },
        {
          "type": "range",
          "id": "mobile_horizontal_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Mobile horizontal position",
          "default": 60,
          "visible_if": "{{ block.settings.enable_mobile_position }}"
        },
        {
          "type": "range",
          "id": "mobile_vertical_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Mobile vertical position",
          "default": 58,
          "visible_if": "{{ block.settings.enable_mobile_position }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "category": "Product discovery",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "product_hotspot",
          "settings": {
            "horizontal_position": 60,
            "vertical_position": 58
          }
        },
        {
          "type": "product_hotspot",
          "settings": {
            "horizontal_position": 49,
            "vertical_position": 52
          }
        },
        {
          "type": "product_hotspot",
          "settings": {
            "horizontal_position": 72,
            "vertical_position": 63
          }
        }
      ]
    }
  ]
}
{% endschema %}
