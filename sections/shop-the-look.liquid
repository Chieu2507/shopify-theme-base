{% render 'section-stylesheet', asset: 'section-shop-the-look.css', defer_on_home: true %}

{% liquid
  assign product_block_count = 0
  assign bundle_total = 0
  assign bundle_available = true
  assign bundle_price_label = section.settings.bundle_price_label
  assign bundle_savings_text = section.settings.bundle_savings_text
  assign bundle_add_label = section.settings.bundle_add_label
  assign bundle_adding_label = section.settings.bundle_adding_label
  assign bundle_added_label = section.settings.bundle_added_label
  assign bundle_error_label = section.settings.bundle_error_label
  assign total_value_label = section.settings.total_value_label
  if bundle_price_label == blank
    assign bundle_price_label = 'shop_the_look.set_price' | t
  endif
  if bundle_savings_text == blank
    assign bundle_savings_text = 'shop_the_look.savings' | t
  endif
  if bundle_add_label == blank
    assign bundle_add_label = 'shop_the_look.add_all' | t
  endif
  if bundle_adding_label == blank
    assign bundle_adding_label = 'shop_the_look.adding' | t
  endif
  if bundle_added_label == blank
    assign bundle_added_label = 'shop_the_look.added' | t
  endif
  if bundle_error_label == blank
    assign bundle_error_label = 'shop_the_look.add_error' | t
  endif
  if total_value_label == blank
    assign total_value_label = 'shop_the_look.total_value' | t
  endif
  assign mobile_media_aspect_ratio = section.settings.mobile_image.aspect_ratio | default: section.settings.image.aspect_ratio | default: 1
  assign shop_the_look_color_scheme_id = section.settings.color_scheme.id | default: 'scheme-4'
  assign shop_the_look_background = section.settings.background_color
  if shop_the_look_background == blank
    assign shop_the_look_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif
  if shop_the_look_background == blank
    assign shop_the_look_background = 'var(--color-background)'
  endif

  for block in section.blocks
    if block.type == 'product_hotspot'
      assign product_block_count = product_block_count | plus: 1
      if block.settings.product != blank
        assign product_variant = block.settings.product.selected_or_first_available_variant
        if product_variant != blank
          assign bundle_total = bundle_total | plus: product_variant.price
          if product_variant.available == false or product_variant.requires_selling_plan
            assign bundle_available = false
          endif
        else
          assign bundle_available = false
        endif
      else
        assign bundle_available = false
      endif
    endif
  endfor

  if product_block_count == 0
    assign bundle_available = false
  endif
%}

{% if product_block_count > 0 %}
  {% capture bundle_items %}
    [
      {% assign bundle_item_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'product_hotspot' and block.settings.product != blank %}
          {% assign bundle_variant = block.settings.product.selected_or_first_available_variant %}
          {% if bundle_variant != blank and bundle_variant.available %}
            {% unless bundle_variant.requires_selling_plan %}
              {% unless bundle_item_index == 0 %},{% endunless %}
              {"id":{{ bundle_variant.id | json }},"quantity":1}
              {% assign bundle_item_index = bundle_item_index | plus: 1 %}
            {% endunless %}
          {% endif %}
        {% endif %}
      {% endfor %}
    ]
  {% endcapture %}

  <shop-the-look
    id="ShopTheLook-{{ section.id }}"
    data-deferred-module="{{ 'shop-the-look.js' | asset_url }}"
    data-editor-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
    class="shop-the-look color-scheme color-{{ shop_the_look_color_scheme_id }}{% if section.settings.section_width == 'full' %} full-width{% endif %} shop-the-look--media-{{ section.settings.media_position | default: 'left' }}"
    style="--shop-the-look-height: {{ section.settings.height_desktop }}px; --shop-the-look-height-mobile: {{ section.settings.height_mobile }}px; --shop-the-look-content-padding: {{ section.settings.content_padding }}px; --shop-the-look-product-image-size: {{ section.settings.product_image_size }}px; --shop-the-look-mobile-media-ratio: {{ mobile_media_aspect_ratio }}; --shop-the-look-background: {{ shop_the_look_background }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="shop-the-look__inner section-spacing">
      <div class="shop-the-look__layout">
        <div class="shop-the-look__media-column">
          <div class="shop-the-look__visual">
            {% liquid
              assign editorial_image = section.settings.image | default: section.settings.mobile_image
              assign editorial_image_alt = editorial_image.alt
              assign mobile_focal_point = section.settings.mobile_focal_point
              if section.settings.mobile_image == blank or mobile_focal_point == blank
                assign mobile_focal_point = section.settings.focal_point
              endif
              capture editorial_image_style
                echo '--shop-the-look-desktop-focal-point: ' | append: section.settings.focal_point | append: '; '
                echo '--shop-the-look-mobile-focal-point: ' | append: mobile_focal_point | append: ';'
              endcapture
              if editorial_image_alt == blank
                assign editorial_image_alt = 'shop_the_look.editorial_image' | t
              endif
            %}
            <div class="shop-the-look__media">
              {% render 'responsive-media',
                image: editorial_image,
                mobile_image: section.settings.mobile_image,
                mobile_breakpoint: 992,
                max_width: 1920,
                mobile_max_width: 1200,
                widths: '480, 720, 960, 1200, 1440, 1920',
                mobile_widths: '360, 480, 640, 750, 960, 1200',
                sizes: '(min-width: 993px) 50vw, 100vw',
                class: 'shop-the-look__editorial-image',
                loading: 'lazy',
                alt: editorial_image_alt,
                style: editorial_image_style,
                placeholder_asset: 'placeholder-image-default-2.svg',
                placeholder_class: 'shop-the-look__placeholder'
              %}
            </div>

            <div class="shop-the-look__hotspots" role="group" aria-label="{{ 'shop_the_look.products' | t | escape }}">
              {% assign hotspot_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'product_hotspot' %}
                  {% liquid
                    assign hotspot_label = block.settings.product.title
                    assign desktop_hotspot_x = block.settings.horizontal_position | default: 60 | at_least: 0 | at_most: 100
                    assign desktop_hotspot_y = block.settings.vertical_position | default: 58 | at_least: 0 | at_most: 100
                    assign mobile_hotspot_x = desktop_hotspot_x
                    assign mobile_hotspot_y = desktop_hotspot_y
                    assign desktop_connector_x = block.settings.connector_horizontal_position | default: desktop_hotspot_x | at_least: 0 | at_most: 100
                    assign desktop_connector_y = block.settings.connector_vertical_position | default: desktop_hotspot_y | at_least: 0 | at_most: 100
                    assign mobile_connector_x = desktop_connector_x
                    assign mobile_connector_y = desktop_connector_y
                    assign show_connector = true
                    if block.settings.show_connector == false
                      assign show_connector = false
                    endif
                    if block.settings.enable_mobile_position
                      assign mobile_hotspot_x = block.settings.mobile_horizontal_position | default: desktop_hotspot_x | at_least: 0 | at_most: 100
                      assign mobile_hotspot_y = block.settings.mobile_vertical_position | default: desktop_hotspot_y | at_least: 0 | at_most: 100
                      assign mobile_connector_x = block.settings.mobile_connector_horizontal_position | default: desktop_connector_x | at_least: 0 | at_most: 100
                      assign mobile_connector_y = block.settings.mobile_connector_vertical_position | default: desktop_connector_y | at_least: 0 | at_most: 100
                    endif
                    if hotspot_label == blank
                      assign hotspot_label = 'shop_the_look.product' | t
                    endif
                    assign hotspot_number = hotspot_index | plus: 1 | prepend: '0' | slice: -2, 2
                  %}
                  <div
                    class="shop-the-look__hotspot-annotation"
                    data-shop-the-look-hotspot-annotation
                    data-block-id="{{ block.id }}"
                    style="--hotspot-x: {{ desktop_hotspot_x }}%; --hotspot-y: {{ desktop_hotspot_y }}%; --hotspot-mobile-x: {{ mobile_hotspot_x }}%; --hotspot-mobile-y: {{ mobile_hotspot_y }}%; --hotspot-connector-x: {{ desktop_connector_x }}%; --hotspot-connector-y: {{ desktop_connector_y }}%; --hotspot-mobile-connector-x: {{ mobile_connector_x }}%; --hotspot-mobile-connector-y: {{ mobile_connector_y }}%;"
                    {{ block.shopify_attributes }}
                  >
                    {% if show_connector %}
                      <svg class="shop-the-look__hotspot-connector" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <line class="shop-the-look__hotspot-connector-line shop-the-look__hotspot-connector-line--desktop" x1="{{ desktop_hotspot_x }}" y1="{{ desktop_hotspot_y }}" x2="{{ desktop_connector_x }}" y2="{{ desktop_connector_y }}"></line>
                        <line class="shop-the-look__hotspot-connector-line shop-the-look__hotspot-connector-line--mobile" x1="{{ mobile_hotspot_x }}" y1="{{ mobile_hotspot_y }}" x2="{{ mobile_connector_x }}" y2="{{ mobile_connector_y }}"></line>
                      </svg>
                    {% endif %}
                    {% if request.design_mode %}
                      <span class="shop-the-look__hotspot-guide" aria-hidden="true">
                        <span class="shop-the-look__hotspot-guide-grid"></span>
                        <span class="shop-the-look__hotspot-guide-marker"></span>
                        {% if show_connector %}<span class="shop-the-look__hotspot-guide-target"></span>{% endif %}
                        <span class="shop-the-look__hotspot-guide-label">Hotspot {{ hotspot_number }} · Marker {{ desktop_hotspot_x }}% / {{ desktop_hotspot_y }}%{% if show_connector %} · Target {{ desktop_connector_x }}% / {{ desktop_connector_y }}%{% endif %}{% if block.settings.enable_mobile_position %} · Mobile {{ mobile_hotspot_x }}% / {{ mobile_hotspot_y }}%{% endif %}</span>
                      </span>
                    {% endif %}
                    <button
                        class="shop-the-look__hotspot"
                        type="button"
                        aria-controls="ShopTheLookProduct-{{ section.id }}-{{ block.id }}"
                        aria-pressed="false"
                        aria-label="{{ 'shop_the_look.select_product' | t: product: hotspot_label | escape }}"
                        data-shop-the-look-hotspot
                        data-index="{{ hotspot_index }}"
                      >
                        <span class="shop-the-look__hotspot-number" aria-hidden="true">{{ hotspot_number }}</span>
                    </button>
                  </div>
                  {% assign hotspot_index = hotspot_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="shop-the-look__content-column">
          <div class="shop-the-look__content">
            <header class="section-header shop-the-look__header">
              <div class="shop-the-look__header-content">
                {% for block in section.blocks %}
                  {% if block.type == 'label' and block.settings.text != blank %}
                    <div class="shop-the-look__label">
                      {% render 'content-block',
                        block: block,
                        content: block.settings.text,
                        kind: 'label',
                        default_preset: 'label',
                        default_font: 'label',
                        force_preset: 'label'
                      %}
                    </div>
                  {% endif %}
                {% endfor %}

                {% for block in section.blocks %}
                  {% if block.type == 'heading' and block.settings.heading != blank %}
                    <div class="shop-the-look__heading" id="ShopTheLookHeading-{{ section.id }}">
                      {% render 'content-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h2', default_font: 'heading' %}
                    </div>
                  {% endif %}
                {% endfor %}

                <div class="shop-the-look__ornament" aria-hidden="true">
                  <span class="shop-the-look__ornament-line"></span>
                  <span class="shop-the-look__ornament-diamond"></span>
                  <span class="shop-the-look__ornament-line"></span>
                </div>

                {% for block in section.blocks %}
                  {% if block.type == 'text' and block.settings.text != blank %}
                    <div class="shop-the-look__text">
                      {% render 'content-block',
                        block: block,
                        content: block.settings.text,
                        kind: 'text',
                        default_preset: 'sm',
                        default_font: 'body'
                      %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </header>

            <div class="shop-the-look__summary">
              <div class="shop-the-look__summary-price">
                <span class="shop-the-look__summary-label">{{ bundle_price_label | escape }}</span>
                <span class="shop-the-look__summary-value">
                  {% if section.settings.bundle_price_override != blank %}
                    {{ section.settings.bundle_price_override | escape }}
                  {% elsif bundle_total > 0 %}
                    {{ bundle_total | money }}
                  {% else %}
                    —
                  {% endif %}
                </span>
              </div>
              <span class="shop-the-look__summary-divider" aria-hidden="true"></span>
              <p class="shop-the-look__summary-savings">{{ bundle_savings_text | escape | newline_to_br }}</p>
            </div>

            <ol class="shop-the-look__products">
              {% assign product_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'product_hotspot' %}
                  {% liquid
                    assign product = block.settings.product
                    assign product_variant = product.selected_or_first_available_variant
                    assign product_image = block.settings.cutout_image | default: product.featured_image
                    assign product_placeholder_index = product_index | modulo: 4 | plus: 1
                    assign product_number = product_index | plus: 1 | prepend: '0' | slice: -2, 2
                  %}
                  <li
                    class="shop-the-look__product"
                    id="ShopTheLookProduct-{{ section.id }}-{{ block.id }}"
                    data-shop-the-look-product
                    data-block-id="{{ block.id }}"
                  >
                    <span class="shop-the-look__product-number" aria-hidden="true">{{ product_number }}</span>

                    {% if product != blank and product_image != blank %}
                      <a class="shop-the-look__product-media" href="{{ product.url | escape }}" aria-label="{{ product.title | escape }}">
                        {% render 'responsive-image',
                          image: product_image,
                          max_width: 320,
                          widths: '96, 128, 192, 256, 320',
                          sizes: '(max-width: 767.98px) 24vw, (max-width: 992px) 18vw, 140px',
                          class: 'shop-the-look__product-image',
                          loading: 'lazy',
                          alt: product.title,
                          style: 'width: 100%; height: 100%; object-fit: cover;'
                        %}
                      </a>
                    {% else %}
                      <span class="shop-the-look__product-media" aria-hidden="true">
                        {{ 'product-' | append: product_placeholder_index | placeholder_svg_tag: 'shop-the-look__product-placeholder' }}
                      </span>
                    {% endif %}

                    <div class="shop-the-look__product-details">
                      {% if product != blank %}
                        <a class="shop-the-look__product-title" href="{{ product.url | escape }}">{{ product.title | escape }}</a>
                      {% else %}
                        <span class="shop-the-look__product-title">{{ 'onboarding.product_title' | t }}</span>
                      {% endif %}
                    </div>

                    <span class="shop-the-look__product-price">
                      {% if product_variant != blank %}
                        {{ product_variant.price | money }}
                      {% else %}
                        —
                      {% endif %}
                    </span>
                  </li>
                  {% assign product_index = product_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            </ol>

            <div class="shop-the-look__actions">
              <button
                class="shop-the-look__bundle-button"
                type="button"
                data-shop-the-look-bundle-add
                data-shop-the-look-bundle-items="{{ bundle_items | strip | escape }}"
                data-shop-the-look-bundle-add-label="{{ bundle_add_label | escape }}"
                data-shop-the-look-bundle-adding-label="{{ bundle_adding_label | escape }}"
                data-shop-the-look-bundle-added-label="{{ bundle_added_label | escape }}"
                data-shop-the-look-bundle-error-label="{{ bundle_error_label | escape }}"
                {% unless bundle_available %}aria-disabled="true"{% endunless %}
              >
                <span data-shop-the-look-bundle-label>{{ bundle_add_label | escape }}</span>
              </button>
              <p class="shop-the-look__bundle-status visually-hidden" data-shop-the-look-bundle-status role="status" aria-live="polite" aria-atomic="true"></p>
              <p class="shop-the-look__total">{{ total_value_label | escape }} <span>{% if bundle_total > 0 %}{{ bundle_total | money }}{% else %}—{% endif %}</span></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </shop-the-look>
{% endif %}

{% schema %}
{
  "name": "Shop the look",
  "tag": "section",
  "class": "section-shop-the-look",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "product_image_size",
      "min": 160,
      "max": 360,
      "step": 20,
      "unit": "px",
      "label": "Product image size",
      "default": 240
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 24,
      "max": 96,
      "step": 8,
      "unit": "px",
      "label": "Content padding",
      "default": 48
    },
    {
      "type": "header",
      "content": "Editorial image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Recommended when the desktop crop does not fit the mobile layout. Uses the main image when left blank."
    },
    {
      "type": "text",
      "id": "focal_point",
      "label": "Focal point",
      "default": "center center",
      "info": "CSS object-position, for example: 50% 40%"
    },
    {
      "type": "text",
      "id": "mobile_focal_point",
      "label": "Mobile focal point",
      "default": "center center",
      "info": "Applied only when a mobile image is selected."
    },
    {
      "type": "header",
      "content": "Section height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 640,
      "max": 1200,
      "step": 40,
      "unit": "px",
      "label": "Desktop",
      "default": 960
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 360,
      "max": 560,
      "step": 40,
      "unit": "px",
      "label": "Mobile content",
      "default": 440
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme."
    },
    {
      "type": "header",
      "content": "Bundle details"
    },
    {
      "type": "text",
      "id": "bundle_price_label",
      "label": "Price label",
      "default": "Set price"
    },
    {
      "type": "text",
      "id": "bundle_price_override",
      "label": "Display set price",
      "info": "Optional display text. This does not change the price charged in Shopify."
    },
    {
      "type": "text",
      "id": "bundle_savings_text",
      "label": "Savings message",
      "default": "Savings when bought as a set"
    },
    {
      "type": "text",
      "id": "bundle_add_label",
      "label": "Add all label",
      "default": "Add all to bag"
    },
    {
      "type": "text",
      "id": "bundle_adding_label",
      "label": "Adding label",
      "default": "Adding to bag"
    },
    {
      "type": "text",
      "id": "bundle_added_label",
      "label": "Added label",
      "default": "Added to bag"
    },
    {
      "type": "text",
      "id": "bundle_error_label",
      "label": "Error message",
      "default": "This set could not be added. Please try again."
    },
    {
      "type": "text",
      "id": "total_value_label",
      "label": "Total value label",
      "default": "Total value:"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "label",
      "name": "t:names.label",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:typography_blocks.text",
          "default": "t:typography_defaults.label"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Legacy color token",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "subtext", "label": "Subtext" }
          ],
          "visible_if": "{{ false }}"
        },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        },
        {
          "type": "header",
          "content": "t:typography_blocks.layout"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:typography_blocks.width",
          "options": [
            { "value": "fit-content", "label": "t:typography_options.fit" },
            { "value": "100%", "label": "t:typography_options.fill" }
          ],
          "default": "fit-content"
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "t:typography_blocks.width_mobile",
          "options": [
            { "value": "fit-content", "label": "t:typography_options.fit" },
            { "value": "100%", "label": "t:typography_options.fill" }
          ],
          "default": "fit-content"
        },
        {
          "type": "text_alignment",
          "id": "alignment",
          "label": "t:typography_blocks.alignment",
          "default": "left",
          "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
        },
        {
          "type": "header",
          "content": "t:typography_blocks.padding"
        },
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "t:typography_blocks.top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "t:typography_blocks.bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-start",
          "label": "t:typography_blocks.left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-end",
          "label": "t:typography_blocks.right",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "header",
          "content": "Animation"
        },
        {
