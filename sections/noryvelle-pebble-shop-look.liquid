{% liquid
  assign product_count = section.blocks.size
  assign campaign_alt = section.settings.campaign_alt | default: section.settings.campaign_image.alt
%}

<noryvelle-pebble-shop-look
  class="np-shop-look full-width color-scheme color-{{ section.settings.color_scheme.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="np-shop-look__layout">
    <div class="np-shop-look__products">
      <div class="np-shop-look__slides" data-shop-look-slides aria-live="polite">
        {% for block in section.blocks %}
          <div
            class="np-shop-look__slide"
            data-shop-look-slide
            data-block-id="{{ block.id }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            {% render 'product-card',
              product: block.settings.product,
              placeholder_index: forloop.index,
              media_ratio: 'square',
              sizes: '(min-width: 1200px) 384px, (min-width: 750px) 320px, 240px',
              show_badges: false,
              show_compare_at_price: false,
              show_variant_dots: true,
              show_secondary_image: false,
              show_quick_add: false,
              show_media_actions: true,
              enable_quick_view: false,
              heading_tag: 'h3'
            %}
          </div>
        {% else %}
          <div class="np-shop-look__slide">
            {% render 'product-card',
              placeholder_index: 1,
              media_ratio: 'square',
              show_badges: false,
              show_variant_dots: false,
              show_media_actions: false,
              heading_tag: 'h3'
            %}
          </div>
        {% endfor %}
      </div>

      {% if product_count > 1 %}
        <div class="np-shop-look__controls">
          <button
            class="np-shop-look__control np-shop-look__control--previous"
            type="button"
            aria-label="{{ section.settings.previous_label | escape }}"
            data-shop-look-previous
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M21 12H3m0 0 5-5m-5 5 5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            class="np-shop-look__control np-shop-look__control--next"
            type="button"
            aria-label="{{ section.settings.next_label | escape }}"
            data-shop-look-next
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 12h18m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    <div
      class="np-shop-look__campaign"
      style="--np-shop-look-campaign-position: {{ section.settings.campaign_position }};"
    >
      {% if section.settings.campaign_image != blank %}
        {% render 'responsive-image',
          image: section.settings.campaign_image,
          max_width: 1920,
          widths: '375, 540, 750, 960, 1200, 1440, 1920',
          sizes: '(min-width: 990px) 50vw, 100vw',
          class: 'np-shop-look__campaign-image',
          loading: 'lazy',
          alt: campaign_alt,
          style: 'object-position: var(--np-shop-look-campaign-position);'
        %}
      {% else %}
        {% render 'media-placeholder', class_name: 'np-shop-look__campaign-placeholder', asset_name: 'placeholder-image-default-2.svg' %}
      {% endif %}
      <div class="np-shop-look__overlay"></div>
      <div class="np-shop-look__campaign-content">
        {% if section.settings.heading != blank %}
          <h2 class="np-shop-look__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% render 'cta',
          label: section.settings.button_label,
          url: section.settings.button_link,
          style: 'tertiary',
          class: 'np-shop-look__campaign-link'
        %}
      </div>
    </div>
  </div>
</noryvelle-pebble-shop-look>

{% stylesheet %}
  .np-shop-look {
    display: block;
    padding-top: 96px;
    overflow: hidden;
    background: #fff;
    color: #181818;
  }

  .np-shop-look__layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .np-shop-look__products,
  .np-shop-look__campaign {
    position: relative;
    min-width: 0;
    height: min(40vw, 768px);
    min-height: 640px;
  }

  .np-shop-look__products {
    display: grid;
    background: #fff;
    place-items: center;
  }

  .np-shop-look__slides {
    width: 384px;
  }

  .np-shop-look__slide {
    width: 384px;
  }

  .np-shop-look__slide[hidden] {
    display: none;
  }

  .np-shop-look__slide .product-card {
    width: 100%;
    overflow: hidden;
    background: #f6f6f6;
  }

  .np-shop-look__slide .product-card__media {
    border-radius: 0;
    background: #f6f6f6;
  }

  .np-shop-look__slide .product-card__image,
  .np-shop-look__slide .product-card__placeholder {
    box-sizing: border-box;
    padding: 6%;
    object-fit: contain;
  }

  .np-shop-look__slide .product-card__content {
    display: flex;
    min-height: 109px;
    box-sizing: border-box;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 8px;
    padding: 16px 20px 20px;
    background: #f6f6f6;
  }

  .np-shop-look__slide .product-card__details {
    width: 100%;
  }

  .np-shop-look__slide .product-card__title {
    overflow: hidden;
    margin: 0;
    color: #181818;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-style: var(--font-body--style);
    font-weight: 500;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .np-shop-look__slide .product-card__price {
    margin-top: 4px;
    color: #181818;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-style: var(--font-body--style);
    font-weight: 400;
    letter-spacing: 0.2px;
    line-height: 1.5;
  }

  .np-shop-look__slide .product-card__variant-dots {
    gap: 8px;
    padding: 0;
  }

  .np-shop-look__slide .product-card__variant-swatch-button {
    width: 16px;
    height: 16px;
    padding: 0;
    border: 1px solid #b3b3b3;
    border-radius: 0;
  }

  .np-shop-look__slide .product-card__variant-swatch-button.is-active {
    padding: 4px;
    border-color: #181818;
  }

  .np-shop-look__slide .product-card__variant-swatch-button > span[aria-hidden='true'] {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
  }

  .np-shop-look__slide .product-card__media-actions {
    display: none;
  }

  .np-shop-look__controls {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .np-shop-look__control {
    position: absolute;
    top: 50%;
    display: grid;
    width: 48px;
    height: 48px;
    padding: 12px;
    border: 0;
    background: transparent;
    color: #181818;
    cursor: pointer;
    pointer-events: auto;
    transform: translateY(-50%);
    place-items: center;
  }

  .np-shop-look__control--previous {
    left: 32px;
  }

  .np-shop-look__control--next {
    right: 32px;
  }

  .np-shop-look__control:disabled {
    cursor: default;
    opacity: 0.3;
  }

  .np-shop-look__control:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: -2px;
  }

  .np-shop-look__control svg {
    width: 24px;
    height: 24px;
  }

  .np-shop-look__campaign {
    overflow: hidden;
    background: #e9e9e9;
    --np-shop-look-campaign-position: center;
  }

  .np-shop-look__campaign-image,
  .np-shop-look__campaign-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .np-shop-look__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgb(0 0 0 / 30%));
    pointer-events: none;
  }

  .np-shop-look__campaign-content {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 40px;
  }

  .np-shop-look__heading {
    width: 100%;
    margin: 0;
    color: #fff;
    font-family: var(--font-heading--family);
    font-size: 26px;
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    letter-spacing: 2px;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .np-shop-look__campaign-link {
    color: #fff;
    border-bottom-color: #fff;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.6px;
    line-height: 1.5;
  }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .np-shop-look {
      padding-top: 0;
    }

    .np-shop-look__layout {
      display: flex;
      flex-direction: column;
    }

    .np-shop-look__campaign {
      order: 1;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 5 / 4;
    }

    .np-shop-look__campaign-content {
      padding: 32px 30px;
    }

    .np-shop-look__products {
      order: 2;
      width: 100%;
      height: 613px;
      min-height: 0;
      padding: 64px 0;
    }

    .np-shop-look__slides,
    .np-shop-look__slide {
      width: 384px;
    }

    .np-shop-look__slide .product-card__content {
      min-height: 101px;
      padding: 12px 16px 16px;
    }

    .np-shop-look__control--previous {
      left: 30px;
    }

    .np-shop-look__control--next {
      right: 30px;
    }

    .np-shop-look__slide .product-card__media-actions {
      right: 16px;
      bottom: 16px;
      left: auto;
      display: flex;
      opacity: 1;
      transform: none;
    }

    .np-shop-look__slide .product-card__media-action {
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      border-radius: 0;
      backdrop-filter: blur(2px);
      background: rgb(255 255 255 / 60%);
      box-shadow: none;
      color: #181818;
    }

    .np-shop-look__slide .product-card__media-action svg {
      display: none;
    }

    .np-shop-look__slide .product-card__media-action::before,
    .np-shop-look__slide .product-card__media-action::after {
      position: absolute;
      width: 16px;
      height: 1px;
      background: currentcolor;
      content: '';
    }

    .np-shop-look__slide .product-card__media-action::after {
      transform: rotate(90deg);
    }
  }

  @media screen and (max-width: 749px) {
    .np-shop-look {
      padding-top: 0;
    }

    .np-shop-look__layout {
      display: flex;
      flex-direction: column;
    }

    .np-shop-look__campaign {
      order: 1;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 5 / 4;
    }

    .np-shop-look__campaign-content {
      gap: 12px;
      padding: 24px 16px;
    }

    .np-shop-look__heading {
      font-size: 22px;
    }

    .np-shop-look__products {
      order: 2;
      width: 100%;
      height: 453px;
      min-height: 0;
      padding: 56px 0;
    }

    .np-shop-look__slides,
    .np-shop-look__slide {
      width: 240px;
    }

    .np-shop-look__slide .product-card__content {
      min-height: 101px;
      padding: 12px 16px 16px;
    }

    .np-shop-look__slide .product-card__media-actions {
      right: 16px;
      bottom: 16px;
      left: auto;
      display: flex;
      opacity: 1;
      transform: none;
    }

    .np-shop-look__slide .product-card__media-action {
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      border-radius: 0;
      backdrop-filter: blur(2px);
      background: rgb(255 255 255 / 60%);
      box-shadow: none;
      color: #181818;
    }

    .np-shop-look__slide .product-card__media-action:hover:not(:disabled),
    .np-shop-look__slide .product-card__media-action:focus-visible:not(:disabled) {
      background: rgb(255 255 255 / 78%);
      box-shadow: none;
      color: #181818;
      transform: none;
    }

    .np-shop-look__slide .product-card__media-action svg {
      display: none;
    }

    .np-shop-look__slide .product-card__media-action::before,
    .np-shop-look__slide .product-card__media-action::after {
      position: absolute;
      width: 16px;
      height: 1px;
      background: currentcolor;
      content: '';
    }

    .np-shop-look__slide .product-card__media-action::after {
      transform: rotate(90deg);
    }

    .np-shop-look__controls {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('noryvelle-pebble-shop-look')) {
    class NoryvellePebbleShopLook extends HTMLElement {
      connectedCallback() {
        this.slides = [...this.querySelectorAll('[data-shop-look-slide]')];
        this.previousButton = this.querySelector('[data-shop-look-previous]');
        this.nextButton = this.querySelector('[data-shop-look-next]');
        this.index = Math.max(0, this.slides.findIndex((slide) => !slide.hidden));
        this.pointerStart = null;
        this.onPrevious = () => this.show(this.index - 1);
        this.onNext = () => this.show(this.index + 1);
        this.onPointerDown = (event) => {
          this.pointerStart = event.clientX;
        };
        this.onPointerUp = (event) => {
          if (this.pointerStart === null) return;
          const distance = event.clientX - this.pointerStart;
          this.pointerStart = null;
          if (Math.abs(distance) < 40) return;
          this.show(distance < 0 ? this.index + 1 : this.index - 1);
        };
        this.onBlockSelect = (event) => {
          const slideIndex = this.slides.findIndex((slide) => slide.dataset.blockId === event.detail.blockId);
          if (slideIndex >= 0) this.show(slideIndex);
        };
        this.previousButton?.addEventListener('click', this.onPrevious);
        this.nextButton?.addEventListener('click', this.onNext);
        this.querySelector('[data-shop-look-slides]')?.addEventListener('pointerdown', this.onPointerDown);
        this.querySelector('[data-shop-look-slides]')?.addEventListener('pointerup', this.onPointerUp);
        document.addEventListener('shopify:block:select', this.onBlockSelect);
        this.show(this.index);
      }

      disconnectedCallback() {
        this.previousButton?.removeEventListener('click', this.onPrevious);
        this.nextButton?.removeEventListener('click', this.onNext);
        this.querySelector('[data-shop-look-slides]')?.removeEventListener('pointerdown', this.onPointerDown);
        this.querySelector('[data-shop-look-slides]')?.removeEventListener('pointerup', this.onPointerUp);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      show(nextIndex) {
        if (!this.slides.length) return;
        this.index = Math.min(Math.max(nextIndex, 0), this.slides.length - 1);
        this.slides.forEach((slide, index) => {
          const isCurrent = index === this.index;
          slide.hidden = !isCurrent;
          slide.setAttribute('aria-hidden', String(!isCurrent));
        });
        if (this.previousButton) this.previousButton.disabled = this.index === 0;
        if (this.nextButton) this.nextButton.disabled = this.index === this.slides.length - 1;
      }
    }

    customElements.define('noryvelle-pebble-shop-look', NoryvellePebbleShopLook);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Noryvelle shop look",
  "tag": "section",
  "class": "section-noryvelle-shop-look",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "campaign_image",
      "label": "Campaign image"
    },
    {
      "type": "text",
      "id": "campaign_alt",
      "label": "Campaign image alt text"
    },
    {
      "type": "select",
      "id": "campaign_position",
      "label": "Campaign image position",
      "options": [
        {"value": "left top", "label": "Left top"},
        {"value": "center top", "label": "Center top"},
        {"value": "right top", "label": "Right top"},
        {"value": "left center", "label": "Left center"},
        {"value": "center", "label": "Center"},
        {"value": "right center", "label": "Right center"},
        {"value": "left bottom", "label": "Left bottom"},
        {"value": "center bottom", "label": "Center bottom"},
        {"value": "right bottom", "label": "Right bottom"}
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Effortless Elegance in Every Detail"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View bag line"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous button label",
      "default": "Previous product"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button label",
      "default": "Next product"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noryvelle shop look",
      "blocks": [
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
