{% liquid
  assign search_overlay_appearance = section.settings.appearance_type | default: 'inherit'
  unless search_overlay_appearance == 'inherit' or search_overlay_appearance == 'scheme'
    assign search_overlay_appearance = 'inherit'
  endunless
  assign search_overlay_class = 'search-overlay color-scheme section-color-scope'
  if search_overlay_appearance == 'scheme'
    assign search_overlay_scheme = section.settings.color_scheme | default: 'scheme-1'
    if section.settings.color_scheme.id != blank
      assign search_overlay_scheme = section.settings.color_scheme.id
    endif
    assign search_overlay_scheme = search_overlay_scheme | default: 'scheme-1' | handleize
    assign search_overlay_class = search_overlay_class | append: ' search-overlay--scheme ' | append: search_overlay_scheme
  else
    assign search_overlay_class = search_overlay_class | append: ' search-overlay--inherit'
  endif
  assign search_overlay_placeholder = section.settings.placeholder
  if search_overlay_placeholder == blank
    assign search_overlay_placeholder = 'search.overlay_placeholder' | t
  endif
  assign search_show_products = section.settings.show_products
  assign search_show_collections = section.settings.show_collections
  assign search_show_blog_posts = section.settings.show_blog_posts
  assign search_show_pages = section.settings.show_pages
  if search_show_products == nil
    assign search_show_products = true
  endif
  if search_show_collections == nil
    assign search_show_collections = true
  endif
  if search_show_blog_posts == nil
    assign search_show_blog_posts = true
  endif
  if search_show_pages == nil
    assign search_show_pages = true
  endif
%}

<div
  id="SearchOverlay"
  class="{{ search_overlay_class }}"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'search.title' | t }}"
  aria-hidden="true"
  hidden
  data-search-overlay
  data-placeholder="{{ search_overlay_placeholder | escape }}"
  data-placeholder-suggestions="{{ section.settings.placeholder_suggestions | escape }}"
  data-show-products="{{ search_show_products }}"
  data-show-collections="{{ search_show_collections }}"
  data-show-blog-posts="{{ search_show_blog_posts }}"
  data-show-pages="{{ search_show_pages }}"
  data-view-all-style="{{ section.settings.view_all_style | default: 'primary' | escape }}"
  data-search-url="{{ routes.search_url }}"
  data-predictive-search-url="{{ routes.predictive_search_url }}"
  data-products-label="{{ 'search.products' | t | escape }}"
  data-collections-label="{{ 'search.collections' | t | escape }}"
  data-blog-posts-label="{{ 'search.blog_posts' | t | escape }}"
  data-pages-label="{{ 'search.pages' | t | escape }}"
  data-suggestions-label="{{ 'search.suggestions' | t | escape }}"
  data-view-all-label="{{ 'search.view_all_results' | t | escape }}"
  data-no-results-label="{{ 'search.no_results' | t | escape }}"
  {{ section.shopify_attributes }}
>
  <button class="search-overlay__backdrop" type="button" aria-label="{{ 'search.close' | t }}" data-search-overlay-backdrop></button>
  <div class="search-overlay__panel">
    <div class="container page-width search-overlay__container">
      <form class="search-overlay__form" action="{{ routes.search_url }}" method="get" role="search" data-search-overlay-form>
        <span class="search-overlay__icon" aria-hidden="true">
          {% render 'icon', icon: 'magnifying-glass', bare: true %}
        </span>
        <label class="visually-hidden" for="SearchOverlayInput">{{ 'search.title' | t }}</label>
        <input id="SearchOverlayInput" class="search-overlay__input" name="q" type="search" autocomplete="off" placeholder="{{ search_overlay_placeholder | escape }}" role="combobox" aria-autocomplete="list" aria-controls="SearchOverlayResults" aria-expanded="false" data-search-overlay-input>
        <button class="overlay-close search-overlay__close" type="button" aria-label="{{ 'search.close' | t }}" data-search-overlay-close></button>
      </form>

      <div id="SearchOverlayResults" class="search-overlay__results" data-search-overlay-results aria-live="polite" hidden></div>
    </div>
  </div>
</div>

{% stylesheet %}
  .search-overlay {
    position: fixed;
    z-index: var(--z-drawer);
    inset-inline: 0;
    top: var(--search-overlay-top, 0px);
    bottom: 0;
    overflow: visible;
    padding: 0;
    background: transparent;
    color: var(--overlay-text-color);
    opacity: 0;
    transform: translateY(-0.5rem);
    transition: opacity var(--motion-duration-standard) var(--motion-ease-standard), transform var(--motion-duration-standard) var(--motion-ease-standard);
  }

  .search-overlay:not([hidden]) { opacity: 1; transform: translateY(0); }
  .search-overlay__results[hidden] { display: none; }
  html.search-overlay-open,
  body.search-overlay-open { overflow: hidden; }
  body:has(.section-header .header__container.full-width) .search-overlay__container { max-width: none; }
  .search-overlay--scheme { color: var(--body-color); }
  .search-overlay__backdrop {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--overlay-color);
    opacity: var(--overlay-opacity);
    cursor: pointer;
    -webkit-backdrop-filter: blur(var(--overlay-backdrop-blur));
    backdrop-filter: blur(var(--overlay-backdrop-blur));
  }
  .search-overlay__panel { position: relative; z-index: 1; min-height: 0; padding-block: 1rem; background: var(--overlay-background-color); }
  .search-overlay--has-results .search-overlay__panel {
    background: var(--overlay-background-color);
    border-bottom: 1px solid color-mix(in srgb, var(--border-color) 55%, transparent);
    box-shadow: none;
  }
  .search-overlay--scheme.search-overlay--has-results .search-overlay__panel { background: var(--background-color); }
  .search-overlay--scheme .search-overlay__panel { background: var(--background-color); }
  .search-overlay__form { position: relative; display: flex; align-items: center; width: calc(100% - 3.5rem); padding-inline: 0; border: 0; border-radius: var(--input-radius); background: var(--overlay-background-color); color: var(--overlay-text-color); }
  .search-overlay__icon { position: absolute; z-index: 2; left: 10px; display: inline-flex; width: 1.25rem; height: 1.25rem; color: inherit; pointer-events: none; }
  .search-overlay__icon svg { width: 100%; height: 100%; }
  .search-overlay__form input.search-overlay__input { width: auto; min-width: 0; flex: 1 1 auto; padding: 0 40px !important; border: 0 !important; border-radius: 0; outline: 0; background: transparent; color: inherit; font: inherit; font-size: var(--font-body-xl); letter-spacing: var(--font-accent-letter-spacing); }
  .search-overlay__form input.search-overlay__input::-webkit-search-cancel-button,
  .search-overlay__form input.search-overlay__input::-webkit-search-decoration,
  .search-overlay__form input.search-overlay__input::-webkit-search-results-button,
  .search-overlay__form input.search-overlay__input::-webkit-search-results-decoration { display: none; appearance: none; -webkit-appearance: none; }
  .search-overlay__form input.search-overlay__input::-ms-clear { display: none; width: 0; height: 0; }
  .search-overlay__form input.search-overlay__input::placeholder { color: currentColor; opacity: 0.58; letter-spacing: 0.18em; text-transform: uppercase; }
  .search-overlay__close { --overlay-close-size: 2.5rem; position: absolute; top: 50%; left: calc(100% + 1rem); color: var(--overlay-text-color); transform: translateY(-50%); }
  .search-overlay--scheme .search-overlay__close { color: var(--body-color); }
  .search-overlay__results { display: grid; grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 4.3fr); gap: 2.5rem; padding: 1.75rem 0 3rem; }
  .search-overlay__results:not(.search-overlay__results--has-suggestions) { grid-template-columns: minmax(0, 1fr); }
  .search-overlay__suggestions { min-width: 0; }
  .search-overlay__eyebrow, .search-overlay__tab { margin: 0; font-size: var(--font-body-xs); font-weight: var(--font-accent-weight); letter-spacing: 0.18em; text-transform: uppercase; }
  .search-overlay__eyebrow { padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); }
  .search-overlay__suggestion-list, .search-overlay__page-list { display: grid; gap: 0.85rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .search-overlay__suggestion-list a, .search-overlay__page-list a { color: inherit; font-size: var(--font-body-sm); text-decoration: none; }
  .search-overlay__page-list a { position: relative; display: inline-block; }
  .search-overlay__page-list a::after { position: absolute; inset-block-end: -0.2em; inset-inline-start: 0; width: 100%; height: 1px; background: currentColor; content: ''; transform: scaleX(0); transform-origin: left center; transition: transform var(--motion-duration-fast) var(--motion-ease-standard); }
  .search-overlay__page-list a:is(:hover, :focus-visible)::after { transform: scaleX(1); }
  .search-overlay__suggestion-list button { position: relative; display: inline-block; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; font-size: var(--font-body-sm); text-align: start; cursor: pointer; }
  .search-overlay__suggestion-list button::after { position: absolute; inset-block-end: -0.2em; inset-inline-start: 0; width: 100%; height: 1px; background: currentColor; content: ''; transform: scaleX(0); transform-origin: left center; transition: transform var(--motion-duration-fast) var(--motion-ease-standard); }
  .search-overlay__suggestion-list button:is(:hover, :focus-visible)::after { transform: scaleX(1); }
  .search-overlay__content { min-width: 0; }
  .search-overlay__tabs { display: flex; gap: 2.5rem; border-bottom: 1px solid var(--border-color); }
  .search-overlay__tab { position: relative; padding: 0 0 1rem; border: 0; background: transparent; color: color-mix(in srgb, currentColor 55%, transparent); cursor: pointer; }
  .search-overlay__tab[aria-selected='true'] { color: inherit; }
  .search-overlay__tab[aria-selected='true']::after { position: absolute; inset-inline: 0; bottom: -1px; height: 1px; background: currentColor; content: ''; }
  .search-overlay__result-panel { padding-top: 2rem; }
  .search-overlay__product-grid, .search-overlay__collection-grid, .search-overlay__article-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .search-overlay__result-card { display: grid; gap: 0.85rem; color: inherit; text-decoration: none; }
  .search-overlay__image { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; background: color-mix(in srgb, var(--background-color) 94%, var(--body-color)); }
  .search-overlay__result-title { font-size: var(--font-body-sm); font-weight: var(--font-accent-weight); letter-spacing: 0.12em; line-height: 1.35; text-transform: uppercase; }
  .search-overlay__price { color: color-mix(in srgb, currentColor 65%, transparent); font-size: var(--font-body-xs); letter-spacing: 0.1em; }
  .search-overlay__view-all { display: flex; justify-content: center; margin-top: 2.5rem; }
  .search-overlay__view-all .btn:not(.btn--tertiary) { min-height: 2.75rem; }
  .search-overlay__empty { margin: 0; font-size: var(--font-body-sm); }

  @media (max-width: 767.98px) {
    .search-overlay__panel { padding-block: 0.75rem; }
    .search-overlay__form { gap: 0.75rem; }
    .search-overlay__input { font-size: var(--font-body-lg); }
    .search-overlay__results { grid-template-columns: 1fr; gap: 1.5rem; padding-block: 1.25rem 2rem; }
    .search-overlay__suggestions { display: none; }
    .search-overlay__tabs { gap: 1.25rem; overflow-x: auto; }
    .search-overlay__product-grid, .search-overlay__collection-grid, .search-overlay__article-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  }
{% endstylesheet %}

{% javascript %}
(() => {
  const controllerKey = '__searchOverlayController';
  if (window[controllerKey]) {
    window[controllerKey].initialize(document);
    return;
  }

  const state = {
    overlay: null,
    input: null,
    form: null,
    results: null,
    sectionRoot: null,
    editorSelected: false,
    timer: null,
    controller: null,
    placeholderTimer: null,
  };

  const getOverlay = (root = document) => {
    if (!root) return null;
    if (root.matches?.('[data-search-overlay]')) return root;
    return root.querySelector?.('[data-search-overlay]') || null;
  };

  const getPlaceholderSuggestions = (overlay) => (overlay?.dataset.placeholderSuggestions || '')
    .split(';')
    .map((suggestion) => suggestion.trim())
    .filter(Boolean);

  const stopPlaceholderRotation = () => {
    window.clearTimeout(state.placeholderTimer);
    state.placeholderTimer = null;
  };

  const startPlaceholderRotation = () => {
    stopPlaceholderRotation();
    const { overlay, input } = state;
    const suggestions = getPlaceholderSuggestions(overlay);
    if (!overlay || !input || !suggestions.length) return;
    const defaultPlaceholder = input.dataset.searchOverlayDefaultPlaceholder || '';
    const placeholders = [...suggestions, defaultPlaceholder].filter(Boolean);

    let placeholderIndex = 0;
    let characterIndex = 0;
    let deleting = false;
    const step = () => {
      if (state.overlay !== overlay || state.input !== input || input.value.trim()) return;
      const placeholder = placeholders[placeholderIndex];

      if (!deleting) {
        characterIndex += 1;
        input.setAttribute('placeholder', placeholder.slice(0, characterIndex));
        if (characterIndex >= placeholder.length) {
          deleting = true;
          state.placeholderTimer = window.setTimeout(step, 1400);
        } else {
          state.placeholderTimer = window.setTimeout(step, 80);
        }
        return;
      }

      characterIndex -= 1;
      input.setAttribute('placeholder', placeholder.slice(0, characterIndex));
      if (characterIndex <= 0) {
        deleting = false;
        placeholderIndex = (placeholderIndex + 1) % placeholders.length;
        state.placeholderTimer = window.setTimeout(step, 500);
      } else {
        state.placeholderTimer = window.setTimeout(step, 45);
      }
    };

    state.placeholderTimer = window.setTimeout(step, 1200);
  };

  const resetPlaceholder = (input) => {
    if (!input) return;
    input.setAttribute('placeholder', input.dataset.searchOverlayDefaultPlaceholder || '');
  };

  const close = ({ force = false } = {}) => {
    if (!state.overlay) return;
    // Selecting the Search section in the Theme Editor may open the overlay for
    // inspection, but an explicit close must always take precedence. Releasing
    // this flag also prevents a subsequent editor refresh from reopening it.
    if (!force) state.editorSelected = false;
    stopPlaceholderRotation();
    state.overlay.setAttribute('hidden', '');
    state.overlay.setAttribute('aria-hidden', 'true');
    if (state.input) state.input.value = '';
    resetPlaceholder(state.input);
    if (state.results) {
      state.results.innerHTML = '';
      state.results.hidden = true;
      state.results.classList.remove('search-overlay__results--has-suggestions');
    }
    state.overlay.classList.remove('search-overlay--has-results');
    state.input?.setAttribute('aria-expanded', 'false');
    window.clearTimeout(state.timer);
    state.controller?.abort();
    state.timer = null;
    state.controller = null;
    document.documentElement.classList.remove('search-overlay-open');
    document.body.classList.remove('search-overlay-open');
    document.dispatchEvent(new CustomEvent('search-overlay:close'));
  };

  const open = ({ focus = true } = {}) => {
    const { overlay, input } = state;
    if (!overlay || !input) return;
    const header = document.querySelector('.shopify-section.header');
    overlay.style.setProperty('--search-overlay-top', `${Math.max(0, header?.getBoundingClientRect().bottom || 0)}px`);
    overlay.removeAttribute('hidden');
    overlay.setAttribute('aria-hidden', 'false');
    startPlaceholderRotation();
    document.documentElement.classList.add('search-overlay-open');
    document.body.classList.add('search-overlay-open');
    document.dispatchEvent(new CustomEvent('search-overlay:open', { detail: { header } }));
    if (focus) window.requestAnimationFrame(() => input.focus());
  };

  const escapeHtml = (value = '') => String(value).replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
  const money = (amount) => new Intl.NumberFormat(document.documentElement.lang || 'en', { style: 'currency', currency: window.Shopify?.currency?.active || 'USD' }).format(Number(amount || 0) / 100);
  const imageUrl = (item) => item?.featured_image?.url || item?.featured_image || item?.image?.url || item?.image || item?.featured_media?.preview_image?.url || '';
  const card = (item, showPrice = false) => {
    const image = imageUrl(item);
    return `<a class="search-overlay__result-card" href="${escapeHtml(item.url)}">${image ? `<img class="search-overlay__image" src="${escapeHtml(image)}" alt="${escapeHtml(item.title)}" loading="lazy">` : '<span class="search-overlay__image"></span>'}<span class="search-overlay__result-title">${escapeHtml(item.title)}</span>${showPrice ? `<span class="search-overlay__price">${escapeHtml(money(item.price))}</span>` : ''}</a>`;
  };

  const getResourceTypes = (overlay) => {
    const types = ['query'];
    if (overlay.dataset.showProducts !== 'false') types.push('product');
    if (overlay.dataset.showCollections !== 'false') types.push('collection');
    if (overlay.dataset.showBlogPosts !== 'false') types.push('article');
    if (overlay.dataset.showPages !== 'false') types.push('page');
    return types.join(',');
  };

  const previewLimit = (resourceType) => resourceType === 'pages' ? 10 : 4;
  const hasMoreResults = (resourceType, count) => resourceType === 'pages' ? count >= previewLimit(resourceType) : count > previewLimit(resourceType);
  const viewAllStyle = (overlay) => ['primary', 'secondary', 'tertiary'].includes(overlay.dataset.viewAllStyle) ? overlay.dataset.viewAllStyle : 'primary';
  const viewAllMarkup = (overlay, query, label, shouldShow) => {
    if (!shouldShow) return '';
    return `<div class="search-overlay__view-all"><a class="btn btn--${viewAllStyle(overlay)}" href="${escapeHtml(overlay.dataset.searchUrl)}?q=${encodeURIComponent(query)}">${escapeHtml(label)}</a></div>`;
  };

  const render = (resourceResults, query, targetOverlay = state.overlay, targetResults = state.results, targetInput = state.input) => {
    if (!targetOverlay || !targetResults) return;
    const products = resourceResults.products || [];
    const collections = resourceResults.collections || [];
    const articles = resourceResults.articles || [];
    const pages = resourceResults.pages || [];
    const queries = resourceResults.queries || [];
    const labels = targetOverlay.dataset;
    const panels = [];
    if (products.length) panels.push(['products', labels.productsLabel, `<div class="search-overlay__product-grid">${products.slice(0, previewLimit('products')).map((item) => card(item, true)).join('')}</div>`]);
    if (collections.length) panels.push(['collections', labels.collectionsLabel, `<div class="search-overlay__collection-grid">${collections.slice(0, previewLimit('collections')).map((item) => card(item)).join('')}</div>`]);
    if (articles.length) panels.push(['articles', labels.blogPostsLabel, `<div class="search-overlay__article-grid">${articles.slice(0, previewLimit('articles')).map((item) => card(item)).join('')}</div>`]);
    if (pages.length) panels.push(['pages', labels.pagesLabel, `<ul class="search-overlay__page-list">${pages.slice(0, previewLimit('pages')).map((item) => `<li><a href="${escapeHtml(item.url)}">${escapeHtml(item.title)}</a></li>`).join('')}</ul>`]);
    if (!panels.length) {
      targetResults.innerHTML = `<p class="search-overlay__empty">${escapeHtml(labels.noResultsLabel)}</p>`;
      targetResults.hidden = false;
      targetResults.classList.remove('search-overlay__results--has-suggestions');
      targetOverlay.classList.add('search-overlay--has-results');
      return;
    }
    const hasOverflow = hasMoreResults('products', products.length)
      || hasMoreResults('collections', collections.length)
      || hasMoreResults('articles', articles.length)
      || hasMoreResults('pages', pages.length);
    const viewAll = viewAllMarkup(targetOverlay, query, labels.viewAllLabel, hasOverflow);
    const productPanelIndex = panels.findIndex(([key]) => key === 'products');
    const viewAllPanelIndex = productPanelIndex >= 0 ? productPanelIndex : 0;
    if (viewAll) panels[viewAllPanelIndex][2] += viewAll;
    const hasSuggestions = queries.length > 0;
    const suggestions = hasSuggestions ? `<aside class="search-overlay__suggestions"><p class="search-overlay__eyebrow">${escapeHtml(labels.suggestionsLabel)}</p><ul class="search-overlay__suggestion-list">${queries.map((item) => `<li><button type="button" data-search-suggestion="${escapeHtml(item.text || item.styled_text || '')}">${escapeHtml(item.text || item.styled_text || '')}</button></li>`).join('')}</ul></aside>` : '';
    targetResults.classList.toggle('search-overlay__results--has-suggestions', hasSuggestions);
    targetResults.innerHTML = `${suggestions}<div class="search-overlay__content"><div class="search-overlay__tabs" role="tablist">${panels.map(([key, label], index) => `<button class="search-overlay__tab" type="button" role="tab" aria-selected="${index === 0}" data-search-tab="${key}">${escapeHtml(label)}</button>`).join('')}</div>${panels.map(([key, , content], index) => `<div class="search-overlay__result-panel" role="tabpanel" data-search-panel="${key}"${index ? ' hidden' : ''}>${content}</div>`).join('')}</div>`;
    targetResults.hidden = false;
    targetOverlay.classList.add('search-overlay--has-results');
    targetResults.querySelectorAll('[data-search-tab]').forEach((tab) => tab.addEventListener('click', () => {
      targetResults.querySelectorAll('[data-search-tab]').forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
      targetResults.querySelectorAll('[data-search-panel]').forEach((panel) => { panel.hidden = panel.dataset.searchPanel !== tab.dataset.searchTab; });
    }));
    targetResults.querySelectorAll('[data-search-suggestion]').forEach((button) => button.addEventListener('click', () => { targetInput.value = button.dataset.searchSuggestion; targetInput.dispatchEvent(new Event('input')); }));
  };

  const initializeOverlay = (nextOverlay) => {
    if (!nextOverlay || nextOverlay.dataset.searchOverlayReady === 'true') return;
    const nextInput = nextOverlay.querySelector('[data-search-overlay-input]');
    const nextForm = nextOverlay.querySelector('[data-search-overlay-form]');
    const nextResults = nextOverlay.querySelector('[data-search-overlay-results]');
    const nextClose = nextOverlay.querySelector('[data-search-overlay-close]');
    const nextBackdrop = nextOverlay.querySelector('[data-search-overlay-backdrop]');
    if (!nextInput || !nextForm || !nextResults || !nextClose || !nextBackdrop) return;

    const wasEditorSelected = state.editorSelected;
    if (state.overlay && state.overlay !== nextOverlay) close({ force: true });
    state.overlay = nextOverlay;
    state.input = nextInput;
    state.form = nextForm;
    state.results = nextResults;
    state.sectionRoot = nextOverlay.closest('.shopify-section') || nextOverlay;
    state.editorSelected = wasEditorSelected;
    nextInput.dataset.searchOverlayDefaultPlaceholder = nextOverlay.dataset.placeholder || nextInput.getAttribute('placeholder') || '';
    resetPlaceholder(nextInput);
    nextOverlay.dataset.searchOverlayReady = 'true';

    nextInput.addEventListener('input', () => {
      const query = nextInput.value.trim();
      window.clearTimeout(state.timer);
      if (!query) {
        nextResults.hidden = true;
        nextResults.innerHTML = '';
        nextResults.classList.remove('search-overlay__results--has-suggestions');
        nextOverlay.classList.remove('search-overlay--has-results');
        nextInput.setAttribute('aria-expanded', 'false');
        resetPlaceholder(nextInput);
        startPlaceholderRotation();
        return;
      }
      stopPlaceholderRotation();
      state.timer = window.setTimeout(async () => {
        state.controller?.abort();
        state.controller = new AbortController();
        const requestController = state.controller;
        const params = new URLSearchParams({ q: query, 'resources[type]': getResourceTypes(nextOverlay), 'resources[limit]': '10', 'resources[limit_scope]': 'each' });
        try {
          const response = await fetch(`${nextOverlay.dataset.predictiveSearchUrl}?${params}`, {
            headers: { Accept: 'application/json' },
            signal: requestController.signal,
          });
          if (!response.ok) throw new Error('Predictive search failed');
          const data = await response.json();
          if (state.overlay !== nextOverlay || state.input !== nextInput || query !== nextInput.value.trim()) return;
          render(data.resources?.results || {}, query, nextOverlay, nextResults, nextInput);
          nextInput.setAttribute('aria-expanded', 'true');
        } catch (error) {
          if (error.name !== 'AbortError' && state.overlay === nextOverlay) {
            nextResults.innerHTML = `<p class="search-overlay__empty">${escapeHtml(nextOverlay.dataset.noResultsLabel)}</p>`;
            nextResults.hidden = false;
            nextResults.classList.remove('search-overlay__results--has-suggestions');
            nextOverlay.classList.add('search-overlay--has-results');
          }
        }
      }, 160);
    });

    nextForm.addEventListener('submit', (event) => { if (!nextInput.value.trim()) event.preventDefault(); });
    nextClose.addEventListener('click', () => close());
    nextBackdrop.addEventListener('click', () => close());
    if (state.editorSelected) open({ focus: false });
  };

  document.addEventListener('click', (event) => {
    if (!event.target.closest?.('[data-search-overlay-open]')) return;
    event.preventDefault();
    initializeOverlay(getOverlay());
    open();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && state.overlay && !state.overlay.hasAttribute('hidden')) close();
  });

  document.addEventListener('shopify:section:load', (event) => {
    const nextOverlay = getOverlay(event.target);
    if (nextOverlay) initializeOverlay(nextOverlay);
  });

  document.addEventListener('shopify:section:unload', (event) => {
    if (!state.overlay) return;
    const target = event.target;
    if (target === state.sectionRoot || target?.contains?.(state.overlay)) {
      close({ force: true });
      state.overlay = null;
      state.input = null;
      state.form = null;
      state.results = null;
      state.sectionRoot = null;
      state.editorSelected = false;
    }
  });

  const isSearchSectionEvent = (event) => {
    const target = event.target;
    return state.overlay && (target === state.sectionRoot || target === state.overlay || target?.contains?.(state.overlay) || state.overlay.contains(target));
  };

  document.addEventListener('shopify:section:select', (event) => {
    const nextOverlay = getOverlay(event.target);
    if (nextOverlay) initializeOverlay(nextOverlay);
    if (!isSearchSectionEvent(event)) return;
    state.editorSelected = true;
    open({ focus: false });
  });

  document.addEventListener('shopify:section:deselect', (event) => {
    if (!isSearchSectionEvent(event)) return;
    state.editorSelected = false;
    close({ force: true });
  });

  window.addEventListener('resize', () => {
    if (!state.overlay || state.overlay.hasAttribute('hidden')) return;
    const header = document.querySelector('.shopify-section.header');
    state.overlay.style.setProperty('--search-overlay-top', `${Math.max(0, header?.getBoundingClientRect().bottom || 0)}px`);
  });

  window[controllerKey] = { initialize: (root) => initializeOverlay(getOverlay(root)) };
  initializeOverlay(getOverlay());
})();
