{% render 'section-stylesheet', asset: 'section-carry-edit.css', inline_on_home: true %}

<carry-edit
  id="carry-edit"
  class="carry-edit carry-edit--layout-{{ section.settings.layout_ratio }} carry-edit--choices-{{ section.settings.choice_style }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width carry-edit--full{% endif %}"
  data-deferred-module="{{ 'carry-edit.js' | asset_url }}"
  data-step-prefix="{{ 'carry_edit.step' | t | escape }}"
  data-step-separator="{{ 'carry_edit.of' | t | escape }}"
  data-curated-edit-label="{{ 'carry_edit.curated_edit' | t | escape }}"
  data-closest-edit-label="{{ 'carry_edit.closest_edit' | t | escape }}"
  data-match-weight-occasion="{{ section.settings.match_weight_occasion }}"
  data-match-weight-silhouette="{{ section.settings.match_weight_silhouette }}"
  data-match-weight-capacity="{{ section.settings.match_weight_capacity }}"
  data-match-weight-finish="{{ section.settings.match_weight_finish }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --carry-edit-product-columns: {{ section.settings.product_columns }};"
>
  <div class="carry-edit__spacing section-spacing">
    <div class="carry-edit__inner">
      <div class="carry-edit__intro"{% if section.settings.heading != blank %} aria-labelledby="CarryEditTitle-{{ section.id }}"{% endif %}>
        {% if section.settings.eyebrow != blank %}
          <p class="carry-edit__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="carry-edit__heading" id="CarryEditTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.intro != blank %}
          <div class="carry-edit__intro-copy rte">{{ section.settings.intro }}</div>
        {% endif %}
      </div>

      <div class="carry-edit__finder">
        <div class="carry-edit__questions" data-carry-edit-questions>
          <div class="carry-edit__step-meta">
            <span data-carry-edit-step-count>{{ 'carry_edit.step' | t }} 1 {{ 'carry_edit.of' | t }} 4</span>
            <span>{{ section.settings.concierge_label | escape }}</span>
          </div>
          <h3 class="carry-edit__question" id="CarryEditQuestion-{{ section.id }}" data-carry-edit-question tabindex="-1">{{ section.settings.question_occasion | escape }}</h3>
          <div class="carry-edit__selection-summary" data-carry-edit-selection-summary hidden></div>
          <div class="carry-edit__choices" role="group" aria-labelledby="CarryEditQuestion-{{ section.id }}" data-carry-edit-choices>
            <button class="carry-edit__choice" type="button" data-carry-edit-choice="workday" aria-pressed="false">{{ section.settings.occasion_workday | escape }}</button>
            <button class="carry-edit__choice" type="button" data-carry-edit-choice="off-duty" aria-pressed="false">{{ section.settings.occasion_off_duty | escape }}</button>
            <button class="carry-edit__choice" type="button" data-carry-edit-choice="after-dark" aria-pressed="false">{{ section.settings.occasion_after_dark | escape }}</button>
            <button class="carry-edit__choice" type="button" data-carry-edit-choice="in-transit" aria-pressed="false">{{ section.settings.occasion_in_transit | escape }}</button>
          </div>
          <div class="carry-edit__flow-footer">
            <button class="carry-edit__back" type="button" data-carry-edit-back hidden>
              <span aria-hidden="true">←</span>
              {{ 'carry_edit.back' | t }}
            </button>
            {% if section.settings.show_progress %}
              <div class="carry-edit__progress" aria-hidden="true">
                <span data-carry-edit-progress></span>
                <span data-carry-edit-progress></span>
                <span data-carry-edit-progress></span>
                <span data-carry-edit-progress></span>
              </div>
            {% endif %}
          </div>
        </div>

        <p class="visually-hidden" data-carry-edit-status role="status" aria-live="polite"></p>
        <div class="carry-edit__result" data-carry-edit-result hidden></div>

        <noscript>
          <div class="carry-edit__noscript">
            <h3>
              {% if section.settings.fallback_badge != blank %}
                {{ section.settings.fallback_badge | escape }}
              {% else %}
                {{ 'carry_edit.curated_edit' | t }}
              {% endif %}
            </h3>
            {% liquid
              assign noscript_link = section.settings.fallback_primary_link
              if noscript_link == blank and section.settings.fallback_collection != blank
                assign noscript_link = section.settings.fallback_collection.url
              endif
            %}
            {% render 'cta', label: section.settings.fallback_primary_label, url: noscript_link, style: 'primary' %}
          </div>
        </noscript>
      </div>
    </div>
  </div>

  <div class="carry-edit__sources" data-carry-edit-sources aria-hidden="true">
    {% for block in section.blocks %}
      {% liquid
        assign path_primary_link = block.settings.primary_link
        if path_primary_link == blank and block.settings.result_collection != blank
          assign path_primary_link = block.settings.result_collection.url
        endif
        assign path_products = block.settings.result_products
        if path_products == blank and block.settings.result_collection != blank
          assign path_products = block.settings.result_collection.products
        endif
        assign path_heading = block.settings.heading
        if path_heading == blank
          assign path_heading = 'carry_edit.curated_edit' | t
        endif
      %}
      <div
        data-carry-edit-path
        data-block-id="{{ block.id }}"
        data-occasion="{{ block.settings.occasion }}"
        data-silhouette="{{ block.settings.silhouette }}"
        data-capacity="{{ block.settings.capacity }}"
        data-finish="{{ block.settings.finish }}"
        data-route-priority="{{ block.settings.route_priority }}"
        {{ block.shopify_attributes }}
      >
        <template data-carry-edit-path-template>
          <div class="carry-edit__result-content" data-carry-edit-rendered>
            {% if block.settings.featured_badge != blank %}
              <p class="carry-edit__result-kicker" data-carry-edit-result-kicker>{{ block.settings.featured_badge | escape }}</p>
            {% else %}
              <p class="carry-edit__result-kicker" data-carry-edit-result-kicker>{{ 'carry_edit.curated_edit' | t }}</p>
            {% endif %}
            <h3 class="carry-edit__result-heading" data-carry-edit-result-heading tabindex="-1">{{ path_heading | escape }}</h3>
            {% if block.settings.copy != blank %}
              <div class="carry-edit__result-copy rte">{{ block.settings.copy }}</div>
            {% endif %}
            <div class="carry-edit__chips" data-carry-edit-chips></div>
            {% if block.settings.primary_label != blank and path_primary_link != blank %}
              <div class="carry-edit__actions">
                {% render 'cta', label: block.settings.primary_label, url: path_primary_link, style: 'primary' %}
              </div>
            {% endif %}

            <ul class="carry-edit__products" role="list">
              {% if path_products != blank %}
                {% for product in path_products limit: section.settings.products_to_show %}
                  <li class="carry-edit__product">
                    {% render 'product-card',
                      product: product,
                      show_badges: true,
                      show_compare_at_price: true,
                      show_variant_dots: true,
                      show_media_actions: true,
                      enable_quick_view: true
                    %}
                  </li>
                {% endfor %}
              {% else %}
                {% for placeholder_number in (1..section.settings.products_to_show) %}
                  <li class="carry-edit__product">
                    {% render 'product-card', placeholder_index: placeholder_number %}
                  </li>
                {% endfor %}
              {% endif %}
            </ul>

            <button class="carry-edit__restart" type="button" data-carry-edit-restart>{{ 'carry_edit.start_again' | t }}</button>
          </div>
        </template>
      </div>
    {% endfor %}

    {% liquid
      assign fallback_primary_link = section.settings.fallback_primary_link
      if fallback_primary_link == blank and section.settings.fallback_collection != blank
        assign fallback_primary_link = section.settings.fallback_collection.url
      endif
      assign fallback_products = section.settings.fallback_products
      if fallback_products == blank and section.settings.fallback_collection != blank
        assign fallback_products = section.settings.fallback_collection.products
      endif
      assign fallback_heading = section.settings.fallback_heading
      if fallback_heading == blank
        assign fallback_heading = 'carry_edit.curated_edit' | t
      endif
    %}
    <div data-carry-edit-fallback>
      <template data-carry-edit-path-template>
        <div class="carry-edit__result-content" data-carry-edit-rendered>
          {% if section.settings.fallback_badge != blank %}
            <p class="carry-edit__result-kicker" data-carry-edit-result-kicker>{{ section.settings.fallback_badge | escape }}</p>
          {% else %}
            <p class="carry-edit__result-kicker" data-carry-edit-result-kicker>{{ 'carry_edit.curated_edit' | t }}</p>
          {% endif %}
          <h3 class="carry-edit__result-heading" data-carry-edit-result-heading tabindex="-1">{{ fallback_heading | escape }}</h3>
          {% if section.settings.fallback_copy != blank %}
            <div class="carry-edit__result-copy rte">{{ section.settings.fallback_copy }}</div>
          {% endif %}
          <div class="carry-edit__chips" data-carry-edit-chips></div>
          {% if section.settings.fallback_primary_label != blank and fallback_primary_link != blank %}
            <div class="carry-edit__actions">
              {% render 'cta', label: section.settings.fallback_primary_label, url: fallback_primary_link, style: 'primary' %}
            </div>
          {% endif %}

          <ul class="carry-edit__products" role="list">
            {% if fallback_products != blank %}
              {% for product in fallback_products limit: section.settings.products_to_show %}
                <li class="carry-edit__product">
                  {% render 'product-card',
                    product: product,
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true
                  %}
                </li>
              {% endfor %}
            {% else %}
              {% for placeholder_number in (1..section.settings.products_to_show) %}
                <li class="carry-edit__product">
                  {% render 'product-card', placeholder_index: placeholder_number %}
                </li>
              {% endfor %}
            {% endif %}
          </ul>

          <button class="carry-edit__restart" type="button" data-carry-edit-restart>{{ 'carry_edit.start_again' | t }}</button>
        </div>
      </template>
    </div>
  </div>

  <script type="application/json" data-carry-edit-steps>
    [
      {
        "key": "occasion",
        "question": {{ section.settings.question_occasion | json }},
        "answers": [
          { "value": "workday", "label": {{ section.settings.occasion_workday | json }} },
          { "value": "off-duty", "label": {{ section.settings.occasion_off_duty | json }} },
          { "value": "after-dark", "label": {{ section.settings.occasion_after_dark | json }} },
          { "value": "in-transit", "label": {{ section.settings.occasion_in_transit | json }} }
        ]
      },
      {
        "key": "silhouette",
        "question": {{ section.settings.question_silhouette | json }},
        "answers": [
          { "value": "structured-tote", "label": {{ section.settings.silhouette_structured_tote | json }} },
          { "value": "shoulder", "label": {{ section.settings.silhouette_shoulder | json }} },
          { "value": "crossbody", "label": {{ section.settings.silhouette_crossbody | json }} },
          { "value": "mini-clutch", "label": {{ section.settings.silhouette_mini_clutch | json }} },
          { "value": "weekender", "label": {{ section.settings.silhouette_weekender | json }} }
        ]
      },
      {
        "key": "capacity",
        "question": {{ section.settings.question_capacity | json }},
        "answers": [
          { "value": "essentials", "label": {{ section.settings.capacity_essentials | json }} },
          { "value": "day", "label": {{ section.settings.capacity_day | json }} },
          { "value": "laptop-13", "label": {{ section.settings.capacity_laptop_13 | json }} },
          { "value": "laptop-16", "label": {{ section.settings.capacity_laptop_16 | json }} },
          { "value": "overnight", "label": {{ section.settings.capacity_overnight | json }} }
        ]
      },
      {
        "key": "finish",
        "question": {{ section.settings.question_finish | json }},
        "answers": [
          { "value": "black-gold", "label": {{ section.settings.finish_black_gold | json }} },
          { "value": "espresso-gold", "label": {{ section.settings.finish_espresso_gold | json }} },
          { "value": "neutral-silver", "label": {{ section.settings.finish_neutral_silver | json }} },
          { "value": "statement", "label": {{ section.settings.finish_statement | json }} }
        ]
      }
    ]
  </script>
</carry-edit>

{% schema %}
{
  "name": "Carry Edit",
  "tag": "section",
  "class": "section-carry-edit",
  "limit": 1,
  "max_blocks": 40,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Noryvelle carry edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the bag that moves with you." },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Four considered choices lead to an edit shaped around your day, your essentials, and the way you carry them.</p>" },
    { "type": "text", "id": "concierge_label", "label": "Interaction label", "default": "Bag concierge" },
    { "type": "header", "content": "Step 1 · Occasion" },
    { "type": "text", "id": "question_occasion", "label": "Question 1 label", "default": "Where will you carry it?" },
    { "type": "text", "id": "occasion_workday", "label": "Occasion label: Workday", "default": "Workday" },
    { "type": "text", "id": "occasion_off_duty", "label": "Occasion label: Off duty", "default": "Off duty" },
    { "type": "text", "id": "occasion_after_dark", "label": "Occasion label: After dark", "default": "After dark" },
    { "type": "text", "id": "occasion_in_transit", "label": "Occasion label: In transit", "default": "In transit" },
    { "type": "header", "content": "Step 2 · Silhouette" },
    { "type": "text", "id": "question_silhouette", "label": "Question 2 label", "default": "Which shape feels most like you?" },
    { "type": "text", "id": "silhouette_structured_tote", "label": "Silhouette label: Structured tote", "default": "Structured tote" },
    { "type": "text", "id": "silhouette_shoulder", "label": "Silhouette label: Shoulder bag", "default": "Shoulder bag" },
    { "type": "text", "id": "silhouette_crossbody", "label": "Silhouette label: Crossbody", "default": "Crossbody" },
    { "type": "text", "id": "silhouette_mini_clutch", "label": "Silhouette label: Mini or clutch", "default": "Mini or clutch" },
    { "type": "text", "id": "silhouette_weekender", "label": "Silhouette label: Weekender", "default": "Weekender" },
    { "type": "header", "content": "Step 3 · Capacity" },
    { "type": "text", "id": "question_capacity", "label": "Question 3 label", "default": "What needs to fit?" },
    { "type": "text", "id": "capacity_essentials", "label": "Capacity label: Essentials", "default": "Phone, cards and keys" },
    { "type": "text", "id": "capacity_day", "label": "Capacity label: Day", "default": "Everyday essentials" },
    { "type": "text", "id": "capacity_laptop_13", "label": "Capacity label: 13-inch laptop", "default": "13-inch laptop" },
    { "type": "text", "id": "capacity_laptop_16", "label": "Capacity label: 16-inch laptop", "default": "16-inch laptop" },
    { "type": "text", "id": "capacity_overnight", "label": "Capacity label: Overnight", "default": "An overnight edit" },
    { "type": "header", "content": "Step 4 · Finish" },
    { "type": "text", "id": "question_finish", "label": "Question 4 label", "default": "Choose your finish." },
    { "type": "text", "id": "finish_black_gold", "label": "Finish label: Black and gold", "default": "Black with gold" },
    { "type": "text", "id": "finish_espresso_gold", "label": "Finish label: Espresso and gold", "default": "Espresso with gold" },
    { "type": "text", "id": "finish_neutral_silver", "label": "Finish label: Neutral and silver", "default": "Neutral with silver" },
    { "type": "text", "id": "finish_statement", "label": "Finish label: Statement", "default": "A statement finish" },
    { "type": "header", "content": "Routing behavior" },
    { "type": "paragraph", "content": "A specific condition must match. Any is a wildcard. Compatible paths beat nearest paths; weighted specificity wins, then path priority, then block order." },
    { "type": "range", "id": "match_weight_occasion", "label": "Occasion match weight", "min": 1, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "match_weight_silhouette", "label": "Silhouette match weight", "min": 1, "max": 10, "step": 1, "default": 5 },
    { "type": "range", "id": "match_weight_capacity", "label": "Capacity match weight", "min": 1, "max": 10, "step": 1, "default": 6 },
    { "type": "range", "id": "match_weight_finish", "label": "Finish match weight", "min": 1, "max": 10, "step": 1, "default": 2 },
    { "type": "header", "content": "Fallback carry edit" },
    { "type": "paragraph", "content": "Used only when no Carry path is available. Add broad wildcard paths to cover the full quiz without creating one block per combination." },
    { "type": "collection", "id": "fallback_collection", "label": "Fallback collection", "info": "Supplies product cards and the primary link when no fallback product list or link is selected." },
    { "type": "product_list", "id": "fallback_products", "label": "Fallback products", "limit": 6, "info": "Takes priority over the fallback collection." },
    { "type": "text", "id": "fallback_heading", "label": "Fallback heading", "default": "A considered {silhouette} edit for {occasion}.", "info": "Supports {occasion}, {silhouette}, {capacity}, and {finish}." },
    { "type": "richtext", "id": "fallback_copy", "label": "Fallback copy", "default": "<p>Selected around what you carry, with a finish designed to settle naturally into your wardrobe.</p>", "info": "Supports {occasion}, {silhouette}, {capacity}, and {finish}." },
    { "type": "text", "id": "fallback_badge", "label": "Fallback badge", "default": "Your considered carry edit" },
    { "type": "text", "id": "fallback_primary_label", "label": "Fallback CTA label", "default": "Explore all bags" },
    { "type": "url", "id": "fallback_primary_link", "label": "Fallback CTA link", "info": "Uses the fallback collection when empty." },
    { "type": "header", "content": "Product cards" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 6, "step": 1, "default": 3 },
    { "type": "select", "id": "product_columns", "label": "Desktop product columns", "options": [{ "value": "2", "label": "2 columns" }, { "value": "3", "label": "3 columns" }], "default": "3" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }], "default": "full" },
    { "type": "select", "id": "layout_ratio", "label": "Desktop panel ratio", "options": [{ "value": "balanced", "label": "Balanced" }, { "value": "editorial", "label": "Larger introduction" }, { "value": "finder", "label": "Larger finder" }], "default": "finder" },
    { "type": "select", "id": "choice_style", "label": "Choice style", "options": [{ "value": "outline", "label": "Outlined cards" }, { "value": "soft", "label": "Soft fill" }, { "value": "pill", "label": "Rounded pills" }], "default": "outline" },
    { "type": "checkbox", "id": "show_progress", "label": "Show step progress", "default": true },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "carry_path",
      "name": "Carry path",
      "settings": [
        { "type": "paragraph", "content": "Each block is one curated carry edit. Use specific conditions wherever possible; Any creates a broader path." },
        { "type": "text", "id": "path_label", "label": "Internal path label", "default": "Occasion · Silhouette · Capacity · Finish", "info": "Use a clear label so this path is easy to manage in the Theme Editor." },
        { "type": "header", "content": "Match conditions" },
        { "type": "select", "id": "occasion", "label": "Occasion", "options": [{ "value": "any", "label": "Any occasion" }, { "value": "workday", "label": "Workday" }, { "value": "off-duty", "label": "Off duty" }, { "value": "after-dark", "label": "After dark" }, { "value": "in-transit", "label": "In transit" }], "default": "workday" },
        { "type": "select", "id": "silhouette", "label": "Silhouette", "options": [{ "value": "any", "label": "Any silhouette" }, { "value": "structured-tote", "label": "Structured tote" }, { "value": "shoulder", "label": "Shoulder bag" }, { "value": "crossbody", "label": "Crossbody" }, { "value": "mini-clutch", "label": "Mini or clutch" }, { "value": "weekender", "label": "Weekender" }], "default": "structured-tote" },
        { "type": "select", "id": "capacity", "label": "Capacity", "options": [{ "value": "any", "label": "Any capacity" }, { "value": "essentials", "label": "Phone, cards and keys" }, { "value": "day", "label": "Everyday essentials" }, { "value": "laptop-13", "label": "13-inch laptop" }, { "value": "laptop-16", "label": "16-inch laptop" }, { "value": "overnight", "label": "Overnight" }], "default": "laptop-13" },
        { "type": "select", "id": "finish", "label": "Finish", "options": [{ "value": "any", "label": "Any finish" }, { "value": "black-gold", "label": "Black with gold" }, { "value": "espresso-gold", "label": "Espresso with gold" }, { "value": "neutral-silver", "label": "Neutral with silver" }, { "value": "statement", "label": "Statement finish" }], "default": "black-gold" },
        { "type": "range", "id": "route_priority", "label": "Tie-break priority", "min": 0, "max": 20, "step": 1, "default": 0, "info": "Higher wins only when path scores are otherwise equal. Block order is the final tie-break." },
        { "type": "header", "content": "Products and destination" },
        { "type": "collection", "id": "result_collection", "label": "Result collection", "info": "Supplies product cards and the primary link when no product list or link is selected." },
        { "type": "product_list", "id": "result_products", "label": "Result products", "limit": 6, "info": "Takes priority over the result collection." },
        { "type": "text", "id": "primary_label", "label": "Primary CTA label", "default": "Explore this carry edit" },
        { "type": "url", "id": "primary_link", "label": "Primary CTA link", "info": "Uses the result collection when empty." },
        { "type": "header", "content": "Result copy" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A {silhouette} shaped for {occasion}.", "info": "Supports {occasion}, {silhouette}, {capacity}, and {finish}." },
        { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>A considered edit with room for {capacity} and a finish that works naturally with your wardrobe.</p>", "info": "Supports {occasion}, {silhouette}, {capacity}, and {finish}." },
        { "type": "text", "id": "featured_badge", "label": "Featured badge", "default": "Your Noryvelle carry edit" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
