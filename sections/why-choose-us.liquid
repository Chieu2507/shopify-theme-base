{% render 'section-stylesheet', asset: 'section-why-choose-us.css', defer_on_home: true %}

{% liquid
  assign section_background = section.settings.background_color
  if section_background == blank
    assign section_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} { background: {{ section_background }}; }
  #shopify-section-{{ section.id }} .why-choose-us { background: transparent; }
{% endstyle %}

<div
  class="why-choose-us color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --why-choose-us-column-gap: {{ section.settings.column_gap }}px;"
>
  <div class="why-choose-us__inner section-spacing{% if section.settings.section_width == 'page' %} page-width{% endif %}">
    <header class="why-choose-us__header" data-reveal-group>
      {% content_for 'block', type: 'label', id: 'section_label' %}
      {% content_for 'block', type: 'heading', id: 'section_heading' %}
    </header>

    <div class="why-choose-us__stats" role="list" aria-label="{{ section.settings.statistics_accessibility_label | escape }}" data-reveal-group>
      {% content_for 'block', type: 'why-choose-us-stat', id: 'stat_1' %}
      {% content_for 'block', type: 'why-choose-us-stat', id: 'stat_2' %}
      {% content_for 'block', type: 'why-choose-us-stat', id: 'stat_3' %}
    </div>

    <div class="why-choose-us__archives" role="list" aria-label="{{ section.settings.archives_accessibility_label | escape }}" data-reveal-group>
      {% content_for 'block', type: 'why-choose-us-archive-card', id: 'archive_1' %}
      {% content_for 'block', type: 'why-choose-us-archive-card', id: 'archive_2' %}
      {% content_for 'block', type: 'why-choose-us-archive-card', id: 'archive_3' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why choose us",
  "tag": "section",
  "class": "section-why-choose-us",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "page"
    },
    { "type": "range", "id": "column_gap", "label": "Desktop column gap", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "text", "id": "statistics_accessibility_label", "label": "Statistics accessibility label", "default": "Why choose Spinel statistics" },
    { "type": "text", "id": "archives_accessibility_label", "label": "Archive links accessibility label", "default": "Explore the collection" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "color", "id": "background_color", "label": "Background color", "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme." },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [
    {
      "name": "Why choose us",
      "category": "Editorial content",
      "settings": { "section_width": "page", "column_gap": 40, "color_scheme": "scheme-4", "padding_top": 80, "padding_bottom": 80 },
      "blocks": [
        { "type": "label", "id": "section_label", "static": true, "settings": { "text": "<p>03 / WHY SPINEL</p>", "reveal_type": "fade-up", "reveal_delay": 0 } },
        { "type": "heading", "id": "section_heading", "static": true, "settings": { "heading": "<h2>In fine red, scarcer than the ruby it named.</h2>", "type_preset": "h4", "reveal_type": "fade-up", "reveal_delay": 150 } },
        { "type": "why-choose-us-stat", "id": "stat_1", "static": true, "settings": { "value": "8 MM", "description": "<p>NATURAL, UNTREATED<br>MOGOK, BURMA</p>" } },
        { "type": "why-choose-us-stat", "id": "stat_2", "static": true, "settings": { "value": "42 HOURS", "description": "<p>SETTING AND HAND-FINISHING<br>18K HALLMARKED</p>" } },
        { "type": "why-choose-us-stat", "id": "stat_3", "static": true, "settings": { "value": "600 YEARS", "description": "<p>CATALOGUED AS RUBY UNTIL GEMOLOGY SETTLED IT —<br>THE NAME NEVER CAUGHT UP</p>" } },
        { "type": "why-choose-us-archive-card", "id": "archive_1", "static": true, "settings": { "label": "ARCHIVE N° 01", "title": "The Necklaces", "action_label": "Enter" } },
        { "type": "why-choose-us-archive-card", "id": "archive_2", "static": true, "settings": { "label": "ARCHIVE N° 02", "title": "The Rings", "action_label": "Enter" } },
        { "type": "why-choose-us-archive-card", "id": "archive_3", "static": true, "settings": { "label": "ARCHIVE N° 03", "title": "The Art of Giving", "action_label": "Enter" } }
      ]
    }
  ]
}
{% endschema %}
