{% render 'section-stylesheet', asset: 'section-why-choose-us.css', defer_on_home: true %}

{% liquid
  assign section_background = section.settings.background_color
  if section_background == blank
    assign section_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif
  assign background_image_alt = section.settings.background_image.alt | default: section.settings.mobile_background_image.alt
%}

{% style %}
  #shopify-section-{{ section.id }} { background: {{ section_background }}; }
  #shopify-section-{{ section.id }} .why-choose-us { background: transparent; }
{% endstyle %}

<div
  class="why-choose-us color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}{% if section.settings.use_custom_background_image %} why-choose-us--has-background-image{% endif %}{% if section.settings.enable_bottom_blur %} why-choose-us--with-bottom-blur{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --why-choose-us-overlay-color: {{ section.settings.overlay_color }}; --why-choose-us-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {% if section.settings.use_custom_background_image %}
    <div class="why-choose-us__background" aria-hidden="true">
      {% render 'responsive-media',
        image: section.settings.background_image,
        mobile_image: section.settings.mobile_background_image,
        mobile_breakpoint: 767,
        max_width: 2400,
        mobile_max_width: 1280,
        widths: '750, 960, 1200, 1600, 1920, 2400',
        mobile_widths: '375, 550, 750, 960, 1280',
        sizes: '100vw',
        class: 'why-choose-us__background-image',
        alt: background_image_alt,
        decorative: true,
        loading: 'lazy',
        placeholder_asset: 'placeholder-image-default-3.svg',
        placeholder_class: 'why-choose-us__background-placeholder'
      %}
    </div>
    <div class="why-choose-us__background-overlay" aria-hidden="true"></div>
  {% endif %}

  <div class="why-choose-us__inner section-spacing{% if section.settings.section_width == 'page' %} page-width{% endif %}">
    <div class="why-choose-us__content">
      <header class="why-choose-us__header" data-reveal-group>
        <div class="why-choose-us__header-content">
          {% content_for 'block', type: 'label', id: 'section_label' %}
          {% content_for 'block', type: 'heading', id: 'section_heading' %}
          {% content_for 'block', type: 'text', id: 'section_text' %}
          {% content_for 'block', type: 'button', id: 'section_button' %}
        </div>
      </header>

      {% content_for 'block', type: 'why-choose-us-statistics', id: 'statistics' %}
    </div>

    <div class="why-choose-us__archive-region">
      {% content_for 'block', type: 'why-choose-us-archives', id: 'archives' %}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Why choose us",
  "tag": "section",
  "class": "section-why-choose-us",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "page"
    },
    { "type": "header", "content": "Background transition" },
    { "type": "checkbox", "id": "enable_bottom_blur", "label": "Show bottom blur", "default": false },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "color", "id": "background_color", "label": "Background color", "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme." },
    { "type": "checkbox", "id": "use_custom_background_image", "label": "Use custom background image", "default": false },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "visible_if": "{{ section.settings.use_custom_background_image }}" },
    { "type": "image_picker", "id": "mobile_background_image", "label": "Mobile image", "visible_if": "{{ section.settings.use_custom_background_image }}" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000", "visible_if": "{{ section.settings.use_custom_background_image }}" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 45, "visible_if": "{{ section.settings.use_custom_background_image }}" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [
    {
      "name": "Why choose us",
      "category": "Editorial content",
      "settings": { "section_width": "page", "color_scheme": "scheme-4", "padding_top": 80, "padding_bottom": 80, "enable_bottom_blur": false, "use_custom_background_image": false, "overlay_color": "#000000", "overlay_opacity": 45 },
      "blocks": [
        { "type": "label", "id": "section_label", "static": true, "settings": { "text": "<p>THE STONE</p>", "reveal_type": "fade-up", "reveal_delay": 0 } },
        { "type": "heading", "id": "section_heading", "static": true, "settings": { "heading": "<h2>LIGHT<br>REMEMBERS</h2>", "type_preset": "h2", "reveal_type": "fade-up", "reveal_delay": 150 } },
        { "type": "text", "id": "section_text", "static": true, "settings": { "text": "<p>Born deep within ancient earth, each spinel carries a memory older than time — shaped by pressure, warmed by fire, and perfected by nature.</p>", "type_preset": "md", "reveal_type": "fade-up", "reveal_delay": 200 } },
        { "type": "button", "id": "section_button", "static": true, "settings": { "label": "Read our story", "style": "tertiary", "icon": "arrow-right", "reveal_type": "fade-up", "reveal_delay": 300 } },
        { "type": "why-choose-us-statistics", "id": "statistics", "static": true, "settings": { "columns_desktop": "3", "columns_mobile": "1", "item_gap": 40, "heading_size": "h2", "text_size": "xs" }, "blocks": [
          { "type": "why-choose-us-stat", "settings": { "value": "8 MM", "description": "<p>NATURAL, UNTREATED<br>MOGOK, BURMA</p>" } },
          { "type": "why-choose-us-stat", "settings": { "value": "42 HOURS", "description": "<p>SETTING AND HAND-FINISHING<br>18K HALLMARKED</p>" } },
          { "type": "why-choose-us-stat", "settings": { "value": "600 YEARS", "description": "<p>CATALOGUED AS RUBY UNTIL GEMOLOGY SETTLED IT —<br>THE NAME NEVER CAUGHT UP</p>" } }
        ] },
        { "type": "why-choose-us-archives", "id": "archives", "static": true, "settings": { "columns_desktop": "3", "columns_mobile": "1", "item_gap": 40, "image_width": 104, "image_ratio": "4-3", "label_size": "label", "heading_size": "h6", "text_size": "sm", "button_style": "tertiary", "button_size": "small" }, "blocks": [
          { "type": "why-choose-us-archive-card", "settings": { "label": "ARCHIVE N° 01", "title": "The Necklaces", "action_label": "Enter" } },
          { "type": "why-choose-us-archive-card", "settings": { "label": "ARCHIVE N° 02", "title": "The Rings", "action_label": "Enter" } },
          { "type": "why-choose-us-archive-card", "settings": { "label": "ARCHIVE N° 03", "title": "The Art of Giving", "action_label": "Enter" } }
        ] }
      ]
    }
  ]
}
{% endschema %}

