{% liquid
  assign logo_width = settings.logo_width
  if logo_width == blank
    assign logo_width = 180
  endif
  assign logo_width_mobile = settings.logo_width_mobile
  if logo_width_mobile == blank
    assign logo_width_mobile = 140
  endif
  assign logo_sizes = '(min-width: 768px) ' | append: logo_width | append: 'px, ' | append: logo_width_mobile | append: 'px'
  assign logo_image = settings.logo
  assign logo_class = 'site-logo'

  if section.settings.header_overlay
    assign logo_class = logo_class | append: ' site-logo--transparent'
    if settings.logo_transparent != blank
      assign logo_image = settings.logo_transparent
    endif
  endif
%}

<header class="section-color-scope {{ section.settings.color_scheme | default: 'scheme-1' }}">
  <div class="header__title">
    <a class="{{ logo_class }}" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if logo_image != blank %}
        {{
          logo_image
          | image_url: width: logo_width
          | image_tag:
            widths: '80, 120, 140, 180, 240, 320, 400',
            sizes: logo_sizes,
            class: 'site-logo__image',
            alt: shop.name
        }}
      {% else %}
        <span class="site-logo__fallback">{{ shop.name | escape }}</span>
      {% endif %}
    </a>
  </div>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account class="icon" menu="{{ section.settings.customer_account_menu }}">
        <span class="visually-hidden">{{ 'accessibility.account' | t }}</span>
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a class="icon" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart' | t }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      <span class="visually-hidden">{{ 'accessibility.cart' | t }}</span>
      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    min-height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--body-color);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header .header__title .site-logo {
    justify-content: flex-start;
    width: var(--logo-width);
    max-width: min(var(--logo-width), 45vw);
    min-width: 0;
  }
  .site-logo__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 3.5rem;
    object-fit: contain;
  }
  .site-logo__fallback {
    overflow-wrap: anywhere;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    display: block;
    width: var(--icon-size-large);
    height: var(--icon-size-large);
    stroke-width: var(--icon-stroke-width);
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }
  header .header__menu a {
    border-radius: var(--navigation-radius);
  }
  header .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--button-height);
    min-height: var(--button-height);
    color: inherit;
    line-height: 1;
  }
  @media (max-width: 767.98px) {
    header {
      gap: 0.75rem;
    }
    header .header__menu {
      display: none;
    }
    header .icon {
      min-width: var(--button-height-mobile);
      min-height: var(--button-height-mobile);
    }
    header .header__title .site-logo {
      width: min(var(--logo-width-mobile), 52vw);
      max-width: min(var(--logo-width-mobile), 52vw);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "header_overlay",
      "label": "t:labels.use_transparent_logo",
      "info": "t:info.header_overlay",
      "default": false
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
