          "type": "range",
          "id": "width_desktop",
          "min": 80,
          "max": 280,
          "step": 10,
          "unit": "px",
          "label": "Desktop width",
          "default": 170
        },
        {
          "type": "range",
          "id": "width_mobile",
          "min": 70,
          "max": 180,
          "step": 10,
          "unit": "px",
          "label": "Tablet and mobile width",
          "default": 120
        }
      ]
    },
    {
      "type": "menu_badge",
      "name": "Menu badge",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item title",
          "info": "Must exactly match a top-level menu item."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "New"
        }
      ]
    },
