            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="2"></rect><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="2"></circle><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"></circle></svg>
          </a>
          <a href="{{ routes.root_url }}" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 8.2a2.8 2.8 0 0 0-2-2C17.2 5.7 12 5.7 12 5.7s-5.2 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.5 12 29 29 0 0 0 3 15.8a2.8 2.8 0 0 0 2 2c1.8.5 7 .5 7 .5s5.2 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.8 29 29 0 0 0-.5-3.8ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z" fill="currentColor"></path></svg>
          </a>
          <a href="{{ routes.root_url }}" aria-label="TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.5 4c.4 2.3 1.7 3.7 4 4v3.1a8.4 8.4 0 0 1-4-1.2v6.4a5.2 5.2 0 1 1-4.6-5.2v3.2a2.1 2.1 0 1 0 1.5 2V4h3.1Z" fill="currentColor"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="helix-header__drawer helix-header__drawer--search" data-helix-search-drawer aria-hidden="true">
    <div class="helix-header__drawer-panel" role="dialog" aria-modal="true" aria-label="{{ 'header.search' | t }}" tabindex="-1">
      <div class="helix-header__drawer-top">
        <strong>{{ 'header.search' | t }}</strong>
        <button class="helix-header__close-button" type="button" data-helix-close-layer aria-label="{{ 'general.close' | t }}">{% render 'helix-icon-close' %}</button>
      </div>
      <form action="{{ routes.search_url }}" method="get" class="helix-header__search-form">
        <label class="visually-hidden" for="{{ helix_header_id }}-search">{{ 'header.search' | t }}</label>
        <input id="{{ helix_header_id }}-search" type="search" name="q" placeholder="What are you looking for?" autocomplete="off">
        <button type="submit" aria-label="{{ 'header.search' | t }}">{% render 'helix-icon-search' %}</button>
      </form>
      <p class="helix-header__drawer-note">{{ 'header.popular_searches' | t }}</p>
      <div class="helix-header__search-links">
        <a href="{{ helix_trending_collection_url }}">{{ 'header.trending' | t }}</a>
        <a href="{{ helix_best_sellers_collection_url }}">{{ 'header.best_sellers' | t }}</a>
        <a href="{{ helix_sale_collection_url }}">{{ 'header.on_sale' | t }}</a>
      </div>
    </div>
  </div>

  <div class="helix-header__drawer helix-header__drawer--cart" data-helix-cart-drawer aria-hidden="true">
    <div class="helix-header__drawer-panel" role="dialog" aria-modal="true" aria-label="{{ 'header.cart' | t }}" tabindex="-1">
      <div class="helix-header__drawer-top">
        <strong>{{ 'header.cart' | t }}</strong>
        <button class="helix-header__close-button" type="button" data-helix-close-layer aria-label="{{ 'general.close' | t }}">{% render 'helix-icon-close' %}</button>
      </div>
      {% if cart.item_count > 0 %}
        <p class="helix-header__cart-message">{{ cart.item_count }} {{ 'header.items_in_cart' | t }}</p>
        <div class="helix-header__cart-total">{{ cart.total_price | money }}</div>
        <a class="helix-header__drawer-button helix-header__drawer-button--dark" href="{{ routes.cart_url }}">{{ 'header.view_cart' | t }}</a>
        {% if additional_checkout_buttons %}{{ content_for_additional_checkout_buttons }}{% endif %}
      {% else %}
        <p class="helix-header__cart-message">{{ 'header.empty_cart' | t }}</p>
        <a class="helix-header__drawer-button" href="{{ routes.all_products_collection_url }}">{{ 'header.shop' | t }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@700&family=Figtree:wght@400;500;600;700&display=swap');

  #{{ helix_header_id }} {
    --helix-font: {% if section.settings.font_family != blank %}{{ section.settings.font_family.family }}, {{ section.settings.font_family.fallback_families }}{% else %}'Figtree', sans-serif{% endif %};
  }
{% endstyle %}

{% stylesheet %}
  .helix-header,
  .helix-header * {
    box-sizing: border-box;
  }

  .helix-header {
    position: relative;
    z-index: 30;
    width: 100vw;
    color: var(--helix-solid-text);
    font-family: var(--helix-font, 'Figtree', 'Open Sans', Arial, sans-serif);
    font-size: 14px;
    line-height: 1.6;
  }

  body:has(.helix-header) {
    overflow-x: hidden;
  }

  html.helix-header-lock,
  html.helix-header-lock body {
    overflow: hidden;
  }

  .helix-header button,
  .helix-header input {
    color: inherit;
    font: inherit;
  }

  .helix-header button,
  .helix-header summary {
    cursor: pointer;
  }

  .helix-header a {
    color: inherit;
    text-decoration: none;
  }

  .helix-header__announcement {
    display: grid;
    min-height: 38.4px;
    grid-template-columns: 32px minmax(0, 700px) 32px;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    overflow: hidden;
    background: var(--helix-announcement-bg);
    color: var(--helix-announcement-text);
    font-size: 14px;
    line-height: 22.4px;
  }

  .helix-header__announcement-track {
    position: relative;
    grid-column: 2;
    width: 100%;
    min-width: 0;
    height: 22.4px;
    min-height: 22.4px;
    overflow: hidden;
    text-align: center;
  }

  .helix-header__announcement-message {
    position: absolute;
    inset: 0;
    margin: 0;
    width: 100%;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(7px);
    transition: opacity .2s cubic-bezier(.6, .14, 0, 1), transform .3s cubic-bezier(.6, .14, 0, 1);
    pointer-events: none;
  }

  .helix-header__announcement-message.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .helix-header__announcement-message strong {
    font-weight: 700;
  }

  .helix-header__announcement-side {
    display: flex;
    width: 32px;
    height: 38.4px;
    align-items: center;
    justify-content: center;
  }

  .helix-header__announcement-side--right {
    grid-column: 3;
  }

  .helix-header__announcement-side button {
    display: grid;
    width: 32px;
    height: 38.4px;
    padding: 0;
    place-items: center;
    border: 0;
    background: transparent;
    font-size: 14px;
    line-height: 22.4px;
    transition: transform .2s ease, opacity .2s ease;
  }

  .helix-header__announcement-side--left {
    grid-column: 1;
  }

  .helix-header__announcement-side--left button span {
    display: inline-flex;
    transform: rotate(90deg);
  }

  .helix-header__announcement-side--right button span {
    display: inline-flex;
    transform: rotate(-90deg);
  }

  .helix-header__announcement-side button svg {
    width: 16px;
    height: 16px;
  }

  .helix-header__announcement-side button:hover,
  .helix-header__announcement-side button:focus-visible {
    transform: translateX(3px);
    opacity: .62;
  }

  .helix-header__announcement-side--left button:hover,
  .helix-header__announcement-side--left button:focus-visible {
    transform: translateX(-3px);
  }

  .helix-header__desktop-bar,
  .helix-header__mobile-bar {
    position: absolute;
    z-index: 3;
    top: 38.4px;
    right: 0;
    left: 0;
    color: var(--helix-solid-text);
  }

  .helix-header--no-announcement .helix-header__desktop-bar,
  .helix-header--no-announcement .helix-header__mobile-bar {
    top: 0;
  }

  .helix-header__desktop-surface,
  .helix-header__mobile-inner {
    background: transparent;
    transition: background-color .2s cubic-bezier(.6, 0, .4, 1), box-shadow .2s cubic-bezier(.6, 0, .4, 1), color .2s cubic-bezier(.6, 0, .4, 1);
  }

  .helix-header__desktop-surface {
    position: relative;
    z-index: 1;
    isolation: isolate;
  }

  .helix-header__menu-background {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    left: 0;
    height: 0;
    background: transparent;
    pointer-events: none;
    transition: height .3s cubic-bezier(.6, .14, 0, 1);
  }

  .helix-header__desktop-surface::before {
    display: none;
  }

  .helix-header__desktop-inner {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(1820px, calc(100vw - 100px));
    min-height: 80px;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    margin-left: 50px;
    margin-right: 0;
    gap: 10px;
    padding: 24px 0;
  }

  .helix-header__desktop-nav,
  .helix-header__actions {
    display: flex;
    min-width: 0;
    align-items: center;
  }

  .helix-header__desktop-nav {
    justify-content: flex-start;
    gap: 0;
    margin-left: -12px;
  }

  .helix-header__actions {
    justify-content: flex-end;
    gap: 0;
  }

  .helix-header__brand {
    position: relative;
    z-index: 2;
    display: inline-flex;
    width: var(--helix-logo-width);
    min-width: var(--helix-logo-width);
    height: auto;
    align-items: center;
    justify-content: center;
    justify-self: center;
    line-height: 1;
  }

  .helix-header__desktop-inner > .helix-header__brand {
    height: 19px;
  }

  .helix-header__brand--mobile {
    width: var(--helix-mobile-logo-width);
    min-width: var(--helix-mobile-logo-width);
  }

  .helix-header__logo,
  .helix-header__logo-text {
    display: block;
    width: 100%;
    line-height: 1;
  }

  .helix-header__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .helix-header__logo--overlay,
  .helix-header__logo-text--overlay {
    position: absolute;
    inset: 0;
    display: none;
  }

  .helix-header__logo-text {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -.03em;
    text-align: center;
    white-space: nowrap;
  }

  .helix-header__nav-trigger,
  .helix-header__currency-trigger,
  .helix-header__nav-link {
    position: relative;
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border: 0;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .02em;
    line-height: 22.4px;
    white-space: nowrap;
  }

  .helix-header__nav-trigger::after,
  .helix-header__nav-link::after,
  .helix-header__currency-trigger::after {
    position: absolute;
    right: 12px;
    bottom: 1px;
    left: 12px;
    height: 1px;
    background: currentColor;
    content: '';
    opacity: .85;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform .2s cubic-bezier(.6, 0, .4, 1);
  }

  .helix-header__nav-trigger:hover::after,
  .helix-header__nav-trigger:focus-visible::after,
  .helix-header__nav-link:hover::after,
  .helix-header__nav-link:focus-visible::after,
  .helix-header__dropdown[open] > .helix-header__nav-trigger::after,
  .helix-header__currency-trigger:hover::after,
  .helix-header__currency-trigger:focus-visible::after,
  .helix-header__dropdown[open] > .helix-header__currency-trigger::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .helix-header__chevron {
    display: inline-flex;
    width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    transition: transform .3s cubic-bezier(.6, .14, 0, 1);
  }

  .helix-header__chevron svg {
    width: 20px;
    height: 20px;
  }

  .helix-header__desktop-nav .helix-header__chevron,
  .helix-header__desktop-nav .helix-header__chevron svg {
    width: 16px;
    height: 16px;
  }

  .helix-header__dropdown[open] > summary .helix-header__chevron {
    transform: rotate(180deg);
  }

  .helix-header__dropdown > summary::-webkit-details-marker {
    display: none;
  }

  .helix-header__dropdown > summary {
    list-style: none;
  }

  .helix-header__dropdown {
    position: static;
  }

  .helix-header__dropdown--pages,
  .helix-header__dropdown--currency {
    position: relative;
  }

  .helix-header__currency-trigger {
    display: flex;
    min-height: 16px;
    height: 16px;
    gap: 8px;
    padding: 0;
    font-weight: 400;
    line-height: 14px;
    letter-spacing: normal;
  }

  .helix-header__currency-trigger .helix-header__chevron,
  .helix-header__currency-trigger .helix-header__chevron svg {
    width: 16px;
    height: 16px;
  }

  .helix-header__country-flag {
    display: inline-block;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    background: var(--helix-country-flag) center / contain no-repeat;
  }

  .helix-header__actions-divider {
    width: 1px;
    height: 16px;
    flex: 0 0 1px;
    margin-right: 20px;
    border-right: 1px solid #e5e5e5;
  }

  .helix-header__dropdown--currency {
    margin-right: 20px;
  }

  .helix-header__icon-button {
    display: inline-flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    transition: transform .25s ease, opacity .25s ease;
  }

  .helix-header__icon-button:hover,
  .helix-header__icon-button:focus-visible {
    opacity: .62;
    transform: translateY(-1px);
  }

  .helix-header__icon-button + .helix-header__icon-button {
    margin-left: 20px;
  }

  .helix-header__icon-button svg {
    width: 24px;
    height: 24px;
  }

  .helix-header__cart-icon {
    position: relative;
    display: inline-flex;
  }

  .helix-header__cart-count {
    position: absolute;
    top: -7px;
    right: -8px;
    display: grid;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    place-items: center;
    border-radius: 50%;
    background: currentColor;
    color: var(--helix-announcement-bg);
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
  }

  .helix-header__mega-panel {
    position: absolute;
    z-index: 8;
    top: 100%;
    right: -50px;
    left: -50px;
    height: var(--helix-mega-height, 0px);
    max-height: min(540px, calc(100vh - 80px));
    overflow: hidden;
    background: #fff;
    color: #1a1312;
    opacity: 0;
    pointer-events: none;
    transform: none;
    transition: height .3s cubic-bezier(.6, .14, 0, 1), opacity .2s cubic-bezier(.6, .14, 0, 1), visibility 0s linear .3s;
    visibility: hidden;
  }

  .helix-header__mega-panel::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  .helix-header__mega-panel::-webkit-scrollbar-thumb {
    border-radius: 99px;
    background: rgba(26, 19, 18, .2);
  }

  .helix-header__mega-panel::-webkit-scrollbar-track {
    background: transparent;
  }

  .helix-header__dropdown[open] > .helix-header__mega-panel {
    height: var(--helix-mega-height, min(540px, calc(100vh - 80px)));
    opacity: 1;
    overflow: auto;
    pointer-events: auto;
    transition-delay: 0s;
    visibility: visible;
  }

  .helix-header__mega-inner {
    width: 100%;
    margin-inline: auto;
    padding: 40px 0;
  }

  .helix-header__mega-columns {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    padding-inline: clamp(30px, 3.94vw, 50px);
  }

  .helix-header__mega-links-grid {
    display: grid;
    width: 600px;
    max-width: 600px;
    flex: 1 1 0%;
    grid-template-columns: repeat(3, 200px);
    margin: -15px;
  }

  .helix-header__mega-banners {
    display: grid;
    min-width: 0;
    flex: 0 1 907px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .helix-header__mega-products {
    min-width: 0;
    flex: 0 1 50%;
    display: flex;
    flex-direction: column;
  }

  .helix-header__mega-products-head {
    display: flex;
    min-height: 25.2px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 0 0 24px;
    opacity: 0;
    transform: translate3d(0, 15px, 0);
  }

  .helix-header__dropdown[open] .helix-header__mega-products-head {
    animation: helix-menu-reveal .4s ease .35s forwards;
  }

  .helix-header__mega-products-head .helix-header__mega-title {
    margin: 0;
    font-family: 'Archivo', var(--helix-font, sans-serif);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: .36px;
    line-height: 25.2px;
  }

  .helix-header__mega-products-controls {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
  }

  .helix-header__mega-products-button {
    display: grid;
    width: 24px;
    height: 24px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: currentColor;
    cursor: pointer;
    transition: opacity .2s ease, transform .2s ease;
  }

  .helix-header__mega-products-button:hover:not(:disabled),
  .helix-header__mega-products-button:focus-visible:not(:disabled) {
    opacity: .55;
    transform: translateY(-1px);
  }

  .helix-header__mega-products-button:disabled {
    cursor: not-allowed;
    opacity: .5;
  }

  .helix-header__mega-products-button svg {
    width: 18px;
    height: 18px;
  }

  .helix-header__mega-products-button--prev svg {
    transform: rotate(90deg);
  }

  .helix-header__mega-products-button--next svg {
    transform: rotate(-90deg);
  }

  .helix-header__mega-products-viewport {
    overflow: hidden;
    margin: 0 -10px;
    padding: 0 10px;
  }

  .helix-header__mega-products-track {
    display: flex;
    gap: 12px;
    transform: translate3d(0, 0, 0);
    transition: transform .35s cubic-bezier(.6, .14, 0, 1);
    will-change: transform;
  }

  .helix-header__mega-product {
    width: calc((100% - 24px) / 3);
    min-width: calc((100% - 24px) / 3);
    flex: 0 0 calc((100% - 24px) / 3);
    opacity: 0;
    transform: translate3d(0, 15px, 0);
  }

  .helix-header__dropdown[open] .helix-header__mega-product {
    animation: helix-menu-reveal .4s ease forwards;
  }

  .helix-header__dropdown[open] .helix-header__mega-product:nth-child(1) { animation-delay: .4s; }
  .helix-header__dropdown[open] .helix-header__mega-product:nth-child(2) { animation-delay: .45s; }
  .helix-header__dropdown[open] .helix-header__mega-product:nth-child(3) { animation-delay: .5s; }
  .helix-header__dropdown[open] .helix-header__mega-product:nth-child(4) { animation-delay: .55s; }
  .helix-header__dropdown[open] .helix-header__mega-product:nth-child(5) { animation-delay: .6s; }

  .helix-header__mega-product-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 16px;
    background: transparent;
  }

  .helix-header__mega-product-media > a:not(.helix-header__mega-product-quick-view):not(.helix-header__mega-product-quick-add) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .helix-header__mega-product-image {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity .45s cubic-bezier(.6, .14, 0, 1);
  }

  .helix-header__mega-product-image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .helix-header__mega-product-media:hover .helix-header__mega-product-image--secondary,
  .helix-header__mega-product-media:focus-within .helix-header__mega-product-image--secondary {
    opacity: 1;
  }

  .helix-header__mega-product-badge {
    position: absolute;
    z-index: 2;
    top: 12px;
    left: 12px;
    display: inline-flex;
    min-height: 20px;
    align-items: center;
    padding: 3px 8.5px;
    border-radius: 9990px;
    background: #e80303;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .06em;
    line-height: normal;
  }

  .helix-header__mega-product-quick-view {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    display: grid;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff;
    color: #1a1312;
    opacity: 0;
    transform: translateX(10px);
    transition: opacity .3s cubic-bezier(.4, 0, .2, 1), transform .3s cubic-bezier(.4, 0, .2, 1);
  }

  .helix-header__mega-product-quick-view svg {
    width: 20px;
    height: 20px;
  }

  .helix-header__mega-product-media:hover .helix-header__mega-product-quick-view,
  .helix-header__mega-product-media:focus-within .helix-header__mega-product-quick-view {
    opacity: 1;
    transform: translateX(0);
  }

  .helix-header__mega-product-quick-add {
    position: absolute;
    z-index: 2;
    right: 12px;
    bottom: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
