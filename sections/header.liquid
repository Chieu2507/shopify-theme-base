{% comment %}Source-inspired header presentation adapted to Spinel's merchant-managed data model.{% endcomment %}
{% render 'section-stylesheet', asset: 'section-header-source.css' %}

{% liquid
  assign header_id = 'Header-' | append: section.id
  assign navigation_menu = section.settings.menu
  assign menu_links = navigation_menu.links
  assign logo_image = settings.logo | default: settings.logo_mobile
  assign mobile_logo_image = settings.logo_mobile | default: logo_image
  assign logo_width_desktop = 170
  assign logo_width_mobile = 120
  assign country_form_id = 'HeaderCountryForm-' | append: section.id
  assign mobile_country_form_id = 'HeaderMobileCountryForm-' | append: section.id
  assign mobile_language_form_id = 'HeaderMobileLanguageForm-' | append: section.id
  assign header_color_scheme = section.settings.color_scheme
  assign transparent_header_enabled = false
  assign floating_header_enabled = false
  assign account_action = section.settings.account_action | default: 'panel'
  assign account_href = routes.account_url
  assign account_open_new_tab = false
  assign has_menu = false

  if template.name == 'index'
    if section.settings.header_style == 'transparent'
      assign transparent_header_enabled = true
      assign header_color_scheme = section.settings.transparent_color_scheme
    elsif section.settings.header_style == 'floating'
      assign floating_header_enabled = true
    endif
  endif

  if account_action == 'custom_url' and section.settings.account_custom_url != blank
    assign account_href = section.settings.account_custom_url
  endif

  if account_action == 'new_tab'
    assign account_open_new_tab = true
  endif

  if menu_links == blank and navigation_menu != blank
    assign navigation_menu_handle = navigation_menu.handle | default: navigation_menu
    assign navigation_menu = linklists[navigation_menu_handle]
    assign menu_links = navigation_menu.links
  endif

  if menu_links != blank
    assign has_menu = true
  endif
%}

<header
  id="{{ header_id }}"
  class="header header--no-announcement header--logo-{{ section.settings.header_layout }} color-scheme color-{{ header_color_scheme.id }}{% if transparent_header_enabled %} header--overlay header--transparent{% endif %}{% if floating_header_enabled %} header--floating{% endif %}{% if section.settings.sticky_behavior != 'none' %} header--sticky{% endif %}{% if section.settings.underline_active_link %} header--underline-active{% endif %}"
  data-header-root
  data-dropdown-trigger="{{ section.settings.dropdown_trigger }}"
  data-default-color-class="color-{{ section.settings.color_scheme.id }}"
  data-transparent-color-class="color-{{ section.settings.transparent_color_scheme.id }}"
  data-deferred-module="{{ 'section-header-source.js' | asset_url }}"
  style="--header-height: {{ section.settings.height_desktop }}px; --header-height-mobile: {{ section.settings.height_mobile }}px; --header-logo-width: {{ logo_width_desktop }}px; --header-mobile-logo-width: {{ logo_width_mobile }}px; --header-font: var(--font-paragraph--family); --header-solid-text: var(--color-text); --header-overlay-text: var(--color-text); --header-announcement-bg: var(--color-background);"
>
  <div class="header__desktop-bar">
    <div class="header__menu-background" aria-hidden="true"></div>
    <div class="header__desktop-surface">
      <div class="header__desktop-inner">
        <nav class="header__desktop-nav" aria-label="{{ 'header.primary_navigation' | t | escape }}">
          {% for link in menu_links %}
            {% liquid
              assign badge_block = nil
              assign mega_menu_block = nil

              for block in section.blocks
                if block.type == 'menu_badge' and block.settings.menu_item != blank and block.settings.menu_item == link.title
                  assign badge_block = block
                endif

                if block.type == 'mega_menu' and block.settings.menu_item != blank
                  assign mega_menu_items = block.settings.menu_item | split: ';'
                  for mega_menu_item in mega_menu_items
                    assign mega_menu_item_name = mega_menu_item | strip
                    if mega_menu_item_name == link.title
                      assign mega_menu_block = block
                      break
                    endif
                  endfor
                endif
              endfor

              assign has_dropdown = false
              if link.links != blank or mega_menu_block != nil
                assign has_dropdown = true
              endif
            %}

            {% if has_dropdown %}
              <details class="header__dropdown{% if mega_menu_block != nil %} header__dropdown--mega{% else %} header__dropdown--pages{% endif %}" data-header-dropdown>
                <summary class="header__nav-trigger{% if link.current or link.child_active %} is-active{% endif %}" aria-label="{{ 'header.open_submenu' | t: item: link.title | escape }}">
                  <span>{{ link.title | escape }}</span>
                  {% if badge_block != nil %}<span class="header__menu-badge" {{ badge_block.shopify_attributes }}><span>{{ badge_block.settings.text | escape }}</span></span>{% endif %}
                  <span class="header__chevron" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
                </summary>

                {% if mega_menu_block != nil %}
                  {% liquid
                    assign mega_columns = mega_menu_block.settings.columns | default: '3' | plus: 0
                    assign links_per_column = link.links.size | plus: mega_columns | minus: 1 | divided_by: mega_columns
                    assign promotion_count = 0
                    assign has_promotion_1 = false
                    assign has_promotion_2 = false

                    if mega_menu_block.settings.promotion_1_image != blank or mega_menu_block.settings.promotion_1_heading != blank or mega_menu_block.settings.promotion_1_text != blank or mega_menu_block.settings.promotion_1_link_label != blank
                      assign has_promotion_1 = true
                      assign promotion_count = promotion_count | plus: 1
                    endif
                    if mega_menu_block.settings.promotion_2_image != blank or mega_menu_block.settings.promotion_2_heading != blank or mega_menu_block.settings.promotion_2_text != blank or mega_menu_block.settings.promotion_2_link_label != blank
                      assign has_promotion_2 = true
                      assign promotion_count = promotion_count | plus: 1
                    endif
                  %}
                  <div class="header__mega-panel" data-header-mega-panel {{ mega_menu_block.shopify_attributes }}>
                    <div class="header__mega-inner">
                      <div class="header__mega-columns{% if promotion_count == 0 %} header__mega-columns--links-only{% endif %}">
                        <div class="header__mega-links-grid" style="--header-mega-columns: {{ mega_columns }};">
                          {% for column in (1..mega_columns) %}
                            {% liquid
                              assign column_index = column | minus: 1
                              assign column_offset = column_index | times: links_per_column
                              assign column_links = link.links | slice: column_offset, links_per_column
                            %}
                            {% if column_links.size > 0 or forloop.first %}
                              <div class="header__mega-column">
                                {% if forloop.first and mega_menu_block.settings.column_heading != blank %}
                                  <p class="header__mega-title">{{ mega_menu_block.settings.column_heading | escape }}</p>
                                {% endif %}
                                <ul class="header__mega-links" role="list">
                                  {% if forloop.first and link.url != blank %}
                                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                                  {% endif %}
                                  {% for child_link in column_links %}
                                    <li>
                                      {% if child_link.links != blank %}
                                        <a class="header__mega-category-title" href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                                        <ul class="header__mega-nested" role="list">
                                          {% for grandchild_link in child_link.links %}
                                            <li><a href="{{ grandchild_link.url }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>{{ grandchild_link.title | escape }}</a></li>
                                          {% endfor %}
                                        </ul>
                                      {% else %}
                                        <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                                      {% endif %}
                                    </li>
                                  {% endfor %}
                                </ul>
                              </div>
                            {% endif %}
                          {% endfor %}
                        </div>

                        {% if promotion_count > 0 %}
                          <div class="header__mega-banners header__mega-banners--{{ promotion_count }}">
                            {% if has_promotion_1 %}
                              <article class="header__mega-promo">
                                {% if mega_menu_block.settings.promotion_1_image != blank %}
                                  {% assign promotion_1_alt = mega_menu_block.settings.promotion_1_image.alt | default: mega_menu_block.settings.promotion_1_heading %}
                                  {% render 'responsive-image', image: mega_menu_block.settings.promotion_1_image, max_width: 900, widths: '360, 540, 720, 900', sizes: '(min-width: 991px) 24vw, 70vw', loading: 'lazy', alt: promotion_1_alt %}
                                {% endif %}
                                <div class="header__mega-promo-content">
                                  {% if mega_menu_block.settings.promotion_1_heading != blank %}<{{ mega_menu_block.settings.promotion_1_heading_tag | default: 'h3' }} class="{% render 'typography-class', preset: mega_menu_block.settings.promotion_1_heading_size, fallback: 'medium' %}">{{ mega_menu_block.settings.promotion_1_heading | escape }}</{{ mega_menu_block.settings.promotion_1_heading_tag | default: 'h3' }}>{% endif %}
                                  {% if mega_menu_block.settings.promotion_1_text != blank %}<div class="rte spinel-text--{{ mega_menu_block.settings.promotion_1_text_size | default: 'medium' }} content-text content-text--{{ mega_menu_block.settings.promotion_1_text_alignment | default: 'left' }}">{{ mega_menu_block.settings.promotion_1_text }}</div>{% endif %}
                                  {% if mega_menu_block.settings.promotion_1_link_label != blank and mega_menu_block.settings.promotion_1_link != blank %}<a href="{{ mega_menu_block.settings.promotion_1_link }}">{{ mega_menu_block.settings.promotion_1_link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
                                </div>
                              </article>
                            {% endif %}
                            {% if has_promotion_2 %}
                              <article class="header__mega-promo">
                                {% if mega_menu_block.settings.promotion_2_image != blank %}
                                  {% assign promotion_2_alt = mega_menu_block.settings.promotion_2_image.alt | default: mega_menu_block.settings.promotion_2_heading %}
                                  {% render 'responsive-image', image: mega_menu_block.settings.promotion_2_image, max_width: 900, widths: '360, 540, 720, 900', sizes: '(min-width: 991px) 24vw, 70vw', loading: 'lazy', alt: promotion_2_alt %}
                                {% endif %}
                                <div class="header__mega-promo-content">
                                  {% if mega_menu_block.settings.promotion_2_heading != blank %}<{{ mega_menu_block.settings.promotion_2_heading_tag | default: 'h3' }} class="{% render 'typography-class', preset: mega_menu_block.settings.promotion_2_heading_size, fallback: 'medium' %}">{{ mega_menu_block.settings.promotion_2_heading | escape }}</{{ mega_menu_block.settings.promotion_2_heading_tag | default: 'h3' }}>{% endif %}
                                  {% if mega_menu_block.settings.promotion_2_text != blank %}<div class="rte spinel-text--{{ mega_menu_block.settings.promotion_2_text_size | default: 'medium' }} content-text content-text--{{ mega_menu_block.settings.promotion_2_text_alignment | default: 'left' }}">{{ mega_menu_block.settings.promotion_2_text }}</div>{% endif %}
                                  {% if mega_menu_block.settings.promotion_2_link_label != blank and mega_menu_block.settings.promotion_2_link != blank %}<a href="{{ mega_menu_block.settings.promotion_2_link }}">{{ mega_menu_block.settings.promotion_2_link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
                                </div>
                              </article>
                            {% endif %}
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% else %}
                  <div class="header__pages-panel">
                    {% if link.url != blank %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}
                    {% for child_link in link.links %}
                      {% if child_link.links != blank %}
                        <div class="header__pages-panel-group">
                          <strong>{{ child_link.title | escape }}</strong>
                          {% if child_link.url != blank %}<a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>{% endif %}
                          {% for grandchild_link in child_link.links %}<a href="{{ grandchild_link.url }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>{{ grandchild_link.title | escape }}</a>{% endfor %}
                        </div>
                      {% else %}
                        <a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              </details>
            {% else %}
              <a class="header__nav-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                <span>{{ link.title | escape }}</span>
                {% if badge_block != nil %}<span class="header__menu-badge" {{ badge_block.shopify_attributes }}><span>{{ badge_block.settings.text | escape }}</span></span>{% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </nav>

        <a class="header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if logo_image != blank %}
            <span class="header__logo header__logo--normal">{{ logo_image | image_url: width: 480 | image_tag: loading: 'eager', widths: '170, 240, 340, 480', sizes: '170px', alt: shop.name }}</span>
            <span class="header__logo header__logo--overlay" aria-hidden="true">{{ logo_image | image_url: width: 480 | image_tag: loading: 'eager', widths: '170, 240, 340, 480', sizes: '170px', alt: '' }}</span>
          {% else %}
            <span class="header__logo-text header__logo-text--normal">{{ shop.name | escape }}</span>
            <span class="header__logo-text header__logo-text--overlay" aria-hidden="true">{{ shop.name | escape }}</span>
          {% endif %}
        </a>

        <div class="header__actions">
          {% if section.settings.show_localization and localization.available_countries.size > 1 %}
            <details class="header__dropdown header__dropdown--currency" data-header-dropdown>
              <summary class="header__currency-trigger">
                {% if section.settings.show_country_flag %}<span class="header__country-flag" aria-hidden="true" style="--header-country-flag: url(https://cdn.shopify.com/static/images/flags/{{ localization.country.iso_code | downcase }}.svg?width=32);"></span>{% endif %}
                <span>{{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}</span>
                <span class="header__chevron" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
              </summary>
              <div class="header__currency-panel">
                <p class="header__panel-label">{{ 'header.country_region' | t }}</p>
                <div data-header-country-form>
                  {% form 'localization', id: country_form_id %}
                    <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" data-header-country-value>
                    <div class="header__country-list">
                      {% for country in localization.available_countries %}
                        <button type="button" value="{{ country.iso_code }}" data-header-country-option{% if country.iso_code == localization.country.iso_code %} aria-current="true"{% endif %}>
                          <span>{{ country.name }}</span><span>{{ country.currency.iso_code }} {{ country.currency.symbol }}</span>
                        </button>
                      {% endfor %}
                    </div>
                  {% endform %}
                </div>
              </div>
            </details>
            <span class="header__actions-divider" aria-hidden="true"></span>
          {% endif %}

          {% if section.settings.show_search %}
            <a class="header__icon-button" href="{{ routes.search_url }}" data-header-search-open aria-controls="{{ header_id }}-search" aria-label="{{ 'header.search' | t | escape }}">{% render 'icon', name: 'search' %}</a>
          {% endif %}

          {% if section.settings.show_account and shop.customer_accounts_enabled %}
            {% if account_action == 'panel' %}
              <shopify-account class="header__icon-button header__account-component" menu="{{ section.settings.customer_account_menu }}">
                <span slot="signed-out-avatar" aria-hidden="true">{% render 'icon', name: 'account' %}</span>
              </shopify-account>
            {% else %}
              <a class="header__icon-button" href="{{ account_href }}"{% if account_open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ 'header.account' | t | escape }}">{% render 'icon', name: 'account' %}</a>
            {% endif %}
          {% endif %}

          {% if section.settings.show_cart %}
            <a class="header__icon-button header__cart-link" href="{{ routes.cart_url }}" data-cart-drawer-open aria-label="{{ 'header.cart_count' | t: count: cart.item_count | escape }}">
              <span class="header__cart-icon">{% render 'icon', name: 'bag' %}{% if cart.item_count > 0 %}<span class="header__cart-count">{{ cart.item_count }}</span>{% endif %}</span>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="header__mobile-bar">
    <div class="header__mobile-inner">
      <div class="header__mobile-side header__mobile-side--left">
        {% if has_menu %}<button class="header__mobile-icon" type="button" data-header-mobile-open aria-expanded="false" aria-controls="{{ header_id }}-mobile-menu" aria-label="{{ 'header.open_menu' | t | escape }}">{% render 'icon', name: 'menu' %}</button>{% endif %}
      </div>

      <a class="header__brand header__brand--mobile" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {% if mobile_logo_image != blank %}
          <span class="header__logo header__logo--normal">{{ mobile_logo_image | image_url: width: 360 | image_tag: loading: 'eager', widths: '120, 180, 240, 360', sizes: '120px', alt: shop.name }}</span>
          <span class="header__logo header__logo--overlay" aria-hidden="true">{{ mobile_logo_image | image_url: width: 360 | image_tag: loading: 'eager', widths: '120, 180, 240, 360', sizes: '120px', alt: '' }}</span>
        {% else %}
          <span class="header__logo-text header__logo-text--normal">{{ shop.name | escape }}</span>
          <span class="header__logo-text header__logo-text--overlay" aria-hidden="true">{{ shop.name | escape }}</span>
        {% endif %}
      </a>

      <div class="header__mobile-side header__mobile-side--right">
        {% if section.settings.show_search %}<a class="header__mobile-icon" href="{{ routes.search_url }}" data-header-search-open aria-controls="{{ header_id }}-search" aria-label="{{ 'header.search' | t | escape }}">{% render 'icon', name: 'search' %}</a>{% endif %}
        {% if section.settings.show_cart %}<a class="header__mobile-icon header__cart-link" href="{{ routes.cart_url }}" data-cart-drawer-open aria-label="{{ 'header.cart_count' | t: count: cart.item_count | escape }}"><span class="header__cart-icon">{% render 'icon', name: 'bag' %}{% if cart.item_count > 0 %}<span class="header__cart-count">{{ cart.item_count }}</span>{% endif %}</span></a>{% endif %}
      </div>
    </div>
  </div>

  <button class="header__scrim" type="button" data-header-close-layer aria-label="{{ 'header.close_menu' | t | escape }}"></button>

  {% if has_menu %}
    <div class="header__mobile-menu" id="{{ header_id }}-mobile-menu" data-header-mobile-menu aria-hidden="true">
      <div class="header__mobile-menu-panel" role="dialog" aria-modal="true" aria-label="{{ 'header.primary_navigation' | t | escape }}" tabindex="-1">
        <div class="header__mobile-menu-top">
          <a class="header__mobile-menu-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            {% if mobile_logo_image != blank %}<span class="header__logo">{{ mobile_logo_image | image_url: width: 360 | image_tag: loading: 'eager', widths: '120, 180, 240, 360', sizes: '120px', alt: shop.name }}</span>{% else %}<span class="header__logo-text">{{ shop.name | escape }}</span>{% endif %}
          </a>
          <button class="header__close-button" type="button" data-header-close-mobile aria-label="{{ 'header.close_menu' | t | escape }}">{% render 'icon', name: 'close' %}</button>
        </div>

        <nav class="header__mobile-nav" aria-label="{{ 'header.primary_navigation' | t | escape }}">
          {% for link in menu_links %}
            {% liquid
              assign mobile_badge_block = nil
              assign mobile_mega_block = nil
              for block in section.blocks
                if block.type == 'menu_badge' and block.settings.menu_item == link.title
                  assign mobile_badge_block = block
                endif
                if block.type == 'mega_menu' and block.settings.menu_item != blank
                  assign mobile_mega_items = block.settings.menu_item | split: ';'
                  for mobile_mega_item in mobile_mega_items
                    assign mobile_mega_item_name = mobile_mega_item | strip
                    if mobile_mega_item_name == link.title
                      assign mobile_mega_block = block
                      break
                    endif
                  endfor
                endif
              endfor
              assign mobile_has_submenu = false
              if link.links != blank or mobile_mega_block != nil
                assign mobile_has_submenu = true
              endif
            %}

            {% if mobile_has_submenu %}
              <details data-header-mobile-section>
                <summary><span>{{ link.title | escape }}{% if mobile_badge_block != nil %}<span class="header__mobile-menu-badge">{{ mobile_badge_block.settings.text | escape }}</span>{% endif %}</span><span aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span></summary>
                <div class="header__mobile-submenu">
                  <div class="header__mobile-submenu-header">
                    <button class="header__mobile-back" type="button" data-header-mobile-back aria-label="{{ 'header.back_to' | t: item: link.title | escape }}"><span aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span><span>{{ link.title | escape }}</span></button>
                    <button class="header__close-button" type="button" data-header-close-mobile aria-label="{{ 'header.close_menu' | t | escape }}">{% render 'icon', name: 'close' %}</button>
                  </div>
                  <div class="header__mobile-submenu-inner">
                    <div class="header__mobile-submenu-group header__mobile-submenu-group--featured">
                      {% if link.url != blank %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}
                      {% for child_link in link.links %}
                        {% if child_link.links == blank %}<a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>{% endif %}
                      {% endfor %}
                    </div>

                    {% for child_link in link.links %}
                      {% if child_link.links != blank %}
                        <details class="header__mobile-submenu-details">
                          <summary><span>{{ child_link.title | escape }}</span><span aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span></summary>
                          <div class="header__mobile-submenu header__mobile-submenu--child">
                            <div class="header__mobile-submenu-header">
                              <button class="header__mobile-back" type="button" data-header-mobile-back aria-label="{{ 'header.back_to' | t: item: child_link.title | escape }}"><span aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span><span>{{ child_link.title | escape }}</span></button>
                            </div>
                            <div class="header__mobile-submenu-inner">
                              <div class="header__mobile-submenu-group">
                                {% if child_link.url != blank %}<a href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>{% endif %}
                                {% for grandchild_link in child_link.links %}<a href="{{ grandchild_link.url }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>{{ grandchild_link.title | escape }}</a>{% endfor %}
                              </div>
                            </div>
                          </div>
                        </details>
                      {% endif %}
                    {% endfor %}

                    {% if mobile_mega_block != nil %}
                      {% liquid
                        assign mobile_has_promotion_1 = false
                        assign mobile_has_promotion_2 = false
                        if mobile_mega_block.settings.promotion_1_image != blank or mobile_mega_block.settings.promotion_1_heading != blank or mobile_mega_block.settings.promotion_1_link_label != blank
                          assign mobile_has_promotion_1 = true
                        endif
                        if mobile_mega_block.settings.promotion_2_image != blank or mobile_mega_block.settings.promotion_2_heading != blank or mobile_mega_block.settings.promotion_2_link_label != blank
                          assign mobile_has_promotion_2 = true
                        endif
                      %}
                      {% if mobile_has_promotion_1 or mobile_has_promotion_2 %}
                        <div class="header__mobile-promos">
                          {% if mobile_has_promotion_1 %}
                            <article class="header__mobile-promo">
                              {% if mobile_mega_block.settings.promotion_1_image != blank %}<span class="header__mobile-promo-media">{% render 'responsive-image', image: mobile_mega_block.settings.promotion_1_image, max_width: 600, widths: '240, 360, 480, 600', sizes: '70vw', loading: 'lazy', alt: mobile_mega_block.settings.promotion_1_heading %}</span>{% endif %}
                              {% if mobile_mega_block.settings.promotion_1_heading != blank %}<strong>{{ mobile_mega_block.settings.promotion_1_heading | escape }}</strong>{% endif %}
                              {% if mobile_mega_block.settings.promotion_1_link_label != blank and mobile_mega_block.settings.promotion_1_link != blank %}<a href="{{ mobile_mega_block.settings.promotion_1_link }}">{{ mobile_mega_block.settings.promotion_1_link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
                            </article>
                          {% endif %}
                          {% if mobile_has_promotion_2 %}
                            <article class="header__mobile-promo">
                              {% if mobile_mega_block.settings.promotion_2_image != blank %}<span class="header__mobile-promo-media">{% render 'responsive-image', image: mobile_mega_block.settings.promotion_2_image, max_width: 600, widths: '240, 360, 480, 600', sizes: '70vw', loading: 'lazy', alt: mobile_mega_block.settings.promotion_2_heading %}</span>{% endif %}
                              {% if mobile_mega_block.settings.promotion_2_heading != blank %}<strong>{{ mobile_mega_block.settings.promotion_2_heading | escape }}</strong>{% endif %}
                              {% if mobile_mega_block.settings.promotion_2_link_label != blank and mobile_mega_block.settings.promotion_2_link != blank %}<a href="{{ mobile_mega_block.settings.promotion_2_link }}">{{ mobile_mega_block.settings.promotion_2_link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
                            </article>
                          {% endif %}
                        </div>
                      {% endif %}
                    {% endif %}
                  </div>
                </div>
              </details>
            {% else %}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span>{{ link.title | escape }}{% if mobile_badge_block != nil %}<span class="header__mobile-menu-badge">{{ mobile_badge_block.settings.text | escape }}</span>{% endif %}</span></a>
            {% endif %}
          {% endfor %}
        </nav>

        <div class="header__mobile-menu-footer">
          {% if section.settings.show_account and shop.customer_accounts_enabled %}
            {% if account_action == 'panel' %}
              <shopify-account class="header__mobile-login" menu="{{ section.settings.customer_account_menu }}"><span slot="signed-out-avatar">{{ 'header.login' | t }}</span></shopify-account>
            {% else %}
              <a class="header__mobile-login" href="{{ account_href }}"{% if account_open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ 'header.login' | t }}</a>
            {% endif %}
          {% endif %}

          {% if section.settings.show_localization %}
            {% if localization.available_countries.size > 1 %}
              <details class="header__mobile-localization">
                <summary>{% if section.settings.show_country_flag %}<span class="header__country-flag" aria-hidden="true" style="--header-country-flag: url(https://cdn.shopify.com/static/images/flags/{{ localization.country.iso_code | downcase }}.svg?width=32);"></span>{% endif %}<span>{{ localization.country.name }} · {{ localization.country.currency.iso_code }}</span><span aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span></summary>
                <div class="header__mobile-localization-panel">
                  <div data-header-country-form>
                    {% form 'localization', id: mobile_country_form_id %}
                      <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" data-header-country-value>
                      {% for country in localization.available_countries %}<button type="button" value="{{ country.iso_code }}" data-header-country-option><span>{{ country.name }}</span><span>{{ country.currency.iso_code }}</span></button>{% endfor %}
                    {% endform %}
                  </div>
                </div>
              </details>
            {% endif %}
            {% if localization.available_languages.size > 1 %}
              <details class="header__mobile-localization">
                <summary><span>{{ 'header.language' | t }} · {{ localization.language.endonym_name }}</span><span aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span></summary>
                <div class="header__mobile-localization-panel">
                  <div data-header-language-form>
                    {% form 'localization', id: mobile_language_form_id %}
                      <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" data-header-language-value>
                      {% for language in localization.available_languages %}<button type="button" value="{{ language.iso_code }}" data-header-language-option><span>{{ language.endonym_name }}</span><span>{{ language.iso_code | upcase }}</span></button>{% endfor %}
                    {% endform %}
                  </div>
                </div>
              </details>
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_search %}
    <div class="header__drawer header__drawer--search" id="{{ header_id }}-search" data-header-search-drawer aria-hidden="true">
      <div class="header__drawer-panel" role="dialog" aria-modal="true" aria-label="{{ 'header.search' | t | escape }}" tabindex="-1">
        <div class="header__drawer-top"><strong>{{ 'header.search' | t }}</strong><button class="header__close-button" type="button" data-header-close-layer aria-label="{{ 'header.close_search' | t | escape }}">{% render 'icon', name: 'close' %}</button></div>
        <form action="{{ routes.search_url }}" method="get" class="header__search-form" role="search">
          <label class="visually-hidden" for="{{ header_id }}-search-input">{{ 'header.search' | t }}</label>
          <input id="{{ header_id }}-search-input" type="search" name="q" placeholder="{{ 'search.placeholder' | t | escape }}" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" aria-label="{{ 'header.search' | t | escape }}">{% render 'icon', name: 'search' %}</button>
        </form>
      </div>
    </div>
  {% endif %}
</header>

