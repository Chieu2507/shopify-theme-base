{% endstylesheet %}

{% javascript %}
  (() => {
    const initHelixHeader = (root) => {
      if (!root || root.dataset.helixReady === 'true') return;
      root.dataset.helixReady = 'true';

    const select = (selector, scope = root) => scope.querySelector(selector);
    const selectAll = (selector, scope = root) => Array.from(scope.querySelectorAll(selector));
    const desktopQuery = window.matchMedia('(min-width: 991px)');
    const dropdowns = selectAll('[data-helix-dropdown]');
    const mobileMenu = select('[data-helix-mobile-menu]');
    const searchDrawer = select('[data-helix-search-drawer]');
    const cartDrawer = select('[data-helix-cart-drawer]');
    const mobileMenuPanel = select('.helix-header__mobile-menu-panel');
    const mobileSections = selectAll('[data-helix-mobile-section]');
    const mobileDetails = selectAll('.helix-header__mobile-nav details');
    const mobileSubmenuSections = selectAll('.helix-header__mobile-submenu-details');
    const searchPanel = select('.helix-header__drawer--search .helix-header__drawer-panel');
    const cartPanel = select('.helix-header__drawer--cart .helix-header__drawer-panel');
    let announcementIndex = 0;
    let announcementTimer;
    let closeDropdownTimer;
    let lastScrollY = window.scrollY;
    const menProducts = select('[data-helix-men-products]');
    const menProductsViewport = select('[data-helix-men-products-viewport]', menProducts);
    const menProductsTrack = select('[data-helix-men-products-track]', menProducts);
    const menProductsPrev = select('[data-helix-men-products-prev]', menProducts);
    const menProductsNext = select('[data-helix-men-products-next]', menProducts);
    let menProductsOffset = 0;

    const syncMobileSubmenuState = () => {
      mobileMenuPanel?.classList.toggle('is-mobile-submenu-open', mobileSections.some((section) => section.open));
    };

    const getMobileSubmenuPanel = (section) => section?.querySelector(':scope > .helix-header__mobile-submenu');

    const resetMobileSubmenuTransition = (section) => {
      getMobileSubmenuPanel(section)?.classList.remove('is-mobile-submenu-closing');
      section?.removeAttribute('data-helix-mobile-closing');
    };

    const closeMobileSubmenu = (section) => {
      if (!section?.open) return;

      const panel = getMobileSubmenuPanel(section);
      if (!panel) {
        section.removeAttribute('open');
        syncMobileSubmenuState();
        return;
      }

      if (section.dataset.helixMobileClosing === 'true') return;

      section.dataset.helixMobileClosing = 'true';
      panel.classList.add('is-mobile-submenu-closing');

      let fallbackTimer;
      let finished = false;
      const finish = () => {
        if (finished) return;
        finished = true;
        panel.removeEventListener('animationend', handleAnimationEnd);
        window.clearTimeout(fallbackTimer);
        panel.classList.remove('is-mobile-submenu-closing');
        section.removeAttribute('data-helix-mobile-closing');
        section.removeAttribute('open');
        syncMobileSubmenuState();
      };
      const handleAnimationEnd = (event) => {
        if (event.animationName === 'helix-mobile-slide-out') finish();
      };

      panel.addEventListener('animationend', handleAnimationEnd);
      fallbackTimer = window.setTimeout(finish, 360);
    };

    const normalizeAnnouncementMessage = () => {
      const firstMessage = select('[data-helix-announcement-message]');
      if (!firstMessage) return;
      const messageText = firstMessage.textContent.replace(/\\s+/g, ' ').trim();
      if (!messageText.includes('Free shipping for all orders over') || !messageText.includes('5.000.000₫Free shipping for all orders over')) return;
      firstMessage.innerHTML = 'Free shipping for all orders over <strong>5.000.000₫</strong>';
    };

    normalizeAnnouncementMessage();

    const syncMenProducts = () => {
      if (!menProductsViewport || !menProductsTrack) return;
      const maxOffset = Math.max(0, menProductsTrack.scrollWidth - menProductsViewport.clientWidth);
      menProductsOffset = Math.max(0, Math.min(menProductsOffset, maxOffset));
      menProductsTrack.style.transform = `translate3d(-${menProductsOffset}px, 0, 0)`;
      if (menProductsPrev) menProductsPrev.disabled = menProductsOffset <= 0;
      if (menProductsNext) menProductsNext.disabled = menProductsOffset >= maxOffset - 1;
    };

    const stepMenProducts = (direction) => {
      if (!menProductsViewport || !menProductsTrack) return;
      const maxOffset = Math.max(0, menProductsTrack.scrollWidth - menProductsViewport.clientWidth);
      menProductsOffset = Math.max(0, Math.min(maxOffset, menProductsOffset + direction * 304));
      syncMenProducts();
    };

    menProductsPrev?.addEventListener('click', () => stepMenProducts(-1));
    menProductsNext?.addEventListener('click', () => stepMenProducts(1));

    const setBodyLock = () => {
      const locked = dropdowns.some((dropdown) => dropdown.open) || root.classList.contains('is-mobile-menu-open') || root.classList.contains('is-search-open') || root.classList.contains('is-cart-open');
      document.documentElement.classList.toggle('helix-header-lock', locked);
    };

    const closeDropdowns = () => {
      dropdowns.forEach((dropdown) => {
        dropdown.open = false;
      });
      root.classList.remove('is-menu-open');
      window.setTimeout(syncDropdownState, 0);
    };

    const openLayer = (name) => {
      closeDropdowns();
      closeLayers();
      const target = name === 'mobile' ? mobileMenu : name === 'search' ? searchDrawer : cartDrawer;
      const panel = name === 'mobile' ? mobileMenuPanel : name === 'search' ? searchPanel : cartPanel;
      if (!target) return;
      const stateName = name === 'mobile' ? 'mobile-menu' : name;
      root.classList.add(`is-${stateName}-open`);
      target.setAttribute('aria-hidden', 'false');
      panel?.focus({ preventScroll: true });
      setBodyLock();
      if (name === 'search') select('input[type="search"]', searchDrawer)?.focus({ preventScroll: true });
    };

    const closeLayers = () => {
      root.classList.remove('is-mobile-menu-open', 'is-search-open', 'is-cart-open');
      [mobileMenu, searchDrawer, cartDrawer].forEach((layer) => layer?.setAttribute('aria-hidden', 'true'));
      mobileDetails.forEach((section) => {
        resetMobileSubmenuTransition(section);
        section.open = false;
      });
      syncMobileSubmenuState();
      select('[data-helix-mobile-open]')?.setAttribute('aria-expanded', 'false');
      setBodyLock();
    };

    const syncMegaPanelHeight = (dropdown) => {
      const panel = select('[data-helix-mega-panel]', dropdown);
      if (!panel) return 0;
      if (!dropdown.open) {
        panel.style.setProperty('--helix-mega-height', '0px');
        return 0;
      }
      const maxHeight = Math.min(540, Math.max(0, window.innerHeight - 80));
      const panelHeight = Math.min(Math.max(0, panel.scrollHeight - 2), maxHeight);
      panel.style.setProperty('--helix-mega-height', `${panelHeight}px`);
      return panelHeight;
    };

    const syncDropdownState = () => {
      const open = dropdowns.some((dropdown) => dropdown.open);
      root.classList.toggle('is-menu-open', open);
      let menuHeight = 0;
      dropdowns.forEach((dropdown) => {
        const panelHeight = syncMegaPanelHeight(dropdown);
        if (dropdown.open) menuHeight = panelHeight;
      });
      root.style.setProperty('--helix-menu-height', `${menuHeight}px`);
      setBodyLock();
      syncMenProducts();
    };

    const replayMegaPanelReveal = () => {
      if (!desktopQuery.matches || !root.classList.contains('is-menu-open')) return;
      root.classList.add('is-replaying-menu-reveal');
      void root.offsetWidth;
      root.classList.remove('is-replaying-menu-reveal');
    };

    dropdowns.forEach((dropdown) => {
      const summary = select('summary', dropdown);
      dropdown.addEventListener('toggle', syncDropdownState);

      summary?.addEventListener('click', () => {
        const url = summary.dataset.url;
        if (url && url !== '#') {
          window.location.href = url;
          return;
        }
        window.setTimeout(syncDropdownState, 0);
      });

      dropdown.addEventListener('pointerenter', () => {
        if (!desktopQuery.matches || !dropdown.hasAttribute('data-helix-hover-dropdown')) return;
        window.clearTimeout(closeDropdownTimer);
        const switchingDropdown = dropdowns.some((item) => item !== dropdown && item.open);
        dropdowns.forEach((item) => {
          if (item !== dropdown) item.open = false;
        });
        dropdown.open = true;
        syncDropdownState();
        if (switchingDropdown) replayMegaPanelReveal();
      });

      dropdown.addEventListener('pointerleave', () => {
        if (!desktopQuery.matches || !dropdown.hasAttribute('data-helix-hover-dropdown')) return;
        closeDropdownTimer = window.setTimeout(() => {
          if (!dropdown.matches(':hover')) {
            dropdown.open = false;
            syncDropdownState();
          }
        }, 120);
      });
    });

    mobileSections.forEach((section) => {
      section.addEventListener('toggle', () => {
        if (section.open) {
          mobileSections.forEach((otherSection) => {
            if (otherSection !== section) otherSection.open = false;
          });
        }
        window.setTimeout(syncMobileSubmenuState, 0);
      });
    });

    mobileSubmenuSections.forEach((section) => {
      section.addEventListener('toggle', () => {
        if (section.open) {
          resetMobileSubmenuTransition(section);
          mobileSubmenuSections.forEach((otherSection) => {
            if (otherSection !== section && otherSection.parentElement === section.parentElement) otherSection.open = false;
          });
        }
        window.setTimeout(syncMobileSubmenuState, 0);
      });
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) {
        closeDropdowns();
        closeLayers();
      }
    });

    root.addEventListener('click', (event) => {
      const searchTrigger = event.target.closest('[data-helix-open-search]');
      const cartTrigger = event.target.closest('[data-helix-open-cart]');
      const mobileTrigger = event.target.closest('[data-helix-mobile-open]');
      const mobileBack = event.target.closest('[data-helix-mobile-back]');
      const closeTrigger = event.target.closest('[data-helix-close-layer], [data-helix-close-mobile]');
      const countryOption = event.target.closest('[data-helix-country-option]');

      if (mobileBack) {
        event.preventDefault();
        closeMobileSubmenu(mobileBack.closest('details'));
        return;
      }

      if (searchTrigger) {
        event.preventDefault();
        openLayer('search');
      }

      if (cartTrigger) {
        event.preventDefault();
        openLayer('cart');
      }

      if (mobileTrigger) {
        event.preventDefault();
        openLayer('mobile');
        mobileTrigger.setAttribute('aria-expanded', 'true');
      }

      if (closeTrigger) {
        event.preventDefault();
        closeLayers();
        select('[data-helix-mobile-open]')?.setAttribute('aria-expanded', 'false');
      }

      if (countryOption) {
        const value = countryOption.value;
        const countryValue = select('[data-helix-country-value]');
        const localizationForm = select('[data-helix-localization-form]');
        if (countryValue && localizationForm && value) {
          countryValue.value = value;
          localizationForm.submit();
        }
      }
    });

    select('[data-helix-announcement-prev]')?.addEventListener('click', () => showAnnouncement(announcementIndex - 1, -1));
    select('[data-helix-announcement-next]')?.addEventListener('click', () => showAnnouncement(announcementIndex + 1, 1));

    function showAnnouncement(index, direction = 1) {
      const messages = selectAll('[data-helix-announcement-message]');
      if (messages.length < 2) return;
      announcementIndex = (index + messages.length) % messages.length;
      messages.forEach((message, messageIndex) => {
        message.classList.toggle('is-active', messageIndex === announcementIndex);
        message.style.setProperty('--helix-announcement-direction', direction > 0 ? '1' : '-1');
      });
      restartAnnouncementTimer();
    }

    function restartAnnouncementTimer() {
      window.clearInterval(announcementTimer);
      const messages = selectAll('[data-helix-announcement-message]');
      if (messages.length < 2) return;
      announcementTimer = window.setInterval(() => showAnnouncement(announcementIndex + 1, 1), Number(root.dataset.announcementInterval) || 5000);
    }

    function updateScrollState() {
      if (!root.classList.contains('helix-header--sticky')) return;
      const currentScrollY = window.scrollY;
      root.classList.toggle('is-scrolled', currentScrollY > 8);
      if (!desktopQuery.matches) {
        if (currentScrollY > lastScrollY + 3 && currentScrollY > 80) root.classList.add('is-scroll-hidden');
        if (currentScrollY < lastScrollY - 3 || currentScrollY <= 8) root.classList.remove('is-scroll-hidden');
      } else {
        root.classList.remove('is-scroll-hidden');
      }
      lastScrollY = currentScrollY;
    }

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeDropdowns();
      closeLayers();
      select('[data-helix-mobile-open]')?.setAttribute('aria-expanded', 'false');
    });

    window.addEventListener('scroll', updateScrollState, { passive: true });
    window.addEventListener('resize', () => {
      if (desktopQuery.matches) root.classList.remove('is-scroll-hidden');
      syncDropdownState();
      syncMenProducts();
    });

    restartAnnouncementTimer();
      updateScrollState();
    };

    const bootHelixHeaders = () => {
      document.querySelectorAll('[data-helix-header]').forEach(initHelixHeader);
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootHelixHeaders);
    else bootHelixHeaders();
    document.addEventListener('shopify:section:load', bootHelixHeaders);
  })();
{% endjavascript %}

