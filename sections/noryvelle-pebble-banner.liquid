{% liquid
  assign banner_url = section.settings.button_link | default: routes.all_products_collection_url
  assign banner_image_alt = section.settings.alt_text | default: section.settings.image.alt
  assign banner_is_decorative = false
  if banner_image_alt == blank
    assign banner_is_decorative = true
  endif
%}

<section
  class="noryvelle-pebble-banner full-width color-scheme color-{{ section.settings.color_scheme.id }}"
  style="--pebble-banner-height: {{ section.settings.height_desktop }}px; --pebble-banner-height-tablet: {{ section.settings.height_tablet }}px; --pebble-banner-height-mobile: {{ section.settings.height_mobile }}px; --pebble-banner-overlay: {{ section.settings.overlay_color }}; --pebble-banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --pebble-banner-position: {{ section.settings.image_position }}; --pebble-banner-mobile-position: {{ section.settings.mobile_image_position }};"
>
  <div class="noryvelle-pebble-banner__media">
    {% if section.settings.image != blank %}
      {% render 'responsive-picture',
        image: section.settings.image,
        mobile_image: section.settings.mobile_image,
        max_width: 2400,
        mobile_max_width: 960,
        widths: '750, 960, 1200, 1600, 1920, 2400',
        mobile_widths: '375, 550, 750, 960',
        sizes: '100vw',
        class: 'noryvelle-pebble-banner__image',
        alt: banner_image_alt,
        decorative: banner_is_decorative,
        loading: 'lazy'
      %}
    {% else %}
      {% render 'media-placeholder',
        class_name: 'noryvelle-pebble-banner__image',
        asset_name: 'placeholder-image-default-2.svg'
      %}
    {% endif %}
  </div>
  <div class="noryvelle-pebble-banner__overlay" aria-hidden="true"></div>

  <div class="noryvelle-pebble-banner__content">
    {% if section.settings.heading != blank %}
      <h2 class="noryvelle-pebble-banner__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.button_label != blank %}
      {% render 'cta',
        label: section.settings.button_label,
        url: banner_url,
        style: 'tertiary',
        class: 'noryvelle-pebble-banner__link'
      %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .noryvelle-pebble-banner {
    position: relative;
    display: flex;
    width: 100%;
    min-height: var(--pebble-banner-height);
    padding: 80px 48px;
    overflow: hidden;
    align-items: flex-end;
    justify-content: center;
    isolation: isolate;
  }

  .noryvelle-pebble-banner__media,
  .noryvelle-pebble-banner__overlay {
    position: absolute;
    inset: 0;
  }

  .noryvelle-pebble-banner__media {
    z-index: 0;
    overflow: hidden;
  }

  .noryvelle-pebble-banner__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .noryvelle-pebble-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pebble-banner-position);
  }

  .noryvelle-pebble-banner__overlay {
    z-index: 1;
    background: var(--pebble-banner-overlay);
    opacity: var(--pebble-banner-overlay-opacity);
    pointer-events: none;
  }

  .noryvelle-pebble-banner__content {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(100%, 1824px);
    flex-direction: column;
    gap: 20px;
    align-items: center;
    color: #ffffff;
    text-align: center;
  }

  .noryvelle-pebble-banner__heading {
    width: 100%;
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: 32px;
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    letter-spacing: 2px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .noryvelle-pebble-banner__link.button {
    border-bottom-color: currentcolor;
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-style: var(--font-body--style);
    font-weight: 500;
    letter-spacing: 0.6px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .noryvelle-pebble-banner {
      min-height: var(--pebble-banner-height-tablet);
      padding: 64px 30px;
    }

    .noryvelle-pebble-banner__heading {
      font-size: 28px;
    }
  }

  @media screen and (max-width: 749px) {
    .noryvelle-pebble-banner {
      min-height: var(--pebble-banner-height-mobile);
      padding: 56px 16px;
    }

    .noryvelle-pebble-banner__image {
      object-position: var(--pebble-banner-mobile-position);
    }

    .noryvelle-pebble-banner__heading {
      font-size: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pebble banner",
  "tag": "section",
  "class": "section-pebble-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text",
      "info": "Leave blank to use the image alt text."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Hands to Heritage"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 480,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Desktop",
      "default": 720
    },
    {
      "type": "range",
      "id": "height_tablet",
      "min": 360,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Tablet",
      "default": 720
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "label": "Mobile",
      "default": 720
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color",
      "default": "#181818"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Opacity",
      "default": 35
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Pebble banner"
    }
  ]
}
{% endschema %}
