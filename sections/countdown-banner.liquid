{% render 'section-stylesheet', asset: 'section-countdown-banner.css', defer_on_home: true %}
{% liquid
  assign countdown_url = section.settings.button_link | default: routes.all_products_collection_url
  assign countdown_preview = false
  if section.settings.end_at == blank and request.design_mode
    assign countdown_preview = true
  endif
%}

<section
  class="noryvelle-pebble-countdown full-width color-scheme color-{{ section.settings.color_scheme.id }}"
  style="--pebble-countdown-background: {{ section.settings.background_color }}; --pebble-countdown-foreground: {{ section.settings.text_color }}; --pebble-countdown-button-background: {{ section.settings.button_background }}; --pebble-countdown-button-label: {{ section.settings.button_label_color }};"
  data-deferred-module="{{ 'section-countdown-banner.js' | asset_url }}"
>
  <div class="noryvelle-pebble-countdown__inner">
    <div class="noryvelle-pebble-countdown__copy">
      <div class="noryvelle-pebble-countdown__heading-group">
        <div class="noryvelle-pebble-countdown__titles">
          {% if section.settings.tagline != blank %}
            <p class="noryvelle-pebble-countdown__tagline">{{ section.settings.tagline | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="noryvelle-pebble-countdown__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
        </div>
        {% if section.settings.text != blank %}
          <p class="noryvelle-pebble-countdown__text">{{ section.settings.text | escape }}</p>
        {% endif %}
      </div>
    </div>

    <noryvelle-pebble-countdown
      class="noryvelle-pebble-countdown__timer"
      {% if section.settings.end_at != blank %}
        data-end-at="{{ section.settings.end_at | escape }}"
        data-completion-behavior="{{ section.settings.completion_behavior }}"
      {% elsif countdown_preview %}
        data-preview
      {% endif %}
    >
      <time
        class="noryvelle-pebble-countdown__units"
        {% if section.settings.end_at != blank %}datetime="{{ section.settings.end_at | escape }}"{% endif %}
        aria-label="{{ section.settings.aria_label | escape }}"
        data-countdown-units
      >
        <span class="noryvelle-pebble-countdown__unit">
          <span class="noryvelle-pebble-countdown__value" data-countdown-days>{% if countdown_preview %}02{% else %}00{% endif %}</span>
          <span class="noryvelle-pebble-countdown__label">{{ section.settings.days_label | escape }}</span>
        </span>
        <span class="noryvelle-pebble-countdown__unit">
          <span class="noryvelle-pebble-countdown__value" data-countdown-hours>{% if countdown_preview %}14{% else %}00{% endif %}</span>
          <span class="noryvelle-pebble-countdown__label">{{ section.settings.hours_label | escape }}</span>
        </span>
        <span class="noryvelle-pebble-countdown__unit">
          <span class="noryvelle-pebble-countdown__value" data-countdown-minutes>{% if countdown_preview %}33{% else %}00{% endif %}</span>
          <span class="noryvelle-pebble-countdown__label">{{ section.settings.minutes_label | escape }}</span>
        </span>
        <span class="noryvelle-pebble-countdown__unit">
          <span class="noryvelle-pebble-countdown__value" data-countdown-seconds>{% if countdown_preview %}20{% else %}00{% endif %}</span>
          <span class="noryvelle-pebble-countdown__label">{{ section.settings.seconds_label | escape }}</span>
        </span>
      </time>
      <p class="noryvelle-pebble-countdown__complete" data-countdown-complete hidden aria-live="polite">
        {{ section.settings.completion_message | escape }}
      </p>
      {% if section.settings.end_at != blank %}
        <noscript>
          <style>.noryvelle-pebble-countdown__units{display:none}</style>
          <p class="noryvelle-pebble-countdown__fallback">
            {{ section.settings.no_script_label | escape }} {{ section.settings.end_at | escape }}
          </p>
        </noscript>
      {% endif %}
    </noryvelle-pebble-countdown>

    {% if section.settings.button_label != blank %}
      <div class="noryvelle-pebble-countdown__button">
        {% render 'cta',
          label: section.settings.button_label,
          url: countdown_url,
          style: 'primary',
          class: 'noryvelle-pebble-countdown__button-link'
        %}
      </div>
    {% endif %}
  </div>
</section>



{% schema %}
{
  "name": "Countdown banner",
  "tag": "section",
  "class": "section-pebble-countdown",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Limited Release"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Super Sale Up to 20% off"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "For a limited time only. Discover refined essentials at exclusive prices."
    },
    {
      "type": "text",
      "id": "end_at",
      "label": "End date and time",
      "info": "Use ISO 8601 format, for example 2027-12-31T23:59:59+07:00",
      "default": "2027-12-31T23:59:59+07:00"
    },
    {
      "type": "text",
      "id": "days_label",
      "label": "Days label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "minutes_label",
      "label": "Minutes label",
      "default": "Minutes"
    },
    {
      "type": "text",
      "id": "seconds_label",
      "label": "Seconds label",
      "default": "Seconds"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Sale countdown"
    },
    {
      "type": "text",
      "id": "no_script_label",
      "label": "No JavaScript label",
      "default": "Offer ends"
    },
    {
      "type": "select",
      "id": "completion_behavior",
      "label": "When countdown ends",
      "options": [
        {
          "value": "message",
          "label": "Show message"
        },
        {
          "value": "hide",
          "label": "Hide countdown"
        }
      ],
      "default": "message"
    },
    {
      "type": "text",
      "id": "completion_message",
      "label": "Completion message",
      "default": "This offer has ended"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Shop the sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#181818"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_label_color",
      "label": "Button label",
      "default": "#1c1c1c"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Countdown banner",
      "category": "Marketing"
    }
  ]
}
{% endschema %}
