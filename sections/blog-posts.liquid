{% render 'section-stylesheet', asset: 'section-blog-posts.css', defer_on_home: true %}

{% liquid
  assign article_count = 0
  assign header_count = section.blocks | where: 'type', 'header' | size

  for block in section.blocks
    if block.type == 'article' and block.settings.article != blank
      assign article_count = article_count | plus: 1
    endif
  endfor
%}

{% if article_count > 0 or header_count > 0 %}
  <section
    class="blog-posts color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --blog-posts-card-gap: {{ section.settings.card_gap }}px;"
  >
    <div class="blog-posts__inner section-spacing">
      {% if header_count > 0 %}
        <header class="blog-posts__header">
          {% for block in section.blocks %}
            {% if block.type == 'header' %}
              {% assign blog_header_text_class = 'blog-posts__intro content-text content-text--' | append: block.settings.text_size %}
              {% capture header_attributes %}{{ block.shopify_attributes }}{% endcapture %}
              {% render 'section-header',
                heading: block.settings.heading,
                heading_tag: block.settings.heading_tag,
                heading_size: block.settings.heading_size,
                heading_class: 'blog-posts__heading',
                text: block.settings.text,
                text_class: blog_header_text_class,
                action_label: block.settings.link_label,
                action_url: block.settings.link,
                action_style: 'text',
                action_class: 'blog-posts__view-all',
                alignment: 'center',
                class: 'blog-posts__header-content',
                tag: 'div',
                attributes: header_attributes
              %}
            {% endif %}
          {% endfor %}
        </header>
      {% endif %}

      {% if article_count > 0 %}
        <div class="blog-posts__articles">
          {% for block in section.blocks %}
            {% if block.type == 'article' %}
              {% liquid
                assign card_article = block.settings.article
                assign card_image = block.settings.image | default: card_article.image
                assign card_title = block.settings.title | default: card_article.title
                assign card_excerpt = block.settings.excerpt | default: card_article.excerpt_or_content
                assign card_url = block.settings.link | default: card_article.url
                assign card_tag = block.settings.tag
                if card_tag == blank
                  assign card_tag = card_article.tags | first
                endif
                assign card_alt = block.settings.image_alt | default: card_image.alt | default: card_title
                assign card_media_ratio = block.settings.media_ratio
                if card_media_ratio == 'inherit'
                  assign card_media_ratio = section.settings.media_ratio
                endif

                assign card_excerpt_words = block.settings.excerpt_words
                if card_excerpt_words == blank or card_excerpt_words == 0
                  assign card_excerpt_words = section.settings.excerpt_words
                endif

                assign show_card_tag = section.settings.show_tags
                if block.settings.tag_visibility == 'show'
                  assign show_card_tag = true
                elsif block.settings.tag_visibility == 'hide'
                  assign show_card_tag = false
                endif

                assign show_card_date = section.settings.show_date
                if block.settings.date_visibility == 'show'
                  assign show_card_date = true
                elsif block.settings.date_visibility == 'hide'
                  assign show_card_date = false
                endif

                assign show_card_author = section.settings.show_author
                if block.settings.author_visibility == 'show'
                  assign show_card_author = true
                elsif block.settings.author_visibility == 'hide'
                  assign show_card_author = false
                endif

                assign show_card_excerpt = true
                if block.settings.excerpt_visibility == 'hide'
                  assign show_card_excerpt = false
                endif

                assign card_heading_tag = block.settings.heading_tag | default: 'h3'
                assign card_link_label = block.settings.link_label
              %}

              {% if card_article != blank %}
                <article
                  class="blog-posts__card blog-posts__card--media-{{ block.settings.media_position }} blog-posts__card--mobile-media-{{ block.settings.mobile_media_position }} blog-posts__card--align-{{ block.settings.content_alignment }} blog-posts__card--vertical-{{ block.settings.vertical_alignment }}{% unless block.settings.show_image %} blog-posts__card--no-media{% endunless %}"
                  style="--blog-posts-card-media-width: {{ block.settings.media_width }}%; --blog-posts-card-content-width: {{ block.settings.content_width }}px; --blog-posts-card-image-position: {{ block.settings.image_position }};"
                  {{ block.shopify_attributes }}
                >
                  <div class="blog-posts__card-content">
                    <div class="blog-posts__card-copy">
                      {% if show_card_tag and card_tag != blank %}
                        <p class="blog-posts__tag">{{ card_tag | escape }}</p>
                      {% endif %}

                      <{{ card_heading_tag }} class="blog-posts__card-title jovie-heading--{{ block.settings.title_size }} heading--{{ block.settings.title_size }}">
                        <a href="{{ card_url }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ card_title | escape }}</a>
                      </{{ card_heading_tag }}>

                      {% if show_card_date or show_card_author %}
                        <p class="blog-posts__metadata">
                          {% if show_card_date %}
                            {{ card_article.published_at | time_tag: format: 'date' }}
                          {% endif %}
                          {% if show_card_date and show_card_author %}
                            <span aria-hidden="true"> · </span>
                          {% endif %}
                          {% if show_card_author %}
                            <span>{{ card_article.author | escape }}</span>
                          {% endif %}
                        </p>
                      {% endif %}

                      {% if show_card_excerpt and card_excerpt != blank %}
                        <div class="blog-posts__excerpt blog-posts__excerpt--{{ block.settings.excerpt_size }} rte">
                          {{ card_excerpt | strip_html | truncatewords: card_excerpt_words | escape }}
                        </div>
                      {% endif %}
                    </div>

                    {% render 'cta',
                      label: card_link_label,
                      url: card_url,
                      style: block.settings.link_style,
                      class: 'blog-posts__read-more',
                      open_in_new_tab: block.settings.open_in_new_tab
                    %}
                  </div>

                  {% if block.settings.show_image %}
                    <div class="blog-posts__media blog-posts__media--{{ card_media_ratio }}">
                      <a class="blog-posts__media-link" href="{{ card_url }}" tabindex="-1" aria-hidden="true"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                        {% if card_image != blank %}
                          {% render 'responsive-image',
                            image: card_image,
                            max_width: 1200,
                            widths: '360, 480, 640, 800, 1000, 1200',
                            sizes: '(min-width: 990px) 34vw, (min-width: 750px) 42vw, calc(100vw - 32px)',
                            class: 'blog-posts__image media-cover',
                            loading: 'lazy',
                            alt: card_alt,
                            style: 'object-position: var(--blog-posts-card-image-position);'
                          %}
                        {% else %}
                          {% render 'media-placeholder', class_name: 'blog-posts__image media-cover', asset_name: 'placeholder-image-default-1.svg' %}
                        {% endif %}
                      </a>
                    </div>
                  {% endif %}
                </article>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}



