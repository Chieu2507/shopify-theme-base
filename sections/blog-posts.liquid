      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "select", "id": "width", "label": "Width", "options": [{ "value": "fit-content", "label": "Fit" }, { "value": "100%", "label": "Fill" }], "default": "fit-content" },
