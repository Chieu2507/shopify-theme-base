{% render 'section-stylesheet', asset: 'section-blog-posts.css', defer_on_home: true %}

{% liquid
  assign blog_posts_background = section.settings.background_color
  if blog_posts_background == blank
    assign blog_posts_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ blog_posts_background }};
  }
{% endstyle %}

{% liquid
  assign article_count = 0
  assign header_block_count = 0

  for block in section.blocks
    if block.type == 'article'
      assign article_count = article_count | plus: 1
    endif
    if block.type == 'blog-header-label' or block.type == 'blog-header-heading' or block.type == 'blog-header-text' or block.type == 'blog-header-button' or block.type == 'header'
      assign header_block_count = header_block_count | plus: 1
    endif
  endfor
  assign rendered_article_count = article_count
  if rendered_article_count == 0
    assign rendered_article_count = 3
  endif
%}

{% if rendered_article_count > 0 %}
  <div
    class="blog-posts color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --blog-posts-column-gap: {{ section.settings.column_gap | default: 20 }}px; --blog-posts-mobile-column-gap: {{ section.settings.mobile_column_gap | default: 12 }}px;"
  >
    <div class="blog-posts__inner section-spacing">
      {% if header_block_count > 0 %}
        <header class="blog-posts__header">
          <div class="blog-posts__header-content">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'blog-header-label' %}
                  {% render 'content-block', block: block, content: block.settings.text, kind: 'label', default_preset: 'label', default_font: 'label', force_preset: 'label' %}
                {% when 'blog-header-heading' %}
                  {% render 'content-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h4', default_font: 'heading' %}
                {% when 'blog-header-text' %}
                  {% render 'content-block', block: block, content: block.settings.text, kind: 'text', default_preset: 'sm', default_font: 'body' %}
                {% when 'blog-header-button' %}
                  {% if block.settings.label != blank %}
                    <div class="content-button" {{ block.shopify_attributes }} {% render 'reveal-attributes', settings: block.settings %}>
                      {% render 'cta', label: block.settings.label, url: block.settings.link, style: block.settings.style, icon: block.settings.icon, open_in_new_tab: block.settings.open_in_new_tab %}
                    </div>
                  {% endif %}
                {% when 'header' %}
                  {% render 'section-header',
                    heading: block.settings.heading,
                    heading_tag: block.settings.heading_tag,
                    heading_size: block.settings.heading_size,
                    subheading: block.settings.subheading,
                    text: block.settings.text,
                    action_label: block.settings.link_label,
                    action_url: block.settings.link,
                    action_style: block.settings.button_style,
                    action_open_in_new_tab: block.settings.button_open_in_new_tab,
                    alignment: block.settings.content_alignment,
                    tag: 'div',
                    attributes: block.shopify_attributes
                  %}
              {% endcase %}
            {% endfor %}
          </div>
        </header>
      {% endif %}

      <div class="blog-posts__articles" data-reveal-group>
        {% assign article_reveal_index = 0 %}
        {% if article_count > 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'article' %}
              {% liquid
                assign card_article = block.settings.article
                assign card_image = blank
                assign card_article_title = blank
                assign card_article_excerpt = blank
                assign card_article_url = blank
                assign card_article_tag = blank
                assign card_article_published_at = blank
                assign card_article_author = blank

                if card_article != blank
                  assign card_image = card_article.image
                  assign card_article_title = card_article.title
                  assign card_article_excerpt = card_article.excerpt_or_content
                  assign card_article_url = card_article.url
                  assign card_article_tag = card_article.tags | first
                  assign card_article_published_at = card_article.published_at
                  assign card_article_author = card_article.author
                endif

                assign card_title = block.settings.title | default: card_article_title
                assign card_excerpt = blank
                if block.settings.excerpt != blank
                  assign card_excerpt = block.settings.excerpt
                elsif card_article_excerpt != blank
                  assign card_excerpt = card_article_excerpt
                endif
                assign card_url = card_article_url
                assign card_link_label = block.settings.link_label
                assign card_cta_url = card_url
                if card_cta_url == blank and card_link_label != blank
                  assign card_cta_url = '#'
                endif
                assign card_tag = blank
                if card_article != blank
                  assign card_tag = card_article_tag | default: 'Journal'
                endif
                assign card_alt = card_title
                if card_image != blank
                  assign card_alt = card_image.alt | default: card_title
                endif
                assign card_media_ratio = section.settings.media_ratio

                assign show_card_tag = section.settings.show_tags
                assign show_card_date = section.settings.show_date
                assign show_card_author = section.settings.show_author
                assign show_card_excerpt = true
                assign card_excerpt_words = section.settings.excerpt_words

                assign card_heading_tag = section.settings.heading_tag | default: 'h3'
              %}

              <article
                class="blog-posts__card{% if card_article == blank %} blog-posts__card--placeholder{% endif %}"
                style="--blog-posts-card-image-position: center center; --reveal-order: {{ article_reveal_index }};"
                data-reveal-item
                {{ block.shopify_attributes }}
              >
                  {% if section.settings.show_image %}
                    <div class="blog-posts__media blog-posts__media--{{ card_media_ratio }}">
                      {% if card_url != blank %}
                        <a class="blog-posts__media-link" href="{{ card_url | escape }}"{% if section.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                      {% else %}
                        <div class="blog-posts__media-link">
                      {% endif %}
                        {% if card_image != blank %}
                          {% render 'responsive-media',
                            image: card_image,
                            max_width: 1200,
                            widths: '360, 480, 640, 800, 1000, 1200',
                            sizes: '(min-width: 1150px) 33vw, (min-width: 768px) 50vw, calc(100vw - 32px)',
                            class: 'blog-posts__image media-cover',
                            loading: 'lazy',
                            alt: card_alt,
                            style: 'object-position: var(--blog-posts-card-image-position);'
                          %}
                        {% else %}
                          {{ 'image' | placeholder_svg_tag: 'blog-posts__placeholder media-cover' }}
                        {% endif %}
                      {% if card_url != blank %}</a>{% else %}</div>{% endif %}
                    </div>
                  {% endif %}

                  <div class="blog-posts__card-content">
                    {% if card_article != blank or block.settings.title != blank %}
                      <div class="blog-posts__card-copy">
                      {% if card_article != blank and show_card_tag and card_tag != blank %}
                        <p class="blog-posts__tag">{{ card_tag | escape }}</p>
                      {% endif %}

                      <{{ card_heading_tag }} class="blog-posts__card-title {% render 'typography-class', preset: section.settings.title_size, fallback: 'h3' %}">
                        {% if card_url != blank %}
                          <a href="{{ card_url | escape }}"{% if section.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ card_title | escape }}</a>
                        {% else %}
                          {{ card_title | escape }}
                        {% endif %}
                      </{{ card_heading_tag }}>

                      {% if card_article != blank and show_card_date or card_article != blank and show_card_author %}
                        <p class="blog-posts__metadata">
                          {% if show_card_date %}
                            {{ card_article_published_at | time_tag: format: 'date' }}
                          {% endif %}
                          {% if show_card_date and show_card_author %}
                            <span aria-hidden="true"> · </span>
                          {% endif %}
                          {% if show_card_author %}
                            <span>{{ card_article_author | escape }}</span>
                          {% endif %}
                        </p>
                      {% endif %}

                      {% if show_card_excerpt and card_excerpt != blank %}
                        <div class="blog-posts__excerpt blog-posts__excerpt--{{ section.settings.excerpt_size }} rte">
                          {{ card_excerpt | strip_html | truncatewords: card_excerpt_words | escape }}
                        </div>
                      {% endif %}
                    </div>

                      {% render 'cta',
                      label: card_link_label,
                      url: card_cta_url,
                      style: section.settings.link_style,
                      class: 'blog-posts__read-more',
                      open_in_new_tab: section.settings.open_in_new_tab
                      %}
                    {% else %}
                      <div class="blog-posts__skeleton-copy" aria-hidden="true">
                        <span></span><span></span><span></span>
                      </div>
                    {% endif %}
                  </div>
              </article>
              {% assign article_reveal_index = article_reveal_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% else %}
          {% for placeholder_index in (1..rendered_article_count) %}
            <article class="blog-posts__card blog-posts__card--placeholder" data-reveal-item style="--reveal-order: {{ forloop.index0 }};">
              {% if section.settings.show_image %}
                <div class="blog-posts__media blog-posts__media--{{ section.settings.media_ratio }}">
                  <div class="blog-posts__media-link">
                    {{ 'image' | placeholder_svg_tag: 'blog-posts__placeholder media-cover' }}
                  </div>
                </div>
              {% endif %}
              <div class="blog-posts__card-content">
                <div class="blog-posts__skeleton-copy" aria-hidden="true"><span></span><span></span><span></span></div>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}



{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section-blog-posts",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Desktop column gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_column_gap",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Mobile column gap",
      "default": 12
    },
    {
      "type": "header",
      "content": "Article layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Desktop image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
