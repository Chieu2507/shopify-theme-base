      "min": 10,
      "max": 50,
      "step": 1,
      "label": "Excerpt length",
      "default": 28
    },
    {
      "type": "header",
      "content": "Mobile Article layout"
    },
    {
      "type": "select",
      "id": "mobile_media_position",
      "label": "Mobile image position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "header",
      "content": "Articles content"
