        { "type": "select", "id": "reveal_type", "label": "Type", "options": [{ "value": "none", "label": "None" }, { "value": "fade-up", "label": "Fade up" }], "default": "fade-up" },
        { "type": "range", "id": "reveal_delay", "label": "Animation delay", "min": 0, "max": 1050, "step": 75, "unit": "ms", "default": 0 }
      ]
    },
    {
      "type": "blog-header-heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "heading", "label": "Text", "default": "<h2>Discover our story</h2>" },
