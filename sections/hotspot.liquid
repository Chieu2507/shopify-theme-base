{% liquid
  assign hotspot_section_width = section.settings.section_width | default: 'full_width_no_padding'
  unless hotspot_section_width == 'page_width' or hotspot_section_width == 'full_width' or hotspot_section_width == 'full_width_no_padding'
    assign hotspot_section_width = 'full_width_no_padding'
  endunless

  assign hotspot_section_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign hotspot_section_scheme = section.settings.color_scheme.id
  endif
  assign hotspot_section_scheme = hotspot_section_scheme | default: 'scheme-1' | handleize

  assign hotspot_section_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign hotspot_section_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign hotspot_header_block = section.blocks | where: 'type', 'header' | first
  assign hotspot_callout_block = section.blocks | where: 'type', 'product-callout' | first
  assign hotspot_header_has_children = false
  if hotspot_header_block != blank and hotspot_header_block.blocks != blank
    assign hotspot_header_has_children = true
  endif
%}

{% capture hotspot_section_style %}
  --hotspot-section-padding-top: {{ hotspot_section_padding_top }}px;
  --hotspot-section-padding-bottom: {{ hotspot_section_padding_bottom }}px;
  {% if section.settings.background_color != blank %}--hotspot-section-background: {{ section.settings.background_color | escape }};{% endif %}
{% endcapture %}
{% assign hotspot_section_style = hotspot_section_style | strip %}

<div
  class="hotspot-section section-color-scope color-scheme {{ hotspot_section_scheme }} hotspot-section--width-{{ hotspot_section_width }}"
  style="{{ hotspot_section_style }}"
  data-hotspot-section
>
  {% if hotspot_header_has_children or request.design_mode %}
    <div class="hotspot-section__header container page-width">
      {% content_for 'block', type: 'header', id: 'header' %}
    </div>
  {% endif %}

  {% if hotspot_callout_block != blank %}
    <div class="hotspot-section__callout">
      {% content_for 'block', type: 'product-callout', id: 'product-callout' %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .hotspot-section {
    width: 100%;
    min-width: 0;
    padding-top: var(--hotspot-section-padding-top, 0px);
    padding-bottom: var(--hotspot-section-padding-bottom, 0px);
    background: var(--hotspot-section-background, var(--background-color));
  }

  .hotspot-section__header,
  .hotspot-section__callout {
    min-width: 0;
  }

  .hotspot-section__header {
    padding-bottom: clamp(2rem, 4vw, 4.8rem);
  }

  .hotspot-section__header > .block-header {
    width: 100%;
  }

  .hotspot-section--width-page_width .hotspot-section__callout {
    width: 100%;
    max-width: var(--page-width);
    padding-inline: var(--page-margin-current, var(--page-margin-desktop));
    margin-inline: auto;
  }

  .hotspot-section--width-full .hotspot-section__callout {
    width: 100%;
    padding-inline: var(--page-margin-current, var(--page-margin-desktop));
    margin-inline: auto;
  }

  .hotspot-section--width-full_width_no_padding .hotspot-section__callout {
    width: 100%;
  }

  @media (min-width: 768px) and (max-width: 1149.98px) {
    .hotspot-section--width-page_width .hotspot-section__callout,
    .hotspot-section--width-full .hotspot-section__callout {
      --page-margin-current: var(--page-margin-tablet);
    }
  }

  @media (max-width: 767.98px) {
    .hotspot-section {
      padding-top: calc(var(--hotspot-section-padding-top, 0px) * 0.5);
      padding-bottom: calc(var(--hotspot-section-padding-bottom, 0px) * 0.5);
    }

    .hotspot-section__header {
      padding-bottom: 2rem;
    }

    .hotspot-section--width-page_width .hotspot-section__callout,
    .hotspot-section--width-full .hotspot-section__callout {
      --page-margin-current: var(--page-margin-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hotspot_product_callout",
  "class": "section-hotspot",
  "enabled_on": { "templates": ["index"] },
  "blocks": [
    { "type": "header" },
    { "type": "product-callout" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "page_width", "label": "t:options.section_width.page_width" },
        { "value": "full_width", "label": "t:options.section_width.full_width" },
        { "value": "full_width_no_padding", "label": "t:options.section_width.full_width_no_padding" }
      ],
      "default": "full_width_no_padding"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "t:labels.background_color"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:general.hotspot_product_callout",
      "category": "t:general.banners",
      "settings": {
        "section_width": "full_width_no_padding",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      },
      "blocks": [
        {
          "type": "header",
          "id": "header",
          "static": true
        },
        {
          "type": "product-callout",
          "id": "product-callout",
          "static": true,
          "settings": {
            "text_protection": 20,
            "heading": "Easy by design",
            "heading_size": "large",
            "text": "<p>Soft texture, effortless movement, and warm-weather pieces designed to be worn on repeat.</p>",
            "button_label": "Shop Linen",
            "button_color": "#FFFFFF",
            "text_alignment": "left",
            "text_position": "bottom_left",
            "hotspot_icon_style": "plus",
            "hotspot_color": "#FFFFFF"
          },
          "blocks": [
            {
              "type": "hotspot",
              "settings": {
                "vertical_position": 50,
                "horizontal_position": 22
              }
            },
            {
              "type": "hotspot",
              "settings": {
                "vertical_position": 56,
                "horizontal_position": 57
              }
            },
            {
              "type": "hotspot",
              "settings": {
                "vertical_position": 73,
                "horizontal_position": 77
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
