{% render 'section-stylesheet', asset: 'section-testimonials.css', defer_on_home: true %}

{% if section.blocks.size > 0 %}
  <testimonials-slider
    data-deferred-module="{{ 'testimonials.js' | asset_url }}"
    class="testimonials color-scheme color-{{ section.settings.color_scheme.id }} full-width{% if section.settings.section_width == 'full' %} testimonials--content-full{% endif %}"
    data-section-id="{{ section.id }}"
    data-layout-desktop="{{ section.settings.layout_desktop | default: 'slider' }}"
    data-layout-tablet="{{ section.settings.layout_desktop | default: 'slider' }}"
    data-layout-mobile="{{ section.settings.layout_mobile | default: 'slider' }}"
    data-columns-desktop="{{ section.settings.columns_desktop | default: 1 }}"
    data-columns-tablet="{{ section.settings.columns_desktop | default: 1 }}"
    data-columns-mobile="{{ section.settings.columns_mobile | default: 1 }}"
    data-show-pagination="{{ section.settings.show_pagination }}"
    style="--testimonials-content-gap: {{ section.settings.content_gap | default: 24 }}px; --testimonials-column-gap: {{ section.settings.column_gap | default: 28 }}px; --testimonials-row-gap: {{ section.settings.row_gap | default: 40 }}px; --testimonials-columns-desktop: {{ section.settings.columns_desktop | default: 1 }}; --testimonials-columns-mobile: {{ section.settings.columns_mobile | default: 1 }}; --testimonials-pagination-bottom-spacing-mobile: {{ section.settings.pagination_bottom_spacing_mobile | default: 32 }}px; --testimonials-container-width: {% if section.settings.section_width == 'custom' %}{{ section.settings.container_width | default: 1280 }}px{% else %}var(--page-width){% endif %}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="testimonials__inner section-spacing">
      <div class="testimonials__carousel">
        <div class="testimonials__slider swiper" data-testimonials-slider>
          <div class="testimonials__items swiper-wrapper" role="list">
            {% for block in section.blocks %}
              {% if block.type == 'testimonial' %}
                {% if block.settings.quote != blank or block.settings.author != blank or block.settings.role != blank %}
                  <figure class="testimonials__item testimonials__item--icon-{{ block.settings.icon_size | default: 'small' }} swiper-slide" role="listitem" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                  <div class="testimonials__icon" aria-hidden="true">
                    {% if block.settings.icon != blank %}
                      {% if block.settings.icon == 'asset:testimonials-selected-icon.png' %}
                        {% render 'media-placeholder', class_name: 'testimonials__icon-image', asset_name: 'placeholder-image-default-5.svg' %}
                      {% else %}
                        {% render 'responsive-image',
                          image: block.settings.icon,
                          max_width: 384,
                          widths: '48, 56, 64, 72, 80, 96, 144, 192, 288, 384',
                          sizes: '(max-width: 749px) 160px, 192px',
                          class: 'testimonials__icon-image',
                          loading: 'lazy',
                          decorative: true
                        %}
                      {% endif %}
                    {% else %}
                      {% render 'spark-icon', class: 'testimonials__icon-image' %}
                    {% endif %}
                  </div>

                  {% if block.settings.quote != blank %}
                    <blockquote class="testimonials__quote testimonials__quote--{{ block.settings.quote_size | default: 'h3' }} {% render 'typography-class', preset: block.settings.quote_size, fallback: 'h3' %}">
                      <p>{{ block.settings.quote | escape }}</p>
                    </blockquote>
                  {% endif %}

                  {% if block.settings.author != blank or block.settings.role != blank %}
                    <figcaption class="testimonials__attribution spinel-text--{{ block.settings.attribution_size | default: 'medium' }} content-text--{{ block.settings.attribution_size | default: 'medium' }}">
                      {% if block.settings.author != blank %}<span>{{ block.settings.author | escape }}</span>{% endif %}
                      {% if block.settings.author != blank and block.settings.role != blank %}<span aria-hidden="true"> - </span>{% endif %}
                      {% if block.settings.role != blank %}<span>{{ block.settings.role | escape }}</span>{% endif %}
                    </figcaption>
                  {% endif %}
                  </figure>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <button class="testimonials__navigation-button testimonials__navigation-button--previous" type="button" aria-label="{{ 'testimonials.previous' | t | escape }}" data-testimonials-previous>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M14.5 5 7.5 12l7 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="testimonials__navigation-button testimonials__navigation-button--next" type="button" aria-label="{{ 'testimonials.next' | t | escape }}" data-testimonials-next>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="m9.5 5 7 7-7 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      {% if section.settings.show_pagination %}<div class="testimonials__pagination swiper-pagination" data-testimonials-pagination></div>{% endif %}
    </div>
  </testimonials-slider>
{% endif %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Desktop layout",
      "options": [
        {"value": "grid", "label": "Grid"},
        {"value": "slider", "label": "Slider"}
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Mobile layout",
      "options": [
        {"value": "grid", "label": "Grid"},
        {"value": "slider", "label": "Slider"}
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show slider pagination",
      "default": false
    },
    {
      "type": "range",
      "id": "pagination_bottom_spacing_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile space below dots",
      "default": 32,
      "visible_if": "{{ section.settings.show_pagination }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Desktop columns / items",
      "default": 1
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns / items",
      "options": [
        {"value": "1", "label": "1"},
        {"value": "2", "label": "2"}
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {"value": "contained", "label": "Contained"},
        {"value": "full", "label": "Full width"},
        {"value": "custom", "label": "Custom"}
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 640,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "label": "Container width",
      "default": 1280,
      "visible_if": "{{ section.settings.section_width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Icon to text gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Row gap",
      "default": 40
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "header",
          "content": "Testimonial"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "select",
          "id": "icon_size",
          "label": "Icon size",
          "default": "small",
          "options": [
            {"value": "small", "label": "Small"},
            {"value": "medium", "label": "Medium"},
            {"value": "large", "label": "Large"}
          ]
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "When designing this collection, we wanted to strike a balance between bold silhouettes and timeless proportions. The result is a series of rings that feel effortless, yet striking"
        },
        {
          "type": "select",
          "id": "quote_size",
          "label": "Quote size",
          "options": [
            {"value": "h1", "label": "XX-large"},
            {"value": "h2", "label": "X-large"},
            {"value": "h3", "label": "Large"},
            {"value": "h4", "label": "Medium"},
            {"value": "h5", "label": "Small"},
            {"value": "h6", "label": "X-small"}
          ],
          "default": "h3"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Clara"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Founder of MALANDRA"
        },
        {
          "type": "select",
          "id": "attribution_size",
          "label": "Author and role size",
          "options": [
            {"value": "x-large", "label": "X-large"},
            {"value": "large", "label": "Large"},
            {"value": "medium", "label": "Medium"},
            {"value": "small", "label": "Small"},
            {"value": "x-small", "label": "X-small"}
          ],
          "default": "medium"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Brand trust",
      "blocks": [
        {"type": "testimonial"},
        {"type": "testimonial"},
        {"type": "testimonial"}
      ]
    }
  ]
}
{% endschema %}
