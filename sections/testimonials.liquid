{% render 'section-stylesheet', asset: 'section-testimonials.css', defer_on_home: true %}

{% liquid
  assign testimonials_background = section.settings.background_color
  if testimonials_background == blank
    assign testimonials_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ testimonials_background }};
  }

  #shopify-section-{{ section.id }} .testimonials {
    background: transparent;
  }
{% endstyle %}

{% if section.blocks.size > 0 %}
  <testimonials-slider
    data-deferred-module="{{ 'testimonials.js' | asset_url }}"
    class="testimonials testimonials--editorial color-scheme color-{{ section.settings.color_scheme.id }} full-width{% if section.settings.section_width == 'full' %} testimonials--content-full{% endif %}"
    data-section-id="{{ section.id }}"
    style="--testimonials-content-width: {% case section.settings.content_width %}{% when 'small' %}560px{% when 'large' %}960px{% when 'custom' %}{{ section.settings.content_width_custom }}px{% else %}760px{% endcase %}; --testimonials-item-gap: {{ section.settings.item_gap }}px; --testimonials-label-size: {{ section.settings.label_size }}px; --testimonials-heading-size: {{ section.settings.heading_size }}px; --testimonials-content-padding: {{ section.settings.content_padding }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    {% if section.settings.background_image != blank %}
      <div class="testimonials__background" aria-hidden="true">
        {% render 'responsive-image',
          image: section.settings.background_image,
          max_width: 2400,
          widths: '480, 750, 1100, 1500, 1920, 2400',
          sizes: '100vw',
          class: 'testimonials__background-image',
          loading: 'lazy',
          decorative: true
        %}
      </div>
    {% endif %}
    <div class="testimonials__inner section-spacing">
      <div class="testimonials__carousel">
        <div class="testimonials__slider swiper" data-testimonials-slider>
          <div class="testimonials__items swiper-wrapper" role="list">
            {% for block in section.blocks %}
              {% if block.type == 'testimonial' %}
                {% if block.settings.quote != blank or block.settings.author != blank or block.settings.role != blank %}
                  <figure class="testimonials__item swiper-slide" role="listitem" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                  {% if block.settings.label != blank %}
                    <p class="testimonials__label" data-testimonials-reveal>{{ block.settings.label | escape }}</p>
                  {% endif %}

                  {% if block.settings.quote != blank %}
                    <blockquote class="testimonials__quote" data-testimonials-reveal>
                      <p>{{ block.settings.quote | escape }}</p>
                    </blockquote>
                  {% endif %}

                  {% if block.settings.author != blank or block.settings.role != blank %}
                    <figcaption class="testimonials__attribution" data-testimonials-reveal>
                      {% if block.settings.author != blank %}<span class="testimonials__author">{{ block.settings.author | escape }}</span>{% endif %}
                      {% if block.settings.role != blank %}<span>{{ block.settings.role | escape }}</span>{% endif %}
                    </figcaption>
                  {% endif %}

                  {% if block.settings.location != blank or block.settings.piece != blank %}
                    <p class="testimonials__details" data-testimonials-reveal>
                      {% if block.settings.location != blank %}<span>{{ block.settings.location | escape }}</span>{% endif %}
                      {% if block.settings.location != blank and block.settings.piece != blank %}<span aria-hidden="true"> · </span>{% endif %}
                      {% if block.settings.piece != blank %}<span>{{ block.settings.piece | escape }}</span>{% endif %}
                    </p>
                  {% endif %}
                  <div class="testimonials__piece-link-wrap" data-testimonials-reveal>
                    {% render 'cta',
                      label: block.settings.button_label,
                      url: block.settings.button_link,
                      style: 'tertiary',
                      icon: 'arrow-right',
                      class: 'testimonials__piece-link'
                    %}
                  </div>
                  </figure>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>

      </div>

      {% assign testimonial_total = section.blocks.size | prepend: '0' | slice: -2, 2 %}
      <div class="testimonials__editorial-footer" data-testimonials-controls{% if section.blocks.size <= 1 %} hidden{% endif %} role="group" aria-label="Testimonial controls">
        <div class="testimonials__editorial-controls">
          <button class="testimonials__editorial-button" type="button" aria-label="{{ 'testimonials.previous' | t | escape }}" data-testimonials-previous>
            {% render 'icon', name: 'chevron-left' %}
          </button>
          <p class="testimonials__counter" aria-live="polite">
            <span data-testimonials-current>01</span>
            <span aria-hidden="true">/</span>
            <span data-testimonials-total>{{ testimonial_total }}</span>
          </p>
          <button class="testimonials__editorial-button" type="button" aria-label="{{ 'testimonials.next' | t | escape }}" data-testimonials-next>
            {% render 'icon', name: 'chevron-right' %}
          </button>
        </div>
      </div>
    </div>
  </testimonials-slider>
{% endif %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {"value": "page", "label": "Page width"},
        {"value": "full", "label": "Full width"}
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {"value": "small", "label": "Small"},
        {"value": "medium", "label": "Medium"},
        {"value": "large", "label": "Large"},
        {"value": "custom", "label": "Custom"}
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 320,
      "max": 1280,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 760,
      "visible_if": "{{ section.settings.content_width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Item"
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Item gap",
      "default": 16
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Label size",
      "default": 10
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 52
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 24,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Content padding",
      "default": 88
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "header",
          "content": "Item"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "When designing this collection, we wanted to strike a balance between bold silhouettes and timeless proportions. The result is a series of rings that feel effortless, yet striking"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Clara"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Founder of MALANDRA"
        },
        {
          "type": "header",
          "content": "Additional details"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "CUSTOMER STORIES / PRIVATE NOTES"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location"
        },
        {
          "type": "text",
          "id": "piece",
          "label": "Piece"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View the piece"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Brand trust",
      "blocks": [
        {"type": "testimonial"},
        {"type": "testimonial"},
        {"type": "testimonial"}
      ]
    }
  ]
}
{% endschema %}
