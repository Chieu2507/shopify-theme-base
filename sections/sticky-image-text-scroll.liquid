{% render 'section-stylesheet', asset: 'section-sticky-scroll.css' %}
{% render 'section-stylesheet', asset: 'section-sticky-image-text-scroll.css' %}

{% liquid
  assign section_background = section.settings.background_color
  assign section_background_image = section.settings.background_image
  assign section_description = section.settings.accessibility_label | default: 'Sticky image with text story'
%}

{% if section_background != blank or section_background_image != blank %}
  <style>
    #shopify-section-{{ section.id }} {
      {% if section_background != blank %}background-color: {{ section_background }};{% endif %}
      {% if section_background_image != blank %}
        background-image: url('{{ section_background_image | image_url: width: 2400 }}');
        background-position: center;
        background-size: cover;
      {% endif %}
    }
  </style>
{% endif %}

<sticky-scroll
  class="sticky-scroll sticky-scroll--image-text sticky-scroll--width-{{ section.settings.section_width }} sticky-scroll--mobile-{{ section.settings.mobile_layout }} sticky-scroll--mobile-ratio-{{ section.settings.mobile_image_ratio }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}{% if section_background_image != blank %} sticky-scroll--has-background-image{% endif %}"
  role="region"
  aria-label="{{ section_description | escape }}"
  data-section-id="{{ section.id }}"
  data-design-mode="{{ request.design_mode }}"
  data-mobile-layout="{{ section.settings.mobile_layout }}"
  style="--sticky-scroll-panel-count: {{ section.blocks.size }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="sticky-scroll__stage" data-sticky-scroll-stage>
    {% content_for 'blocks' %}

    {% if section.blocks.size > 1 %}
      <nav class="sticky-scroll__steps" aria-label="Story steps" data-sticky-scroll-steps></nav>
    {% endif %}
  </div>
</sticky-scroll>

<script type="module" src="{{ 'sticky-scroll.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Sticky image text scroll",
  "tag": "section",
  "class": "section-sticky-image-text-scroll",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "sticky", "label": "Sticky" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "Mobile image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "2-3", "label": "Portrait (2:3)" },
        { "value": "3-4", "label": "Standard (3:4)" },
        { "value": "4-5", "label": "Portrait (4:5)" },
        { "value": "6-7", "label": "Classic (6:7)" },
        { "value": "3-2", "label": "Landscape (3:2)" },
        { "value": "4-3", "label": "Landscape (4:3)" },
        { "value": "16-9", "label": "Wide (16:9)" }
      ],
      "default": "4-5",
      "visible_if": "{{ section.settings.mobile_layout == 'stacked' }}"
    },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "info": "Describes this section for screen reader users.", "default": "Sticky image with text story" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "sticky-image-text-scroll-panel" }
  ],
  "presets": [
    {
      "name": "Sticky image text scroll",
      "category": "Editorial content",
      "settings": { "section_width": "full", "mobile_layout": "stacked", "mobile_image_ratio": "4-5" },
      "blocks": [
        {
          "type": "sticky-image-text-scroll-panel",
          "settings": { "image_ratio": "4-5", "image_position": "center center", "content_alignment": "left", "content_width": 520, "content_gap": 20 },
          "blocks": [
            { "type": "label", "settings": { "text": "<p>THE COLLECTION</p>", "reveal_type": "fade-up", "reveal_delay": 0 } },
            { "type": "heading", "settings": { "heading": "<h2>Made slowly.<br>Kept for longer.</h2>", "type_preset": "h2", "reveal_type": "fade-up", "reveal_delay": 150 } },
            { "type": "text", "settings": { "text": "<p>Every piece is shaped with care, refined in the quiet space between hand and stone.</p>", "type_preset": "sm", "reveal_type": "fade-up", "reveal_delay": 300 } },
            { "type": "button", "settings": { "label": "Discover the collection", "style": "tertiary", "icon": "arrow-right", "reveal_type": "fade-up", "reveal_delay": 450 } }
          ]
        },
        {
          "type": "sticky-image-text-scroll-panel",
          "settings": { "image_ratio": "4-5", "image_position": "center center", "content_alignment": "left", "content_width": 520, "content_gap": 20 },
          "blocks": [
            { "type": "label", "settings": { "text": "<p>THE CRAFT</p>", "reveal_type": "fade-up", "reveal_delay": 0 } },
            { "type": "heading", "settings": { "heading": "<h2>Designed to endure.</h2>", "type_preset": "h2", "reveal_type": "fade-up", "reveal_delay": 150 } },
            { "type": "text", "settings": { "text": "<p>A restrained study in form, proportion and the character of natural stones.</p>", "type_preset": "sm", "reveal_type": "fade-up", "reveal_delay": 300 } },
            { "type": "button", "settings": { "label": "Explore the craft", "style": "tertiary", "icon": "arrow-right", "reveal_type": "fade-up", "reveal_delay": 450 } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
