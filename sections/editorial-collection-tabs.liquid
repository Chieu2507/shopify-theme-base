{% render 'section-stylesheet', asset: 'section-editorial-collection-tabs.css', defer_on_home: true %}
{% render 'swiper-stylesheet', defer_on_home: true %}

{% liquid
  assign section_background = section.settings.background_color
  if section_background == blank
    assign section_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif

  assign tab_blocks = section.blocks | where: 'type', 'editorial-collection-tab'
  assign tab_count = tab_blocks.size
  assign desktop_columns = section.settings.columns_desktop | plus: 0
  assign tablet_columns = desktop_columns
  if tablet_columns > 2
    assign tablet_columns = 2
  endif
  assign mobile_columns = section.settings.columns_mobile | plus: 0
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section_background }};
  }

  #shopify-section-{{ section.id }} .editorial-collection-tabs {
    background: transparent;
  }
{% endstyle %}

<editorial-collection-tabs
  class="editorial-collection-tabs color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  data-deferred-module="{{ 'editorial-collection-tabs.js' | asset_url }}"
  data-desktop-columns="{{ desktop_columns }}"
  data-mobile-columns="{{ mobile_columns }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --editorial-tabs-gap: {{ section.settings.column_gap }}px; --editorial-tabs-mobile-gap: {{ section.settings.mobile_column_gap }}px;"
>
  <div class="editorial-collection-tabs__inner section-spacing{% if section.settings.section_width == 'page' %} page-width{% endif %}">
    <header class="editorial-collection-tabs__header">
      <div class="editorial-collection-tabs__title-group" data-reveal>
        {% content_for 'block', type: 'label', id: 'label' %}
        {% content_for 'block', type: 'heading', id: 'heading' %}
      </div>
      <div class="editorial-collection-tabs__description" data-reveal>
        {% content_for 'block', type: 'text', id: 'description' %}
      </div>
    </header>

    {% if tab_count > 0 %}
      <div class="editorial-collection-tabs__tabs" role="tablist" aria-label="Collections">
        {% for block in tab_blocks %}
          {% liquid
            assign collection = block.settings.collection
            assign tab_label = block.settings.label | default: collection.title | default: 'Collection'
            assign collection_count = collection.products_count | default: 0
            assign collection_count_label = collection_count
            if collection_count < 10
              assign collection_count_label = collection_count | prepend: '0'
            endif
          %}
          <button
            class="editorial-collection-tabs__tab"
            id="EditorialCollectionTab-{{ section.id }}-{{ block.id }}"
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="EditorialCollectionPanel-{{ section.id }}-{{ block.id }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-editorial-collection-tab
            data-block-id="{{ block.id }}"
          >
            <span>{{ tab_label | escape }}</span>
            {% if block.settings.show_product_count %}
              <span class="editorial-collection-tabs__tab-count">{{ collection_count_label }}</span>
            {% endif %}
          </button>
        {% endfor %}
      </div>

      <div class="editorial-collection-tabs__panels">
        {% for block in tab_blocks %}
          {% liquid
            assign panel_is_first = forloop.first
            assign collection = block.settings.collection
            assign visible_product_count = collection.products_count | default: 0
            if visible_product_count > section.settings.products_to_show
              assign visible_product_count = section.settings.products_to_show
            endif

            assign initial_showing_count = desktop_columns
            if initial_showing_count > visible_product_count
              assign initial_showing_count = visible_product_count
            endif

            assign desktop_slides = desktop_columns
            assign tablet_slides = tablet_columns
            assign mobile_slides = mobile_columns
            if visible_product_count > desktop_slides
              assign desktop_slides = desktop_slides | plus: 0.15
            endif
            if visible_product_count > tablet_slides
              assign tablet_slides = tablet_slides | plus: 0.15
            endif
            if visible_product_count > mobile_slides
              assign mobile_slides = mobile_slides | plus: 0.2
            endif

            assign collection_label = block.settings.footer_label | default: block.settings.label | default: collection.title | default: 'Collection'
          %}
          <div
            class="editorial-collection-tabs__panel"
            id="EditorialCollectionPanel-{{ section.id }}-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="EditorialCollectionTab-{{ section.id }}-{{ block.id }}"
            data-editorial-collection-panel
            data-block-id="{{ block.id }}"
            data-collection-label="{{ collection_label | escape }}"
            data-collection-url="{{ collection.url | escape }}"
            data-product-total="{{ visible_product_count }}"
            style="--editorial-tabs-slide-mobile: calc((100% - {{ section.settings.mobile_column_gap }}px * ({{ mobile_slides }} - 1)) / {{ mobile_slides }}); --editorial-tabs-slide-tablet: calc((100% - {{ section.settings.column_gap }}px * ({{ tablet_slides }} - 1)) / {{ tablet_slides }}); --editorial-tabs-slide-desktop: calc((100% - {{ section.settings.column_gap }}px * ({{ desktop_slides }} - 1)) / {{ desktop_slides }});"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="editorial-collection-tabs__carousel swiper" data-editorial-collection-carousel>
              <ul class="editorial-collection-tabs__products swiper-wrapper" role="list">
                {% if collection != blank and collection.products_count > 0 %}
                  {% for product in collection.products limit: section.settings.products_to_show %}
                    {% liquid
                      assign card_loading = 'lazy'
                      assign card_fetchpriority = 'auto'
                      assign card_preload = false
                      if section.index <= 3 and panel_is_first and forloop.first
                        assign card_loading = 'eager'
                        assign card_fetchpriority = 'high'
                        assign card_preload = true
                      endif
                    %}
                    <li class="editorial-collection-tabs__product swiper-slide">
                      {% render 'product-card',
                        product: product,
                        media_ratio: 'global',
                        show_badges: true,
                        show_variant_dots: false,
                        show_media_actions: false,
                        show_quick_add: true,
                        enable_quick_view: true,
                        loading: card_loading,
                        fetchpriority: card_fetchpriority,
                        preload: card_preload,
                        sizes: '(min-width: 1150px) 25vw, (min-width: 768px) 50vw, 84vw'
                      %}
                    </li>
                  {% endfor %}
                {% else %}
                  {% for placeholder_index in (1..4) %}
                    <li class="editorial-collection-tabs__product swiper-slide">
                      {% render 'product-card',
                        media_ratio: 'global',
                        show_badges: true,
                        show_variant_dots: false,
                        show_media_actions: false,
                        show_quick_add: false,
                        enable_quick_view: false,
                        placeholder_index: placeholder_index
                      %}
                    </li>
                  {% endfor %}
                {% endif %}
              </ul>
            </div>

            <button class="editorial-collection-tabs__arrow editorial-collection-tabs__arrow--previous" type="button" aria-label="Previous products" data-editorial-collection-previous>
              {% render 'icon', name: 'chevron-left' %}
            </button>
            <button class="editorial-collection-tabs__arrow editorial-collection-tabs__arrow--next" type="button" aria-label="Next products" data-editorial-collection-next>
              {% render 'icon', name: 'chevron-right' %}
            </button>

            <footer class="editorial-collection-tabs__footer">
              <span
                class="editorial-collection-tabs__showing"
                data-editorial-collection-showing
                data-total="{{ visible_product_count }}"
              >Showing {{ initial_showing_count }} of {{ visible_product_count }}</span>
              <div class="editorial-collection-tabs__progress" aria-hidden="true">
                <span data-editorial-collection-progress></span>
              </div>
              <span class="editorial-collection-tabs__page-label" data-editorial-collection-page-label>{{ collection_label | escape }} / Page 01</span>
              {% if collection != blank %}
                <a class="editorial-collection-tabs__view-all" href="{{ collection.url | escape }}">
                  <span>{{ block.settings.view_all_label | default: section.settings.view_all_label | escape }}</span>
                  <span aria-hidden="true">{% render 'icon', name: 'button-arrow' %}</span>
                </a>
              {% else %}
                <span class="editorial-collection-tabs__view-all">
                  <span>{{ block.settings.view_all_label | default: section.settings.view_all_label | escape }}</span>
                  <span aria-hidden="true">{% render 'icon', name: 'button-arrow' %}</span>
                </span>
              {% endif %}
            </footer>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</editorial-collection-tabs>

{% schema %}
{
  "name": "Editorial collection tabs",
  "tag": "section",
  "class": "section-editorial-collection-tabs",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Default view all label",
      "default": "View all collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products per tab",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "info": "Shows an additional 0.2 card as a swipe preview.",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Column gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_column_gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Mobile column gap",
      "default": 12
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    { "type": "@theme" }
  ],
  "presets": [
    {
      "name": "Editorial collection tabs",
      "category": "Products",
      "settings": {
        "section_width": "full",
        "products_to_show": 8,
        "columns_desktop": 4,
        "columns_mobile": "1",
        "color_scheme": "scheme-2"
      },
      "blocks": [
        {
          "type": "label",
          "id": "label",
          "static": true,
          "settings": {
            "text": "<p>SHOP / THE HOUSE EDIT</p>"
          }
        },
        {
          "type": "heading",
          "id": "heading",
          "static": true,
          "settings": {
            "heading": "<h2>Shop the<br>current edit.</h2>",
            "type_preset": "h2"
          }
        },
        {
          "type": "text",
          "id": "description",
          "static": true,
          "settings": {
            "text": "<p>Warm-gold forms,<br>chosen for now.</p>",
            "type_preset": "sm"
          }
        },
        { "type": "editorial-collection-tab", "settings": { "label": "New arrivals" } },
        { "type": "editorial-collection-tab", "settings": { "label": "Best sellers" } },
        { "type": "editorial-collection-tab", "settings": { "label": "Rings" } },
        { "type": "editorial-collection-tab", "settings": { "label": "Necklaces" } },
        { "type": "editorial-collection-tab", "settings": { "label": "Gifts" } }
      ]
    }
  ]
}
{% endschema %}
