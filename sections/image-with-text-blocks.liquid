{% render 'section-stylesheet', asset: 'section-image-with-text.css', defer_on_home: true %}

<section
  class="image-with-text image-with-text--blocks image-with-text--media-{{ section.settings.media_position }} image-with-text--media-count-2 color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} image-with-text--full full-width{% endif %}"
  style="--image-with-text-column-gap: {{ section.settings.column_gap }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="image-with-text__inner section-spacing">
    {% content_for 'block', type: '_image-with-text-media-cluster', id: 'media_cluster' %}

    <div class="image-with-text__content image-with-text__content--{{ section.settings.content_alignment }}">
      {% content_for 'block', type: 'group', id: 'content_group' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .image-with-text--blocks .image-with-text__content > .spinel-group {
    width: 100%;
  }

  .image-with-text--blocks .image-with-text__content--center .spinel-group {
    --spinel-group-cross: center !important;
    --spinel-group-cross-mobile: center !important;
  }

  .image-with-text--blocks .image-with-text__content--right .spinel-group {
    --spinel-group-cross: flex-end !important;
    --spinel-group-cross-mobile: flex-end !important;
  }

  .image-with-text--blocks .image-with-text__content--center .typography-block {
    --typography-alignment: center !important;
  }

  .image-with-text--blocks .image-with-text__content--right .typography-block {
    --typography-alignment: right !important;
  }

  .image-with-text--blocks .image-with-text__content--center .content-button {
    justify-content: center;
  }

  .image-with-text--blocks .image-with-text__content--right .content-button {
    justify-content: flex-end;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text · Blocks",
  "tag": "section",
  "class": "image-with-text-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 40
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "_image-with-text-media-cluster"
    },
    {
      "type": "group"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "presets": [
    {
      "name": "Image with text · Blocks",
      "category": "Image",
      "blocks": [
        {
          "type": "_image-with-text-media-cluster",
          "id": "media_cluster",
          "static": true,
          "settings": {
            "desktop_ratio": "portrait",
            "mobile_ratio": "portrait"
          },
          "blocks": [
            {
              "type": "media",
              "settings": {
                "ratio": "portrait",
                "focal_point": "center center"
              }
            },
            {
              "type": "media",
              "settings": {
                "ratio": "square",
                "focal_point": "center center"
              }
            }
          ]
        },
        {
          "type": "group",
          "id": "content_group",
          "static": true,
          "settings": {
            "block_style": "group",
            "flow": "vertical",
            "stack_alignment": "flex-start",
            "stack_distribution": "flex-start",
            "gap": 16,
            "phone_flow": "vertical",
            "phone_alignment": "flex-start",
            "phone_distribution": "flex-start",
            "gap_mobile": 16,
            "desktop_width": "stretch",
            "phone_width": "stretch"
          },
          "blocks": [
            {
              "type": "group",
              "settings": {
                "block_style": "group",
                "flow": "vertical",
                "stack_alignment": "flex-start",
                "stack_distribution": "flex-start",
                "gap": 8,
                "phone_flow": "vertical",
                "phone_alignment": "flex-start",
                "phone_distribution": "flex-start",
                "gap_mobile": 8,
                "desktop_width": "stretch",
                "phone_width": "stretch"
              },
              "blocks": [
                {
                  "type": "subheading",
                  "settings": {
                    "text": "<p>Our mission</p>",
                    "type_preset": "subheading",
                    "font": "subheading",
                    "color": "subtext",
                    "width": "fit-content",
                    "width_mobile": "fit-content"
                  }
                },
                {
                  "type": "heading",
                  "settings": {
                    "heading": "<h2>More Than Beauty, A Philosophy</h2>",
                    "type_preset": "h2",
                    "color": "text",
                    "width": "fit-content",
                    "width_mobile": "fit-content"
                  }
                }
              ]
            },
            {
              "type": "group",
              "settings": {
                "block_style": "group",
                "flow": "vertical",
                "stack_alignment": "flex-start",
                "stack_distribution": "flex-start",
                "gap": 24,
                "phone_flow": "vertical",
                "phone_alignment": "flex-start",
                "phone_distribution": "flex-start",
                "gap_mobile": 24,
                "desktop_width": "stretch",
                "phone_width": "stretch"
              },
              "blocks": [
                {
                  "type": "text",
                  "settings": {
                    "text": "<p>Use this text to share information about your brand.</p>",
                    "type_preset": "custom",
                    "font": "body",
                    "font_weight": "inherit",
                    "font_size": 14,
                    "font_size_mobile": 14,
                    "line_height": "normal",
                    "color": "subtext",
                    "width": "fit-content",
                    "width_mobile": "fit-content"
                  }
                },
                {
                  "type": "button",
                  "settings": {
                    "label": "Read more",
                    "style": "tertiary",
                    "alignment": "left"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
