  .main-collection__sort-option input {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .main-collection__sort-radio {
    display: grid;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
