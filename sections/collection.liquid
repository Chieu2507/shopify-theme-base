{% liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign sort_label = 'collection.sort_by' | t | remove: ':' | strip
  assign active_filter_count = 0
  assign promotion_block = nil
  assign collection_heading = section.settings.custom_heading | default: collection.title
  assign collection_description = collection.description
  if collection_description == blank
    assign collection_description = section.settings.fallback_description
  endif
  assign desktop_card_width = 100.0 | divided_by: section.settings.columns_desktop
  assign tablet_card_width = 100.0 | divided_by: section.settings.columns_desktop
  assign mobile_card_width = 100.0 | divided_by: section.settings.columns_mobile

  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor

  for block in section.blocks
    if block.type == 'promotion'
      assign promotion_block = block
      break
    endif
  endfor
%}

{% capture product_card_sizes %}(min-width: 990px) {{ desktop_card_width }}vw, (min-width: 750px) {{ tablet_card_width }}vw, {{ mobile_card_width }}vw{% endcapture %}

{% if promotion_block != nil %}
  {% liquid
    assign promotion_image = promotion_block.settings.image
    assign promotion_link = promotion_block.settings.link
    assign promotion_alt = promotion_image.alt | default: promotion_block.settings.heading
  %}
  {% capture promotion_card %}
    <li
      class="main-collection__promotion color-scheme color-{{ promotion_block.settings.color_scheme.id }}"
      style="--main-collection-promotion-position: {{ promotion_block.settings.focal_point }}; --main-collection-promotion-overlay: {{ promotion_block.settings.overlay_opacity | divided_by: 100.0 }};"
      {{ promotion_block.shopify_attributes }}
    >
      {% if promotion_link != blank %}
        <a class="main-collection__promotion-card" href="{{ promotion_link }}">
      {% else %}
        <div class="main-collection__promotion-card">
      {% endif %}
        <div class="main-collection__promotion-media">
          {% if promotion_image != blank %}
            {% render 'responsive-image',
              image: promotion_image,
              max_width: 1800,
              widths: '480, 640, 800, 1000, 1200, 1400, 1600, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'main-collection__promotion-image',
              loading: 'lazy',
              alt: promotion_alt
            %}
          {% else %}
            {% render 'media-placeholder', class_name: 'main-collection__promotion-placeholder', asset_name: 'placeholder-image-default-1.svg' %}
          {% endif %}
        </div>
        <span class="main-collection__promotion-overlay" aria-hidden="true"></span>
        <div class="main-collection__promotion-content main-collection__promotion-content--{{ promotion_block.settings.content_position }}">
          {% if promotion_block.settings.eyebrow != blank %}
            <span class="main-collection__promotion-eyebrow">{{ promotion_block.settings.eyebrow | escape }}</span>
          {% endif %}
          {% if promotion_block.settings.heading != blank %}
            <{{ promotion_block.settings.heading_tag }} class="main-collection__promotion-heading omnise-heading--{{ promotion_block.settings.heading_size }} heading--{{ promotion_block.settings.heading_size }}">
              {{ promotion_block.settings.heading | escape }}
            </{{ promotion_block.settings.heading_tag }}>
          {% endif %}
          {% if promotion_block.settings.button_label != blank and promotion_link != blank %}
            <span class="button button--primary">{{ promotion_block.settings.button_label | escape }}</span>
          {% endif %}
        </div>
      {% if promotion_link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    </li>
  {% endcapture %}
{% endif %}

<section
  class="main-collection color-scheme color-{{ section.settings.color_scheme.id }} full-width"
    style="--main-collection-columns-desktop: {{ section.settings.columns_desktop }}; --main-collection-columns-tablet: {{ section.settings.columns_desktop }}; --main-collection-columns-mobile: {{ section.settings.columns_mobile }}; --main-collection-product-gap: {{ section.settings.product_gap }}px; --main-collection-header-padding-top: {{ section.settings.header_padding_top }}px; --main-collection-header-padding-bottom: {{ section.settings.header_padding_bottom }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;"
>
  <div class="main-collection__header">
    <h1 class="main-collection__title">{{ collection_heading | escape }}</h1>

    {% if collection_description != blank %}
      <collection-description class="main-collection__description-wrap">
        <div
          class="main-collection__description rte omnise-text--{{ section.settings.text_size | default: 'medium' }}{% if section.settings.show_read_more %} main-collection__description--collapsed{% endif %}"
          id="CollectionDescription-{{ section.id }}"
          data-collection-description
        >
          {{ collection_description }}
        </div>
        {% if section.settings.show_read_more %}
          <button
            class="main-collection__read-more"
            type="button"
            hidden
            aria-controls="CollectionDescription-{{ section.id }}"
            aria-expanded="false"
            data-collection-description-toggle
            data-more-label="{{ 'collection.read_more' | t | escape }}"
            data-less-label="{{ 'collection.read_less' | t | escape }}"
          >
            {{ 'collection.read_more' | t }}
          </button>
        {% endif %}
      </collection-description>
    {% endif %}
  </div>

  <collection-facets class="main-collection__facets" data-section-id="{{ section.id }}">
    {% if collection != blank and collection.all_products_count > 0 %}
      <div class="main-collection__toolbar">
        <div class="main-collection__toolbar-start">
          {% if section.settings.enable_filtering and collection.filters.size > 0 %}
            <button
              class="main-collection__filter-button button button--secondary"
              type="button"
              aria-haspopup="dialog"
              aria-controls="CollectionFilters-{{ section.id }}"
              data-collection-filter-open
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15.5312 10.7948H14.4596C14.2319 9.23504 12.8855 8.03336 11.2635 8.03336C9.64159 8.03336 8.29522 9.23504 8.06747 10.7948H0.46875C0.209875 10.7948 0 11.0047 0 11.2635C0 11.5224 0.209875 11.7323 0.46875 11.7323H8.06747C8.29522 13.2921 9.64159 14.4938 11.2635 14.4938C12.8855 14.4938 14.2319 13.2921 14.4596 11.7323H15.5312C15.7901 11.7323 16 11.5224 16 11.2635C16 11.0047 15.7901 10.7948 15.5312 10.7948ZM11.2635 13.5563C9.99934 13.5563 8.97084 12.5278 8.97084 11.2635C8.97084 9.99936 9.99934 8.97086 11.2635 8.97086C12.5278 8.97086 13.5562 9.99936 13.5562 11.2635C13.5562 12.5278 12.5278 13.5563 11.2635 13.5563Z" fill="currentColor"/>
                <path d="M0.46875 5.20522H1.54037C1.76813 6.76497 3.1145 7.96666 4.73647 7.96666C6.35841 7.96666 7.70478 6.76497 7.93253 5.20522H15.5312C15.7901 5.20522 16 4.99535 16 4.73647C16 4.4776 15.7901 4.26772 15.5312 4.26772H7.93253C7.70478 2.70794 6.35841 1.50626 4.73647 1.50626C3.1145 1.50626 1.76813 2.70794 1.54037 4.26772H0.46875C0.209875 4.26772 0 4.4776 0 4.73647C0 4.99535 0.209875 5.20522 0.46875 5.20522ZM4.73647 2.44376C6.00066 2.44376 7.02916 3.47226 7.02916 4.73647C7.02916 6.00066 6.00066 7.02916 4.73647 7.02916C3.47225 7.02916 2.44375 6.00066 2.44375 4.73647C2.44375 3.47226 3.47225 2.44376 4.73647 2.44376Z" fill="currentColor"/>
              </svg>

              <span>{{ 'collection.filter' | t }}
                {% if active_filter_count > 0 %}
                  <span>({{ active_filter_count }})</span>
                {% endif %}
              </span>
            </button>
          {% endif %}
        </div>

        <div class="main-collection__toolbar-end">
          <span class="main-collection__product-count" aria-live="polite">
            {{ 'collection.product_count' | t: count: collection.products_count }}
          </span>

          {% if section.settings.enable_sorting %}
            <form class="main-collection__sort-form{% if section.settings.enable_filtering and collection.filters.size > 0 %} main-collection__sort-form--mobile-hidden{% endif %}" action="{{ collection.url }}" method="get" data-collection-sort-form>
            {% for filter in collection.filters %}
              {% for value in filter.active_values %}
                <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
              {% endfor %}
              {% if filter.type == 'price_range' %}
                {% if filter.min_value.value != nil %}
                  <input
                    type="hidden"
                    name="{{ filter.min_value.param_name }}"
                    value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                  >
                {% endif %}
                {% if filter.max_value.value != nil %}
                  <input
                    type="hidden"
                    name="{{ filter.max_value.param_name }}"
                    value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                  >
                {% endif %}
              {% endif %}
            {% endfor %}
            <label id="CollectionSortLabel-{{ section.id }}" for="CollectionSort-{{ section.id }}">{{ sort_label }}</label>
            <collection-sort-select class="main-collection__sort-select-wrap">
              <select
                id="CollectionSort-{{ section.id }}"
                name="sort_by"
                aria-labelledby="CollectionSortLabel-{{ section.id }}"
                data-collection-sort
                data-collection-sort-native
              >
                {% for option in collection.sort_options %}
                  <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>
                    {{ option.name }}
                  </option>
                {% endfor %}
              </select>
              <button
                class="main-collection__sort-trigger"
                type="button"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="CollectionSortOptions-{{ section.id }}"
                aria-labelledby="CollectionSortLabel-{{ section.id }} CollectionSortValue-{{ section.id }}"
                data-collection-sort-trigger
              >
                <span id="CollectionSortValue-{{ section.id }}" data-collection-sort-value>
                  {% for option in collection.sort_options %}
                    {% if option.value == sort_by %}{{ option.name }}{% endif %}
                  {% endfor %}
                </span>
                <svg viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                  <path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div
                class="main-collection__sort-listbox"
                id="CollectionSortOptions-{{ section.id }}"
                role="listbox"
                aria-labelledby="CollectionSortLabel-{{ section.id }}"
                data-collection-sort-listbox
                hidden
              >
                {% for option in collection.sort_options %}
                  <button
                    class="main-collection__sort-option-button"
                    type="button"
                    role="option"
                    aria-selected="{% if option.value == sort_by %}true{% else %}false{% endif %}"
                    title="{{ option.name | escape }}"
                    data-value="{{ option.value | escape }}"
                    data-collection-sort-option
                  >
                    <span>{{ option.name }}</span>
                    <svg viewBox="0 0 14 11" aria-hidden="true" focusable="false">
                      <path d="m1 5.5 3.5 3.5L13 1" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {% endfor %}
              </div>
            </collection-sort-select>
            <button class="main-collection__sort-submit" type="submit">{{ 'collection.apply_sort' | t }}</button>
            </form>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.enable_filtering and collection.filters.size > 0 %}
      <dialog
        class="main-collection__filter-dialog"
        id="CollectionFilters-{{ section.id }}"
        aria-labelledby="CollectionFiltersTitle-{{ section.id }}"
        scroll-lock
        data-collection-filter-dialog
      >
        <span class="main-collection__filter-backdrop-pointer modal-close-button close-icon" aria-hidden="true"></span>
        <form class="main-collection__filter-form" action="{{ collection.url }}" method="get">
          <header class="main-collection__filter-header">
            <h2 id="CollectionFiltersTitle-{{ section.id }}">{{ 'collection.filters' | t }}</h2>
            <button class="main-collection__filter-close modal-close-button close-icon" type="button" aria-label="{{ 'collection.close_filters' | t | escape }}" data-collection-filter-close></button>
          </header>

          <div class="main-collection__filter-body">
            {% if active_filter_count > 0 %}
              <div class="main-collection__active-filters">
              {% for filter in collection.filters %}
                {% for value in filter.active_values %}
                  <a href="{{ value.url_to_remove }}">
                    <span>{{ value.label | escape }}</span>
                    <span aria-hidden="true">×</span>
                  </a>
                {% endfor %}
                {% if filter.type == 'price_range' %}
                  {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                    <a href="{{ filter.url_to_remove }}">
                      <span>{{ filter.label | escape }}</span>
                      <span aria-hidden="true">×</span>
                    </a>
                  {% endif %}
                {% endif %}
              {% endfor %}
              <a class="main-collection__clear-link" href="{{ collection.url }}">{{ 'collection.clear_all' | t }}</a>
              </div>
            {% endif %}

            <div class="main-collection__filter-groups">
              {% if section.settings.enable_sorting %}
                <details class="main-collection__mobile-sort main-collection__filter-group" open>
                  <summary>
                    <span>{{ sort_label }}</span>
                    <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                      <path d="M2 6h8" stroke="currentColor" stroke-linecap="round"/>
                    </svg>
                  </summary>
                  <fieldset class="main-collection__sort-options">
                    <legend class="visually-hidden">{{ sort_label }}</legend>
                    {% for option in collection.sort_options %}
                      <label class="main-collection__sort-option">
                        <input
                          type="radio"
                          name="sort_by"
                          value="{{ option.value }}"
                          {% if option.value == sort_by %}checked{% endif %}
                        >
                        <span class="main-collection__sort-radio" aria-hidden="true"></span>
                        <span class="main-collection__sort-option-label">{{ option.name }}</span>
                      </label>
                    {% endfor %}
                  </fieldset>
                </details>
              {% endif %}

              {% for filter in collection.filters %}
                <details class="main-collection__filter-group" open>
                <summary>
                  <span>{{ filter.label | escape }}</span>
                  <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                    <path d="M2 6h8" stroke="currentColor" stroke-linecap="round"/>
                  </svg>
                </summary>

                {% if filter.type == 'price_range' %}
                  {% liquid
                    assign price_range_max = filter.range_max | money_without_currency | replace: ',', ''
                    assign price_range_min_value = 0
                    assign price_range_max_value = price_range_max
                    assign currency_symbol = cart.currency.symbol | default: localization.country.currency.symbol | default: '$'

                    if filter.min_value.value != nil
                      assign price_range_min_value = filter.min_value.value | money_without_currency | replace: ',', ''
                    endif

                    if filter.max_value.value != nil
                      assign price_range_max_value = filter.max_value.value | money_without_currency | replace: ',', ''
                    endif
                  %}
                  <collection-price-range class="main-collection__price-filter">
                    <div class="main-collection__price-slider" data-price-range-slider>
                      <input
                        type="range"
                        min="0"
                        max="{{ price_range_max }}"
                        step="1"
                        value="{{ price_range_min_value }}"
                        aria-label="{{ 'collection.price_from' | t | escape }}"
                        data-price-range-min
                      >
                      <input
                        type="range"
                        min="0"
                        max="{{ price_range_max }}"
                        step="1"
                        value="{{ price_range_max_value }}"
                        aria-label="{{ 'collection.price_to' | t | escape }}"
                        data-price-range-max
                      >
                    </div>

                    <div class="main-collection__price-fields">
                      <div class="main-collection__price-input">
                        <label class="visually-hidden" for="Filter-{{ filter.label | handle }}-Min-{{ section.id }}">{{ 'collection.price_from' | t }}</label>
                        <span aria-hidden="true">{{ currency_symbol }}</span>
                        <input
                          id="Filter-{{ filter.label | handle }}-Min-{{ section.id }}"
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          min="0"
                          max="{{ price_range_max }}"
                          step="1"
                          placeholder="0"
                          data-price-number-min
                          {% if filter.min_value.value != nil %}value="{{ price_range_min_value }}"{% endif %}
                        >
                      </div>
                      <span class="main-collection__price-separator" aria-hidden="true">{{ 'collection.price_to' | t | downcase }}</span>
                      <div class="main-collection__price-input">
                        <label class="visually-hidden" for="Filter-{{ filter.label | handle }}-Max-{{ section.id }}">{{ 'collection.price_to' | t }}</label>
                        <span aria-hidden="true">{{ currency_symbol }}</span>
                        <input
                          id="Filter-{{ filter.label | handle }}-Max-{{ section.id }}"
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          min="0"
                          max="{{ price_range_max }}"
                          step="1"
                          placeholder="{{ price_range_max }}"
                          data-price-number-max
                          {% if filter.max_value.value != nil %}value="{{ price_range_max_value }}"{% endif %}
                        >
                      </div>
                    </div>
                  </collection-price-range>
                {% else %}
                  {% liquid
                    assign is_swatch_filter = false
                    if filter.presentation == 'swatch'
                      assign is_swatch_filter = true
                    endif
                  %}
                  <ul class="main-collection__filter-values{% if is_swatch_filter %} main-collection__filter-values--swatches{% endif %}" role="list">
                    {% for value in filter.values limit: 50 %}
                      <li>
                        <label class="main-collection__filter-value{% if value.active %} is-active{% endif %}">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          {% if is_swatch_filter %}
                            {% liquid
                              assign swatch_style = ''
                              if value.swatch.image != blank
                                assign swatch_image_url = value.swatch.image | image_url: width: 48
                                assign swatch_style = '--main-collection-swatch-image: url(' | append: swatch_image_url | append: ');'
                              elsif value.swatch.color != blank
                                assign swatch_style = '--main-collection-swatch-color: ' | append: value.swatch.color | append: ';'
                              endif
                            %}
                            <span class="main-collection__swatch"{% if swatch_style != blank %} style="{{ swatch_style }}"{% endif %}></span>
                          {% endif %}
                          <span>{{ value.label | escape }}</span>
                          <span>({{ value.count }})</span>
                        </label>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
                </details>
              {% endfor %}
            </div>
          </div>

          <footer class="main-collection__filter-footer">
            <button class="button button--primary" type="submit">
              {{ 'collection.apply_filters' | t: count: collection.products_count }}
            </button>
            <a class="button button--secondary" href="{{ collection.url }}">{{ 'collection.clear_all' | t }}</a>
          </footer>
        </form>
      </dialog>
    {% endif %}

    <div class="main-collection__products section-spacing" id="CollectionProducts-{{ section.id }}">
      {% paginate collection.products by section.settings.products_per_page, window_size: 1 %}
        {% if collection.products_count > 0 %}
          <h2 class="visually-hidden">{{ 'collection.products_heading' | t }}</h2>
          <ul class="main-collection__grid" role="list">
            {% assign promotion_rendered = false %}
            {% for product in collection.products %}
              {% liquid
                assign card_loading = 'lazy'
                assign card_fetchpriority = 'auto'
                if forloop.index > 2
                  assign card_fetchpriority = 'low'
                endif
              %}
              <li class="main-collection__product">
                {% render 'product-card',
                  product: product,
                  show_media_actions: section.settings.show_card_actions,
                  enable_quick_view: section.settings.enable_quick_view,
                  heading_tag: 'h3',
                  sizes: product_card_sizes,
                  loading: card_loading,
                  fetchpriority: card_fetchpriority
                %}
              </li>

              {% if promotion_block != nil and forloop.index == section.settings.promotion_after %}
                {{ promotion_card }}
                {% assign promotion_rendered = true %}
              {% endif %}
            {% endfor %}

            {% if promotion_block != nil and promotion_rendered == false %}
              {{ promotion_card }}
            {% endif %}
          </ul>

          {% if paginate.pages > 1 %}
            <nav class="main-collection__pagination" aria-label="{{ 'collection.pagination' | t | escape }}">
              {% if paginate.previous %}
                <a class="main-collection__pagination-arrow" href="{{ paginate.previous.url }}" aria-label="{{ 'collection.previous_page' | t | escape }}">
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="m10.5 3-5 5 5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {% endif %}

              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {% else %}
                  <span{% if part.title == paginate.current_page %} class="is-current" aria-current="page"{% endif %}>{{ part.title }}</span>
                {% endif %}
              {% endfor %}

              {% if paginate.next %}
                <a class="main-collection__pagination-arrow" href="{{ paginate.next.url }}" aria-label="{{ 'collection.next_page' | t | escape }}">
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="m5.5 3 5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {% endif %}
            </nav>
          {% endif %}
        {% else %}
          <div class="main-collection__empty">
            <h2>{{ 'collection.empty' | t }}</h2>
            <p>{{ 'collection.empty_help' | t }}</p>
            {% if active_filter_count > 0 %}
              <a class="button button--primary" href="{{ collection.url }}">{{ 'collection.clear_all' | t }}</a>
            {% endif %}
          </div>
        {% endif %}
      {% endpaginate %}
    </div>
  </collection-facets>
</section>

{% stylesheet %}
  .main-collection {
    display: block;
    background: var(--gradient-background, var(--color-background));
    color: var(--color-text);
  }

  .main-collection__header {
    display: grid;
    min-height: 192px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 56px;
    padding: var(--main-collection-header-padding-top) var(--page-margin) var(--main-collection-header-padding-bottom);
  }

  .main-collection__title {
    margin: 0;
    font-size: var(--font-h2-size);
    line-height: var(--font-h2-line-height);
  }

  .main-collection__description-wrap {
    display: grid;
    justify-items: start;
    gap: 12px;
  }

  .main-collection__description {
    color: var(--color-text);
  }

  html:not(.no-js) .main-collection__description--collapsed {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .main-collection__read-more {
    padding: 0 0 2px;
    border: 0;
    border-bottom: 1px solid currentcolor;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font-size: var(--font-body-small);
    line-height: 1.3;
  }

  .main-collection__read-more:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .main-collection__facets {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .main-collection__facets[aria-busy='true'] .main-collection__products {
    opacity: 0.55;
    pointer-events: none;
  }

  .main-collection__products {
    transition: opacity var(--motion-duration) ease;
  }

  .main-collection__toolbar {
    display: flex;
    min-height: 48px;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding-inline: var(--page-margin);
  }

  .main-collection__toolbar-start,
