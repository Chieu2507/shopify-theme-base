    border-radius: 50%;
    background: var(--color-background);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
    cursor: grab;
    pointer-events: auto;
  }

  .main-collection__price-slider input[type='range']:active::-webkit-slider-thumb {
