    top: 50%;
    height: 5px;
    border-radius: 999px;
    content: '';
    transform: translateY(-50%);
  }

  .main-collection__price-slider::before {
    right: 0;
    left: 0;
    background: color-mix(in srgb, var(--color-text) 14%, transparent);
  }

  .main-collection__price-slider::after {
    right: calc(100% - var(--main-collection-price-max));
    left: var(--main-collection-price-min);
    background: var(--color-heading);
  }

  .main-collection__price-slider input[type='range'] {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 28px;
    margin: 0;
    padding: 0;
