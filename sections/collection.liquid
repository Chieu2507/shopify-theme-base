      font-size: var(--font-h2-size);
      line-height: 1.02;
    }

    .main-collection__description-wrap {
      justify-items: center;
      gap: 16px;
    }

    .main-collection__description--collapsed {
      -webkit-line-clamp: 6;
    }

    .main-collection__facets {
      gap: 28px;
    }

    .main-collection__toolbar {
      padding-inline: var(--page-margin);
    }

    .main-collection__toolbar-end {
      margin-left: auto;
    }

    .main-collection__sort-form--mobile-hidden {
      display: none;
    }

    .main-collection__grid {
      grid-template-columns: repeat(var(--main-collection-columns-mobile), minmax(0, 1fr));
    }

    .main-collection__promotion-card {
      min-height: 220px;
    }

    .main-collection__promotion {
      grid-column: 1 / -1;
    }

    .main-collection__mobile-sort {
      display: block;
    }

    .main-collection__promotion-content {
      gap: 10px;
      padding: 20px 16px;
    }

    .main-collection__promotion-heading {
      font-size: var(--font-h4-size);
      line-height: var(--font-h4-line-height);
    }

    .main-collection__promotion-content .button {
      min-height: 36px;
    }

    .main-collection__pagination {
      min-height: 72px;
    }

    .main-collection__filter-dialog {
      position: fixed;
      inset: auto 0 0;
      width: 100vw;
      height: 85dvh;
      max-height: 85dvh;
      margin: 0;
      overflow: visible;
      border-radius: 14px 14px 0 0;
      background: transparent;
      box-shadow: 0 -14px 42px rgb(0 0 0 / 12%);
      transform: translateY(100%);
    }

    .main-collection__filter-form { overflow: hidden; border-radius: inherit; background: var(--color-background); }
    .main-collection__filter-dialog[open]:not(.is-closing) { transform: translateY(0); }
    .main-collection__filter-dialog[open]:not(.is-closing) { animation-name: main-collection-filter-drawer-in-mobile; }
    .main-collection__filter-dialog.is-closing { animation-name: main-collection-filter-drawer-out-mobile; }
    .main-collection__filter-handle { display: grid; width: 100%; height: 28px; place-items: center; background: var(--color-background); cursor: grab; touch-action: none; user-select: none; -webkit-tap-highlight-color: transparent; }
    .main-collection__filter-handle::before { width: 48px; height: 4px; border-radius: 999px; background: color-mix(in srgb, var(--color-heading) 14%, transparent); content: ''; }
    .main-collection__filter-dialog.is-handle-dragging .main-collection__filter-handle { cursor: grabbing; }
    .main-collection__filter-header { min-height: 64px; }

    @keyframes main-collection-filter-drawer-in-mobile { from { transform: translateY(100%); } to { transform: translateY(0); } }
    @keyframes main-collection-filter-drawer-out-mobile { from { transform: translateY(0); } to { transform: translateY(100%); } }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-collection__products,
    .main-collection__promotion-image,
    .main-collection__sort-trigger,
    .main-collection__sort-trigger svg,
    .main-collection__sort-radio::before,
    .main-collection__filter-backdrop-pointer,
    .main-collection__filter-group summary svg,
    .main-collection__filter-dialog[open],
    .main-collection__filter-dialog[open]::backdrop,
    .main-collection__filter-dialog.is-closing,
    .main-collection__filter-dialog.is-closing::backdrop {
      transition: none;
      animation: none;
    }
  }
{% endstylesheet %}


