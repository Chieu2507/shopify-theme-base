  .main-collection__sort-listbox,
  .main-collection__filter-body {
    scrollbar-color: color-mix(in srgb, var(--color-text) 38%, transparent) transparent;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
  }

  .main-collection__sort-listbox::-webkit-scrollbar,
  .main-collection__filter-body::-webkit-scrollbar {
    width: 8px;
  }

  .main-collection__sort-listbox::-webkit-scrollbar-track,
  .main-collection__filter-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .main-collection__sort-listbox::-webkit-scrollbar-thumb,
  .main-collection__filter-body::-webkit-scrollbar-thumb {
    border: 2px solid var(--color-background);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-text) 38%, transparent);
  }

  .main-collection__sort-listbox::-webkit-scrollbar-thumb:hover,
  .main-collection__filter-body::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--color-text) 58%, transparent);
  }

  .main-collection__sort-listbox[hidden] {
    display: none;
  }

  .main-collection__sort-option-button {
    display: flex;
    width: 100%;
    min-height: 40px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 10px;
    border: 0;
    border-radius: max(2px, calc(var(--style-border-radius-inputs) - 2px));
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    text-align: left;
  }

  .main-collection__sort-option-button:hover,
  .main-collection__sort-option-button:focus-visible {
    outline: 0;
    background: color-mix(in srgb, var(--color-text) 7%, transparent);
  }

  .main-collection__sort-option-button svg {
    width: 13px;
    flex: 0 0 13px;
    opacity: 0;
  }

  .main-collection__sort-option-button[aria-selected='true'] {
    color: var(--color-heading);
    font-weight: 600;
  }

  .main-collection__sort-option-button[aria-selected='true'] svg {
    opacity: 1;
  }

  .main-collection__products {
    padding-inline: var(--page-margin);
  }

  .main-collection__grid {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--main-collection-product-gap);
    grid-template-columns: repeat(var(--main-collection-columns-desktop), minmax(0, 1fr));
    list-style: none;
  }

  .main-collection__product,
  .main-collection__promotion {
    min-width: 0;
  }

  .main-collection__promotion {
    min-height: 100%;
    grid-column: span 2;
  }

  .main-collection__promotion-card {
    position: relative;
    display: block;
    overflow: hidden;
    height: 100%;
    min-height: 360px;
    color: var(--color-text);
    isolation: isolate;
  }

  .main-collection__promotion-media,
  .main-collection__promotion-overlay,
  .main-collection__promotion-content {
    position: absolute;
    inset: 0;
  }

  .main-collection__promotion-image,
  .main-collection__promotion-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--main-collection-promotion-position);
    transition: transform 300ms ease;
  }

  .main-collection__promotion-card[href]:hover .main-collection__promotion-image {
    transform: scale(1.02);
  }

  .main-collection__promotion-overlay {
    z-index: 1;
    background: rgb(0 0 0 / var(--main-collection-promotion-overlay));
  }

  .main-collection__promotion-content {
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
    text-align: center;
  }

  .main-collection__promotion-content--top {
    justify-content: flex-start;
  }

  .main-collection__promotion-content--bottom {
    justify-content: flex-end;
  }

  .main-collection__promotion-eyebrow {
    font-size: var(--font-caption);
    text-transform: uppercase;
  }

  .main-collection__promotion-heading {
    max-width: 620px;
    margin: 0;
    color: var(--color-heading);
  }

  .main-collection__pagination {
    display: flex;
    min-height: 88px;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .main-collection__pagination a,
  .main-collection__pagination span {
    display: grid;
    min-width: 32px;
    height: 32px;
    place-items: center;
    color: var(--color-text);
    font-size: var(--font-caption);
    text-decoration: none;
  }

  .main-collection__pagination .is-current {
    background: var(--color-heading);
    color: var(--color-background);
  }

  .main-collection__pagination-arrow svg {
    width: 14px;
    height: 14px;
  }

  .main-collection__empty {
    display: grid;
    min-height: 420px;
    place-items: center;
    align-content: center;
    gap: 16px;
    text-align: center;
  }

  .main-collection__filter-dialog {
    width: min(375px, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 auto 0 0;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: var(--color-background);
    color: var(--color-text);
  }

  .no-js .main-collection__filter-button {
    display: none;
  }

  .no-js .main-collection__filter-backdrop-pointer {
    display: none;
  }

  .no-js .main-collection__filter-dialog {
    position: static;
    display: block;
    width: 100%;
    height: auto;
  }

  .no-js .main-collection__filter-header button {
    display: none;
  }

  .no-js .main-collection__filter-form {
    height: auto;
  }

  .no-js .main-collection__filter-body {
    overflow: visible;
  }

  .main-collection__filter-dialog::backdrop {
    background: rgb(0 0 0 / 0.32);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  html.collection-filter-backdrop-cursor,
  html.collection-filter-backdrop-cursor body,
  html.collection-filter-backdrop-cursor .main-collection__filter-dialog::backdrop {
    cursor: none !important;
  }

  .main-collection__filter-backdrop-pointer {
    position: absolute;
    z-index: 12;
    top: var(--main-collection-filter-pointer-y, 0);
    left: var(--main-collection-filter-pointer-x, 0);
    width: 64px;
    height: 64px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(.68);
    transition: opacity 160ms ease, transform 220ms cubic-bezier(.22, 1, .36, 1), visibility 0s linear 220ms;
    will-change: transform, opacity;
  }

  .main-collection__filter-backdrop-pointer.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
    transition-delay: 0s;
  }

  .main-collection__filter-dialog[open]:not(.is-closing) {
    animation: main-collection-filter-drawer-in 280ms cubic-bezier(.22, 1, .36, 1) both;
  }

  .main-collection__filter-dialog[open]:not(.is-closing)::backdrop {
    animation: main-collection-filter-backdrop-in 240ms ease-out both;
  }

  .main-collection__filter-dialog.is-closing {
    pointer-events: none;
    animation: main-collection-filter-drawer-out 240ms cubic-bezier(.55, 0, 1, .45) both;
  }

  .main-collection__filter-dialog.is-closing::backdrop {
    animation: main-collection-filter-backdrop-out 220ms ease-in both;
  }

  @keyframes main-collection-filter-drawer-in {
    from { opacity: 0; transform: translateX(-28px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes main-collection-filter-drawer-out {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(-100%); }
  }

  @keyframes main-collection-filter-backdrop-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes main-collection-filter-backdrop-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  .main-collection__filter-form {
    display: grid;
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .main-collection__filter-body {
    min-height: 0;
    overflow-y: auto;
  }

  .main-collection__filter-header {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    padding-inline: 24px;
