    outline-offset: 2px;
  }

  .main-collection__filter-value input:focus-visible + .main-collection__swatch {
    outline: 2px solid var(--color-heading);
    outline-offset: 3px;
  }

  .main-collection__price-filter {
    display: block;
    padding: 8px 0 22px;
