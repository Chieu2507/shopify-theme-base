  .main-collection__sort-option input:checked + .main-collection__sort-radio::before {
    transform: scale(1);
  }

  .main-collection__sort-option input:focus-visible + .main-collection__sort-radio {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .main-collection__filter-group {
    border-bottom: 1px solid var(--color-variant-border);
  }

  .main-collection__filter-group:last-child {
