      -webkit-line-clamp: 6;
    }

    .main-collection__facets {
      gap: 28px;
    }

    .main-collection__toolbar {
      padding-inline: var(--page-margin);
    }

    .main-collection__toolbar-end {
      margin-left: auto;
    }

    .main-collection__sort-form--mobile-hidden {
      display: none;
    }

    .main-collection__grid {
      grid-template-columns: repeat(var(--main-collection-columns-mobile), minmax(0, 1fr));
    }

    .main-collection__promotion-card {
      min-height: 220px;
    }

    .main-collection__promotion {
      grid-column: 1 / -1;
    }

    .main-collection__mobile-sort {
      display: block;
    }

    .main-collection__promotion-content {
      gap: 10px;
      padding: 20px 16px;
    }

    .main-collection__promotion-heading {
      font-size: var(--font-h4-size);
      line-height: var(--font-h4-line-height);
    }

    .main-collection__promotion-content .button {
      min-height: 36px;
    }

    .main-collection__pagination {
      min-height: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-collection__products,
    .main-collection__promotion-image,
    .main-collection__sort-trigger,
    .main-collection__sort-trigger svg,
    .main-collection__sort-radio::before,
    .main-collection__filter-backdrop-pointer,
    .main-collection__filter-group summary svg,
    .main-collection__filter-dialog[open],
    .main-collection__filter-dialog[open]::backdrop,
    .main-collection__filter-dialog.is-closing,
    .main-collection__filter-dialog.is-closing::backdrop {
      transition: none;
      animation: none;
    }
  }
