  }

  .main-collection__price-slider input[type='range']:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--color-heading);
    outline-offset: 3px;
  }

  .main-collection__price-slider input[type='range']:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--color-heading);
    outline-offset: 3px;
  }

  .main-collection__price-fields {
