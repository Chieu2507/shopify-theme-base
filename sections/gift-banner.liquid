{% render 'section-stylesheet', asset: 'section-gift-banner.css' %}

{% liquid
  assign gift_banner_background = section.settings.background_color
  if gift_banner_background == blank
    assign gift_banner_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif

  assign gift_banner_image = section.settings.image
  if request.page_type == 'product' and section.settings.mobile_image != blank
    assign gift_banner_mobile_image = section.settings.mobile_image
  else
    assign gift_banner_mobile_image = gift_banner_image
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} { background: {{ gift_banner_background }}; }
{% endstyle %}

<div
  class="gift-banner color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} gift-banner--full full-width{% endif %}"
  style="--gift-banner-height: {{ section.settings.desktop_height }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="gift-banner__inner section-spacing">
    <div class="gift-banner__media" aria-hidden="true">
      {% if gift_banner_image != blank %}
        {{ gift_banner_image | image_url: width: 2400 | image_tag: class: 'gift-banner__image gift-banner__image--desktop', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'lazy' }}
        {% if gift_banner_mobile_image != blank %}
          {{ gift_banner_mobile_image | image_url: width: 1200 | image_tag: class: 'gift-banner__image gift-banner__image--mobile', widths: '500, 750, 1000, 1200', sizes: '100vw', loading: 'lazy' }}
        {% endif %}
      {% else %}
        <img class="gift-banner__image gift-banner__image--desktop" src="{{ 'gift-spinel-editorial.jpg' | asset_url }}" alt="" width="1600" height="2000" loading="lazy">
        <img class="gift-banner__image gift-banner__image--mobile" src="{{ 'gift-spinel-editorial.jpg' | asset_url }}" alt="" width="1600" height="2000" loading="lazy">
      {% endif %}
    </div>

    <div class="gift-banner__content" data-reveal-group>
      {% if section.settings.eyebrow != blank %}
        <p class="gift-banner__eyebrow" data-reveal-item style="--reveal-order: 0;">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="gift-banner__heading" data-reveal-item style="--reveal-order: 1;">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      <div class="gift-banner__ornament" aria-hidden="true"><span></span></div>
      {% if section.settings.text != blank %}
        <div class="gift-banner__text rte" data-reveal-item style="--reveal-order: 2;">{{ section.settings.text }}</div>
      {% endif %}
      <div class="gift-banner__cta" data-reveal-item style="--reveal-order: 3;">
        {% render 'cta', label: section.settings.button_label, url: section.settings.button_link, style: 'secondary', class: 'gift-banner__button', icon: 'none' %}
      </div>

      <div class="gift-banner__details" data-reveal-group>
        {% for index in (1..3) %}
          {% liquid
            assign detail_number_key = 'detail_' | append: index | append: '_number'
            assign detail_heading_key = 'detail_' | append: index | append: '_heading'
            assign detail_text_key = 'detail_' | append: index | append: '_text'
            assign detail_number = section.settings[detail_number_key]
            assign detail_heading = section.settings[detail_heading_key]
            assign detail_text = section.settings[detail_text_key]
          %}
          {% if detail_heading != blank or detail_text != blank %}
            <div class="gift-banner__detail" data-reveal-item style="--reveal-order: {{ index | minus: 1 }};">
              {% if detail_number != blank %}<p class="gift-banner__detail-number">{{ detail_number | escape }}</p>{% endif %}
              {% if detail_heading != blank %}<h3 class="gift-banner__detail-heading">{{ detail_heading | escape }}</h3>{% endif %}
              {% if detail_text != blank %}<p class="gift-banner__detail-text">{{ detail_text | escape }}</p>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift banner",
  "tag": "section",
  "class": "section-gift-banner",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The art of giving" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every piece arrives as a gift" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Presentation considered to the final detail.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover gifting" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "header", "content": "Detail 1" },
    { "type": "text", "id": "detail_1_number", "label": "Number", "default": "01" },
    { "type": "text", "id": "detail_1_heading", "label": "Heading", "default": "The case" },
    { "type": "text", "id": "detail_1_text", "label": "Text", "default": "Espresso leather, oxblood velvet." },
    { "type": "header", "content": "Detail 2" },
    { "type": "text", "id": "detail_2_number", "label": "Number", "default": "02" },
    { "type": "text", "id": "detail_2_heading", "label": "Heading", "default": "The ribbon" },
    { "type": "text", "id": "detail_2_text", "label": "Text", "default": "Hand-tied in house rose." },
    { "type": "header", "content": "Detail 3" },
    { "type": "text", "id": "detail_3_number", "label": "Number", "default": "03" },
    { "type": "text", "id": "detail_3_heading", "label": "Heading", "default": "The card" },
    { "type": "text", "id": "detail_3_text", "label": "Text", "default": "Your words, set by the atelier." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }], "default": "full" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 360, "max": 680, "step": 20, "unit": "px", "default": 480 },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "color", "id": "background_color", "label": "Background color", "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme." },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    { "name": "Gift banner", "category": "Editorial content" }
  ]
}
{% endschema %}
