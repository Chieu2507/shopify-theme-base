<footer class="section-color-scope {{ section.settings.color_scheme | default: 'scheme-1' }}">
  <div class="footer__copyright">
    &copy;
    {{ 'now' | date: '%Y' }}
    {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}
  </div>

  <div class="footer__links">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="footer__payment">
    {% if section.settings.show_payment_icons %}
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag }}
      {% endfor %}
    {% endif %}
  </div>

  {% render 'social-links' %}
</footer>

{% stylesheet %}
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }
  footer a {
    text-decoration: none;
    color: var(--body-color);
  }
  footer .footer__links,
  footer .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  footer .footer__links a {
    border-radius: var(--navigation-radius);
  }
  footer .social-links {
    margin-inline-start: auto;
  }
  @media (max-width: 767.98px) {
    footer {
      align-items: flex-start;
      flex-direction: column;
    }
    footer .social-links {
      margin-inline-start: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
