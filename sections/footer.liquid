{% render 'section-stylesheet', asset: 'section-footer.css', defer_on_home: true %}

{% liquid
  assign localization_form_id = 'FooterLocalizationForm-' | append: section.id
  assign copyright_name = section.settings.copyright_name
  if copyright_name == blank
    assign copyright_name = shop.name
  endif
%}

<footer-house
  class="footer-house color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  data-deferred-module="{{ 'section-footer.js' | asset_url }}"
>
  <footer
    class="footer"
    style="
      --footer-padding-top: {{ section.settings.padding_top }}px;
      --footer-padding-bottom: {{ section.settings.padding_bottom }}px;
      --footer-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --footer-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    "
  >
    <div class="footer__inner">
      {% content_for 'block', type: '_footer-intro', id: 'intro' %}

      <nav class="footer__menus" aria-label="{{ 'footer.navigation' | t | escape }}">
        {% content_for 'blocks' %}
      </nav>

      {% content_for 'block', type: '_footer-signature', id: 'signature' %}

      <div class="footer__utility">
        <div class="footer__utility-start">
          {% if section.settings.location_label != blank or section.settings.show_country_selector or section.settings.show_language_selector %}
            <footer-localization class="footer__localization">
              {% form 'localization', id: localization_form_id %}
                <div class="footer__region">
                  {% if section.settings.location_label != blank %}
                    <span>{{ section.settings.location_label | escape }}</span>
                  {% endif %}

                  {% if section.settings.show_country_selector %}
                    {% if section.settings.location_label != blank %}<span class="footer__utility-divider" aria-hidden="true">/</span>{% endif %}
                    {% if localization.available_countries.size > 1 %}
                      <label class="visually-hidden" for="FooterCountry-{{ section.id }}">{{ 'footer.country_region' | t }}</label>
                      <span class="footer__localization-select">
                        <select id="FooterCountry-{{ section.id }}" name="country_code" data-footer-localization-select>
                          {% for country in localization.available_countries %}
                            <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                              {{ country.name | escape }} / {{ country.currency.iso_code | escape }}
                            </option>
                          {% endfor %}
                        </select>
                        <span class="footer__localization-select-icon" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
                      </span>
                    {% else %}
                      <span>{{ localization.country.name | escape }} / {{ localization.country.currency.iso_code | escape }}</span>
                    {% endif %}
                  {% endif %}

                  {% if section.settings.show_language_selector and localization.available_languages.size > 1 %}
                    <span class="footer__utility-divider" aria-hidden="true">/</span>
                    <label class="visually-hidden" for="FooterLanguage-{{ section.id }}">{{ 'footer.language' | t }}</label>
                    <span class="footer__localization-select">
                      <select id="FooterLanguage-{{ section.id }}" name="locale_code" data-footer-localization-select>
                        {% for language in localization.available_languages %}
                          <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                            {{ language.endonym_name | capitalize | escape }}
                          </option>
                        {% endfor %}
                      </select>
                      <span class="footer__localization-select-icon" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
                    </span>
                  {% endif %}
                </div>
                <noscript><button type="submit">{{ 'footer.apply' | t }}</button></noscript>
              {% endform %}
            </footer-localization>
          {% endif %}
        </div>

        <div class="footer__copyright">
          &copy; {{ copyright_name | escape }} {{ 'now' | date: '%Y' }} <span aria-hidden="true">·</span> {{ powered_by_link }}
        </div>

        <div class="footer__utility-end">
          {% if section.settings.legal_menu != blank and section.settings.legal_menu.links.size > 0 %}
            <nav class="footer__legal" aria-label="{{ 'footer.legal' | t | escape }}">
              {% for link in section.settings.legal_menu.links %}
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {% endfor %}
            </nav>
          {% elsif shop.policies.size > 0 %}
            <nav class="footer__legal" aria-label="{{ 'footer.legal' | t | escape }}">
              {% for policy in shop.policies %}
                {% if policy.url != blank and policy.body != blank %}
                  <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                {% endif %}
              {% endfor %}
            </nav>
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <div class="footer__payments" aria-label="{{ 'footer.payment_methods' | t | escape }}">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.show_follow_on_shop %}
        <div class="footer__follow-on-shop">
          {{ shop | login_button: action: 'follow' }}
        </div>
      {% endif %}
    </div>
  </footer>
</footer-house>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 24
    },
    {
      "type": "header",
      "content": "Store utilities"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Location label",
      "default": "New York"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country/currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "default": false
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "info": "Uses the shop name when left blank.",
      "default": "SPINEL"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "Show Follow on Shop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "footer-menu"
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "category": "Theme layout",
      "blocks": [
        {
          "type": "_footer-intro",
          "id": "intro",
          "static": true,
          "settings": {},
          "blocks": [
            {
              "type": "_footer-newsletter",
              "id": "newsletter",
              "static": true,
              "blocks": [
            {
              "type": "heading",
              "id": "newsletter_eyebrow",
              "name": "t:names.subheading",
              "static": true,
              "settings": {
                "heading": "<p>PRIVATE NOTES / OCCASIONAL LETTERS</p>",
                "type_preset": "subheading",
                "color": "subtext"
              }
            },
            {
              "type": "heading",
              "id": "newsletter_heading",
              "static": true,
              "settings": {
                "heading": "<h2>Keep close to<br>what endures.</h2>",
                "type_preset": "h1"
              }
            },
            {
              "type": "text",
              "id": "newsletter_text",
              "static": true,
              "settings": {
                "text": "<p>Private notes on new stones, atelier work and appointments—sent only when there is something worth sharing.</p>",
                "type_preset": "paragraph",
                "color": "subtext"
              }
            },
            {
              "type": "newsletter-form",
              "id": "newsletter_form",
              "static": true,
              "settings": {
                "email_label": "Email address",
                "email_placeholder": "YOUR EMAIL ADDRESS",
                "hide_label": true,
                "show_required_marker": false,
                "button_label": "JOIN THE LIST",
                "button_style": "primary",
                "form_layout": "inline",
                "success_message": "Thank you for subscribing."
              }
            },
            {
              "type": "heading",
              "id": "newsletter_note",
              "name": "t:names.subheading",
              "static": true,
              "settings": {
                "heading": "<p>OCCASIONAL LETTERS. UNSUBSCRIBE AT ANY TIME.</p>",
                "type_preset": "subheading",
                "color": "subtext"
              }
            }
              ]
            },
            {
              "type": "_footer-appointment",
              "id": "appointment",
              "static": true,
              "blocks": [
            {
              "type": "heading",
              "id": "appointment_eyebrow",
              "name": "t:names.subheading",
              "static": true,
              "settings": {
                "heading": "<p>PRIVATE APPOINTMENTS</p>",
                "type_preset": "subheading",
                "color": "subtext"
              }
            },
            {
              "type": "heading",
              "id": "appointment_heading",
              "static": true,
              "settings": {
                "heading": "<h2>Discover Spinel,<br>one stone at a time.</h2>",
                "type_preset": "h2"
              }
            },
            {
              "type": "text",
              "id": "appointment_text",
              "static": true,
              "settings": {
                "text": "<p>Explore stones, proportions and settings with the house in a more personal conversation.</p>",
                "type_preset": "paragraph",
                "color": "subtext"
              }
            },
            {
              "type": "button",
              "id": "appointment_button",
              "static": true,
              "settings": {
                "label": "BOOK AN APPOINTMENT",
                "link": "/pages/contact",
                "style": "tertiary",
                "icon": "arrow-right"
              }
              }
              ]
            },
            {
              "type": "divider",
              "settings": {
                "thickness": 1,
                "length": 100,
                "disable_on_desktop": false,
                "disable_on_mobile": false,
                "padding_device": "desktop",
                "padding_top_desktop": 0,
                "padding_bottom_desktop": 6,
                "padding_top_mobile": 0,
                "padding_bottom_mobile": 40
              }
            }
          ]
        },
        {
          "type": "footer-menu",
          "settings": {
            "heading": "<h3>SHOP</h3>",
            "type_preset": "subheading",
            "menu": "footer-shop",
            "show_external_indicator": true
          }
        },
        {
          "type": "footer-menu",
          "settings": {
            "heading": "<h3>THE HOUSE</h3>",
            "type_preset": "subheading",
            "menu": "footer-about",
            "show_external_indicator": true
          }
        },
        {
          "type": "footer-menu",
          "settings": {
            "heading": "<h3>CLIENT CARE</h3>",
            "type_preset": "subheading",
            "menu": "footer-help",
            "show_external_indicator": true
          }
        },
        {
          "type": "footer-menu",
          "settings": {
            "heading": "<h3>CONNECT</h3>",
            "type_preset": "subheading",
            "menu": "footer",
            "show_external_indicator": true
          }
        },
        {
          "type": "_footer-signature",
          "id": "signature",
          "static": true,
          "blocks": [
            {
              "type": "heading",
              "id": "signature_eyebrow",
              "name": "t:names.subheading",
              "static": true,
              "settings": {
                "heading": "<p>THE HOUSE OF SPINEL / NEW YORK</p>",
                "type_preset": "subheading",
                "color": "subtext"
              }
            },
            {
              "type": "heading",
              "id": "signature_wordmark",
              "static": true,
              "settings": {
                "heading": "<p>SPINEL</p>",
                "type_preset": "h1",
                "width": "100%",
                "width_mobile": "100%"
              }
            },
            {
              "type": "heading",
              "id": "signature_principles",
              "name": "t:names.subheading",
              "static": true,
              "settings": {
                "heading": "<p>NATURAL STONES<br>SCULPTURAL GOLD<br>MADE WITH INTENT</p>",
                "type_preset": "subheading",
                "color": "subtext"
              }
            },
            {
              "type": "heading",
              "id": "signature_tagline",
              "name": "t:names.subheading",
              "static": true,
              "settings": {
                "heading": "<p>OBJECTS OF COLOUR, CHARACTER AND CONSEQUENCE.</p>",
                "type_preset": "subheading",
                "color": "subtext"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
