{% render 'section-stylesheet', asset: 'section-footer.css', defer_on_home: true %}

{% liquid
  assign newsletter_count = 0
  assign menu_count = 0
  assign localization_form_id = 'FooterLocalizationForm-' | append: section.id

  for block in section.blocks
    if block.type == 'newsletter'
      assign newsletter_count = newsletter_count | plus: 1
    elsif block.type == 'menu'
      assign menu_count = menu_count | plus: 1
    endif
  endfor
%}

{% if section.blocks.size > 0 %}
<footer
  class="footer color-scheme color-{{ section.settings.color_scheme.id }} full-width"
  style="--footer-padding-top: {{ section.settings.padding_top }}px; --footer-padding-bottom: {{ section.settings.padding_bottom }}px; --footer-column-gap: {{ section.settings.column_gap }}px;"
  data-deferred-module="{{ 'section-footer.js' | asset_url }}"
>
  <div class="footer__inner{% if section.settings.section_width == 'page' %} footer__inner--page{% endif %}">
    {% if newsletter_count > 0 or menu_count > 0 %}
      <div class="footer__top{% if newsletter_count == 0 %} footer__top--menus-only{% endif %}">
        {% for block in section.blocks %}
          {% if block.type == 'newsletter' %}
            <div class="footer__newsletter" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <{{ block.settings.heading_tag | default: 'h2' }} class="footer__heading spinel-heading--{{ block.settings.heading_size | default: 'lg' }} heading--{{ block.settings.heading_size | default: 'lg' }}">{{ block.settings.heading | escape }}</{{ block.settings.heading_tag | default: 'h2' }}>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="footer__newsletter-text rte spinel-text--{{ block.settings.text_size | default: 'medium' }} content-text--{{ block.settings.text_size | default: 'medium' }}">{{ block.settings.text }}</div>
              {% endif %}

              {% form 'customer', class: 'footer__newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="footer__newsletter-field">
                  <label class="footer__visually-hidden" for="FooterNewsletter-{{ section.id }}-{{ block.id }}">
                    {{ 'footer.email' | t }}
                  </label>
                  <input
                    id="FooterNewsletter-{{ section.id }}-{{ block.id }}"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email | escape }}"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    aria-required="true"
                    required
                  >
                  <button type="submit" aria-label="{{ block.settings.button_label | escape }}">
                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                      <path d="M3 10h13M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>

                {% if form.posted_successfully? %}
                  <p class="footer__form-message" tabindex="-1">{{ 'footer.newsletter_success' | t }}</p>
                {% endif %}

                {% if form.errors %}
                  <div class="footer__form-message footer__form-message--error" role="alert">
                    {{ form.errors | default_errors }}
                  </div>
                {% endif %}
              {% endform %}

              {% if block.settings.disclaimer != blank %}
                <div class="footer__disclaimer rte spinel-text--{{ block.settings.text_size | default: 'medium' }} content-text--{{ block.settings.text_size | default: 'medium' }}">{{ block.settings.disclaimer }}</div>
              {% endif %}

              {% if block.settings.facebook_url != blank or block.settings.instagram_url != blank or block.settings.pinterest_url != blank or block.settings.tiktok_url != blank %}
                <div class="footer__social" role="group" aria-label="{{ 'footer.social_links' | t | escape }}">
                  {% if block.settings.facebook_url != blank %}
                    <a href="{{ block.settings.facebook_url }}" aria-label="{{ 'announcement_bar.facebook' | t | escape }}">
                      {% render 'social-icon', name: 'facebook' %}
                    </a>
                  {% endif %}
                  {% if block.settings.instagram_url != blank %}
                    <a href="{{ block.settings.instagram_url }}" aria-label="{{ 'announcement_bar.instagram' | t | escape }}">
                      {% render 'social-icon', name: 'instagram' %}
                    </a>
                  {% endif %}
                  {% if block.settings.pinterest_url != blank %}
                    <a href="{{ block.settings.pinterest_url }}" aria-label="{{ 'announcement_bar.pinterest' | t | escape }}">
                      {% render 'social-icon', name: 'pinterest' %}
                    </a>
                  {% endif %}
                  {% if block.settings.tiktok_url != blank %}
                    <a href="{{ block.settings.tiktok_url }}" aria-label="{{ 'footer.tiktok' | t | escape }}">
                      {% render 'social-icon', name: 'tiktok' %}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        {% if menu_count > 0 %}
          <nav class="footer__menus" aria-label="{{ 'footer.navigation' | t | escape }}">
            {% for block in section.blocks %}
              {% if block.type == 'menu' %}
                <div class="footer__menu" {{ block.shopify_attributes }}>
                  {% liquid
                    assign menu_heading = block.settings.heading
                    if menu_heading == blank
                      assign menu_heading = block.settings.menu.title
                    endif
                  %}
                  {% if menu_heading != blank %}
                    <{{ block.settings.heading_tag | default: 'h3' }} class="footer__menu-heading spinel-heading--{{ block.settings.heading_size | default: 'medium' }} heading--{{ block.settings.heading_size | default: 'medium' }}">{{ menu_heading | escape }}</{{ block.settings.heading_tag | default: 'h3' }}>
                  {% endif %}
                  {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
                    <ul role="list">
                      {% for link in block.settings.menu.links %}
                        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </nav>
        {% endif %}
      </div>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == 'wordmark' %}
        {% liquid
          assign wordmark = block.settings.text
          if wordmark == blank
            assign wordmark = shop.name
          endif
        %}
        <div
          class="footer__wordmark"
          data-wordmark="{{ wordmark | escape }}"
          style="--footer-wordmark-size-desktop: {{ block.settings.font_size_desktop | default: 164 }}px; --footer-wordmark-size-mobile: {{ block.settings.font_size_mobile | default: 72 }}px;"
          aria-hidden="true"
          {{ block.shopify_attributes }}
        ></div>
      {% endif %}
    {% endfor %}

    <div class="footer__bottom">
      <div class="footer__bottom-start">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'copyright' %}
              <div class="footer__copyright" {{ block.shopify_attributes }}>
                &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if block.settings.text != blank %}. {{ block.settings.text | escape }}{% endif %}
              </div>

            {% when 'localization' %}
              {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
                <footer-localization class="footer__localization" {{ block.shopify_attributes }}>
                  {% form 'localization', id: localization_form_id %}
                    {% if block.settings.show_country_selector and localization.available_countries.size > 1 %}
                      <label class="footer__visually-hidden" for="FooterCountry-{{ section.id }}">{{ 'footer.country_region' | t }}</label>
                      <span class="footer__localization-select">
                        <select id="FooterCountry-{{ section.id }}" name="country_code" data-footer-localization-select>
                          {% for country in localization.available_countries %}
                            <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                              {{ country.currency.iso_code | escape }}
                            </option>
                          {% endfor %}
                        </select>
                        <span class="footer__localization-select-icon" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
                      </span>
                    {% endif %}

                    {% if block.settings.show_language_selector and localization.available_languages.size > 1 %}
                      <label class="footer__visually-hidden" for="FooterLanguage-{{ section.id }}">{{ 'footer.language' | t }}</label>
                      <span class="footer__localization-select">
                        <select id="FooterLanguage-{{ section.id }}" name="locale_code" data-footer-localization-select>
                          {% for language in localization.available_languages %}
                            <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                              {{ language.endonym_name | capitalize | escape }}
                            </option>
                          {% endfor %}
                        </select>
                        <span class="footer__localization-select-icon" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
                      </span>
                    {% endif %}
                    <noscript><button type="submit">{{ 'footer.apply' | t }}</button></noscript>
                  {% endform %}
                </footer-localization>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>

      <div class="footer__bottom-end">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'legal_menu' %}
              {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
                <nav class="footer__legal" aria-label="{{ 'footer.legal' | t | escape }}" {{ block.shopify_attributes }}>
                  {% for link in block.settings.menu.links %}
                    <a href="{{ link.url }}">{{ link.title | escape }}</a>
                  {% endfor %}
                </nav>
              {% elsif shop.policies.size > 0 %}
                <nav class="footer__legal" aria-label="{{ 'footer.legal' | t | escape }}" {{ block.shopify_attributes }}>
                  {% for policy in shop.policies %}
                    {% if policy.url != blank and policy.body != blank %}
                      <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                    {% endif %}
                  {% endfor %}
                </nav>
              {% endif %}

            {% when 'payments' %}
              {% if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
                <div class="footer__payment" aria-label="{{ 'footer.payment_methods' | t | escape }}" {{ block.shopify_attributes }}>
                  {% for type in shop.enabled_payment_types %}
                    {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
                  {% endfor %}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
        <div class="footer__follow-on-shop">
          {{ shop | login_button: action: 'follow' }}
        </div>
      </div>
    </div>
  </div>
</footer>
{% endif %}




