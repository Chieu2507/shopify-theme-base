            "type_preset": "subheading",
            "color": "subtext"
          }
        },
        {
          "type": "heading",
          "id": "signature_wordmark",
          "static": true,
          "settings": {
            "heading": "<p>SPINEL</p>",
            "type_preset": "h1",
            "width": "100%",
            "width_mobile": "100%"
          }
        },
        {
          "type": "text",
          "id": "signature_principles",
          "static": true,
          "settings": {
            "text": "<p>NATURAL STONES<br>SCULPTURAL GOLD<br>MADE WITH INTENT</p>",
            "type_preset": "subheading",
            "color": "subtext"
          }
        },
        {
          "type": "text",
          "id": "signature_tagline",
          "static": true,
          "settings": {
            "text": "<p>OBJECTS OF COLOUR, CHARACTER AND CONSEQUENCE.</p>",
            "type_preset": "subheading",
            "color": "subtext"
          }
        }
      ]
    }
  ]
}
{% endschema %}
