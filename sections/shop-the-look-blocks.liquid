{% render 'section-stylesheet', asset: 'section-shop-the-look.css', defer_on_home: true %}

{% content_for 'blocks' %}

{% liquid
  assign hotspot_blocks = section.blocks | where: 'type', '_shop-the-look-hotspot'
  assign product_block_count = hotspot_blocks.size
%}

{% if product_block_count > 0 %}
  <shop-the-look
    id="ShopTheLook-{{ section.id }}"
    data-deferred-module="{{ 'shop-the-look.js' | asset_url }}"
    class="shop-the-look shop-the-look--blocks color-scheme color-{{ section.settings.color_scheme.id }} full-width shop-the-look--media-{{ section.settings.media_position }}"
    style="--shop-the-look-height: {{ section.settings.height_desktop }}px; --shop-the-look-height-mobile: {{ section.settings.height_mobile }}px; --shop-the-look-content-padding: {{ section.settings.content_padding }}px; --shop-the-look-product-image-size: {{ section.settings.product_image_size }}px;"
  >
    <div class="shop-the-look__layout">
      <div class="shop-the-look__media-column">
        <div class="shop-the-look__visual">
          {% content_for 'block', type: '_shop-the-look-media', id: 'editorial_media' %}

          <div class="shop-the-look__hotspots" role="tablist" aria-label="{{ 'shop_the_look.products' | t | escape }}">
            {% for hotspot_block in hotspot_blocks %}
              {% liquid
                assign hotspot_label = hotspot_block.settings.product.title
                assign mobile_hotspot_x = hotspot_block.settings.horizontal_position
                assign mobile_hotspot_y = hotspot_block.settings.vertical_position

                if hotspot_block.settings.enable_mobile_position
                  assign mobile_hotspot_x = hotspot_block.settings.mobile_horizontal_position
                  assign mobile_hotspot_y = hotspot_block.settings.mobile_vertical_position
                endif

                if hotspot_label == blank
                  assign hotspot_label = 'shop_the_look.product' | t
                endif
              %}
              <button
                class="shop-the-look__hotspot"
                type="button"
                role="tab"
                id="ShopTheLookHotspot-{{ section.id }}-{{ hotspot_block.id }}"
                aria-controls="ShopTheLookProduct-{{ section.id }}-{{ hotspot_block.id }}"
                aria-label="{{ 'shop_the_look.select_product' | t: product: hotspot_label | escape }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                style="--hotspot-x: {{ hotspot_block.settings.horizontal_position }}%; --hotspot-y: {{ hotspot_block.settings.vertical_position }}%; --hotspot-mobile-x: {{ mobile_hotspot_x }}%; --hotspot-mobile-y: {{ mobile_hotspot_y }}%;"
                data-shop-the-look-hotspot
                data-block-id="{{ hotspot_block.id }}"
              >
                <span aria-hidden="true"></span>
              </button>
            {% endfor %}
          </div>
        </div>

        <div class="shop-the-look__mobile-preview" aria-live="polite" aria-atomic="true">
          {% for hotspot_block in hotspot_blocks %}
            {% liquid
              assign preview_product = hotspot_block.settings.product
              assign preview_variant = preview_product.selected_or_first_available_variant
              assign preview_placeholder_index = forloop.index0 | modulo: 6 | plus: 1
              assign preview_placeholder_asset_index = preview_placeholder_index | minus: 1 | modulo: 4 | plus: 1
              assign preview_placeholder_asset = 'placeholder-image-product-' | append: preview_placeholder_asset_index | append: '.svg'
            %}
            <a
              class="shop-the-look__mobile-preview-card"
              href="{{ preview_product.url | default: '#' }}"
              data-shop-the-look-preview
              data-block-id="{{ hotspot_block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              <span class="shop-the-look__mobile-preview-media">
                {% if preview_product != blank and preview_product.featured_image != blank %}
                  {% render 'responsive-image',
                    image: preview_product.featured_image,
                    max_width: 160,
                    widths: '80, 120, 160',
                    sizes: '64px',
                    class: 'shop-the-look__mobile-preview-image',
                    loading: 'lazy',
                    alt: preview_product.featured_image.alt
                  %}
                {% else %}
                  {% render 'media-placeholder', class_name: 'shop-the-look__mobile-preview-placeholder', asset_name: preview_placeholder_asset %}
                {% endif %}
              </span>
              <span class="shop-the-look__mobile-preview-details">
                <span class="shop-the-look__mobile-preview-title">
                  {% if preview_product != blank %}
                    {{ preview_product.title | escape }}
                  {% else %}
                    {{ 'onboarding.product_title' | t }}
                  {% endif %}
                </span>
                <span class="shop-the-look__mobile-preview-price{% if preview_variant.compare_at_price > preview_variant.price %} shop-the-look__mobile-preview-price--sale{% endif %}">
                  {% render 'money', amount: preview_variant.price %}
                </span>
              </span>
              <svg class="shop-the-look__mobile-preview-arrow" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m7.5 4.5 5 5.5-5 5.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {% endfor %}
        </div>
      </div>

      <div class="shop-the-look__content-column">
        <div class="shop-the-look__header">
          {% content_for 'block', type: 'group', id: 'content_group' %}
        </div>

        <div class="shop-the-look__spotlight">
          {% if product_block_count > 1 %}
            <button class="shop-the-look__arrow shop-the-look__arrow--previous" type="button" aria-label="{{ 'shop_the_look.previous_product' | t | escape }}" data-shop-the-look-previous>
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m12.5 4.5-5 5.5 5 5.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {% endif %}

          <div class="shop-the-look__products swiper" data-shop-the-look-slider>
            <div class="swiper-wrapper">
              {% for hotspot_block in hotspot_blocks %}
                <div
                  class="shop-the-look__product-slide swiper-slide"
                  id="ShopTheLookProduct-{{ section.id }}-{{ hotspot_block.id }}"
                  role="tabpanel"
                  aria-labelledby="ShopTheLookHotspot-{{ section.id }}-{{ hotspot_block.id }}"
                  data-shop-the-look-product
                  data-block-id="{{ hotspot_block.id }}"
                  {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
                  {{ hotspot_block.shopify_attributes }}
                >
                  {% render 'product-card',
                    product: hotspot_block.settings.product,
                    placeholder_index: forloop.index,
                    sizes: '(max-width: 749px) 48vw, (min-width: 990px) 360px, 44vw',
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true
                  %}
                </div>
              {% endfor %}
            </div>
          </div>

          {% if product_block_count > 1 %}
            <button class="shop-the-look__arrow shop-the-look__arrow--next" type="button" aria-label="{{ 'shop_the_look.next_product' | t | escape }}" data-shop-the-look-next>
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m7.5 4.5 5 5.5-5 5.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {% endif %}
        </div>

        {% if product_block_count > 1 %}
          <div class="shop-the-look__indicators" aria-hidden="true">
            {% for hotspot_block in hotspot_blocks %}
              <span class="shop-the-look__indicator{% if forloop.first %} shop-the-look__indicator--active{% endif %}" data-shop-the-look-indicator></span>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </shop-the-look>
{% endif %}

{% stylesheet %}
  .shop-the-look--blocks .shop-the-look__header > .spinel-group,
  .shop-the-look--blocks .shop-the-look__header > .shopify-block,
  .shop-the-look--blocks .shop-the-look__header > .shopify-block > .spinel-group {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop the look · Blocks",
  "tag": "section",
  "class": "section-shop-the-look",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Desktop media position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "product_image_size",
      "min": 160,
      "max": 360,
      "step": 20,
      "unit": "px",
      "label": "Product image size",
      "default": 240
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 24,
      "max": 96,
      "step": 8,
      "unit": "px",
      "label": "Content padding",
      "default": 48
    },
    {
      "type": "header",
      "content": "Section height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 640,
      "max": 1200,
      "step": 40,
      "unit": "px",
      "label": "Desktop",
      "default": 960
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 360,
      "max": 560,
      "step": 40,
      "unit": "px",
      "label": "Mobile content",
      "default": 440
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "_shop-the-look-media"
    },
    {
      "type": "group"
    },
    {
      "type": "_shop-the-look-hotspot"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "presets": [
    {
      "name": "Shop the look · Blocks",
      "category": "Image",
      "blocks": [
        {
          "type": "_shop-the-look-media",
          "id": "editorial_media",
          "static": true,
          "settings": {
            "focal_point": "center center",
            "mobile_focal_point": "center center"
          }
        },
        {
          "type": "group",
          "id": "content_group",
          "static": true,
          "settings": {
            "block_style": "group",
            "flow": "vertical",
            "stack_alignment": "center",
            "stack_distribution": "center",
            "gap": 8,
            "phone_flow": "vertical",
            "phone_alignment": "center",
            "phone_distribution": "center",
            "gap_mobile": 8,
            "desktop_width": "stretch",
            "phone_width": "stretch"
          },
          "blocks": [
            {
              "type": "subheading",
              "settings": {
                "text": "<p>Shop the look</p>",
                "type_preset": "subheading",
                "font": "subheading",
                "color": "text",
                "width": "fit-content",
                "width_mobile": "fit-content"
              }
            },
            {
              "type": "heading",
              "settings": {
                "heading": "<h2>Statement Stacks</h2>",
                "type_preset": "h3",
                "font": "heading",
                "color": "text",
                "width": "100%",
                "width_mobile": "100%",
                "alignment": "center"
              }
            }
          ]
        },
        {
          "type": "_shop-the-look-hotspot",
          "settings": {
            "horizontal_position": 40,
            "vertical_position": 35
          }
        },
        {
          "type": "_shop-the-look-hotspot",
          "settings": {
            "horizontal_position": 62,
            "vertical_position": 58
          }
        },
        {
          "type": "_shop-the-look-hotspot",
          "settings": {
            "horizontal_position": 50,
            "vertical_position": 76
          }
        }
      ]
    }
  ]
}
{% endschema %}
