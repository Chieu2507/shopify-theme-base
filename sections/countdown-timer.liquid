          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "mobile_row_gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Mobile row gap",
