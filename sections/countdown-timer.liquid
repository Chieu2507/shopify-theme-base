{% render 'section-stylesheet', asset: 'section-countdown-timer.css', defer_on_home: true %}

{% if section.blocks.size > 0 %}
  <section
    class="countdown-timer color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} countdown-timer--full full-width{% endif %} countdown-timer--mobile-{{ section.settings.mobile_alignment }}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --countdown-timer-column-gap: {{ section.settings.column_gap }}px; --countdown-timer-mobile-row-gap: {{ section.settings.mobile_row_gap }}px;"
    data-deferred-module="{{ 'section-countdown-timer.js' | asset_url }}"
  >
    <div class="countdown-timer__inner section-spacing">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% if block.settings.heading != blank %}
              <div class="countdown-timer__heading-block countdown-timer__heading">
                {% render 'content-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'xl', default_font: 'heading' %}
              </div>
            {% endif %}

          {% when 'text' %}
            {% if block.settings.text != blank %}
              <div class="countdown-timer__text">
                {% render 'content-block', block: block, content: block.settings.text, kind: 'text', default_preset: 'md', default_font: 'body' %}
              </div>
            {% endif %}

          {% when 'countdown' %}
            {% liquid
              assign countdown_is_configured = false
              assign countdown_is_preview = false

              if block.settings.end_at != blank
                assign countdown_is_configured = true
              elsif request.design_mode
                assign countdown_is_preview = true
              endif
            %}
            {% if countdown_is_configured or countdown_is_preview %}
              <countdown-timer
                class="countdown-timer__timer"
                {% if countdown_is_configured %}
                  data-end-at="{{ block.settings.end_at | escape }}"
                  data-show-completion-message="{{ block.settings.show_completion_message }}"
                {% else %}
                  data-countdown-preview
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <time
                  class="countdown-timer__units"
                  {% if countdown_is_configured %}datetime="{{ block.settings.end_at | escape }}"{% endif %}
                  data-countdown-units
                  aria-label="{{ block.settings.aria_label | escape }}"
                >
                  <span class="countdown-timer__unit">
                    <span class="countdown-timer__value" data-countdown-days>{% if countdown_is_preview %}02{% else %}00{% endif %}</span>
                    <span class="countdown-timer__label">{{ block.settings.days_label | escape }}</span>
                  </span>
                  <span class="countdown-timer__unit">
                    <span class="countdown-timer__value" data-countdown-hours>{% if countdown_is_preview %}16{% else %}00{% endif %}</span>
                    <span class="countdown-timer__label">{{ block.settings.hours_label | escape }}</span>
                  </span>
                  <span class="countdown-timer__unit">
                    <span class="countdown-timer__value" data-countdown-minutes>{% if countdown_is_preview %}23{% else %}00{% endif %}</span>
                    <span class="countdown-timer__label">{{ block.settings.minutes_label | escape }}</span>
                  </span>
                  <span class="countdown-timer__unit">
                    <span class="countdown-timer__value" data-countdown-seconds>{% if countdown_is_preview %}16{% else %}00{% endif %}</span>
                    <span class="countdown-timer__label">{{ block.settings.seconds_label | escape }}</span>
                  </span>
                </time>
                <p class="countdown-timer__complete" data-countdown-complete hidden aria-live="polite">
                  {{ block.settings.completion_message | escape }}
                </p>
              </countdown-timer>
            {% endif %}

          {% when 'button' %}
            {% if block.settings.label != blank and block.settings.link != blank %}
              <div class="countdown-timer__button-block" {{ block.shopify_attributes }}>
                {% render 'cta', label: block.settings.label, url: block.settings.link, style: block.settings.style %}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </section>
{% endif %}




{% schema %}
{
  "name": "Countdown timer",
  "tag": "section",
  "class": "section-countdown-timer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 64
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "mobile_row_gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Mobile row gap",
      "default": 28
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "t:typography_blocks.text",
          "default": "<h2>Explore Spinel</h2>"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.heading_size",
          "options": [
            { "value": "3xl", "label": "t:typography_options.display_extra_large" },
            { "value": "2xl", "label": "t:typography_options.display_large" },
            { "value": "xl", "label": "t:typography_options.display_medium" },
            { "value": "lg", "label": "t:typography_options.heading_extra_large" },
            { "value": "md", "label": "t:typography_options.heading_large" },
            { "value": "sm", "label": "t:typography_options.heading_medium" },
            { "value": "xs", "label": "t:typography_options.heading_small" },
            { "value": "2xs", "label": "t:typography_options.heading_extra_small" },
            { "value": "custom", "label": "t:typography_options.custom" }
          ],
          "default": "xl"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "t:typography_blocks.size",
          "min": 8,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 50,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "t:typography_blocks.mobile_size",
          "min": 8,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 30,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "color",
          "label": "t:typography_blocks.color",
          "options": [
            {
              "value": "text",
              "label": "t:typography_options.text"
            },
            {
              "value": "subtext",
              "label": "t:typography_options.subtext"
            }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:typography_blocks.text",
          "default": "<p>Discover jewelry designed for everyday wear.</p>"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.text_size",
          "options": [
            { "value": "lg", "label": "t:typography_options.body_large" },
            { "value": "md", "label": "t:typography_options.body_medium" },
            { "value": "sm", "label": "t:typography_options.body_small" },
            { "value": "xs", "label": "t:typography_options.body_extra_small" },
            { "value": "custom", "label": "t:typography_options.custom" }
          ],
          "default": "md"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "t:typography_blocks.size",
          "min": 8,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 16,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "t:typography_blocks.mobile_size",
          "min": 8,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 14,
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "color",
          "label": "t:typography_blocks.color",
          "options": [
            {
              "value": "text",
              "label": "t:typography_options.text"
            },
            {
              "value": "subtext",
              "label": "t:typography_options.subtext"
            }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Countdown"
        },
        {
          "type": "text",
          "id": "end_at",
          "label": "End date and time",
          "info": "Use ISO 8601 format, for example 2027-12-31T23:59:59+07:00"
        },
        {
          "type": "checkbox",
          "id": "show_completion_message",
          "label": "Show message",
          "default": true
        },
        {
          "type": "text",
          "id": "completion_message",
          "label": "Completion message",
          "default": "This offer has ended",
          "visible_if": "{{ block.settings.show_completion_message }}"
        },
        {
          "type": "header",
          "content": "Unit labels"
        },
        {
          "type": "text",
          "id": "days_label",
          "label": "Days label",
          "default": "Days"
        },
        {
          "type": "text",
          "id": "hours_label",
          "label": "Hours label",
          "default": "Hours"
        },
        {
          "type": "text",
          "id": "minutes_label",
          "label": "Minutes label",
          "default": "Minutes"
        },
        {
          "type": "text",
          "id": "seconds_label",
          "label": "Seconds label",
          "default": "Seconds"
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "Accessibility label",
          "default": "Promotion countdown"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "tertiary",
              "label": "Text link"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Countdown timer",
      "category": "Marketing",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "countdown"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
