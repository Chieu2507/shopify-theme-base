{% if section.blocks.size > 0 %}
  {% render 'section-stylesheet', asset: 'section-editorial-rich-text.css', defer_on_home: true %}
  <section
    class="noryvelle-pebble-rich-text full-width color-scheme color-{{ section.settings.color_scheme.id }}"
    style="--pebble-rich-padding-top: {{ section.settings.padding_top }}px; --pebble-rich-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="noryvelle-pebble-rich-text__container">
      <div class="noryvelle-pebble-rich-text__content">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'text' %}
              {% if block.settings.text != blank %}
                <span class="noryvelle-pebble-rich-text__text" {{ block.shopify_attributes }}>
                  {{ block.settings.text | escape }}
                </span>
              {% endif %}
            {% when 'image' %}
              <span
                class="noryvelle-pebble-rich-text__image"
                style="--pebble-chip-width: {{ block.settings.image_scale }}%; --pebble-chip-left: {{ block.settings.image_left }}%; --pebble-chip-top: {{ block.settings.image_top }}%;"
                aria-hidden="true"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.image != blank %}
                  {% render 'responsive-image',
                    image: block.settings.image,
                    max_width: 360,
                    widths: '62, 95, 112, 190, 224, 360',
                    sizes: '(min-width: 990px) 112px, (min-width: 750px) 95px, 62px',
                    class: 'noryvelle-pebble-rich-text__image-media',
                    decorative: true,
                    loading: 'lazy'
                  %}
                {% else %}
                  {% render 'media-placeholder',
                    class_name: 'noryvelle-pebble-rich-text__image-media noryvelle-pebble-rich-text__image-placeholder',
                    asset_name: 'placeholder-image-product-1.svg'
                  %}
                {% endif %}
              </span>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}


{% schema %}
{
  "name": "Editorial rich text",
  "tag": "section",
  "class": "section-pebble-rich-text",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Looks good."
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_scale",
          "min": 100,
          "max": 240,
          "step": 2,
          "unit": "%",
          "label": "Image scale",
          "default": 144
        },
        {
          "type": "range",
          "id": "image_left",
          "min": -100,
          "max": 100,
          "step": 2,
          "unit": "%",
          "label": "Horizontal offset",
          "default": -22
        },
        {
          "type": "range",
          "id": "image_top",
          "min": -120,
          "max": 80,
          "step": 2,
          "unit": "%",
          "label": "Vertical offset",
          "default": -102
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial rich text",
      "category": "Editorial content",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "Looks good."
          }
        },
        {
          "type": "image",
          "settings": {
            "image_scale": 144,
            "image_left": -22,
            "image_top": -102
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Feels amazing."
          }
        },
        {
          "type": "image",
          "settings": {
            "image_scale": 132,
            "image_left": -20,
            "image_top": -92
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Your edit,"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_scale": 130,
            "image_left": -14,
            "image_top": -80
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Your story."
          }
        }
      ]
    }
  ]
}
{% endschema %}
