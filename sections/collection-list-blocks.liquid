{% if request.page_type == 'collection' and request.design_mode == false %}
  <style>{{ 'section-collection-list.css' | inline_asset_content }}</style>
{% else %}
  {% render 'section-stylesheet', asset: 'section-collection-list.css', defer_on_home: true %}
{% endif %}
{% render 'swiper-stylesheet', defer_on_home: true %}

{% liquid
  assign split_height_desktop = 768
  assign split_height_tablet = 480
  case section.settings.height_desktop
    when 'small'
      assign split_height_desktop = 600
      assign split_height_tablet = 400
    when 'large'
      assign split_height_desktop = 920
      assign split_height_tablet = 560
  endcase

  assign split_height_mobile = 360
  case section.settings.height_mobile
    when 'small'
      assign split_height_mobile = 280
    when 'large'
      assign split_height_mobile = 480
  endcase
%}

{% capture collection_cards %}
  {% content_for 'blocks' %}
{% endcapture %}
{% assign collection_cards = collection_cards | strip %}

{% if collection_cards != blank %}
  <collection-list
    {% if section.settings.layout == 'grid' %}data-deferred-module="{{ 'collection-list.js' | asset_url }}"{% endif %}
    class="collection-list collection-list--{{ section.settings.layout }} collection-list--layout-desktop-{{ section.settings.layout_desktop | default: 'slider' }} collection-list--layout-tablet-{{ section.settings.layout_desktop | default: 'slider' }} collection-list--layout-mobile-{{ section.settings.layout_mobile | default: 'slider' }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
    data-section-id="{{ section.id }}"
    data-layout-desktop="{{ section.settings.layout_desktop | default: 'slider' }}"
    data-layout-tablet="{{ section.settings.layout_desktop | default: 'slider' }}"
    data-layout-mobile="{{ section.settings.layout_mobile | default: 'slider' }}"
    data-columns-desktop="{{ section.settings.columns_desktop }}"
    data-columns-tablet="{{ section.settings.columns_desktop }}"
    data-columns-mobile="{{ section.settings.columns_mobile }}"
    data-show-pagination="{{ section.settings.show_pagination }}"
    style="--collection-list-columns-desktop: {{ section.settings.columns_desktop }}; --collection-list-columns-tablet: {{ section.settings.columns_desktop }}; --collection-list-columns-mobile: {{ section.settings.columns_mobile }}; --collection-list-column-gap: {{ section.settings.column_gap }}px; --collection-list-header-gap: {{ section.settings.header_gap }}px; --collection-list-card-gap: {{ section.settings.card_gap }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --collection-list-height-desktop: {{ split_height_desktop }}px; --collection-list-height-tablet: {{ split_height_tablet }}px; --collection-list-height-mobile: {{ split_height_mobile }}px;"
  >
    <div class="collection-list__inner section-spacing{% if section.settings.section_width == 'page' %} collection-list__inner--page{% endif %}">
      {% if section.settings.show_header %}
        <div class="collection-list__header">
          {% content_for 'block', type: 'group', id: 'header' %}
        </div>
      {% endif %}

      <div class="collection-list__carousel">
        <div class="collection-list__slider{% if section.settings.layout == 'grid' %} swiper{% endif %}"{% if section.settings.layout == 'grid' %} data-collection-list-slider{% endif %}>
          <ul class="collection-list__grid collection-list__grid--{{ section.settings.layout }}{% if section.settings.layout == 'grid' %} swiper-wrapper{% endif %}" role="list">
            {{ collection_cards }}
          </ul>
        </div>

        {% if section.settings.layout == 'grid' %}
          <button
            class="collection-list__navigation-button collection-list__navigation-button--previous"
            type="button"
            aria-label="{{ 'collection_list.previous_item' | t | escape }}"
            data-collection-list-previous
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
              <path d="M14.5 5 7.5 12l7 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            class="collection-list__navigation-button collection-list__navigation-button--next"
            type="button"
            aria-label="{{ 'collection_list.next_item' | t | escape }}"
            data-collection-list-next
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
              <path d="m9.5 5 7 7-7 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% endif %}
      </div>

      {% if section.settings.layout == 'grid' and section.settings.show_pagination %}
        <div class="collection-list__pagination swiper-pagination" data-collection-list-pagination></div>
      {% endif %}
    </div>
  </collection-list>
{% endif %}

{% stylesheet %}
  .collection-list__header > .spinel-group {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:collection_list_blocks.name",
  "tag": "section",
  "class": "section-collection-list",
  "max_blocks": 7,
  "settings": [
    {
      "type": "header",
      "content": "t:collection_list_blocks.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:collection_list_blocks.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:collection_list_blocks.grid"
        },
        {
          "value": "split-promotions",
          "label": "t:collection_list_blocks.split_promotions"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:collection_list_blocks.section_width",
      "options": [
        {
          "value": "full",
          "label": "t:collection_list_blocks.full_width"
        },
        {
          "value": "page",
          "label": "t:collection_list_blocks.page_width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:collection_list_blocks.column_gap",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "t:collection_list_blocks.show_header",
      "default": true
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:collection_list_blocks.header_gap",
      "default": 48,
      "visible_if": "{{ section.settings.show_header }}"
    },
    {
      "type": "header",
      "content": "t:collection_list_blocks.grid_settings",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "t:collection_list_blocks.desktop_layout",
      "options": [
        {
          "value": "grid",
          "label": "t:collection_list_blocks.grid"
        },
        {
          "value": "slider",
          "label": "t:collection_list_blocks.slider"
        }
      ],
      "default": "slider",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "t:collection_list_blocks.mobile_layout",
      "options": [
        {
          "value": "grid",
          "label": "t:collection_list_blocks.grid"
        },
        {
          "value": "slider",
          "label": "t:collection_list_blocks.slider"
        }
      ],
      "default": "slider",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:collection_list_blocks.show_pagination",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:collection_list_blocks.desktop_columns",
      "default": 3,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:collection_list_blocks.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:collection_list_blocks.cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:collection_list_blocks.image_ratio",
      "options": [
        {
          "value": "portrait",
          "label": "t:collection_list_blocks.portrait"
        },
        {
          "value": "square",
          "label": "t:collection_list_blocks.square"
        },
        {
          "value": "landscape",
          "label": "t:collection_list_blocks.landscape"
        }
      ],
      "default": "portrait",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "t:collection_list_blocks.card_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:collection_list_blocks.left"
        },
        {
          "value": "center",
          "label": "t:collection_list_blocks.center"
        },
        {
          "value": "right",
          "label": "t:collection_list_blocks.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "t:collection_list_blocks.card_gap",
      "default": 20
    },
    {
      "type": "select",
      "id": "card_heading_size",
      "label": "t:collection_list_blocks.heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:collection_list_blocks.xx_large"
        },
        {
          "value": "h2",
          "label": "t:collection_list_blocks.x_large"
        },
        {
          "value": "h3",
          "label": "t:collection_list_blocks.large"
        },
        {
          "value": "h4",
          "label": "t:collection_list_blocks.medium"
        },
        {
          "value": "h5",
          "label": "t:collection_list_blocks.small"
        },
        {
          "value": "h6",
          "label": "t:collection_list_blocks.x_small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "card_heading_tag",
      "label": "t:collection_list_blocks.html_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "t:collection_list_blocks.split_heights",
      "visible_if": "{{ section.settings.layout == 'split-promotions' }}"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "t:collection_list_blocks.desktop_height",
      "options": [
        {
          "value": "small",
          "label": "t:collection_list_blocks.small"
        },
        {
          "value": "medium",
          "label": "t:collection_list_blocks.medium"
        },
        {
          "value": "large",
          "label": "t:collection_list_blocks.large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout == 'split-promotions' }}"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "t:collection_list_blocks.mobile_height",
      "options": [
        {
          "value": "small",
          "label": "t:collection_list_blocks.small"
        },
        {
          "value": "medium",
          "label": "t:collection_list_blocks.medium"
        },
        {
          "value": "large",
          "label": "t:collection_list_blocks.large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout == 'split-promotions' }}"
    },
    {
      "type": "header",
      "content": "t:collection_list_blocks.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "t:collection_list_blocks.top_padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:collection_list_blocks.bottom_padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:collection_list_blocks.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:collection_list_blocks.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "_collection-list-card"
    }
  ],
  "presets": [
    {
      "name": "t:collection_list_blocks.preset_grid",
      "category": "t:collection_list_blocks.category",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": {
            "block_style": "group",
            "flow": "vertical",
            "stack_alignment": "center",
            "stack_distribution": "center",
            "gap": 0,
            "phone_flow": "vertical",
            "phone_alignment": "center",
            "phone_distribution": "center",
            "gap_mobile": 0,
            "desktop_width": "stretch",
            "phone_width": "stretch"
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "t:collection_list_blocks.default_heading",
                "type_preset": "h2",
                "font": "heading",
                "width": "100%",
                "width_mobile": "100%",
                "alignment": "center"
              }
            }
          ]
        },
        {
          "type": "_collection-list-card",
          "settings": {
            "title": "t:collection_list_blocks.new_arrivals"
          }
        },
        {
          "type": "_collection-list-card",
          "settings": {
            "title": "t:collection_list_blocks.everyday_edit"
          }
        },
        {
          "type": "_collection-list-card",
          "settings": {
            "title": "t:collection_list_blocks.occasion_pieces"
          }
        }
      ]
    },
    {
      "name": "t:collection_list_blocks.preset_split",
      "category": "t:collection_list_blocks.category",
      "settings": {
        "layout": "split-promotions",
        "show_header": false,
        "header_gap": 0,
        "height_desktop": "medium",
        "height_mobile": "medium",
        "card_heading_size": "h3",
        "card_heading_tag": "h3"
      },
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": {
            "block_style": "group",
            "flow": "vertical",
            "desktop_width": "stretch",
            "phone_width": "stretch"
          }
        },
        {
          "type": "_collection-list-card",
          "settings": {
            "subheading": "t:collection_list_blocks.sale_up_to_20",
            "title": "t:collection_list_blocks.signature_edit",
            "button_label": "t:collection_list_blocks.shop_all",
            "overlay_opacity": 0
          }
        },
        {
          "type": "_collection-list-card",
          "settings": {
            "title": "t:collection_list_blocks.new_collection",
            "button_label": "t:collection_list_blocks.discover_more",
            "overlay_opacity": 25
          }
        }
      ]
    }
  ]
}
{% endschema %}
