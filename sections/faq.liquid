
<section class="faq color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}">
  <div class="faq__inner">
    {% if section.settings.heading != blank %}
      <h2 class="faq__title">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="faq__content">
      {% assign has_questions = false %}
      {% for block in section.blocks %}
        {% if block.type == 'group_heading' %}
          <div class="faq__group" id="faq-group-{{ block.settings.anchor_id | handleize }}" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <{{ block.settings.heading_tag | default: 'h3' }} class="faq__group-title">{{ block.settings.heading | escape }}</{{ block.settings.heading_tag | default: 'h3' }}>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="faq__group-description rte">{{ block.settings.description }}</div>
            {% endif %}
          </div>
        {% elsif block.type == 'question' %}
          {% assign has_questions = true %}
          <details class="faq__item"{% if block.settings.default_open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="faq__summary">
              <span class="faq__question">{{ block.settings.question | escape }}</span>
              <span class="faq__chevron" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
            </summary>
            {% if block.settings.answer != blank %}
              <div class="faq__answer rte">{{ block.settings.answer }}</div>
            {% endif %}
          </details>
        {% endif %}
      {% endfor %}

      {% unless has_questions %}
        <p class="faq__empty">{{ section.settings.empty_message | escape }}</p>
      {% endunless %}
    </div>
  </div>
</section>

{% stylesheet %}
  .faq { background: var(--gradient-background, var(--color-background)); }
  .faq__inner { width: min(100%, var(--page-width)); margin-inline: auto; padding: 64px var(--page-margin) 96px; }
  .faq__title { margin: 0 0 44px; text-align: center; font-size: clamp(32px, 4vw, 48px); line-height: 1.15; }
  .faq__content { width: min(100%, 760px); margin-inline: auto; }
  .faq__group { scroll-margin-top: 24px; margin: 56px 0 10px; }
  .faq__group:first-child { margin-top: 0; }
  .faq__group-title { margin: 0 0 28px; font-size: 28px; line-height: 1.2; }
  .faq__group-description { margin: -14px 0 28px; color: var(--color-text); line-height: 1.5; }
  .faq__item { border-bottom: 1px solid var(--color-variant-border); }
  .faq__item:first-of-type { border-top: 1px solid var(--color-variant-border); }
  .faq__summary { display: flex; min-height: 68px; align-items: center; justify-content: space-between; gap: 24px; padding: 18px 0; color: var(--color-heading); cursor: pointer; font-family: var(--font-heading--family); font-size: 16px; line-height: 1.4; list-style: none; }
  .faq__summary::-webkit-details-marker { display: none; }
  .faq__summary:focus-visible { outline: 2px solid currentcolor; outline-offset: 4px; }
  .faq__question { flex: 1 1 auto; }
  .faq__chevron { flex: 0 0 auto; transition: transform .2s ease; }
  .faq__chevron svg { width: 16px; height: 16px; }
  .faq__item[open] .faq__chevron { transform: rotate(180deg); }
  .faq__answer { padding: 0 44px 22px 0; color: var(--color-text); line-height: 1.6; }
  .faq__empty { color: var(--color-text); text-align: center; }
  @media screen and (max-width: 749px) {
    .faq__inner { padding-top: 48px; padding-bottom: 64px; }
    .faq__title { margin-bottom: 36px; }
    .faq__group-title { font-size: 24px; }
    .faq__summary { min-height: 60px; font-size: 15px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order & Shipping" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page" }, { "value": "full", "label": "Full width" }], "default": "full" },
    { "type": "text", "id": "empty_message", "label": "Empty state message", "default": "Add FAQ questions from the Theme Editor." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "group_heading",
      "name": "FAQ group heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Orders" },
        { "type": "select", "id": "heading_tag", "label": "HTML Tag", "options": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }], "default": "h3" },
        { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "orders" },
        { "type": "richtext", "id": "description", "label": "Description" }
      ]
    },
    {
      "type": "question",
      "name": "FAQ question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How can I track the status of my order?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Once your order ships, you will receive a confirmation email with a tracking link.</p>" },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "FAQ",
      "settings": { "heading": "Order & Shipping" },
      "blocks": [
        { "type": "group_heading", "settings": { "heading": "Orders", "anchor_id": "orders" } },
        { "type": "question", "settings": { "question": "How Can I Track The Status Of My Order?", "default_open": true } },
        { "type": "question", "settings": { "question": "How Do I Place An Order On Your Website?" } },
        { "type": "question", "settings": { "question": "Can I Change Or Cancel My Order After It’s Been Placed?" } },
        { "type": "question", "settings": { "question": "Do You Offer International Shipping For Orders Outside My Country?" } },
        { "type": "group_heading", "settings": { "heading": "Shipping", "anchor_id": "shipping" } },
        { "type": "question", "settings": { "question": "What Shipping Options Do You Offer?" } },
        { "type": "question", "settings": { "question": "How Can I Track My Shipment?" } },
        { "type": "question", "settings": { "question": "Do Gift Cards Expire?" } },
        { "type": "question", "settings": { "question": "Do You Offer Free Shipping?" } },
        { "type": "question", "settings": { "question": "What Should I Do If My Package Is Delayed Or Lost?" } }
      ]
    }
  ]
}
{% endschema %}
