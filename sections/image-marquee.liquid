{% if section.blocks.size > 0 %}
  {% render 'section-stylesheet', asset: 'section-image-marquee.css', defer_on_home: true %}
  <section
    class="noryvelle-pebble-marquee full-width color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.pause_on_hover %} noryvelle-pebble-marquee--pausable{% endif %}"
    style="--pebble-marquee-duration: {{ section.settings.speed }}s; --pebble-marquee-text: {{ section.settings.text_color }};"
    aria-label="{{ section.settings.aria_label | escape }}"
  >
    <div class="noryvelle-pebble-marquee__viewport">
      <div class="noryvelle-pebble-marquee__track">
        <div class="noryvelle-pebble-marquee__group">
          {% for block in section.blocks %}
            <div class="noryvelle-pebble-marquee__item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a class="noryvelle-pebble-marquee__text" href="{{ block.settings.link }}">
                  {{ block.settings.text | escape }}
                </a>
              {% else %}
                <span class="noryvelle-pebble-marquee__text">{{ block.settings.text | escape }}</span>
              {% endif %}
              <span class="noryvelle-pebble-marquee__image" aria-hidden="true">
                {% if block.settings.image != blank %}
                  {% render 'responsive-image',
                    image: block.settings.image,
                    max_width: 320,
                    widths: '64, 96, 128, 144, 192, 288, 320',
                    sizes: '(min-width: 990px) 144px, (min-width: 750px) 96px, 64px',
                    class: 'noryvelle-pebble-marquee__image-media',
                    decorative: true,
                    loading: 'lazy'
                  %}
                {% else %}
                  {% render 'media-placeholder',
                    class_name: 'noryvelle-pebble-marquee__image-media',
                    asset_name: 'placeholder-image-product-1.svg'
                  %}
                {% endif %}
              </span>
            </div>
          {% endfor %}
        </div>

        <div class="noryvelle-pebble-marquee__group" aria-hidden="true">
          {% for block in section.blocks %}
            <div class="noryvelle-pebble-marquee__item">
              <span class="noryvelle-pebble-marquee__text">{{ block.settings.text | escape }}</span>
              <span class="noryvelle-pebble-marquee__image">
                {% if block.settings.image != blank %}
                  {% render 'responsive-image',
                    image: block.settings.image,
                    max_width: 320,
                    widths: '64, 96, 128, 144, 192, 288, 320',
                    sizes: '(min-width: 990px) 144px, (min-width: 750px) 96px, 64px',
                    class: 'noryvelle-pebble-marquee__image-media',
                    decorative: true,
                    loading: 'lazy'
                  %}
                {% else %}
                  {% render 'media-placeholder',
                    class_name: 'noryvelle-pebble-marquee__image-media',
                    asset_name: 'placeholder-image-product-1.svg'
                  %}
                {% endif %}
              </span>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{% endif %}


{% schema %}
{
  "name": "Image marquee",
  "tag": "section",
  "class": "section-pebble-marquee",
  "max_blocks": 8,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Animation duration",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover or focus",
      "default": true
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Brand values"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#b3b3b3"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Text and image",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Timeless Appeal"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image marquee",
      "category": "Banners",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Timeless Appeal"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Effortless Elegance"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Quiet Confidence"
          }
        }
      ]
    }
  ]
}
{% endschema %}
