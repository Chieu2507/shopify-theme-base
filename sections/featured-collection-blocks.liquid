{% render 'section-stylesheet', asset: 'section-featured-collection-critical.css', inline_on_home: true %}
{% render 'swiper-stylesheet', defer_on_home: true %}

{% content_for 'blocks' %}

{% liquid
  assign tab_blocks = section.blocks | where: 'type', '_featured-collection-tab'
  assign promotion_blocks = section.blocks | where: 'type', '_featured-collection-promotion'
  assign promotion_block = promotion_blocks | first
  assign tab_count = tab_blocks.size
  assign promotion_position = promotion_block.settings.position | default: 'before'
  assign has_recently_viewed_source = false
  assign has_collection_source = false

  for tab_block in tab_blocks
    if tab_block.settings.source == 'recently_viewed'
      assign has_recently_viewed_source = true
    else
      assign has_collection_source = true
    endif
  endfor
%}

{% if section.settings.show_intro or promotion_block != blank or tab_count > 0 %}
  <featured-collection
    data-deferred-module="{{ 'featured-collection.js' | asset_url }}"
    data-product-id="{{ product.id }}"
    class="featured-collection featured-collection--slider color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}{% if promotion_block != blank %} featured-collection--has-promotion featured-collection--promotion-{{ promotion_position }}{% endif %}"
    data-desktop-columns="{{ section.settings.columns_desktop }}"
    data-mobile-columns="{{ section.settings.columns_mobile }}"
    data-has-recently-viewed-source="{{ has_recently_viewed_source }}"
    data-design-mode="{{ request.design_mode }}"
    data-products-to-show="{{ section.settings.products_to_show }}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --featured-collection-column-gap: {{ section.settings.column_gap }}px; --featured-collection-mobile-column-gap: {{ section.settings.mobile_column_gap }}px; --featured-collection-columns: {{ section.settings.columns_desktop }};"
    {% if has_recently_viewed_source and has_collection_source == false and request.design_mode == false %}hidden{% endif %}
  >
    <div class="featured-collection__inner section-spacing{% if section.settings.section_width == 'page' %} featured-collection__inner--page{% endif %}">
      {% if section.settings.show_intro or tab_count > 1 %}
        <div class="featured-collection__header{% if section.settings.show_intro %} featured-collection__header--with-intro{% endif %}{% if section.settings.show_intro and tab_count <= 1 %} featured-collection__header--centered{% endif %}">
          {% if section.settings.show_intro %}
            <div class="featured-collection__intro">
              {% content_for 'block', type: 'group', id: 'intro' %}
            </div>
          {% endif %}

          {% if tab_count > 1 %}
            <div
              class="featured-collection__tabs"
              role="tablist"
              aria-label="{{ 'featured_collection.tabs' | t | escape }}"
            >
              {% for tab_block in tab_blocks %}
                {% liquid
                  assign tab_label = tab_block.settings.label
                  if tab_label == blank and tab_block.settings.source == 'recently_viewed'
                    assign tab_label = 'featured_collection.recently_viewed' | t
                  endif
                  if tab_label == blank
                    assign tab_label = tab_block.settings.collection.title
                  endif
                  if tab_label == blank
                    assign tab_label = 'featured_collection.collection' | t
                  endif
                %}
                <button
                  class="featured-collection__tab"
                  id="FeaturedCollectionTab-{{ section.id }}-{{ tab_block.id }}"
                  type="button"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="FeaturedCollectionPanel-{{ section.id }}-{{ tab_block.id }}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  data-featured-collection-tab
                  data-block-id="{{ tab_block.id }}"
                  data-featured-collection-source="{{ tab_block.settings.source | default: 'collection' }}"
                >
                  {{ tab_label | escape }}
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if promotion_block != blank or tab_count > 0 %}
        <div class="featured-collection__body">
          {% if promotion_block != blank %}
            {% liquid
              assign promotion_alt = promotion_block.settings.image.alt
              assign promotion_overlay_opacity = promotion_block.settings.overlay_opacity | divided_by: 100.0
              if promotion_overlay_opacity < 0.45
                assign promotion_overlay_opacity = 0.45
              endif
              if promotion_alt == blank
                assign promotion_alt = promotion_block.settings.heading
              endif
            %}
            <article
              class="featured-collection__promotion featured-collection__promotion--{{ promotion_block.settings.media_ratio }}"
              style="--featured-collection-promotion-focal-point: {{ promotion_block.settings.focal_point }}; --featured-collection-promotion-overlay: {{ promotion_overlay_opacity }};"
              {{ promotion_block.shopify_attributes }}
            >
              <div class="featured-collection__promotion-media">
                {% if promotion_block.settings.image != blank %}
                  {% render 'responsive-image',
                    image: promotion_block.settings.image,
                    max_width: 1200,
                    widths: '320, 480, 640, 800, 960, 1200',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                    class: 'featured-collection__promotion-image',
                    loading: 'lazy',
                    alt: promotion_alt
                  %}
                {% else %}
                  {% render 'media-placeholder', class_name: 'featured-collection__promotion-placeholder' %}
                {% endif %}
              </div>
              <div class="featured-collection__promotion-overlay"></div>
              <div class="featured-collection__promotion-content">
                {% if promotion_block.settings.heading != blank %}
                  <h3 class="featured-collection__promotion-heading">{{ promotion_block.settings.heading | escape }}</h3>
                {% endif %}
                {% if promotion_block.settings.text != blank %}
                  <div class="featured-collection__promotion-text rte">{{ promotion_block.settings.text }}</div>
                {% endif %}
                {% render 'cta',
                  label: promotion_block.settings.button_label,
                  url: promotion_block.settings.link,
                  style: 'primary',
                  class: 'featured-collection__promotion-button'
                %}
              </div>
            </article>
          {% endif %}

          {% if tab_count > 0 %}
            <div class="featured-collection__panels">
              {% assign panel_index = 0 %}
              {% for tab_block in tab_blocks %}
                <div
                  class="featured-collection__panel"
                  id="FeaturedCollectionPanel-{{ section.id }}-{{ tab_block.id }}"
                  role="tabpanel"
                  aria-labelledby="FeaturedCollectionTab-{{ section.id }}-{{ tab_block.id }}"
                  data-featured-collection-panel
                  data-block-id="{{ tab_block.id }}"
                  data-featured-collection-source="{{ tab_block.settings.source | default: 'collection' }}"
                  {% unless forloop.first %}hidden{% endunless %}
                  {{ tab_block.shopify_attributes }}
                >
                  <div class="featured-collection__carousel swiper" data-featured-collection-carousel>
                    <ul class="featured-collection__products swiper-wrapper" role="list" data-featured-collection-scroller>
                    {% if tab_block.settings.source == 'recently_viewed' %}
                      {% if request.design_mode %}
                        {% for placeholder_index in (1..section.settings.products_to_show) %}
                          <li class="featured-collection__product swiper-slide">
                            {% render 'product-card',
                              show_media_actions: true,
                              enable_quick_view: true,
                              placeholder_index: placeholder_index
                            %}
                          </li>
                        {% endfor %}
                      {% endif %}
                    {% elsif tab_block.settings.collection != blank and tab_block.settings.collection.products_count > 0 %}
                      {% for product in tab_block.settings.collection.products limit: section.settings.products_to_show %}
                        {% liquid
                          assign card_loading = 'lazy'
                          assign card_fetchpriority = 'auto'
                          assign card_preload = false
                          if section.index <= 3 and panel_index == 0 and forloop.first
                            assign card_loading = 'eager'
                            assign card_fetchpriority = 'high'
                            assign card_preload = true
                          endif
                        %}
                        <li class="featured-collection__product swiper-slide">
                          {% render 'product-card',
                            product: product,
                            show_media_actions: true,
                            enable_quick_view: true,
                            loading: card_loading,
                            fetchpriority: card_fetchpriority,
                            preload: card_preload
                          %}
                        </li>
                      {% endfor %}
                    {% else %}
                      {% for placeholder_index in (1..section.settings.products_to_show) %}
                        <li class="featured-collection__product swiper-slide">
                          {% render 'product-card',
                            show_media_actions: true,
                            enable_quick_view: true,
                            placeholder_index: placeholder_index
                          %}
                        </li>
                      {% endfor %}
                    {% endif %}
                    </ul>
                  </div>

                  <button
                    class="featured-collection__carousel-button featured-collection__carousel-button--previous"
                    type="button"
                    aria-label="{{ 'featured_collection.previous_products' | t | escape }}"
                    data-featured-collection-previous
                  >
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                      <path d="M14.5 5 7.5 12l7 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button
                    class="featured-collection__carousel-button featured-collection__carousel-button--next"
                    type="button"
                    aria-label="{{ 'featured_collection.next_products' | t | escape }}"
                    data-featured-collection-next
                  >
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                      <path d="m9.5 5 7 7-7 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <div class="featured-collection__progress" aria-hidden="true">
                    <span data-featured-collection-progress></span>
                  </div>
                </div>
                {% assign panel_index = panel_index | plus: 1 %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </featured-collection>
{% endif %}

{% stylesheet %}
  .featured-collection__intro > .spinel-group,
  .featured-collection__intro > .shopify-block,
  .featured-collection__intro > .shopify-block > .spinel-group {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:featured_collection_blocks.name",
  "tag": "section",
  "class": "section-featured-collection",
  "max_blocks": 7,
  "settings": [
    {
      "type": "header",
      "content": "t:featured_collection_blocks.products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "t:featured_collection_blocks.products_to_show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "t:featured_collection_blocks.show_intro",
      "default": false
    },
    {
      "type": "header",
      "content": "t:featured_collection_blocks.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:featured_collection_blocks.section_width",
      "options": [
        {
          "value": "full",
          "label": "t:featured_collection_blocks.full_width"
        },
        {
          "value": "page",
          "label": "t:featured_collection_blocks.page_width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:featured_collection_blocks.desktop_columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "t:featured_collection_blocks.column_gap",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:featured_collection_blocks.mobile"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:featured_collection_blocks.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:featured_collection_blocks.one_column"
        },
        {
          "value": "2",
          "label": "t:featured_collection_blocks.two_columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "mobile_column_gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "t:featured_collection_blocks.mobile_column_gap",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:featured_collection_blocks.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:featured_collection_blocks.top_padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:featured_collection_blocks.bottom_padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:featured_collection_blocks.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:featured_collection_blocks.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "_featured-collection-promotion"
    },
    {
      "type": "_featured-collection-tab"
    }
  ],
  "presets": [
    {
      "name": "t:featured_collection_blocks.preset_tabs",
      "category": "t:featured_collection_blocks.category",
      "blocks": [
        {
          "type": "group",
          "id": "intro",
          "static": true,
          "settings": {
            "block_style": "group",
            "flow": "vertical",
            "stack_alignment": "flex-start",
            "stack_distribution": "flex-start",
            "gap": 8,
            "phone_flow": "vertical",
            "phone_alignment": "flex-start",
            "phone_distribution": "flex-start",
            "gap_mobile": 8,
            "desktop_width": "stretch",
            "phone_width": "stretch"
          }
        },
        {
          "type": "_featured-collection-tab",
          "settings": {
            "label": "t:featured_collection_blocks.featured"
          }
        },
        {
          "type": "_featured-collection-tab",
          "settings": {
            "label": "t:featured_collection_blocks.new_in"
          }
        },
        {
          "type": "_featured-collection-tab",
          "settings": {
            "label": "t:featured_collection_blocks.best_sellers"
          }
        }
      ]
    },
    {
      "name": "t:featured_collection_blocks.preset_promotion",
      "category": "t:featured_collection_blocks.category",
      "settings": {
        "show_intro": true
      },
      "blocks": [
        {
          "type": "group",
          "id": "intro",
          "static": true,
          "settings": {
            "block_style": "group",
            "flow": "vertical",
            "stack_alignment": "flex-start",
            "stack_distribution": "flex-start",
            "gap": 8,
            "phone_flow": "vertical",
            "phone_alignment": "flex-start",
            "phone_distribution": "flex-start",
            "gap_mobile": 8,
            "desktop_width": "stretch",
            "phone_width": "stretch"
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "t:featured_collection_blocks.intro_heading",
                "type_preset": "h2",
                "font": "heading",
                "color": "text",
                "width": "100%",
                "width_mobile": "100%",
                "alignment": "left"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "t:featured_collection_blocks.intro_text",
                "type_preset": "custom",
                "font": "body",
                "font_weight": "inherit",
                "font_size": 12,
                "font_size_mobile": 12,
                "line_height": "normal",
                "color": "text",
                "width": "100%",
                "width_mobile": "100%",
                "alignment": "left"
              }
            }
          ]
        },
        {
          "type": "_featured-collection-promotion"
        },
        {
          "type": "_featured-collection-tab",
          "settings": {
            "label": "t:featured_collection_blocks.featured"
          }
        },
        {
          "type": "_featured-collection-tab",
          "settings": {
            "label": "t:featured_collection_blocks.new_in"
          }
        },
        {
          "type": "_featured-collection-tab",
          "settings": {
            "label": "t:featured_collection_blocks.best_sellers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
