{% render 'section-stylesheet', asset: 'section-gift-spinel.css' %}

{% liquid
  assign gift_spinel_background = section.settings.background_color
  if gift_spinel_background == blank
    assign gift_spinel_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif

  assign hero_title = section.settings.hero_title | default: 'The Gift'
  assign hero_tagline = section.settings.hero_tagline | default: 'For the moments that mean everything.'
  assign hero_description = section.settings.hero_description | default: '<p>A token of love. A reason to celebrate.<br>Thoughtful gifts, ready to be cherished<br>by the one who matters most.</p>'
  assign hero_image_class = 'gift-spinel__hero-image gift-spinel__hero-image--desktop'
  if section.settings.mobile_image == blank
    assign hero_image_class = hero_image_class | append: ' gift-spinel__hero-image--mobile-fallback'
  endif
  assign gift_path_count = 0
  for section_block in section.blocks
    unless section_block.id == 'gift-assurance'
      assign gift_path_count = gift_path_count | plus: 1
    endunless
  endfor
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ gift_spinel_background }};
  }
{% endstyle %}

<gift-spinel
  id="gift-spinel-{{ section.id }}"
  class="gift-spinel gift-spinel--image-{{ section.settings.image_position }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  data-deferred-module="{{ 'gift-spinel.js' | asset_url }}"
  data-editor-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <a name="gift-spinel" tabindex="-1" aria-hidden="true"></a>

  <div class="gift-spinel__spacing section-spacing">
    <div class="gift-spinel__inner">
      <section class="gift-spinel__hero" aria-labelledby="GiftSpinelTitle-{{ section.id }}">
        <div class="gift-spinel__hero-media" aria-hidden="true">
          {% if section.settings.image != blank %}
            {% render 'responsive-image',
              image: section.settings.image,
              max_width: 2400,
              widths: '640, 960, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              class: hero_image_class,
              loading: 'eager',
              fetchpriority: 'high',
              decorative: true
            %}
          {% elsif section.settings.mobile_image == blank %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'gift-spinel__hero-image gift-spinel__hero-placeholder' }}
          {% endif %}

          {% if section.settings.mobile_image != blank %}
            {% render 'responsive-image',
              image: section.settings.mobile_image,
              max_width: 1600,
              widths: '480, 640, 750, 960, 1200, 1600',
              sizes: '100vw',
              class: 'gift-spinel__hero-image gift-spinel__hero-image--mobile',
              loading: 'eager',
              fetchpriority: 'high',
              decorative: true
            %}
          {% endif %}
        </div>

        <div class="gift-spinel__hero-content">
          <div class="gift-spinel__hero-copy">
            {% if section.settings.hero_eyebrow != blank %}
              <p class="gift-spinel__hero-eyebrow subheading-text">{{ section.settings.hero_eyebrow | escape }}</p>
            {% endif %}
            <h2 class="gift-spinel__hero-title" id="GiftSpinelTitle-{{ section.id }}">{{ hero_title | escape }}</h2>
            <p class="gift-spinel__hero-tagline">{{ hero_tagline | escape }}</p>
            <div class="gift-spinel__hero-description rte">{{ hero_description }}</div>
          </div>

          {% if gift_path_count > 0 %}
            <div class="gift-spinel__choices" data-gift-spinel-choices role="tablist" aria-label="{{ 'gift_spinel.occasion_tabs' | t | escape }}">
              {% assign gift_path_index = 0 %}
              {% for block in section.blocks %}
                {% unless block.id == 'gift-assurance' %}
                {% assign gift_path_index = gift_path_index | plus: 1 %}
                {% liquid
                  case gift_path_index
                    when 1
                      assign occasion_key = 'birthday'
                    when 2
                      assign occasion_key = 'anniversary'
                    when 3
                      assign occasion_key = 'engagement'
                    else
                      assign occasion_key = 'just-because'
                  endcase
                  assign occasion_label = block.settings.occasion_label
                  if occasion_label == blank
                    case occasion_key
                      when 'birthday'
                        assign occasion_label = 'Birthday'
                      when 'anniversary'
                        assign occasion_label = 'Anniversary'
                      when 'engagement'
                        assign occasion_label = 'Engagement'
                      when 'just-because'
                        assign occasion_label = 'Just Because'
                      else
                        assign occasion_label = 'Gift path'
                    endcase
                  endif
                  assign panel_id = 'GiftSpinelPanel-' | append: section.id | append: '-' | append: block.id
                %}
                <button
                  class="gift-spinel__choice{% if gift_path_index == 1 %} is-selected{% endif %}"
                  type="button"
                  role="tab"
                  id="GiftSpinelChoice-{{ section.id }}-{{ block.id }}"
                  data-gift-spinel-choice="{{ block.id }}"
                  data-gift-spinel-target="{{ panel_id }}"
                  data-occasion="{{ occasion_key | escape }}"
                  aria-controls="{{ panel_id }}"
                  aria-selected="{% if gift_path_index == 1 %}true{% else %}false{% endif %}"
                  tabindex="{% if gift_path_index == 1 %}0{% else %}-1{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <span class="gift-spinel__choice-label">{{ occasion_label | escape }}</span>
                </button>
                {% endunless %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </section>

      {% if gift_path_count > 0 %}
        <section class="gift-spinel__product-band" aria-label="{{ 'gift_spinel.curated_edit' | t | escape }}">
          <p class="visually-hidden" data-gift-spinel-status role="status" aria-live="polite"></p>
          <div class="gift-spinel__product-panels">
            {% assign gift_path_index = 0 %}
            {% for block in section.blocks %}
              {% unless block.id == 'gift-assurance' %}
              {% assign gift_path_index = gift_path_index | plus: 1 %}
              {% liquid
                case gift_path_index
                  when 1
                    assign occasion_key = 'birthday'
                  when 2
                    assign occasion_key = 'anniversary'
                  when 3
                    assign occasion_key = 'engagement'
                  else
                    assign occasion_key = 'just-because'
                endcase
                assign occasion_label = block.settings.occasion_label
                if occasion_label == blank
                  case occasion_key
                    when 'birthday'
                      assign occasion_label = 'Birthday'
                    when 'anniversary'
                      assign occasion_label = 'Anniversary'
                    when 'engagement'
                      assign occasion_label = 'Engagement'
                    when 'just-because'
                      assign occasion_label = 'Just Because'
                    else
                      assign occasion_label = 'Gift path'
                  endcase
                endif
                assign panel_id = 'GiftSpinelPanel-' | append: section.id | append: '-' | append: block.id
              %}
              <div
                class="gift-spinel__product-panel{% if gift_path_index == 1 %} is-active{% endif %}"
                id="{{ panel_id }}"
                role="tabpanel"
                aria-labelledby="GiftSpinelChoice-{{ section.id }}-{{ block.id }}"
                data-gift-spinel-panel
                data-block-id="{{ block.id }}"
                data-occasion="{{ occasion_key | escape }}"
                {% unless gift_path_index == 1 %}hidden{% endunless %}
              >
                {% render block %}
              </div>
              {% endunless %}
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% content_for 'block', type: 'gift-assurance', id: 'gift-assurance' %}
    </div>
  </div>
</gift-spinel>

{% schema %}
{
  "name": "Gift Spinel",
  "tag": "section",
  "class": "section-gift-spinel",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }], "default": "page" },
    { "type": "header", "content": "Gift copy" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "The Gift" },
    { "type": "text", "id": "hero_tagline", "label": "Tagline", "default": "For the moments that mean everything." },
    { "type": "richtext", "id": "hero_description", "label": "Description", "default": "<p>A token of love. A reason to celebrate.<br>Thoughtful gifts, ready to be cherished<br>by the one who matters most.</p>" },
    { "type": "header", "content": "Product tray" },
    { "type": "text", "id": "product_empty_title", "label": "Placeholder product title", "default": "Gift selection", "info": "Used when a gift path does not have a product selected." },
    { "type": "header", "content": "Editorial image" },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Use a wide gift or campaign image. A placeholder is shown until an image is selected." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile hero image", "info": "Optional image used below 768px." },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Focus left" }, { "value": "right", "label": "Focus right" }], "default": "right" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-6" },
    { "type": "color", "id": "background_color", "label": "Background color", "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme." },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "gift-path" },
    { "type": "gift-assurance" }
  ],
  "enabled_on": {
    "templates": ["index"]
  },
  "presets": [
    {
      "name": "Gift Spinel",
      "category": "Gifting",
      "settings": {
        "hero_title": "The Gift",
        "hero_tagline": "For the moments that mean everything.",
        "hero_description": "<p>A token of love. A reason to celebrate.<br>Thoughtful gifts, ready to be cherished<br>by the one who matters most.</p>",
        "image_position": "right",
        "color_scheme": "scheme-6"
      },
      "blocks": [
        { "type": "gift-path", "settings": { "occasion_label": "Birthday" } },
        { "type": "gift-path", "settings": { "occasion_label": "Anniversary" } },
        { "type": "gift-path", "settings": { "occasion_label": "Engagement" } },
        { "type": "gift-assurance", "id": "gift-assurance", "static": true, "settings": { "first_heading": "Need to make a change?", "first_text": "<p>Share your exchange and return options here.</p>", "middle_heading": "How does it arrive?", "middle_text": "<p>Describe your gift presentation and packaging.</p>", "last_heading": "When will it arrive?", "last_text": "<p>Review delivery options at checkout.</p>" } }
      ]
    }
  ]
}
{% endschema %}
