{% render 'section-stylesheet', asset: 'section-gift-spinel.css' %}

{% liquid
  assign image_column_position = section.settings.image_position
  if image_column_position contains 'right'
    assign image_column_position = 'right'
  else
    assign image_column_position = 'left'
  endif
%}

<gift-spinel
  id="gift-spinel"
  class="gift-spinel gift-spinel--layout-{{ section.settings.layout_ratio }} gift-spinel--image-{{ image_column_position }} gift-spinel--choices-{{ section.settings.choice_style }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width gift-spinel--full{% endif %}"
  data-deferred-module="{{ 'gift-spinel.js' | asset_url }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --gift-spinel-product-columns: {{ section.settings.product_columns }};"
>
  <div class="gift-spinel__spacing section-spacing">
    <div class="gift-spinel__inner">
      <div
        class="gift-spinel__intro"
        style="--gift-spinel-card-color: {{ section.settings.image_overlay_color }}; --gift-spinel-card-reflection: {{ section.settings.intro_card_reflection | divided_by: 100.0 }};"
        {% if section.settings.heading != blank %}aria-labelledby="GiftSpinelTitle-{{ section.id }}"{% endif %}
      >
        <div class="gift-spinel__intro-media" aria-hidden="true">
          {% if section.settings.image != blank %}
            {% render 'responsive-image',
              image: section.settings.image,
              max_width: 1800,
              widths: '480, 640, 750, 960, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 42vw, 100vw',
              class: 'gift-spinel__intro-image',
              loading: 'lazy',
              decorative: true
            %}
          {% endif %}
        </div>
        <div class="gift-spinel__intro-content gift-spinel__intro-content--position-{{ section.settings.intro_card_position }}{% if section.settings.enable_intro_card %} gift-spinel__intro-content--card{% endif %}">
          {% if section.settings.subheading != blank %}
            <div class="gift-spinel__subheading gift-spinel__richtext gift-spinel__text--preset-{{ section.settings.subheading_preset }}">{{ section.settings.subheading }}</div>
          {% endif %}
          {% if section.settings.heading != blank %}
            <div class="gift-spinel__heading gift-spinel__richtext gift-spinel__text--preset-{{ section.settings.heading_preset }}" id="GiftSpinelTitle-{{ section.id }}">{{ section.settings.heading }}</div>
          {% endif %}
        </div>
      </div>

      <div class="gift-spinel__finder">
        <div class="gift-spinel__questions" data-gift-spinel-questions>
          <div class="gift-spinel__step-meta">
            <span>{{ 'gift_spinel.quick_choice' | t }}</span>
            <span>{{ section.settings.concierge_label | escape }}</span>
          </div>
          {% if section.settings.intro != blank %}
            <div class="gift-spinel__intro-copy gift-spinel__richtext gift-spinel__text--preset-{{ section.settings.intro_preset }} rte">{{ section.settings.intro }}</div>
          {% endif %}
          <div class="gift-spinel__question gift-spinel__richtext gift-spinel__text--preset-{{ section.settings.question_recipient_preset }}" id="GiftSpinelQuestion-{{ section.id }}" data-gift-spinel-question tabindex="-1">{{ section.settings.question_recipient }}</div>
          <p class="gift-spinel__question-hint" id="GiftSpinelHint-{{ section.id }}">{{ 'gift_spinel.choose_hint' | t }}</p>
          <div class="gift-spinel__choices" data-gift-spinel-choices role="group" aria-labelledby="GiftSpinelQuestion-{{ section.id }}" aria-describedby="GiftSpinelHint-{{ section.id }}">
            <button class="gift-spinel__choice" type="button" data-gift-spinel-choice="partner" aria-pressed="false">{{ section.settings.recipient_partner | escape }}</button>
            <button class="gift-spinel__choice" type="button" data-gift-spinel-choice="mother" aria-pressed="false">{{ section.settings.recipient_mother | escape }}</button>
            <button class="gift-spinel__choice" type="button" data-gift-spinel-choice="friend" aria-pressed="false">{{ section.settings.recipient_friend | escape }}</button>
            <button class="gift-spinel__choice" type="button" data-gift-spinel-choice="myself" aria-pressed="false">{{ section.settings.recipient_myself | escape }}</button>
          </div>
        </div>

        <p class="visually-hidden" data-gift-spinel-status role="status" aria-live="polite"></p>
        <div class="gift-spinel__result" data-gift-spinel-result hidden></div>

      </div>
    </div>
  </div>

  {% for block in section.blocks %}
    {% liquid
      assign path_collection = block.settings.collection
      assign path_primary_link = path_collection.url
      assign path_heading = block.settings.heading
      assign path_copy = block.settings.copy
      assign path_products = path_collection.products
    %}
    <template
      data-gift-spinel-path
      data-block-id="{{ block.id }}"
      data-recipient="{{ block.settings.recipient }}"
    >
      <div class="gift-spinel__result-content" {{ block.shopify_attributes }}>
        {% if block.settings.featured_badge != blank %}
          <div class="gift-spinel__result-kicker gift-spinel__richtext gift-spinel__text--preset-{{ block.settings.featured_badge_preset }}">{{ block.settings.featured_badge }}</div>
        {% else %}
          <p class="gift-spinel__result-kicker">{{ 'gift_spinel.curated_edit' | t }}</p>
        {% endif %}
        <div class="gift-spinel__result-heading gift-spinel__richtext gift-spinel__text--preset-{{ block.settings.heading_preset }}" data-gift-spinel-result-heading tabindex="-1">{{ path_heading }}</div>
        {% if path_copy != blank %}<div class="gift-spinel__result-copy gift-spinel__richtext gift-spinel__text--preset-{{ block.settings.copy_preset }} rte" data-gift-spinel-result-copy>{{ path_copy }}</div>{% endif %}
        <div class="gift-spinel__result-tools">
          <div class="gift-spinel__chips" data-gift-spinel-chips></div>
          <button class="gift-spinel__change" type="button" data-gift-spinel-change>{{ 'gift_spinel.change_recipient' | t }}</button>
        </div>

        <div class="gift-spinel__actions">
          {% render 'cta', label: block.settings.primary_label, url: path_primary_link, style: 'primary' %}
          {% if block.settings.show_personalization and block.settings.personalization_link != blank %}
            {% render 'cta', label: block.settings.personalization_label, url: block.settings.personalization_link, style: 'tertiary' %}
          {% endif %}
        </div>

        {% if path_products != blank %}
          <ul class="gift-spinel__products" role="list">
            {% for product in path_products limit: section.settings.products_to_show %}
              <li class="gift-spinel__product">
                {% render 'product-card',
                  product: product,
                  show_media_actions: true,
                  enable_quick_view: true
                %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <ul class="gift-spinel__products" role="list" aria-label="{{ 'gift_spinel.curated_edit' | t | escape }}">
            {% for placeholder_number in (1..section.settings.products_to_show) %}
              <li class="gift-spinel__product">
                {% render 'product-card',
                  placeholder_index: placeholder_number
                %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </template>
  {% endfor %}

  <template data-gift-spinel-placeholder>
    <div class="gift-spinel__result-content">
      <div class="gift-spinel__result-tools">
        <div class="gift-spinel__chips" data-gift-spinel-chips></div>
        <button class="gift-spinel__change" type="button" data-gift-spinel-change>{{ 'gift_spinel.change_recipient' | t }}</button>
      </div>
      <ul class="gift-spinel__products" role="list">
        {% for placeholder_number in (1..section.settings.products_to_show) %}
          <li class="gift-spinel__product">
            {% render 'product-card', placeholder_index: placeholder_number %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </template>

  <script type="application/json" data-gift-spinel-options>
    [
      { "value": "partner", "label": {{ section.settings.recipient_partner | json }} },
      { "value": "mother", "label": {{ section.settings.recipient_mother | json }} },
      { "value": "friend", "label": {{ section.settings.recipient_friend | json }} },
      { "value": "myself", "label": {{ section.settings.recipient_myself | json }} }
    ]
  </script>
</gift-spinel>

{% schema %}
{
  "name": "Gift Spinel",
  "tag": "section",
  "class": "section-gift-spinel",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Gifting, made simple</p>" },
    { "type": "select", "id": "subheading_preset", "label": "Preset", "options": [{ "value": "default", "label": "Default" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "subheading", "label": "Subheading" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" }], "default": "default" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Find their gift.</p>" },
    { "type": "select", "id": "heading_preset", "label": "Preset", "options": [{ "value": "default", "label": "Default" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "subheading", "label": "Subheading" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" }], "default": "default" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Choose who you are shopping for and we will show you a ready-to-gift jewelry edit.</p>" },
    { "type": "select", "id": "intro_preset", "label": "Preset", "options": [{ "value": "default", "label": "Default" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "subheading", "label": "Subheading" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" }], "default": "default" },
    { "type": "header", "content": "Editorial image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Select an image for this section." },
    { "type": "select", "id": "image_position", "label": "Image column position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left", "info": "Changes the desktop column position. On mobile, the gift finder is shown first and the image second." },
    { "type": "header", "content": "Text card" },
    { "type": "checkbox", "id": "enable_intro_card", "label": "Show text card", "default": true },
    { "type": "color", "id": "image_overlay_color", "label": "Card color", "default": "#F3F1EE" },
    { "type": "select", "id": "intro_card_position", "label": "Card position", "options": [{ "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" }, { "value": "center-left", "label": "Center left" }, { "value": "center", "label": "Center" }, { "value": "center-right", "label": "Center right" }, { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }], "default": "top-left", "info": "Controls the text card placement over the image." },
    { "type": "range", "id": "intro_card_reflection", "label": "Mirror reflection", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 25, "info": "Controls the soft reflective sheen on the text card.", "visible_if": "{{ section.settings.enable_intro_card }}" },
    { "type": "text", "id": "concierge_label", "label": "Interaction label", "default": "Gift finder" },
    { "type": "header", "content": "Recipient choices" },
    { "type": "richtext", "id": "question_recipient", "label": "Question text", "default": "<p>Who are you shopping for?</p>" },
    { "type": "select", "id": "question_recipient_preset", "label": "Preset", "options": [{ "value": "default", "label": "Default" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "subheading", "label": "Subheading" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" }], "default": "default" },
    { "type": "text", "id": "recipient_partner", "label": "Option 1", "default": "My partner" },
    { "type": "text", "id": "recipient_mother", "label": "Option 2", "default": "Mum" },
    { "type": "text", "id": "recipient_friend", "label": "Option 3", "default": "A friend" },
    { "type": "text", "id": "recipient_myself", "label": "Option 4", "default": "Myself" },
    { "type": "header", "content": "Product cards" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 6, "step": 1, "default": 3 },
    { "type": "select", "id": "product_columns", "label": "Desktop product columns", "options": [{ "value": "2", "label": "2 columns" }, { "value": "3", "label": "3 columns" }], "default": "3" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }], "default": "page" },
    { "type": "select", "id": "layout_ratio", "label": "Desktop panel ratio", "options": [{ "value": "balanced", "label": "Balanced" }, { "value": "editorial", "label": "Larger intro" }, { "value": "finder", "label": "Larger gift finder" }], "default": "balanced" },
    { "type": "select", "id": "choice_style", "label": "Choice style", "options": [{ "value": "outline", "label": "Outlined cards" }, { "value": "soft", "label": "Soft fill" }, { "value": "pill", "label": "Rounded pills" }], "default": "outline" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "gift_path",
      "name": "Gift path",
      "settings": [
        {
          "type": "header",
          "content": "Gift path"
        },
        { "type": "paragraph", "content": "Choose one collection for this recipient. Its products and URL are used automatically." },
        { "type": "header", "content": "Recipient" },
        { "type": "select", "id": "recipient", "label": "Recipient", "options": [{ "value": "partner", "label": "Partner" }, { "value": "mother", "label": "Mother" }, { "value": "friend", "label": "Friend" }, { "value": "myself", "label": "Myself" }], "default": "partner" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Supplies the product cards and primary CTA destination." },
        { "type": "header", "content": "Result content" },
        { "type": "text", "id": "primary_label", "label": "Primary CTA label", "default": "Explore this gift edit" },
        { "type": "richtext", "id": "featured_badge", "label": "Featured badge", "default": "<p>Your curated gift edit</p>" },
        { "type": "select", "id": "featured_badge_preset", "label": "Preset", "options": [{ "value": "default", "label": "Default" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "subheading", "label": "Subheading" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" }], "default": "default" },
        { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>A thoughtful edit, chosen with care.</p>", "info": "Supports {recipient}." },
        { "type": "select", "id": "heading_preset", "label": "Preset", "options": [{ "value": "default", "label": "Default" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "subheading", "label": "Subheading" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" }], "default": "default" },
        { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Chosen for its quiet symbolism and made to become part of their everyday ritual.</p>", "info": "Supports {recipient}." },
        { "type": "select", "id": "copy_preset", "label": "Preset", "options": [{ "value": "default", "label": "Default" }, { "value": "paragraph", "label": "Paragraph" }, { "value": "subheading", "label": "Subheading" }, { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" }], "default": "default" },
        { "type": "header", "content": "Personalization CTA" },
        { "type": "checkbox", "id": "show_personalization", "label": "Show personalization CTA", "default": false },
        { "type": "text", "id": "personalization_label", "label": "Personalization CTA label", "default": "Make it personal" },
        { "type": "url", "id": "personalization_link", "label": "Personalization CTA link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift Spinel",
      "category": "Gifting",
      "blocks": [
        { "type": "gift_path", "settings": { "recipient": "mother", "heading": "<p>A thoughtful edit for Mum.</p>", "featured_badge": "<p>Chosen for Mum</p>" } },
        { "type": "gift_path", "settings": { "recipient": "partner", "heading": "<p>A keepsake for your shared story.</p>", "featured_badge": "<p>Chosen for your partner</p>" } },
        { "type": "gift_path", "settings": { "recipient": "friend", "heading": "<p>A gift that feels like them.</p>", "featured_badge": "<p>Chosen for a friend</p>" } },
        { "type": "gift_path", "settings": { "recipient": "myself", "heading": "<p>A piece to keep close.</p>", "featured_badge": "<p>A gift to yourself</p>" } }
      ]
    }
  ]
}
{% endschema %}
