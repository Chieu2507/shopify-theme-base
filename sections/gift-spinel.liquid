{% render 'section-stylesheet', asset: 'section-gift-spinel.css' %}

{% liquid
  assign editorial_image_block = blank
  assign content_card_block = blank
  for block in section.blocks
    if block.type == 'editorial_image'
      assign editorial_image_block = block
    elsif block.type == 'content_card'
      assign content_card_block = block
    endif
  endfor

  assign image_column_position = editorial_image_block.settings.image_position
  if image_column_position contains 'right'
    assign image_column_position = 'right'
  else
    assign image_column_position = 'left'
  endif
%}

<gift-spinel
  id="gift-spinel"
  class="gift-spinel gift-spinel--layout-{{ section.settings.layout_ratio }} gift-spinel--image-{{ image_column_position }} gift-spinel--choices-{{ section.settings.choice_style }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width gift-spinel--full{% endif %}"
  data-deferred-module="{{ 'gift-spinel.js' | asset_url }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --gift-spinel-product-columns: {{ section.settings.product_columns }};"
>
  <div class="gift-spinel__spacing section-spacing">
    <div class="gift-spinel__inner">
      <div
        class="gift-spinel__intro"
        style="--gift-spinel-card-color: {{ content_card_block.settings.card_color }}; --gift-spinel-card-reflection: {{ content_card_block.settings.card_reflection | divided_by: 100.0 }};"
        {% if content_card_block.settings.heading != blank %}aria-labelledby="GiftSpinelTitle-{{ section.id }}"{% endif %}
      >
        <div class="gift-spinel__intro-media" aria-hidden="true" {{ editorial_image_block.shopify_attributes }}>
          {% if editorial_image_block.settings.image != blank %}
            {% render 'responsive-image',
              image: editorial_image_block.settings.image,
              max_width: 1800,
              widths: '480, 640, 750, 960, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 42vw, 100vw',
              class: 'gift-spinel__intro-image',
              loading: 'lazy',
              decorative: true
            %}
          {% endif %}
        </div>
        <div class="gift-spinel__intro-content gift-spinel__intro-content--position-{{ content_card_block.settings.card_position }}{% if content_card_block.settings.show_card %} gift-spinel__intro-content--card{% endif %}">
          {% if content_card_block.settings.subheading != blank %}
            <p class="gift-spinel__subheading">{{ content_card_block.settings.subheading | escape }}</p>
          {% endif %}
          {% if content_card_block.settings.heading != blank %}
            <div class="gift-spinel__heading" id="GiftSpinelTitle-{{ section.id }}">
              {% render 'typography-block',
                block: content_card_block,
                content: content_card_block.settings.heading,
                kind: 'heading',
                default_preset: 'h1',
                default_font: 'heading'
              %}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="gift-spinel__finder">
        <div class="gift-spinel__questions" data-gift-spinel-questions>
          <div class="gift-spinel__step-meta">
            <span>{{ 'gift_spinel.quick_choice' | t }}</span>
            <span>{{ section.settings.concierge_label | escape }}</span>
          </div>
          {% if section.settings.intro != blank %}
            <div class="gift-spinel__intro-copy rte">{{ section.settings.intro }}</div>
          {% endif %}
          <h3 class="gift-spinel__question" id="GiftSpinelQuestion-{{ section.id }}" data-gift-spinel-question tabindex="-1">{{ section.settings.question_recipient | escape }}</h3>
          <p class="gift-spinel__question-hint" id="GiftSpinelHint-{{ section.id }}">{{ 'gift_spinel.choose_hint' | t }}</p>
          <div class="gift-spinel__choices" data-gift-spinel-choices role="group" aria-labelledby="GiftSpinelQuestion-{{ section.id }}" aria-describedby="GiftSpinelHint-{{ section.id }}">
            {% for collection in section.settings.collections limit: 4 %}
              <button class="gift-spinel__choice" type="button" data-gift-spinel-choice="{{ collection.handle }}" aria-pressed="false">{{ collection.title | escape }}</button>
            {% endfor %}
          </div>
        </div>

        <p class="visually-hidden" data-gift-spinel-status role="status" aria-live="polite"></p>
        <div class="gift-spinel__result" data-gift-spinel-result hidden></div>

      </div>
    </div>
  </div>

  {% for collection in section.settings.collections limit: 4 %}
    <template
      data-gift-spinel-path
      data-recipient="{{ collection.handle }}"
    >
      <div class="gift-spinel__result-content">
        <p class="gift-spinel__result-kicker">{{ section.settings.featured_badge | default: 'Curated collection' | escape }}</p>
        <h3 class="gift-spinel__result-heading" data-gift-spinel-result-heading tabindex="-1">{{ collection.title | escape }}</h3>
        {% if collection.description != blank %}<div class="gift-spinel__result-copy rte" data-gift-spinel-result-copy>{{ collection.description }}</div>{% endif %}
        <div class="gift-spinel__result-tools">
          <div class="gift-spinel__chips" data-gift-spinel-chips></div>
          <button class="gift-spinel__change" type="button" data-gift-spinel-change>{{ 'gift_spinel.change_recipient' | t }}</button>
        </div>

        <div class="gift-spinel__actions">
          {% render 'cta', label: section.settings.primary_label, url: collection.url, style: 'primary' %}
        </div>

        {% if collection.products_count > 0 %}
          <ul class="gift-spinel__products" role="list">
            {% for product in collection.products limit: section.settings.products_to_show %}
              <li class="gift-spinel__product">
                {% render 'product-card',
                  product: product,
                  show_media_actions: true,
                  enable_quick_view: true
                %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <ul class="gift-spinel__products" role="list" aria-label="{{ 'gift_spinel.curated_edit' | t | escape }}">
            {% for placeholder_number in (1..section.settings.products_to_show) %}
              <li class="gift-spinel__product">
                {% render 'product-card',
                  placeholder_index: placeholder_number
                %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </template>
  {% endfor %}

  <template data-gift-spinel-placeholder>
    <div class="gift-spinel__result-content">
      <div class="gift-spinel__result-tools">
        <div class="gift-spinel__chips" data-gift-spinel-chips></div>
        <button class="gift-spinel__change" type="button" data-gift-spinel-change>{{ 'gift_spinel.change_recipient' | t }}</button>
      </div>
      <ul class="gift-spinel__products" role="list">
        {% for placeholder_number in (1..section.settings.products_to_show) %}
          <li class="gift-spinel__product">
            {% render 'product-card', placeholder_index: placeholder_number %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </template>

  <script type="application/json" data-gift-spinel-options>
    [
      {% for collection in section.settings.collections limit: 4 %}
        { "value": {{ collection.handle | json }}, "label": {{ collection.title | json }} }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</gift-spinel>

{% schema %}
{
  "name": "Gift Spinel",
  "tag": "section",
  "class": "section-gift-spinel",
  "max_blocks": 2,
  "settings": [
    {
      "type": "header",
      "content": "Collection list"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 4
    },
    {
      "type": "header",
      "content": "Gift finder"
    },
    { "type": "text", "id": "concierge_label", "label": "Interaction label", "default": "Gift finder" },
    { "type": "text", "id": "question_recipient", "label": "Question text", "default": "Who are you shopping for?" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Choose one collection to see the edit instantly.</p>" },
    { "type": "text", "id": "featured_badge", "label": "Result badge", "default": "Curated collection" },
    { "type": "text", "id": "primary_label", "label": "Collection button label", "default": "Explore collection" },
    {
      "type": "header",
      "content": "Product cards"
    },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 6, "step": 1, "default": 3 },
    { "type": "select", "id": "product_columns", "label": "Desktop product columns", "options": [{ "value": "2", "label": "2 columns" }, { "value": "3", "label": "3 columns" }], "default": "3" },
    {
      "type": "header",
      "content": "Layout"
    },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }], "default": "page" },
    { "type": "select", "id": "layout_ratio", "label": "Desktop panel ratio", "options": [{ "value": "balanced", "label": "Balanced" }, { "value": "editorial", "label": "Larger intro" }, { "value": "finder", "label": "Larger gift finder" }], "default": "balanced" },
    { "type": "select", "id": "choice_style", "label": "Choice style", "options": [{ "value": "outline", "label": "Outlined cards" }, { "value": "soft", "label": "Soft fill" }, { "value": "pill", "label": "Rounded pills" }], "default": "outline" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    {
      "type": "header",
      "content": "Appearance"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "content_card",
      "name": "Content card",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Gifting, made simple" },
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<p>Find their gift.</p>"
        },
        {
          "type": "paragraph",
          "content": "t:typography_blocks.highlight_info"
        },
        {
          "type": "select",
          "id": "highlight_style",
          "label": "Highlight style",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "wavy", "label": "Wavy underline" },
            { "value": "solid", "label": "Solid background" }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "Preset",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "paragraph", "label": "Paragraph" },
            { "value": "subheading", "label": "Subheading" },
            { "value": "h1", "label": "Heading 1" },
            { "value": "h2", "label": "Heading 2" },
            { "value": "h3", "label": "Heading 3" },
            { "value": "h4", "label": "Heading 4" },
            { "value": "h5", "label": "Heading 5" },
            { "value": "h6", "label": "Heading 6" }
          ],
          "default": "h1"
        },
        {
          "type": "header",
          "content": "Animation"
        },
        {
          "type": "select",
          "id": "animation_type",
          "label": "Animation type",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "fade_in", "label": "Fade in" },
            { "value": "fade_up", "label": "Fade up" },
            { "value": "slide_in_left", "label": "Slide in left" },
            { "value": "slide_in_right", "label": "Slide in right" },
            { "value": "zoom_in", "label": "Zoom in" },
            { "value": "zoom_out", "label": "Zoom out" }
          ],
          "default": "none"
        },
        {
          "type": "range",
          "id": "animation_delay",
          "label": "Animation delay",
          "min": 0,
          "max": 1000,
          "step": 50,
          "unit": "ms",
          "default": 0,
          "visible_if": "{{ block.settings.animation_type != 'none' }}"
        },
        {
          "type": "header",
          "content": "Card"
        },
        { "type": "checkbox", "id": "show_card", "label": "Show card", "default": true },
        { "type": "color", "id": "card_color", "label": "Card color", "default": "#F3F1EE", "visible_if": "{{ block.settings.show_card }}" },
        { "type": "select", "id": "card_position", "label": "Card position", "options": [{ "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" }, { "value": "center-left", "label": "Center left" }, { "value": "center", "label": "Center" }, { "value": "center-right", "label": "Center right" }, { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }], "default": "top-left", "info": "Controls the content card placement over the image." },
        { "type": "range", "id": "card_reflection", "label": "Mirror reflection", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 25, "info": "Controls the soft reflective sheen on the content card.", "visible_if": "{{ block.settings.show_card }}" }
      ]
    },
    {
      "type": "editorial_image",
      "name": "Editorial image",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "image_position", "label": "Image column position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left", "info": "Changes the desktop column position. On mobile, the gift finder is shown first and the image second." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift Spinel",
      "category": "Gifting",
      "blocks": [
        { "type": "content_card" },
        { "type": "editorial_image" }
      ]
    }
  ]
}
{% endschema %}
