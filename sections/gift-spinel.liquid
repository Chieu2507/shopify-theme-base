{% render 'section-stylesheet', asset: 'section-gift-spinel.css' %}

{% liquid
  assign gift_spinel_background = section.settings.background_color
  if gift_spinel_background == blank
    assign gift_spinel_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif

  assign hero_title = section.settings.hero_title | default: 'The Gift'
  assign hero_tagline = section.settings.hero_tagline | default: 'For the moments that mean everything.'
  assign hero_description = section.settings.hero_description | default: '<p>A token of love. A reason to celebrate.<br>Thoughtful gifts, ready to be cherished<br>by the one who matters most.</p>'
  assign hero_image_class = 'gift-spinel__hero-image gift-spinel__hero-image--desktop'
  if section.settings.mobile_image == blank
    assign hero_image_class = hero_image_class | append: ' gift-spinel__hero-image--mobile-fallback'
  endif
  assign assurance_1_heading = section.settings.assurance_1_heading | default: 'Wrong size?'
  assign assurance_1_text = section.settings.assurance_1_text | default: '<p>Free exchange within 30 days.<br>No hassle.</p>'
  assign assurance_2_heading = section.settings.assurance_2_heading | default: 'How does it arrive?'
  assign assurance_2_text = section.settings.assurance_2_text | default: '<p>In the signature box,<br>with a handwritten card.</p>'
  assign assurance_3_heading = section.settings.assurance_3_heading | default: 'Will it arrive in time?'
  assign assurance_3_text = section.settings.assurance_3_text | default: '<p>Choose your delivery date at checkout.</p>'
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ gift_spinel_background }};
  }
{% endstyle %}

<gift-spinel
  id="gift-spinel-{{ section.id }}"
  class="gift-spinel gift-spinel--image-{{ section.settings.image_position }} color-scheme color-{{ section.settings.color_scheme.id }}"
  data-deferred-module="{{ 'gift-spinel.js' | asset_url }}"
  data-editor-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <a name="gift-spinel" tabindex="-1" aria-hidden="true"></a>

  <div class="gift-spinel__spacing section-spacing">
    <div class="gift-spinel__inner">
      <section class="gift-spinel__hero" aria-labelledby="GiftSpinelTitle-{{ section.id }}">
        <div class="gift-spinel__hero-media" aria-hidden="true">
          {% if section.settings.image != blank %}
            {% render 'responsive-image',
              image: section.settings.image,
              max_width: 2400,
              widths: '640, 960, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              class: hero_image_class,
              loading: 'eager',
              fetchpriority: 'high',
              decorative: true
            %}
          {% elsif section.settings.mobile_image == blank %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'gift-spinel__hero-image gift-spinel__hero-placeholder' }}
          {% endif %}

          {% if section.settings.mobile_image != blank %}
            {% render 'responsive-image',
              image: section.settings.mobile_image,
              max_width: 1600,
              widths: '480, 640, 750, 960, 1200, 1600',
              sizes: '100vw',
              class: 'gift-spinel__hero-image gift-spinel__hero-image--mobile',
              loading: 'eager',
              fetchpriority: 'high',
              decorative: true
            %}
          {% endif %}
        </div>

        <div class="gift-spinel__hero-content">
          <div class="gift-spinel__hero-copy">
            {% if section.settings.hero_eyebrow != blank %}
              <p class="gift-spinel__hero-eyebrow subheading-text">{{ section.settings.hero_eyebrow | escape }}</p>
            {% endif %}
            <h2 class="gift-spinel__hero-title" id="GiftSpinelTitle-{{ section.id }}">{{ hero_title | escape }}</h2>
            <p class="gift-spinel__hero-tagline">{{ hero_tagline | escape }}</p>
            <div class="gift-spinel__hero-description rte">{{ hero_description }}</div>
          </div>

          {% if section.blocks.size > 0 %}
            <div class="gift-spinel__choices" data-gift-spinel-choices role="tablist" aria-label="{{ 'gift_spinel.occasion_tabs' | t | escape }}">
              {% for block in section.blocks %}
                {% liquid
                  assign occasion_key = block.settings.occasion
                  if occasion_key == blank
                    case block.settings.recipient
                      when 'mother'
                        assign occasion_key = 'birthday'
                      when 'partner'
                        assign occasion_key = 'anniversary'
                      when 'friend'
                        assign occasion_key = 'engagement'
                      else
                        assign occasion_key = 'just-because'
                    endcase
                  endif
                  assign occasion_label = block.settings.occasion_label | default: block.settings.recipient_label | default: occasion_key
                  assign panel_id = 'GiftSpinelPanel-' | append: section.id | append: '-' | append: block.id
                %}
                <button
                  class="gift-spinel__choice{% if forloop.first %} is-selected{% endif %}"
                  type="button"
                  role="tab"
                  id="GiftSpinelChoice-{{ section.id }}-{{ block.id }}"
                  data-gift-spinel-choice="{{ block.id }}"
                  data-gift-spinel-target="{{ panel_id }}"
                  data-occasion="{{ occasion_key | escape }}"
                  aria-controls="{{ panel_id }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <span class="gift-spinel__choice-label">{{ occasion_label | escape }}</span>
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </section>

      {% if section.blocks.size > 0 %}
        <section class="gift-spinel__featured-collection" aria-label="{{ 'gift_spinel.curated_edit' | t | escape }}">
          <p class="visually-hidden" data-gift-spinel-status role="status" aria-live="polite"></p>
          <div class="gift-spinel__featured-panels">
            {% for block in section.blocks %}
              {% liquid
                assign occasion_key = block.settings.occasion
                if occasion_key == blank
                  case block.settings.recipient
                    when 'mother'
                      assign occasion_key = 'birthday'
                    when 'partner'
                      assign occasion_key = 'anniversary'
                    when 'friend'
                      assign occasion_key = 'engagement'
                    else
                      assign occasion_key = 'just-because'
                  endcase
                endif
                assign occasion_label = block.settings.occasion_label | default: block.settings.recipient_label | default: occasion_key
                assign panel_id = 'GiftSpinelPanel-' | append: section.id | append: '-' | append: block.id
              %}
              <div
                class="gift-spinel__featured-panel{% if forloop.first %} is-active{% endif %}"
                id="{{ panel_id }}"
                role="tabpanel"
                aria-labelledby="GiftSpinelChoice-{{ section.id }}-{{ block.id }}"
                data-gift-spinel-panel
                data-block-id="{{ block.id }}"
                data-occasion="{{ occasion_key | escape }}"
                {% unless forloop.first %}hidden{% endunless %}
              >
                {% liquid
                  assign featured_products = block.settings.products
                  if block.settings.collection != blank and block.settings.collection.products_count > 0
                    assign featured_products = block.settings.collection.products
                  endif
                  assign rendered_product_count = 0
                %}
                <ul class="gift-spinel__featured-products" role="list">
                  {% for card_product in featured_products limit: 3 %}
                    <li class="gift-spinel__featured-product">
                      <div class="gift-spinel__featured-product-reveal">
                        {% render 'product-card',
                          product: card_product,
                          media_ratio: 'landscape',
                          show_badges: false,
                          show_variant_dots: false,
                          show_media_actions: false,
                          show_quick_add: false,
                          enable_quick_view: false,
                          loading: 'lazy',
                          sizes: '(min-width: 993px) 30vw, (min-width: 768px) 32vw, 86vw'
                        %}
                      </div>
                    </li>
                    {% assign rendered_product_count = rendered_product_count | plus: 1 %}
                  {% endfor %}

                  {% for placeholder_index in (1..3) %}
                    {% if rendered_product_count < 3 %}
                      <li class="gift-spinel__featured-product" aria-hidden="true">
                        <div class="gift-spinel__featured-product-reveal">
                          {% render 'product-card',
                            show_badges: false,
                            show_variant_dots: false,
                            show_media_actions: false,
                            show_quick_add: false,
                            enable_quick_view: false,
                            placeholder_index: placeholder_index,
                            media_ratio: 'landscape',
                            sizes: '(min-width: 993px) 30vw, (min-width: 768px) 32vw, 86vw'
                          %}
                        </div>
                      </li>
                      {% assign rendered_product_count = rendered_product_count | plus: 1 %}
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      <section class="gift-spinel__assurances" aria-label="{{ 'gift_spinel.assurance_label' | t | escape }}">
        <article class="gift-spinel__assurance gift-spinel__assurance--text">
          <h3 class="gift-spinel__assurance-heading">{{ assurance_1_heading | escape }}</h3>
          <div class="gift-spinel__assurance-text rte">{{ assurance_1_text }}</div>
        </article>
        <article class="gift-spinel__assurance gift-spinel__assurance--media">
          <div class="gift-spinel__assurance-copy">
            <h3 class="gift-spinel__assurance-heading">{{ assurance_2_heading | escape }}</h3>
            <div class="gift-spinel__assurance-text rte">{{ assurance_2_text }}</div>
          </div>
          <div class="gift-spinel__assurance-media" aria-hidden="true">
            {% if section.settings.assurance_image != blank %}
              {% render 'responsive-image', image: section.settings.assurance_image, max_width: 720, widths: '240, 360, 480, 720', sizes: '(min-width: 993px) 20vw, 60vw', class: 'gift-spinel__assurance-image', loading: 'lazy', decorative: true %}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'gift-spinel__assurance-image gift-spinel__assurance-placeholder' }}
            {% endif %}
          </div>
        </article>
        <article class="gift-spinel__assurance gift-spinel__assurance--text">
          <h3 class="gift-spinel__assurance-heading">{{ assurance_3_heading | escape }}</h3>
          <div class="gift-spinel__assurance-text rte">{{ assurance_3_text }}</div>
        </article>
      </section>
    </div>
  </div>
</gift-spinel>

{% schema %}
{
  "name": "Gift Spinel",
  "tag": "section",
  "class": "section-gift-spinel",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" }], "default": "page" },
    { "type": "select", "id": "layout_ratio", "label": "Panel ratio", "options": [{ "value": "balanced", "label": "Balanced" }, { "value": "editorial", "label": "Larger intro" }, { "value": "finder", "label": "Larger gift finder" }], "default": "balanced" },
    { "type": "select", "id": "choice_style", "label": "Choice style", "options": [{ "value": "outline", "label": "Outlined cards" }, { "value": "soft", "label": "Soft fill" }, { "value": "pill", "label": "Rounded pills" }], "default": "pill" },
    { "type": "header", "content": "Gift copy" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "The Gift" },
    { "type": "text", "id": "hero_tagline", "label": "Tagline", "default": "For the moments that mean everything." },
    { "type": "richtext", "id": "hero_description", "label": "Description", "default": "<p>A token of love. A reason to celebrate.<br>Thoughtful gifts, ready to be cherished<br>by the one who matters most.</p>" },
    { "type": "header", "content": "Product tray" },
    { "type": "text", "id": "product_empty_title", "label": "Placeholder product title", "default": "Gift selection", "info": "Used when a gift path does not have a product selected." },
    { "type": "header", "content": "Assurance strip" },
    { "type": "text", "id": "assurance_1_heading", "label": "First heading", "default": "Wrong size?" },
    { "type": "richtext", "id": "assurance_1_text", "label": "First text", "default": "<p>Free exchange within 30 days.<br>No hassle.</p>" },
    { "type": "text", "id": "assurance_2_heading", "label": "Middle heading", "default": "How does it arrive?" },
    { "type": "richtext", "id": "assurance_2_text", "label": "Middle text", "default": "<p>In the signature box,<br>with a handwritten card.</p>" },
    { "type": "text", "id": "assurance_3_heading", "label": "Last heading", "default": "Will it arrive in time?" },
    { "type": "richtext", "id": "assurance_3_text", "label": "Last text", "default": "<p>Choose your delivery date at checkout.</p>" },
    { "type": "header", "content": "Cart action" },
    { "type": "text", "id": "bundle_name", "label": "Bundle name", "default": "Gift finder edit", "info": "Retained for compatibility with existing gift path data." },
    { "type": "text", "id": "bundle_add_label", "label": "Add all label", "default": "Add all to cart" },
    { "type": "text", "id": "bundle_adding_label", "label": "Adding label", "default": "Adding to cart" },
    { "type": "text", "id": "bundle_added_label", "label": "Added label", "default": "Added to cart" },
    { "type": "text", "id": "bundle_error_label", "label": "Error message", "default": "This gift edit could not be added. Please try again." },
    { "type": "header", "content": "Editorial image" },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Use a wide gift or campaign image. A placeholder is shown until an image is selected." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile hero image", "info": "Optional image used below 768px." },
    { "type": "image_picker", "id": "assurance_image", "label": "Assurance image", "info": "Optional packaging image for the middle assurance item." },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Focus left" }, { "value": "right", "label": "Focus right" }], "default": "right" },
    { "type": "checkbox", "id": "enable_intro_card", "label": "Legacy text card", "default": true, "info": "Retained for compatibility with existing Gift Spinel settings." },
    { "type": "color", "id": "image_overlay_color", "label": "Legacy card color", "default": "#F3F1EE" },
    { "type": "select", "id": "intro_card_position", "label": "Legacy card position", "options": [{ "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" }, { "value": "center-left", "label": "Center left" }, { "value": "center", "label": "Center" }, { "value": "center-right", "label": "Center right" }, { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }], "default": "top-left" },
    { "type": "range", "id": "intro_card_reflection", "label": "Legacy mirror reflection", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 25 },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-6" },
    { "type": "color", "id": "background_color", "label": "Background color", "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme." },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "gift-path" }
  ],
  "enabled_on": {
    "templates": ["index"]
  },
  "presets": [
    {
      "name": "Gift Spinel",
      "category": "Gifting",
      "settings": {
        "hero_title": "The Gift",
        "hero_tagline": "For the moments that mean everything.",
        "hero_description": "<p>A token of love. A reason to celebrate.<br>Thoughtful gifts, ready to be cherished<br>by the one who matters most.</p>",
        "choice_style": "pill",
        "image_position": "right",
        "color_scheme": "scheme-6",
        "assurance_1_heading": "Wrong size?",
        "assurance_1_text": "<p>Free exchange within 30 days.<br>No hassle.</p>",
        "assurance_2_heading": "How does it arrive?",
        "assurance_2_text": "<p>In the signature box,<br>with a handwritten card.</p>",
        "assurance_3_heading": "Will it arrive in time?",
        "assurance_3_text": "<p>Choose your delivery date at checkout.</p>"
      },
      "blocks": [
        { "type": "gift-path", "settings": { "occasion": "birthday", "occasion_label": "Birthday", "recipient": "mother", "recipient_label": "Birthday" } },
        { "type": "gift-path", "settings": { "occasion": "anniversary", "occasion_label": "Anniversary", "recipient": "partner", "recipient_label": "Anniversary" } },
        { "type": "gift-path", "settings": { "occasion": "engagement", "occasion_label": "Engagement", "recipient": "friend", "recipient_label": "Engagement" } },
        { "type": "gift-path", "settings": { "occasion": "just-because", "occasion_label": "Just Because", "recipient": "myself", "recipient_label": "Just Because" } }
      ]
    }
  ]
}
{% endschema %}
