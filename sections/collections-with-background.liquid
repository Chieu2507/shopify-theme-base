{% liquid
  assign collections_background_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign collections_background_scheme = section.settings.color_scheme.id
  endif
  assign collections_background_scheme = collections_background_scheme | handleize

  assign collections_background_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign collections_background_width = 'full-width'
  endif

  assign collections_background_content_alignment = 'flex-start'
  assign collections_background_text_alignment = 'left'
  if section.settings.content_alignment == 'center'
    assign collections_background_content_alignment = 'center'
    assign collections_background_text_alignment = 'center'
  elsif section.settings.content_alignment == 'right'
    assign collections_background_content_alignment = 'flex-end'
    assign collections_background_text_alignment = 'right'
  endif
%}

{% capture collections_background_style %}
  {% if section.settings.background_color != blank %}--collections-background-color: {{ section.settings.background_color }};{% endif %}
  --collections-background-overlay: {{ section.settings.overlay_opacity | times: 0.01 }};
  --collections-background-content-alignment: {{ collections_background_content_alignment }};
  --collections-background-text-align: {{ collections_background_text_alignment }};
  --collections-background-tab-alignment: {{ collections_background_content_alignment }};
  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
{% endcapture %}

{% if section.settings.background_color != blank %}
  <style>
    #shopify-section-{{ section.id }} { background-color: {{ section.settings.background_color }}; }
  </style>
{% endif %}

<div
  class="section-spacing collections-with-background color-scheme section-color-scope {{ collections_background_scheme }} collections-with-background--{{ section.settings.height }}"
  style="{{ collections_background_style | strip }}"
>
  <div class="container {{ collections_background_width }} collections-with-background__container">
    <div
      class="collections-with-background__layout"
      data-collection-tabs
      data-collection-tabs-ready="false"
      data-layout-direction="vertical"
    >
      <div class="collections-with-background__navigation">
        {% content_for 'block', type: 'tab-layout', id: 'tab-layout' %}
      </div>
      <div class="collections-with-background__items">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .collections-with-background {
    background-color: var(--collections-background-color, var(--background-color));
  }

  .collections-with-background__container,
  .collections-with-background__layout {
    min-width: 0;
  }

  .collections-with-background__layout {
    position: relative;
    display: grid;
    min-height: 30rem;
    overflow: hidden;
    background: var(--background-color);
  }

  .collections-with-background--small .collections-with-background__layout { min-height: 30rem; }
  .collections-with-background--medium .collections-with-background__layout { min-height: 42rem; }
  .collections-with-background--large .collections-with-background__layout { min-height: 52rem; }
  .collections-with-background--full_screen .collections-with-background__layout { min-height: 100svh; }

  .collections-with-background__navigation {
    z-index: 2;
    align-self: end;
    padding: clamp(1.5rem, 4vw, 4rem);
    color: var(--body-color);
  }

  .collections-with-background__navigation .tab-layout__navigation {
    justify-content: var(--collections-background-tab-alignment, flex-start);
  }

  .collections-with-background__items,
  .collection-background-item,
  .collection-background-item__panel {
    min-width: 0;
  }

  .collections-with-background__items {
    position: absolute;
    inset: 0;
  }

  .collection-background-item,
  .collection-background-item__panel {
    position: absolute;
    inset: 0;
  }

  .collection-background-item__panel[hidden] { display: none; }

  .collection-background-item__image,
  .collection-background-item__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .collection-background-item__image {
    object-fit: cover;
  }

  .collection-background-item__overlay {
    background: rgb(0 0 0 / var(--collections-background-overlay, 0.35));
  }

  .collection-background-item__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: end;
    align-items: var(--collections-background-content-alignment, flex-start);
    height: 100%;
    padding: clamp(1.5rem, 4vw, 4rem);
    color: var(--body-color);
    text-align: var(--collections-background-text-align, left);
  }

  .collection-background-item__title {
    max-width: 14ch;
    margin: 0;
    font: var(--font-heading-style) var(--font-heading-weight) var(--font-heading-xl) / var(--font-heading-xl-line-height) var(--font-heading-family);
    letter-spacing: var(--font-heading-xl-letter-spacing);
    text-transform: var(--font-heading-xl-text-transform);
  }

  .collection-background-item__count {
    margin: 0.5rem 0 0;
  }

  .collection-background-item__link {
    position: absolute;
    inset: 0;
  }

  .collection-background-item__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -0.5rem;
  }

  @media (max-width: 767.98px) {
    .collections-with-background__layout,
    .collections-with-background--small .collections-with-background__layout,
    .collections-with-background--medium .collections-with-background__layout,
    .collections-with-background--large .collections-with-background__layout {
      min-height: 34rem;
    }

    .collections-with-background--full_screen .collections-with-background__layout { min-height: 100svh; }

    .collections-with-background__navigation,
    .collection-background-item__content {
      padding: 1.5rem;
    }

    .collection-background-item__title {
      font-size: var(--font-heading-lg);
      line-height: var(--font-heading-lg-line-height);
      letter-spacing: var(--font-heading-lg-letter-spacing);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections background",
  "class": "section-collections-with-background",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 12,
  "blocks": [
    { "type": "tab-layout" },
    { "type": "collection-background-item" }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page_width", "label": "Page width" },
        { "value": "full_width", "label": "Full width" }
      ],
      "default": "full_width"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full_screen", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "show_product_count", "label": "Show product count", "default": true },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "Collections background",
      "blocks": [
        { "type": "tab-layout", "id": "tab-layout", "static": true, "settings": { "style": "underline", "font": "heading", "heading_size": "lg" } },
        { "type": "collection-background-item" },
        { "type": "collection-background-item" },
        { "type": "collection-background-item" }
      ]
    }
  ]
}
{% endschema %}
