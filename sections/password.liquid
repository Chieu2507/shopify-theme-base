{% liquid
  assign newsletter_form_id = 'PasswordNewsletter-' | append: section.id
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign desktop_image = desktop_image | default: mobile_image
%}

<section
  class="password-page password-page--horizontal-{{ section.settings.content_horizontal }} password-page--vertical-{{ section.settings.content_vertical }} color-scheme color-{{ section.settings.color_scheme.id }} full-width"
  style="--password-height-desktop: {{ section.settings.height_desktop }}px; --password-height-mobile: {{ section.settings.height_mobile }}px; --password-content-width: {{ section.settings.content_width }}px; --password-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="password-page__media" aria-hidden="true">
    {% if desktop_image != blank %}
      {% render 'responsive-picture', image: desktop_image, mobile_image: mobile_image, max_width: 2400, mobile_max_width: 1400, widths: '640, 960, 1200, 1600, 2000, 2400', mobile_widths: '480, 640, 750, 960, 1200, 1400', sizes: '100vw', class: 'password-page__image password-page__image--desktop', loading: 'eager', fetchpriority: 'high', decorative: true %}
    {% else %}
      {% render 'media-placeholder', class_name: 'password-page__image password-page__image--desktop', asset_name: 'placeholder-image-default-2.svg' %}
    {% endif %}
      <span class="password-page__overlay"></span>
  </div>

  <div class="password-page__main">
    <div class="password-page__content{% if section.settings.content_surface %} password-page__content--surface{% endif %}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% render 'spinel-type-style',
              block: block,
              content: block.settings.heading,
              kind: 'heading',
              default_preset: 'h2',
              default_font: 'heading',
              class_name: 'password-page__heading',
              content_class: 'password-page__heading-content'
            %}
          {% when 'text' %}
            {% render 'spinel-type-style',
              block: block,
              content: block.settings.text,
              kind: 'text',
              default_preset: 'paragraph',
              default_font: 'body',
              class_name: 'password-page__text',
              content_class: 'password-page__text-content'
            %}
          {% when 'newsletter' %}
            <div class="password-page__newsletter" {{ block.shopify_attributes }}>
              {% form 'customer', id: newsletter_form_id, class: 'password-page__newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="password-page__field-label" for="{{ newsletter_form_id }}-email">{{ block.settings.email_label | escape }}</label>
                <input id="{{ newsletter_form_id }}-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="{{ block.settings.email_placeholder | escape }}" required>
                <button class="button button--primary" type="submit">{{ block.settings.button_label | escape }}</button>
                {% if form.posted_successfully? %}
                  <p class="password-page__form-message" tabindex="-1">{{ 'password.newsletter_success' | t }}</p>
                {% endif %}
                {% if form.errors %}
                  <div class="password-page__form-message password-page__form-message--error" role="alert">{{ form.errors | default_errors }}</div>
                {% endif %}
              {% endform %}
            </div>
        {% endcase %}
      {% endfor %}

      {% if section.settings.show_store_message and shop.password_message != blank %}
        <p class="password-page__store-message">{{ shop.password_message }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .password-page { position: relative; display: grid; min-height: var(--password-height-desktop); overflow: hidden; isolation: isolate; background: var(--gradient-background, var(--color-background)); }
  .password-page__media, .password-page__image, .password-page__overlay { position: absolute; inset: 0; }
  .password-page__media { z-index: -2; }
  .password-page__image { width: 100%; height: 100%; object-fit: cover; }
  .password-page__overlay { z-index: 1; background: rgb(0 0 0 / var(--password-overlay-opacity)); }
  .password-page__newsletter-form input { width: 100%; min-width: 0; min-height: var(--control-height); padding: 0 14px; border: 1px solid var(--color-variant-border); border-radius: var(--style-border-radius-inputs); background: var(--color-background); color: var(--color-text); font: inherit; }
  .password-page__newsletter-form input:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  .password-page__main { position: relative; z-index: 2; display: flex; min-height: 0; flex: 1; align-items: center; padding: 40px var(--page-margin) 72px; }
  .password-page--horizontal-left .password-page__main { justify-content: flex-start; }
  .password-page--horizontal-center .password-page__main { justify-content: center; }
  .password-page--horizontal-right .password-page__main { justify-content: flex-end; }
  .password-page--vertical-top .password-page__main { align-items: flex-start; }
  .password-page--vertical-center .password-page__main { align-items: center; }
  .password-page--vertical-bottom .password-page__main { align-items: flex-end; }
  .password-page__content { display: grid; width: min(100%, var(--password-content-width)); gap: 18px; color: var(--color-text); }
  .password-page__content--surface { padding: clamp(28px, 5vw, 56px); border: 1px solid var(--color-variant-border); background: color-mix(in srgb, var(--color-background) 94%, transparent); }
  .password-page--horizontal-center .password-page__content { text-align: center; }
  .password-page__heading { margin: 0; color: var(--color-heading); }
  .password-page__text, .password-page__store-message { color: var(--color-text); line-height: var(--body-line-height); }
  .password-page__text > * { margin: 0; }
  .password-page__newsletter { margin-top: 6px; }
  .password-page__newsletter-form { display: grid; gap: 12px; }
  .password-page__field-label { color: var(--color-heading); font-size: var(--font-caption); letter-spacing: var(--font-eyebrow-letter-spacing); line-height: var(--font-eyebrow-line-height); text-transform: var(--font-eyebrow-text-case); }
  .password-page__newsletter-form .button { width: 100%; }
  .password-page__form-message { margin: 0; color: var(--color-text); font-size: var(--font-body-small); line-height: 1.45; }
  .password-page__form-message--error { color: var(--color-sale-price); }
  .password-page__form-message--error ul { margin: 0; padding-left: 18px; }
  .password-page__store-message { margin: 4px 0 0; font-size: var(--font-body-small); }
  @media screen and (max-width: 749px) { .password-page { min-height: var(--password-height-mobile); } .password-page__main { padding-top: 28px; padding-bottom: 48px; } .password-page__content--surface { padding: 28px 22px; } }
{% endstylesheet %}

