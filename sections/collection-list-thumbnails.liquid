{% liquid
  assign collection_thumbnails_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign collection_thumbnails_container_width = 'full-width'
  endif
%}

<div class="section-spacing collection-thumbnails color-scheme section-color-scope {{ section.settings.color_scheme | default: 'scheme-1' }}">
  <div
    class="container {{ collection_thumbnails_container_width }} collection-thumbnails__container"
    style="--collection-thumbnails-columns: {{ section.settings.columns_desktop }}; --collection-thumbnails-columns-mobile: {{ section.settings.columns_mobile }}; --collection-thumbnails-gap: {{ section.settings.column_gap_desktop }}px; --collection-thumbnails-gap-mobile: {{ section.settings.column_gap_mobile }}px; --collection-thumbnails-title-gap: {{ section.settings.title_gap }}px; --collection-thumbnails-image-radius: {{ section.settings.image_radius }}%; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .collection-thumbnails {
    padding-top: var(--section-padding-top, 40px);
    padding-bottom: var(--section-padding-bottom, 40px);
  }

  .collection-thumbnails__container {
    display: grid;
    grid-template-columns: repeat(var(--collection-thumbnails-columns, 6), minmax(0, 1fr));
    gap: var(--collection-thumbnails-gap, 24px);
  }

  @media (min-width: 768px) and (max-width: 1149.98px) {
    .collection-thumbnails {
      padding-top: calc(var(--section-padding-top, 40px) * 0.75);
      padding-bottom: calc(var(--section-padding-bottom, 40px) * 0.75);
    }
  }

  @media (max-width: 767.98px) {
    .collection-thumbnails {
      padding-top: calc(var(--section-padding-top, 40px) * 0.5);
      padding-bottom: calc(var(--section-padding-bottom, 40px) * 0.5);
    }

    .collection-thumbnails__container {
      grid-template-columns: repeat(var(--collection-thumbnails-columns-mobile, 3), minmax(0, 1fr));
      gap: var(--collection-thumbnails-gap-mobile, var(--collection-thumbnails-gap, 24px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list_thumbnails",
  "class": "section-collection-list-thumbnails",
  "enabled_on": { "templates": ["*"] },
  "max_blocks": 12,
  "blocks": [{ "type": "collection-thumbnail" }],
  "settings": [
    { "type": "header", "content": "t:general.layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "page_width", "label": "t:options.section_width.page_width" },
        { "value": "full_width", "label": "t:options.section_width.full_width" }
      ],
      "default": "page_width"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.desktop_columns",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:labels.mobile_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "label": "t:labels.desktop_column_gap",
      "min": 0,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "label": "t:labels.mobile_column_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_gap",
      "label": "t:labels.title_gap",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:labels.image_corner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    { "type": "header", "content": "t:general.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "header", "content": "t:general.section_padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.top_padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.bottom_padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [
    {
      "name": "t:general.collection_list_thumbnails",
      "blocks": [
        { "type": "collection-thumbnail" },
        { "type": "collection-thumbnail" },
        { "type": "collection-thumbnail" },
        { "type": "collection-thumbnail" },
        { "type": "collection-thumbnail" },
        { "type": "collection-thumbnail" }
      ]
    }
  ]
}
{% endschema %}
