{% render 'section-stylesheet', asset: 'section-gallery.css', defer_on_home: true %}

{% capture header_content %}
  {% content_for 'block', type: 'group', id: 'header' %}
{% endcapture %}
{% capture gallery_items %}
  {% content_for 'blocks' %}
{% endcapture %}

<section
  class="gallery color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --gallery-content-gap: {{ section.settings.content_gap }}px; --gallery-grid-gap: {{ section.settings.grid_gap }}px; --gallery-columns-desktop: {{ section.settings.columns_desktop }}; --gallery-columns-tablet: {{ section.settings.columns_desktop }}; --gallery-columns-mobile: {{ section.settings.columns_mobile }};"
>
  <div class="gallery__inner section-spacing">
    <header class="gallery__header">
      {{ header_content }}
    </header>

    {% if gallery_items != blank %}
      <div class="gallery__grid">
        {{ gallery_items }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .gallery__header > .spinel-group {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gallery · Blocks",
  "tag": "section",
  "class": "section-gallery",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Header to gallery gap",
      "default": 40
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Image gap",
      "default": 8
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "_gallery-image"
    }
  ],
  "presets": [
    {
      "name": "Gallery · Blocks",
      "category": "Editorial content",
      "blocks": [
        {
          "type": "group",
          "id": "header",
          "static": true,
          "settings": {
            "flow": "vertical",
            "stack_alignment": "center",
            "gap": 24,
            "phone_alignment": "center",
            "desktop_width": "stretch",
            "phone_width": "stretch"
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "<h2>Shop the latest from Instagram</h2>",
                "type_preset": "h2",
                "alignment": "center"
              }
            }
          ]
        },
        {
          "type": "_gallery-image"
        },
        {
          "type": "_gallery-image"
        },
        {
          "type": "_gallery-image"
        },
        {
          "type": "_gallery-image"
        }
      ]
    }
  ]
}
{% endschema %}
