  "name": "Horizontal scroll banners",
  "tag": "section",
  "class": "section-horizontal-banners",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Featured stories"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Desktop height",
      "default": 100
