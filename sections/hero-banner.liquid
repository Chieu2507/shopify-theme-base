{% liquid
  assign media_count = section.blocks | where: 'type', 'media' | size | at_most: 1
  assign hero_overlay_color = section.settings.overlay_color | default: '#181818'
%}

{% if section.blocks.size > 0 %}
  <section
    class="hero-banner color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %} hero-banner--content-{{ section.settings.content_position }}"
    style="--hero-height: {{ section.settings.height_desktop }}px; --hero-height-tablet: {{ section.settings.height_tablet }}px; --hero-height-mobile: {{ section.settings.height_mobile }}px; --hero-overlay-color: {{ hero_overlay_color }}; --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-content-width: {{ section.settings.content_width }}px;"
  >
    {% if media_count > 0 %}
      <div class="hero-banner__media-grid">
        {% assign media_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'media' and media_index == 0 %}
            {% assign media_index = media_index | plus: 1 %}
            <div
              class="hero-banner__media"
              style="--hero-media-position: {{ block.settings.focal_point }};"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                {% liquid
                  assign image_alt = block.settings.alt_text | default: block.settings.image.alt
                  assign image_loading = 'lazy'
                  assign image_priority = 'auto'
                  if media_index == 1 and request.page_type != 'index'
                    assign image_loading = 'eager'
                    assign image_priority = 'high'
                  elsif media_index == 1 and section.index == 1
                    assign image_loading = 'eager'
                    assign image_priority = 'high'
                  endif
                %}
                {% render 'responsive-image',
                  image: block.settings.image,
                  max_width: 2400,
                  widths: '375, 550, 750, 960, 1200, 1600, 1920, 2400',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  class: 'hero-banner__image',
                  alt: image_alt,
                  loading: image_loading,
                  fetchpriority: image_priority
                %}
              {% elsif media_index == 1 %}
                {% render 'media-placeholder', class_name: 'hero-banner__placeholder', asset_name: 'placeholder-image-default-2.svg' %}
              {% else %}
                {% render 'media-placeholder', class_name: 'hero-banner__placeholder', asset_name: 'placeholder-image-default-3.svg' %}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="hero-banner__overlay" aria-hidden="true"></div>
    {% endif %}

    <div class="hero-banner__content-positioner">
      <div class="hero-banner__content">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'heading' %}
              {% render 'spinel-type-style',
                block: block,
                content: block.settings.heading,
                kind: 'heading',
                default_preset: 'h1',
                default_font: 'heading',
                class_name: 'hero-banner__heading-block',
                content_class: 'hero-banner__heading heading'
              %}

            {% when 'text' %}
              {% render 'spinel-type-style',
                block: block,
                content: block.settings.text,
                kind: 'text',
                default_preset: 'paragraph',
                default_font: 'body',
                class_name: 'hero-banner__text',
                content_class: 'hero-banner__text-content'
              %}

            {% when 'button' %}
              {% if block.settings.label != blank %}
                {% assign hero_button_url = block.settings.link | default: routes.all_products_collection_url %}
                <div class="hero-banner__button-block" {{ block.shopify_attributes }}>
                  {% render 'cta',
                    label: block.settings.label,
                    url: hero_button_url,
                    style: block.settings.style,
                    class: 'hero-banner__button'
                  %}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .hero-banner {
    position: relative;
    display: grid;
    overflow: hidden;
    width: 100%;
    min-height: var(--hero-height-mobile);
    background: var(--gradient-background, var(--color-background));
    isolation: isolate;
  }

  .hero-banner__media-grid,
  .hero-banner__content-positioner {
    position: absolute;
    inset: 0;
  }

  .hero-banner__media-grid {
    z-index: -2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .hero-banner__media {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--color-variant-component-background);
  }

  .hero-banner__image,
  .hero-banner__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-media-position);
  }

  .hero-banner__placeholder {
    color: color-mix(in srgb, var(--color-heading) 20%, transparent);
  }

  .hero-banner__overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--hero-overlay-color);
    opacity: var(--hero-overlay-opacity);
    pointer-events: none;
  }

  .hero-banner__content-positioner {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: var(--page-margin);
    pointer-events: none;
  }

  .hero-banner--content-center-left .hero-banner__content-positioner {
    align-items: center;
  }

  .hero-banner--content-top-left .hero-banner__content-positioner,
  .hero-banner--content-top-center .hero-banner__content-positioner,
  .hero-banner--content-top-right .hero-banner__content-positioner {
    align-items: flex-start;
  }

  .hero-banner--content-bottom-center .hero-banner__content-positioner,
  .hero-banner--content-top-center .hero-banner__content-positioner,
  .hero-banner--content-center .hero-banner__content-positioner {
    justify-content: center;
    text-align: center;
  }

  .hero-banner--content-top-right .hero-banner__content-positioner,
  .hero-banner--content-center-right .hero-banner__content-positioner,
  .hero-banner--content-bottom-right .hero-banner__content-positioner {
    justify-content: flex-end;
    text-align: right;
  }

  .hero-banner--content-center-right .hero-banner__content-positioner {
    align-items: center;
  }

  .hero-banner--content-bottom-center .hero-banner__content-positioner {
    align-items: flex-end;
  }

  .hero-banner--content-center .hero-banner__content-positioner {
    align-items: center;
  }

  .hero-banner__content {
    display: flex;
    width: min(100%, var(--hero-content-width));
    flex-direction: column;
    align-items: flex-start;
    color: var(--color-text);
    pointer-events: auto;
  }

  .hero-banner--content-center .hero-banner__content {
    align-items: center;
  }

  .hero-banner--content-top-center .hero-banner__content,
  .hero-banner--content-bottom-center .hero-banner__content,
  .hero-banner--content-center .hero-banner__content {
    align-items: center;
  }

  .hero-banner--content-top-right .hero-banner__content,
  .hero-banner--content-center-right .hero-banner__content,
  .hero-banner--content-bottom-right .hero-banner__content {
    align-items: flex-end;
  }

  .hero-banner__heading {
    margin: 0;
    color: var(--color-heading);
  }

  .hero-banner__text {
    margin-top: 8px;
    color: var(--color-text);
  }

  .hero-banner__button-block {
    margin-top: 24px;
  }

  @media screen and (max-width: 749px) {
    .hero-banner__content-positioner {
      padding-block: 32px;
      width: 100%;
    }

    .hero-banner__content {
      width: min(100%, 320px);
    }

    .hero-banner__button-block {
      margin-top: 20px;
    }
  }

  @media screen and (min-width: 750px) {
    .hero-banner {
      min-height: var(--hero-height-tablet);
    }

    .hero-banner__content-positioner {
      width: 100%;
    }
  }

  @media screen and (min-width: 990px) {
    .hero-banner {
      min-height: var(--hero-height);
    }
  }
{% endstylesheet %}

