{% liquid
  assign media_count = section.blocks | where: 'type', 'media' | size | at_most: 1
  assign hero_overlay_color = section.settings.overlay_color | default: '#181818'
%}

{% if section.blocks.size > 0 %}
  <div
    class="hero-banner color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %} hero-banner--content-{{ section.settings.content_position }} hero-banner--light-sweep-{{ section.settings.light_sweep_size | default: 'medium' }}"
    style="--hero-height: {{ section.settings.height_desktop }}px; --hero-height-tablet: {{ section.settings.height_tablet }}px; --hero-height-mobile: {{ section.settings.height_mobile }}px; --hero-overlay-color: {{ hero_overlay_color }}; --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-content-width: {{ section.settings.content_width }}px; --hero-light-sweep-x: {{ section.settings.light_sweep_x_desktop }}%; --hero-light-sweep-y: {{ section.settings.light_sweep_y_desktop }}%; --hero-light-sweep-mobile-x: {{ section.settings.light_sweep_x_mobile }}%; --hero-light-sweep-mobile-y: {{ section.settings.light_sweep_y_mobile }}%;"
  >
    {% if media_count > 0 %}
      <div class="hero-banner__media-grid">
        {% assign media_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'media' and media_index == 0 %}
            {% assign media_index = media_index | plus: 1 %}
            <div
              class="hero-banner__media"
              style="--hero-media-position: {{ block.settings.focal_point }};"
              {{ block.shopify_attributes }}
            >
              {% liquid
                assign image_alt = block.settings.alt_text | default: block.settings.image.alt
                assign image_loading = 'lazy'
                assign image_priority = 'auto'
                assign hero_placeholder_asset = 'placeholder-image-default-3.svg'
                if media_index == 1
                  assign hero_placeholder_asset = 'placeholder-image-default-2.svg'
                  if request.page_type != 'index' or section.index == 1
                    assign image_loading = 'eager'
                    assign image_priority = 'high'
                  endif
                endif
              %}
              {% render 'responsive-media',
                image: block.settings.image,
                max_width: 2400,
                widths: '375, 550, 750, 960, 1200, 1600, 1920, 2400',
                sizes: '100vw',
                class: 'hero-banner__image',
                alt: image_alt,
                loading: image_loading,
                fetchpriority: image_priority,
                placeholder_asset: hero_placeholder_asset,
                placeholder_class: 'hero-banner__placeholder'
              %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="hero-banner__overlay" aria-hidden="true"></div>
    {% endif %}

    {% if section.settings.enable_light_sweep %}
      <div class="hero-banner__light-sweep" aria-hidden="true"></div>
    {% endif %}

    <div class="hero-banner__content-positioner">
      <div class="hero-banner__content">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'heading' %}
              {% if block.settings.heading != blank %}
                <div class="hero-banner__heading-block hero-banner__heading">
                  {% render 'content-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h1', default_font: 'heading' %}
                </div>
              {% endif %}

            {% when 'text' %}
              {% if block.settings.text != blank %}
                <div class="hero-banner__text">
                  {% render 'content-block', block: block, content: block.settings.text, kind: 'text', default_preset: 'md', default_font: 'body' %}
                </div>
              {% endif %}

            {% when 'button' %}
              {% if block.settings.label != blank %}
                {% assign hero_button_url = block.settings.link | default: routes.all_products_collection_url %}
                <div class="hero-banner__button-block" {{ block.shopify_attributes }}>
                  {% render 'cta',
                    label: block.settings.label,
                    url: hero_button_url,
                    style: block.settings.style,
                    class: 'hero-banner__button',
                    icon: block.settings.icon,
                    open_in_new_tab: block.settings.open_in_new_tab
                  %}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .hero-banner {
    position: relative;
    display: grid;
    overflow: hidden;
    width: 100%;
    min-height: var(--hero-height-mobile);
    background: var(--gradient-background, var(--color-background));
    isolation: isolate;
    --hero-light-sweep-size: clamp(104px, 11vw, 208px);
    --hero-light-sweep-mobile-size: clamp(88px, 28vw, 150px);
  }

  .hero-banner--light-sweep-small {
    --hero-light-sweep-size: clamp(76px, 8vw, 152px);
    --hero-light-sweep-mobile-size: clamp(66px, 20vw, 112px);
  }

  .hero-banner--light-sweep-large {
    --hero-light-sweep-size: clamp(132px, 14vw, 264px);
    --hero-light-sweep-mobile-size: clamp(110px, 34vw, 190px);
  }

  .hero-banner__media-grid,
  .hero-banner__content-positioner {
    position: absolute;
    inset: 0;
  }

  .hero-banner__media-grid {
    z-index: -2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .hero-banner__media {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--color-variant-component-background);
  }

  .hero-banner__image,
  .hero-banner__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-media-position);
  }

  .hero-banner__placeholder {
    color: color-mix(in srgb, var(--color-heading) 20%, transparent);
  }

  .hero-banner__overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--hero-overlay-color);
    opacity: var(--hero-overlay-opacity);
    pointer-events: none;
  }

  .hero-banner__light-sweep {
    position: absolute;
    z-index: 0;
    top: var(--hero-light-sweep-y);
    left: var(--hero-light-sweep-x);
    width: var(--hero-light-sweep-size);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero-banner__light-sweep::before,
  .hero-banner__light-sweep::after {
    position: absolute;
    content: '';
    pointer-events: none;
  }

  .hero-banner__light-sweep::before {
    inset: -70%;
    background: linear-gradient(118deg, transparent 44%, rgb(255 255 255 / 0) 47%, rgb(255 255 255 / 0.85) 49.5%, rgb(255 249 223 / 0.96) 50%, rgb(255 255 255 / 0.85) 50.5%, rgb(255 255 255 / 0) 53%, transparent 56%);
    filter: blur(1px);
    animation: hero-banner-light-sweep 5.6s cubic-bezier(.22, 1, .36, 1) infinite;
  }

  .hero-banner__light-sweep::after {
    inset: 35%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 255 255 / 0.98) 0, rgb(255 247 205 / 0.7) 16%, rgb(255 236 159 / 0.18) 38%, transparent 70%);
    box-shadow: 0 0 18px 6px rgb(255 231 147 / 0.22);
    animation: hero-banner-light-spark 5.6s ease-in-out infinite;
  }

  @keyframes hero-banner-light-sweep {
    0%, 18% {
      opacity: 0;
      transform: translateX(-46%);
    }

    28% {
      opacity: 0.9;
    }

    52% {
      opacity: 0.8;
      transform: translateX(46%);
    }

    62%, 100% {
      opacity: 0;
      transform: translateX(46%);
    }
  }

  @keyframes hero-banner-light-spark {
    0%, 24%, 60%, 100% {
      opacity: 0;
      transform: scale(0.35);
    }

    36%, 48% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .hero-banner__content-positioner {
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: var(--page-margin);
    pointer-events: none;
  }

  .hero-banner--content-center-left .hero-banner__content-positioner {
    align-items: center;
  }

  .hero-banner--content-top-left .hero-banner__content-positioner,
  .hero-banner--content-top-center .hero-banner__content-positioner,
  .hero-banner--content-top-right .hero-banner__content-positioner {
    align-items: flex-start;
  }

  .hero-banner--content-bottom-center .hero-banner__content-positioner,
  .hero-banner--content-top-center .hero-banner__content-positioner,
  .hero-banner--content-center .hero-banner__content-positioner {
    justify-content: center;
    text-align: center;
  }

  .hero-banner--content-top-right .hero-banner__content-positioner,
  .hero-banner--content-center-right .hero-banner__content-positioner,
  .hero-banner--content-bottom-right .hero-banner__content-positioner {
    justify-content: flex-end;
    text-align: right;
  }

  .hero-banner--content-center-right .hero-banner__content-positioner {
    align-items: center;
  }

  .hero-banner--content-bottom-center .hero-banner__content-positioner {
    align-items: flex-end;
  }

  .hero-banner--content-center .hero-banner__content-positioner {
    align-items: center;
  }

  .hero-banner__content {
    display: flex;
    width: min(100%, var(--hero-content-width));
    flex-direction: column;
    align-items: flex-start;
    color: var(--color-text);
    pointer-events: auto;
  }

  .hero-banner--content-center .hero-banner__content {
    align-items: center;
  }

  .hero-banner--content-top-center .hero-banner__content,
  .hero-banner--content-bottom-center .hero-banner__content,
  .hero-banner--content-center .hero-banner__content {
    align-items: center;
  }

  .hero-banner--content-top-right .hero-banner__content,
  .hero-banner--content-center-right .hero-banner__content,
  .hero-banner--content-bottom-right .hero-banner__content {
    align-items: flex-end;
  }

  .hero-banner__heading {
    margin: 0;
    color: var(--color-heading);
  }

  .hero-banner__text {
    margin-top: 8px;
    color: var(--color-text);
  }

  .hero-banner__button-block {
    margin-top: 24px;
  }

  @media screen and (max-width: 767.98px) {
    .hero-banner__light-sweep {
      top: var(--hero-light-sweep-mobile-y);
      left: var(--hero-light-sweep-mobile-x);
      width: var(--hero-light-sweep-mobile-size);
    }

    .hero-banner__content-positioner {
      padding-block: 32px;
      width: 100%;
    }

    .hero-banner__content {
      width: min(100%, 320px);
    }

    .hero-banner__button-block {
      margin-top: 20px;
    }
  }

  @media screen and (min-width: 768px) {
    .hero-banner {
      min-height: var(--hero-height-tablet);
    }

    .hero-banner__content-positioner {
      width: 100%;
    }
  }

  @media screen and (min-width: 1150px) {
    .hero-banner {
      min-height: var(--hero-height);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner__light-sweep::before,
    .hero-banner__light-sweep::after {
      animation: none;
    }

    .hero-banner__light-sweep::before {
      opacity: 0.48;
      transform: none;
    }

    .hero-banner__light-sweep::after {
      opacity: 0.72;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
