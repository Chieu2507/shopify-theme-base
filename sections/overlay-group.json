{
  "type": "custom.overlay",
  "name": "Overlay group",
  "sections": {
    "cart-drawer": {
      "type": "cart-drawer",
      "settings": {
        "title": "Cart",
        "title_size": "md",
        "show_cart_count": true,
        "enable_share_cart": false,
        "enable_block_animations": true,
        "title_line_limit": "none",
        "show_sale_price_first": true,
        "product_cards": false,
        "enable_back_in_stock_alert": false,
        "cart_icon": "cart",
        "enable_padding_desktop": true,
        "enable_padding_mobile": true,
        "free_shipping_enable": true,
        "free_shipping_threshold": 100,
        "progress_bar_color": "#d92d2d",
        "free_shipping_success_color": "#5d874f",
        "show_amount_range": true,
        "free_shipping_pending_message": "You are {amount} away from free shipping!",
        "free_shipping_success_message": "Congratulations! You are eligible for free shipping!",
        "promotion_enable": true,
        "promotion_message": "Use coupon code [code] for 10% off your first order.",
        "promotion_code": "CODE10",
        "promotion_action_label": "Use coupon",
        "color_scheme": "scheme-1",
        "desktop_width": 550,
        "show_recommendations": true,
        "recommendations_heading": "You may also like",
        "recommendations_limit": 4,
        "show_discount": true,
        "show_order_note": true,
        "order_note_label": "Order note",
        "order_note_placeholder": "Add a note to your order",
        "order_note_save_label": "Save note",
        "show_shipping_estimator": true,
        "shipping_estimator_label": "Estimate shipping",
        "discount_label": "Discount",
        "total_label": "Estimated total",
        "checkout_label": "Checkout"
      }
    },
    "search": {
      "type": "search-overlay",
      "settings": {
        "appearance_type": "inherit",
        "color_scheme": "scheme-1",
        "placeholder": "Search for...",
        "placeholder_suggestions": "",
        "show_products": true,
        "show_collections": true,
        "show_blog_posts": true,
        "show_pages": true,
        "view_all_style": "primary"
      }
    }
  },
  "order": [
    "cart-drawer",
    "search"
  ]
}
