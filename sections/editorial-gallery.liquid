<section
  class="np-gallery full-width color-scheme color-{{ section.settings.color_scheme.id }}"
  style="--np-gallery-cta-background: {{ section.settings.cta_background }};"
>
  <div class="np-gallery__grid">
    <div class="np-gallery__cta">
      <div class="np-gallery__cta-content">
        {% if section.settings.heading != blank %}
          <h2 class="np-gallery__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% render 'cta',
          label: section.settings.button_label,
          url: section.settings.button_link,
          style: 'tertiary',
          class: 'np-gallery__button'
        %}
      </div>
    </div>

    {% for block in section.blocks %}
      {% liquid
        assign gallery_alt = block.settings.image_alt | default: block.settings.image.alt
      %}
      <div class="np-gallery__item np-gallery__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}<a class="np-gallery__link" href="{{ block.settings.link }}">{% endif %}
          {% if block.settings.image != blank %}
            {% render 'responsive-image',
              image: block.settings.image,
              max_width: 960,
              widths: '188, 280, 384, 480, 640, 768, 960',
              sizes: '(min-width: 750px) 20vw, 50vw',
              class: 'np-gallery__image',
              loading: 'lazy',
              alt: gallery_alt
            %}
          {% else %}
            {% render 'media-placeholder', class_name: 'np-gallery__placeholder', asset_name: 'placeholder-image-default-1.svg' %}
          {% endif %}
        {% if block.settings.link != blank %}</a>{% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .np-gallery {
    display: block;
    overflow: hidden;
    background: #fff;
  }

  .np-gallery__grid {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-rows: auto;
  }

  .np-gallery__cta,
  .np-gallery__item {
    min-width: 0;
    aspect-ratio: 1;
  }

  .np-gallery__cta {
    display: flex;
    grid-column: 3;
    grid-row: 1;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    background: var(--np-gallery-cta-background, #181818);
  }

  .np-gallery__cta-content {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .np-gallery__heading {
    width: 100%;
    margin: 0;
    color: #fff;
    font-family: var(--font-heading--family);
    font-size: 32px;
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    letter-spacing: 2px;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .np-gallery__button {
    color: #fff;
    border-bottom-color: #fff;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.6px;
    line-height: 1.5;
  }

  .np-gallery__item {
    overflow: hidden;
    background: #f6f6f6;
  }

  .np-gallery__item--1 {
    grid-column: 1;
    grid-row: 1;
  }

  .np-gallery__item--2 {
    grid-column: 2;
    grid-row: 1;
  }

  .np-gallery__item--3 {
    grid-column: 4;
    grid-row: 1;
  }

  .np-gallery__item--4 {
    grid-column: 5;
    grid-row: 1;
  }

  .np-gallery__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .np-gallery__link:focus-visible {
    outline: 2px solid #181818;
    outline-offset: -3px;
  }

  .np-gallery__image,
  .np-gallery__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .np-gallery__link:hover .np-gallery__image {
      transform: scale(1.015);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .np-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .np-gallery__cta {
      grid-column: 2;
    }

    .np-gallery__item--1 {
      grid-column: 1;
    }

    .np-gallery__item--2 {
      grid-column: 3;
    }

    .np-gallery__item--3,
    .np-gallery__item--4 {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .np-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .np-gallery__cta {
      min-height: 228px;
      aspect-ratio: auto;
      grid-column: 1 / -1;
      grid-row: auto;
      padding: 80px 24px;
    }

    .np-gallery__heading {
      font-size: 24px;
    }

    .np-gallery__item--1,
    .np-gallery__item--2,
    .np-gallery__item--3,
    .np-gallery__item--4 {
      grid-column: auto;
      grid-row: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial gallery",
  "tag": "section",
  "class": "section-noryvelle-gallery",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "CTA background",
      "default": "#181818"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our community"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Follow us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial gallery",
      "blocks": [
        {"type": "image"},
        {"type": "image"},
        {"type": "image"},
        {"type": "image"}
      ]
    }
  ]
}
{% endschema %}
