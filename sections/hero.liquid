{% liquid
  assign hero_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign hero_scheme = section.settings.color_scheme.id
  endif
  assign hero_scheme = hero_scheme | default: 'scheme-1' | handleize
%}

<div class="section-spacing hero color-scheme section-color-scope {{ hero_scheme }}">
  <div class="hero__media{% if section.settings.banner_image == blank %} hero__media--placeholder placeholder-image{% endif %}" aria-hidden="true">
    {% if section.settings.banner_image != blank %}
      <picture>
        {% if section.settings.mobile_banner_image != blank %}
          <source
            media="(max-width: 767.98px)"
            srcset="{{ section.settings.mobile_banner_image | image_url: width: 1200 }}"
          >
        {% endif %}
        {{ section.settings.banner_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {% endif %}
  </div>

  <div class="container full-width hero__container">
    <div class="hero__content align-content">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    min-height: 720px;
    overflow: clip;
    background: var(--background-color);
    color: var(--body-color);
  }

  .hero__media,
  .hero__media picture,
  .hero__media img,
  .hero__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__media {
    pointer-events: none;
  }

  .hero__media img,
  .hero__placeholder {
    object-fit: cover;
  }

  .hero__placeholder {
    z-index: 0;
    background-color: transparent;
    color: var(--heading-color);
  }

  .hero__container {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: inherit;
  }

  .hero__content {
    --flex-align: center;
    justify-content: center;
    gap: var(--layout-grid-gap, 1rem);
    width: min(100%, 48rem);
    min-height: inherit;
    margin-inline: auto;
    padding-block: clamp(4rem, 10vw, 9rem);
    color: var(--body-color);
  }

  .hero__content :is(.heading-block, .text-block) {
    text-align: center;
  }

  @media (max-width: 767.98px) {
    .hero {
      min-height: 620px;
    }

    .hero__content {
      padding-block: 4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 50,
  "blocks": [
    { "type": "header" },
    { "type": "eyebrow" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "image" },
    { "type": "video" },
    { "type": "button" },
    { "type": "buttons" },
    { "type": "icon" },
    { "type": "divider" },
    { "type": "spacer" },
    { "type": "scroll-to" },
    { "type": "group" },
    { "type": "row" },
    { "type": "grid" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.media"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "t:labels.banner_image"
    },
    {
      "type": "image_picker",
      "id": "mobile_banner_image",
      "label": "t:labels.mobile_banner_image"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "t:general.hero",
      "settings": {
        "color_scheme": "scheme-1"
      },
      "blocks": [
        {
          "type": "eyebrow",
          "settings": { "text": "<p>The new chapter</p>" }
        },
        {
          "type": "heading",
          "settings": {
            "text": "<p>A world of light.<br>A jewel of your own.</p>",
            "heading_size": "display",
            "html_tag": "h1",
            "width": "custom",
            "max_width": 800
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Meet Octavia. Colour held in a precise geometry, made to become part of your story.</p>",
            "text_size": "sm",
            "width": "custom",
            "max_width": 480
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Discover Octavia",
            "button_style": "primary"
          }
        },
        {
          "type": "spacer",
          "settings": {
            "unit_desktop": "pixel",
            "size_desktop_px": 56,
            "show_on_mobile": true,
            "unit_mobile": "pixel",
            "size_mobile_px": 40
          }
        },
        {
          "type": "eyebrow",
          "settings": { "text": "<p>Octavia three-stone ring / Two-hand gesture / Copy center</p>" }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Focus 216.5 / 165 + 181.2 carat / Octavia / Enamel / Gold / Solid 925</p>",
            "text_size": "xs"
          }
        },
        {
          "type": "scroll-to",
          "settings": {
            "button_label": "Scroll to discover",
            "target_section_number": 2,
            "button_style": "tertiary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
