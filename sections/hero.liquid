{% liquid
  assign hero_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign hero_scheme = section.settings.color_scheme.id
  endif
  assign hero_scheme = hero_scheme | default: 'scheme-1' | handleize

  assign hero_width = section.settings.width | default: 'full_no_padding'
  unless hero_width == 'page' or hero_width == 'full' or hero_width == 'full_no_padding'
    assign hero_width = 'full_no_padding'
  endunless
  assign hero_container_class = 'full-width'
  if hero_width == 'page'
    assign hero_container_class = 'page-width'
  elsif hero_width == 'full_no_padding'
    assign hero_container_class = 'hero__container--full-bleed'
  endif

  assign hero_layout = section.settings.layout | default: 'classic'
  unless hero_layout == 'classic' or hero_layout == 'split'
    assign hero_layout = 'classic'
  endunless
  assign hero_media_type = section.settings.media_type | default: 'image'
  unless hero_media_type == 'image' or hero_media_type == 'video'
    assign hero_media_type = 'image'
  endunless

  assign hero_desktop_height = section.settings.desktop_height | default: 'medium'
  unless hero_desktop_height == 'small' or hero_desktop_height == 'medium' or hero_desktop_height == 'large' or hero_desktop_height == 'full_screen'
    assign hero_desktop_height = 'medium'
  endunless
  assign hero_mobile_height = section.settings.mobile_height | default: 'adapt'
  unless hero_mobile_height == 'adapt' or hero_mobile_height == 'small' or hero_mobile_height == 'medium' or hero_mobile_height == 'large' or hero_mobile_height == 'full_screen'
    assign hero_mobile_height = 'adapt'
  endunless

  assign hero_desktop_position = section.settings.desktop_position | default: 'bottom_left'
  assign hero_mobile_position = section.settings.mobile_position | default: 'center_center'
  assign hero_desktop_gap = section.settings.desktop_gap | default: 12 | plus: 0
  assign hero_mobile_gap = section.settings.mobile_gap | default: 12 | plus: 0
%}

{% capture hero_style %}
  {% if hero_desktop_gap != 12 %}--hero-content-gap: {{ hero_desktop_gap }}px;{% endif %}
  {% if hero_mobile_gap != hero_desktop_gap %}--hero-content-gap-mobile: {{ hero_mobile_gap }}px;{% endif %}
  {% if section.settings.overlay_color != blank %}--hero-overlay-color: {{ section.settings.overlay_color }};{% endif %}
{% endcapture %}

<div
  class="section-spacing hero hero--{{ hero_layout }} hero--desktop-{{ hero_desktop_height }} hero--mobile-{{ hero_mobile_height }} color-scheme section-color-scope {{ hero_scheme }}"
  {% if section.settings.allow_transparent_header %}data-hero-transparent-header{% endif %}
  {% if section.settings.parallax_effect == 'scroll' %}data-hero-parallax{% endif %}
  {% if hero_style != blank %}style="{{ hero_style | strip }}"{% endif %}
>
  <div class="hero__media{% if hero_media_type == 'image' and section.settings.banner_image == blank or hero_media_type == 'video' and section.settings.video == blank %} hero__media--placeholder placeholder-image{% endif %}" aria-hidden="true" data-hero-media>
    {% if hero_media_type == 'video' and section.settings.video != blank %}
      {{ section.settings.video | video_tag: image_size: '2400x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'hero__video hero__video--desktop' }}
      {% if section.settings.mobile_video != blank %}
        {{ section.settings.mobile_video | video_tag: image_size: '1200x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'hero__video hero__video--mobile' }}
      {% endif %}
    {% elsif hero_media_type == 'image' and section.settings.banner_image != blank %}
      <picture>
        {% if section.settings.mobile_banner_image != blank %}
          <source
            media="(max-width: 767.98px)"
            srcset="{{ section.settings.mobile_banner_image | image_url: width: 1200 }}"
          >
        {% endif %}
        {{ section.settings.banner_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {% endif %}
  </div>

  {% if section.settings.show_overlay %}<div class="hero__overlay" aria-hidden="true"></div>{% endif %}
  {% if section.settings.link != blank %}<a class="hero__link" href="{{ section.settings.link }}"{% if section.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ 'general.hero' | t | escape }}"></a>{% endif %}

  <div class="container {{ hero_container_class }} hero__container">
    <div class="hero__content hero__content--desktop-{{ hero_desktop_position }} hero__content--mobile-{{ hero_mobile_position }}{% if section.settings.content_full_width %} hero__content--full-width{% endif %}{% if section.settings.enable_sticky %} hero__content--sticky{% endif %} align-content">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    min-height: var(--hero-min-height, 72rem);
    overflow: clip;
    background: var(--background-color);
    color: var(--body-color);
  }

  .hero--desktop-small { --hero-min-height: 56rem; }
  .hero--desktop-medium { --hero-min-height: 72rem; }
  .hero--desktop-large { --hero-min-height: 90rem; }
  .hero--desktop-full_screen { --hero-min-height: 100svh; }

  .hero__media,
  .hero__media picture,
  .hero__media img,
  .hero__placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__media {
    z-index: 0;
    pointer-events: none;
    will-change: transform;
  }

  .hero__media img,
  .hero__media video,
  .hero__placeholder {
    object-fit: cover;
  }

  .hero__video--mobile {
    display: none;
  }

  .hero__placeholder {
    z-index: 0;
    background-color: transparent;
    color: var(--heading-color);
  }

  .hero__container {
    position: relative;
    z-index: 3;
    display: grid;
    min-height: inherit;
  }

  .hero__container--full-bleed {
    width: 100%;
    max-width: none;
  }

  .hero__overlay,
  .hero__link {
    position: absolute;
    inset: 0;
  }

  .hero__overlay {
    z-index: 1;
    pointer-events: none;
    background-color: var(--hero-overlay-color, #000);
    opacity: .35;
  }

  .hero__link {
    z-index: 2;
  }

  .hero__content {
    gap: var(--hero-content-gap, 1.2rem);
    width: min(100%, 48rem);
    min-height: inherit;
    padding: clamp(4rem, 8vw, 9rem);
    color: var(--body-color);
  }

  .hero__content--full-width {
    width: 100%;
    max-width: none;
  }

  .hero__content--desktop-top_left { --flex-align: start; place-self: start; }
  .hero__content--desktop-top_center { --flex-align: center; place-self: start center; }
  .hero__content--desktop-top_right { --flex-align: end; place-self: start end; }
  .hero__content--desktop-center_left { --flex-align: start; place-self: center start; }
  .hero__content--desktop-center_center { --flex-align: center; place-self: center; }
  .hero__content--desktop-center_right { --flex-align: end; place-self: center end; }
  .hero__content--desktop-bottom_left { --flex-align: start; place-self: end start; }
  .hero__content--desktop-bottom_center { --flex-align: center; place-self: end center; }
  .hero__content--desktop-bottom_right { --flex-align: end; place-self: end; }

  .hero__content--sticky {
    position: sticky;
    top: calc(var(--header-height, 0px) + 2rem);
    align-self: start;
  }

  .hero--split {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero--split .hero__media {
    position: relative;
    grid-column: 1;
    min-height: inherit;
  }

  .hero--split .hero__container {
    grid-column: 2;
  }

  .hero--split .hero__content {
    width: 100%;
  }

  body:has(#MainContent > .shopify-section:first-child .hero[data-hero-transparent-header]) .section-header.header {
    z-index: var(--z-drawer);
    margin-block-end: calc(var(--header-height, 0px) * -1);
    background-color: transparent;
  }

  body:has(#MainContent > .shopify-section:first-child .hero[data-hero-transparent-header]) .section-header.header .header-top {
    background-color: transparent;
  }

  @media (max-width: 767.98px) {
    .hero--mobile-adapt { --hero-min-height: auto; }
    .hero--mobile-small { --hero-min-height: 48rem; }
    .hero--mobile-medium { --hero-min-height: 62rem; }
    .hero--mobile-large { --hero-min-height: 76rem; }
    .hero--mobile-full_screen { --hero-min-height: 100svh; }

    .hero__content {
      gap: var(--hero-content-gap-mobile, var(--hero-content-gap, 1.2rem));
      min-height: var(--hero-min-height, auto);
      padding: 4rem;
    }

    .hero__content--mobile-top_left { --flex-align-mobile: start; place-self: start; }
    .hero__content--mobile-top_center { --flex-align-mobile: center; place-self: start center; }
    .hero__content--mobile-top_right { --flex-align-mobile: end; place-self: start end; }
    .hero__content--mobile-center_left { --flex-align-mobile: start; place-self: center start; }
    .hero__content--mobile-center_center { --flex-align-mobile: center; place-self: center; }
    .hero__content--mobile-center_right { --flex-align-mobile: end; place-self: center end; }
    .hero__content--mobile-bottom_left { --flex-align-mobile: start; place-self: end start; }
    .hero__content--mobile-bottom_center { --flex-align-mobile: center; place-self: end center; }
    .hero__content--mobile-bottom_right { --flex-align-mobile: end; place-self: end; }

    .hero__content--sticky {
      position: relative;
      top: auto;
    }

    .hero--split {
      grid-template-columns: 1fr;
    }

    .hero--split .hero__media,
    .hero--split .hero__container {
      grid-column: 1;
      grid-row: 1;
    }

    .hero--split .hero__media {
      position: absolute;
    }

    .hero__video--desktop:has(+ .hero__video--mobile) {
      display: none;
    }

    .hero__video--mobile {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media { transform: none !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 50,
  "blocks": [
    { "type": "header" },
    { "type": "eyebrow" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "image" },
    { "type": "video" },
    { "type": "button" },
    { "type": "buttons" },
    { "type": "icon" },
    { "type": "divider" },
    { "type": "spacer" },
    { "type": "scroll-to" },
    { "type": "group" },
    { "type": "row" },
    { "type": "grid" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.media"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "t:labels.banner_image"
    },
    {
      "type": "image_picker",
      "id": "mobile_banner_image",
      "label": "t:labels.mobile_banner_image"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "t:general.hero",
      "settings": {
        "color_scheme": "scheme-1"
      },
      "blocks": [
        {
          "type": "eyebrow",
          "settings": { "text": "<p>The new chapter</p>" }
        },
        {
          "type": "heading",
          "settings": {
            "text": "<p>A world of light.<br>A jewel of your own.</p>",
            "heading_size": "display",
            "html_tag": "h1",
            "width": "custom",
            "max_width": 800
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Meet Octavia. Colour held in a precise geometry, made to become part of your story.</p>",
            "text_size": "sm",
            "width": "custom",
            "max_width": 480
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Discover Octavia",
            "button_style": "primary"
          }
        },
        {
          "type": "spacer",
          "settings": {
            "unit_desktop": "pixel",
            "size_desktop_px": 56,
            "show_on_mobile": true,
            "unit_mobile": "pixel",
            "size_mobile_px": 40
          }
        },
        {
          "type": "eyebrow",
          "settings": { "text": "<p>Octavia three-stone ring / Two-hand gesture / Copy center</p>" }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Focus 216.5 / 165 + 181.2 carat / Octavia / Enamel / Gold / Solid 925</p>",
            "text_size": "xs"
          }
        },
        {
          "type": "scroll-to",
          "settings": {
            "button_label": "Scroll to discover",
            "target_section_number": 2,
            "button_style": "tertiary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
