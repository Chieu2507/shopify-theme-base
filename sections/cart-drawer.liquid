{% liquid
  assign cart_drawer_scheme = section.settings.color_scheme.id | default: 'scheme-1'
  assign cart_price_font = section.settings.price_font | default: 'subheading'
  assign cart_title_case = section.settings.product_title_case | default: 'none'
  assign cart_image_radius = section.settings.image_radius | default: 0
  assign empty_cart_link = section.settings.empty_link | default: routes.all_products_collection_url
  assign has_cart_addons = false

  for block in section.blocks
    assign addon_variant = block.settings.product.selected_or_first_available_variant
    if addon_variant != blank
      assign has_cart_addons = true
      break
    endif
  endfor
%}

{% if settings.cart_action == 'drawer' %}
  <cart-drawer
    id="CartDrawer"
    class="cart-drawer color-scheme color-{{ cart_drawer_scheme }}{% if section.settings.indent_desktop %} cart-drawer--indented{% endif %}{% if section.settings.blur_backdrop %} cart-drawer--blurred{% endif %}"
    data-cart-drawer
    data-section-id="{{ section.id }}"
    style="--cart-drawer-width: {{ section.settings.desktop_width }}px; --cart-product-title-case: {{ cart_title_case }}; --cart-price-font-family: var(--font-{{ cart_price_font }}--family); --cart-price-font-style: var(--font-{{ cart_price_font }}--style); --cart-price-font-weight: var(--font-{{ cart_price_font }}--weight); --cart-image-radius: {{ cart_image_radius }}px; --cart-promotion-speed: {{ section.settings.promotion_speed }}s;"
    data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    data-show-currency-code="{{ settings.show_currency_code }}"
    data-cart-update-url="{{ routes.cart_update_url | escape }}.js"
    data-auto-open="{{ section.settings.auto_open }}"
    data-recommendations-enabled="{{ section.settings.complementary_products_enable }}"
    data-recommendations-source="{{ section.settings.complementary_products_source }}"
    data-recommendations-limit="{{ section.settings.complementary_products_limit }}"
    data-recommendations-auto-rotate="{{ section.settings.complementary_products_auto_rotate }}"
    data-recommendations-interval="{{ section.settings.complementary_products_interval }}"
    data-recommendations-pause-on-hover="{{ section.settings.complementary_products_pause_on_hover }}"
    data-discount-enabled="{{ section.settings.show_discount }}"
    data-order-note-enabled="{{ section.settings.show_note }}"
    data-shipping-threshold="{{ section.settings.free_shipping_threshold | times: 100 }}"
    data-empty-label="{{ section.settings.empty_heading | escape }}"
    data-empty-link="{{ empty_cart_link | escape }}"
    data-empty-link-label="{{ section.settings.empty_button_label | escape }}"
    data-empty-image="{% if section.settings.empty_image != blank %}{{ section.settings.empty_image | image_url: width: 1200 }}{% endif %}"
    data-empty-image-ratio="{{ section.settings.empty_image_ratio }}"
    data-decrease-quantity-label="{{ 'quantity.decrease' | t | escape }}"
    data-increase-quantity-label="{{ 'quantity.increase' | t | escape }}"
    data-related-product-label="{{ 'cart_drawer.related_product' | t: index: '__index__' | escape }}"
    data-remove-label="{{ 'cart_drawer.remove' | t | escape }}"
    data-add-to-cart-label="{{ 'cart_drawer.add_to_cart' | t | escape }}"
    data-choose-options-label="{{ 'product_card.choose_options' | t | escape }}"
    data-adding-label="{{ 'cart_drawer.adding' | t | escape }}"
    data-updating-label="{{ 'cart_drawer.updating' | t | escape }}"
    data-applying-discount-label="{{ 'cart_drawer.applying_discount' | t | escape }}"
    data-discount-applied-label="{{ 'cart_drawer.discount_applied' | t | escape }}"
    data-saving-note-label="{{ 'cart_drawer.saving_note' | t | escape }}"
    data-note-saved-label="{{ 'cart_drawer.note_saved' | t | escape }}"
    data-cart-unavailable-label="{{ 'cart_drawer.cart_unavailable' | t | escape }}"
    data-cart-update-error-label="{{ 'cart_drawer.cart_update_error' | t | escape }}"
    data-related-product-error-label="{{ 'cart_drawer.related_product_error' | t | escape }}"
    data-discount-error-label="{{ 'cart_drawer.discount_error' | t | escape }}"
    data-note-error-label="{{ 'cart_drawer.note_error' | t | escape }}"
    data-taxes-included-label="{{ 'cart.taxes_included' | t | escape }}"
    data-taxes-note-label="{{ 'cart_drawer.taxes_note' | t | escape }}"
    data-shipping-calculating-label="{{ 'cart_drawer.shipping_calculating' | t | escape }}"
    data-shipping-error-label="{{ 'cart_drawer.shipping_error' | t | escape }}"
    data-shipping-province-placeholder="{{ 'cart_drawer.select_state' | t | escape }}"
    hidden
    {{ section.shopify_attributes }}
  >
    <span class="cart-drawer__overlay header__menu-overlay header__menu-overlay--mobile" data-cart-drawer-overlay aria-hidden="true"></span>
    <span class="cart-drawer__backdrop-pointer modal-backdrop-pointer modal-close-button close-icon" aria-hidden="true"></span>
    <aside class="cart-drawer__panel modal-drag-target" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
      <header class="cart-drawer__header">
        <h2 id="CartDrawerTitle" class="cart-drawer__title heading-h2 heading-text">{{ section.settings.heading | escape }}</h2>
        <button class="cart-drawer__close modal-close-button close-icon" type="button" aria-label="{{ 'cart_drawer.close' | t | default: 'Close cart' | escape }}" data-cart-drawer-close></button>
      </header>

      {% if section.settings.free_shipping_enable %}
        <div class="cart-drawer__shipping-progress" data-cart-drawer-shipping-progress hidden>
          <p data-cart-drawer-shipping-message></p>
          <span class="cart-drawer__shipping-progress-track" aria-hidden="true"><span data-cart-drawer-shipping-progress-value></span></span>
        </div>
        <template data-cart-drawer-shipping-copy data-pending="{{ section.settings.free_shipping_pending_message | escape }}" data-success="{{ section.settings.free_shipping_success_message | escape }}"></template>
      {% endif %}

      {% if section.settings.promotion_enable and section.settings.promotion_message != blank %}
        <div class="cart-drawer__promotion cart-drawer__promotion--{{ section.settings.promotion_direction }}{% if section.settings.promotion_uppercase %} cart-drawer__promotion--uppercase{% endif %}"{% if section.settings.promotion_pause_on_hover %} data-cart-drawer-promotion-pause{% endif %}>
          <div class="cart-drawer__promotion-track"><span>{{ section.settings.promotion_message | escape }}</span><span aria-hidden="true">{{ section.settings.promotion_message | escape }}</span></div>
        </div>
      {% endif %}

      <div class="cart-drawer__body">
        <p class="cart-drawer__status visually-hidden" data-cart-drawer-status role="status" aria-live="polite" hidden></p>
        <div class="cart-drawer__loading" data-cart-drawer-loading hidden aria-hidden="true"><span class="cart-drawer__loading-spinner"></span></div>
        <div class="cart-drawer__items" data-cart-drawer-items></div>

        {% if has_cart_addons %}
          <section class="cart-drawer__addons" data-cart-drawer-addons hidden aria-label="{{ 'cart_drawer.add_ons' | t | escape }}">
            {% for block in section.blocks %}
              {% assign addon_variant = block.settings.product.selected_or_first_available_variant %}
              {% if addon_variant != blank %}
                <label class="cart-drawer__addon" data-cart-drawer-addon-wrapper {{ block.shopify_attributes }}>
                  <input type="checkbox" data-cart-drawer-addon data-variant-id="{{ addon_variant.id }}">
                  <span class="cart-drawer__addon-icon" aria-hidden="true">{% if block.type == 'gift_wrap' %}{% render 'icon', name: 'sparkles' %}{% else %}{% render 'icon', name: 'shield' %}{% endif %}</span>
                  <span><strong>{{ block.settings.label | escape }}</strong>{% if block.settings.description != blank %}<small>{{ block.settings.description | escape }}</small>{% endif %}</span>
                  <span class="cart-drawer__addon-price">{% render 'money', amount: addon_variant.price %}</span>
                </label>
              {% endif %}
            {% endfor %}
          </section>
        {% endif %}

        {% if section.settings.complementary_products_enable %}
          <section class="cart-drawer__recommendations" data-cart-drawer-recommendations hidden aria-labelledby="CartDrawerRecommendationsTitle">
            <div class="cart-drawer__section-heading">
              <h3 id="CartDrawerRecommendationsTitle" class="heading-h3 heading-text">{{ section.settings.complementary_products_heading | escape }}</h3>
              <div class="cart-drawer__recommendation-dots" data-cart-drawer-recommendation-dots role="group" aria-label="{{ section.settings.complementary_products_heading | escape }}"></div>
            </div>
            <div id="CartDrawerRecommendations-{{ section.id }}" class="cart-drawer__recommendation-list swiper" data-cart-drawer-recommendation-list>
              <div class="cart-drawer__recommendation-track swiper-wrapper" data-cart-drawer-recommendation-track></div>
            </div>
          </section>
          {% if section.settings.complementary_products_source == 'manual' %}
            <script type="application/json" data-cart-drawer-complementary-products>
              [
                {% for product in section.settings.complementary_products %}
                  {% assign variant = product.selected_or_first_available_variant %}
                  {"id":{{ product.id | json }},"title":{{ product.title | json }},"url":{{ product.url | json }},"featured_image":{{ product.featured_image | image_url: width: 360 | json }},"price":{{ variant.price | default: product.price | json }},"available":{{ variant.available | json }},"variant_id":{{ variant.id | json }}}{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            </script>
          {% endif %}
        {% endif %}
      </div>

      <footer class="cart-drawer__footer" data-cart-drawer-footer hidden>
        {% if section.settings.show_note or section.settings.show_discount or section.settings.shipping_estimator_enable %}
          <button class="cart-drawer__order-options-toggle" type="button" aria-expanded="false" aria-controls="CartDrawerOrderOptions-{{ section.id }}" data-cart-drawer-order-options-toggle>
            <span class="cart-drawer__order-options-toggle-icon" aria-hidden="true">{% render 'icon', name: 'filter-sliders' %}</span>
            <span>{{ section.settings.order_options_label | default: 'Order options' | escape }}</span>
          </button>
          <section id="CartDrawerOrderOptions-{{ section.id }}" class="cart-drawer__order-options-panel" data-cart-drawer-order-options aria-hidden="true" aria-labelledby="CartDrawerOrderOptionsTitle-{{ section.id }}">
            <div class="quick-view__handle cart-drawer__order-options-handle" data-cart-drawer-order-options-handle aria-hidden="true"></div>
            <header class="cart-drawer__order-options-header">
              <h3 id="CartDrawerOrderOptionsTitle-{{ section.id }}" class="heading-h3 heading-text">{{ section.settings.order_options_label | default: 'Order options' | escape }}</h3>
              <button class="cart-drawer__order-options-close modal-close-button close-icon" type="button" aria-label="Close order options" data-cart-drawer-order-options-close></button>
            </header>
            <div class="cart-drawer__order-options-content">
              {% if section.settings.show_note %}
                <details class="cart-drawer__note"{% if section.settings.note_expanded %} open{% endif %}>
                  <summary>{{ section.settings.note_label | escape }}</summary>
                  <textarea rows="3" data-cart-drawer-note aria-label="{{ section.settings.note_label | escape }}" placeholder="{{ section.settings.note_placeholder | escape }}"></textarea>
                  <button type="button" class="cart-drawer__text-button" data-cart-drawer-save-note>{{ section.settings.note_save_label | escape }}</button>
                </details>
              {% endif %}

              {% if section.settings.shipping_estimator_enable %}
                <details class="cart-drawer__shipping-estimator">
                  <summary>{{ section.settings.shipping_estimator_label | escape }}</summary>
                  <form data-cart-drawer-shipping-estimator>
                    <label><span>{{ section.settings.shipping_estimator_country_label | escape }}</span><select name="country" data-cart-drawer-shipping-country data-default-country="{{ localization.country.name | escape }}" required>{{ all_country_option_tags }}</select></label>
                    <label data-cart-drawer-shipping-province-field hidden><span>{{ section.settings.shipping_estimator_province_label | escape }}</span><select name="province" data-cart-drawer-shipping-province disabled></select></label>
                    <label><span>{{ section.settings.shipping_estimator_postal_label | escape }}</span><input type="text" name="zip" autocomplete="postal-code" required></label>
                    <button type="submit" class="cart-drawer__text-button">{{ section.settings.shipping_estimator_button_label | escape }}</button>
                  </form>
                  <p class="cart-drawer__shipping-rates" data-cart-drawer-shipping-rates role="status" aria-live="polite"></p>
                </details>
              {% endif %}

              <p class="cart-drawer__tax-note" data-cart-drawer-tax-note>{% if cart.taxes_included %}{{ 'cart.taxes_included' | t }}{% else %}{{ 'cart_drawer.taxes_note' | t | default: 'Taxes and shipping calculated at checkout' | escape }}{% endif %}</p>
              <ul class="cart-drawer__discounts" data-cart-drawer-discounts role="list" hidden></ul>
              {% if section.settings.show_discount %}
                <form class="cart-drawer__discount" data-cart-drawer-discount>
                  <label class="visually-hidden" for="CartDrawerDiscount-{{ section.id }}">{{ 'cart_drawer.discount_code' | t | default: 'Discount code' | escape }}</label>
                  <input id="CartDrawerDiscount-{{ section.id }}" type="text" name="discount" autocomplete="off" placeholder="{{ 'cart_drawer.discount_code' | t | default: 'Discount code' | escape }}" aria-describedby="CartDrawerMessage-{{ section.id }}">
                  <button type="submit" class="cart-drawer__text-button">{{ section.settings.discount_button_label | escape }}</button>
                </form>
              {% endif %}
              <p id="CartDrawerMessage-{{ section.id }}" class="cart-drawer__message" data-cart-drawer-message role="status" aria-live="polite" hidden></p>
            </div>
          </section>
        {% endif %}

        <div class="cart-drawer__total"><span>{{ 'cart_drawer.total' | t | default: 'Total' | escape }}</span><strong data-cart-drawer-total>{% render 'money', amount: cart.total_price %}</strong></div>
        <a class="cart-drawer__checkout" href="{{ routes.checkout_url | default: '/checkout' | escape }}" data-cart-drawer-checkout><span>{{ section.settings.checkout_label | escape }}</span>{% if section.settings.checkout_icon == 'arrow-right' %}<span class="cart-drawer__checkout-icon" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}</span>{% elsif section.settings.checkout_icon == 'arrow-up-right' %}<span class="cart-drawer__checkout-icon" aria-hidden="true">{% render 'icon', name: 'arrow-up-right' %}</span>{% endif %}<span class="cart-drawer__checkout-total" data-cart-drawer-checkout-total>{% render 'money', amount: cart.total_price %}</span></a>
        {% if section.settings.show_accelerated_checkout and additional_checkout_buttons %}<div class="cart-drawer__additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>{% endif %}
        {% if section.settings.show_view_cart %}<a class="cart-drawer__view-cart" href="{{ routes.cart_url | escape }}">{{ section.settings.view_cart_label | escape }}</a>{% endif %}
      </footer>
      {% if section.settings.show_note or section.settings.show_discount or section.settings.shipping_estimator_enable %}
        <button class="cart-drawer__order-options-backdrop" type="button" tabindex="-1" aria-label="Close order options" data-cart-drawer-order-options-close data-modal-backdrop></button>
        <span class="cart-drawer__order-options-backdrop-pointer modal-backdrop-pointer modal-close-button close-icon" aria-hidden="true"></span>
      {% endif %}
    </aside>
  </cart-drawer>
  <script src="{{ 'cart-drawer-loader.js' | asset_url }}" data-cart-drawer-module="{{ 'cart-drawer.js' | asset_url }}" data-cart-drawer-auto-open="{{ section.settings.auto_open }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Cart drawer",
  "enabled_on": { "groups": ["custom.overlay"] },
  "settings": [
    { "type": "header", "content": "Cart drawer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cart" },
    { "type": "checkbox", "id": "auto_open", "label": "Open drawer after adding a product", "default": true },
    { "type": "header", "content": "Free shipping bar" },
    { "type": "checkbox", "id": "free_shipping_enable", "label": "Show free shipping bar", "default": false },
    { "type": "range", "id": "free_shipping_threshold", "label": "Free shipping threshold", "min": 0, "max": 5000, "step": 50, "unit": "$", "default": 100, "visible_if": "{{ section.settings.free_shipping_enable }}" },
    { "type": "text", "id": "free_shipping_pending_message", "label": "Progress message", "default": "You're {amount} away from free shipping", "visible_if": "{{ section.settings.free_shipping_enable }}" },
    { "type": "text", "id": "free_shipping_success_message", "label": "Success message", "default": "You've unlocked free shipping", "visible_if": "{{ section.settings.free_shipping_enable }}" },
    { "type": "header", "content": "Cart tools" },
    { "type": "checkbox", "id": "show_note", "label": "Order note", "default": true },
    { "type": "text", "id": "order_options_label", "label": "Order-options label", "default": "Order options", "visible_if": "{{ section.settings.show_note or section.settings.show_discount or section.settings.shipping_estimator_enable }}" },
    { "type": "checkbox", "id": "note_expanded", "label": "Keep order note expanded", "default": false, "visible_if": "{{ section.settings.show_note }}" },
    { "type": "text", "id": "note_label", "label": "Note label", "default": "Add order note", "visible_if": "{{ section.settings.show_note }}" },
    { "type": "text", "id": "note_placeholder", "label": "Note placeholder", "default": "Add a note to your order", "visible_if": "{{ section.settings.show_note }}" },
    { "type": "text", "id": "note_save_label", "label": "Save-note label", "default": "Save note", "visible_if": "{{ section.settings.show_note }}" },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount code field", "default": true },
    { "type": "text", "id": "discount_button_label", "label": "Discount button label", "default": "Apply", "visible_if": "{{ section.settings.show_discount }}" },
    { "type": "checkbox", "id": "shipping_estimator_enable", "label": "Shipping estimator", "default": false },
    { "type": "text", "id": "shipping_estimator_label", "label": "Estimator label", "default": "Estimate shipping", "visible_if": "{{ section.settings.shipping_estimator_enable }}" },
    { "type": "text", "id": "shipping_estimator_country_label", "label": "Country label", "default": "Country", "visible_if": "{{ section.settings.shipping_estimator_enable }}" },
    { "type": "text", "id": "shipping_estimator_province_label", "label": "State/province label", "default": "State / Province", "visible_if": "{{ section.settings.shipping_estimator_enable }}" },
    { "type": "text", "id": "shipping_estimator_postal_label", "label": "Postal-code label", "default": "Postal code", "visible_if": "{{ section.settings.shipping_estimator_enable }}" },
    { "type": "text", "id": "shipping_estimator_button_label", "label": "Estimator button label", "default": "Calculate", "visible_if": "{{ section.settings.shipping_estimator_enable }}" },
    { "type": "header", "content": "Promotion bar" },
    { "type": "checkbox", "id": "promotion_enable", "label": "Promotion bar", "default": false },
    { "type": "text", "id": "promotion_message", "label": "Message", "default": "Complimentary shipping on every order", "visible_if": "{{ section.settings.promotion_enable }}" },
    { "type": "range", "id": "promotion_speed", "label": "Speed", "min": 2, "max": 20, "step": 1, "unit": "s", "default": 8, "visible_if": "{{ section.settings.promotion_enable }}" },
    { "type": "select", "id": "promotion_direction", "label": "Direction", "options": [{ "value": "left", "label": "Right to left" }, { "value": "right", "label": "Left to right" }], "default": "left", "visible_if": "{{ section.settings.promotion_enable }}" },
    { "type": "checkbox", "id": "promotion_pause_on_hover", "label": "Pause on hover", "default": true, "visible_if": "{{ section.settings.promotion_enable }}" },
    { "type": "checkbox", "id": "promotion_uppercase", "label": "Uppercase", "default": false, "visible_if": "{{ section.settings.promotion_enable }}" },
    { "type": "header", "content": "Complementary products" },
    { "type": "checkbox", "id": "complementary_products_enable", "label": "Complementary products", "default": true },
    { "type": "text", "id": "complementary_products_heading", "label": "Heading", "default": "Complete with", "visible_if": "{{ section.settings.complementary_products_enable }}" },
    { "type": "select", "id": "complementary_products_source", "label": "Product source", "options": [{ "value": "related", "label": "Related products" }, { "value": "manual", "label": "Product list" }], "default": "related", "visible_if": "{{ section.settings.complementary_products_enable }}" },
    { "type": "product_list", "id": "complementary_products", "label": "Products", "limit": 8 },
    { "type": "range", "id": "complementary_products_limit", "label": "Maximum products", "min": 2, "max": 6, "step": 1, "default": 4, "visible_if": "{{ section.settings.complementary_products_enable }}" },
    { "type": "checkbox", "id": "complementary_products_auto_rotate", "label": "Auto-rotate", "default": true, "visible_if": "{{ section.settings.complementary_products_enable }}" },
    { "type": "range", "id": "complementary_products_interval", "label": "Change every", "min": 3, "max": 15, "step": 1, "unit": "s", "default": 8, "visible_if": "{{ section.settings.complementary_products_enable and section.settings.complementary_products_auto_rotate }}" },
    { "type": "checkbox", "id": "complementary_products_pause_on_hover", "label": "Pause on hover", "default": true, "visible_if": "{{ section.settings.complementary_products_enable and section.settings.complementary_products_auto_rotate }}" },
    { "type": "header", "content": "Empty cart" },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "Your cart is empty" },
    { "type": "text", "id": "empty_button_label", "label": "Button label", "default": "Continue shopping" },
    { "type": "url", "id": "empty_link", "label": "Button link", "default": "/collections/all" },
    { "type": "image_picker", "id": "empty_image", "label": "Image" },
    { "type": "select", "id": "empty_image_ratio", "label": "Image ratio", "options": [{ "value": "adapt", "label": "Adapt to image" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }], "default": "adapt", "visible_if": "{{ section.settings.empty_image != blank }}" },
    { "type": "header", "content": "Actions" },
    { "type": "text", "id": "checkout_label", "label": "Checkout label", "default": "Checkout" },
    { "type": "select", "id": "checkout_icon", "label": "Checkout icon", "options": [{ "value": "none", "label": "None" }, { "value": "arrow-right", "label": "Arrow right" }, { "value": "arrow-up-right", "label": "Up-right arrow" }], "default": "none" },
    { "type": "checkbox", "id": "show_view_cart", "label": "View-cart link", "default": true },
    { "type": "text", "id": "view_cart_label", "label": "View-cart label", "default": "View cart", "visible_if": "{{ section.settings.show_view_cart }}" },
    { "type": "checkbox", "id": "show_accelerated_checkout", "label": "Show accelerated checkout buttons", "default": true },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "desktop_width", "label": "Desktop drawer width", "min": 360, "max": 600, "step": 10, "unit": "px", "default": 550 },
    { "type": "checkbox", "id": "indent_desktop", "label": "Indent on desktop", "default": false },
    { "type": "checkbox", "id": "blur_backdrop", "label": "Blur backdrop", "default": false },
    { "type": "select", "id": "product_title_case", "label": "Title case", "options": [{ "value": "none", "label": "Original" }, { "value": "uppercase", "label": "Uppercase" }], "default": "none" },
    { "type": "select", "id": "price_font", "label": "Price font", "options": [{ "value": "body", "label": "Body" }, { "value": "subheading", "label": "Utility" }, { "value": "heading", "label": "Display" }, { "value": "accent", "label": "Accent" }], "default": "subheading" },
    { "type": "range", "id": "image_radius", "label": "Image corners", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 }
  ],
  "max_blocks": 2,
  "blocks": [
    {
