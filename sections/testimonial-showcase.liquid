{% liquid
  assign testimonial_count = section.blocks.size
%}

{% if testimonial_count > 0 %}
  <noryvelle-pebble-testimonial
    class="np-testimonial full-width color-scheme color-{{ section.settings.color_scheme.id }}"
    data-section-id="{{ section.id }}"
    style="--np-testimonial-background: {{ section.settings.background_color }};"
  >
    <div class="np-testimonial__inner">
      <div class="np-testimonial__slides" data-testimonial-slides aria-live="polite">
        {% for block in section.blocks %}
          {% liquid
            assign testimonial_product = block.settings.product
            assign product_image = block.settings.product_image | default: testimonial_product.featured_image
            assign product_url = block.settings.product_link | default: testimonial_product.url
            assign editorial_alt = block.settings.editorial_alt | default: block.settings.editorial_image.alt
            assign product_alt = block.settings.product_alt | default: product_image.alt | default: testimonial_product.title
          %}
          <article
            class="np-testimonial__slide"
            data-testimonial-slide
            data-block-id="{{ block.id }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="np-testimonial__editorial">
              {% if block.settings.editorial_image != blank %}
                {% render 'responsive-image',
                  image: block.settings.editorial_image,
                  max_width: 1216,
                  widths: '343, 480, 608, 768, 960, 1216',
                  sizes: '(min-width: 1200px) 608px, (min-width: 750px) 45vw, calc(100vw - 32px)',
                  class: 'np-testimonial__editorial-image',
                  loading: 'lazy',
                  alt: editorial_alt
                %}
              {% else %}
                {% render 'media-placeholder', class_name: 'np-testimonial__editorial-placeholder', asset_name: 'placeholder-image-default-1.svg' %}
              {% endif %}
            </div>

            <div class="np-testimonial__copy-product">
              <blockquote class="np-testimonial__quote">
                {% if block.settings.quote_heading != blank %}
                  <p class="np-testimonial__quote-heading">{{ block.settings.quote_heading | escape }}</p>
                {% endif %}
                {% if block.settings.quote_body != blank %}
                  <p class="np-testimonial__quote-body">{{ block.settings.quote_body | escape }}</p>
                {% endif %}
                {% if block.settings.author != blank %}
                  <footer class="np-testimonial__author">{{ block.settings.author | escape }}</footer>
                {% endif %}
              </blockquote>

              <div class="np-testimonial__product">
                {% if product_url != blank %}<a class="np-testimonial__product-media" href="{{ product_url }}">{% else %}<div class="np-testimonial__product-media">{% endif %}
                  {% if product_image != blank %}
                    {% render 'responsive-image',
                      image: product_image,
                      max_width: 560,
                      widths: '120, 180, 240, 360, 480, 560',
                      sizes: '(min-width: 1200px) 280px, (min-width: 750px) 180px, 120px',
                      class: 'np-testimonial__product-image',
                      loading: 'lazy',
                      alt: product_alt
                    %}
                  {% else %}
                    {% render 'media-placeholder', class_name: 'np-testimonial__product-placeholder', asset_name: 'placeholder-image-product-1.svg' %}
                  {% endif %}
                {% if product_url != blank %}</a>{% else %}</div>{% endif %}

                {% render 'cta',
                  label: block.settings.product_label,
                  url: product_url,
                  style: 'tertiary',
                  class: 'np-testimonial__product-link'
                %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if testimonial_count > 1 %}
        <div class="np-testimonial__controls">
          <button
            class="np-testimonial__control"
            type="button"
            aria-label="{{ section.settings.previous_label | escape }}"
            data-testimonial-previous
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M21 12H3m0 0 5-5m-5 5 5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            class="np-testimonial__control"
            type="button"
            aria-label="{{ section.settings.next_label | escape }}"
            data-testimonial-next
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 12h18m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  </noryvelle-pebble-testimonial>
{% endif %}

{% stylesheet %}
  .np-testimonial {
    display: block;
    padding: 56px 0;
    background: var(--np-testimonial-background, #f6f6f6);
    color: var(--color-heading, #181818);
  }

  .np-testimonial__inner {
    position: relative;
    width: min(1824px, calc(100% - 96px));
    min-height: 608px;
    margin: 0 auto;
  }

  .np-testimonial__slides {
    width: min(1600px, calc(100% - 176px));
  }

  .np-testimonial__slide {
    display: grid;
    min-height: 608px;
    grid-template-columns: minmax(0, 608fr) minmax(0, 552fr) minmax(0, 280fr);
    align-items: center;
    gap: clamp(40px, 4.1667vw, 80px);
  }

  .np-testimonial__slide[hidden] {
    display: none;
  }

  .np-testimonial__editorial {
    width: 100%;
    max-width: 608px;
    height: auto;
    overflow: hidden;
    aspect-ratio: 1;
    background: #fff;
  }

  .np-testimonial__editorial-image,
  .np-testimonial__editorial-placeholder,
  .np-testimonial__product-image,
  .np-testimonial__product-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .np-testimonial__copy-product {
    display: contents;
  }

  .np-testimonial__quote {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }

  .np-testimonial__quote-heading,
  .np-testimonial__quote-body,
  .np-testimonial__author {
    margin: 0;
  }

  .np-testimonial__quote-heading {
    color: #181818;
    font-family: var(--font-heading--family);
    font-size: 26px;
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    letter-spacing: 2px;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .np-testimonial__quote-body,
  .np-testimonial__author {
    font-family: var(--font-body--family);
    font-size: 16px;
    font-style: var(--font-body--style);
    font-weight: 400;
    letter-spacing: 0.2px;
    line-height: 1.5;
  }

  .np-testimonial__quote-body {
    color: #6c6c6c;
  }

  .np-testimonial__author {
    color: #181818;
  }

  .np-testimonial__product {
    display: flex;
    width: 100%;
    max-width: 280px;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .np-testimonial__product-media {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    aspect-ratio: 1;
    background: #fff;
  }

  .np-testimonial__product-link {
    color: #1e1e1e;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.6px;
    line-height: 1.5;
  }

  .np-testimonial__controls {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    gap: 8px;
  }

  .np-testimonial__control {
    display: grid;
    width: 48px;
    height: 48px;
    padding: 12px;
    border: 0;
    background: transparent;
    color: #181818;
    cursor: pointer;
    place-items: center;
  }

  .np-testimonial__control:disabled {
    cursor: default;
    opacity: 0.3;
  }

  .np-testimonial__control:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: -2px;
  }

  .np-testimonial__control svg {
    width: 24px;
    height: 24px;
  }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .np-testimonial {
      padding: 64px 0;
    }

    .np-testimonial__inner {
      width: calc(100% - 60px);
      min-height: 1010px;
    }

    .np-testimonial__slides {
      width: 100%;
    }

    .np-testimonial__slide {
      display: flex;
      min-height: 930px;
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }

    .np-testimonial__editorial {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }

    .np-testimonial__copy-product {
      display: grid;
      min-height: 190px;
      min-width: 0;
      grid-template-columns: minmax(0, 1fr) 120px;
      align-items: start;
      gap: 80px;
    }

    .np-testimonial__quote-heading {
      font-size: 24px;
    }

    .np-testimonial__product {
      width: 120px;
      align-items: center;
      gap: 12px;
    }

    .np-testimonial__product-media {
      width: 120px;
      height: 120px;
    }

    .np-testimonial__controls {
      position: static;
      justify-content: flex-start;
      margin-top: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .np-testimonial {
      padding: 56px 0;
    }

    .np-testimonial__inner {
      width: calc(100% - 32px);
      min-height: 816px;
    }

    .np-testimonial__slides {
      width: 100%;
    }

    .np-testimonial__slide {
      display: flex;
      min-height: 768px;
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
    }

    .np-testimonial__slide[hidden] {
      display: none;
    }

    .np-testimonial__editorial {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }

    .np-testimonial__copy-product {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .np-testimonial__quote {
      gap: 16px;
    }

    .np-testimonial__quote-heading {
      font-size: 22px;
    }

    .np-testimonial__product {
      width: 120px;
      align-items: center;
      gap: 12px;
    }

    .np-testimonial__product-media {
      width: 120px;
      height: 120px;
    }

    .np-testimonial__controls {
      position: static;
      justify-content: flex-end;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('noryvelle-pebble-testimonial')) {
    class NoryvellePebbleTestimonial extends HTMLElement {
      connectedCallback() {
        this.slides = [...this.querySelectorAll('[data-testimonial-slide]')];
        this.previousButton = this.querySelector('[data-testimonial-previous]');
        this.nextButton = this.querySelector('[data-testimonial-next]');
        this.index = Math.max(0, this.slides.findIndex((slide) => !slide.hidden));
        this.onPrevious = () => this.show(this.index - 1);
        this.onNext = () => this.show(this.index + 1);
        this.onBlockSelect = (event) => {
          const slideIndex = this.slides.findIndex((slide) => slide.dataset.blockId === event.detail.blockId);
          if (slideIndex >= 0) this.show(slideIndex);
        };
        this.previousButton?.addEventListener('click', this.onPrevious);
        this.nextButton?.addEventListener('click', this.onNext);
        document.addEventListener('shopify:block:select', this.onBlockSelect);
        this.show(this.index);
      }

      disconnectedCallback() {
        this.previousButton?.removeEventListener('click', this.onPrevious);
        this.nextButton?.removeEventListener('click', this.onNext);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      show(nextIndex) {
        if (!this.slides.length) return;
        this.index = Math.min(Math.max(nextIndex, 0), this.slides.length - 1);
        this.slides.forEach((slide, index) => {
          const isCurrent = index === this.index;
          slide.hidden = !isCurrent;
          slide.setAttribute('aria-hidden', String(!isCurrent));
        });
        if (this.previousButton) this.previousButton.disabled = this.index === 0;
        if (this.nextButton) this.nextButton.disabled = this.index === this.slides.length - 1;
      }
    }

    customElements.define('noryvelle-pebble-testimonial', NoryvellePebbleTestimonial);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-noryvelle-testimonial",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f6f6f6"
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous button label",
      "default": "Previous testimonial"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button label",
      "default": "Next testimonial"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "editorial_image",
          "label": "Editorial image"
        },
        {
          "type": "text",
          "id": "editorial_alt",
          "label": "Editorial image alt text"
        },
        {
          "type": "text",
          "id": "quote_heading",
          "label": "Quote heading",
          "default": "“A statement piece that turns heads.”"
        },
        {
          "type": "textarea",
          "id": "quote_body",
          "label": "Quote",
          "default": "The craftsmanship is impeccable — every crystal catches the light beautifully. It’s bold but still elegant enough for evening events. I’ve received endless compliments."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "— Clara Montgomery, London"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image override"
        },
        {
          "type": "text",
          "id": "product_alt",
          "label": "Product image alt text"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product link override"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product link label",
          "default": "View product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
