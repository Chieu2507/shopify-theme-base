{% liquid
  assign testimonial_count = section.blocks.size
%}

{% if testimonial_count > 0 %}
  {% render 'section-stylesheet', asset: 'section-testimonial-showcase.css', defer_on_home: true %}
  <noryvelle-pebble-testimonial
    class="np-testimonial full-width color-scheme color-{{ section.settings.color_scheme.id }}"
    data-section-id="{{ section.id }}"
    data-deferred-module="{{ 'section-testimonial-showcase.js' | asset_url }}"
    style="--np-testimonial-background: {{ section.settings.background_color }};"
  >
    <div class="np-testimonial__inner">
      <div class="np-testimonial__slides" data-testimonial-slides aria-live="polite">
        {% for block in section.blocks %}
          {% liquid
            assign testimonial_product = block.settings.product
            assign product_image = block.settings.product_image | default: testimonial_product.featured_image
            assign product_url = block.settings.product_link | default: testimonial_product.url
            assign editorial_alt = block.settings.editorial_alt | default: block.settings.editorial_image.alt
            assign product_alt = block.settings.product_alt | default: product_image.alt | default: testimonial_product.title
          %}
          <article
            class="np-testimonial__slide"
            data-testimonial-slide
            data-block-id="{{ block.id }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="np-testimonial__editorial">
              {% if block.settings.editorial_image != blank %}
                {% render 'responsive-image',
                  image: block.settings.editorial_image,
                  max_width: 1216,
                  widths: '343, 480, 608, 768, 960, 1216',
                  sizes: '(min-width: 1200px) 608px, (min-width: 750px) 45vw, calc(100vw - 32px)',
                  class: 'np-testimonial__editorial-image',
                  loading: 'lazy',
                  alt: editorial_alt
                %}
              {% else %}
                {% render 'media-placeholder', class_name: 'np-testimonial__editorial-placeholder', asset_name: 'placeholder-image-default-1.svg' %}
              {% endif %}
            </div>

            <div class="np-testimonial__copy-product">
              <blockquote class="np-testimonial__quote">
                {% if block.settings.quote_heading != blank %}
                  <p class="np-testimonial__quote-heading">{{ block.settings.quote_heading | escape }}</p>
                {% endif %}
                {% if block.settings.quote_body != blank %}
                  <p class="np-testimonial__quote-body">{{ block.settings.quote_body | escape }}</p>
                {% endif %}
                {% if block.settings.author != blank %}
                  <footer class="np-testimonial__author">{{ block.settings.author | escape }}</footer>
                {% endif %}
              </blockquote>

              <div class="np-testimonial__product">
                {% if product_url != blank %}<a class="np-testimonial__product-media" href="{{ product_url }}">{% else %}<div class="np-testimonial__product-media">{% endif %}
                  {% if product_image != blank %}
                    {% render 'responsive-image',
                      image: product_image,
                      max_width: 560,
                      widths: '120, 180, 240, 360, 480, 560',
                      sizes: '(min-width: 1200px) 280px, (min-width: 750px) 180px, 120px',
                      class: 'np-testimonial__product-image',
                      loading: 'lazy',
                      alt: product_alt
                    %}
                  {% else %}
                    {% render 'media-placeholder', class_name: 'np-testimonial__product-placeholder', asset_name: 'placeholder-image-product-1.svg' %}
                  {% endif %}
                {% if product_url != blank %}</a>{% else %}</div>{% endif %}

                {% render 'cta',
                  label: block.settings.product_label,
                  url: product_url,
                  style: 'tertiary',
                  class: 'np-testimonial__product-link'
                %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if testimonial_count > 1 %}
        <div class="np-testimonial__controls">
          <button
            class="np-testimonial__control"
            type="button"
            aria-label="{{ section.settings.previous_label | escape }}"
            data-testimonial-previous
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M21 12H3m0 0 5-5m-5 5 5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            class="np-testimonial__control"
            type="button"
            aria-label="{{ section.settings.next_label | escape }}"
            data-testimonial-next
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 12h18m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  </noryvelle-pebble-testimonial>
{% endif %}



{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-noryvelle-testimonial",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f6f6f6"
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous button label",
      "default": "Previous testimonial"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button label",
      "default": "Next testimonial"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "editorial_image",
          "label": "Editorial image"
        },
        {
          "type": "text",
          "id": "editorial_alt",
          "label": "Editorial image alt text"
        },
        {
          "type": "text",
          "id": "quote_heading",
          "label": "Quote heading",
          "default": "“A statement piece that turns heads.”"
        },
        {
          "type": "textarea",
          "id": "quote_body",
          "label": "Quote",
          "default": "The craftsmanship is impeccable — every crystal catches the light beautifully. It’s bold but still elegant enough for evening events. I’ve received endless compliments."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "— Clara Montgomery, London"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image override"
        },
        {
          "type": "text",
          "id": "product_alt",
          "label": "Product image alt text"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product link override"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product link label",
          "default": "View product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Brand trust",
      "blocks": [
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
