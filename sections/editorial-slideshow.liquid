{% render 'section-stylesheet', asset: 'section-editorial-slideshow.css' %}
{% render 'swiper-stylesheet' %}

{% liquid
  assign height_mode = section.settings.height_mode | default: 'percent'
  assign height_percent_desktop = section.settings.height_percent_desktop | default: 100
  assign height_percent_mobile = section.settings.height_percent_mobile | default: 100
  assign height_pixels_desktop = section.settings.height_pixels_desktop | default: 780
  assign height_pixels_mobile = section.settings.height_pixels_mobile | default: 700
  assign slideshow_description = section.settings.slideshow_description | default: 'Slideshow about our brand'
  assign autoplay_delay_display = section.settings.autoplay_delay
  if section.settings.autoplay_delay < 10
    assign autoplay_delay_display = '0' | append: section.settings.autoplay_delay
  endif
%}

<editorial-slideshow
  class="editorial-slideshow color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}{% if section.settings.enable_image_zoom %} editorial-slideshow--image-zoom{% endif %} editorial-slideshow--height-mode-{{ height_mode }}"
  role="region"
  aria-label="{{ slideshow_description | escape }}"
  data-section-id="{{ section.id }}"
  data-motion-enabled="{{ settings.enable_motion }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  data-height-mode="{{ height_mode }}"
  data-deferred-module="{{ 'editorial-slideshow.js' | asset_url }}"
  data-first-viewport-height-module="{{ 'first-viewport-height.js' | asset_url }}"
  data-first-viewport-height-mode="{{ height_mode }}"
  data-first-viewport-height-desktop-percent="{{ height_percent_desktop }}"
  data-first-viewport-height-mobile-percent="{{ height_percent_mobile }}"
  style="--editorial-navigator-background-opacity: {{ section.settings.navigator_background_opacity | default: 80 }}%; --editorial-slideshow-desktop-ratio: 16 / 9; --editorial-slideshow-mobile-ratio: 3 / 4; --editorial-slideshow-height-desktop-percent: {{ height_percent_desktop }}svh; --editorial-slideshow-height-mobile-percent: {{ height_percent_mobile }}svh; --editorial-slideshow-height-desktop-pixels: {{ height_pixels_desktop }}px; --editorial-slideshow-height-mobile-pixels: {{ height_pixels_mobile }}px;"
>
  <div class="editorial-slideshow__viewport swiper" data-editorial-slideshow-slider>
    <div class="editorial-slideshow__wrapper swiper-wrapper">
      {% content_for 'blocks' %}
    </div>
  </div>

  {% if section.settings.show_slideshow_controls %}
    <nav
      id="EditorialSlideshowNavigator-{{ section.id }}"
      class="editorial-slideshow__navigator is-collapsed"
      aria-label="{{ 'slideshow.pagination' | t | escape }}"
      data-editorial-navigator
      hidden
    >
      <button
        class="editorial-slideshow__navigator-arrow editorial-slideshow__navigator-arrow--previous"
        type="button"
        aria-label="{{ 'slideshow.previous' | t | escape }}"
        data-editorial-previous
      >
        {% render 'icon', name: 'chevron-left' %}
        <span class="editorial-slideshow__navigator-arrow-label">{{ 'slideshow.previous_short' | t | escape }}</span>
      </button>

      <div class="editorial-slideshow__tabs" role="tablist" data-editorial-slide-tabs></div>

      <button
        class="editorial-slideshow__navigator-arrow editorial-slideshow__navigator-arrow--next"
        type="button"
        aria-label="{{ 'slideshow.next' | t | escape }}"
        data-editorial-next
      >
        <span class="editorial-slideshow__navigator-arrow-label">{{ 'slideshow.next_short' | t | escape }}</span>
        {% render 'icon', name: 'chevron-right' %}
      </button>

      {% if section.settings.autoplay and section.blocks.size > 1 %}
        <button
          class="editorial-slideshow__autoplay"
          type="button"
          aria-label="{{ 'slideshow.pause' | t | escape }}"
          aria-pressed="true"
          data-label-pause="{{ 'slideshow.pause' | t | escape }}"
          data-label-resume="{{ 'slideshow.resume' | t | escape }}"
          data-editorial-autoplay-toggle
        >
          <span class="editorial-slideshow__autoplay-icon" aria-hidden="true">
            {% render 'icon', name: 'pause', class: 'editorial-slideshow__autoplay-icon--pause' %}
            {% render 'icon', name: 'play-outline', class: 'editorial-slideshow__autoplay-icon--play' %}
          </span>
          <span class="editorial-slideshow__autoplay-copy">
            <span class="editorial-slideshow__autoplay-label">{{ 'slideshow.autoplay' | t | escape }}</span>
            <span class="editorial-slideshow__autoplay-value" data-editorial-autoplay-value>{{ autoplay_delay_display }} {{ 'slideshow.seconds_short' | t | escape }}</span>
          </span>
        </button>
      {% endif %}

      <button
        class="editorial-slideshow__navigator-toggle"
        type="button"
        aria-controls="EditorialSlideshowNavigator-{{ section.id }}"
        aria-expanded="false"
        aria-label="{{ 'slideshow.expand_navigation' | t | escape }}"
        data-label-collapse="{{ 'slideshow.collapse_navigation' | t | escape }}"
        data-label-expand="{{ 'slideshow.expand_navigation' | t | escape }}"
        data-editorial-navigator-toggle
      >
        {% render 'icon', name: 'chevron-up' %}
      </button>
    </nav>
  {% endif %}
</editorial-slideshow>

{% schema %}
{
  "name": "Editorial slideshow",
  "tag": "section",
  "class": "section-editorial-slideshow",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "height_mode",
      "label": "Height mode",
      "options": [
        { "value": "adapt", "label": "Adapt to first image" },
        { "value": "percent", "label": "Percents" },
        { "value": "pixels", "label": "Pixels" }
      ],
      "default": "percent"
    },
    {
      "type": "range",
      "id": "height_percent_desktop",
      "label": "Desktop height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.height_mode == 'percent' }}"
    },
    {
      "type": "range",
      "id": "height_percent_mobile",
      "label": "Mobile height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.height_mode == 'percent' }}"
    },
    {
      "type": "range",
      "id": "height_pixels_desktop",
      "label": "Desktop height",
      "min": 480,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 780,
      "visible_if": "{{ section.settings.height_mode == 'pixels' }}"
    },
    {
      "type": "range",
      "id": "height_pixels_mobile",
      "label": "Mobile height",
      "min": 440,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 700,
      "visible_if": "{{ section.settings.height_mode == 'pixels' }}"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Legacy slide height desktop",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "X-large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full",
      "visible_if": "{{ false }}"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Legacy slide height mobile",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "X-large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 6,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "show_slideshow_controls",
      "label": "Show slideshow controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "textarea",
      "id": "slideshow_description",
      "label": "Slideshow description",
      "info": "Describe the slideshow for those using screen readers. This text will not be visible on the page.",
      "default": "Slideshow about our brand"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "navigator_background_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Navigator opacity",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom animation",
      "info": "Inactive images are enlarged and smoothly return to their original size when active.",
      "default": true
    }
  ],
  "blocks": [
    { "type": "editorial-slide" }
  ],
  "presets": [
    {
      "name": "Editorial slideshow",
      "category": "Banners",
      "settings": {
        "height_mode": "percent",
        "height_percent_desktop": 100,
        "height_percent_mobile": 100,
        "height_pixels_desktop": 780,
        "height_pixels_mobile": 700,
        "autoplay": true,
        "autoplay_delay": 6,
        "show_slideshow_controls": true,
        "enable_image_zoom": true,
        "slideshow_description": "Slideshow about our brand",
        "section_width": "full",
        "color_scheme": "scheme-4",
        "navigator_background_opacity": 80
      },
      "blocks": [
        {
          "type": "editorial-slide",
          "settings": {
            "content_width": 520,
            "gap": 24,
            "content_alignment": "left",
            "content_position": "top-left",
            "content_position_mobile": "middle-left",
            "nav_label": "Nocturne",
            "nav_detail": "HOUSE SIGNATURE",
            "color_scheme": "scheme-4",
            "overlay_color": "#000000",
            "overlay_opacity": 30
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "<p>OBJECT 01 / THE HOUSE SIGNATURE</p>",
                "type_preset": "2xs",
                "color": "text"
              }
            },
            {
              "type": "heading",
              "settings": {
                "heading": "<h1>The Nocturne<br>Collar.</h1>",
                "type_preset": "2xl"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>A singular cushion-cut spinel held at the throat by sculptural gold—one unmistakable object, made to order.</p>",
                "type_preset": "md",
                "color": "text"
              }
            },
            {
              "type": "button-group",
              "settings": {
                "layout_direction": "horizontal",
                "alignment": "left",
                "gap": 0
              },
              "blocks": [
                {
                  "type": "button",
                  "settings": {
                    "label": "DISCOVER THE COLLAR",
                    "link": "/collections/all",
                    "style": "primary",
                    "icon": "arrow-right"
                  }
                }
              ]
            },
            {
              "type": "heading",
              "settings": {
                "heading": "<p>NATURAL SPINEL · 18K YELLOW GOLD · ONE OF ONE</p>",
                "type_preset": "2xs",
                "color": "text"
              }
            }
          ]
        },
        {
          "type": "editorial-slide",
          "settings": {
            "nav_label": "Equinox",
            "nav_detail": "SCULPTURAL LIGHT"
          }
        },
        {
          "type": "editorial-slide",
          "settings": {
            "nav_label": "Vesper",
            "nav_detail": "WRIST STUDY"
          }
        }
      ]
    }
  ]
}
{% endschema %}
