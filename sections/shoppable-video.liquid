{% render 'section-stylesheet', asset: 'section-shoppable-video.css', defer_on_home: true %}
{% render 'swiper-stylesheet', defer_on_home: true %}

{% liquid
  assign shoppable_video_background = section.settings.background_color
  if shoppable_video_background == blank
    assign shoppable_video_background = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background
  endif
  assign desktop_columns = section.settings.columns_desktop | plus: 0
  assign skeleton_video_count = desktop_columns | plus: 2
  capture shoppable_video_cards
    content_for 'blocks'
  endcapture
  assign rendered_video_count = skeleton_video_count
  if shoppable_video_cards != blank
    assign rendered_video_count = 0
  endif
  assign initial_showing = desktop_columns
  if shoppable_video_cards == blank and initial_showing > rendered_video_count
    assign initial_showing = rendered_video_count
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ shoppable_video_background }};
  }

  #shopify-section-{{ section.id }} .shoppable-video-section {
    background: transparent;
  }
{% endstyle %}

<shoppable-video-section
  class="shoppable-video-section color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  data-desktop-columns="{{ section.settings.columns_desktop }}"
  data-mobile-columns="{{ section.settings.columns_mobile }}"
  data-section-id="{{ section.id }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --shoppable-video-gap: {{ section.settings.column_gap }}px; --shoppable-video-mobile-gap: {{ section.settings.mobile_column_gap }}px; --shoppable-video-media-ratio: {{ section.settings.media_ratio }};"
>
  <div class="shoppable-video-section__inner section-spacing{% if section.settings.section_width == 'page' %} page-width{% endif %}">
    <header class="shoppable-video-section__header">
      <div class="shoppable-video-section__title-group" data-reveal>
        {% content_for 'block', type: 'label', id: 'label' %}
        {% content_for 'block', type: 'heading', id: 'heading' %}
      </div>
      <div class="shoppable-video-section__description" data-reveal>
        {% content_for 'block', type: 'text', id: 'description' %}
      </div>
    </header>

    <div class="shoppable-video-section__panel">
      <div class="shoppable-video-section__carousel swiper" data-shoppable-video-carousel>
        <div class="shoppable-video-section__slides swiper-wrapper" role="list" data-reveal-group>
          {% if shoppable_video_cards != blank %}
            {{ shoppable_video_cards }}
          {% else %}
            {% for placeholder_index in (1..skeleton_video_count) %}
              <article class="shoppable-video-card shoppable-video-card--placeholder swiper-slide" role="listitem" aria-hidden="true" data-shoppable-video-slide>
                <div class="shoppable-video-card__reveal" data-reveal-item style="--reveal-order: {{ forloop.index0 }};">
                  <div class="shoppable-video-card__media">
                    {% render 'media-placeholder', class_name: 'shoppable-video-card__placeholder', placeholder_name: 'image' %}
                  </div>
                  <div class="shoppable-video-card__product-strip">
                    <div class="shoppable-video-card__product-media">
                      {% assign product_placeholder_index = placeholder_index | minus: 1 | modulo: 4 | plus: 1 %}
                      {% assign placeholder_asset = 'placeholder-image-product-' | append: product_placeholder_index | append: '.svg' %}
                      {% render 'media-placeholder', class_name: 'shoppable-video-card__product-placeholder', asset_name: placeholder_asset %}
                    </div>
                    <div class="shoppable-video-card__product-copy" aria-hidden="true"></div>
                    <div class="shoppable-video-card__product-action" aria-hidden="true"></div>
                  </div>
                </div>
              </article>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <button class="shoppable-video-section__arrow shoppable-video-section__arrow--previous" type="button" aria-label="Previous videos" data-shoppable-video-previous>
        {% render 'icon', name: 'chevron-left' %}
      </button>
      <button class="shoppable-video-section__arrow shoppable-video-section__arrow--next" type="button" aria-label="Next videos" data-shoppable-video-next>
        {% render 'icon', name: 'chevron-right' %}
      </button>

      <footer class="shoppable-video-section__footer" data-reveal{% if shoppable_video_cards != blank %} hidden{% endif %}>
        <span
          class="shoppable-video-section__count"
          data-shoppable-video-showing
          data-total="{{ rendered_video_count }}"
        >Showing {{ initial_showing }} of {{ rendered_video_count }}</span>
        <div class="shoppable-video-section__progress" aria-hidden="true">
          <span data-shoppable-video-progress></span>
        </div>
        <span class="shoppable-video-section__footer-label" data-shoppable-video-page-label>
          {{ section.settings.footer_label | escape }} / Page 01
        </span>
      </footer>
    </div>
  </div>
</shoppable-video-section>

<script type="module" src="{{ 'shoppable-video.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Shoppable video",
  "tag": "section",
  "class": "section-shoppable-video",
  "max_blocks": 8,
  "blocks": [
    { "type": "shoppable-video" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "footer_label",
      "label": "Footer label",
      "default": "Nocturne films"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "info": "Shows an additional 0.15 card as a swipe preview.",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Column gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_column_gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Mobile column gap",
      "default": 12
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Video ratio",
      "options": [
        { "value": "0.75", "label": "Portrait (3:4)" },
        { "value": "0.6667", "label": "Tall portrait (2:3)" },
        { "value": "1", "label": "Square" }
      ],
      "default": "0.75"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme."
    },
    {
      "type": "color_scheme",
      "id": "modal_color_scheme",
      "label": "Product modal color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Shoppable video",
      "category": "Media",
      "settings": {
        "section_width": "full",
        "columns_desktop": 3,
        "columns_mobile": "1",
        "color_scheme": "scheme-2",
        "modal_color_scheme": "scheme-1"
      },
      "blocks": [
        {
          "type": "label",
          "id": "label",
          "static": true,
          "settings": {
            "text": "<p>04 / JEWELS IN MOTION</p>"
          }
        },
        {
          "type": "heading",
          "id": "heading",
          "static": true,
          "settings": {
            "heading": "<h2>The Nocturne,<br>seen in motion.</h2>",
            "type_preset": "h2"
          }
        },
        {
          "type": "text",
          "id": "description",
          "static": true,
          "settings": {
            "text": "<p>Nocturne objects, caught in motion.<br>Three gestures, held in light.</p>",
            "type_preset": "sm"
          }
        },
        { "type": "shoppable-video" },
        { "type": "shoppable-video" },
        { "type": "shoppable-video" }
      ]
    }
  ]
}
{% endschema %}
