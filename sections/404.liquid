{% liquid
  assign desktop_image = section.settings.image | default: section.settings.mobile_image
  assign mobile_image = section.settings.mobile_image
%}

<section
  class="error-page error-page--horizontal-{{ section.settings.content_horizontal }} error-page--vertical-{{ section.settings.content_vertical }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% else %} error-page--contained{% endif %}"
  style="--error-page-height-desktop: {{ section.settings.height_desktop }}px; --error-page-height-mobile: {{ section.settings.height_mobile }}px; --error-page-content-width: {{ section.settings.content_width }}px; --error-page-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="error-page__media" aria-hidden="true">
    {% if desktop_image != blank %}
      {% render 'responsive-picture', image: desktop_image, mobile_image: mobile_image, max_width: 2400, mobile_max_width: 1400, widths: '640, 960, 1200, 1600, 2000, 2400', mobile_widths: '480, 640, 750, 960, 1200, 1400', sizes: '100vw', class: 'error-page__image error-page__image--desktop', loading: 'eager', fetchpriority: 'high', decorative: true %}
    {% else %}
      {% render 'media-placeholder', class_name: 'error-page__image error-page__image--desktop', asset_name: 'placeholder-image-default-2.svg' %}
    {% endif %}
      <span class="error-page__overlay"></span>
  </div>

  <div class="error-page__main">
    <div class="error-page__content{% if section.settings.content_surface %} error-page__content--surface{% endif %}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% if block.settings.heading != blank %}
              <div class="error-page__heading">
                {% render 'typography-block', block: block, content: block.settings.heading, kind: 'heading', default_preset: 'h1', default_font: 'heading' %}
              </div>
            {% endif %}
          {% when 'text' %}
            {% if block.settings.text != blank %}
              <div class="error-page__text">
                {% render 'typography-block', block: block, content: block.settings.text, kind: 'text', default_preset: 'paragraph', default_font: 'body' %}
              </div>
            {% endif %}
          {% when 'button' %}
            {% if block.settings.label != blank and block.settings.url != blank %}
              <div class="error-page__action" {{ block.shopify_attributes }}>
                <a class="button button--primary" href="{{ block.settings.url }}">{{ block.settings.label | escape }}</a>
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .error-page { position: relative; display: grid; min-height: var(--error-page-height-desktop); overflow: hidden; isolation: isolate; background: var(--gradient-background, var(--color-background)); }
  .error-page--contained { width: min(100%, var(--page-width)); margin-inline: auto; }
  .error-page__media, .error-page__image, .error-page__overlay { position: absolute; inset: 0; }
  .error-page__media { z-index: -2; }
  .error-page__image { width: 100%; height: 100%; object-fit: cover; }
  .error-page__overlay { z-index: 1; background: rgb(0 0 0 / var(--error-page-overlay-opacity)); }
  .error-page__main { position: relative; z-index: 2; display: flex; flex: 1; align-items: center; padding: 56px var(--page-margin); }
  .error-page--horizontal-left .error-page__main { justify-content: flex-start; }
  .error-page--horizontal-center .error-page__main { justify-content: center; }
  .error-page--horizontal-right .error-page__main { justify-content: flex-end; }
  .error-page--vertical-top .error-page__main { align-items: flex-start; }
  .error-page--vertical-center .error-page__main { align-items: center; }
  .error-page--vertical-bottom .error-page__main { align-items: flex-end; }
  .error-page__content { display: grid; width: min(100%, var(--error-page-content-width)); gap: 18px; color: var(--color-text); }
  .error-page__content--surface { padding: clamp(28px, 5vw, 56px); border: 1px solid var(--color-variant-border); background: color-mix(in srgb, var(--color-background) 94%, transparent); }
  .error-page--horizontal-center .error-page__content { text-align: center; }
  .error-page__heading { margin: 0; color: var(--color-heading); }
  .error-page__text { color: var(--color-text); letter-spacing: var(--body-letter-spacing); text-transform: none; }
  .error-page__text.error-page__text--x-large { font-size: var(--font-body-large); line-height: 1.5; }
  .error-page__text.error-page__text--large { font-size: var(--font-body-base); line-height: 1.5; }
  .error-page__text.error-page__text--medium { font-size: var(--font-body-small); line-height: 1.5; }
  .error-page__text.error-page__text--small { font-size: var(--font-caption); line-height: 1.45; }
  .error-page__text.error-page__text--x-small { font-size: 11px; line-height: 1.4; }
  .error-page__text > * { margin: 0; }
  .error-page__action { margin-top: 8px; }
  @media screen and (max-width: 749px) { .error-page { min-height: var(--error-page-height-mobile); } .error-page__main { padding-top: 40px; padding-bottom: 40px; } .error-page__content--surface { padding: 28px 22px; } }
{% endstylesheet %}

{% schema %}
{
