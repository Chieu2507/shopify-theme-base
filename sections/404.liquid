    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image" },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 75, "step": 5, "unit": "%", "default": 20 },
    { "type": "range", "id": "height_desktop", "label": "Desktop height", "min": 400, "max": 1000, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 480 },
    {
      "type": "header",
      "content": "Layout"
    },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 280, "max": 680, "step": 20, "unit": "px", "default": 480 },
    { "type": "select", "id": "content_horizontal", "label": "Horizontal content position", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "select", "id": "content_vertical", "label": "Vertical content position", "options": [{ "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" }], "default": "center" },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "full", "label": "Full width" }, { "value": "contained", "label": "Contained" }], "default": "full" },
