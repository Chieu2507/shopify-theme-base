<section
  class="error-page color-scheme color-{{ section.settings.color_scheme.id }}"
  style="--error-page-padding-top: {{ section.settings.padding_top }}px; --error-page-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="error-page__main">
    <div class="error-page__content">
      <{{ section.settings.heading_tag }} class="error-page__heading spinel-heading--{{ section.settings.heading_size }} heading--{{ section.settings.heading_size }}">
        {{ 'errors.page_not_found' | t }}
      </{{ section.settings.heading_tag }}>

      <p class="error-page__text error-page__text--{{ section.settings.description_size }}">
        {{ 'errors.page_not_found_description' | t }}
      </p>

      <div class="error-page__actions">
        <a class="button button--primary" href="{{ routes.root_url }}">{{ 'errors.go_to_homepage' | t }}</a>
        <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'errors.continue_shopping' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .error-page { background: var(--gradient-background, var(--color-background)); color: var(--color-text); }
  .error-page__main { display: grid; padding: var(--error-page-padding-top) var(--page-margin) var(--error-page-padding-bottom); place-items: center; }
  .error-page__content { display: grid; width: min(100%, 680px); gap: 20px; text-align: center; }
  .error-page__heading { margin: 0; color: var(--color-heading); }
  .error-page__text { margin: 0; color: var(--color-text); letter-spacing: var(--body-letter-spacing); line-height: 1.5; }
  .error-page__text--x-large { font-size: var(--font-body-large); }
  .error-page__text--large { font-size: var(--font-body-base); }
  .error-page__text--medium { font-size: var(--font-body-small); }
  .error-page__text--small { font-size: var(--font-caption); }
  .error-page__text--x-small { font-size: 11px; }
  .error-page__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 12px; }
  .error-page__actions .button { min-width: 220px; }
  @media screen and (max-width: 749px) {
    .error-page__actions { flex-direction: column; align-items: stretch; }
    .error-page__actions .button { width: 100%; min-width: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section-404",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "XX-large" },
        { "value": "h2", "label": "X-large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-small" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "description_size",
      "label": "Description size",
      "options": [
        { "value": "x-large", "label": "X-large" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" },
        { "value": "x-small", "label": "X-small" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 240,
      "step": 8,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 40,
      "max": 240,
      "step": 8,
      "unit": "px",
      "default": 104
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
