<section class="collapsible-content color-scheme color-{{ section.settings.color_scheme.id }} full-width{% if section.settings.section_width == 'full' %} collapsible-content--full{% endif %}" style="--collapsible-padding-top: {{ section.settings.padding_top }}px; --collapsible-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="collapsible-content__inner">
    {% for block in section.blocks %}
      {% if block.type == 'heading' and block.settings.heading != blank %}
        {% render 'spinel-type-style',
          block: block,
          content: block.settings.heading,
          kind: 'heading',
          default_preset: 'h2',
          default_font: 'heading',
          class_name: 'collapsible-content__header',
          content_class: 'collapsible-content__heading'
        %}
      {% endif %}
    {% endfor %}
    <div class="collapsible-content__items">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <details class="collapsible-content__item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
            <summary><{{ block.settings.heading_tag | default: 'h3' }} class="collapsible-content__item-heading spinel-heading--{{ block.settings.heading_size | default: 'medium' }} heading--{{ block.settings.heading_size | default: 'medium' }}">{{ block.settings.heading | escape }}</{{ block.settings.heading_tag | default: 'h3' }}><span class="collapsible-content__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M15 12.5L10 7.5L5 12.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></span></summary>
            <div class="collapsible-content__body content-text spinel-text--{{ block.settings.text_size | default: 'medium' }} content-text--{{ block.settings.text_size | default: 'medium' }} rte">{{ block.settings.content }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
<script>
  (() => {
    const root = document.currentScript.closest('.collapsible-content');
    if (!root || root.dataset.animationBound) return;
    root.dataset.animationBound = 'true';

    const duration = 300;
    const easing = 'cubic-bezier(.4, 0, .2, 1)';
    const states = new WeakMap();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const finish = (details, open, state) => {
      details.open = open;
      details.style.removeProperty('height');
      details.style.removeProperty('overflow');
      details.classList.remove('is-closing');
      state.contentAnimation?.cancel();
      states.delete(details);
    };

    const animate = (details, open) => {
      const summary = details.querySelector('summary');
      const body = details.querySelector('.collapsible-content__body');
      if (!summary || !body) return;

      const previousState = states.get(details);
      const startHeight = details.getBoundingClientRect().height;
      const startOpacity = details.open
        ? Number.parseFloat(getComputedStyle(body).opacity) || 1
        : 0;

      previousState?.heightAnimation?.cancel();
      previousState?.contentAnimation?.cancel();

      if (open && !details.open) details.open = true;
      details.classList.toggle('is-closing', !open);
      const endHeight = open ? summary.offsetHeight + body.scrollHeight : summary.offsetHeight;

      if (reducedMotion.matches) {
        finish(details, open, {});
        return;
      }

      details.style.height = `${startHeight}px`;
      details.style.overflow = 'hidden';
      details.getBoundingClientRect();

      const state = { targetOpen: open };
      state.heightAnimation = details.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration, easing, fill: 'forwards' }
      );
      state.contentAnimation = body.animate(
        { opacity: [startOpacity, open ? 1 : 0] },
        { duration: duration * 0.75, easing, fill: 'forwards' }
      );
      states.set(details, state);

      state.heightAnimation.onfinish = () => {
        if (states.get(details) === state) finish(details, open, state);
      };
    };

    root.addEventListener('click', (event) => {
      const summary = event.target.closest('.collapsible-content__item > summary');
      if (!summary || !root.contains(summary)) return;
      event.preventDefault();
      const details = summary.parentElement;
      const currentTarget = states.get(details)?.targetOpen ?? details.open;
      animate(details, !currentTarget);
    });
  })();
</script>
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="collapsible-content__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label | escape }}
        <span aria-hidden="true">›</span>
      </a>
    {% endif %}
  </div>
</section>
{% stylesheet %}
  .collapsible-content { padding: var(--collapsible-padding-top) var(--page-margin) var(--collapsible-padding-bottom); }
  .collapsible-content__inner { display: flex; width: min(100%, 880px); flex-direction: column; gap: 48px; margin-inline: auto; }
  .collapsible-content--full .collapsible-content__inner { width: min(100%, var(--page-width)); }
  .collapsible-content__heading { margin: 0; text-align: center; font-weight: 400; }
  .collapsible-content__items { border-block-start: 1px solid var(--product-border, #dedbd7); }
  .collapsible-content__item { border-block-end: 1px solid var(--product-border, #dedbd7); }
  .collapsible-content__item summary { display: flex; justify-content: space-between; gap: 16px; padding: 20px 0; cursor: pointer; list-style: none; }
  .collapsible-content__item summary::-webkit-details-marker { display: none; }
  .collapsible-content__item-heading { margin: 0; font-weight: 400; }
  .collapsible-content__icon { display: inline-grid; width: 20px; height: 20px; place-items: center; color: var(--color-text); transform: rotate(180deg); transition: transform .25s ease; }
  .collapsible-content__icon svg { display: block; width: 20px; height: 20px; }
  .collapsible-content__item[open] .collapsible-content__icon { transform: rotate(360deg); }
  .collapsible-content__item.is-closing .collapsible-content__icon { transform: rotate(180deg); }
  .collapsible-content__button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; align-self: center; border-bottom: 1px solid currentColor; padding-bottom: 3px; color: var(--color-text); font-size: var(--font-caption); letter-spacing: .04em; text-decoration: none; text-transform: uppercase; }
  .collapsible-content__button span { font-size: 18px; line-height: .8; }
  .collapsible-content__body { padding: 0 32px 20px 0; color: var(--color-text, #686560); }
  @media (max-width: 989px) { .collapsible-content { padding-inline: 16px; } .collapsible-content__inner { gap: 24px; } }
  @media (max-width: 749px) { .collapsible-content { padding-block: calc(var(--collapsible-padding-top) * 0.75) calc(var(--collapsible-padding-bottom) * 0.75); } }
{% endstylesheet %}
