{% liquid
  assign collection_blocks = section.blocks | where: 'type', 'collection_card'
  assign placeholder_count = 3
  assign card_sizes = '(min-width: 990px) 33vw, 100vw'
  if section.settings.layout == 'compact'
    assign placeholder_count = 5
    assign card_sizes = '(min-width: 990px) 20vw, 212px'
  endif
%}

<section
  class="noryvelle-pebble-collection-list noryvelle-pebble-collection-list--{{ section.settings.layout }} color-scheme color-{{ section.settings.color_scheme.id }} full-width"
  style="--npcl-padding-top: {{ section.settings.padding_top }}px; --npcl-padding-bottom: {{ section.settings.padding_bottom }}px; --npcl-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --npcl-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --npcl-gap: {{ section.settings.card_gap }}px;"
>
  <div class="noryvelle-pebble-collection-list__inner">
    {% if section.settings.heading != blank or section.settings.text != blank or section.settings.cta_label != blank %}
      <header class="noryvelle-pebble-collection-list__header">
        <div class="noryvelle-pebble-collection-list__header-copy">
          {% if section.settings.eyebrow != blank %}
            <p class="noryvelle-pebble-collection-list__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <{{ section.settings.heading_tag }} class="noryvelle-pebble-collection-list__heading heading--{{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </{{ section.settings.heading_tag }}>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="noryvelle-pebble-collection-list__text rte">{{ section.settings.text }}</div>
          {% endif %}
        </div>
        {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
          <div class="noryvelle-pebble-collection-list__header-action">
            {% render 'cta',
              label: section.settings.cta_label,
              url: section.settings.cta_link,
              style: 'tertiary'
            %}
          </div>
        {% endif %}
      </header>
    {% endif %}

    <ul class="noryvelle-pebble-collection-list__grid" role="list">
      {% if collection_blocks.size > 0 %}
        {% for block in collection_blocks %}
          {% liquid
            assign card_collection = block.settings.collection
            assign card_image = block.settings.image | default: card_collection.image
            if card_image == blank and card_collection != blank
              assign card_image = card_collection.products.first.featured_image
            endif
            assign card_title = block.settings.title | default: card_collection.title
            assign card_url = block.settings.link | default: card_collection.url
            assign card_alt = block.settings.image_alt | default: card_image.alt | default: card_title
            assign card_count = card_collection.all_products_count
            if card_title == blank
              assign card_title = 'collection_list.collection' | t
            endif
          %}
          <li class="noryvelle-pebble-collection-list__item" {{ block.shopify_attributes }}>
            {% if card_url != blank %}
              <a class="noryvelle-pebble-collection-list__card" href="{{ card_url }}">
            {% else %}
              <div class="noryvelle-pebble-collection-list__card">
            {% endif %}
                <div
                  class="noryvelle-pebble-collection-list__media"
                  style="--npcl-focal-point: {{ block.settings.focal_point }};"
                >
                  {% if card_image != blank %}
                    {% render 'responsive-image',
                      image: card_image,
                      max_width: 1400,
                      widths: '320, 480, 640, 800, 1000, 1200, 1400',
                      sizes: card_sizes,
                      class: 'noryvelle-pebble-collection-list__image',
                      loading: 'lazy',
                      alt: card_alt
                    %}
                  {% else %}
                    {% render 'media-placeholder',
                      class_name: 'noryvelle-pebble-collection-list__placeholder',
                      asset_name: 'placeholder-image-default-1.svg'
                    %}
                  {% endif %}
                </div>
                <div class="noryvelle-pebble-collection-list__content{% if block.settings.description != blank %} noryvelle-pebble-collection-list__content--has-description{% endif %}">
                  <div class="noryvelle-pebble-collection-list__title-row">
                    <h3 class="noryvelle-pebble-collection-list__title">{{ card_title | escape }}</h3>
                    {% if block.settings.show_product_count and card_collection != blank %}
                      <span
                        class="noryvelle-pebble-collection-list__count"
                        aria-label="{{ 'collection.product_count' | t: count: card_count | escape }}"
                      >
                        {{ card_count }}
                      </span>
                    {% endif %}
                  </div>
                  {% if block.settings.description != blank %}
                    <div class="noryvelle-pebble-collection-list__description rte">
                      {{ block.settings.description }}
                    </div>
                  {% endif %}
                </div>
            {% if card_url != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      {% else %}
        {% for placeholder_index in (1..placeholder_count) %}
          <li class="noryvelle-pebble-collection-list__item">
            <div class="noryvelle-pebble-collection-list__card">
              <div class="noryvelle-pebble-collection-list__media">
                {% render 'media-placeholder',
                  class_name: 'noryvelle-pebble-collection-list__placeholder',
                  asset_name: 'placeholder-image-default-1.svg'
                %}
              </div>
              <div class="noryvelle-pebble-collection-list__content">
                <div class="noryvelle-pebble-collection-list__title-row">
                  <h3 class="noryvelle-pebble-collection-list__title">
                    {{ 'collection_list.collection' | t | escape }}
                  </h3>
                </div>
              </div>
            </div>
          </li>
        {% endfor %}
      {% endif %}
    </ul>

    {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
      <div class="noryvelle-pebble-collection-list__mobile-action">
        {% render 'cta',
          label: section.settings.cta_label,
          url: section.settings.cta_link,
          style: 'tertiary'
        %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .noryvelle-pebble-collection-list {
    display: block;
    overflow: hidden;
    background: var(--gradient-background, var(--color-background));
    color: var(--color-text);
  }

  .noryvelle-pebble-collection-list__inner {
    width: calc(100% - (var(--page-margin) * 2));
    margin-inline: auto;
    padding-block: var(--npcl-padding-top) var(--npcl-padding-bottom);
  }

  .noryvelle-pebble-collection-list__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  .noryvelle-pebble-collection-list__header-copy {
    display: grid;
    max-width: 768px;
    gap: 8px;
  }

  .noryvelle-pebble-collection-list__eyebrow,
  .noryvelle-pebble-collection-list__heading,
  .noryvelle-pebble-collection-list__text > *,
  .noryvelle-pebble-collection-list__title,
  .noryvelle-pebble-collection-list__count,
  .noryvelle-pebble-collection-list__description > * {
    margin: 0;
  }

  .noryvelle-pebble-collection-list__eyebrow {
    color: var(--color-text);
    font-size: var(--font-caption);
    letter-spacing: var(--body-letter-spacing);
    line-height: 1.5;
    text-transform: uppercase;
  }

  .noryvelle-pebble-collection-list__heading,
  .noryvelle-pebble-collection-list__title {
    color: var(--color-heading);
  }

  .noryvelle-pebble-collection-list__text {
    color: var(--color-text);
    line-height: var(--body-line-height);
  }

  .noryvelle-pebble-collection-list__grid {
    display: grid;
    min-width: 0;
    margin: 40px 0 0;
    padding: 0;
    gap: var(--npcl-gap);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
  }

  .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .noryvelle-pebble-collection-list__item {
    min-width: 0;
  }

  .noryvelle-pebble-collection-list__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .noryvelle-pebble-collection-list__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 6 / 7;
    background: var(--color-variant-component-background);
  }

  .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__media {
    aspect-ratio: 4 / 3;
  }

  .noryvelle-pebble-collection-list__image,
  .noryvelle-pebble-collection-list__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--npcl-focal-point, center center);
  }

  .noryvelle-pebble-collection-list__content {
    display: grid;
    justify-items: center;
    padding: 20px 16px 0;
    gap: 6px;
    text-align: center;
  }

  .noryvelle-pebble-collection-list__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 6px;
  }

  .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__content {
    min-height: 92px;
    align-content: center;
    padding: 16px;
  }

  .noryvelle-pebble-collection-list__title {
    font-family: var(--font-heading--family);
    font-size: var(--font-h5-size);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    letter-spacing: var(--heading-letter-spacing);
    line-height: var(--font-h5-line-height);
    text-transform: var(--heading-text-case);
  }

  .noryvelle-pebble-collection-list__count {
    color: var(--color-text);
    font-size: 10px;
    line-height: 1;
    transform: translateY(-2px);
  }

  .noryvelle-pebble-collection-list__description {
    max-width: 420px;
    color: var(--color-text);
    font-size: var(--font-body-small);
    line-height: 1.5;
  }

  .noryvelle-pebble-collection-list__card:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 4px;
  }

  .noryvelle-pebble-collection-list__mobile-action {
    display: none;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .noryvelle-pebble-collection-list__inner {
      width: calc(100% - 60px);
    }

    .noryvelle-pebble-collection-list--portrait .noryvelle-pebble-collection-list__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__grid {
      display: flex;
      overflow-x: auto;
      grid-template-columns: none;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
    }

    .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__grid::-webkit-scrollbar {
      display: none;
    }

    .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__item {
      flex: 0 0 212px;
      scroll-snap-align: start;
    }

    .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__content {
      min-height: 82px;
    }
  }

  @media screen and (max-width: 749px) {
    .noryvelle-pebble-collection-list__inner {
      width: calc(100% - 32px);
      padding-block: var(--npcl-padding-top-mobile) var(--npcl-padding-bottom-mobile);
    }

    .noryvelle-pebble-collection-list__header {
      display: block;
    }

    .noryvelle-pebble-collection-list__header-action {
      display: none;
    }

    .noryvelle-pebble-collection-list__grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 32px;
    }

    .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__grid {
      display: flex;
      width: calc(100% + 16px);
      margin-right: -16px;
      overflow-x: auto;
      gap: var(--npcl-gap);
      grid-template-columns: none;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
    }

    .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__grid::-webkit-scrollbar {
      display: none;
    }

    .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__item {
      flex: 0 0 212px;
      scroll-snap-align: start;
    }

    .noryvelle-pebble-collection-list__content {
      min-height: 55px;
      padding-top: 16px;
    }

    .noryvelle-pebble-collection-list__content--has-description {
      min-height: 79px;
    }

    .noryvelle-pebble-collection-list--compact .noryvelle-pebble-collection-list__content {
      min-height: 82px;
    }

    .noryvelle-pebble-collection-list__mobile-action {
      display: flex;
      justify-content: center;
      margin-top: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection showcase",
  "tag": "section",
  "class": "section-noryvelle-pebble-collections",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait cards"
        },
        {
          "value": "compact",
          "label": "Compact rail"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted for journeys"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "X-large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Action label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Action link"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card gap",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 56
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "select",
          "id": "focal_point",
          "label": "Image focal point",
          "options": [
            {
              "value": "center center",
              "label": "Center"
            },
            {
              "value": "center top",
              "label": "Top"
            },
            {
              "value": "center bottom",
              "label": "Bottom"
            },
            {
              "value": "left center",
              "label": "Left"
            },
            {
              "value": "right center",
              "label": "Right"
            }
          ],
          "default": "center center"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        },
        {
          "type": "checkbox",
          "id": "show_product_count",
          "label": "Show product count",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial collections",
      "category": "Collections",
      "settings": {
        "layout": "portrait",
        "heading": "Crafted for journeys"
      },
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    },
    {
      "name": "Compact collection rail",
      "category": "Collections",
      "settings": {
        "layout": "compact",
        "heading": "Classic collections"
      },
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    }
  ]
}
{% endschema %}
