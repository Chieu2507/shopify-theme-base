{% liquid
  assign studio_block = section.blocks | where: 'type', 'studio_details' | first
  assign intro_block = section.blocks | where: 'type', 'form_intro' | first
  assign field_blocks = section.blocks | where: 'type', 'form_field'
  assign contact_form_id = 'ContactForm-' | append: section.id
%}

<section
  class="contact-form color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} contact-form--full full-width{% endif %}"
  style="--contact-form-height-desktop: {{ section.settings.height_desktop }}px; --contact-form-height-tablet: {{ section.settings.height_tablet }}px; --contact-form-height-mobile: {{ section.settings.height_mobile }}px; --contact-form-media-width: {{ section.settings.media_width }}%; --contact-form-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="contact-form__inner">
    <h1 class="visually-hidden">{{ page.title | escape }}</h1>
    {% if section.settings.show_breadcrumbs %}
      <nav class="contact-form__breadcrumbs" aria-label="{{ 'accessibility.breadcrumb' | t | escape }}">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | escape }}</a>
        <span aria-hidden="true">/</span>
        <span>{{ section.settings.breadcrumb_current | default: page.title | escape }}</span>
      </nav>
    {% endif %}

    <div class="contact-form__layout">
      <div class="contact-form__media">
        {% if section.settings.image != blank %}
          {% render 'responsive-image',
            image: section.settings.image,
            max_width: 1600,
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'contact-form__image',
            loading: 'lazy',
            alt: section.settings.image.alt
          %}
        {% else %}
          {% render 'media-placeholder', class_name: 'contact-form__placeholder', asset_name: 'placeholder-image-default-2.svg' %}
        {% endif %}
        <div class="contact-form__media-overlay" aria-hidden="true"></div>

        {% if studio_block != blank %}
          <div class="contact-form__studio" {{ studio_block.shopify_attributes }}>
            {% if studio_block.settings.title != blank %}
              <h2 class="contact-form__studio-title">{{ studio_block.settings.title | escape }}</h2>
            {% endif %}
            <div class="contact-form__studio-details">
              {% if studio_block.settings.address != blank %}<p>{{ studio_block.settings.address | escape }}</p>{% endif %}
              {% if studio_block.settings.phone != blank %}<p>{{ studio_block.settings.phone | escape }}</p>{% endif %}
              {% if studio_block.settings.hours != blank %}<p>{{ studio_block.settings.hours | escape }}</p>{% endif %}
            </div>
            {% if studio_block.settings.button_label != blank and studio_block.settings.button_link != blank %}
              <a class="contact-form__studio-button" href="{{ studio_block.settings.button_link }}">
                {{ studio_block.settings.button_label | escape }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="contact-form__content">
        {% if intro_block != blank %}
          <div class="contact-form__intro" {{ intro_block.shopify_attributes }}>
            {% if intro_block.settings.eyebrow != blank %}
              <p class="contact-form__eyebrow">{{ intro_block.settings.eyebrow | escape }}</p>
            {% endif %}
            {% if intro_block.settings.heading != blank %}
              <{{ intro_block.settings.heading_tag | default: 'h2' }} class="contact-form__heading omnise-heading--{{ intro_block.settings.heading_size | default: 'xl' }} heading--{{ intro_block.settings.heading_size | default: 'xl' }}">{{ intro_block.settings.heading | escape }}</{{ intro_block.settings.heading_tag | default: 'h2' }}>
            {% endif %}
            {% if intro_block.settings.description != blank %}
              <p class="contact-form__description">{{ intro_block.settings.description | escape }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% form 'contact', id: contact_form_id, class: 'contact-form__form' %}
          {% if form.posted_successfully? %}
            <p class="contact-form__status contact-form__status--success" tabindex="-1">{{ section.settings.success_message | escape }}</p>
          {% endif %}
          {% if form.errors %}
            <div class="contact-form__status contact-form__status--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="contact-form__fields">
            {% for block in field_blocks %}
              {% liquid
                assign field_id = contact_form_id | append: '-' | append: forloop.index
                assign field_name = 'contact[' | append: block.settings.field_type | append: ']'
                assign field_class = 'contact-form__field'
                if block.settings.field_type == 'name' or block.settings.field_type == 'email'
                  assign field_class = field_class | append: ' contact-form__field--half'
                endif
              %}
              <div class="{{ field_class }}" {{ block.shopify_attributes }}>
                <label for="{{ field_id }}">{{ block.settings.label | escape }}{% if block.settings.required %}<span aria-hidden="true">*</span>{% endif %}</label>
                {% if block.settings.field_type == 'message' %}
                  <textarea id="{{ field_id }}" name="{{ field_name }}" rows="4" placeholder="{{ block.settings.placeholder | escape }}"{% if block.settings.required %} required{% endif %}>{{ form.body | escape }}</textarea>
                {% else %}
                  <input
                    id="{{ field_id }}"
                    type="{% if block.settings.field_type == 'email' %}email{% elsif block.settings.field_type == 'phone' %}tel{% else %}text{% endif %}"
                    name="{{ field_name }}"
                    value="{% if block.settings.field_type == 'name' %}{{ form.name | escape }}{% elsif block.settings.field_type == 'email' %}{{ form.email | escape }}{% endif %}"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    {% if block.settings.required %}required{% endif %}
                  >
                {% endif %}
              </div>
            {% endfor %}
          </div>

          <button type="submit" class="contact-form__submit button button--primary">
            {{ section.settings.submit_label | escape }}
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .contact-form {
    background: var(--gradient-background, var(--color-background));
  }

  .contact-form__inner {
    width: min(100%, var(--page-width));
    margin-inline: auto;
  }

  .contact-form--full .contact-form__inner {
    width: 100%;
  }

  .contact-form__breadcrumbs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding-inline: var(--page-margin);
    color: var(--color-text);
    font-size: var(--font-caption);
  }

  .contact-form__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .contact-form__breadcrumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-form__layout {
    display: grid;
    min-height: var(--contact-form-height-desktop);
    grid-template-columns: minmax(0, var(--contact-form-media-width)) minmax(0, 1fr);
  }

  .contact-form__media {
    position: relative;
    min-height: var(--contact-form-height-desktop);
    overflow: hidden;
    background: var(--color-variant-component-background);
    color: #fff;
  }

  .contact-form__image,
  .contact-form__placeholder,
  .contact-form__media-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .contact-form__image,
  .contact-form__placeholder {
    object-fit: cover;
  }

  .contact-form__placeholder {
    color: color-mix(in srgb, var(--color-heading) 18%, transparent);
  }

  .contact-form__media-overlay {
    background: rgb(0 0 0 / var(--contact-form-overlay-opacity));
  }

  .contact-form__studio {
    position: absolute;
    z-index: 1;
    right: clamp(24px, 5vw, 80px);
    bottom: clamp(24px, 5vw, 64px);
    left: clamp(24px, 5vw, 80px);
  }

  .contact-form__studio-title {
    margin: 0 0 10px;
    color: inherit;
    font-family: var(--font-body--family);
    font-size: clamp(22px, 2vw, 30px);
    font-weight: 400;
    line-height: 1.15;
  }

  .contact-form__studio-details {
    display: grid;
    gap: 2px;
    color: rgb(255 255 255 / 88%);
    font-size: var(--font-caption);
    line-height: 1.5;
  }

  .contact-form__studio-details p {
    margin: 0;
  }

  .contact-form__studio-button {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    margin-top: 22px;
    padding: 0 18px;
    border: 1px solid rgb(255 255 255 / 80%);
    color: #fff;
    font-size: 10px;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .contact-form__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 5vw, 88px);
    background: var(--gradient-background, var(--color-background));
  }

  .contact-form__intro {
    max-width: 560px;
    margin: 0 auto 24px;
    text-align: center;
  }

  .contact-form__eyebrow {
    margin: 0 0 10px;
    color: var(--color-text);
    font-size: var(--font-caption);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .contact-form__heading {
    margin: 0;
    color: var(--color-heading);
    font-size: var(--font-h3-size);
    line-height: var(--font-h3-line-height);
    text-transform: none;
  }

  .contact-form__description {
    margin: 8px auto 0;
    color: var(--color-text);
    font-size: var(--font-caption);
    line-height: 1.5;
  }

  .contact-form__form {
    width: min(100%, 560px);
    margin-inline: auto;
  }

  .contact-form__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 12px;
  }

  .contact-form__field {
    display: grid;
    gap: 5px;
  }

  .contact-form__field:not(.contact-form__field--half) {
    grid-column: 1 / -1;
  }

  .contact-form__field label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    border: 1px solid transparent;
    border-radius: var(--style-border-radius-inputs);
    background: #fff;
    color: var(--color-heading);
    font-size: var(--font-caption);
    line-height: 1.4;
    outline: none;
    padding: 10px 12px;
  }

  .contact-form__field input {
    min-height: var(--control-height);
  }

  .contact-form__field textarea {
    min-height: 84px;
    resize: vertical;
  }

  .contact-form__field input::placeholder,
  .contact-form__field textarea::placeholder {
    color: #a0a0a0;
    opacity: 1;
  }

  .contact-form__field input:focus-visible,
  .contact-form__field textarea:focus-visible {
    border-color: currentcolor;
  }

  .contact-form__submit {
    display: flex;
    min-height: var(--control-height);
    margin: 20px auto 0;
    padding-inline: var(--button-inline-padding);
    font-size: var(--font-caption);
  }

  .contact-form__status {
    margin: 0 0 16px;
    font-size: var(--font-caption);
    line-height: 1.5;
    text-align: center;
  }

  .contact-form__status--success { color: #246b3e; }
  .contact-form__status--error { color: #a22727; }

  @media screen and (max-width: 989px) {
    .contact-form__layout,
    .contact-form__media {
      min-height: var(--contact-form-height-tablet);
    }
  }

  @media screen and (max-width: 749px) {
    .contact-form__breadcrumbs {
      min-height: 36px;
    }

    .contact-form__layout {
      display: block;
      min-height: 0;
    }

    .contact-form__media {
      min-height: var(--contact-form-height-mobile);
    }

    .contact-form__content {
      padding: 48px var(--page-margin) 56px;
    }

    .contact-form__fields {
      grid-template-columns: 1fr;
    }

    .contact-form__field--half,
    .contact-form__field:not(.contact-form__field--half) {
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Studio image"
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 35,
      "max": 65,
      "step": 1,
      "unit": "%",
      "label": "Image width",
      "default": 50
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 25
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 420,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Desktop height",
      "default": 620
    },
    {
      "type": "range",
      "id": "height_tablet",
      "min": 420,
      "max": 760,
      "step": 10,
      "unit": "px",
      "label": "Tablet height",
      "default": 560
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 360,
      "max": 760,
      "step": 10,
      "unit": "px",
      "label": "Mobile image height",
      "default": 520
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Breadcrumb home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_current",
      "label": "Breadcrumb current label",
      "default": "Contact us"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Submit now"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for contacting us. We will be in touch shortly."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "studio_details",
      "name": "Studio details",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sydney Studio"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address",
          "default": "123 Sample St, Sydney NSW 2000 AU"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+1 555 000 000"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Opening hours",
          "default": "Mon-Sat: 10:00-20:00"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Appointment button label",
          "default": "Book appointment"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Appointment button link"
        }
      ]
    },
    {
      "type": "form_intro",
      "name": "Form introduction",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Send a message"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Do You Have Any Question?"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "h1",
              "label": "XX-large"
            },
            {
              "value": "h2",
              "label": "X-large"
            },
            {
              "value": "h3",
              "label": "Large"
            },
            {
              "value": "h4",
              "label": "Medium"
            },
            {
              "value": "h5",
              "label": "Small"
            },
            {
              "value": "h6",
              "label": "X-small"
            }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "HTML Tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            }
          ],
          "default": "h2"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Submit the contact form and our team will be in touch shortly."
        }
      ]
    },
    {
      "type": "form_field",
      "name": "Form field",
      "settings": [
        {
          "type": "select",
          "id": "field_type",
          "label": "Field type",
          "options": [
            {
              "value": "name",
              "label": "Name"
            },
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "phone",
              "label": "Phone number"
            },
            {
              "value": "address",
              "label": "Address"
            },
            {
              "value": "message",
              "label": "Message"
            }
          ],
          "default": "name"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Contact form",
      "category": "Blog & pages",
      "settings": {
        "section_width": "full",
        "color_scheme": "scheme-2",
        "media_width": 50
      },
      "blocks": [
        {
          "type": "studio_details"
        },
        {
          "type": "form_intro"
        },
        {
          "type": "form_field",
          "settings": {
            "field_type": "name",
            "label": "Name",
            "placeholder": "Name"
          }
        },
        {
          "type": "form_field",
          "settings": {
            "field_type": "email",
            "label": "Email",
            "placeholder": "Email"
          }
        },
        {
          "type": "form_field",
          "settings": {
            "field_type": "phone",
            "label": "Phone number",
            "placeholder": "Phone number"
          }
        },
        {
          "type": "form_field",
          "settings": {
            "field_type": "address",
            "label": "Address",
            "placeholder": "Address"
          }
        },
        {
          "type": "form_field",
          "settings": {
            "field_type": "message",
            "label": "Message",
            "placeholder": "Message"
          }
        }
      ]
    }
  ]
}
{% endschema %}
