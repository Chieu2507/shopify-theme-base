          "default": "<p>Thoughtfully made pieces, designed to be treasured every day.</p>"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size",
          "options": [
            { "value": "x-large", "label": "X-large" },
            { "value": "large", "label": "Large" },
            { "value": "medium", "label": "Medium" },
            { "value": "small", "label": "Small" },
            { "value": "x-small", "label": "X-small" }
          ],
          "default": "medium"
        }
      ]
    },
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "select",
          "id": "icon_name",
          "label": "Default icon",
          "options": [
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "box", "label": "Box" }
          ],
          "default": "sparkles",
          "info": "Shown when no custom icon image is selected."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quality That Lasts"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Overrides the heading when set."
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "FAQ anchor ID",
          "info": "Links this item to a matching FAQ group anchor."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>For extra peace of mind, every piece is covered by our two-year warranty.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon with text",
      "blocks": [
        {
          "type": "header"
        },
        {
          "type": "item",
          "settings": {
            "heading": "Quality That Lasts",
            "text": "<p>For extra peace of mind, every piece is covered by our two-year warranty.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Sustainably Made",
            "text": "<p>Handcrafted from responsibly sourced materials, with 100% certified recycled gold.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Premium Service",
            "text": "<p>Fast free shipping over $100, plus hassle-free returns and attentive support.</p>"
