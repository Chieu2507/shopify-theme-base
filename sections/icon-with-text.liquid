{% render 'section-stylesheet', asset: 'section-icon-with-text.css', defer_on_home: true %}

{% liquid
  assign item_count = section.blocks | where: 'type', 'item' | size
  assign header_count = section.blocks | where: 'type', 'header' | size
%}

{% if item_count > 0 or header_count > 0 %}
  <section
    class="icon-with-text icon-with-text--icon-{{ section.settings.icon_size | default: 'small' }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
    style="--section-padding-top: {{ section.settings.padding_top | default: 10 }}px; --section-padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px; --icon-with-text-column-gap: {{ section.settings.column_gap | default: 28 }}px; --icon-with-text-row-gap: {{ section.settings.row_gap | default: 40 }}px; --icon-with-text-content-gap: {{ section.settings.content_gap | default: 24 }}px; --icon-with-text-columns-desktop: {{ section.settings.columns_desktop | default: 1 }}; --icon-with-text-columns-tablet: {{ section.settings.columns_desktop | default: 1 }}; --icon-with-text-columns-mobile: {{ section.settings.columns_mobile | default: 1 }};{% if section.settings.background_color != blank %} --icon-with-text-background: {{ section.settings.background_color }};{% endif %}"
  >
    <div class="icon-with-text__inner section-spacing">
      {% if section.settings.heading != blank %}
        <header class="icon-with-text__header">
          <h2 class="icon-with-text__section-heading spinel-heading--h2">{{ section.settings.heading | escape }}</h2>
        </header>
      {% endif %}

      {% if header_count > 0 %}
        <header class="icon-with-text__header">
          {% for block in section.blocks %}
            {% if block.type == 'header' %}
              {% assign icon_with_text_header_text_class = 'icon-with-text__intro content-text content-text--' | append: block.settings.text_size %}
              {% capture header_attributes %}{{ block.shopify_attributes }}{% endcapture %}
              {% render 'section-header',
                heading: block.settings.heading,
                heading_tag: block.settings.heading_tag,
                heading_size: block.settings.heading_size,
                heading_class: 'icon-with-text__heading',
                text: block.settings.text,
                text_class: icon_with_text_header_text_class,
                alignment: 'center',
                class: 'icon-with-text__header-content',
                tag: 'div',
                attributes: header_attributes
              %}
            {% endif %}
          {% endfor %}
        </header>
      {% endif %}

      {% if item_count > 0 %}
        <div class="icon-with-text__list" role="list">
            {% for block in section.blocks %}
              {% if block.type == 'item' %}
                {% assign item_heading = block.settings.title | default: block.settings.heading %}
                {% assign item_anchor = block.settings.anchor_id | handleize %}
                {% if item_anchor != blank %}
                  <a class="icon-with-text__item-link" href="#{{ item_anchor }}">
                {% endif %}
                <div class="icon-with-text__item icon-with-text__item--{{ section.settings.item_style | default: 'default' }}" role="listitem" {{ block.shopify_attributes }}>
                  <div class="icon-with-text__icon" aria-hidden="true">
                    {% if block.settings.icon != blank %}
                      {% render 'responsive-image',
                        image: block.settings.icon,
                        max_width: 96,
                        widths: '32, 48, 64, 96',
                        sizes: '32px',
                        class: 'icon-with-text__icon-image',
                        loading: 'lazy',
                        decorative: true
                      %}
                    {% else %}
                      {% render 'icon', name: block.settings.icon_name %}
                    {% endif %}
                  </div>

                  <div class="icon-with-text__content">
                    {% if item_heading != blank %}
                      <{{ section.settings.heading_tag }} class="icon-with-text__heading spinel-heading--{{ section.settings.heading_size | default: 'h4' }} heading--{{ section.settings.heading_size | default: 'h4' }}">
                        {{ item_heading | escape }}
                      </{{ section.settings.heading_tag }}>
                    {% endif %}

                    {% if block.settings.text != blank %}
                      <div class="icon-with-text__text content-text spinel-text--{{ section.settings.text_size }} content-text--{{ section.settings.text_size }} rte">
                        {{ block.settings.text }}
                      </div>
                    {% endif %}
                  </div>
                </div>
                {% if item_anchor != blank %}
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}



{% schema %}
{
  "name": "Icon with text",
  "tag": "section",
  "class": "section-icon-with-text",
  "max_blocks": 9,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop columns / items",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns / items",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "contained"
    },
    {
      "type": "select",
      "id": "item_style",
      "label": "Item style",
      "options": [
        {
          "value": "with-border",
          "label": "With border"
        },
        {
          "value": "with-background",
          "label": "With background"
        },
        {
          "value": "default",
          "label": "Default"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "Icon size",
      "default": "small",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Icon to text gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Row gap",
      "default": 40
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "XX-large"
        },
        {
          "value": "h2",
          "label": "X-large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-small"
        }
      ],
      "default": "h5"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "x-large",
          "label": "X-large"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "x-small",
          "label": "X-small"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Optional. Overrides the color scheme background. Clear it to use the color scheme."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "header",
      "name": "Header",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Why Choose Us"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h1", "label": "XX-large" },
            { "value": "h2", "label": "X-large" },
            { "value": "h3", "label": "Large" },
            { "value": "h4", "label": "Medium" },
            { "value": "h5", "label": "Small" },
            { "value": "h6", "label": "X-small" }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "HTML Tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h2"
