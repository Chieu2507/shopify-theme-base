{% render 'section-stylesheet', asset: 'section-sticky-scroll.css' %}
{% render 'section-stylesheet', asset: 'section-image-stack.css' %}

{% liquid
  assign section_background = section.settings.background_color
  assign section_background_image = section.settings.background_image
  assign section_mobile_background_image = section.settings.mobile_background_image
  assign section_description = section.settings.accessibility_label | default: 'Image stack'
%}

{% if section_background != blank or section_background_image != blank %}
  <style>
    #shopify-section-{{ section.id }} {
      {% if section_background != blank %}background-color: {{ section_background }};{% endif %}
      {% if section_background_image != blank %}
        background-image: url('{{ section_background_image | image_url: width: 2400 }}');
        background-position: center;
        background-size: cover;
      {% endif %}
    }
    {% if section_mobile_background_image != blank %}
      @media screen and (max-width: 767.98px) {
        #shopify-section-{{ section.id }} {
          background-image: url('{{ section_mobile_background_image | image_url: width: 1280 }}');
        }
      }
    {% endif %}
  </style>
{% endif %}

<sticky-scroll
  class="sticky-scroll image-stack image-stack--effect-{{ section.settings.scroll_effect_style }} sticky-scroll--width-{{ section.settings.section_width }} sticky-scroll--mobile-stacked sticky-scroll--mobile-ratio-{{ section.settings.mobile_image_ratio }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  role="region"
  aria-label="{{ section_description | escape }}"
  data-section-id="{{ section.id }}"
  data-design-mode="{{ request.design_mode }}"
  data-mobile-layout="stacked"
  data-scroll-effect-style="{{ section.settings.scroll_effect_style }}"
  style="--sticky-scroll-panel-count: {{ section.blocks.size }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="sticky-scroll__stage" data-sticky-scroll-stage>
    {% content_for 'blocks' %}

    {% if section.settings.scroll_effect_style == 'scene' %}
      <div class="image-stack__media-stack" aria-hidden="true" data-image-stack-media-stack>
        {% for block in section.blocks %}
          {% liquid
            assign panel_alt = block.settings.alt | default: block.settings.image.alt
            assign card_ratio = block.settings.image_ratio | default: '4-5'
            case card_ratio
              when 'adapt'
                assign card_ratio = 'auto'
              when 'square'
                assign card_ratio = '1 / 1'
              else
                assign card_ratio = card_ratio | replace: '-', ' / '
            endcase
          %}
          <div
            class="image-stack__media-layer"
            data-image-stack-media-index="{{ forloop.index0 }}"
            style="--image-stack-card-ratio: {{ card_ratio }}; --sticky-scroll-image-position: {{ block.settings.image_position }};"
          >
            {% render 'responsive-media', image: block.settings.image, mobile_image: block.settings.mobile_image, mobile_breakpoint: 767, max_width: 1200, mobile_max_width: 960, widths: '320, 480, 640, 800, 960, 1200', mobile_widths: '375, 550, 750, 960', sizes: '(min-width: 768px) 28vw, calc(100vw - 2 * var(--page-margin))', class: 'image-stack__media-image', loading: 'lazy', alt: panel_alt, placeholder_asset: 'image', placeholder_class: 'image-stack__media-placeholder' %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.blocks.size > 1 %}
      <nav class="sticky-scroll__steps" aria-label="Image stack steps" data-sticky-scroll-steps></nav>
    {% endif %}
  </div>
</sticky-scroll>

<script type="module" src="{{ 'sticky-scroll.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Image stack",
  "tag": "section",
  "class": "section-image-stack",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "scroll_effect_style",
      "label": "Scroll effect style",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" },
        { "value": "scene", "label": "Scene" }
      ],
      "default": "scene"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "Mobile image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "2-3", "label": "Portrait (2:3)" },
        { "value": "3-4", "label": "Standard (3:4)" },
        { "value": "4-5", "label": "Portrait (4:5)" },
        { "value": "6-7", "label": "Classic (6:7)" },
        { "value": "3-2", "label": "Landscape (3:2)" },
        { "value": "4-3", "label": "Landscape (4:3)" },
        { "value": "16-9", "label": "Wide (16:9)" }
      ],
      "default": "4-5"
    },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "image_picker", "id": "mobile_background_image", "label": "Mobile background image" },
    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "info": "Describes this section for screen reader users.", "default": "Image stack" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "image-stack-scene" }
  ],
  "presets": [
    {
      "name": "Image stack",
      "category": "Editorial content",
      "settings": { "scroll_effect_style": "scene", "section_width": "full", "mobile_image_ratio": "4-5" },
      "blocks": [
        {
          "type": "image-stack-scene",
          "settings": { "content_position": "bottom-left", "content_alignment": "left", "content_width": 520, "content_gap": 20 },
          "blocks": [
            { "type": "label", "settings": { "text": "<p>THE COLLECTION</p>", "reveal_type": "fade-up", "reveal_delay": 0 } },
            { "type": "heading", "settings": { "heading": "<h2>Beauty in every detail.</h2>", "type_preset": "h2", "reveal_type": "fade-up", "reveal_delay": 150 } },
            { "type": "text", "settings": { "text": "<p>Each piece is shaped through a quiet study of material, proportion and light.</p>", "type_preset": "sm", "reveal_type": "fade-up", "reveal_delay": 300 } },
            { "type": "button", "settings": { "label": "Shop the collection", "style": "tertiary", "icon": "arrow-right", "reveal_type": "fade-up", "reveal_delay": 450 } }
          ]
        },
        {
          "type": "image-stack-scene",
          "settings": { "content_position": "bottom-left", "content_alignment": "left", "content_width": 520, "content_gap": 20 },
          "blocks": [
            { "type": "label", "settings": { "text": "<p>THE CRAFT</p>", "reveal_type": "fade-up", "reveal_delay": 0 } },
            { "type": "heading", "settings": { "heading": "<h2>Made to be remembered.</h2>", "type_preset": "h2", "reveal_type": "fade-up", "reveal_delay": 150 } },
            { "type": "text", "settings": { "text": "<p>Designed with an attention to the detail that gives every object its character.</p>", "type_preset": "sm", "reveal_type": "fade-up", "reveal_delay": 300 } },
            { "type": "button", "settings": { "label": "Discover the craft", "style": "tertiary", "icon": "arrow-right", "reveal_type": "fade-up", "reveal_delay": 450 } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
