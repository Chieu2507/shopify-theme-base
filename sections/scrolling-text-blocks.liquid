{% render 'section-stylesheet', asset: 'section-scrolling-text-critical.css', inline_on_home: true %}

{% content_for 'blocks' %}

{% liquid
  assign text_blocks = section.blocks | where: 'type', '_scrolling-text-item'
  assign item_count = 0
  for text_block in text_blocks
    if text_block.settings.text != blank
      assign item_count = item_count | plus: 1
    endif
  endfor
%}

{% if item_count > 0 %}
  <section
    class="scrolling-text color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}{% if section.settings.behavior %} scrolling-text--marquee{% endif %} scrolling-text--direction-{{ section.settings.direction }} scrolling-text--icon-{{ section.settings.icon_size }} scrolling-text--font-{{ section.settings.font_role }}{% if section.settings.pause_on_hover %} scrolling-text--pause-on-hover{% endif %}"
    style="--scrolling-text-height: {{ section.settings.height_desktop }}px; --scrolling-text-height-mobile: {{ section.settings.height_mobile }}px; --scrolling-text-gap: {{ section.settings.item_gap }}px; --scrolling-text-duration: {{ section.settings.speed }}s; --scrolling-text-font-size: {{ section.settings.font_size }}px; --scrolling-text-font-size-mobile: {{ section.settings.font_size_mobile }}px;"
    data-deferred-module="{{ 'section-scrolling-text.js' | asset_url }}"
    aria-label="{{ 'scrolling_text.announcements' | t | escape }}"
  >
    <scrolling-text-marquee class="scrolling-text__viewport">
      <div class="scrolling-text__track">
        <div class="scrolling-text__group">
          {% for text_block in text_blocks %}
            {% if text_block.settings.text != blank %}
              <div class="scrolling-text__item" {{ text_block.shopify_attributes }}>
                {% if text_block.settings.link != blank %}
                  <a class="scrolling-text__link" href="{{ text_block.settings.link }}">{{ text_block.settings.text | escape }}</a>
                {% else %}
                  <span>{{ text_block.settings.text | escape }}</span>
                {% endif %}
              </div>
              {% if section.settings.separator_icon != blank %}
                <span class="scrolling-text__separator" aria-hidden="true">
                  {% render 'responsive-image',
                    image: section.settings.separator_icon,
                    max_width: 128,
                    widths: '16, 24, 32, 48, 64, 96, 128',
                    sizes: 'var(--scrolling-text-icon-size)',
                    class: 'scrolling-text__icon',
                    decorative: true,
                    loading: 'lazy'
                  %}
                </span>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.behavior %}
          <div class="scrolling-text__group" aria-hidden="true">
            {% for text_block in text_blocks %}
              {% if text_block.settings.text != blank %}
                <div class="scrolling-text__item">
                  {% if text_block.settings.link != blank %}
                    <a class="scrolling-text__link" href="{{ text_block.settings.link }}" tabindex="-1">{{ text_block.settings.text | escape }}</a>
                  {% else %}
                    <span>{{ text_block.settings.text | escape }}</span>
                  {% endif %}
                </div>
                {% if section.settings.separator_icon != blank %}
                  <span class="scrolling-text__separator" aria-hidden="true">
                    {% render 'responsive-image',
                      image: section.settings.separator_icon,
                      max_width: 128,
                      widths: '16, 24, 32, 48, 64, 96, 128',
                      sizes: 'var(--scrolling-text-icon-size)',
                      class: 'scrolling-text__icon',
                      decorative: true,
                      loading: 'lazy'
                    %}
                  </span>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </scrolling-text-marquee>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:scrolling_text_blocks.name",
  "tag": "section",
  "class": "section-scrolling-text",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "t:scrolling_text_blocks.behavior"
    },
    {
      "type": "checkbox",
      "id": "behavior",
      "label": "t:scrolling_text_blocks.enable_scrolling",
      "default": true
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:scrolling_text_blocks.direction",
      "options": [
        {
          "value": "left",
          "label": "t:scrolling_text_blocks.left"
        },
        {
          "value": "right",
          "label": "t:scrolling_text_blocks.right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.behavior }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:scrolling_text_blocks.pause_on_hover",
      "default": true,
      "visible_if": "{{ section.settings.behavior }}"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "label": "t:scrolling_text_blocks.scrolling_duration",
      "default": 35,
      "visible_if": "{{ section.settings.behavior }}"
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 12,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "t:scrolling_text_blocks.item_gap",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:scrolling_text_blocks.typography"
    },
    {
      "type": "select",
      "id": "font_role",
      "label": "t:scrolling_text_blocks.text_font",
      "options": [
        {
          "value": "heading",
          "label": "t:scrolling_text_blocks.heading_font"
        },
        {
          "value": "body",
          "label": "t:scrolling_text_blocks.body_font"
        }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:scrolling_text_blocks.desktop_font_size",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "t:scrolling_text_blocks.mobile_font_size",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:scrolling_text_blocks.separator_icon"
    },
    {
      "type": "image_picker",
      "id": "separator_icon",
      "label": "t:scrolling_text_blocks.icon_image"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "t:scrolling_text_blocks.icon_size",
      "default": "small",
      "options": [
        {
          "value": "small",
          "label": "t:scrolling_text_blocks.small"
        },
        {
          "value": "medium",
          "label": "t:scrolling_text_blocks.medium"
        },
        {
          "value": "large",
          "label": "t:scrolling_text_blocks.large"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:scrolling_text_blocks.section_height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 40,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "t:scrolling_text_blocks.desktop",
      "default": 64
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 36,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "t:scrolling_text_blocks.mobile",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:scrolling_text_blocks.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:scrolling_text_blocks.section_width",
      "options": [
        {
          "value": "full",
          "label": "t:scrolling_text_blocks.full_width"
        },
        {
          "value": "page",
          "label": "t:scrolling_text_blocks.page_width"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "t:scrolling_text_blocks.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:scrolling_text_blocks.color_scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "_scrolling-text-item"
    }
  ],
  "presets": [
    {
      "name": "t:scrolling_text_blocks.name",
      "category": "t:scrolling_text_blocks.category",
      "blocks": [
        {
          "type": "_scrolling-text-item",
          "settings": {
            "text": "t:scrolling_text_blocks.sustainable_manufacturing"
          }
        },
        {
          "type": "_scrolling-text-item",
          "settings": {
            "text": "t:scrolling_text_blocks.made_to_be_used"
          }
        },
        {
          "type": "_scrolling-text-item",
          "settings": {
            "text": "t:scrolling_text_blocks.considered_materials"
          }
        },
        {
          "type": "_scrolling-text-item",
          "settings": {
            "text": "t:scrolling_text_blocks.made_with_love"
          }
        },
        {
          "type": "_scrolling-text-item",
          "settings": {
            "text": "t:scrolling_text_blocks.carefully_finished"
          }
        }
      ]
    }
  ]
}
{% endschema %}
