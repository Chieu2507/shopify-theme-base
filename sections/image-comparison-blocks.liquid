{% render 'section-stylesheet', asset: 'section-image-comparison.css', defer_on_home: true %}

{% liquid
  assign before_block = section.blocks | where: 'id', 'before' | first
  assign before_image = before_block.settings.image | default: before_block.settings.mobile_image
  assign comparison_ratio = before_image.aspect_ratio | default: 1.333333

  assign page_width_pixels = settings.max_page_width | remove: 'rem' | times: 16
  assign desktop_page_margin = settings.page_margin_desktop | at_least: settings.min_page_margin
  assign tablet_page_margin = settings.page_margin_tablet | at_least: settings.min_page_margin
  assign mobile_page_margin = settings.page_margin_mobile | at_least: settings.min_page_margin
  assign desktop_horizontal_margin = desktop_page_margin | times: 2
  assign tablet_horizontal_margin = tablet_page_margin | times: 2
  assign mobile_horizontal_margin = mobile_page_margin | times: 2
  assign comparison_max_width = page_width_pixels | minus: desktop_horizontal_margin
  capture comparison_image_sizes
    echo '(min-width: '
    echo page_width_pixels
    echo 'px) '
    echo comparison_max_width
    echo 'px, (min-width: 990px) calc(100vw - '
    echo desktop_horizontal_margin
    echo 'px), (min-width: 750px) calc(100vw - '
    echo tablet_horizontal_margin
    echo 'px), calc(100vw - '
    echo mobile_horizontal_margin
    echo 'px)'
  endcapture
%}

<section
  class="image-comparison image-comparison--blocks color-scheme color-{{ section.settings.color_scheme.id }} image-comparison--{{ section.settings.layout }} full-width"
  style="--image-comparison-ratio: {{ comparison_ratio }}; --image-comparison-height-desktop: {{ section.settings.desktop_height }}; --image-comparison-height-mobile: {{ section.settings.mobile_height }}; --image-comparison-layout-gap: {{ section.settings.layout_gap }}px; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="image-comparison__inner section-spacing">
    <div class="image-comparison__content">
      {% content_for 'block', type: 'group', id: 'header' %}
    </div>

    <image-comparison-slider
      class="image-comparison__slider image-comparison__slider--{{ section.settings.layout }} image-comparison__slider--desktop-height-{{ section.settings.desktop_height }} image-comparison__slider--mobile-height-{{ section.settings.mobile_height }}"
      style="--comparison-position: 20%;"
      data-orientation="{{ section.settings.layout }}"
      data-deferred-module="{{ 'section-image-comparison.js' | asset_url }}"
      aria-label="{{ 'image_comparison.comparison_label' | t | escape }}"
    >
      {% content_for 'block',
        type: '_image-comparison-panel',
        id: 'before',
        side: 'before',
        image_sizes: comparison_image_sizes,
        placeholder_asset: 'placeholder-image-default-1.svg'
      %}

      {% content_for 'block',
        type: '_image-comparison-panel',
        id: 'after',
        side: 'after',
        image_sizes: comparison_image_sizes,
        placeholder_asset: 'placeholder-image-default-2.svg'
      %}

      <button
        class="image-comparison__handle"
        type="button"
        data-image-comparison-handle
        role="slider"
        aria-label="{{ 'image_comparison.handle_label' | t | escape }}"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="20"
        aria-orientation="{% if section.settings.layout == 'vertical' %}vertical{% else %}horizontal{% endif %}"
      >
        <span class="visually-hidden" data-image-comparison-value>20%</span>
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path d="m11 9-7 7 7 7M21 9l7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
      </button>
    </image-comparison-slider>
  </div>
</section>

{% stylesheet %}
  .image-comparison--blocks .image-comparison__content > .spinel-group {
    width: 100%;
  }

  .image-comparison--blocks
    .image-comparison__content:not(:has(.spinel-group__content > *)) {
    display: none;
  }

  .image-comparison--blocks .image-comparison__overlay {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .image-comparison--blocks
    .image-comparison__overlay:has(.typography-block, .content-button)
    > .image-comparison__overlay-label {
    display: none;
  }

  .image-comparison--blocks .image-comparison__overlay > .spinel-group {
    width: 100%;
  }

  .image-comparison--blocks .image-comparison__overlay .typography-block {
    color: inherit;
  }

  .image-comparison--blocks
    .image-comparison__overlay
    .typography-block__content,
  .image-comparison--blocks
    .image-comparison__overlay
    .typography-block__content
    :is(p, h1, h2, h3, h4, h5, h6) {
    color: inherit !important;
  }

  .image-comparison--blocks
    .image-comparison__overlay
    .typography-block--heading[data-spinel-line-height='tight'] {
    --typography-line-height: 1.12 !important;
  }

  .image-comparison--blocks .image-comparison__overlay .content-button {
    pointer-events: auto;
  }

  .image-comparison--blocks
    .image-comparison__overlay
    .content-button
    .button--tertiary {
    padding-bottom: 4px;
    border-bottom: 1px solid currentcolor;
    color: inherit;
    font-size: 13px;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }
{% endstylesheet %}

