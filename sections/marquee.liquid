{% render 'section-stylesheet', asset: 'section-marquee-critical.css', inline_on_home: true %}

<section
  class="marquee-section color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% endif %}"
  style="--marquee-section-gap: {{ section.settings.marquee_gap }}px; --marquee-section-padding-top: {{ section.settings.padding_top }}px; --marquee-section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-deferred-module="{{ 'section-marquee.js' | asset_url }}"
  aria-label="{{ 'marquee.announcements' | t | escape }}"
>
  <div class="marquee-section__inner{% if section.settings.section_width == 'page' %} marquee-section__inner--page{% endif %}">
    {% content_for 'blocks' %}
  </div>
</section>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "section-marquee",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "marquee"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "marquee_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Space between marquees",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "category": "Marketing",
      "blocks": [
        {
          "type": "marquee",
          "blocks": [
            {
              "type": "text",
              "settings": {
                "text": "<p>Comfort Products</p>",
                "type_preset": "paragraph"
              }
            },
            {
              "type": "marquee-media"
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>PEBBLE</p>",
                "type_preset": "paragraph"
              }
            },
            {
              "type": "marquee-media"
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Organic Cotton</p>",
                "type_preset": "paragraph"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
