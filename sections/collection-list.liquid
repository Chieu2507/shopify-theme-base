        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "HTML Tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            }
          ],
          "default": "h3",
          "visible_if": "{{ section.settings.layout == 'split-promotions' }}"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "CTA",
          "visible_if": "{{ section.settings.layout == 'split-promotions' }}"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
