          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Everyday edit"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Occasion pieces"
          }
        }
      ]
    },
    {
      "name": "Collection list split promotions",
      "category": "Collections",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "eyebrow": "Sale up to 20%",
            "title": "The signature edit",
            "button_label": "Shop all",
            "overlay_opacity": 0
          }
        },
        {
          "type": "collection_card",
          "settings": {
