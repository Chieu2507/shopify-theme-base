          ],
          "default": "bottom",
          "visible_if": "{{ section.settings.layout == 'split-promotions' }}"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "h1",
              "label": "XX-large"
            },
            {
              "value": "h2",
              "label": "X-large"
