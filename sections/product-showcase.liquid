{% render 'section-stylesheet', asset: 'section-product-showcase.css', defer_on_home: true %}
{% liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign tab_blocks = section.blocks | where: 'type', 'collection_tab'
  assign section_collection = section.settings.collection
  assign section_collection_url = section_collection.url
  assign section_cta_url = section.settings.cta_link | default: section_collection_url
%}

<noryvelle-pebble-products
  class="noryvelle-pebble-products noryvelle-pebble-products--{{ section.settings.layout }} color-scheme color-{{ section.settings.color_scheme.id }} full-width"
  data-layout="{{ section.settings.layout }}"
  data-deferred-module="{{ 'section-product-showcase.js' | asset_url }}"
  style="--npp-padding-top: {{ section.settings.padding_top }}px; --npp-padding-bottom: {{ section.settings.padding_bottom }}px; --npp-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --npp-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --npp-gap: {{ section.settings.card_gap }}px;"
>
  <div class="noryvelle-pebble-products__inner">
    {% unless section.settings.layout == 'editorial' %}
      {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank %}
        <header class="noryvelle-pebble-products__header">
          {% if section.settings.eyebrow != blank %}
            <p class="noryvelle-pebble-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <{{ section.settings.heading_tag }} class="noryvelle-pebble-products__heading heading--{{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </{{ section.settings.heading_tag }}>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="noryvelle-pebble-products__text rte">{{ section.settings.text }}</div>
          {% endif %}
        </header>
      {% endif %}
    {% endunless %}

    {% case section.settings.layout %}
      {% when 'tabbed' %}
        {% if tab_blocks.size > 0 %}
          <div
            class="noryvelle-pebble-products__tabs"
            role="tablist"
            aria-label="{{ 'featured_collection.tabs' | t | escape }}"
          >
            {% for block in tab_blocks %}
              {% liquid
                assign tab_label = block.settings.label | default: block.settings.collection.title
                if tab_label == blank
                  assign tab_label = 'collection_list.collection' | t
                endif
              %}
              <button
                class="noryvelle-pebble-products__tab"
                id="NoryvelleProductsTab-{{ section.id }}-{{ block.id }}"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="NoryvelleProductsPanel-{{ section.id }}-{{ block.id }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-npp-tab
              >
                {{ tab_label | escape }}
              </button>
            {% endfor %}
          </div>

          <div class="noryvelle-pebble-products__panels">
            {% for block in tab_blocks %}
              {% liquid
                assign tab_collection = block.settings.collection
                assign tab_collection_url = tab_collection.url
                assign tab_cta_url = section.settings.cta_link | default: tab_collection_url
              %}
              <section
                class="noryvelle-pebble-products__panel"
                id="NoryvelleProductsPanel-{{ section.id }}-{{ block.id }}"
                role="tabpanel"
                aria-labelledby="NoryvelleProductsTab-{{ section.id }}-{{ block.id }}"
                data-npp-panel
                data-block-id="{{ block.id }}"
                {% unless forloop.first %}hidden{% endunless %}
                {{ block.shopify_attributes }}
              >
                <div class="noryvelle-pebble-products__rail-shell">
                  <ul class="noryvelle-pebble-products__rail" role="list" data-npp-rail>
                    {% if tab_collection != blank and tab_collection.products_count > 0 %}
                      {% for product in tab_collection.products limit: section.settings.products_to_show %}
                        <li class="noryvelle-pebble-products__product">
                          {% render 'product-card',
                            product: product,
                            media_ratio: 'square',
                            show_badges: true,
                            show_compare_at_price: true,
                            show_variant_dots: true,
                            show_media_actions: true,
                            enable_quick_view: true,
                            sizes: '(min-width: 990px) 25vw, 280px'
                          %}
                        </li>
                      {% endfor %}
                    {% else %}
                      {% for placeholder_index in (1..4) %}
                        <li class="noryvelle-pebble-products__product">
                          {% render 'product-card',
                            placeholder_index: placeholder_index,
                            media_ratio: 'square',
                            show_badges: true,
                            show_variant_dots: true,
                            sizes: '(min-width: 990px) 25vw, 280px'
                          %}
                        </li>
                      {% endfor %}
                    {% endif %}
                  </ul>
                </div>
                <div class="noryvelle-pebble-products__navigation">
                  <button
                    class="noryvelle-pebble-products__arrow noryvelle-pebble-products__arrow--previous"
                    type="button"
                    aria-label="{{ 'featured_collection.previous_products' | t | escape }}"
                    data-npp-previous
                    disabled
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  {% if section.settings.cta_label != blank and tab_cta_url != blank %}
                    <div class="noryvelle-pebble-products__cta">
                      {% render 'cta',
                        label: section.settings.cta_label,
                        url: tab_cta_url,
                        style: 'tertiary'
                      %}
                    </div>
                  {% endif %}
                  <button
                    class="noryvelle-pebble-products__arrow noryvelle-pebble-products__arrow--next"
                    type="button"
                    aria-label="{{ 'featured_collection.next_products' | t | escape }}"
                    data-npp-next
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </section>
            {% endfor %}
          </div>
        {% else %}
          <div class="noryvelle-pebble-products__empty">
            <p>{{ section.settings.empty_text | escape }}</p>
          </div>
        {% endif %}

      {% when 'editorial' %}
        <header class="noryvelle-pebble-products__editorial-header">
          <div class="noryvelle-pebble-products__editorial-header-copy">
            {% if section.settings.eyebrow != blank %}
              <p class="noryvelle-pebble-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {% endif %}
            {% if section.settings.heading != blank %}
              <{{ section.settings.heading_tag }} class="noryvelle-pebble-products__heading heading--{{ section.settings.heading_size }}">
                {{ section.settings.heading | escape }}
              </{{ section.settings.heading_tag }}>
            {% endif %}
            {% if section.settings.text != blank %}
              <div class="noryvelle-pebble-products__text rte">{{ section.settings.text }}</div>
            {% endif %}
          </div>
          {% if section.settings.cta_label != blank and section_cta_url != blank %}
            <div class="noryvelle-pebble-products__editorial-header-action">
              {% render 'cta',
                label: section.settings.cta_label,
                url: section_cta_url,
                style: 'tertiary'
              %}
            </div>
          {% endif %}
        </header>
        <div class="noryvelle-pebble-products__editorial">
          <div
            class="noryvelle-pebble-products__editorial-media"
            style="--npp-editorial-focal-point: {{ section.settings.editorial_focal_point }};"
          >
            {% if section.settings.editorial_image != blank %}
              {% render 'responsive-image',
                image: section.settings.editorial_image,
                max_width: 1800,
                widths: '480, 720, 960, 1200, 1440, 1800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                class: 'noryvelle-pebble-products__editorial-image',
                loading: 'lazy',
                alt: section.settings.editorial_image.alt,
                style: 'object-position: var(--npp-editorial-focal-point);'
              %}
            {% else %}
              {% render 'media-placeholder',
                class_name: 'noryvelle-pebble-products__editorial-image',
                asset_name: 'placeholder-image-default-2.svg'
              %}
            {% endif %}
          </div>

          <ul class="noryvelle-pebble-products__editorial-grid" role="list" data-npp-rail>
            {% if product_blocks.size > 0 %}
              {% for block in product_blocks limit: 4 %}
                <li class="noryvelle-pebble-products__product" {{ block.shopify_attributes }}>
                  {% render 'product-card',
                    product: block.settings.product,
                    placeholder_index: forloop.index,
                    media_ratio: 'square',
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% elsif section_collection != blank and section_collection.products_count > 0 %}
              {% for product in section_collection.products limit: 4 %}
                <li class="noryvelle-pebble-products__product">
                  {% render 'product-card',
                    product: product,
                    media_ratio: 'square',
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% else %}
              {% for placeholder_index in (1..4) %}
                <li class="noryvelle-pebble-products__product">
                  {% render 'product-card',
                    placeholder_index: placeholder_index,
                    media_ratio: 'square',
                    show_badges: true,
                    show_variant_dots: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
        {% if section.settings.cta_label != blank and section_cta_url != blank %}
          <div class="noryvelle-pebble-products__editorial-mobile-action">
            {% render 'cta',
              label: section.settings.cta_label,
              url: section_cta_url,
              style: 'tertiary'
            %}
          </div>
        {% endif %}

      {% else %}
        <div class="noryvelle-pebble-products__standard">
          <ul class="noryvelle-pebble-products__rail" role="list" data-npp-rail>
            {% if product_blocks.size > 0 %}
              {% for block in product_blocks limit: section.settings.products_to_show %}
                <li class="noryvelle-pebble-products__product" {{ block.shopify_attributes }}>
                  {% render 'product-card',
                    product: block.settings.product,
                    placeholder_index: forloop.index,
                    media_ratio: 'square',
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% elsif section_collection != blank and section_collection.products_count > 0 %}
              {% for product in section_collection.products limit: section.settings.products_to_show %}
                <li class="noryvelle-pebble-products__product">
                  {% render 'product-card',
                    product: product,
                    media_ratio: 'square',
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% else %}
              {% for placeholder_index in (1..4) %}
                <li class="noryvelle-pebble-products__product">
                  {% render 'product-card',
                    placeholder_index: placeholder_index,
                    media_ratio: 'square',
                    show_badges: true,
                    show_variant_dots: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% endif %}
          </ul>
          {% if section.settings.cta_label != blank and section_cta_url != blank %}
            <div class="noryvelle-pebble-products__cta">
              {% render 'cta',
                label: section.settings.cta_label,
                url: section_cta_url,
                style: 'tertiary'
              %}
            </div>
          {% endif %}
        </div>
    {% endcase %}
  </div>
</noryvelle-pebble-products>



{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "class": "section-noryvelle-pebble-products",
  "max_blocks": 16,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "standard",
          "label": "Standard products"
        },
        {
          "value": "tabbed",
          "label": "Tabbed collections"
        },
        {
          "value": "editorial",
          "label": "Editorial split"
        }
      ],
      "default": "standard"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for every journey"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "X-large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "View all link"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty tab text",
      "default": "Choose at least one collection."
    },
    {
      "type": "header",
      "content": "Editorial media"
    },
    {
      "type": "image_picker",
      "id": "editorial_image",
      "label": "Editorial image"
    },
    {
      "type": "select",
      "id": "editorial_focal_point",
      "label": "Editorial focal point",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Layout spacing"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card gap",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 56
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Curated product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    },
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product carousel",
      "category": "Product discovery",
      "settings": {
        "layout": "standard",
        "eyebrow": "New arrivals",
        "heading": "Designed for every journey"
      }
    },
    {
      "name": "Tabbed products",
      "category": "Product discovery",
      "settings": {
        "layout": "tabbed",
        "eyebrow": "",
        "heading": "Editor's pick"
      },
      "blocks": [
        {
          "type": "collection_tab",
          "settings": {
            "label": "New arrivals"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "label": "Best sellers"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "label": "The edit"
          }
        }
      ]
    },
    {
      "name": "Editorial products",
      "category": "Product discovery",
      "settings": {
        "layout": "editorial",
        "eyebrow": "The Noryvelle edit",
        "heading": "Timeless pieces"
      }
    }
  ]
}
{% endschema %}
