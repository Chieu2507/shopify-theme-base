{% liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign tab_blocks = section.blocks | where: 'type', 'collection_tab'
  assign section_collection = section.settings.collection
  assign section_collection_url = section_collection.url
  assign section_cta_url = section.settings.cta_link | default: section_collection_url
%}

<noryvelle-pebble-products
  class="noryvelle-pebble-products noryvelle-pebble-products--{{ section.settings.layout }} color-scheme color-{{ section.settings.color_scheme.id }} full-width"
  data-layout="{{ section.settings.layout }}"
  style="--npp-padding-top: {{ section.settings.padding_top }}px; --npp-padding-bottom: {{ section.settings.padding_bottom }}px; --npp-padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --npp-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px; --npp-gap: {{ section.settings.card_gap }}px;"
>
  <div class="noryvelle-pebble-products__inner">
    {% unless section.settings.layout == 'editorial' %}
      {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank %}
        <header class="noryvelle-pebble-products__header">
          {% if section.settings.eyebrow != blank %}
            <p class="noryvelle-pebble-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <{{ section.settings.heading_tag }} class="noryvelle-pebble-products__heading heading--{{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </{{ section.settings.heading_tag }}>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="noryvelle-pebble-products__text rte">{{ section.settings.text }}</div>
          {% endif %}
        </header>
      {% endif %}
    {% endunless %}

    {% case section.settings.layout %}
      {% when 'tabbed' %}
        {% if tab_blocks.size > 0 %}
          <div
            class="noryvelle-pebble-products__tabs"
            role="tablist"
            aria-label="{{ 'featured_collection.tabs' | t | escape }}"
          >
            {% for block in tab_blocks %}
              {% liquid
                assign tab_label = block.settings.label | default: block.settings.collection.title
                if tab_label == blank
                  assign tab_label = 'collection_list.collection' | t
                endif
              %}
              <button
                class="noryvelle-pebble-products__tab"
                id="NoryvelleProductsTab-{{ section.id }}-{{ block.id }}"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="NoryvelleProductsPanel-{{ section.id }}-{{ block.id }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-npp-tab
              >
                {{ tab_label | escape }}
              </button>
            {% endfor %}
          </div>

          <div class="noryvelle-pebble-products__panels">
            {% for block in tab_blocks %}
              {% liquid
                assign tab_collection = block.settings.collection
                assign tab_collection_url = tab_collection.url
                assign tab_cta_url = section.settings.cta_link | default: tab_collection_url
              %}
              <section
                class="noryvelle-pebble-products__panel"
                id="NoryvelleProductsPanel-{{ section.id }}-{{ block.id }}"
                role="tabpanel"
                aria-labelledby="NoryvelleProductsTab-{{ section.id }}-{{ block.id }}"
                data-npp-panel
                data-block-id="{{ block.id }}"
                {% unless forloop.first %}hidden{% endunless %}
                {{ block.shopify_attributes }}
              >
                <div class="noryvelle-pebble-products__rail-shell">
                  <ul class="noryvelle-pebble-products__rail" role="list" data-npp-rail>
                    {% if tab_collection != blank and tab_collection.products_count > 0 %}
                      {% for product in tab_collection.products limit: section.settings.products_to_show %}
                        <li class="noryvelle-pebble-products__product">
                          {% render 'product-card',
                            product: product,
                            media_ratio: 'square',
                            show_badges: true,
                            show_compare_at_price: true,
                            show_variant_dots: true,
                            show_media_actions: true,
                            enable_quick_view: true,
                            sizes: '(min-width: 990px) 25vw, 280px'
                          %}
                        </li>
                      {% endfor %}
                    {% else %}
                      {% for placeholder_index in (1..4) %}
                        <li class="noryvelle-pebble-products__product">
                          {% render 'product-card',
                            placeholder_index: placeholder_index,
                            media_ratio: 'square',
                            show_badges: true,
                            show_variant_dots: true,
                            sizes: '(min-width: 990px) 25vw, 280px'
                          %}
                        </li>
                      {% endfor %}
                    {% endif %}
                  </ul>
                </div>
                <div class="noryvelle-pebble-products__navigation">
                  <button
                    class="noryvelle-pebble-products__arrow noryvelle-pebble-products__arrow--previous"
                    type="button"
                    aria-label="{{ 'featured_collection.previous_products' | t | escape }}"
                    data-npp-previous
                    disabled
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  {% if section.settings.cta_label != blank and tab_cta_url != blank %}
                    <div class="noryvelle-pebble-products__cta">
                      {% render 'cta',
                        label: section.settings.cta_label,
                        url: tab_cta_url,
                        style: 'tertiary'
                      %}
                    </div>
                  {% endif %}
                  <button
                    class="noryvelle-pebble-products__arrow noryvelle-pebble-products__arrow--next"
                    type="button"
                    aria-label="{{ 'featured_collection.next_products' | t | escape }}"
                    data-npp-next
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </section>
            {% endfor %}
          </div>
        {% else %}
          <div class="noryvelle-pebble-products__empty">
            <p>{{ section.settings.empty_text | escape }}</p>
          </div>
        {% endif %}

      {% when 'editorial' %}
        <header class="noryvelle-pebble-products__editorial-header">
          <div class="noryvelle-pebble-products__editorial-header-copy">
            {% if section.settings.eyebrow != blank %}
              <p class="noryvelle-pebble-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {% endif %}
            {% if section.settings.heading != blank %}
              <{{ section.settings.heading_tag }} class="noryvelle-pebble-products__heading heading--{{ section.settings.heading_size }}">
                {{ section.settings.heading | escape }}
              </{{ section.settings.heading_tag }}>
            {% endif %}
            {% if section.settings.text != blank %}
              <div class="noryvelle-pebble-products__text rte">{{ section.settings.text }}</div>
            {% endif %}
          </div>
          {% if section.settings.cta_label != blank and section_cta_url != blank %}
            <div class="noryvelle-pebble-products__editorial-header-action">
              {% render 'cta',
                label: section.settings.cta_label,
                url: section_cta_url,
                style: 'tertiary'
              %}
            </div>
          {% endif %}
        </header>
        <div class="noryvelle-pebble-products__editorial">
          <div
            class="noryvelle-pebble-products__editorial-media"
            style="--npp-editorial-focal-point: {{ section.settings.editorial_focal_point }};"
          >
            {% if section.settings.editorial_image != blank %}
              {% render 'responsive-image',
                image: section.settings.editorial_image,
                max_width: 1800,
                widths: '480, 720, 960, 1200, 1440, 1800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                class: 'noryvelle-pebble-products__editorial-image',
                loading: 'lazy',
                alt: section.settings.editorial_image.alt,
                style: 'object-position: var(--npp-editorial-focal-point);'
              %}
            {% else %}
              {% render 'media-placeholder',
                class_name: 'noryvelle-pebble-products__editorial-image',
                asset_name: 'placeholder-image-default-2.svg'
              %}
            {% endif %}
          </div>

          <ul class="noryvelle-pebble-products__editorial-grid" role="list" data-npp-rail>
            {% if product_blocks.size > 0 %}
              {% for block in product_blocks limit: 4 %}
                <li class="noryvelle-pebble-products__product" {{ block.shopify_attributes }}>
                  {% render 'product-card',
                    product: block.settings.product,
                    placeholder_index: forloop.index,
                    media_ratio: 'square',
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% elsif section_collection != blank and section_collection.products_count > 0 %}
              {% for product in section_collection.products limit: 4 %}
                <li class="noryvelle-pebble-products__product">
                  {% render 'product-card',
                    product: product,
                    media_ratio: 'square',
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% else %}
              {% for placeholder_index in (1..4) %}
                <li class="noryvelle-pebble-products__product">
                  {% render 'product-card',
                    placeholder_index: placeholder_index,
                    media_ratio: 'square',
                    show_badges: true,
                    show_variant_dots: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
        {% if section.settings.cta_label != blank and section_cta_url != blank %}
          <div class="noryvelle-pebble-products__editorial-mobile-action">
            {% render 'cta',
              label: section.settings.cta_label,
              url: section_cta_url,
              style: 'tertiary'
            %}
          </div>
        {% endif %}

      {% else %}
        <div class="noryvelle-pebble-products__standard">
          <ul class="noryvelle-pebble-products__rail" role="list" data-npp-rail>
            {% if product_blocks.size > 0 %}
              {% for block in product_blocks limit: section.settings.products_to_show %}
                <li class="noryvelle-pebble-products__product" {{ block.shopify_attributes }}>
                  {% render 'product-card',
                    product: block.settings.product,
                    placeholder_index: forloop.index,
                    media_ratio: 'square',
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% elsif section_collection != blank and section_collection.products_count > 0 %}
              {% for product in section_collection.products limit: section.settings.products_to_show %}
                <li class="noryvelle-pebble-products__product">
                  {% render 'product-card',
                    product: product,
                    media_ratio: 'square',
                    show_badges: true,
                    show_compare_at_price: true,
                    show_variant_dots: true,
                    show_media_actions: true,
                    enable_quick_view: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% else %}
              {% for placeholder_index in (1..4) %}
                <li class="noryvelle-pebble-products__product">
                  {% render 'product-card',
                    placeholder_index: placeholder_index,
                    media_ratio: 'square',
                    show_badges: true,
                    show_variant_dots: true,
                    sizes: '(min-width: 990px) 25vw, 280px'
                  %}
                </li>
              {% endfor %}
            {% endif %}
          </ul>
          {% if section.settings.cta_label != blank and section_cta_url != blank %}
            <div class="noryvelle-pebble-products__cta">
              {% render 'cta',
                label: section.settings.cta_label,
                url: section_cta_url,
                style: 'tertiary'
              %}
            </div>
          {% endif %}
        </div>
    {% endcase %}
  </div>
</noryvelle-pebble-products>

{% stylesheet %}
  .noryvelle-pebble-products {
    display: block;
    overflow: hidden;
    background: var(--gradient-background, var(--color-background));
    color: var(--color-text);
  }

  .noryvelle-pebble-products__inner {
    width: calc(100% - (var(--page-margin) * 2));
    margin-inline: auto;
    padding-block: var(--npp-padding-top) var(--npp-padding-bottom);
  }

  .noryvelle-pebble-products__header {
    display: grid;
    max-width: 768px;
    justify-items: center;
    margin-inline: auto;
    gap: 8px;
    text-align: center;
  }

  .noryvelle-pebble-products__eyebrow,
  .noryvelle-pebble-products__heading,
  .noryvelle-pebble-products__text > * {
    margin: 0;
  }

  .noryvelle-pebble-products__eyebrow {
    color: var(--color-text);
    font-size: var(--font-caption);
    letter-spacing: var(--body-letter-spacing);
    line-height: 1.5;
    text-transform: uppercase;
  }

  .noryvelle-pebble-products__heading {
    color: var(--color-heading);
  }

  .noryvelle-pebble-products__text {
    color: var(--color-text);
    line-height: var(--body-line-height);
  }

  .noryvelle-pebble-products__standard,
  .noryvelle-pebble-products__panels {
    margin-top: 40px;
  }

  .noryvelle-pebble-products__rail-shell {
    position: relative;
  }

  .noryvelle-pebble-products__rail,
  .noryvelle-pebble-products__editorial-grid {
    display: flex;
    min-width: 0;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    gap: var(--npp-gap);
    list-style: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  .noryvelle-pebble-products__rail::-webkit-scrollbar,
  .noryvelle-pebble-products__editorial-grid::-webkit-scrollbar {
    display: none;
  }

  .noryvelle-pebble-products__product {
    min-width: 0;
    flex: 0 0 calc((100% - (var(--npp-gap) * 3)) / 4);
    scroll-snap-align: start;
  }

  .noryvelle-pebble-products__cta {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .noryvelle-pebble-products__tabs {
    display: flex;
    max-width: 100%;
    overflow-x: auto;
    justify-content: safe center;
    margin-top: 24px;
    scrollbar-width: none;
  }

  .noryvelle-pebble-products__tabs::-webkit-scrollbar {
    display: none;
  }

  .noryvelle-pebble-products__tab {
    position: relative;
    flex: 0 0 auto;
    padding: 8px 16px;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
    font-size: var(--font-caption);
    letter-spacing: var(--body-letter-spacing);
    line-height: 1.5;
    text-transform: uppercase;
  }

  .noryvelle-pebble-products__tab::after {
    position: absolute;
    right: 16px;
    bottom: 4px;
    left: 16px;
    height: 1px;
    background: currentcolor;
    content: '';
    transform: scaleX(0);
    transition: transform 220ms ease;
  }

  .noryvelle-pebble-products__tab[aria-selected='true'] {
    color: var(--color-heading);
  }

  .noryvelle-pebble-products__tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  .noryvelle-pebble-products__tab:focus-visible,
  .noryvelle-pebble-products__arrow:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .noryvelle-pebble-products__panel[hidden] {
    display: none;
  }

  .noryvelle-pebble-products__navigation {
    display: grid;
    align-items: center;
    margin-top: 40px;
    grid-template-columns: 48px minmax(0, 1fr) 48px;
  }

  .noryvelle-pebble-products__navigation .noryvelle-pebble-products__cta {
    grid-column: 2;
    margin-top: 0;
  }

  .noryvelle-pebble-products__arrow {
    display: grid;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-background);
    box-shadow: 0 2px 12px rgb(0 0 0 / 10%);
    color: var(--color-heading);
    cursor: pointer;
    place-items: center;
  }

  .noryvelle-pebble-products__arrow svg {
    width: 20px;
    height: 20px;
  }

  .noryvelle-pebble-products__arrow--previous {
    grid-column: 1;
  }

  .noryvelle-pebble-products__arrow--next {
    grid-column: 3;
    justify-self: end;
  }

  .noryvelle-pebble-products__arrow:disabled {
    opacity: 0.3;
  }

  .noryvelle-pebble-products__editorial-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  .noryvelle-pebble-products__editorial-header-copy {
    display: grid;
    max-width: 768px;
    gap: 8px;
  }

  .noryvelle-pebble-products__editorial {
    display: grid;
    margin-top: 40px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--npp-gap);
  }

  .noryvelle-pebble-products__editorial-media {
    position: relative;
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    background: var(--color-variant-component-background);
  }

  .noryvelle-pebble-products__editorial-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--npp-editorial-focal-point, center center);
  }

  .noryvelle-pebble-products__editorial-grid {
    display: grid;
    overflow: visible;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    scroll-snap-type: none;
  }

  .noryvelle-pebble-products__editorial-grid .noryvelle-pebble-products__product {
    width: auto;
  }

  .noryvelle-pebble-products__editorial-mobile-action {
    display: none;
  }

  .noryvelle-pebble-products__empty {
    display: grid;
    min-height: 280px;
    margin-top: 40px;
    border: 1px solid var(--color-variant-border);
    place-items: center;
    text-align: center;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .noryvelle-pebble-products__inner {
      width: calc(100% - 60px);
    }

    .noryvelle-pebble-products--standard .noryvelle-pebble-products__product {
      flex-basis: 280px;
    }

    .noryvelle-pebble-products--tabbed .noryvelle-pebble-products__product {
      flex-basis: calc((100% - (var(--npp-gap) * 2)) / 3);
    }
  }

  @media screen and (max-width: 749px) {
    .noryvelle-pebble-products__inner {
      width: calc(100% - 32px);
      padding-block: var(--npp-padding-top-mobile) var(--npp-padding-bottom-mobile);
    }

    .noryvelle-pebble-products__header {
      max-width: 448px;
    }

    .noryvelle-pebble-products__standard,
    .noryvelle-pebble-products__panels {
      margin-top: 32px;
    }

    .noryvelle-pebble-products__tabs {
      justify-content: flex-start;
      width: calc(100% + 16px);
      margin-right: -16px;
      margin-top: 20px;
    }

    .noryvelle-pebble-products__product {
      flex-basis: min(280px, 82vw);
    }

    .noryvelle-pebble-products__arrow {
      display: none;
    }

    .noryvelle-pebble-products__navigation {
      margin-top: 32px;
      grid-template-columns: minmax(0, 1fr);
    }

    .noryvelle-pebble-products__navigation .noryvelle-pebble-products__cta {
      grid-column: 1;
    }

    .noryvelle-pebble-products__cta {
      margin-top: 32px;
    }

    .noryvelle-pebble-products__editorial-header {
      display: block;
    }

    .noryvelle-pebble-products__editorial-header-action {
      display: none;
    }

    .noryvelle-pebble-products__editorial {
      margin-top: 32px;
      grid-template-columns: minmax(0, 1fr);
    }

    .noryvelle-pebble-products__editorial-media {
      min-height: 0;
      aspect-ratio: 5 / 7;
    }

    .noryvelle-pebble-products__editorial-grid {
      display: flex;
      width: calc(100% + 16px);
      margin-top: var(--npp-gap);
      margin-right: -16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .noryvelle-pebble-products__editorial-grid .noryvelle-pebble-products__product {
      flex: 0 0 min(280px, 82vw);
    }

    .noryvelle-pebble-products__editorial-mobile-action {
      display: flex;
      justify-content: center;
      margin-top: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .noryvelle-pebble-products__tab::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('noryvelle-pebble-products')) {
    class NoryvellePebbleProducts extends HTMLElement {
      connectedCallback() {
        this.controller = new AbortController();
        this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.addEventListener('click', this.handleClick.bind(this), { signal: this.controller.signal });
        this.addEventListener('keydown', this.handleKeydown.bind(this), { signal: this.controller.signal });
        document.addEventListener('shopify:block:select', this.handleBlockSelect.bind(this), {
          signal: this.controller.signal,
        });
        this.querySelectorAll('[data-npp-rail]').forEach((rail) => {
          rail.addEventListener('scroll', () => this.updateArrows(rail), {
            passive: true,
            signal: this.controller.signal,
          });
          this.updateArrows(rail);
        });
      }

      disconnectedCallback() {
        this.controller?.abort();
      }

      handleClick(event) {
        const tab = event.target.closest('[data-npp-tab]');
        if (tab && this.contains(tab)) {
          this.selectTab(tab);
          return;
        }

        const arrow = event.target.closest('[data-npp-previous], [data-npp-next]');
        if (!arrow || !this.contains(arrow)) return;
        const rail = arrow.closest('[data-npp-panel]')?.querySelector('[data-npp-rail]');
        if (!rail) return;
        const card = rail.querySelector('.noryvelle-pebble-products__product');
        const gap = Number.parseFloat(getComputedStyle(rail).columnGap) || 0;
        const distance = (card?.getBoundingClientRect().width || rail.clientWidth) + gap;
        rail.scrollBy({
          left: arrow.hasAttribute('data-npp-previous') ? -distance : distance,
          behavior: this.reduceMotion ? 'auto' : 'smooth',
        });
      }

      handleKeydown(event) {
        const tab = event.target.closest('[data-npp-tab]');
        if (!tab) return;
        const tabs = Array.from(this.querySelectorAll('[data-npp-tab]'));
        const currentIndex = tabs.indexOf(tab);
        let nextIndex = currentIndex;
        if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        if (nextIndex === currentIndex) return;
        event.preventDefault();
        this.selectTab(tabs[nextIndex], true);
      }

      handleBlockSelect(event) {
        const panel = this.querySelector(`[data-npp-panel][data-block-id="${CSS.escape(event.detail?.blockId || '')}"]`);
        if (!panel) return;
        const tab = this.querySelector(`[data-npp-tab][aria-controls="${CSS.escape(panel.id)}"]`);
        this.selectTab(tab);
      }

      selectTab(selectedTab, moveFocus = false) {
        if (!selectedTab) return;
        this.querySelectorAll('[data-npp-tab]').forEach((tab) => {
          const selected = tab === selectedTab;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        this.querySelectorAll('[data-npp-panel]').forEach((panel) => {
          panel.hidden = panel.id !== selectedTab.getAttribute('aria-controls');
        });
        const panel = this.querySelector(`#${CSS.escape(selectedTab.getAttribute('aria-controls'))}`);
        const rail = panel?.querySelector('[data-npp-rail]');
        if (rail) requestAnimationFrame(() => this.updateArrows(rail));
        if (moveFocus) selectedTab.focus();
      }

      updateArrows(rail) {
        const panel = rail.closest('[data-npp-panel]');
        const previous = panel?.querySelector('[data-npp-previous]');
        const next = panel?.querySelector('[data-npp-next]');
        if (!previous || !next) return;
        const maximum = Math.max(0, rail.scrollWidth - rail.clientWidth);
        previous.disabled = rail.scrollLeft <= 1;
        next.disabled = rail.scrollLeft >= maximum - 1;
      }
    }

    customElements.define('noryvelle-pebble-products', NoryvellePebbleProducts);
  }
{% endjavascript %}

