{% liquid
  assign desktop_image = section.settings.image | default: section.settings.mobile_image
  assign mobile_image = section.settings.mobile_image
%}

<section
  class="about-page about-page--horizontal-{{ section.settings.content_horizontal }} about-page--vertical-{{ section.settings.content_vertical }} color-scheme color-{{ section.settings.color_scheme.id }}{% if section.settings.section_width == 'full' %} full-width{% else %} about-page--contained{% endif %}"
  style="--about-page-height-desktop: {{ section.settings.height_desktop }}px; --about-page-height-mobile: {{ section.settings.height_mobile }}px; --about-page-content-width: {{ section.settings.content_width }}px; --about-page-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="about-page__media" aria-hidden="true">
    {% render 'responsive-media', image: desktop_image, mobile_image: mobile_image, max_width: 2400, mobile_max_width: 1400, widths: '640, 960, 1200, 1600, 2000, 2400', mobile_widths: '480, 640, 750, 960, 1200, 1400', sizes: '100vw', class: 'about-page__image about-page__image--desktop', loading: 'eager', fetchpriority: 'high', decorative: true, placeholder_asset: 'placeholder-image-default-2.svg', placeholder_class: 'about-page__image about-page__image--desktop' %}
    <span class="about-page__overlay"></span>
  </div>

  <div class="about-page__main">
    <div class="about-page__content{% if section.settings.content_surface %} about-page__content--surface{% endif %}">
      {% for block in section.blocks %}
        {% if block.type == 'subheading' and block.settings.text != blank %}
          <div class="about-page__subheading">
            {% render 'typography-block',
              block: block,
              content: block.settings.text,
              kind: 'text',
              default_preset: 'subheading',
              default_font: 'subheading'
            %}
          </div>
        {% endif %}
      {% endfor %}

      {% if section.settings.show_page_title and page.title != blank %}
        <h1 class="about-page__heading typo-h1">{{ page.title | escape }}</h1>
      {% endif %}

      {% if page.content != blank %}
        <div class="about-page__text rte">{{ page.content }}</div>
      {% endif %}

      {% for block in section.blocks %}
        {% if block.type == 'button' and block.settings.label != blank and block.settings.url != blank %}
          <div class="about-page__action" {{ block.shopify_attributes }}>
            <a class="button button--primary" href="{{ block.settings.url }}">{{ block.settings.label | escape }}</a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .about-page { position: relative; display: grid; min-height: var(--about-page-height-desktop); overflow: hidden; isolation: isolate; background: var(--gradient-background, var(--color-background)); }
  .about-page--contained { width: min(100%, var(--page-width)); margin-inline: auto; }
  .about-page__media, .about-page__image, .about-page__overlay { position: absolute; inset: 0; }
  .about-page__media { z-index: -2; }
  .about-page__image { width: 100%; height: 100%; object-fit: cover; }
  .about-page__overlay { z-index: 1; background: rgb(0 0 0 / var(--about-page-overlay-opacity)); }
  .about-page__main { position: relative; z-index: 2; display: flex; flex: 1; align-items: center; padding: 64px var(--page-margin); }
  .about-page--horizontal-left .about-page__main { justify-content: flex-start; }
  .about-page--horizontal-center .about-page__main { justify-content: center; }
  .about-page--horizontal-right .about-page__main { justify-content: flex-end; }
  .about-page--vertical-top .about-page__main { align-items: flex-start; }
  .about-page--vertical-center .about-page__main { align-items: center; }
  .about-page--vertical-bottom .about-page__main { align-items: flex-end; }
  .about-page__content { display: grid; width: min(100%, var(--about-page-content-width)); gap: 18px; color: var(--color-text); }
  .about-page__content--surface { padding: clamp(28px, 5vw, 56px); border: 1px solid var(--color-variant-border); background: color-mix(in srgb, var(--color-background) 94%, transparent); }
  .about-page--horizontal-center .about-page__content { text-align: center; }
  .about-page__subheading { margin: 0; color: var(--color-text); font-size: var(--font-subheading-size); letter-spacing: var(--font-subheading-letter-spacing); line-height: var(--font-subheading-line-height); text-transform: var(--font-subheading-text-case); }
  .about-page__heading { margin: 0; color: var(--color-heading); }
  .about-page__text { color: var(--color-text); line-height: var(--body-line-height); }
  .about-page__text > * { margin: 0; }
  .about-page__text > * + * { margin-top: 14px; }
  .about-page__action { margin-top: 8px; }
  @media screen and (max-width: 749px) { .about-page { min-height: var(--about-page-height-mobile); } .about-page__main { padding-top: 44px; padding-bottom: 44px; } .about-page__content--surface { padding: 28px 22px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section-page",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 280,
      "max": 880,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "select",
      "id": "content_horizontal",
      "label": "Horizontal content position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Vertical content position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "checkbox",
      "id": "show_page_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "content_surface",
      "label": "Show content surface",
      "default": false
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 75,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 360,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Subheading",
          "default": "<p>Our story</p>"
        },
        {
          "type": "header",
          "content": "t:typography_blocks.typography"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:typography_blocks.preset",
          "options": [
            {
              "value": "paragraph",
              "label": "t:typography_options.paragraph"
            },
            {
              "value": "subheading",
              "label": "t:typography_options.subheading"
            },
            {
              "value": "h1",
              "label": "t:typography_options.h1"
            },
            {
              "value": "h2",
              "label": "t:typography_options.h2"
            },
            {
              "value": "h3",
              "label": "t:typography_options.h3"
            },
            {
              "value": "h4",
              "label": "t:typography_options.h4"
            },
            {
              "value": "h5",
              "label": "t:typography_options.h5"
            },
            {
              "value": "h6",
              "label": "t:typography_options.h6"
            }
          ],
          "default": "subheading"
        },
        {
          "type": "select",
          "id": "color",
          "label": "t:typography_blocks.color",
          "options": [
            {
              "value": "text",
              "label": "t:typography_options.text"
            },
            {
              "value": "subtext",
              "label": "t:typography_options.subtext"
            }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "disable_line_break_mobile",
          "label": "t:typography_blocks.disable_line_break_mobile",
          "default": false
        },
        {
          "type": "header",
          "content": "t:typography_blocks.layout"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:typography_blocks.width",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "select",
          "id": "width_mobile",
          "label": "t:typography_blocks.width_mobile",
          "options": [
            {
              "value": "fit-content",
              "label": "t:typography_options.fit"
            },
            {
              "value": "100%",
              "label": "t:typography_options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "text_alignment",
          "id": "alignment",
          "label": "t:typography_blocks.alignment",
          "default": "left",
          "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
        },
        {
          "type": "header",
          "content": "t:typography_blocks.padding"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "t:typography_blocks.top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "t:typography_blocks.bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding_left",
          "label": "t:typography_blocks.left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding_right",
          "label": "t:typography_blocks.right",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "mobile_scale",
          "label": "t:typography_blocks.mobile_scale",
          "min": 20,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 100
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Discover the collection"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
