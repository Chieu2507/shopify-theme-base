{% liquid
  assign collection_tabs_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign collection_tabs_container_width = 'full-width'
  endif

  assign collection_tabs_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign collection_tabs_scheme = section.settings.color_scheme.id
  endif
  assign collection_tabs_scheme = collection_tabs_scheme | default: 'scheme-1' | handleize

  assign collection_tabs_padding_top = section.settings.padding_top | default: 16 | plus: 0
  assign collection_tabs_padding_bottom = section.settings.padding_bottom | default: 32 | plus: 0
  assign collection_tabs_padding_top_mobile = section.settings.padding_top_mobile | default: 8 | plus: 0
  assign collection_tabs_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 24 | plus: 0
%}

{% capture collection_tabs_style %}
  {% if collection_tabs_padding_top != 16 %}--collection-tabs-padding-top: {{ collection_tabs_padding_top }}px;{% endif %}
  {% if collection_tabs_padding_bottom != 32 %}--collection-tabs-padding-bottom: {{ collection_tabs_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if collection_tabs_padding_top_mobile != 8 %}--collection-tabs-padding-top-mobile: {{ collection_tabs_padding_top_mobile }}px;{% endif %}
    {% if collection_tabs_padding_bottom_mobile != 24 %}--collection-tabs-padding-bottom-mobile: {{ collection_tabs_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign collection_tabs_style = collection_tabs_style | strip %}

<div
  class="section-spacing collection-tabs__spacing section-color-scope {{ collection_tabs_scheme }}"
  {% if collection_tabs_style != blank %}style="{{ collection_tabs_style }}"{% endif %}
>
  <div class="container {{ collection_tabs_container_width }} collection-tabs__container">
    <div class="collection-tabs__layout" data-collection-tabs>
      {% content_for 'block', type: 'tab-layout', id: 'tab-layout' %}
      {% content_for 'block', type: 'collection-tabs-view-all', id: 'collection-tabs-view-all' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-tabs__spacing {
    width: 100%;
    min-width: 0;
    padding-top: var(--collection-tabs-padding-top, 16px);
    padding-bottom: var(--collection-tabs-padding-bottom, 32px);
    background-color: var(--background-color);
  }

  .collection-tabs__container {
    min-width: 0;
  }

  .collection-tabs__layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--layout-grid-gap, 24px);
    min-width: 0;
  }

  .collection-tabs__layout > .tab-layout {
    align-self: stretch;
  }

  @media (max-width: 767.98px) {
    .collection-tabs__spacing {
      padding-top: var(--collection-tabs-padding-top-mobile, var(--collection-tabs-padding-top, 16px));
      padding-bottom: var(--collection-tabs-padding-bottom-mobile, var(--collection-tabs-padding-bottom, 32px));
    }
  }
{% endstylesheet %}

{% schema %}
{
