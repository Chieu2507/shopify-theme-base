{% liquid
  assign section_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign section_width = 'full-width'
  endif
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign boxed_scheme = section.settings.boxed_color_scheme | default: scheme
%}
<script type="module" src="{{ 'collections-with-tabs.js' | asset_url }}"></script>
<div class="section-spacing collections-with-tabs color-scheme section-color-scope {{ scheme }}{% if section.settings.boxed_layout %} collections-with-tabs--boxed{% endif %}" style="--collections-with-tabs-gap:{{ section.settings.gap_desktop | default: 90 }}px;--collections-with-tabs-gap-mobile:{{ section.settings.gap_mobile | default: 30 }}px;--collections-with-tabs-padding-top:{{ section.settings.padding_top | default: 50 }}px;--collections-with-tabs-padding-bottom:{{ section.settings.padding_bottom | default: 50 }}px;--collections-with-tabs-boxed-y:{{ section.settings.boxed_padding_vertical | default: 70 }}px;--collections-with-tabs-boxed-x:{{ section.settings.boxed_padding_horizontal | default: 70 }}px;--collections-with-tabs-boxed-y-mobile:{{ section.settings.boxed_padding_vertical_mobile | default: 50 }}px;--collections-with-tabs-boxed-x-mobile:{{ section.settings.boxed_padding_horizontal_mobile | default: 20 }}px;--collections-with-tabs-padding-top-mobile:{{ section.settings.padding_top_mobile | default: 50 }}px;--collections-with-tabs-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile | default: 50 }}px;--collections-with-tabs-image-ratio:{{ section.settings.image_ratio | default: 'auto' }};--collections-with-tabs-products:{{ section.settings.products_to_show | default: 2 }};--collections-with-tabs-progress-duration:{{ section.settings.auto_rotate_speed | default: 6 }}s;" data-collections-with-tabs data-auto-rotate="{{ section.settings.auto_rotate }}" data-auto-rotate-speed="{{ section.settings.auto_rotate_speed | default: 6 }}">
  <div class="container {{ section_width }}">
    <div class="collections-with-tabs__box color-scheme section-color-scope {{ boxed_scheme }}">
      {% content_for 'block', type: 'header', id: 'look-header' %}
      <div class="collections-with-tabs__body collections-with-tabs__body--{{ section.settings.image_position | default: 'right' }}">
        <div class="collections-with-tabs__navigation" role="tablist" aria-label="Collections">
          {% content_for 'blocks' %}
          {% if section.settings.auto_rotate %}
            <div class="collections-with-tabs__progress" aria-hidden="true" data-collections-with-tabs-progress><span></span></div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
{% stylesheet %}
.collections-with-tabs{padding-block:var(--collections-with-tabs-padding-top) var(--collections-with-tabs-padding-bottom)}.collections-with-tabs__box{display:grid;gap:var(--collections-with-tabs-gap)}.collections-with-tabs--boxed .collections-with-tabs__box{padding:var(--collections-with-tabs-boxed-y) var(--collections-with-tabs-boxed-x)}.collections-with-tabs__body{min-width:0}.collections-with-tabs__navigation{display:grid;grid-template-columns:minmax(16rem,1fr) minmax(0,1fr);gap:var(--collections-with-tabs-gap);align-items:start}.collections-with-tabs-item{display:contents}.collections-with-tabs__body--left .collections-with-tabs__tab{grid-column:2}.collections-with-tabs__body--left .collections-with-tabs__panel{grid-column:1}.collections-with-tabs__tab{grid-column:1;display:flex;align-items:baseline;justify-content:space-between;width:100%;padding:1.25rem 0;border:0;border-bottom:1px solid var(--border-color);background:transparent;color:var(--body-color);cursor:pointer;font:inherit;font-family:var(--font-heading-family);font-size:var(--collections-with-tabs-title-size,var(--font-heading-xl));line-height:var(--font-heading-lg-line-height);text-align:left}.collections-with-tabs--title-heading_1{--collections-with-tabs-title-size:var(--font-heading-display)}.collections-with-tabs--title-heading_2{--collections-with-tabs-title-size:var(--font-heading-xl)}.collections-with-tabs--title-heading_3{--collections-with-tabs-title-size:var(--font-heading-lg)}.collections-with-tabs--title-heading_4{--collections-with-tabs-title-size:var(--font-heading-md)}.collections-with-tabs__tab[aria-selected='true']{color:var(--heading-color)}.collections-with-tabs__tab-title{margin:0;font:inherit}.collections-with-tabs__tab small{font:inherit;font-family:var(--font-body-family);font-size:var(--font-body-sm)}.collections-with-tabs__panel{grid-column:2;grid-row:1 / span 20;min-width:0}.collections-with-tabs__panel[hidden]{display:none}.collections-with-tabs__media{overflow:hidden;background:var(--background-color);aspect-ratio:var(--collections-with-tabs-image-ratio,auto)}.collections-with-tabs__media--custom{background:var(--collections-with-tabs-custom-background)}.collections-with-tabs__media :is(img,svg){display:block;width:100%;height:100%;object-fit:cover}.collections-with-tabs__products{display:grid;grid-template-columns:repeat(var(--collections-with-tabs-products,3),minmax(0,1fr));gap:1rem;margin-top:1rem}@media(max-width:767.98px){.collections-with-tabs{padding-block:var(--collections-with-tabs-padding-top-mobile,calc(var(--collections-with-tabs-padding-top)*.5)) var(--collections-with-tabs-padding-bottom-mobile,calc(var(--collections-with-tabs-padding-bottom)*.5))}.collections-with-tabs--boxed .collections-with-tabs__box{padding:var(--collections-with-tabs-boxed-y-mobile) var(--collections-with-tabs-boxed-x-mobile)}.collections-with-tabs__box{gap:var(--collections-with-tabs-gap-mobile)}.collections-with-tabs__navigation{grid-template-columns:1fr;gap:0}.collections-with-tabs__tab{font-size:var(--font-heading-md);line-height:var(--font-heading-md-line-height)}.collections-with-tabs__panel{grid-column:1;grid-row:auto;margin-top:var(--collections-with-tabs-gap-mobile)}.collections-with-tabs__products{grid-template-columns:repeat(2,minmax(0,1fr))}}
.collections-with-tabs__navigation{position:relative;display:block!important;min-height:34rem}.collections-with-tabs__navigation>*:not(.collections-with-tabs__progress){display:block!important;width:calc(50% - (var(--collections-with-tabs-gap) / 2));margin:0}.collections-with-tabs-item{display:block!important;width:100%}.collections-with-tabs__tab{grid-column:auto;font-family:var(--font-heading-family);font-size:inherit}.collections-with-tabs__tab-title{font:inherit}.collections-with-tabs__panel{position:absolute;top:0;left:calc(50% + (var(--collections-with-tabs-gap) / 2));width:calc(50% - (var(--collections-with-tabs-gap) / 2));grid-column:auto;grid-row:auto}.collections-with-tabs__media{aspect-ratio:1}.collections-with-tabs__progress{width:calc(50% - (var(--collections-with-tabs-gap) / 2));height:2px;margin-top:1.25rem;background:color-mix(in srgb,var(--body-color) 18%,transparent);overflow:hidden}.collections-with-tabs__progress span{display:block;width:100%;height:100%;background:var(--heading-color);transform:scaleX(0);transform-origin:left center}.collections-with-tabs__body--left .collections-with-tabs__navigation>*:not(.collections-with-tabs__progress),.collections-with-tabs__body--left .collections-with-tabs__progress{margin-left:calc(50% + (var(--collections-with-tabs-gap) / 2))}.collections-with-tabs__body--left .collections-with-tabs__panel{left:0}@media(min-width:768px) and (max-width:1149.98px){.collections-with-tabs{padding-block:calc(var(--collections-with-tabs-padding-top) * .75) calc(var(--collections-with-tabs-padding-bottom) * .75)}}@media(max-width:767.98px){.collections-with-tabs__navigation{display:grid!important;min-height:0}.collections-with-tabs__navigation>*:not(.collections-with-tabs__progress),.collections-with-tabs__body--left .collections-with-tabs__navigation>*:not(.collections-with-tabs__progress){width:auto;margin-left:0}.collections-with-tabs__panel,.collections-with-tabs__body--left .collections-with-tabs__panel{position:static;width:auto;margin-top:var(--collections-with-tabs-gap-mobile)}.collections-with-tabs__progress,.collections-with-tabs__body--left .collections-with-tabs__progress{width:100%;margin-left:0}}
{% endstylesheet %}
{% schema %}
