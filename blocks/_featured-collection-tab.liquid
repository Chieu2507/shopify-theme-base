{% doc %}
  Stores the source and label for one tab in the theme-block-native Featured
  collection section. The parent section renders the synchronized tab and
  product panel.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% schema %}
{
  "name": "t:featured_collection_blocks.collection_tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:featured_collection_blocks.tab_label"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:featured_collection_blocks.product_source",
      "options": [
        {
          "value": "collection",
          "label": "t:featured_collection_blocks.collection"
        },
        {
          "value": "recently_viewed",
          "label": "t:featured_collection_blocks.recently_viewed"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:featured_collection_blocks.collection"
    }
  ],
  "presets": [
    {
      "name": "t:featured_collection_blocks.collection_tab",
      "settings": {
        "label": "t:featured_collection_blocks.featured"
      }
    }
  ]
}
{% endschema %}
