{% doc %}
  Renders the grouped newsletter content for the footer.

  @example
  {% content_for 'block', type: '_footer-newsletter', id: 'newsletter' %}
{% enddoc %}

{% liquid
  assign footer_social_count = 0
  if section.settings.facebook_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
  if section.settings.instagram_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
  if section.settings.youtube_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
  if section.settings.tiktok_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
  if section.settings.x_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
  if section.settings.snapchat_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
  if section.settings.pinterest_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
  if section.settings.tumblr_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
  if section.settings.vimeo_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
  if section.settings.linkedin_url != blank
    assign footer_social_count = footer_social_count | plus: 1
  endif
%}

<section class="footer__newsletter" {{ block.shopify_attributes }}>
  <div class="footer__eyebrow footer__newsletter-eyebrow">
    {% content_for 'block', type: 'heading', id: 'newsletter_eyebrow' %}
  </div>

  <div class="footer__newsletter-heading">
    {% content_for 'block', type: 'heading', id: 'newsletter_heading' %}
  </div>

  <div class="footer__newsletter-text">
    {% content_for 'block', type: 'text', id: 'newsletter_text' %}
  </div>

  <div class="footer__newsletter-form">
    {% content_for 'block', type: 'newsletter-form', id: 'newsletter_form' %}
  </div>

  <div class="footer__newsletter-note">
    {% content_for 'block', type: 'heading', id: 'newsletter_note' %}
  </div>

  {% if footer_social_count > 0 %}
    <nav class="footer__social" aria-label="{{ 'footer.social_links' | t | escape }}">
      <ul class="footer__social-list" role="list">
        {% if section.settings.facebook_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.facebook_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.facebook' | t | escape }}">
              {% render 'social-icon', name: 'facebook' %}
            </a>
          </li>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.instagram_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.instagram' | t | escape }}">
              {% render 'social-icon', name: 'instagram' %}
            </a>
          </li>
        {% endif %}
        {% if section.settings.youtube_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.youtube_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.youtube' | t | escape }}">
              {% render 'social-icon', name: 'youtube' %}
            </a>
          </li>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.tiktok_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.tiktok' | t | escape }}">
              {% render 'social-icon', name: 'tiktok' %}
            </a>
          </li>
        {% endif %}
        {% if section.settings.x_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.x_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.x_twitter' | t | escape }}">
              {% render 'social-icon', name: 'x' %}
            </a>
          </li>
        {% endif %}
        {% if section.settings.snapchat_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.snapchat_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.snapchat' | t | escape }}">
              {% render 'social-icon', name: 'snapchat' %}
            </a>
          </li>
        {% endif %}
        {% if section.settings.pinterest_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.pinterest_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.pinterest' | t | escape }}">
              {% render 'social-icon', name: 'pinterest' %}
            </a>
          </li>
        {% endif %}
        {% if section.settings.tumblr_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.tumblr_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.tumblr' | t | escape }}">
              {% render 'social-icon', name: 'tumblr' %}
            </a>
          </li>
        {% endif %}
        {% if section.settings.vimeo_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.vimeo_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.vimeo' | t | escape }}">
              {% render 'social-icon', name: 'vimeo' %}
            </a>
          </li>
        {% endif %}
        {% if section.settings.linkedin_url != blank %}
          <li>
            <a class="footer__social-link" href="{{ section.settings.linkedin_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.linkedin' | t | escape }}">
              {% render 'social-icon', name: 'linkedin' %}
            </a>
          </li>
        {% endif %}
      </ul>
    </nav>
  {% endif %}
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": null,
  "blocks": [
    { "type": "heading" },
    { "type": "text" },
    { "type": "newsletter-form" }
  ],
  "settings": []
}
{% endschema %}
