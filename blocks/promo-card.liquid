{% doc %}
  Renders one or more optional promotional items inside a Collection Tab
  product list. The block is intentionally only allow-listed by collection-tab
  and is rendered as a grid item or carousel slide alongside Product Card items.

  @example
  {% content_for 'block', type: 'promo-card', id: 'promo-card' %}
{% enddoc %}

{% liquid
  assign promo_card_position = block.settings.card_position | default: 1 | plus: 0
  if promo_card_position < 1 or promo_card_position > 25
    assign promo_card_position = 1
  endif

  assign promo_card_alignment = block.settings.alignment | default: 'center'
  unless promo_card_alignment == 'left' or promo_card_alignment == 'center' or promo_card_alignment == 'right'
    assign promo_card_alignment = 'center'
  endunless

  assign promo_card_content_position = block.settings.position | default: 'bottom'
  unless promo_card_content_position == 'top' or promo_card_content_position == 'center' or promo_card_content_position == 'bottom'
    assign promo_card_content_position = 'bottom'
  endunless

  assign promo_card_heading_size = block.settings.heading_size | default: 'heading_3'
  unless promo_card_heading_size == 'heading_1' or promo_card_heading_size == 'heading_2' or promo_card_heading_size == 'heading_3' or promo_card_heading_size == 'heading_4'
    assign promo_card_heading_size = 'heading_3'
  endunless
  assign promo_card_heading_class = 'heading-lg'
  case promo_card_heading_size
    when 'heading_1'
      assign promo_card_heading_class = 'heading-display'
    when 'heading_2'
      assign promo_card_heading_class = 'heading-xl'
    when 'heading_4'
      assign promo_card_heading_class = 'heading-md'
  endcase

  assign promo_card_text_size = block.settings.text_size | default: 'md'
  unless promo_card_text_size == 'xs' or promo_card_text_size == 'sm' or promo_card_text_size == 'md' or promo_card_text_size == 'lg' or promo_card_text_size == 'xl' or promo_card_text_size == 'xxl'
    assign promo_card_text_size = 'md'
  endunless

  assign promo_card_media_type = block.settings.media_type | default: 'image'
  unless promo_card_media_type == 'image' or promo_card_media_type == 'video'
    assign promo_card_media_type = 'image'
  endunless

  assign promo_card_button_style = block.settings.button_style | default: 'tertiary'
  unless promo_card_button_style == 'primary' or promo_card_button_style == 'secondary' or promo_card_button_style == 'tertiary'
    assign promo_card_button_style = 'tertiary'
  endunless

  assign promo_card_button_icon = blank
  if block.settings.show_icon
    assign promo_card_button_icon = 'arrow'
  endif

  assign promo_card_content_gap = block.settings.content_gap | default: 8 | plus: 0
  if promo_card_content_gap < 0 or promo_card_content_gap > 100
    assign promo_card_content_gap = 8
  endif
  assign promo_card_button_spacing = block.settings.button_spacing | default: 16 | plus: 0
  if promo_card_button_spacing < 0 or promo_card_button_spacing > 100
    assign promo_card_button_spacing = 16
  endif

  assign promo_card_padding_vertical = block.settings.padding_vertical | default: 32 | plus: 0
  assign promo_card_padding_horizontal = block.settings.padding_horizontal | default: 28 | plus: 0
  assign promo_card_padding_vertical_mobile = block.settings.padding_vertical_mobile | default: 24 | plus: 0
  assign promo_card_padding_horizontal_mobile = block.settings.padding_horizontal_mobile | default: 20 | plus: 0

  if promo_card_padding_vertical < 0 or promo_card_padding_vertical > 100
    assign promo_card_padding_vertical = 32
  endif
  if promo_card_padding_horizontal < 0 or promo_card_padding_horizontal > 100
    assign promo_card_padding_horizontal = 28
  endif
  if promo_card_padding_vertical_mobile < 0 or promo_card_padding_vertical_mobile > 100
    assign promo_card_padding_vertical_mobile = 24
  endif
  if promo_card_padding_horizontal_mobile < 0 or promo_card_padding_horizontal_mobile > 100
    assign promo_card_padding_horizontal_mobile = 20
  endif

  assign promo_card_scheme = block.settings.color_scheme | default: 'scheme-3'
  if block.settings.color_scheme.id != blank
    assign promo_card_scheme = block.settings.color_scheme.id
  endif
  assign promo_card_scheme = promo_card_scheme | default: 'scheme-3' | handleize

  assign promo_card_link = block.settings.link
  assign promo_card_link_label = block.settings.heading | strip_html | strip | default: 'Promo card'
  assign promo_card_layout = section.settings.layout_type | default: 'carousel'
  unless promo_card_layout == 'grid' or promo_card_layout == 'carousel'
    assign promo_card_layout = 'carousel'
  endunless
%}

{% capture promo_card_style %}
  --promo-card-content-gap: {{ promo_card_content_gap }}px;
  --promo-card-button-spacing: {{ promo_card_button_spacing }}px;
  --promo-card-padding-vertical: {{ promo_card_padding_vertical }}px;
  --promo-card-padding-horizontal: {{ promo_card_padding_horizontal }}px;
  {% if block.settings.customize_mobile_padding %}
    --promo-card-padding-vertical-mobile: {{ promo_card_padding_vertical_mobile }}px;
    --promo-card-padding-horizontal-mobile: {{ promo_card_padding_horizontal_mobile }}px;
  {% endif %}
  {% if block.settings.show_overlay and block.settings.overlay_color != blank %}--promo-card-overlay-color: {{ block.settings.overlay_color | escape }};{% endif %}
{% endcapture %}
{% assign promo_card_style = promo_card_style | strip %}

<div
  class="collection-tab-promo-block promo-card-slide product-collection-grid__item{% if promo_card_layout == 'carousel' %} swiper-slide{% endif %}"
  data-collection-tab-promo-item
  {{ block.shopify_attributes }}
>
  <article
    class="product-grid__item promo-card relative promo-card--position-{{ promo_card_content_position }} promo-card--align-{{ promo_card_alignment }}{% if block.settings.show_on_top_mobile %} promo-card-top-mobile{% endif %}{% if block.settings.show_overlay %} promo-card--has-overlay{% endif %} color-scheme section-color-scope {{ promo_card_scheme }}"
    data-collection-tab-promo
    data-promo-card-position="{{ promo_card_position }}"
    data-promo-card-show-on-top-mobile="{{ block.settings.show_on_top_mobile }}"
    {% if promo_card_style != blank %}style="{{ promo_card_style }}"{% endif %}
  >
    {% render 'media-background',
      media_type: promo_card_media_type,
      image: block.settings.image,
      mobile_image: block.settings.mobile_image,
      video: block.settings.video,
      mobile_video: block.settings.mobile_video,
      alt: '',
      sizes: '(min-width: 768px) 25vw, 100vw',
      aria_hidden: true,
      class: 'promo-card__media'
    %}

    {% if block.settings.show_overlay %}
      <span class="promo-card__overlay" aria-hidden="true"></span>
    {% endif %}

    {% if promo_card_link != blank %}
      <a
        class="promo-card__link"
        href="{{ promo_card_link | escape }}"
        aria-label="{{ promo_card_link_label | escape }}"
        {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
      ></a>
    {% endif %}

    <div class="promo-card__content">
      <div class="promo-card__copy">
        {% if block.settings.subheading != blank %}
          <div class="promo-card__subheading body-text body-sm">{{ block.settings.subheading }}</div>
        {% endif %}
        {% if block.settings.heading != blank %}
          <div class="promo-card__heading heading-text {{ promo_card_heading_class }}">{{ block.settings.heading }}</div>
        {% endif %}
        {% if block.settings.text != blank %}
          <div class="promo-card__text body-text body-{{ promo_card_text_size }}">{{ block.settings.text }}</div>
        {% endif %}
      </div>

      {% if block.settings.button_label != blank %}
        <div class="promo-card__button">
          {% render 'theme-button',
            label: block.settings.button_label,
            url: promo_card_link,
            open_in_new_tab: block.settings.open_in_new_tab,
            variant: promo_card_button_style,
            icon: promo_card_button_icon,
            icon_position: 'after',
            icon_size: 'inherit',
            class: 'promo-card__button-link'
          %}
        </div>
      {% endif %}
    </div>
  </article>
</div>

{% stylesheet %}
  .promo-card {
    position: relative;
    display: flex;
    align-items: var(--promo-card-content-position, flex-end);
    justify-content: var(--promo-card-content-alignment, center);
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 20rem;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: var(--pcard-image-ratio, 1);
    background: var(--background-color);
    color: var(--body-color);
  }

  .promo-card--position-top { --promo-card-content-position: flex-start; }
  .promo-card--position-center { --promo-card-content-position: center; }
  .promo-card--position-bottom { --promo-card-content-position: flex-end; }
  .promo-card--align-left { --promo-card-content-alignment: flex-start; }
  .promo-card--align-center { --promo-card-content-alignment: center; }
  .promo-card--align-right { --promo-card-content-alignment: flex-end; }

  .promo-card__media,
  .promo-card__overlay,
  .promo-card__link {
    position: absolute;
    inset: 0;
  }

  .promo-card__media {
    z-index: 0;
  }

  .promo-card__media .background-media,
  .promo-card__media .background-media__image,
  .promo-card__media .background-media__image > picture,
  .promo-card__media .background-media__image > img,
  .promo-card__media .background-media__image .image__placeholder,
  .promo-card__media .background-media__video,
  .promo-card__media .background-media__video > video,
  .promo-card__media .background-media__placeholder {
    width: 100%;
    height: 100%;
  }

  .promo-card__overlay {
    z-index: 1;
    background: var(--promo-card-overlay-color, rgb(0 0 0 / 40%));
    pointer-events: none;
  }

  .promo-card__link {
    z-index: 2;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .promo-card__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  .promo-card__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: var(--promo-card-content-alignment, center);
    width: 100%;
    min-width: 0;
    padding: var(--promo-card-padding-vertical, 32px) var(--promo-card-padding-horizontal, 28px);
    color: var(--body-color);
    text-align: var(--promo-card-text-align, center);
    pointer-events: none;
  }

  .promo-card--align-left { --promo-card-text-align: left; }
  .promo-card--align-center { --promo-card-text-align: center; }
  .promo-card--align-right { --promo-card-text-align: right; }

  .promo-card__copy {
    display: flex;
    flex-direction: column;
    align-items: inherit;
    gap: var(--promo-card-content-gap, 8px);
    width: 100%;
    min-width: 0;
  }

  .promo-card__subheading,
  .promo-card__heading,
  .promo-card__text {
    width: 100%;
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .promo-card__subheading p,
  .promo-card__heading p,
  .promo-card__text p {
    margin: 0;
  }

  .promo-card__subheading,
  .promo-card__text {
    color: var(--body-color);
  }

  .promo-card__heading {
    color: var(--heading-color);
  }

  .promo-card__button {
    margin-top: var(--promo-card-button-spacing, 16px);
    pointer-events: auto;
  }

  .promo-card__button-link {
    max-width: 100%;
  }

  @media (max-width: 767.98px) {
    .promo-card__content {
      padding: var(--promo-card-padding-vertical-mobile, var(--promo-card-padding-vertical, 32px)) var(--promo-card-padding-horizontal-mobile, var(--promo-card-padding-horizontal, 28px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-card__link,
    .promo-card__button-link {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Promo card",
    "tag": null,
    "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "card_position",
      "label": "Card position",
      "min": 1,
      "max": 25,
      "step": 1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_on_top_mobile",
      "label": "Show promo card on top (mobile)",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "Card link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile video (optional)",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "alpha": true,
      "default": "#00000066",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "heading_1", "label": "Heading 1" },
        { "value": "heading_2", "label": "Heading 2" },
        { "value": "heading_3", "label": "Heading 3" },
        { "value": "heading_4", "label": "Heading 4" }
      ],
      "default": "heading_3"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "tertiary", "label": "Subtle" }
      ],
      "default": "tertiary"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": false
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_spacing",
      "label": "Button spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Top and bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Left and right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Custom for mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "label": "Top and bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Left and right (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Promo card",
      "category": "t:general.basic",
      "settings": {
        "card_position": 1,
        "show_on_top_mobile": false,
        "media_type": "image",
        "show_overlay": true,
        "overlay_color": "#00000066",
        "subheading": "",
        "heading": "<p>Heading</p>",
        "text": "<p>Add a short paragraph to support the heading</p>",
        "alignment": "center",
        "position": "bottom",
        "heading_size": "heading_3",
        "text_size": "md",
        "button_label": "Shop now",
        "button_style": "tertiary",
        "show_icon": false,
        "content_gap": 8,
        "button_spacing": 16,
        "color_scheme": "scheme-3",
        "padding_vertical": 32,
        "padding_horizontal": 28,
        "customize_mobile_padding": false
      }
    }
  ]
}
{% endschema %}
