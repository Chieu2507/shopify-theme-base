{% doc %}
  Renders the grouped private appointment content for the footer.

  @example
  {% content_for 'block', type: '_footer-appointment', id: 'appointment' %}
{% enddoc %}

<aside class="footer__appointment" {{ block.shopify_attributes }}>
  <span class="footer__appointment-ornament" aria-hidden="true">
    {{ 'footer-house-mark-small.svg' | inline_asset_content }}
  </span>

  <div class="footer__eyebrow footer__appointment-eyebrow">
    {% content_for 'block', type: 'heading', id: 'appointment_eyebrow' %}
  </div>

  <div class="footer__appointment-heading">
    {% content_for 'block', type: 'heading', id: 'appointment_heading' %}
  </div>

  <div class="footer__appointment-text">
    {% content_for 'block', type: 'text', id: 'appointment_text' %}
  </div>

  <div class="footer__appointment-action">
    {% content_for 'block', type: 'button', id: 'appointment_button' %}
  </div>
</aside>

{% schema %}
{
  "name": "Private appointment",
  "tag": null,
  "blocks": [
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" }
  ],
  "settings": []
}
{% endschema %}
