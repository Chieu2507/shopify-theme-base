{% doc %}
  Renders a Figma-oriented editorial slideshow slide with the same media,
  content, and nested block options as the standard slide block.

  @example
  {% content_for 'block', type: 'editorial-slide', id: 'slide' %}
{% enddoc %}

{% liquid
  assign slide_image = block.settings.image | default: block.settings.mobile_image
  assign slide_mobile_image = block.settings.mobile_image
  assign slide_image_alt = block.settings.image_alt | default: slide_image.alt
  if slide_image_alt == blank
    assign slide_image_alt = block.settings.product_title
  endif
  if slide_image_alt == blank
    assign slide_image_alt = 'accessibility.image' | t
  endif

  assign slide_collection = block.settings.collection
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  assign first_slide = section.blocks | first
  if first_slide.id == block.id
    if request.page_type != 'index' or section.index == 1
      assign image_loading = 'eager'
      assign image_priority = 'high'
    endif
  endif

  assign slide_product = block.settings.product
  assign slide_product_variant = blank
  if slide_product != blank
    assign slide_product_variant = slide_product.selected_or_first_available_variant
  endif
  assign product_title = block.settings.product_title
  assign product_url = block.settings.product_link
  assign product_price = block.settings.product_price
  if slide_product != blank
    assign product_title = slide_product.title
    assign product_url = slide_product.url
  endif
  if slide_product_variant != blank
    assign product_price = slide_product_variant.price
  endif
  assign product_meta = block.settings.product_meta
  assign product_cta_label = block.settings.product_cta_label | default: 'VIEW PRODUCT'
  assign product_price_label = block.settings.product_price_label | default: 'PRICE'
%}

<article
  class="editorial-slideshow__slide swiper-slide color-scheme color-{{ block.settings.color_scheme.id }} editorial-slideshow__slide--desktop-{{ block.settings.content_position | default: 'top-left' }} editorial-slideshow__slide--mobile-{{ block.settings.content_position_mobile | default: 'middle-left' }} editorial-slideshow__slide--align-{{ block.settings.content_alignment | default: 'left' }}"
  style="
    --editorial-slideshow-overlay-color: {{ block.settings.overlay_color | default: '#000000' }};
    --editorial-slideshow-overlay-opacity: {{ block.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};
    --editorial-slideshow-content-width: {{ block.settings.content_width | default: 520 }}px;
    --editorial-slideshow-image-position: {{ block.settings.image_position | default: 'center center' }};
  "
  data-block-id="{{ block.id }}"
  data-editorial-nav-label="{{ block.settings.nav_label | escape }}"
  data-editorial-nav-detail="{{ block.settings.nav_detail | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="editorial-slideshow__media" data-swiper-parallax-x="100%">
    {% if slide_image != blank %}
      {% render 'responsive-picture',
        image: slide_image,
        mobile_image: slide_mobile_image,
        max_width: 2400,
        mobile_max_width: 1280,
        widths: '750, 960, 1200, 1600, 1920, 2400',
        mobile_widths: '375, 550, 750, 960, 1280',
        sizes: '100vw',
        class: 'editorial-slideshow__image',
        loading: image_loading,
        fetchpriority: image_priority,
        alt: slide_image_alt
      %}
    {% else %}
      {% render 'media-placeholder',
        class_name: 'editorial-slideshow__placeholder',
        asset_name: 'placeholder-image-default-2.svg',
        loading: image_loading,
        fetchpriority: image_priority
      %}
    {% endif %}
  </div>

  <div class="editorial-slideshow__overlay" aria-hidden="true"></div>

  <div
    class="editorial-slideshow__content-positioner"
  >
    <div class="editorial-slideshow__content">
      {% if block.settings.eyebrow != blank %}
        <div class="editorial-slideshow__eyebrow">{{ block.settings.eyebrow }}</div>
      {% endif %}

      {% if block.settings.show_collection_list and slide_collection != blank %}
        <nav class="editorial-slideshow__collection-list" aria-label="{{ slide_collection.title | escape }}">
          <a class="editorial-slideshow__collection-title" href="{{ slide_collection.url }}">
            {{ slide_collection.title | escape }}
          </a>
          {% for product in slide_collection.products limit: 4 %}
            <a href="{{ product.url }}">{{ product.title | escape }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      {% content_for 'blocks' %}

      {% if block.settings.spec_line != blank %}
        <div class="editorial-slideshow__spec-line">{{ block.settings.spec_line }}</div>
      {% endif %}
    </div>
  </div>

  {% if product_title != blank or slide_product != blank %}
    <aside
      class="editorial-slideshow__product-card"
      aria-label="{{ product_title | escape }}"
    >
      <div class="editorial-slideshow__product-copy">
        {% if product_url != blank %}
          <a class="editorial-slideshow__product-title" href="{{ product_url }}">{{ product_title | escape }}</a>
        {% else %}
          <span class="editorial-slideshow__product-title">{{ product_title | escape }}</span>
        {% endif %}
        {% if product_meta != blank %}
          <span class="editorial-slideshow__product-meta">{{ product_meta | escape }}</span>
        {% endif %}
      </div>

      {% if product_price != blank %}
        <div class="editorial-slideshow__product-price">
          <span class="editorial-slideshow__product-price-label">{{ product_price_label | escape }}</span>
          <span class="editorial-slideshow__product-price-value">
            {% if slide_product_variant != blank %}
              {% render 'money', amount: product_price %}
            {% else %}
              {{ product_price | escape }}
            {% endif %}
          </span>
        </div>
      {% endif %}

      {% if product_url != blank %}
        <a class="editorial-slideshow__product-link" href="{{ product_url }}">
          <span>{{ product_cta_label | escape }}</span>
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </aside>
  {% endif %}
</article>

{% schema %}
{
  "name": "Editorial slide",
  "tag": null,
  "blocks": [
    { "type": "heading" },
    { "type": "text" },
    { "type": "button-group" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "1920 x 1080px recommended for desktop."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image (mobile)",
      "info": "1280 x 1780px recommended for mobile."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Leave blank to use the image alt text."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OBJECT 01 / THE HOUSE SIGNATURE"
    },
    {
      "type": "inline_richtext",
      "id": "spec_line",
      "label": "Specification line",
      "default": "NATURAL SPINEL · 18K YELLOW GOLD · ONE OF ONE"
    },
    {
      "type": "header",
      "content": "Content layout"
    },
    {
      "type": "checkbox",
      "id": "show_collection_list",
      "label": "Show collection list",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 280,
      "max": 720,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 520
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "top-left"
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Content position mobile",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-left"
    },
    {
      "type": "header",
      "content": "Product panel"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Navigator label",
      "default": "Nocturne"
    },
    {
      "type": "text",
      "id": "nav_detail",
      "label": "Navigator detail",
      "default": "HOUSE SIGNATURE"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product title",
      "default": "The Nocturne Collar"
    },
    {
      "type": "text",
      "id": "product_meta",
      "label": "Product meta",
      "default": "CUSHION-CUT · 22.4 CT · ONE OF ONE"
    },
    {
      "type": "text",
      "id": "product_price_label",
      "label": "Price label",
      "default": "PRICE"
    },
    {
      "type": "text",
      "id": "product_price",
      "label": "Product price",
      "default": "$8,600",
      "info": "Used as a fallback when no product is selected."
    },
    {
      "type": "url",
      "id": "product_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "product_cta_label",
      "label": "Button label",
      "default": "VIEW PRODUCT"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Editorial slide",
      "category": "Banners",
      "settings": {
        "content_width": 520,
        "content_alignment": "left",
        "content_position": "top-left",
        "content_position_mobile": "middle-left",
        "color_scheme": "scheme-3"
      },
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "<h1>The Nocturne<br>Collar.</h1>",
            "type_preset": "h1",
            "alignment": "left"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>A singular cushion-cut spinel held at the throat by sculptural gold—one unmistakable object, made to order.</p>",
            "type_preset": "paragraph",
            "color": "text",
            "alignment": "left"
          }
        },
        {
          "type": "button-group",
          "settings": {
            "layout_direction": "horizontal",
            "alignment": "left",
            "gap": 0
          },
          "blocks": [
            {
              "type": "button",
              "settings": {
                "label": "DISCOVER THE COLLAR",
                "link": "/collections/all",
                "style": "primary",
                "icon": "arrow-right"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
