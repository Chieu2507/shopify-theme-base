{% doc %}
  @param {form} form - The product form object provided by the parent product details block.
{% enddoc %}
{% assign product = closest.product | default: product %}
{% render 'buy-buttons', product: product, variant: product.selected_or_first_available_variant, block: block, form: form %}
{% schema %}
{
  "name": "Product buy buttons",
  "settings": [
    {
      "type": "select",
      "id": "button_layout",
      "label": "Button layout",
      "options": [
        {
          "value": "inline",
          "label": "Quantity and Add to cart in one row"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ],
      "default": "inline"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": true
    }
  ]
}
{% endschema %}
