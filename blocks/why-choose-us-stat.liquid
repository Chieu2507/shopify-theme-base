{% doc %}
  Renders one fixed editorial statistic for the Why choose us section.
{% enddoc %}

<div
  class="why-choose-us__stat"
  role="listitem"
  data-reveal-item
  style="--why-choose-us-stat-value-size: {{ block.settings.value_size }}px; --why-choose-us-stat-value-size-mobile: {{ block.settings.value_size_mobile }}px; --why-choose-us-stat-description-size: {{ block.settings.description_size }}px;"
  {{ block.shopify_attributes }}
>
  <p class="why-choose-us__stat-value {% if block.settings.value_font == 'body' %}body-text{% else %}heading-text{% endif %}">{{ block.settings.value | escape }}</p>
  <div class="why-choose-us__stat-description rte">{{ block.settings.description }}</div>
</div>

{% schema %}
{
  "name": "Why choose us statistic",
  "tag": null,
  "settings": [
    { "type": "text", "id": "value", "label": "Value", "default": "8 MM" },
    { "type": "header", "content": "Value typography" },
    { "type": "select", "id": "value_font", "label": "Font", "options": [{ "value": "heading", "label": "Heading" }, { "value": "body", "label": "Body" }], "default": "heading" },
    { "type": "range", "id": "value_size", "label": "Value size", "min": 24, "max": 112, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "value_size_mobile", "label": "Mobile value size", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Description" },
    { "type": "richtext", "id": "description", "label": "Text", "default": "<p>NATURAL, UNTREATED<br>MOGOK, BURMA</p>" },
    { "type": "range", "id": "description_size", "label": "Text size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 10 }
  ]
}
{% endschema %}
