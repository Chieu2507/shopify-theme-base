{% doc %}
  Renders one fixed editorial statistic for the Why choose us section.
{% enddoc %}

<div
  class="why-choose-us__stat"
  role="listitem"
  data-reveal-item
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Why choose us statistic",
  "tag": null,
  "blocks": [
    { "type": "heading" },
    { "type": "text" }
  ],
  "settings": []
}
{% endschema %}
