{% doc %}
  Renders the grouped study card used by the Image with text editorial collage.
  The static children preserve the study-card composition while this custom
  Group extends the global Group controls for layout, size, padding and
  appearance.
{% enddoc %}

{% liquid
  assign group_padding_top = block.settings.padding_top
  assign group_padding_right = block.settings.padding_right
  assign group_padding_bottom = block.settings.padding_bottom
  assign group_padding_left = block.settings.padding_left
  if group_padding_top == blank or group_padding_top == 0
    assign group_padding_top = block.settings.padding | default: 0
  endif
  if group_padding_right == blank or group_padding_right == 0
    assign group_padding_right = block.settings.padding | default: 0
  endif
  if group_padding_bottom == blank or group_padding_bottom == 0
    assign group_padding_bottom = block.settings.padding | default: 0
  endif
  if group_padding_left == blank or group_padding_left == 0
    assign group_padding_left = block.settings.padding | default: 0
  endif

  assign group_background = block.settings.background_color
  if group_background == blank and block.settings.enable_appearance
    assign group_background = block.settings.color_scheme.settings.background_gradient | default: block.settings.color_scheme.settings.background
  endif
%}

<div
  class="house-craft-study-group house-craft-study-group--layout-{{ block.settings.layout_direction | default: 'horizontal' }} house-craft-study-group--width-{{ block.settings.width | default: 'fill' }}{% if block.settings.enable_appearance %} color-scheme color-{{ block.settings.color_scheme.id }}{% endif %}"
  style="
    --house-craft-study-gap: {{ block.settings.gap | default: 16 }}px;
    --house-craft-study-alignment: {{ block.settings.alignment | default: 'flex-start' }};
    --house-craft-study-padding-top: {{ group_padding_top }}px;
    --house-craft-study-padding-right: {{ group_padding_right }}px;
    --house-craft-study-padding-bottom: {{ group_padding_bottom }}px;
    --house-craft-study-padding-left: {{ group_padding_left }}px;
    {% if block.settings.enable_appearance %}background: {{ group_background }};{% endif %}
  "
  data-reveal-item
  {{ block.shopify_attributes }}
>
  <div class="house-craft-study-group__image">
    {% content_for 'block', type: 'media', id: 'study_image' %}
  </div>
  <div class="house-craft-study-group__label">
    {% content_for 'block', type: 'label', id: 'study_label' %}
  </div>
  <div class="house-craft-study-group__heading">
    {% content_for 'block', type: 'heading', id: 'study_heading' %}
  </div>
  <div class="house-craft-study-group__text">
    {% content_for 'block', type: 'text', id: 'study_text' %}
  </div>
</div>

{% schema %}
{
  "name": "Group",
  "blocks": [
    { "type": "media" },
    { "type": "label" },
    { "type": "heading" },
    { "type": "text" }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout direction",
      "default": "horizontal",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ]
    },
    { "type": "range", "id": "gap", "label": "Gap", "default": 16, "min": 0, "max": 100, "step": 2, "unit": "px" },
    { "type": "header", "content": "Size" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "fill",
      "options": [
        { "value": "fill", "label": "Fill" },
        { "value": "fit", "label": "Fit content" }
      ]
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding", "label": "All sides", "default": 8, "min": 0, "max": 200, "step": 2, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 0, "min": 0, "max": 200, "step": 2, "unit": "px" },
    { "type": "range", "id": "padding_right", "label": "Right padding", "default": 0, "min": 0, "max": 200, "step": 2, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 0, "min": 0, "max": 200, "step": 2, "unit": "px" },
    { "type": "range", "id": "padding_left", "label": "Left padding", "default": 0, "min": 0, "max": 200, "step": 2, "unit": "px" },
    { "type": "header", "content": "Appearance" },
    { "type": "checkbox", "id": "enable_appearance", "label": "Enable appearance", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ block.settings.enable_appearance }}" },
    { "type": "color", "id": "background_color", "label": "Background color", "info": "Optional. Overrides the selected color scheme background.", "visible_if": "{{ block.settings.enable_appearance }}" }
  ]
}
{% endschema %}
