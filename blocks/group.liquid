{% doc %}
  Renders Spinel's nestable Card / Group block.

  The block can act as a transparent layout group or as a card surface. It
  accepts Spinel Heading, Subheading, Text, Button, Media and nested Card /
  Group blocks.

  @param {string} [class_name] - Optional class supplied by a static parent.

  @example
  {% content_for 'block', type: 'group', id: 'content_group' %}
{% enddoc %}

{% liquid
  assign block_style = block.settings.block_style | default: 'group'
  assign flow = block.settings.flow | default: 'vertical'
  assign phone_flow = block.settings.phone_flow | default: 'vertical'
  assign desktop_width = block.settings.desktop_width | default: 'stretch'
  assign phone_width = block.settings.phone_width | default: 'stretch'

  assign width_value = '100%'
  if desktop_width == 'natural'
    assign width_value = 'fit-content'
  elsif desktop_width == 'constrained'
    assign width_value = 'min(100%, ' | append: block.settings.max_width | append: 'px)'
  endif

  assign phone_width_value = '100%'
  if phone_width == 'natural'
    assign phone_width_value = 'fit-content'
  endif

  assign desktop_main = block.settings.stack_distribution | default: 'flex-start'
  assign desktop_cross = block.settings.stack_alignment | default: 'flex-start'
  if flow == 'horizontal'
    assign desktop_main = block.settings.row_distribution | default: 'flex-start'
    assign desktop_cross = block.settings.row_alignment | default: 'center'
  endif

  assign phone_main = block.settings.phone_distribution | default: 'flex-start'
  assign phone_cross = block.settings.phone_alignment | default: 'flex-start'

  assign corner_radius = 0
  case block.settings.corner_treatment
    when 'soft'
      assign corner_radius = 12
    when 'rounded'
      assign corner_radius = 24
  endcase

  assign link_label = block.settings.link_label
  if link_label == blank
    assign link_label = 'content_group.open' | t
  endif
%}

<div
  class="
    spinel-group
    spinel-group--{{ block_style }}
    spinel-group--flow-{{ flow }}
    spinel-group--phone-{{ phone_flow }}
    spinel-group--outline-{{ block.settings.outline | default: 'none' }}
    spinel-group--elevation-{{ block.settings.elevation | default: 'none' }}
    {% if block_style == 'card' %}color-scheme color-{{ block.settings.color_scheme.id }}{% endif %}
    {{ class_name }}
  "
  style="
    --spinel-group-width: {{ width_value }};
    --spinel-group-width-mobile: {{ phone_width_value }};
    --spinel-group-min-height: {{ block.settings.min_height | default: 0 }}px;
    --spinel-group-gap: {{ block.settings.gap | default: 16 }}px;
    --spinel-group-gap-mobile: {{ block.settings.gap_mobile | default: 12 }}px;
    --spinel-group-main: {{ desktop_main }};
    --spinel-group-cross: {{ desktop_cross }};
    --spinel-group-main-mobile: {{ phone_main }};
    --spinel-group-cross-mobile: {{ phone_cross }};
    --spinel-group-padding-block: {{ block.settings.padding_vertical | default: 0 }}px;
    --spinel-group-padding-inline: {{ block.settings.padding_horizontal | default: 0 }}px;
    --spinel-group-padding-block-mobile: {{ block.settings.padding_vertical_mobile | default: 0 }}px;
    --spinel-group-padding-inline-mobile: {{ block.settings.padding_horizontal_mobile | default: 0 }}px;
    --spinel-group-radius: {{ corner_radius }}px;
    --spinel-group-image-position: {{ block.settings.image_position | default: 'center center' }};
    --spinel-group-tint: {{ block.settings.tint_strength | default: 0 | divided_by: 100.0 }};
  "
  {{ block.shopify_attributes }}
>
  {% if block_style == 'card' and block.settings.background_image != blank %}
    <div class="spinel-group__media" aria-hidden="true">
      {% render 'responsive-image',
        image: block.settings.background_image,
        max_width: 2000,
        widths: '320, 480, 750, 960, 1200, 1600, 2000',
        sizes: '100vw',
        class: 'spinel-group__media-element',
        decorative: true
      %}
      {% if block.settings.tint_strength > 0 %}
        <span class="spinel-group__tint"></span>
      {% endif %}
    </div>
  {% endif %}

  {% if block_style == 'card' and block.settings.link != blank %}
    <a
      class="spinel-group__link"
      href="{{ block.settings.link }}"
      aria-label="{{ link_label | escape }}"
      {% if block.settings.open_in_new_tab %}
        target="_blank"
        rel="noopener"
      {% endif %}
    ></a>
  {% endif %}

  <div class="spinel-group__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .spinel-group {
    position: relative;
    display: block;
    width: var(--spinel-group-width);
    max-width: 100%;
    min-height: var(--spinel-group-min-height);
    border-radius: var(--spinel-group-radius);
    isolation: isolate;
  }

  .spinel-group--card {
    background: var(--gradient-background, var(--color-background));
    color: var(--color-text);
  }

  .spinel-group--outline-subtle {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentcolor 16%, transparent);
  }

  .spinel-group--outline-defined {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentcolor 42%, transparent);
  }

  .spinel-group--elevation-soft {
    filter: drop-shadow(0 8px 18px rgb(0 0 0 / 8%));
  }

  .spinel-group--elevation-raised {
    filter: drop-shadow(0 18px 42px rgb(0 0 0 / 14%));
  }

  .spinel-group__media,
  .spinel-group__link {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .spinel-group__media {
    z-index: -1;
    overflow: hidden;
  }

  .spinel-group__media-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--spinel-group-image-position);
  }

  .spinel-group__tint {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--spinel-group-tint));
  }

  .spinel-group__link {
    z-index: 1;
  }

  .spinel-group__content {
    position: relative;
    display: flex;
    min-height: inherit;
    align-items: var(--spinel-group-cross);
    flex-direction: column;
    gap: var(--spinel-group-gap);
    justify-content: var(--spinel-group-main);
    padding-block: var(--spinel-group-padding-block);
    padding-inline: var(--spinel-group-padding-inline);
  }

  .spinel-group--flow-horizontal .spinel-group__content {
    flex-direction: row;
  }

  .spinel-group__link ~ .spinel-group__content {
    pointer-events: none;
  }

  .spinel-group__link ~ .spinel-group__content :is(a, button, input, textarea, select, video) {
    position: relative;
    z-index: 2;
    pointer-events: auto;
  }

  @media (max-width: 749px) {
    .spinel-group {
      width: var(--spinel-group-width-mobile);
    }

    .spinel-group__content {
      align-items: var(--spinel-group-cross-mobile);
      gap: var(--spinel-group-gap-mobile);
      justify-content: var(--spinel-group-main-mobile);
      padding-block: var(--spinel-group-padding-block-mobile);
      padding-inline: var(--spinel-group-padding-inline-mobile);
    }

    .spinel-group--phone-vertical .spinel-group__content {
      flex-direction: column;
    }

    .spinel-group--phone-horizontal .spinel-group__content {
      flex-direction: row;
    }
  }
{% endstylesheet %}

{% schema %}
