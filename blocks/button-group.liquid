{% doc %}
  Renders a group of reusable button blocks for a slide.

  @example
  {% content_for 'block', type: 'button-group', id: 'button-group' %}
{% enddoc %}

{% liquid
  assign button_justify = 'flex-start'
  if block.settings.alignment == 'center'
    assign button_justify = 'center'
  elsif block.settings.alignment == 'right'
    assign button_justify = 'flex-end'
  endif
%}

<div
  class="slideshow__button-group slideshow__button-group--{{ block.settings.layout_direction | default: 'horizontal' }} block-animation"
  style="--slideshow-button-gap: {{ block.settings.gap | default: 12 }}px; --slideshow-button-justify: {{ button_justify }}; --block-animation-delay: {{ block.settings.animation_delay | default: 0 }}ms;"
  data-block-animation="{{ block.settings.animation_type | default: 'fade_up' }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Group button",
  "tag": null,
  "blocks": [
    { "type": "button" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:typography_blocks.animation"
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "t:typography_blocks.type",
      "options": [
        { "value": "none", "label": "t:typography_options.none" },
        { "value": "fade_in", "label": "t:typography_options.fade_in" },
        { "value": "fade_up", "label": "t:typography_options.fade_up" },
        { "value": "slide_in_left", "label": "t:typography_options.slide_in_left" },
        { "value": "slide_in_right", "label": "t:typography_options.slide_in_right" },
        { "value": "zoom_in", "label": "t:typography_options.zoom_in" },
        { "value": "zoom_out", "label": "t:typography_options.zoom_out" }
      ],
      "default": "fade_up"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:typography_blocks.animation_delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "Group button",
      "category": "Buttons",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Shop all",
            "link": "/collections/all",
            "style": "primary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
