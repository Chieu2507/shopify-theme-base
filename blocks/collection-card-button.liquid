{% doc %}
  Renders the collection card call-to-action using the shared Button
  Foundation. The destination is always the current collection, so this block
  intentionally exposes no editable link setting.

  @example
  {% content_for 'block', type: 'collection-card-button', id: 'button' %}
{% enddoc %}

{% liquid
  assign collection_card_button_collection = closest.collection
  assign collection_card_button_label = block.settings.button_label | default: 'Shop now'

  assign collection_card_button_style = block.settings.button_style | default: 'tertiary'
  unless collection_card_button_style == 'primary' or collection_card_button_style == 'secondary' or collection_card_button_style == 'tertiary'
    assign collection_card_button_style = 'tertiary'
  endunless

  assign collection_card_button_icon = blank
  if block.settings.show_icon
    assign collection_card_button_icon = block.settings.icon | default: 'arrow-right'
    unless collection_card_button_icon == 'arrow-right' or collection_card_button_icon == 'shopping-bag'
      assign collection_card_button_icon = 'arrow-right'
    endunless
  endif

  assign collection_card_button_icon_position = block.settings.icon_position | default: 'after'
  unless collection_card_button_icon_position == 'before' or collection_card_button_icon_position == 'after'
    assign collection_card_button_icon_position = 'after'
  endunless

  assign collection_card_button_icon_size = block.settings.icon_size | default: 'inherit'
  unless collection_card_button_icon_size == 'inherit' or collection_card_button_icon_size == 'custom'
    assign collection_card_button_icon_size = 'inherit'
  endunless

  assign collection_card_button_icon_width = block.settings.icon_width | default: 20 | plus: 0
  if collection_card_button_icon_width < 12 or collection_card_button_icon_width > 32
    assign collection_card_button_icon_width = 20
  endif

  assign collection_card_button_padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign collection_card_button_padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign collection_card_button_padding_top_mobile = block.settings.padding_top_mobile | default: collection_card_button_padding_top | plus: 0
  assign collection_card_button_padding_bottom_mobile = block.settings.padding_bottom_mobile | default: collection_card_button_padding_bottom | plus: 0

  if collection_card_button_padding_top < 0 or collection_card_button_padding_top > 100
    assign collection_card_button_padding_top = 0
  endif
  if collection_card_button_padding_bottom < 0 or collection_card_button_padding_bottom > 100
    assign collection_card_button_padding_bottom = 0
  endif
  if collection_card_button_padding_top_mobile < 0 or collection_card_button_padding_top_mobile > 100
    assign collection_card_button_padding_top_mobile = collection_card_button_padding_top
  endif
  if collection_card_button_padding_bottom_mobile < 0 or collection_card_button_padding_bottom_mobile > 100
    assign collection_card_button_padding_bottom_mobile = collection_card_button_padding_bottom
  endif
%}

{% capture collection_card_button_style_attribute %}
  {% if collection_card_button_padding_top != 0 %}--collection-card-button-padding-top: {{ collection_card_button_padding_top }}px;{% endif %}
  {% if collection_card_button_padding_bottom != 0 %}--collection-card-button-padding-bottom: {{ collection_card_button_padding_bottom }}px;{% endif %}
  {% if block.settings.customize_mobile_padding %}
    {% if collection_card_button_padding_top_mobile != collection_card_button_padding_top %}--collection-card-button-padding-top-mobile: {{ collection_card_button_padding_top_mobile }}px;{% endif %}
    {% if collection_card_button_padding_bottom_mobile != collection_card_button_padding_bottom %}--collection-card-button-padding-bottom-mobile: {{ collection_card_button_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign collection_card_button_style_attribute = collection_card_button_style_attribute | strip %}

{% if collection_card_button_label != blank or request.design_mode %}
  <div
    class="collection-card-button"
    {% if collection_card_button_style_attribute != blank %}style="{{ collection_card_button_style_attribute }}"{% endif %}
    {{ block.shopify_attributes }}
  >
    {% render 'theme-button',
      label: collection_card_button_label,
      url: collection_card_button_collection.url,
      variant: collection_card_button_style,
      icon: collection_card_button_icon,
      icon_position: collection_card_button_icon_position,
      icon_size: collection_card_button_icon_size,
      icon_width: collection_card_button_icon_width,
      class: 'collection-card-button__button'
    %}
  </div>
{% endif %}

{% stylesheet %}
  .collection-card-button {
    display: block;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    padding-top: var(--collection-card-button-padding-top, 0px);
    padding-bottom: var(--collection-card-button-padding-bottom, 0px);
  }

  .collection-card-button__button {
    max-width: 100%;
  }

  @media (max-width: 767.98px) {
    .collection-card-button {
      padding-top: var(--collection-card-button-padding-top-mobile, var(--collection-card-button-padding-top, 0px));
      padding-bottom: var(--collection-card-button-padding-bottom-mobile, var(--collection-card-button-padding-bottom, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Shop now"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "tertiary", "label": "Subtle" }
      ],
      "default": "tertiary"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "arrow-right", "label": "Arrow right" },
        { "value": "shopping-bag", "label": "Shopping bag" }
      ],
      "default": "arrow-right",
      "visible_if": "{{ block.settings.show_icon }}"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "before", "label": "Left" },
        { "value": "after", "label": "Right" }
      ],
      "default": "after",
      "visible_if": "{{ block.settings.show_icon }}"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "Icon size",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "inherit",
      "visible_if": "{{ block.settings.show_icon }}"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Custom icon size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.show_icon and block.settings.icon_size == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Custom for mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ]
}
{% endschema %}
