{% doc %}
  Stores one linked or unlinked text item for the theme-block-native Scrolling
  text section. The parent section renders both synchronized marquee groups.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% schema %}
{
  "name": "t:scrolling_text_blocks.text_item",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:scrolling_text_blocks.text",
      "default": "t:scrolling_text_blocks.sustainable_manufacturing"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:scrolling_text_blocks.link"
    }
  ],
  "presets": [
    {
      "name": "t:scrolling_text_blocks.text_item"
    }
  ]
}
{% endschema %}
