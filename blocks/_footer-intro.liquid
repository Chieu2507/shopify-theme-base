{% doc %}
  Renders the grouped newsletter and private appointment content for the footer.

  @example
  {% content_for 'block', type: '_footer-intro', id: 'intro' %}
{% enddoc %}

<div class="footer__intro" {{ block.shopify_attributes }}>
  <div class="footer__intro-content">
    {% content_for 'block', type: '_footer-newsletter', id: 'newsletter' %}
    {% content_for 'block', type: '_footer-appointment', id: 'appointment' %}
  </div>

  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Footer intro",
  "tag": null,
  "blocks": [
    { "type": "divider" }
  ]
}
{% endschema %}
