{% assign product = closest.product | default: product %}
{% render 'product-price', variant: product.selected_or_first_available_variant, block: block %}
{% schema %}
{
  "name": "Product price",
  "settings": [
    {
      "type": "header",
      "content": "Product price"
    },
    {
      "type": "select",
      "id": "price_size",
      "label": "Price size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_discount_percentage",
      "label": "Discount percentage",
      "default": false
    }
  ]
}
{% endschema %}
