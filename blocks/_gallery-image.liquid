{% doc %}
  Renders one image inside the theme-block gallery section.
{% enddoc %}

{% liquid
  assign gallery_image = block.settings.image
  assign image_alt = block.settings.image_alt | default: gallery_image.alt
%}

<div class="gallery__item" {{ block.shopify_attributes }}>
  {% if block.settings.link != blank %}
    <a class="gallery__link" href="{{ block.settings.link }}">
  {% endif %}
  <div class="gallery__media">
    {% if gallery_image != blank %}
      {% render 'responsive-image',
        image: gallery_image,
        max_width: 1200,
        widths: '240, 360, 450, 600, 750, 900, 1200',
        sizes: '(min-width: 990px) calc((100vw - 120px) / 4), (min-width: 750px) calc((100vw - 68px) / 2), calc((100vw - 40px) / 2)',
        class: 'gallery__image media-cover',
        loading: 'lazy',
        alt: image_alt
      %}
    {% else %}
      {% render 'media-placeholder', class_name: 'gallery__placeholder media-cover', asset_name: 'placeholder-image-default-1.svg' %}
    {% endif %}
    <span class="gallery__social-icon" aria-hidden="true">
      {% render 'social-icon', name: 'instagram' %}
    </span>
  </div>
  {% if block.settings.link != blank %}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Gallery image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Gallery image"
    }
  ]
}
{% endschema %}
