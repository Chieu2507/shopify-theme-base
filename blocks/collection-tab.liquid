{% doc %}
  Renders one collection tab inside a Tab Layout. The block owns the
  collection resource, tab label and product count. Layout and gap settings
  are supplied by the Collection Tabs section so every tab stays in sync.
  Product rendering is delegated to the shared product collection grid.

  @example
  {% content_for 'block', type: 'collection-tab', id: 'collection-tab' %}
{% enddoc %}

{% liquid
  assign collection_tab_collection = block.settings.collection
  assign collection_tab_label = block.settings.label | strip
  if collection_tab_label == blank and collection_tab_collection != blank
    assign collection_tab_label = collection_tab_collection.title
  endif
  if collection_tab_label == blank
    assign collection_tab_label = 'collection_tabs.default_tab' | t
  endif

  assign collection_tab_max_products = block.settings.max_products | default: 4 | plus: 0
  if collection_tab_max_products < 1 or collection_tab_max_products > 24
    assign collection_tab_max_products = 4
  endif

  assign collection_tab_id = block.id | default: 'collection-tab'
  assign collection_tab_trigger_id = 'CollectionTabTrigger-' | append: collection_tab_id
  assign collection_tab_panel_id = 'CollectionTabPanel-' | append: collection_tab_id

  assign collection_tab_has_products = false
  assign collection_tab_show_placeholders = false
  if collection_tab_collection != blank and collection_tab_collection.products != blank
    assign collection_tab_has_products = true
  elsif collection_tab_collection == blank and request.design_mode
    assign collection_tab_show_placeholders = true
  endif

  assign collection_tab_legacy_product_card_present = false
  for collection_tab_child_block in block.blocks
    if collection_tab_child_block.type == 'product-card'
      assign collection_tab_legacy_product_card_present = true
      assign collection_tab_legacy_product_card_show_ranking = collection_tab_child_block.settings.show_ranking
      assign collection_tab_legacy_product_card_color_type = collection_tab_child_block.settings.color_type
      assign collection_tab_legacy_product_card_color_scheme = collection_tab_child_block.settings.color_scheme
      assign collection_tab_legacy_product_card_editor_attributes = collection_tab_child_block.shopify_attributes
      break
    endif
  endfor
%}

<div
  class="collection-tab"
  data-collection-tab
  data-tab-id="{{ collection_tab_id | escape }}"
  {{ block.shopify_attributes }}
>
  <button
    id="{{ collection_tab_trigger_id | escape }}"
    class="tab-layout__tab collection-tab__trigger link-underline"
    type="button"
    role="tab"
    aria-selected="false"
    aria-controls="{{ collection_tab_panel_id | escape }}"
    tabindex="-1"
    data-collection-tab-trigger
    data-underline="active"
    data-tab-id="{{ collection_tab_id | escape }}"
    {% if collection_tab_collection != blank %}data-collection-url="{{ collection_tab_collection.url | escape }}"{% endif %}
  >
    {{ collection_tab_label | escape }}
  </button>

  <div
    id="{{ collection_tab_panel_id | escape }}"
    class="collection-tab__panel"
    role="tabpanel"
    aria-labelledby="{{ collection_tab_trigger_id | escape }}"
    data-collection-tab-panel
    data-tab-id="{{ collection_tab_id | escape }}"
  >
    {% content_for 'block', type: '_product-collection-grid', id: 'collection-tab-grid', collection: collection_tab_collection, max_products: collection_tab_max_products, layout_type: section.settings.layout_type, columns_desktop: section.settings.columns_desktop, columns_mobile: section.settings.columns_mobile, enable_swipe_mobile: section.settings.enable_swipe_mobile, custom_columns: section.settings.custom_columns, custom_columns_desktop: section.settings.custom_columns_desktop, custom_columns_mobile: section.settings.custom_columns_mobile, gap_horizontal: section.settings.gap_horizontal, gap_vertical: section.settings.gap_vertical, gap_horizontal_mobile: section.settings.gap_horizontal_mobile, gap_vertical_mobile: section.settings.gap_vertical_mobile, show_placeholders: collection_tab_show_placeholders, placeholder_count: 4, grid_class: 'collection-tab__products', item_class: 'collection-tab__product', items_data_attributes: 'data-collection-tab-products', product_card_override_enabled: collection_tab_legacy_product_card_present, product_card_show_ranking_override: collection_tab_legacy_product_card_show_ranking, product_card_color_type_override: collection_tab_legacy_product_card_color_type, product_card_color_scheme_override: collection_tab_legacy_product_card_color_scheme, product_card_editor_attributes_override: collection_tab_legacy_product_card_editor_attributes %}

    {% if collection_tab_collection != blank and collection_tab_has_products == false %}
      <p class="collection-tab__empty body-text body-sm">{{ 'collection_tabs.empty_collection' | t }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .collection-tab__panel {
    min-width: 0;
  }

  .collection-tab__empty {
    margin-block-start: 1rem;
    color: color-mix(in srgb, var(--body-color) 72%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_tab",
  "tag": null,
  "blocks": [
    { "type": "_product-collection-grid" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.tab_label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:labels.max_products",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_tab",
      "category": "t:general.collection",
      "settings": {
        "label": "",
        "collection": "",
        "max_products": 4
      },
      "blocks": [
        {
          "type": "_product-collection-grid",
          "id": "collection-tab-grid",
          "static": true,
          "blocks": [
            {
              "type": "product-card",
              "id": "product-card",
              "static": true,
              "settings": {
                "show_ranking": false,
                "color_type": "inherit",
                "color_scheme": "scheme-1"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
