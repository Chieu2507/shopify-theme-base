{% doc %}
  Renders a reusable section-header group. Its children are intentionally
  limited to label, heading, text and button Theme Blocks.

  @example
  {% content_for 'block', type: '_section-header', id: 'section_header' %}
{% enddoc %}

<header
  class="section-header section-header-block section-header-block--{{ block.settings.content_alignment }}{% if block.settings.show_divider %} section-header-block--with-divider{% endif %}"
  style="--section-header-content-width: {{ block.settings.content_width }}px; --section-header-padding-top: {{ block.settings.padding_top }}px; --section-header-padding-bottom: {{ block.settings.padding_bottom }}px;"
  {{ block.shopify_attributes }}
>
  <div class="section-header-block__content">
    {% content_for 'blocks' %}
  </div>
</header>

{% schema %}
{
  "name": "Section header group",
  "blocks": [
    {
      "type": "label"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 280,
      "max": 1280,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider below heading",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Section header group",
      "settings": {
        "content_alignment": "center",
        "content_width": 840,
        "show_divider": true
      },
      "blocks": [
        {
          "type": "label",
          "settings": {
            "text": "<p>Savoir-faire</p>",
            "alignment": "center"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "<h2>The house know-how</h2>",
            "type_preset": "h1",
            "alignment": "center"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>From carbon line to articulated curve.</p>",
            "alignment": "center"
          }
        }
      ]
    }
  ]
}
{% endschema %}
