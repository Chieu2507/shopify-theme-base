{% doc %}
  Renders product material and care information.
{% enddoc %}
{% if block.settings.content != blank %}
  {% render 'product-disclosure',
    details_class: 'product-material-care',
    heading_class: 'product-material-care__heading',
    heading: block.settings.heading,
    heading_tag: block.settings.html_tag,
    heading_size: block.settings.heading_size,
    content: block.settings.content,
    text_size: block.settings.text_size,
    attributes: block.shopify_attributes
  %}
{% endif %}
{% schema %}
{
  "name": "Material and care",
  "settings": [
    {
      "type": "header",
      "content": "Material and care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Material and care"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "XX-large"
        },
        {
          "value": "h2",
          "label": "X-large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-small"
        }
      ],
      "default": "h4"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "HTML Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "x-large",
          "label": "X-large"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "x-small",
          "label": "X-small"
        }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ]
}
{% endschema %}
