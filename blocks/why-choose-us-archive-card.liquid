{% doc %}
  Renders one fixed archive link card for the Why choose us section.
{% enddoc %}

<article
  class="why-choose-us__archive-card"
  role="listitem"
  data-reveal-item
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</article>

{% schema %}
{
  "name": "Why choose us archive",
  "tag": null,
  "blocks": [
    { "type": "media" },
    { "type": "label" },
    { "type": "heading" },
    { "type": "button" }
  ],
  "settings": []
}
{% endschema %}
