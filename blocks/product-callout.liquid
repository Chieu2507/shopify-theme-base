{% doc %}
  Renders Product callout content and nested product hotspots using the media
  and height settings owned by its section. Desktop content sits over the image;
  on mobile it follows the image so the copy remains readable.

  @example
  {% content_for 'block', type: 'product-callout', id: 'product-callout' %}
{% enddoc %}

{% liquid
  assign product_callout_image = section.settings.image
  assign product_callout_mobile_image = section.settings.mobile_image
  assign product_callout_base_image = product_callout_image
  if product_callout_base_image == blank
    assign product_callout_base_image = product_callout_mobile_image
    assign product_callout_mobile_image = blank
  endif

  assign product_callout_desktop_ratio = product_callout_base_image.aspect_ratio | default: 2.4
  assign product_callout_mobile_ratio = product_callout_mobile_image.aspect_ratio | default: product_callout_desktop_ratio
  if product_callout_desktop_ratio < 0.25 or product_callout_desktop_ratio > 3
    assign product_callout_desktop_ratio = 2.4
  endif
  if product_callout_mobile_ratio < 0.25 or product_callout_mobile_ratio > 3
    assign product_callout_mobile_ratio = product_callout_desktop_ratio
  endif

  assign product_callout_desktop_height = section.settings.desktop_height | default: 'adapt'
  unless product_callout_desktop_height == 'adapt' or product_callout_desktop_height == 'extra_small' or product_callout_desktop_height == 'small' or product_callout_desktop_height == 'medium' or product_callout_desktop_height == 'large' or product_callout_desktop_height == 'extra_large' or product_callout_desktop_height == 'full_screen'
    assign product_callout_desktop_height = 'adapt'
  endunless
  assign product_callout_mobile_height = section.settings.mobile_height | default: 'adapt'
  unless product_callout_mobile_height == 'adapt' or product_callout_mobile_height == 'extra_small' or product_callout_mobile_height == 'small' or product_callout_mobile_height == 'medium' or product_callout_mobile_height == 'large' or product_callout_mobile_height == 'extra_large' or product_callout_mobile_height == 'full_screen'
    assign product_callout_mobile_height = 'adapt'
  endunless

  assign product_callout_overlay = section.settings.overlay

  assign product_callout_heading_size = block.settings.heading_size | default: 'xl'
  case product_callout_heading_size
    when 'large'
      assign product_callout_heading_size = 'xl'
    when 'medium'
      assign product_callout_heading_size = 'lg'
    when 'small'
      assign product_callout_heading_size = 'md'
  endcase
  unless product_callout_heading_size == 'display' or product_callout_heading_size == 'xl' or product_callout_heading_size == 'lg' or product_callout_heading_size == 'md' or product_callout_heading_size == 'sm' or product_callout_heading_size == 'xs' or product_callout_heading_size == 'custom'
    assign product_callout_heading_size = 'xl'
  endunless

  assign product_callout_custom_heading_size = block.settings.custom_heading_size | default: 24 | plus: 0
  if product_callout_custom_heading_size < 10 or product_callout_custom_heading_size > 100
    assign product_callout_custom_heading_size = 24
  endif

  assign product_callout_heading_tag = block.settings.html_tag | default: 'h2'
  unless product_callout_heading_tag == 'div' or product_callout_heading_tag == 'h1' or product_callout_heading_tag == 'h2' or product_callout_heading_tag == 'h3' or product_callout_heading_tag == 'h4' or product_callout_heading_tag == 'h5' or product_callout_heading_tag == 'h6'
    assign product_callout_heading_tag = 'h2'
  endunless

  assign product_callout_text_size = block.settings.text_size | default: 'lg'
  unless product_callout_text_size == 'xs' or product_callout_text_size == 'sm' or product_callout_text_size == 'md' or product_callout_text_size == 'lg' or product_callout_text_size == 'xl' or product_callout_text_size == 'xxl'
    assign product_callout_text_size = 'lg'
  endunless

  assign product_callout_gap_desktop = block.settings.gap_desktop | default: 12 | plus: 0
  if product_callout_gap_desktop < 0 or product_callout_gap_desktop > 100
    assign product_callout_gap_desktop = 12
  endif
  assign product_callout_gap_mobile = block.settings.gap_mobile | default: 8 | plus: 0
  if product_callout_gap_mobile < 0 or product_callout_gap_mobile > 100
    assign product_callout_gap_mobile = 8
  endif

  assign product_callout_button_style = block.settings.button_style | default: 'secondary'
  unless product_callout_button_style == 'primary' or product_callout_button_style == 'secondary' or product_callout_button_style == 'tertiary'
    assign product_callout_button_style = 'secondary'
  endunless

  assign product_callout_text_alignment = block.settings.text_alignment | default: 'left'
  unless product_callout_text_alignment == 'left' or product_callout_text_alignment == 'center' or product_callout_text_alignment == 'right'
    assign product_callout_text_alignment = 'left'
  endunless

  assign product_callout_text_position = block.settings.text_position | default: 'bottom_left'
  unless product_callout_text_position == 'top_left' or product_callout_text_position == 'top_center' or product_callout_text_position == 'top_right' or product_callout_text_position == 'center_left' or product_callout_text_position == 'center_center' or product_callout_text_position == 'center_right' or product_callout_text_position == 'bottom_left' or product_callout_text_position == 'bottom_center' or product_callout_text_position == 'bottom_right'
    assign product_callout_text_position = 'bottom_left'
  endunless

  assign product_callout_hotspot_icon_style = block.settings.hotspot_icon_style | default: 'plus'
  unless product_callout_hotspot_icon_style == 'dot' or product_callout_hotspot_icon_style == 'plus' or product_callout_hotspot_icon_style == 'tag' or product_callout_hotspot_icon_style == 'bag'
    assign product_callout_hotspot_icon_style = 'plus'
  endunless

  assign product_callout_hotspot_behavior = block.settings.hotspot_behavior | default: 'click'
  unless product_callout_hotspot_behavior == 'click' or product_callout_hotspot_behavior == 'hover'
    assign product_callout_hotspot_behavior = 'click'
  endunless

  assign product_callout_content_scheme = block.settings.content_color_scheme | default: 'scheme-1'
  if block.settings.content_color_scheme.id != blank
    assign product_callout_content_scheme = block.settings.content_color_scheme.id
  endif
  assign product_callout_content_scheme = product_callout_content_scheme | default: 'scheme-1' | handleize

  assign product_callout_image_alt = product_callout_image.alt | default: product_callout_mobile_image.alt | default: product_callout_base_image.alt
  assign product_callout_class = 'product-callout product-callout--position-' | append: product_callout_text_position
  assign product_callout_class = product_callout_class | append: ' product-callout--align-' | append: product_callout_text_alignment
  assign product_callout_class = product_callout_class | append: ' product-callout--desktop-' | append: product_callout_desktop_height
  assign product_callout_class = product_callout_class | append: ' product-callout--mobile-' | append: product_callout_mobile_height
  assign product_callout_class = product_callout_class | append: ' product-callout--icon-' | append: product_callout_hotspot_icon_style
  assign product_callout_class = product_callout_class | append: ' color-scheme section-color-scope ' | append: product_callout_content_scheme
  assign product_callout_text_class = 'product-callout__text body-text body-' | append: product_callout_text_size | append: ' rte'
%}

{% capture product_callout_style %}
  --product-callout-ratio: {{ product_callout_desktop_ratio }};
  --product-callout-ratio-mobile: {{ product_callout_mobile_ratio }};
  {% if product_callout_overlay != blank %}--product-callout-overlay-color: {{ product_callout_overlay | escape }};{% endif %}
  --product-callout-content-gap: {{ product_callout_gap_desktop }}px;
  --product-callout-content-gap-mobile: {{ product_callout_gap_mobile }}px;
  {% if product_callout_heading_size == 'custom' %}--heading-block-custom-size: {{ product_callout_custom_heading_size }}px;{% endif %}
{% endcapture %}
{% assign product_callout_style = product_callout_style | strip %}

<article
  class="{{ product_callout_class }}"
  style="{{ product_callout_style }}"
  data-product-callout
  data-product-callout-hotspot-behavior="{{ product_callout_hotspot_behavior }}"
  {{ block.shopify_attributes }}
>
  <div class="product-callout__media">
    {% render 'media-background',
      media_type: 'image',
      image: product_callout_base_image,
      mobile_image: product_callout_mobile_image,
      alt: product_callout_image_alt,
      placeholder: 'lifestyle-1',
      sizes: '100vw'
    %}

    {% if product_callout_overlay != blank %}
      <span class="product-callout__overlay" aria-hidden="true"></span>
    {% endif %}

    <div
      class="product-callout__hotspots"
      role="group"
      aria-label="{{ 'accessibility.product_callout_hotspots' | t | escape }}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>

  <div class="product-callout__content product-callout__content--{{ product_callout_text_position }} product-callout__content--align-{{ product_callout_text_alignment }}">
    {% if block.settings.preheading != blank %}
      <p class="product-callout__preheading eyebrow-text">{{ block.settings.preheading | escape }}</p>
    {% endif %}

    {% if block.settings.heading != blank %}
      <{{ product_callout_heading_tag }} class="product-callout__heading heading-block heading-text heading-{{ product_callout_heading_size }}">{{ block.settings.heading | escape }}</{{ product_callout_heading_tag }}>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="{{ product_callout_text_class }}">{{ block.settings.text }}</div>
    {% endif %}

    {% if block.settings.button_label != blank %}
      {% render 'theme-button',
        label: block.settings.button_label,
        url: block.settings.button_link,
        open_in_new_tab: block.settings.open_in_new_tab,
        variant: product_callout_button_style,
        class: 'product-callout__button'
      %}
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .product-callout {
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    color: var(--body-color);
    isolation: isolate;
  }

  .product-callout__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--product-callout-ratio, 2.4);
    overflow: visible;
    background: var(--background-color);
  }

  .product-callout--desktop-adapt .product-callout__media { min-height: 0; }
  .product-callout--desktop-extra_small .product-callout__media { min-height: 42rem; aspect-ratio: auto; }
  .product-callout--desktop-small .product-callout__media { min-height: 56rem; aspect-ratio: auto; }
  .product-callout--desktop-medium .product-callout__media { min-height: 72rem; aspect-ratio: auto; }
  .product-callout--desktop-large .product-callout__media { min-height: 90rem; aspect-ratio: auto; }
  .product-callout--desktop-extra_large .product-callout__media { min-height: 108rem; aspect-ratio: auto; }
  .product-callout--desktop-full_screen .product-callout__media { min-height: 100svh; aspect-ratio: auto; }

  .product-callout__overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: var(--product-callout-overlay-color);
    pointer-events: none;
  }

  .product-callout__hotspots {
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
  }

  .product-callout__hotspot-wrap {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--product-callout-hotspot-y, 50%);
    inset-inline-start: var(--product-callout-hotspot-x, 50%);
    pointer-events: auto;
    transform: translate(-50%, -50%);
  }

  @media (max-width: 767.98px) {
    .product-callout__hotspot-wrap {
      inset-block-start: var(--product-callout-hotspot-y-mobile, var(--product-callout-hotspot-y, 50%));
      inset-inline-start: var(--product-callout-hotspot-x-mobile, var(--product-callout-hotspot-x, 50%));
    }
  }

  .product-callout__hotspot-wrap--active {
    z-index: 5;
  }

  .product-callout__content {
    position: absolute;
    z-index: 3;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: var(--product-callout-content-gap, 12px);
    align-items: flex-start;
    justify-content: flex-end;
    width: 100%;
    max-width: 100%;
    padding: clamp(2.4rem, 5vw, 6.4rem) clamp(1.6rem, 5vw, 6.4rem);
    color: var(--body-color);
    pointer-events: none;
  }

  .product-callout__content > * {
    pointer-events: auto;
  }

  .product-callout__content--top_left,
  .product-callout__content--top_center,
  .product-callout__content--top_right {
    justify-content: flex-start;
  }

  .product-callout__content--center_left,
  .product-callout__content--center_center,
  .product-callout__content--center_right {
    justify-content: center;
  }

  .product-callout__content--top_center,
  .product-callout__content--center_center,
  .product-callout__content--bottom_center {
    align-items: center;
  }

  .product-callout__content--top_right,
  .product-callout__content--center_right,
  .product-callout__content--bottom_right {
    align-items: flex-end;
  }

  .product-callout__content--align-left {
    text-align: left;
  }

  .product-callout__content--align-center {
    text-align: center;
  }

  .product-callout__content--align-right {
    text-align: right;
  }

  .product-callout__content :where(.product-callout__preheading, .product-callout__heading, .product-callout__text) {
    width: min(100%, 64rem);
    margin: 0;
    color: currentColor;
  }

  .product-callout__preheading {
    font-size: var(--font-body-sm);
  }

  .product-callout__content .product-callout__heading {
    width: min(100%, 64rem);
    max-width: 100%;
    padding: 0;
  }

  .product-callout__content .product-callout__heading.heading-text {
    color: var(--heading-color);
  }

  .product-callout__text {
    --body-color: currentColor;
    max-width: 48rem !important;
  }

  .product-callout__text :first-child {
    margin-top: 0;
  }

  .product-callout__text :last-child {
    margin-bottom: 0;
  }

  .product-callout__hotspot {
    position: relative;
    isolation: isolate;
    display: grid;
    width: clamp(3rem, 3.2vw, 4rem);
    height: clamp(3rem, 3.2vw, 4rem);
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--heading-color);
    cursor: pointer;
    font: inherit;
    text-decoration: none;
    pointer-events: auto;
    transform: scale(1);
    transition: transform var(--motion-duration-fast) var(--motion-ease-standard), box-shadow var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .product-callout__hotspot::before,
  .product-callout__hotspot::after {
    position: absolute;
    z-index: 0;
    inset: 10%;
    border: 1px solid currentColor;
    border-radius: 50%;
    content: '';
    opacity: 0;
    pointer-events: none;
    animation: product-callout-hotspot-ring 2.4s ease-out infinite;
  }

  .product-callout__hotspot::after {
    animation-delay: 1.2s;
  }

  .product-callout__hotspot:is(:hover, :focus-visible) {
    transform: scale(1.08);
  }

  .product-callout__hotspot:focus-visible {
    outline: 2px solid var(--heading-color);
    outline-offset: 4px;
  }

  .product-callout__hotspot[aria-disabled='true'] {
    cursor: default;
  }

  .product-callout__hotspot-icon {
    position: relative;
    z-index: 1;
    display: none;
    color: var(--heading-color);
  }

  .product-callout--icon-dot .product-callout__hotspot-icon--dot,
  .product-callout--icon-plus .product-callout__hotspot-icon--plus,
  .product-callout--icon-tag .product-callout__hotspot-icon--tag,
  .product-callout--icon-bag .product-callout__hotspot-icon--bag {
    display: grid;
    place-items: center;
  }

  .product-callout__hotspot-icon--dot {
    width: 1.25rem;
    height: 1.25rem;
    border: 0.1rem solid var(--heading-color);
    border-radius: 50%;
    background: var(--heading-color);
    box-shadow: 0 0 1.5rem rgb(0 0 0 / 28%);
  }

  .product-callout__hotspot-icon--plus,
  .product-callout__hotspot-icon--tag,
  .product-callout__hotspot-icon--bag {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--heading-color);
    color: var(--background-color);
    box-shadow: 0 0 1.5rem rgb(0 0 0 / 28%);
  }

  .product-callout__hotspot-icon--plus svg,
  .product-callout__hotspot-icon--tag svg,
  .product-callout__hotspot-icon--bag svg {
    width: 42%;
    height: 42%;
  }

  .product-callout__hotspot--placeholder .product-callout__hotspot-icon--dot,
  .product-callout__hotspot--placeholder .product-callout__hotspot-icon--plus,
  .product-callout__hotspot--placeholder .product-callout__hotspot-icon--tag,
  .product-callout__hotspot--placeholder .product-callout__hotspot-icon--bag {
    opacity: 0.88;
  }

  @keyframes product-callout-hotspot-ring {
    0% {
      opacity: 0.55;
      transform: scale(0.85);
    }

    100% {
      opacity: 0;
      transform: scale(2);
    }
  }

  .product-callout__popover {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(100% + 0.8rem);
    inset-inline-start: calc(100% + 0.8rem);
    width: min(24rem, calc(100vw - 3.2rem));
    pointer-events: auto;
  }

  .product-callout__popover--left {
    inset-inline-start: auto;
    inset-inline-end: calc(100% + 0.8rem);
  }

  .product-callout__popover--top {
    inset-block-start: auto;
    inset-block-end: calc(100% + 0.8rem);
  }

  .product-callout__popover--content {
    inset-inline-start: 50%;
    inset-inline-end: auto;
    width: min(20rem, calc(100vw - 3.2rem));
    transform: translateX(-50%);
  }

  .product-callout__popover--content::before {
    position: absolute;
    z-index: 1;
    inset-block-start: -0.65rem;
    inset-inline-start: 50%;
    width: 0;
    height: 0;
    border-inline: 0.65rem solid transparent;
    border-block-end: 0.65rem solid var(--background-color, #fff);
    content: '';
    transform: translateX(-50%);
  }

  .product-callout__popover--content.product-callout__popover--top::before {
    inset-block-start: auto;
    inset-block-end: -0.65rem;
    transform: translateX(-50%) rotate(180deg);
  }

  .product-callout__popover[hidden] {
    display: none;
  }

  .product-callout__product-card,
  .product-callout__content-card {
    width: 100%;
    padding: 0.8rem;
    border: 1px solid rgb(0 0 0 / 10%);
    border-radius: var(--radius-square, 0);
    background: var(--background-color, #fff);
    color: var(--body-color, #1d2835);
    box-shadow: 0 0.8rem 2.4rem rgb(0 0 0 / 18%);
  }

  .product-callout__product-card {
    display: flex;
    gap: 1rem;
  }

  .product-callout__content-card {
    --text-align-default: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.2rem;
    text-align: center;
  }

  .product-callout__content-card-heading {
    width: 100%;
    margin: 0;
  }

  .product-callout__content-card-text {
    width: 100%;
  }

  .product-callout__content-card-text :first-child {
    margin-top: 0;
  }

  .product-callout__content-card-text :last-child {
    margin-bottom: 0;
  }

  .product-callout__content-card-placeholder {
    font-size: var(--font-body-sm);
    opacity: 0.7;
  }

  .product-callout__product-card-media {
    flex: 0 0 5.6rem;
    width: 5.6rem;
    height: 5.6rem;
    overflow: hidden;
    background: var(--background-color, #f3f3f3);
  }

  .product-callout__product-card-media img,
  .product-callout__product-card-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-callout__product-card-placeholder {
    color: var(--border-color, #cfcfcf);
  }

  .product-callout__product-card-details {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .product-callout__product-card-category,
  .product-callout__product-card-action {
    font-size: var(--font-body-xs);
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .product-callout__product-card-category {
    color: var(--secondary-color, var(--body-color));
    opacity: 0.7;
  }

  .product-callout__product-card-title,
  .product-callout__product-card-price {
    display: block;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-callout__product-card-title {
    margin-top: 0.25rem;
    font-size: var(--font-body-sm);
  }

  .product-callout__product-card-price {
    margin-top: 0.1rem;
    font-size: var(--font-body-xs);
  }

  .product-callout__product-card-action {
    margin-top: 0.45rem;
    color: currentColor;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .product-callout__product-card-action:hover,
  .product-callout__product-card-action:focus-visible {
    opacity: 0.65;
  }

  .product-callout__product-card-action--disabled {
    cursor: default;
    opacity: 0.55;
    text-decoration: none;
  }

  @media (max-width: 767.98px) {
    .product-callout--mobile-adapt .product-callout__media { min-height: 0; aspect-ratio: var(--product-callout-ratio-mobile, var(--product-callout-ratio, 2.4)); }
    .product-callout--mobile-extra_small .product-callout__media { min-height: 40rem; aspect-ratio: auto; }
    .product-callout--mobile-small .product-callout__media { min-height: 48rem; aspect-ratio: auto; }
    .product-callout--mobile-medium .product-callout__media { min-height: 62rem; aspect-ratio: auto; }
    .product-callout--mobile-large .product-callout__media { min-height: 76rem; aspect-ratio: auto; }
    .product-callout--mobile-extra_large .product-callout__media { min-height: 90rem; aspect-ratio: auto; }
    .product-callout--mobile-full_screen .product-callout__media { min-height: 100svh; aspect-ratio: auto; }

    .product-callout__overlay {
      display: none;
    }

    .product-callout__content {
      position: relative;
      inset: auto;
      display: flex;
      flex-direction: column;
      gap: var(--product-callout-content-gap-mobile, var(--product-callout-content-gap, 8px));
      padding: 2.4rem var(--page-margin-mobile) 2.8rem;
      background: var(--background-color);
      color: var(--body-color);
      pointer-events: auto;
    }

    .product-callout__content--align-center {
      align-items: center;
      text-align: center;
    }

    .product-callout__content--align-right {
      align-items: flex-end;
      text-align: right;
    }

    .product-callout__content--align-left {
      align-items: flex-start;
    }

    .product-callout__popover,
    .product-callout__popover--left,
    .product-callout__popover--top {
      inset-block-start: calc(100% + 0.8rem);
      inset-block-end: auto;
      inset-inline-start: 50%;
      inset-inline-end: auto;
      transform: translateX(-50%);
      width: min(26rem, calc(100vw - (2 * var(--page-margin-mobile, 1.6rem))));
    }

    .product-callout__popover--content {
      width: min(20rem, calc(100vw - (2 * var(--page-margin-mobile, 1.6rem))));
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .product-callout__hotspot,
    .product-callout__button {
      transition: none;
    }

    .product-callout__hotspot::before,
    .product-callout__hotspot::after {
      animation: none;
      opacity: 0.24;
      transform: scale(1.6);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const instances = new WeakMap();

    const closeActive = (state, restoreFocus = false) => {
      const active = state.active;
      if (!active) return;

      active.popover.hidden = true;
      active.wrapper.classList.remove('product-callout__hotspot-wrap--active');
      active.trigger.setAttribute('aria-expanded', 'false');
      state.active = null;

      if (restoreFocus) active.trigger.focus({ preventScroll: true });
    };

    const openPopover = (state, trigger) => {
      const wrapper = trigger.closest('[data-product-callout-hotspot-wrap]');
      const popover = wrapper?.querySelector('[data-product-callout-popover]');
      if (!wrapper || !popover) return;

      const isActive = state.active?.trigger === trigger;
      if (isActive) {
        if (state.toggleOnClick) closeActive(state);
        return;
      }

      closeActive(state);

      popover.hidden = false;
      wrapper.classList.add('product-callout__hotspot-wrap--active');
      trigger.setAttribute('aria-expanded', 'true');
      state.active = { trigger, wrapper, popover };
    };

    const initialize = (callout) => {
      if (!callout || instances.has(callout)) return;

      const controller = new AbortController();
      const state = {
        callout,
        controller,
        active: null,
        hotspotBehavior: callout.dataset.productCalloutHotspotBehavior === 'hover' ? 'hover' : 'click',
        toggleOnClick: true,
      };
      instances.set(callout, state);

      const openForHover = (event) => {
        if (state.hotspotBehavior !== 'hover' || event.pointerType === 'touch') return;
        const trigger = event.currentTarget.querySelector('[data-product-callout-hotspot]');
        if (!trigger) return;

        state.toggleOnClick = false;
        openPopover(state, trigger);
        state.toggleOnClick = true;
      };

      const closeForHover = (event) => {
        if (state.hotspotBehavior !== 'hover') return;
        const nextTarget = event.relatedTarget;
        if (nextTarget instanceof Node && callout.contains(nextTarget)) return;
        closeActive(state);
      };

      const openForFocus = (event) => {
        if (state.hotspotBehavior !== 'hover' || event.target !== event.currentTarget.querySelector('[data-product-callout-hotspot]')) return;

        state.toggleOnClick = false;
        openPopover(state, event.target);
        state.toggleOnClick = true;
      };

      const closeForFocus = (event) => {
        if (state.hotspotBehavior !== 'hover') return;
        const nextTarget = event.relatedTarget;
        if (nextTarget instanceof Node && event.currentTarget.contains(nextTarget)) return;
        if (state.active?.wrapper === event.currentTarget) closeActive(state);
      };

      callout.querySelectorAll('[data-product-callout-hotspot-wrap]').forEach((wrapper) => {
        wrapper.addEventListener('pointerenter', openForHover, { signal: controller.signal });
        wrapper.addEventListener('focusin', openForFocus, { signal: controller.signal });
        wrapper.addEventListener('focusout', closeForFocus, { signal: controller.signal });
      });

      callout.addEventListener('pointerleave', closeForHover, { signal: controller.signal });

      callout.addEventListener(
        'click',
        (event) => {
          const trigger = event.target.closest?.('[data-product-callout-hotspot]');
          if (!trigger || !callout.contains(trigger)) {
            if (state.hotspotBehavior === 'hover') closeActive(state);
            return;
          }
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          event.preventDefault();
          state.toggleOnClick = true;
          openPopover(state, trigger);
        },
        { signal: controller.signal },
      );

      document.addEventListener(
        'click',
        (event) => {
          if (state.active && !callout.contains(event.target)) closeActive(state);
        },
        { signal: controller.signal },
      );

      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape' || !state.active) return;
          event.preventDefault();
          closeActive(state, true);
        },
        { signal: controller.signal },
      );
    };

    const destroy = (callout) => {
      const state = instances.get(callout);
      if (!state) return;
      closeActive(state);
      state.controller.abort();
      instances.delete(callout);
    };

    const initializeRoot = (root = document) => {
      if (root.matches?.('[data-product-callout]')) initialize(root);
      root.querySelectorAll?.('[data-product-callout]').forEach(initialize);
    };

    const destroyRoot = (root) => {
      if (root.matches?.('[data-product-callout]')) destroy(root);
      root.querySelectorAll?.('[data-product-callout]').forEach(destroy);
    };

    document.addEventListener('shopify:section:load', (event) => initializeRoot(event.target));
    document.addEventListener('shopify:section:unload', (event) => destroyRoot(event.target));

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeRoot(), { once: true });
    } else {
      initializeRoot();
    }
  })();
{% endjavascript %}

