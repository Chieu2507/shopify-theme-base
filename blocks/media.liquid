{% doc %}
  Renders a reusable image theme block.

  @example
  {% content_for 'block', type: 'media', id: 'media' %}
{% enddoc %}

<div
  class="content-media content-media--{{ block.settings.ratio }}"
  style="--content-media-position: {{ block.settings.focal_point }}"
  {{ block.shopify_attributes }}
  {% render 'reveal-attributes', settings: block.settings %}
>
  {% render 'responsive-media',
    image: block.settings.image,
    max_width: 2000,
    widths: '320, 480, 750, 960, 1200, 1600, 2000',
    sizes: '(min-width: 1600px) 1600px, 100vw',
    class: 'content-media__image',
    alt: block.settings.alt,
    placeholder_asset: 'placeholder-image-default-1.svg',
    placeholder_class: 'content-media__placeholder'
  %}
</div>

{% schema %}
{
  "name": "Media",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Focal point",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "reveal_type",
      "label": "Type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade up" },
        { "value": "fade-down", "label": "Fade down" },
        { "value": "fade-left", "label": "Fade left" },
        { "value": "fade-right", "label": "Fade right" },
        { "value": "zoom", "label": "Zoom" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "reveal_duration",
      "label": "Duration",
      "min": 300,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 650,
      "visible_if": "{{ block.settings.reveal_type != 'none' }}"
    },
    {
      "type": "range",
      "id": "reveal_delay",
      "label": "Delay",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.reveal_type != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "Media"
    }
  ]
}
{% endschema %}
