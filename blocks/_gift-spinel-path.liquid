{% doc %}
  Renders one private Gift Spinel result path as an inert template. The
  section's JavaScript clones the matching template when a recipient is
  selected.

  @example
  {% content_for 'block', type: '_gift-spinel-path', id: 'gift_path' %}
{% enddoc %}

{% liquid
  assign path_primary_link = block.settings.primary_link
  if path_primary_link == blank and block.settings.result_collection != blank
    assign path_primary_link = block.settings.result_collection.url
  endif

  assign path_heading = block.settings.heading
  assign path_copy = block.settings.copy
  assign path_products = block.settings.result_products
  if path_products == blank and block.settings.result_collection != blank
    assign path_products = block.settings.result_collection.products
  endif
%}

<template
  data-gift-spinel-path
  data-block-id="{{ block.id }}"
  data-recipient="{{ block.settings.recipient }}"
>
  <div class="gift-spinel__result-content" {{ block.shopify_attributes }}>
    {% if block.settings.featured_badge != blank %}
      <p class="gift-spinel__result-kicker">{{ block.settings.featured_badge | escape }}</p>
    {% else %}
      <p class="gift-spinel__result-kicker">{{ 'gift_spinel.curated_edit' | t }}</p>
    {% endif %}

    <h3
      class="gift-spinel__result-heading"
      data-gift-spinel-result-heading
      tabindex="-1"
    >
      {{ path_heading | escape }}
    </h3>

    {% if path_copy != blank %}
      <div class="gift-spinel__result-copy rte" data-gift-spinel-result-copy>
        {{ path_copy }}
      </div>
    {% endif %}

    <div class="gift-spinel__result-tools">
      <div class="gift-spinel__chips" data-gift-spinel-chips></div>
      <button class="gift-spinel__change" type="button" data-gift-spinel-change>
        {{ 'gift_spinel.change_recipient' | t }}
      </button>
    </div>

    <div class="gift-spinel__actions">
      {% render 'cta',
        label: block.settings.primary_label,
        url: path_primary_link,
        style: 'primary'
      %}
      {% if block.settings.show_personalization and block.settings.personalization_link != blank %}
        {% render 'cta',
          label: block.settings.personalization_label,
          url: block.settings.personalization_link,
          style: 'tertiary'
        %}
      {% endif %}
    </div>

    {% if path_products != blank %}
      <ul class="gift-spinel__products" role="list">
        {% for product in path_products limit: section.settings.products_to_show %}
          <li class="gift-spinel__product">
            {% render 'product-card',
              product: product,
              show_media_actions: true,
              enable_quick_view: true
            %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <ul
        class="gift-spinel__products"
        role="list"
        aria-label="{{ 'gift_spinel.curated_edit' | t | escape }}"
      >
        {% for placeholder_number in (1..section.settings.products_to_show) %}
          <li class="gift-spinel__product">
            {% render 'product-card', placeholder_index: placeholder_number %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</template>

{% schema %}
{
  "name": "Gift path",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Gift path"
    },
    {
      "type": "paragraph",
      "content": "Create one focused edit for each recipient option."
    },
    {
      "type": "header",
      "content": "Recipient"
    },
    {
      "type": "text",
      "id": "path_label",
      "label": "Internal path label",
      "default": "Recipient gift edit",
      "info": "Use a clear name such as Mother gift edit."
    },
    {
      "type": "select",
      "id": "recipient",
      "label": "Recipient",
      "options": [
        {
          "value": "partner",
          "label": "Partner"
        },
        {
          "value": "mother",
          "label": "Mother"
        },
        {
          "value": "friend",
          "label": "Friend"
        },
        {
          "value": "myself",
          "label": "Myself"
        }
      ],
      "default": "partner"
    },
    {
      "type": "header",
      "content": "Products and destination"
    },
    {
      "type": "collection",
      "id": "result_collection",
      "label": "Result collection",
      "info": "Supplies product cards and the primary link when no product list or link is selected."
    },
    {
      "type": "product_list",
      "id": "result_products",
      "label": "Result products",
      "limit": 6,
      "info": "Takes priority over the result collection."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary CTA label",
      "default": "Explore this gift edit"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary CTA link",
      "info": "Uses the result collection when empty."
    },
    {
      "type": "header",
      "content": "Result copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A thoughtful edit, chosen with care.",
      "info": "Supports {recipient}."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Chosen for its quiet symbolism and made to become part of their everyday ritual.</p>",
      "info": "Supports {recipient}."
    },
    {
      "type": "text",
      "id": "featured_badge",
      "label": "Featured badge",
      "default": "Your curated gift edit"
    },
    {
      "type": "header",
      "content": "Personalization CTA"
    },
    {
      "type": "checkbox",
      "id": "show_personalization",
      "label": "Show personalization CTA",
      "default": false
    },
    {
      "type": "text",
      "id": "personalization_label",
      "label": "Personalization CTA label",
      "default": "Make it personal"
    },
    {
      "type": "url",
      "id": "personalization_link",
      "label": "Personalization CTA link"
    }
  ],
  "presets": [
    {
      "name": "Gift path"
    }
  ]
}
{% endschema %}
