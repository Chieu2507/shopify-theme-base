{% doc %}
  A merchant-configurable visual slide for the Slideshow section. It owns the
  slide media and local content placement; nested Theme Blocks supply content.
{% enddoc %}

{% liquid
  assign slide_layout = block.settings.layout | default: 'classic'
  assign slide_media_type = block.settings.media_type | default: 'image'
  assign slide_scheme = block.settings.color_scheme | default: 'scheme-1'
  if block.settings.color_scheme.id != blank
    assign slide_scheme = block.settings.color_scheme.id
  endif
  assign slide_scheme = slide_scheme | handleize
%}

{% capture slide_style %}
  {% if block.settings.overlay_color != blank %}--slideshow-slide-overlay: {{ block.settings.overlay_color }};{% endif %}
  {% if block.settings.desktop_gap != 12 %}--slideshow-slide-gap: {{ block.settings.desktop_gap }}px;{% endif %}
  {% if block.settings.mobile_gap != 12 %}--slideshow-slide-gap-mobile: {{ block.settings.mobile_gap }}px;{% endif %}
{% endcapture %}

<div
  class="swiper-slide slideshow-slide slideshow-slide--{{ slide_layout }} slideshow-slide--desktop-{{ block.settings.desktop_position }} slideshow-slide--mobile-{{ block.settings.mobile_position }} color-scheme section-color-scope {{ slide_scheme }}"
  data-slideshow-slide
  {% if slide_style != blank %}style="{{ slide_style | strip }}"{% endif %}
  {{ block.shopify_attributes }}
>
  <div class="slideshow-slide__media{% if block.settings.image == blank and block.settings.video == blank %} placeholder-image{% endif %}" aria-hidden="true">
    {% if slide_media_type == 'video' and block.settings.video != blank %}
      {{ block.settings.video | video_tag: image_size: '2400x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'slideshow-slide__video' }}
    {% elsif block.settings.image != blank %}
      <picture>
        {% if block.settings.mobile_image != blank %}<source media="(max-width: 767.98px)" srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}">{% endif %}
        {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow-slide__placeholder' }}
    {% endif %}
    {% if block.settings.show_overlay %}<span class="slideshow-slide__overlay"></span>{% endif %}
  </div>

  {% if block.settings.link != blank %}<a class="slideshow-slide__link" href="{{ block.settings.link }}"{% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ block.settings.link_label | default: 'Slide link' | escape }}"></a>{% endif %}

  <div class="slideshow-slide__content"><div class="slideshow-slide__content-inner align-content">{% content_for 'blocks' %}</div></div>
</div>

{% stylesheet %}
  .slideshow-slide { display: grid; min-height: inherit; isolation: isolate; overflow: hidden; }
  .slideshow-slide__media, .slideshow-slide__content { grid-area: 1 / 1; }
  .slideshow-slide__media { position: relative; z-index: 0; min-height: inherit; }
  .slideshow-slide__media picture, .slideshow-slide__media img, .slideshow-slide__video, .slideshow-slide__placeholder { display: block; width: 100%; height: 100%; min-height: inherit; object-fit: cover; }
  .slideshow-slide__overlay { position: absolute; inset: 0; background: var(--slideshow-slide-overlay, #00000033); }
  .slideshow-slide__link { position: absolute; inset: 0; z-index: 1; }
  .slideshow-slide__content { position: relative; z-index: 2; display: flex; min-height: inherit; padding: 6.4rem calc(var(--page-margin-desktop) + 6.4rem); pointer-events: none; }
  .slideshow-slide__content-inner { gap: var(--slideshow-slide-gap, 1.2rem); width: min(100%, 64rem); color: var(--body-color); pointer-events: auto; }
  .slideshow-slide--desktop-top_left .slideshow-slide__content { align-items: flex-start; justify-content: flex-start; }
  .slideshow-slide--desktop-top_center .slideshow-slide__content { align-items: flex-start; justify-content: center; }
  .slideshow-slide--desktop-top_right .slideshow-slide__content { align-items: flex-start; justify-content: flex-end; }
  .slideshow-slide--desktop-center_left .slideshow-slide__content { align-items: center; justify-content: flex-start; }
  .slideshow-slide--desktop-center_center .slideshow-slide__content { align-items: center; justify-content: center; }
  .slideshow-slide--desktop-center_right .slideshow-slide__content { align-items: center; justify-content: flex-end; }
  .slideshow-slide--desktop-bottom_left .slideshow-slide__content { align-items: flex-end; justify-content: flex-start; }
  .slideshow-slide--desktop-bottom_center .slideshow-slide__content { align-items: flex-end; justify-content: center; }
  .slideshow-slide--desktop-bottom_right .slideshow-slide__content { align-items: flex-end; justify-content: flex-end; }
  .slideshow-slide--split .slideshow-slide__media { grid-column: 2; width: 50%; justify-self: end; }
  .slideshow-slide--split .slideshow-slide__content { grid-column: 1; width: 50%; background: var(--background-color); }
  .slideshow-slide:not(.swiper-slide-active) .slideshow-slide__content-inner > .shopify-block { opacity: 0; transform: translateY(1.6rem); }
  .slideshow-slide.swiper-slide-active .slideshow-slide__content-inner > .shopify-block { animation: slideshow-content-in .5s ease both; animation-delay: calc(var(--slideshow-block-index, 0) * 75ms); }
  .slideshow-slide__content-inner > .shopify-block:nth-child(1) { --slideshow-block-index: 0; }.slideshow-slide__content-inner > .shopify-block:nth-child(2) { --slideshow-block-index: 1; }.slideshow-slide__content-inner > .shopify-block:nth-child(3) { --slideshow-block-index: 2; }.slideshow-slide__content-inner > .shopify-block:nth-child(4) { --slideshow-block-index: 3; }.slideshow-slide__content-inner > .shopify-block:nth-child(5) { --slideshow-block-index: 4; }.slideshow-slide__content-inner > .shopify-block:nth-child(6) { --slideshow-block-index: 5; }
  @keyframes slideshow-content-in { to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 767.98px) {
    .slideshow-slide__content { padding: 3.2rem calc(var(--page-margin-mobile) + 2.4rem); }
    .slideshow-slide__content-inner { gap: var(--slideshow-slide-gap-mobile, var(--slideshow-slide-gap, 1.2rem)); }
    .slideshow-slide--mobile-top_left .slideshow-slide__content { align-items: flex-start; justify-content: flex-start; }.slideshow-slide--mobile-top_center .slideshow-slide__content { align-items: flex-start; justify-content: center; }.slideshow-slide--mobile-top_right .slideshow-slide__content { align-items: flex-start; justify-content: flex-end; }.slideshow-slide--mobile-center_left .slideshow-slide__content { align-items: center; justify-content: flex-start; }.slideshow-slide--mobile-center_center .slideshow-slide__content { align-items: center; justify-content: center; }.slideshow-slide--mobile-center_right .slideshow-slide__content { align-items: center; justify-content: flex-end; }.slideshow-slide--mobile-bottom_left .slideshow-slide__content { align-items: flex-end; justify-content: flex-start; }.slideshow-slide--mobile-bottom_center .slideshow-slide__content { align-items: flex-end; justify-content: center; }.slideshow-slide--mobile-bottom_right .slideshow-slide__content { align-items: flex-end; justify-content: flex-end; }
    .slideshow-slide--split .slideshow-slide__media, .slideshow-slide--split .slideshow-slide__content { grid-column: 1; width: 100%; }
    .slideshow-slide--split .slideshow-slide__media { grid-row: 1; height: 42%; }.slideshow-slide--split .slideshow-slide__content { grid-row: 2; min-height: 58%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Slide",
  "tag": null,
  "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "button" }, { "type": "buttons" }, { "type": "spacer" }, { "type": "icon" }],
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "classic", "label": "Classic" }, { "value": "split", "label": "Split" }], "default": "classic" },
    { "type": "url", "id": "link", "label": "Link" }, { "type": "checkbox", "id": "open_in_new_tab", "label": "Open link in new tab", "default": false },
    { "type": "header", "content": "Media" }, { "type": "select", "id": "media_type", "label": "Type", "options": [{ "value": "image", "label": "Image" }, { "value": "video", "label": "Video" }], "default": "image" },
    { "type": "image_picker", "id": "image", "label": "Image", "visible_if": "{{ block.settings.media_type == 'image' }}" }, { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "visible_if": "{{ block.settings.media_type == 'image' }}" }, { "type": "video", "id": "video", "label": "Video", "visible_if": "{{ block.settings.media_type == 'video' }}" },
    { "type": "checkbox", "id": "show_overlay", "label": "Show overlay", "default": true }, { "type": "color", "id": "overlay_color", "label": "Overlay color", "alpha": true, "default": "#00000033", "visible_if": "{{ block.settings.show_overlay }}" },
    { "type": "header", "content": "Content" },
    { "type": "select", "id": "desktop_position", "label": "Desktop position", "options": [{ "value": "top_left", "label": "Top left" }, { "value": "top_center", "label": "Top center" }, { "value": "top_right", "label": "Top right" }, { "value": "center_left", "label": "Center left" }, { "value": "center_center", "label": "Center center" }, { "value": "center_right", "label": "Center right" }, { "value": "bottom_left", "label": "Bottom left" }, { "value": "bottom_center", "label": "Bottom center" }, { "value": "bottom_right", "label": "Bottom right" }], "default": "bottom_left" },
    { "type": "select", "id": "mobile_position", "label": "Mobile position", "options": [{ "value": "top_left", "label": "Top left" }, { "value": "top_center", "label": "Top center" }, { "value": "top_right", "label": "Top right" }, { "value": "center_left", "label": "Center left" }, { "value": "center_center", "label": "Center center" }, { "value": "center_right", "label": "Center right" }, { "value": "bottom_left", "label": "Bottom left" }, { "value": "bottom_center", "label": "Bottom center" }, { "value": "bottom_right", "label": "Bottom right" }], "default": "center_center" },
    { "type": "range", "id": "desktop_gap", "label": "Desktop gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 12 }, { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 12 },
    { "type": "header", "content": "Appearance" }, { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
