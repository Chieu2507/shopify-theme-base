{% liquid
  assign header_top_separator = block.settings.bottom_separator | default: 'none'
  unless header_top_separator == 'none' or header_top_separator == 'line' or header_top_separator == 'shadow'
    assign header_top_separator = 'none'
  endunless

  assign header_top_gap = block.settings.gap | default: 20 | plus: 0
  if header_top_gap < 0 or header_top_gap > 100
    assign header_top_gap = 20
  endif

  assign header_top_padding_top = block.settings.padding_top | default: 24 | plus: 0
  assign header_top_padding_bottom = block.settings.padding_bottom | default: 24 | plus: 0
  if header_top_padding_top < 0 or header_top_padding_top > 100
    assign header_top_padding_top = 24
  endif
  if header_top_padding_bottom < 0 or header_top_padding_bottom > 100
    assign header_top_padding_bottom = 24
  endif
%}

{% capture header_top_style %}
  {% if header_top_gap != 20 %}--header-top-gap: {{ header_top_gap }}px;{% endif %}
  {% if header_top_padding_top != 24 %}--header-top-padding-top: {{ header_top_padding_top }}px;{% endif %}
  {% if header_top_padding_bottom != 24 %}--header-top-padding-bottom: {{ header_top_padding_bottom }}px;{% endif %}
{% endcapture %}
{% assign header_top_style = header_top_style | strip %}

<div
  class="header-top header-top--separator-{{ header_top_separator }}"
  {% if header_top_style != blank %}style="{{ header_top_style }}"{% endif %}
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .header-top {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--header-top-gap, 20px);
    min-width: 0;
    padding-top: var(--header-top-padding-top, 24px);
    padding-bottom: var(--header-top-padding-bottom, 24px);
  }

  .header-top > * {
    min-width: 0;
  }

  .header-top--separator-line {
    border-bottom: 1px solid var(--border-color);
  }

  .header-top--separator-shadow {
    box-shadow: 0 1px 0 color-mix(in srgb, var(--shadow-color) 20%, transparent);
  }

  .header-top :where(.header-search, .header-account, .header-cart) {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: var(--button-height);
    color: var(--body-color);
    line-height: 1;
    text-decoration: none;
  }

  .header-top :where(.header-search, .header-account, .header-cart) .icon {
    width: var(--header-icon-size, var(--icon-size-large));
    height: var(--header-icon-size, var(--icon-size-large));
    flex: 0 0 auto;
  }

  .header-top :where(.header-search, .header-account, .header-cart) svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke-width: var(--icon-stroke-width);
  }

  .header-top .header-action__label {
    white-space: nowrap;
  }

  .header-top .header-cart__count {
    min-width: 1.25em;
    font-size: var(--font-body-xs);
    line-height: 1;
    text-align: center;
  }

  .header-top .header-divider {
    flex: 0 0 auto;
  }

  @media (max-width: 767.98px) {
    .header-top {
      flex-wrap: wrap;
      gap: var(--header-top-gap, 20px);
    }

    .header-top :where(.header-search, .header-account, .header-cart) {
      min-height: var(--button-height-mobile);
    }

    .header-top .header-action--type-icon .header-action__label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header_top",
  "tag": null,
  "blocks": [
    { "type": "_header-menu" },
    { "type": "_header-menu-toggle" },
    { "type": "_header-logo" },
    { "type": "_header-localization" },
    { "type": "_header-divider" },
    { "type": "_header-search" },
    { "type": "_header-account" },
    { "type": "_header-cart" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "select",
      "id": "bottom_separator",
      "label": "t:labels.bottom_separator",
      "options": [
        { "value": "none", "label": "t:options.header_separator.none" },
        { "value": "line", "label": "t:options.header_separator.line" },
        { "value": "shadow", "label": "t:options.header_separator.shadow" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
