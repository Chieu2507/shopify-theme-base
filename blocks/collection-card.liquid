{% doc %}
  Renders one collection card from the closest collection resource.

  Collection List renders this static block once for each selected collection
  and passes the current resource through `closest.collection`. Keeping the
  card as a real Theme Block (instead of rendering only a snippet) makes
  `block.shopify_attributes` available to the Theme Editor inspector.

  @param {boolean} [placeholder] - Whether to render the empty editor state
{% enddoc %}

{% liquid
  assign collection_card_collection = closest.collection
  assign collection_card_image = collection_card_collection.featured_image | default: collection_card_collection.image
  assign collection_card_scheme = block.settings.color_scheme | default: 'scheme-1'
  if block.settings.color_scheme.id != blank
    assign collection_card_scheme = block.settings.color_scheme.id
  endif
  assign collection_card_scheme = collection_card_scheme | default: 'scheme-1' | handleize
  assign collection_card_placement = block.settings.placement | default: 'below_image'
  assign collection_card_ratio = block.settings.ratio | default: 'original'
  assign collection_card_padding_top = block.settings.padding_top | default: 16 | plus: 0
  assign collection_card_padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign collection_card_padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign collection_card_padding_right = block.settings.padding_right | default: 0 | plus: 0
  assign collection_card_padding_top_mobile = block.settings.padding_top_mobile | default: collection_card_padding_top | plus: 0
  assign collection_card_padding_bottom_mobile = block.settings.padding_bottom_mobile | default: collection_card_padding_bottom | plus: 0
  assign collection_card_padding_left_mobile = block.settings.padding_left_mobile | default: collection_card_padding_left | plus: 0
  assign collection_card_padding_right_mobile = block.settings.padding_right_mobile | default: collection_card_padding_right | plus: 0

  if collection_card_padding_top < 0 or collection_card_padding_top > 100
    assign collection_card_padding_top = 16
  endif
  if collection_card_padding_bottom < 0 or collection_card_padding_bottom > 100
    assign collection_card_padding_bottom = 0
  endif
  if collection_card_padding_left < 0 or collection_card_padding_left > 100
    assign collection_card_padding_left = 0
  endif
  if collection_card_padding_right < 0 or collection_card_padding_right > 100
    assign collection_card_padding_right = 0
  endif
  if collection_card_padding_top_mobile < 0 or collection_card_padding_top_mobile > 100
    assign collection_card_padding_top_mobile = collection_card_padding_top
  endif
  if collection_card_padding_bottom_mobile < 0 or collection_card_padding_bottom_mobile > 100
    assign collection_card_padding_bottom_mobile = collection_card_padding_bottom
  endif
  if collection_card_padding_left_mobile < 0 or collection_card_padding_left_mobile > 100
    assign collection_card_padding_left_mobile = collection_card_padding_left
  endif
  if collection_card_padding_right_mobile < 0 or collection_card_padding_right_mobile > 100
    assign collection_card_padding_right_mobile = collection_card_padding_right
  endif

  assign collection_card_is_placeholder = false
  if placeholder
    assign collection_card_is_placeholder = true
  endif
%}

{% capture collection_card_padding_style %}
  {% if collection_card_padding_top != 16 %}--card-padding-top: {{ collection_card_padding_top }}px;{% endif %}
  {% if collection_card_padding_bottom != 0 %}--card-padding-bottom: {{ collection_card_padding_bottom }}px;{% endif %}
  {% if collection_card_padding_left != 0 %}--card-padding-left: {{ collection_card_padding_left }}px;{% endif %}
  {% if collection_card_padding_right != 0 %}--card-padding-right: {{ collection_card_padding_right }}px;{% endif %}
  {% if block.settings.customize_mobile_padding %}
    {% if collection_card_padding_top_mobile != collection_card_padding_top %}--card-padding-top-mobile: {{ collection_card_padding_top_mobile }}px;{% endif %}
    {% if collection_card_padding_bottom_mobile != collection_card_padding_bottom %}--card-padding-bottom-mobile: {{ collection_card_padding_bottom_mobile }}px;{% endif %}
    {% if collection_card_padding_left_mobile != collection_card_padding_left %}--card-padding-left-mobile: {{ collection_card_padding_left_mobile }}px;{% endif %}
    {% if collection_card_padding_right_mobile != collection_card_padding_right %}--card-padding-right-mobile: {{ collection_card_padding_right_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign collection_card_padding_style = collection_card_padding_style | strip %}

<article
  class="collection-card-kernel collection-card-kernel--{{ collection_card_placement }} collection-card-kernel--{{ collection_card_ratio }}{% if collection_card_is_placeholder %} collection-card-kernel--placeholder{% else %} collection-card-kernel--linked{% endif %}{% if request.design_mode %} collection-card-kernel--design-mode{% endif %}{% if block.settings.color_type == 'color_scheme' %} color-scheme section-color-scope {{ collection_card_scheme }}{% endif %}"
  data-collection-card
  style="--card-border:{{ block.settings.border_thickness | default: 0 }}px;--card-align:{{ block.settings.alignment | default: 'left' }};{% if collection_card_padding_style != blank %}{{ collection_card_padding_style }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="collection-card-kernel__media{% if collection_card_image == blank %} placeholder-image{% endif %}">
    {% if collection_card_image != blank %}
      {{ collection_card_image | image_url: width: 1200 | image_tag: alt: collection_card_collection.title }}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag }}
    {% endif %}
  </div>

  {% if collection_card_collection != blank %}
    <a
      class="collection-card-kernel__link"
      href="{{ collection_card_collection.url }}"
      aria-label="{{ collection_card_collection.title | escape }}"
    ></a>
  {% else %}
    <span class="collection-card-kernel__link" role="link" aria-disabled="true"></span>
  {% endif %}

  <div class="collection-card-kernel__content">
    {% content_for 'block', type: 'collection-card-title', id: 'title' %}
    {% content_for 'blocks' %}
  </div>
</article>

{% stylesheet %}
  .collection-card-kernel {
    position: relative;
    overflow: hidden;
    border: var(--card-border) solid var(--border-color);
    border-radius: var(--card-radius);
    background: var(--background-color);
    isolation: isolate;
  }

  .collection-card-kernel__link {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .collection-card-kernel__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  .collection-card-kernel__media {
    position: relative;
    z-index: 0;
    overflow: hidden;
  }

  .collection-card-kernel--square .collection-card-kernel__media {
    aspect-ratio: 1;
  }

  .collection-card-kernel--portrait .collection-card-kernel__media {
    aspect-ratio: 2 / 3;
  }

  .collection-card-kernel__media img,
  .collection-card-kernel__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-card-kernel__content {
    position: relative;
    z-index: 3;
    padding: var(--card-padding-top, 16px) var(--card-padding-right, 0px) var(--card-padding-bottom, 0px) var(--card-padding-left, 0px);
    text-align: var(--card-align);
  }

  .collection-card-kernel--linked .collection-card-kernel__content {
    pointer-events: none;
  }

  .collection-card-kernel--linked .collection-card-kernel__content :where(a, button, input, select, textarea) {
    pointer-events: auto;
  }

  .collection-card-kernel--design-mode .collection-card-kernel__content {
    pointer-events: auto;
  }

  .collection-card-kernel__content h3 {
    margin: 0;
  }

  .collection-card-kernel--on_image {
    position: relative;
  }

  .collection-card-kernel--on_image .collection-card-kernel__content {
    position: absolute;
    z-index: 3;
    inset: auto 0 0;
    padding: var(--card-padding-top, 1.6rem) var(--card-padding-right, 1.6rem) var(--card-padding-bottom, 1.6rem) var(--card-padding-left, 1.6rem);
    color: #fff;
    background: linear-gradient(transparent, rgb(0 0 0 / 65%));
  }

  @media (max-width: 767.98px) {
    .collection-card-kernel__content {
      padding: var(--card-padding-top-mobile, var(--card-padding-top, 16px)) var(--card-padding-right-mobile, var(--card-padding-right, 0px)) var(--card-padding-bottom-mobile, var(--card-padding-bottom, 0px)) var(--card-padding-left-mobile, var(--card-padding-left, 0px));
    }

    .collection-card-kernel--on_image .collection-card-kernel__content {
      padding: var(--card-padding-top-mobile, var(--card-padding-top, 1.6rem)) var(--card-padding-right-mobile, var(--card-padding-right, 1.6rem)) var(--card-padding-bottom-mobile, var(--card-padding-bottom, 1.6rem)) var(--card-padding-left-mobile, var(--card-padding-left, 1.6rem));
    }
  }
{% endstylesheet %}

