{% doc %}
  Renders the fixed editorial image for the theme-block-native Shop the look
  section and exposes its mobile aspect ratio to the section layout.

  @example
  {% content_for 'block', type: '_shop-the-look-media', id: 'editorial_media' %}
{% enddoc %}

{% liquid
  assign editorial_image = block.settings.image | default: block.settings.mobile_image
  assign editorial_image_alt = editorial_image.alt
  assign mobile_media_aspect_ratio = block.settings.mobile_image.aspect_ratio | default: block.settings.image.aspect_ratio | default: 1
  assign mobile_focal_point = block.settings.mobile_focal_point

  if block.settings.mobile_image == blank or mobile_focal_point == blank
    assign mobile_focal_point = block.settings.focal_point
  endif

  if editorial_image_alt == blank
    assign editorial_image_alt = 'shop_the_look.editorial_image' | t
  endif

  capture editorial_image_style
    echo '--shop-the-look-desktop-focal-point: ' | append: block.settings.focal_point | append: '; '
    echo '--shop-the-look-mobile-focal-point: ' | append: mobile_focal_point | append: ';'
  endcapture
%}

{% style %}
  #ShopTheLook-{{ section.id }} {
    --shop-the-look-mobile-media-ratio: {{ mobile_media_aspect_ratio }};
  }
{% endstyle %}

<div class="shop-the-look__media" {{ block.shopify_attributes }}>
  {% if editorial_image != blank %}
    {% render 'responsive-picture',
      image: editorial_image,
      mobile_image: block.settings.mobile_image,
      mobile_breakpoint: 989,
      max_width: 1920,
      mobile_max_width: 1200,
      widths: '480, 720, 960, 1200, 1440, 1920',
      mobile_widths: '360, 480, 640, 750, 960, 1200',
      sizes: '(min-width: 990px) 50vw, 100vw',
      class: 'shop-the-look__editorial-image',
      loading: 'lazy',
      alt: editorial_image_alt,
      style: editorial_image_style
    %}
  {% else %}
    {% render 'media-placeholder', class_name: 'shop-the-look__placeholder', asset_name: 'placeholder-image-default-2.svg' %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Editorial image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Editorial image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Recommended when the desktop crop does not fit the mobile layout. Uses the main image when left blank."
    },
    {
      "type": "text",
      "id": "focal_point",
      "label": "Focal point",
      "default": "center center",
      "info": "CSS object-position, for example: 50% 40%"
    },
    {
      "type": "text",
      "id": "mobile_focal_point",
      "label": "Mobile focal point",
      "default": "center center",
      "info": "Applied only when a mobile image is selected."
    }
  ]
}
{% endschema %}
