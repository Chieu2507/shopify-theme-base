{% doc %}
  Renders one image slide with media, overlay, optional collection links and a
  fixed Card / Group slot for nested Heading, Text and Button theme blocks.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign slide_collection = block.settings.collection
  assign slide_image = block.settings.image | default: block.settings.mobile_image
  assign slide_image_alt = slide_image.alt

  if slide_image_alt == blank
    assign slide_image_alt = block.settings.image_alt
  endif
  if slide_image_alt == blank
    assign slide_image_alt = 'accessibility.image' | t
  endif

  assign slide_index = 0
  for section_block in section.blocks
    if section_block.type == '_slideshow-slide'
      assign slide_index = slide_index | plus: 1
      if section_block.id == block.id
        break
      endif
    endif
  endfor
  if slide_index == 0
    assign slide_index = 1
  endif

  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if slide_index == 1 and request.page_type != 'index'
    assign image_loading = 'eager'
    assign image_priority = 'high'
  elsif slide_index == 1 and section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif

  assign placeholder_asset = 'placeholder-image-default-2.svg'
  assign placeholder_remainder = slide_index | modulo: 2
  if placeholder_remainder == 0
    assign placeholder_asset = 'placeholder-image-default-3.svg'
  endif
%}

<article
  class="slideshow__slide swiper-slide color-scheme color-{{ block.settings.color_scheme.id }} slideshow__slide--desktop-{{ block.settings.content_position }} slideshow__slide--mobile-{{ block.settings.content_position_mobile }} slideshow__slide--align-{{ block.settings.content_alignment }}"
  style="
    --slideshow-overlay-color: {{ block.settings.overlay_color }};
    --slideshow-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --slideshow-content-width: {{ block.settings.content_width }}px;
  "
  data-block-id="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <div class="slideshow__media" data-swiper-parallax-x="100%">
    {% if slide_image != blank %}
      <picture>
        {% if block.settings.mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ block.settings.mobile_image | image_url: width: 375 }} 375w,
              {{ block.settings.mobile_image | image_url: width: 550 }} 550w,
              {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ block.settings.mobile_image | image_url: width: 960 }} 960w,
              {{ block.settings.mobile_image | image_url: width: 1280 }} 1280w
            "
            sizes="100vw"
          >
        {% endif %}
        {{
          slide_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 960, 1200, 1600, 1920, 2400',
            sizes: '(min-width: 750px) 100vw, 100vw',
            class: 'slideshow__image',
            loading: image_loading,
            fetchpriority: image_priority,
            alt: slide_image_alt
        }}
      </picture>
    {% else %}
      {% render 'media-placeholder',
        class_name: 'slideshow__placeholder',
        asset_name: placeholder_asset,
        loading: image_loading,
        fetchpriority: image_priority
      %}
    {% endif %}
  </div>

  <div class="slideshow__overlay" aria-hidden="true"></div>

  <div
    class="slideshow__content-positioner"
    data-swiper-parallax-x="30%"
    data-swiper-parallax-opacity="0"
    data-swiper-parallax-duration="1000"
  >
    <div class="slideshow__content">
      {% if block.settings.show_collection_list and slide_collection != blank %}
        <nav class="slideshow__collection-list" aria-label="{{ slide_collection.title | escape }}">
          <a class="slideshow__collection-title" href="{{ slide_collection.url }}">
            {{ slide_collection.title | escape }}
          </a>
          {% for product in slide_collection.products limit: 4 %}
            <a href="{{ product.url }}">{{ product.title | escape }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      {% content_for 'block', type: 'group', id: 'content_card', class_name: 'slideshow__content-card' %}
    </div>
  </div>
</article>

