{% doc %}
  Renders a navigation menu with an optional heading and a mobile disclosure.

  The parent layout owns the block width and alignment. This block owns the
  selected menu, heading presentation, link list and mobile disclosure state.

  @example
  {% content_for 'block', type: 'menu', id: 'menu' %}
{% enddoc %}

{% liquid
  assign selected_menu = block.settings.menu
  assign selected_menu_handle = block.settings.menu
  if block.settings.menu.handle != blank
    assign selected_menu_handle = block.settings.menu.handle
  endif
  if selected_menu.links == blank and selected_menu_handle != blank
    assign selected_menu = linklists[selected_menu_handle]
  endif

  assign has_menu = false
  if selected_menu != blank and selected_menu.links != blank
    assign has_menu = true
  endif

  assign menu_icon = block.settings.icon | default: 'chevron'
  unless menu_icon == 'chevron' or menu_icon == 'plus'
    assign menu_icon = 'chevron'
  endunless

  assign collapse_menu_on_mobile = block.settings.collapse_menu_on_mobile | default: true, allow_false: true

  assign heading_size = block.settings.heading_size | default: 'lg'
  unless heading_size == 'display' or heading_size == 'xl' or heading_size == 'lg' or heading_size == 'md' or heading_size == 'sm' or heading_size == 'xs' or heading_size == 'custom'
    assign heading_size = 'lg'
  endunless

  assign heading_tag = block.settings.html_tag | default: 'h2'
  unless heading_tag == 'div' or heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3' or heading_tag == 'h4' or heading_tag == 'h5' or heading_tag == 'h6'
    assign heading_tag = 'h2'
  endunless

  assign heading_color = block.settings.heading_color
  if heading_color == 'heading'
    assign heading_color = 'var(--heading-color)'
  elsif heading_color == 'body'
    assign heading_color = 'var(--body-color)'
  endif

  assign menu_size = block.settings.menu_size | default: 'md'
  unless menu_size == 'xs' or menu_size == 'sm' or menu_size == 'md' or menu_size == 'lg' or menu_size == 'xl' or menu_size == 'xxl'
    assign menu_size = 'md'
  endunless

  assign menu_color = block.settings.menu_color
  if menu_color == 'heading'
    assign menu_color = 'var(--heading-color)'
  elsif menu_color == 'body'
    assign menu_color = 'var(--body-color)'
  endif

  assign heading_gap = block.settings.heading_gap | default: 16 | plus: 0
  if heading_gap < 0 or heading_gap > 100
    assign heading_gap = 16
  endif

  assign menu_gap = block.settings.menu_gap | default: 8 | plus: 0
  if menu_gap < 0 or menu_gap > 100
    assign menu_gap = 8
  endif

  assign heading_content = block.settings.heading | default: ''
  assign heading_label = heading_content | strip_html | strip
  if heading_label == blank
    assign heading_label = selected_menu.title | default: '' | strip
    if heading_label == blank
      assign heading_label = 'accessibility.footer_menu' | t
    endif
    assign heading_content = heading_label | escape
  endif

  assign menu_class = 'menu-block menu-block--icon-' | append: menu_icon
  assign heading_class = 'menu-block__heading heading-text heading-' | append: heading_size
  assign menu_list_class = 'menu-block__list body-text body-' | append: menu_size
%}

{% capture menu_style %}
  {% if heading_gap != 16 %}--menu-block-heading-gap: {{ heading_gap }}px;{% endif %}
  {% if menu_gap != 8 %}--menu-block-menu-gap: {{ menu_gap }}px;{% endif %}
  {% if heading_color != blank %}--menu-block-heading-color: {{ heading_color | escape }};{% endif %}
  {% if menu_color != blank %}--menu-block-menu-color: {{ menu_color | escape }};{% endif %}
{% endcapture %}
{% assign menu_style = menu_style | strip %}

{% capture heading_markup %}
  <{{ heading_tag }}
    class="{{ heading_class }}"
  >{{ heading_content }}</{{ heading_tag }}>
{% endcapture %}
{% assign heading_markup = heading_markup | strip %}

{% capture menu_markup %}
  {% if has_menu %}
    <ul class="{{ menu_list_class }}" role="list">
      {% for menu_link in selected_menu.links %}
        <li class="menu-block__item{% if menu_link.active or menu_link.child_active %} menu-block__item--active{% endif %}{% if menu_link.links != blank %} menu-block__item--has-children{% endif %}">
          {% if menu_link.url != blank %}
            <a
              class="menu-block__link"
              href="{{ menu_link.url | escape }}"
              {% if menu_link.current %}aria-current="page"{% endif %}
            >{{ menu_link.title | escape }}</a>
          {% else %}
            <span class="menu-block__link menu-block__link--placeholder">{{ menu_link.title | escape }}</span>
          {% endif %}

          {% if menu_link.links != blank %}
            <ul class="menu-block__submenu" role="list">
              {% for child_link in menu_link.links %}
                <li class="menu-block__item{% if child_link.active %} menu-block__item--active{% endif %}">
                  {% if child_link.url != blank %}
                    <a
                      class="menu-block__link"
                      href="{{ child_link.url | escape }}"
                      {% if child_link.current %}aria-current="page"{% endif %}
                    >{{ child_link.title | escape }}</a>
                  {% else %}
                    <span class="menu-block__link menu-block__link--placeholder">{{ child_link.title | escape }}</span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% elsif request.design_mode %}
    <p class="menu-block__empty">{{ 'accessibility.footer_menu' | t }}</p>
  {% endif %}
{% endcapture %}
{% assign menu_markup = menu_markup | strip %}

{% if has_menu or request.design_mode %}
  <nav
    class="{{ menu_class }}"
    aria-label="{{ heading_label | escape }}"
    data-collapse-mobile="{{ collapse_menu_on_mobile }}"
    {% if menu_style != blank %}style="{{ menu_style }}"{% endif %}
    {{ block.shopify_attributes }}
  >
    {% if collapse_menu_on_mobile %}
      <details class="menu-block__details">
        <summary class="menu-block__summary">
          {{ heading_markup }}
          <span class="menu-block__toggle-icon menu-block__toggle-icon--{{ menu_icon }}" aria-hidden="true">
            {% if menu_icon == 'plus' %}
              <svg viewBox="0 0 24 24" fill="none" focusable="false">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-thickness)" />
              </svg>
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" focusable="false">
                <path d="m5 9 7 7 7-7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="var(--icon-thickness)" />
              </svg>
            {% endif %}
          </span>
        </summary>
        <div class="menu-block__content">
          <div class="menu-block__content-inner">{{ menu_markup }}</div>
        </div>
      </details>
    {% else %}
      {{ heading_markup }}
      <div class="menu-block__content">
        <div class="menu-block__content-inner">{{ menu_markup }}</div>
      </div>
    {% endif %}
  </nav>
{% endif %}

{% stylesheet %}
  .menu-block {
    display: block;
    width: 100%;
    min-width: 0;
    color: var(--body-color);
  }

  .menu-block__details,
  .menu-block__content {
    min-width: 0;
  }

  .menu-block__content-inner {
    min-width: 0;
  }

  .menu-block__heading {
    display: block;
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--menu-block-heading-color, var(--heading-color));
  }

  .menu-block__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-width: 0;
    list-style: none;
    cursor: default;
  }

  .menu-block__summary::-webkit-details-marker {
    display: none;
  }

  .menu-block__summary > .menu-block__heading {
    flex: 1 1 auto;
  }

  .menu-block__summary:focus-visible {
    outline: 2px solid var(--input-focus-color);
    outline-offset: 3px;
  }

  .menu-block__content {
    margin-block-start: var(--menu-block-heading-gap, 16px);
  }

  .menu-block__details > .menu-block__content {
    display: block;
  }

  .menu-block__list,
  .menu-block__submenu {
    display: grid;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-block__list {
    gap: var(--menu-block-menu-gap, 8px);
    color: var(--menu-block-menu-color, var(--body-color));
  }

  .menu-block__submenu {
    gap: var(--menu-block-menu-gap, 8px);
    margin-block-start: var(--menu-block-menu-gap, 8px);
    padding-inline-start: 1rem;
  }

  .menu-block__link {
    display: inline-block;
    max-width: 100%;
    color: inherit;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .menu-block__link:hover,
  .menu-block__link[aria-current='page'],
  .menu-block__item--active > .menu-block__link {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .menu-block__empty {
    color: var(--body-color);
  }

  .menu-block__toggle-icon {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    color: inherit;
    transition: transform var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .menu-block__toggle-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 768px) {
    .menu-block[data-collapse-mobile='true'] .menu-block__summary {
      pointer-events: none;
    }

    .menu-block[data-collapse-mobile='true'] .menu-block__details > .menu-block__content {
      display: block !important;
    }
  }

  @media (max-width: 767.98px) {
    .menu-block[data-collapse-mobile='true'] .menu-block__summary {
      display: flex;
      cursor: pointer;
      pointer-events: auto;
      padding-block: 0.75rem;
      border-block-end: 1px solid var(--border-color);
    }

    .menu-block[data-collapse-mobile='true'] .menu-block__toggle-icon {
      display: inline-flex;
    }

    .menu-block[data-collapse-mobile='true'] .menu-block__details > .menu-block__content {
      display: block !important;
      box-sizing: border-box;
      height: 0;
      margin-block-start: 0;
      padding-block-start: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.25rem);
      transition:
        height var(--motion-duration-standard) var(--motion-ease-standard),
        padding-block-start var(--motion-duration-standard) var(--motion-ease-standard),
        opacity var(--motion-duration-fast) var(--motion-ease-standard),
        transform var(--motion-duration-fast) var(--motion-ease-standard),
        visibility 0s linear var(--motion-duration-standard);
    }

    .menu-block[data-collapse-mobile='true'] .menu-block__content-inner {
      min-height: 0;
      overflow: hidden;
    }

    .menu-block[data-collapse-mobile='true'] .menu-block__details[open] > .menu-block__content {
      height: auto;
      padding-block-start: var(--menu-block-heading-gap, 16px);
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: 0s;
    }

    .menu-block[data-collapse-mobile='true'] .menu-block__details[open] .menu-block__toggle-icon--chevron {
      transform: rotate(180deg);
    }

    .menu-block[data-collapse-mobile='true'] .menu-block__details[open] .menu-block__toggle-icon--plus {
      transform: rotate(45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-block__content,
    .menu-block__toggle-icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const menuSelector = ".menu-block[data-collapse-mobile='true']";
    const desktopQuery = window.matchMedia('(min-width: 768px)');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const menuStates = new WeakMap();

    const cancelAnimation = (state) => {
      state.animationId += 1;
      if (state.animationFrame) {
        cancelAnimationFrame(state.animationFrame);
        state.animationFrame = 0;
      }
      if (state.transitionEnd) {
        state.content.removeEventListener('transitionend', state.transitionEnd);
        state.transitionEnd = null;
      }
    };

    const setStaticState = (state) => {
      cancelAnimation(state);
      state.content.style.removeProperty('height');
    };

    const animateContent = (state) => {
      const { content, details } = state;
      cancelAnimation(state);

      if (desktopQuery.matches || reducedMotionQuery.matches) {
        content.style.removeProperty('height');
        return;
      }

      const startHeight = content.getBoundingClientRect().height;
      const endHeight = details.open ? content.scrollHeight : 0;
      const animationId = state.animationId;

      content.style.height = `${startHeight}px`;
      content.getBoundingClientRect();

      if (Math.abs(startHeight - endHeight) < 0.5) {
        if (details.open) content.style.removeProperty('height');
        else content.style.height = '0px';
        return;
      }

      const transitionEnd = (event) => {
        if (event.target !== content || event.propertyName !== 'height' || state.animationId !== animationId) return;

        state.transitionEnd = null;
        content.removeEventListener('transitionend', transitionEnd);
        if (details.open) content.style.removeProperty('height');
      };

      state.transitionEnd = transitionEnd;
      content.addEventListener('transitionend', transitionEnd);
      state.animationFrame = requestAnimationFrame(() => {
        state.animationFrame = 0;
        if (state.animationId !== animationId) return;
        content.style.height = `${endHeight}px`;
      });
    };

    const prepareToggle = (state) => {
      if (desktopQuery.matches || reducedMotionQuery.matches) return;

      cancelAnimation(state);
      const currentHeight = state.content.getBoundingClientRect().height;
      state.content.style.height = `${currentHeight}px`;
      state.content.getBoundingClientRect();
    };

    const initializeMenu = (menu) => {
      const details = menu.querySelector('.menu-block__details');
      if (!details || menuStates.has(details)) return;

      const controller = new AbortController();
      const content = details.querySelector('.menu-block__content');
      const summary = details.querySelector('.menu-block__summary');
      if (!content || !summary) return;

      const state = {
        animationFrame: 0,
        animationId: 0,
        content,
        controller,
        details,
        transitionEnd: null
      };

      const syncOpenState = () => {
        details.open = desktopQuery.matches;
        if (desktopQuery.matches || reducedMotionQuery.matches) {
          setStaticState(state);
        } else {
          cancelAnimation(state);
          content.style.height = '0px';
        }
      };
      const syncMotionState = () => {
        if (reducedMotionQuery.matches) setStaticState(state);
      };
      const handleToggle = () => {
        if (desktopQuery.matches) {
          details.open = true;
          setStaticState(state);
          return;
        }

        animateContent(state);
      };

      desktopQuery.addEventListener('change', syncOpenState, { signal: controller.signal });
      reducedMotionQuery.addEventListener('change', syncMotionState, { signal: controller.signal });
      summary.addEventListener('click', () => prepareToggle(state), { signal: controller.signal });
      details.addEventListener('toggle', handleToggle, { signal: controller.signal });
      menuStates.set(details, state);
      syncOpenState();
    };

    const initializeMenus = (root = document) => {
      if (root.matches?.(menuSelector)) initializeMenu(root);
      root.querySelectorAll?.(menuSelector).forEach(initializeMenu);
    };

    const removeMenus = (root) => {
      const menus = [];
      if (root.matches?.(menuSelector)) menus.push(root);
      root.querySelectorAll?.(menuSelector).forEach((menu) => menus.push(menu));

      menus.forEach((menu) => {
        const details = menu.querySelector('.menu-block__details');
        const state = details && menuStates.get(details);
        state?.controller.abort();
        if (state) cancelAnimation(state);
        if (details) menuStates.delete(details);
      });
    };

    document.addEventListener('shopify:section:load', (event) => initializeMenus(event.target));
    document.addEventListener('shopify:section:unload', (event) => removeMenus(event.target));

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeMenus(), { once: true });
    } else {
      initializeMenus();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.menu",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:general.heading"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "checkbox",
      "id": "collapse_menu_on_mobile",
      "label": "t:labels.collapse_menu_on_mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "options": [
        { "value": "chevron", "label": "t:options.menu_icon.chevron" },
        { "value": "plus", "label": "t:options.menu_icon.plus" }
      ],
      "default": "chevron"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "t:labels.heading_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "menu_gap",
      "label": "t:labels.menu_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:general.heading_typography"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:labels.heading_size",
      "options": [
        { "value": "display", "label": "t:options.heading_size.display" },
        { "value": "xl", "label": "t:options.heading_size.xl" },
        { "value": "lg", "label": "t:options.heading_size.lg" },
        { "value": "md", "label": "t:options.heading_size.md" },
        { "value": "sm", "label": "t:options.heading_size.sm" },
        { "value": "xs", "label": "t:options.heading_size.xs" },
        { "value": "custom", "label": "t:options.heading_size.custom" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "t:labels.html_tag",
      "info": "t:info.heading_html_tag",
      "options": [
        { "value": "div", "label": "t:options.html_tag.paragraph" },
        { "value": "h1", "label": "t:options.html_tag.h1" },
        { "value": "h2", "label": "t:options.html_tag.h2" },
        { "value": "h3", "label": "t:options.html_tag.h3" },
        { "value": "h4", "label": "t:options.html_tag.h4" },
        { "value": "h5", "label": "t:options.html_tag.h5" },
        { "value": "h6", "label": "t:options.html_tag.h6" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.text_color",
      "info": "t:info.heading_text_color"
    },
    {
      "type": "header",
      "content": "t:general.menu_typography"
    },
    {
      "type": "select",
      "id": "menu_size",
      "label": "t:labels.text_size",
      "options": [
        { "value": "xs", "label": "t:options.text_size.xs" },
        { "value": "sm", "label": "t:options.text_size.sm" },
        { "value": "md", "label": "t:options.text_size.md" },
        { "value": "lg", "label": "t:options.text_size.lg" },
        { "value": "xl", "label": "t:options.text_size.xl" },
        { "value": "xxl", "label": "t:options.text_size.xxl" }
      ],
      "default": "md"
    },
    {
      "type": "color",
      "id": "menu_color",
      "label": "t:labels.text_color"
    }
  ],
  "presets": [
    {
      "name": "t:general.menu",
      "category": "t:general.navigation",
      "settings": {
        "menu": "main-menu",
        "collapse_menu_on_mobile": true,
        "icon": "chevron",
        "heading_gap": 16,
        "menu_gap": 8,
        "html_tag": "h2",
        "heading_size": "lg",
        "menu_size": "md"
      }
    }
  ]
}
{% endschema %}
