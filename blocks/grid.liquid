{% doc %}
  Renders Columns using the grid type ID for compatibility with saved templates.
  The grid owns column counts, horizontal/vertical gaps, mobile swipe, width
  and vertical padding. The existing Column kernel owns child content layout.
{% enddoc %}

{% liquid
  assign columns_desktop = block.settings.columns_desktop | default: 4 | plus: 0 | floor
  if columns_desktop < 2 or columns_desktop > 6
    assign columns_desktop = 4
  endif
  assign columns_mobile = block.settings.columns_mobile | default: 1 | plus: 0 | floor
  if columns_mobile < 1 or columns_mobile > 2
    assign columns_mobile = 1
  endif
%}
{% capture grid_style %}
  {% if columns_desktop != 4 %}--grid-columns-desktop: {{ columns_desktop }};{% endif %}
  {% if columns_mobile != 1 %}--grid-columns-mobile: {{ columns_mobile }};{% endif %}
  {% assign gap_horizontal_value = block.settings.gap_horizontal | default: 20 | at_least: 0 | at_most: 100 %}
  {% if gap_horizontal_value != 20 %}--grid-gap-horizontal: {{ gap_horizontal_value }}px;{% endif %}
  {% assign gap_vertical_value = block.settings.gap_vertical | default: 30 | at_least: 0 | at_most: 100 %}
  {% if gap_vertical_value != 30 %}--grid-gap-vertical: {{ gap_vertical_value }}px;{% endif %}
  {% assign gap_horizontal_mobile_value = block.settings.gap_horizontal_mobile | default: 12 | at_least: 0 | at_most: 50 %}
  {% if gap_horizontal_mobile_value != 12 %}--grid-gap-horizontal-mobile: {{ gap_horizontal_mobile_value }}px;{% endif %}
  {% assign gap_vertical_mobile_value = block.settings.gap_vertical_mobile | default: 30 | at_least: 0 | at_most: 50 %}
  {% unless block.settings.enable_swipe_mobile %}{% if gap_vertical_mobile_value != 30 %}--grid-gap-vertical-mobile: {{ gap_vertical_mobile_value }}px;{% endif %}{% endunless %}
  {% assign padding_top_value = block.settings.padding_top | default: 0 | at_least: 0 | at_most: 100 %}
  {% if padding_top_value != 0 %}--grid-padding-top: {{ padding_top_value }}px;{% endif %}
  {% assign padding_bottom_value = block.settings.padding_bottom | default: 0 | at_least: 0 | at_most: 100 %}
  {% if padding_bottom_value != 0 %}--grid-padding-bottom: {{ padding_bottom_value }}px;{% endif %}
  {% assign padding_top_mobile_value = block.settings.padding_top_mobile | default: 0 | at_least: 0 | at_most: 100 %}
  {% if block.settings.customize_mobile_padding %}--grid-padding-top-mobile: {{ padding_top_mobile_value }}px;{% endif %}
  {% assign padding_bottom_mobile_value = block.settings.padding_bottom_mobile | default: 0 | at_least: 0 | at_most: 100 %}
  {% if block.settings.customize_mobile_padding %}--grid-padding-bottom-mobile: {{ padding_bottom_mobile_value }}px;{% endif %}
  {% if block.settings.width == 'custom' %}--grid-width: {{ block.settings.custom_width | default: 50 | at_least: 10 | at_most: 100 }}%;{% endif %}
  {% if block.settings.custom_columns %}
    {% assign entries = block.settings.columns_per_breakpoint | downcase | split: ',' %}
    {% for entry in entries %}
      {% assign parts = entry | split: ':' %}
      {% assign key = parts.first | strip %}
      {% assign value = parts.last | strip %}
      {% assign count = value | plus: 0 %}
      {% assign canonical = count | append: '' %}
      {% assign valid_key = false %}
      {% case key %}{% when 'xs', 'sm', 'md', 'lg', 'xl', 'xxl' %}{% assign valid_key = true %}{% endcase %}
      {% if valid_key and parts.size == 2 and canonical == value and count >= 1 and count <= 50 %}--grid-columns-{{ key }}: {{ count }};{% endif %}
    {% endfor %}
  {% endif %}
{% endcapture %}
{% assign grid_style = grid_style | strip %}
<div class="block-grid{% if block.settings.enable_swipe_mobile %} block-grid--swipe-mobile{% endif %}"
  {% if grid_style != blank %}style="{{ grid_style }}"{% endif %}
  {% if block.settings.enable_swipe_mobile %}tabindex="0" role="region" aria-label="{{ 'accessibility.columns' | t | escape }}"{% endif %}
  {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>
{% stylesheet %}
  .block-grid {
    --grid-columns-desktop: 4;
    --grid-columns-mobile: 1;
    --grid-columns-xs: initial;
    --grid-columns-sm: initial;
    --grid-columns-md: initial;
    --grid-columns-lg: initial;
    --grid-columns-xl: initial;
    --grid-columns-xxl: initial;
    --grid-gap-horizontal: 20px;
    --grid-gap-vertical: 30px;
    --grid-gap-horizontal-mobile: 12px;
    --grid-gap-vertical-mobile: 30px;
    --grid-width: 100%;
    --grid-padding-top: 0px;
    --grid-padding-bottom: 0px;
    --grid-padding-top-mobile: initial;
    --grid-padding-bottom-mobile: initial;
    --grid-current-columns: var(--grid-columns-xs, var(--grid-columns-mobile));
    display: grid;
    grid-template-columns: repeat(var(--grid-current-columns), minmax(0, 1fr));
    column-gap: var(--grid-gap-horizontal-mobile);
    row-gap: var(--grid-gap-vertical-mobile);
    width: 100%;
    min-width: 0;
    padding-block: var(--grid-padding-top-mobile, var(--grid-padding-top)) var(--grid-padding-bottom-mobile, var(--grid-padding-bottom));
  }
  .block-grid > .block-column { width: 100%; min-width: 0; max-width: 100%; }
  @media (min-width: 576px) {
    .block-grid { --grid-current-columns: var(--grid-columns-sm, var(--grid-columns-xs, var(--grid-columns-mobile))); }
  }
  @media (min-width: 768px) {
    .block-grid {
      --grid-current-columns: var(--grid-columns-md, var(--grid-columns-desktop));
      width: var(--grid-width);
      column-gap: var(--grid-gap-horizontal);
      row-gap: var(--grid-gap-vertical);
      padding-block: var(--grid-padding-top) var(--grid-padding-bottom);
    }
  }
  @media (min-width: 992px) {
    .block-grid { --grid-current-columns: var(--grid-columns-lg, var(--grid-columns-md, var(--grid-columns-desktop))); }
  }
  @media (min-width: 1200px) {
    .block-grid { --grid-current-columns: var(--grid-columns-xl, var(--grid-columns-lg, var(--grid-columns-md, var(--grid-columns-desktop)))); }
  }
  @media (min-width: 1400px) {
    .block-grid { --grid-current-columns: var(--grid-columns-xxl, var(--grid-columns-xl, var(--grid-columns-lg, var(--grid-columns-md, var(--grid-columns-desktop))))); }
  }
  @media (max-width: 767.98px) {
    .block-grid--swipe-mobile {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - (var(--grid-current-columns) - 1) * var(--grid-gap-horizontal-mobile)) / var(--grid-current-columns));
      row-gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-inline: contain;
    }
    .block-grid--swipe-mobile > .block-column { scroll-snap-align: start; }
  }
{% endstylesheet %}
