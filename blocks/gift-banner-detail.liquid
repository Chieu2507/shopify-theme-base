{% doc %}
  Renders one repeatable gifting detail for the Gift banner.
{% enddoc %}

{% if block.settings.heading != blank or block.settings.text != blank %}
  <article class="gift-banner__detail gift-banner__detail--number-{{ block.settings.number_size }} gift-banner__detail--heading-{{ block.settings.heading_size }} gift-banner__detail--text-{{ block.settings.text_size }}" {{ block.shopify_attributes }} data-reveal-item>
    {% if block.settings.number != blank %}
      <p class="gift-banner__detail-number">{{ block.settings.number | escape }}</p>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h3 class="gift-banner__detail-heading">{{ block.settings.heading | escape }}</h3>
    {% endif %}
    {% if block.settings.text != blank %}
      <div class="gift-banner__detail-text rte">{{ block.settings.text }}</div>
    {% endif %}
  </article>
{% endif %}

{% schema %}
{
  "name": "Gift banner detail",
  "tag": null,
  "settings": [
    { "type": "text", "id": "number", "label": "Number", "default": "01" },
    { "type": "select", "id": "number_size", "label": "Number size", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "medium" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The case" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "medium" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Espresso leather, oxblood velvet.</p>" },
    { "type": "select", "id": "text_size", "label": "Text size", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "medium" }
  ],
  "presets": [
    { "name": "Gift banner detail" }
  ]
}
{% endschema %}
