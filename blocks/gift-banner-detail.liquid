{% doc %}
  Renders one fixed gifting detail for the Gift banner.
{% enddoc %}

{% if block.settings.heading != blank or block.settings.text != blank %}
  <article class="gift-banner__detail" {{ block.shopify_attributes }} data-reveal-item>
    {% if block.settings.number != blank %}
      <p class="gift-banner__detail-number">{{ block.settings.number | escape }}</p>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h3 class="gift-banner__detail-heading">{{ block.settings.heading | escape }}</h3>
    {% endif %}
    {% if block.settings.text != blank %}
      <div class="gift-banner__detail-text rte">{{ block.settings.text }}</div>
    {% endif %}
  </article>
{% endif %}

{% schema %}
{
  "name": "Gift banner detail",
  "tag": null,
  "settings": [
    { "type": "text", "id": "number", "label": "Number", "default": "01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The case" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Espresso leather, oxblood velvet.</p>" }
  ],
  "presets": [
    { "name": "Gift banner detail" }
  ]
}
{% endschema %}
