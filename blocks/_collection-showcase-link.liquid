{% doc %}
  Defines one collection entry for the theme-block collection showcase.

  The parent section renders each entry in both the navigation list and media
  slider so both regions stay synchronized.
{% enddoc %}

{% schema %}
{
  "name": "Collection entry",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Panel image",
      "info": "Overrides the collection image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "focal_point",
      "label": "Image focal point",
      "default": "center center",
      "info": "CSS object-position, for example: 50% 40%."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Custom title"
    },
    {
      "type": "text",
      "id": "count",
      "label": "Custom count",
      "info": "Leave blank to use the collection's current product count."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Custom link"
    }
  ],
  "presets": [
    {
      "name": "Collection entry"
    }
  ]
}
{% endschema %}
