{% doc %}
  Renders one linked collection thumbnail for the Collection list: Thumbnails
  section. The selected collection owns its destination, title, and default
  image; an optional image override is available for campaign artwork.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign thumbnail_collection = block.settings.collection
  assign thumbnail_image = block.settings.image | default: thumbnail_collection.featured_image
  assign thumbnail_title = thumbnail_collection.title | default: 'collection_list.default_title' | t
  assign thumbnail_ratio = block.settings.image_ratio | default: 'square'
  unless thumbnail_ratio == 'square' or thumbnail_ratio == 'portrait' or thumbnail_ratio == 'landscape'
    assign thumbnail_ratio = 'square'
  endunless
%}

{% if thumbnail_collection != blank %}
  <a
    class="collection-thumbnail collection-thumbnail--{{ thumbnail_ratio }}"
    href="{{ thumbnail_collection.url }}"
    {{ block.shopify_attributes }}
  >
{% else %}
  <div class="collection-thumbnail collection-thumbnail--{{ thumbnail_ratio }}" {{ block.shopify_attributes }}>
{% endif %}
  <div class="collection-thumbnail__media{% if thumbnail_image == blank %} placeholder-image{% endif %}">
    {% if thumbnail_image != blank %}
      {{ thumbnail_image | image_url: width: 800 | image_tag: widths: '180, 240, 320, 480, 640, 800', sizes: '(max-width: 767.98px) calc((100vw - 48px) / var(--collection-thumbnails-columns-mobile)), calc((min(100vw, var(--page-width)) - 96px) / var(--collection-thumbnails-columns))', alt: thumbnail_title }}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
  <h3 class="collection-thumbnail__title">{{ thumbnail_title | escape }}</h3>
{% if thumbnail_collection != blank %}
  </a>
{% else %}
  </div>
{% endif %}

{% stylesheet %}
  .collection-thumbnail {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: var(--collection-thumbnails-title-gap, 12px);
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .collection-thumbnail__media {
    width: 100%;
    overflow: hidden;
    border-radius: var(--collection-thumbnails-image-radius, 50%);
    background: var(--background-color);
    aspect-ratio: 1;
  }

  .collection-thumbnail--portrait .collection-thumbnail__media { aspect-ratio: 3 / 4; }
  .collection-thumbnail--landscape .collection-thumbnail__media { aspect-ratio: 4 / 3; }

  .collection-thumbnail__media img,
  .collection-thumbnail__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-duration-medium, 250ms) ease;
  }

  .collection-thumbnail:hover .collection-thumbnail__media img,
  .collection-thumbnail:focus-visible .collection-thumbnail__media img {
    transform: scale(1.04);
  }

  .collection-thumbnail:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .collection-thumbnail__title {
    margin: 0;
    overflow-wrap: anywhere;
    font: inherit;
    font-weight: var(--font-heading-weight, 500);
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-thumbnail__media img { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "tag": null,
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:general.collection" },
    { "type": "image_picker", "id": "image", "label": "t:general.image", "info": "Uses the collection image when left blank." },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "landscape", "label": "t:options.image_ratio.landscape" }
      ],
      "default": "square"
    }
  ],
  "presets": [{ "name": "t:general.collection" }]
}
{% endschema %}
