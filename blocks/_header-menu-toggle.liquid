<button
  class="header-menu-toggle btn btn--unstyled"
  type="button"
  aria-expanded="false"
  aria-controls="HeaderMenu-{{ section.id }}"
  aria-label="Open menu"
  data-header-menu-toggle
  {{ block.shopify_attributes }}
>
  <span class="icon header-menu-toggle__open-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" focusable="false">
      <path d="M4 7.5h16M4 12h16M4 16.5h16" stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" />
    </svg>
  </span>
  <span class="icon header-menu-toggle__close-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" focusable="false">
      <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" />
    </svg>
  </span>
  <span class="visually-hidden">Menu</span>
</button>

{% stylesheet %}
  .header-menu-toggle.btn {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: var(--button-height);
    min-width: var(--button-height);
    min-height: var(--button-height);
    color: var(--body-color);
  }

  .header-menu-toggle .icon {
    display: inline-flex;
    width: var(--header-icon-size, var(--icon-size-large));
    height: var(--header-icon-size, var(--icon-size-large));
  }

  .header-menu-toggle .icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .header-menu-toggle__close-icon {
    display: none !important;
  }

  .header-top--menu-open .header-menu-toggle__open-icon {
    display: none !important;
  }

  .header-top--menu-open .header-menu-toggle__close-icon {
    display: inline-flex !important;
  }

  @media (max-width: 767.98px) {
    .header-menu-toggle.btn {
      display: inline-flex;
      order: -1;
      width: var(--button-height-mobile);
      min-width: var(--button-height-mobile);
      min-height: var(--button-height-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header_menu_toggle",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "t:general.header_menu_toggle",
      "category": "t:general.header"
    }
  ]
}
{% endschema %}
