{% liquid
  assign menu_toggle_icon = block.settings.icon | default: 'bars-3'
  unless menu_toggle_icon == 'bars-3' or menu_toggle_icon == 'menu' or menu_toggle_icon == 'grip-vertical'
    assign menu_toggle_icon = 'bars-3'
  endunless

  assign menu_toggle_icon_size = block.settings.icon_size | plus: 0
  assign menu_toggle_has_custom_icon_size = false
  if block.settings.icon_size != blank and menu_toggle_icon_size >= 8 and menu_toggle_icon_size <= 48
    assign menu_toggle_has_custom_icon_size = true
  endif
%}

<button
  class="header-menu-toggle btn btn--unstyled"
  type="button"
  aria-expanded="false"
  aria-controls="HeaderMobileDrawer-{{ section.id }}"
  aria-label="Open menu"
  {% if menu_toggle_has_custom_icon_size %}style="--header-menu-toggle-icon-size: {{ menu_toggle_icon_size }}px;"{% endif %}
  data-header-menu-toggle
  {{ block.shopify_attributes }}
>
  <span class="icon header-menu-toggle__open-icon" aria-hidden="true">
    {% render 'icon', icon: menu_toggle_icon, bare: true %}
  </span>
  <span class="icon header-menu-toggle__close-icon" aria-hidden="true">
    {% render 'icon', icon: 'x-mark', bare: true %}
  </span>
  <span class="visually-hidden">Menu</span>
</button>

{% stylesheet %}
  .header-menu-toggle.btn {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: var(--button-height);
    min-width: var(--button-height);
    min-height: var(--button-height);
    color: var(--body-color);
  }

  .header-menu-toggle .icon {
    display: inline-flex;
    width: var(--header-menu-toggle-icon-size, var(--header-icon-size, var(--icon-size-medium)));
    height: var(--header-menu-toggle-icon-size, var(--header-icon-size, var(--icon-size-medium)));
  }

  .header-menu-toggle .icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .header-menu-toggle__close-icon {
    display: none !important;
  }

  .header-top--menu-open .header-menu-toggle__open-icon {
    display: none !important;
  }

  .header-top--menu-open .header-menu-toggle__close-icon {
    display: inline-flex !important;
  }

  @media (max-width: 991.98px) {
    .header-menu-toggle.btn {
      display: inline-flex;
      width: 24px;
      min-width: 24px;
      height: 24px;
      min-height: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header_menu_toggle",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Choose icon",
      "options": [
        { "value": "bars-3", "label": "Menu" },
        { "value": "menu", "label": "Alternative menu" },
        { "value": "grip-vertical", "label": "Grip" }
      ],
      "default": "bars-3"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:general.header_menu_toggle",
      "category": "t:general.header"
    }
  ]
}
{% endschema %}
