{% doc %}
  Renders a media-led panel for the Sticky scroll section. The background media
  belongs to the panel while editorial copy reuses the shared Block Kernels.
{% enddoc %}

{% liquid
  assign panel_image = block.settings.image | default: block.settings.mobile_image
  assign panel_alt = block.settings.alt | default: panel_image.alt
  assign panel_index = 0
  for section_block in section.blocks
    if section_block.id == block.id
      assign panel_index = forloop.index0
      break
    endif
  endfor
  assign panel_number = panel_index | plus: 1
  if panel_number < 10
    assign panel_number = panel_number | prepend: '0'
  endif
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if panel_index == 0 and section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
%}

<article
  class="sticky-scroll__panel"
  data-sticky-scroll-panel
  data-sticky-scroll-index="{{ panel_index }}"
  style="--sticky-scroll-content-width: {{ block.settings.content_width }}px; --sticky-scroll-content-gap: {{ block.settings.content_gap }}px; --sticky-scroll-image-position: {{ block.settings.image_position }};"
  {{ block.shopify_attributes }}
>
  <div class="sticky-scroll__media">
    {% render 'responsive-media',
      image: panel_image,
      mobile_image: block.settings.mobile_image,
      mobile_breakpoint: 767,
      max_width: 2400,
      mobile_max_width: 1280,
      widths: '750, 960, 1200, 1600, 1920, 2400',
      mobile_widths: '375, 550, 750, 960, 1280',
      sizes: '100vw',
      class: 'sticky-scroll__image',
      loading: image_loading,
      fetchpriority: image_priority,
      alt: panel_alt,
      placeholder_asset: 'lifestyle-1',
      placeholder_class: 'sticky-scroll__placeholder'
    %}
  </div>

  <div class="sticky-scroll__overlay" aria-hidden="true"></div>

  <div class="sticky-scroll__content-positioner">
    <div class="sticky-scroll__content" data-sticky-scroll-content>
      {% content_for 'blocks' %}
    </div>
  </div>

  <span class="sticky-scroll__ghost-number" aria-hidden="true">{{ panel_number }}</span>
</article>

{% schema %}
{
  "name": "Sticky scroll panel",
  "tag": null,
  "blocks": [
    { "type": "label" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" },
    { "type": "spacer" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 280,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Sticky scroll panel",
      "category": "Editorial content",
      "blocks": [
        { "type": "label", "settings": { "text": "<p>THE COLLECTION</p>", "reveal_type": "none" } },
        { "type": "heading", "settings": { "heading": "<h2>Beauty in Every<br>Detail.</h2>", "type_preset": "h2", "reveal_type": "none" } },
        { "type": "text", "settings": { "text": "<p>Every piece begins as a study in proportion, material and light.</p>", "type_preset": "sm", "reveal_type": "none" } },
        { "type": "button", "settings": { "label": "Shop the collection", "link": "/collections/all", "style": "tertiary", "icon": "arrow-right", "reveal_type": "none" } }
      ]
    }
  ]
}
{% endschema %}
