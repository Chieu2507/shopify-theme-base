{% doc %}
  Renders the first article as a featured blog post with optional content.
{% enddoc %}

{% assign blog_source = section.settings.blog | default: blog %}
{% assign featured_article = blog_source.articles | first %}
{% assign featured_radius = 'var(--radius-square)' %}
{% if block.settings.corner_radius == 'rounded' %}{% assign featured_radius = 'var(--radius-rounded)' %}{% endif %}
{% assign featured_shadow = 'none' %}
{% if block.settings.shadow == 'small' %}{% assign featured_shadow = '0 2px 8px rgb(0 0 0 / 0.12)' %}{% elsif block.settings.shadow == 'medium' %}{% assign featured_shadow = '0 8px 24px rgb(0 0 0 / 0.16)' %}{% endif %}
{% assign featured_content_align = 'start' %}
{% if block.settings.alignment == 'center' %}{% assign featured_content_align = 'center' %}{% elsif block.settings.alignment == 'right' %}{% assign featured_content_align = 'end' %}{% endif %}
{% if featured_article %}
  <article
    class="blog-featured-post blog-featured-post--height-{{ block.settings.height | default: 'large' }} {{ block.settings.color_scheme | default: 'scheme-1' }}"
    style="--blog-featured-gap: {{ block.settings.desktop_gap }}px; --blog-featured-gap-mobile: {{ block.settings.mobile_gap }}px; --blog-featured-border: {{ block.settings.border_thickness }}px; --blog-featured-radius: {{ featured_radius }}; --blog-featured-shadow: {{ featured_shadow }};"
    {{ block.shopify_attributes }}
  >
    {% if featured_article.image %}
      <a class="blog-featured-post__media" href="{{ featured_article.url }}" aria-label="{{ featured_article.title | escape }}">
        {{ featured_article.image | image_url: width: 1600 | image_tag: loading: 'lazy' }}
      </a>
    {% endif %}
    <div class="blog-featured-post__content" style="--blog-card-padding-top: {{ block.settings.padding_top }}px; --blog-card-padding-bottom: {{ block.settings.padding_bottom }}px; --blog-card-padding-left: {{ block.settings.padding_left }}px; --blog-card-padding-right: {{ block.settings.padding_right }}px; --text-align-default: {{ block.settings.alignment }}; --blog-featured-content-align: {{ featured_content_align }};">
      {% if block.settings.show_meta %}
        <p class="blog-featured-post__meta">
          {% if block.settings.show_date %}{{ featured_article.published_at | time_tag: format: 'date' }}{% endif %}
          {% if block.settings.show_date and block.settings.show_tag and featured_article.tags != blank %} | {% endif %}
          {% if block.settings.show_tag and featured_article.tags != blank %}{{ featured_article.tags | first | escape }}{% endif %}
        </p>
      {% endif %}
      <div class="blog-featured-post__body">
        {% if block.settings.show_title %}
          <h2 class="blog-card__title blog-card__title--{{ block.settings.title_size }}"><a href="{{ featured_article.url }}">{{ featured_article.title | escape }}</a></h2>
        {% endif %}
        {% if block.settings.show_description and featured_article.content != blank %}
          <div class="blog-card__description">{{ featured_article.content | strip_html | truncatewords: block.settings.description_words }}</div>
        {% endif %}
        {% if block.settings.show_excerpt and featured_article.excerpt != blank %}
          <div class="blog-card__description">{{ featured_article.excerpt | strip_html | truncatewords: block.settings.description_words }}</div>
        {% endif %}
        {% if block.settings.show_button %}
          {% render 'theme-button', label: block.settings.button_label, url: featured_article.url, variant: block.settings.button_style, icon: 'arrow', class: 'blog-card__button' %}
        {% endif %}
      </div>
    </div>
  </article>
{% elsif request.design_mode %}
  <div class="blog-posts__empty" {{ block.shopify_attributes }}>Add articles to this blog to preview the featured post.</div>
{% endif %}

{% stylesheet %}
  .blog-featured-post {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--blog-featured-gap, 8px);
    overflow: hidden;
    border: var(--blog-featured-border, 0px) solid var(--border-color);
    border-radius: var(--blog-featured-radius, var(--radius-square));
    background: var(--blog-featured-background, transparent);
    box-shadow: var(--blog-featured-shadow, none);
  }
  .blog-featured-post__media { display: block; aspect-ratio: 3 / 2; overflow: hidden; }
  .blog-featured-post--height-small .blog-featured-post__media { aspect-ratio: auto; height: 240px; }
  .blog-featured-post--height-medium .blog-featured-post__media { aspect-ratio: auto; height: 320px; }
  .blog-featured-post--height-large .blog-featured-post__media { aspect-ratio: auto; height: 420px; }
  .blog-featured-post--height-extra-large .blog-featured-post__media { aspect-ratio: auto; height: 520px; }
  .blog-featured-post__media img { width: 100%; height: 100%; object-fit: cover; }
  .blog-featured-post__content { display: flex; flex-direction: column; justify-content: space-between; align-items: var(--blog-featured-content-align, flex-start); min-height: 100%; padding: var(--blog-card-padding-top) var(--blog-card-padding-right) var(--blog-card-padding-bottom) var(--blog-card-padding-left); text-align: var(--blog-posts-align, left); }
  .blog-featured-post__meta, .blog-featured-post__body { width: 100%; }
  .blog-featured-post__meta { margin: 0; font-size: var(--font-body-sm); line-height: 1.3; color: var(--text-color); opacity: 0.55; }
  .blog-featured-post__body { display: grid; justify-items: var(--blog-featured-content-align, start); gap: 0.75rem; }
  .blog-card__title { max-width: 22ch; margin: 0; overflow-wrap: anywhere; font-size: clamp(2rem, 3vw, 3rem); line-height: 1.08; letter-spacing: -0.02em; }
  .blog-card__title a { color: inherit; text-decoration: none; }
  .blog-card__title--h1 { font-size: var(--font-heading-display); line-height: var(--font-heading-display-line-height); }
  .blog-card__title--h2 { font-size: var(--font-heading-xl); line-height: var(--font-heading-xl-line-height); }
  .blog-card__title--h3 { font-size: var(--font-heading-lg); line-height: var(--font-heading-lg-line-height); }
  .blog-card__meta { margin: 0 0 0.75rem; font-size: var(--font-body-sm); color: var(--text-color); }
  .blog-card__description { color: var(--body-color); }
  @media (max-width: 767.98px) {
    .blog-featured-post { grid-template-columns: 1fr; gap: var(--blog-featured-gap-mobile, 8px); min-height: 0; }
    .blog-featured-post__media { display: block; aspect-ratio: 4 / 3; height: auto !important; }
    .blog-featured-post__content { min-height: 0; justify-content: start; padding: 24px 0 32px; }
    .blog-featured-post__meta { margin-bottom: 16px; text-align: left; }
    .blog-featured-post__body { justify-items: start; gap: 28px; text-align: left; }
    .blog-card__title { font-size: clamp(1.75rem, 7vw, 2.25rem); line-height: 1.08; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured post",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "height", "label": "Media height", "options": [ { "value": "adapt", "label": "Adapt to image" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }, { "value": "extra-large", "label": "Extra large" } ], "default": "large" },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "range", "id": "desktop_gap", "label": "Desktop gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 8 },
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "border_thickness", "label": "Border thickness", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 0 },
    { "type": "select", "id": "corner_radius", "label": "Corner radius", "options": [ { "value": "inherit", "label": "Inherit" }, { "value": "square", "label": "Square" }, { "value": "rounded", "label": "Rounded" } ], "default": "inherit" },
    { "type": "select", "id": "shadow", "label": "Shadow", "options": [ { "value": "none", "label": "None" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" } ], "default": "none" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_meta", "label": "Show meta", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true, "visible_if": "{{ block.settings.show_meta }}" },
    { "type": "checkbox", "id": "show_tag", "label": "Show tag", "default": true, "visible_if": "{{ block.settings.show_meta }}" },
    { "type": "checkbox", "id": "show_title", "label": "Show title", "default": true },
    { "type": "select", "id": "title_size", "label": "Title size", "options": [ { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" } ], "default": "h2", "visible_if": "{{ block.settings.show_title }}" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": false },
    { "type": "range", "id": "description_words", "label": "Description words", "min": 5, "max": 50, "step": 1, "default": 20, "visible_if": "{{ block.settings.show_description }}" },
    { "type": "checkbox", "id": "show_excerpt", "label": "Excerpt", "default": false },
    { "type": "checkbox", "id": "show_button", "label": "Show button", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more", "visible_if": "{{ block.settings.show_button }}" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [ { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "tertiary", "label": "Tertiary" } ], "default": "tertiary", "visible_if": "{{ block.settings.show_button }}" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_left", "label": "Left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_right", "label": "Right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 50 }
  ],
  "presets": [
    {
      "name": "Featured post",
      "category": "Blog"
    }
  ]
}
{% endschema %}
