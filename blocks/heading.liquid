{% doc %}
  Renders a reusable heading theme block.

  @example
  {% content_for 'block', type: 'heading', id: 'heading' %}
{% enddoc %}

{% if block.settings.heading != blank %}
  <{{ block.settings.heading_tag }}
    class="content-heading omnise-heading--{{ block.settings.heading_size }} heading--{{ block.settings.heading_size }} content-heading--{{ block.settings.alignment }}"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.heading }}
  </{{ block.settings.heading_tag }}>
{% endif %}

{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Tell your story"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "XX-large"
        },
        {
          "value": "h2",
          "label": "X-large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Heading"
    }
  ]
}
{% endschema %}
