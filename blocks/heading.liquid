{% doc %}
  Renders a reusable heading theme block with preset typography.

  @example
  {% content_for 'block', type: 'heading', id: 'heading' %}
{% enddoc %}

{% render 'content-block',
  block: block,
  content: block.settings.heading,
  kind: 'heading',
  default_preset: 'h2',
  default_font: 'heading'
%}

{% schema %}
{
  "name": "t:typography_blocks.heading",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:typography_blocks.typography"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:typography_blocks.text",
      "default": "t:typography_defaults.heading"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:typography_blocks.preset",
      "options": [
        { "value": "paragraph", "label": "t:typography_options.paragraph" },
        { "value": "subheading", "label": "t:typography_options.subheading" },
        { "value": "h1", "label": "t:typography_options.h1" },
        { "value": "h2", "label": "t:typography_options.h2" },
        { "value": "h3", "label": "t:typography_options.h3" },
        { "value": "h4", "label": "t:typography_options.h4" },
        { "value": "h5", "label": "t:typography_options.h5" },
        { "value": "h6", "label": "t:typography_options.h6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:typography_blocks.color",
      "options": [
        { "value": "text", "label": "t:typography_options.text" },
        { "value": "subtext", "label": "t:typography_options.subtext" }
      ],
      "default": "text"
    },
    {
      "type": "checkbox",
      "id": "disable_line_break_mobile",
      "label": "t:typography_blocks.disable_line_break_mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "t:typography_blocks.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:typography_blocks.width",
      "options": [
        { "value": "fit-content", "label": "t:typography_options.fit" },
        { "value": "100%", "label": "t:typography_options.fill" }
      ],
      "default": "fit-content"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:typography_blocks.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:typography_options.fit" },
        { "value": "100%", "label": "t:typography_options.fill" }
      ],
      "default": "fit-content"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:typography_blocks.alignment",
      "default": "left",
      "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
    },
    {
      "type": "header",
      "content": "t:typography_blocks.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:typography_blocks.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:typography_blocks.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:typography_blocks.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:typography_blocks.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:typography_blocks.heading",
      "category": "t:typography_blocks.basic",
      "settings": {
        "heading": "t:typography_defaults.heading",
        "type_preset": "h2"
      }
    },
    {
      "name": "t:names.subheading",
      "category": "t:typography_blocks.basic",
      "settings": {
        "heading": "t:typography_defaults.subheading",
        "type_preset": "subheading"
      }
    }
  ]
}
{% endschema %}
