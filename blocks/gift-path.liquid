{% doc %}
  Stores one occasion and its own product picker for the Gift Spinel section.
  The parent section renders the tab and product cards; this block has no
  nested content blocks or bundle action.
{% enddoc %}

{% schema %}
{
  "name": "Gift path",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Gift path" },
    { "type": "paragraph", "content": "Select up to 3 products for this occasion's edit." },
    { "type": "header", "content": "Occasion" },
    { "type": "select", "id": "occasion", "label": "Occasion", "options": [{ "value": "birthday", "label": "Birthday" }, { "value": "anniversary", "label": "Anniversary" }, { "value": "engagement", "label": "Engagement" }, { "value": "just-because", "label": "Just Because" }] },
    { "type": "text", "id": "occasion_label", "label": "Occasion label", "info": "Optional. If blank, the label follows the block order." },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 3, "info": "Products selected here are rendered only for this Gift path." }
  ],
  "presets": [
    {
      "name": "Gift path",
      "category": "Gifting"
    }
  ]
}
{% endschema %}
