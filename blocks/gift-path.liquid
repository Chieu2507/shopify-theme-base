{% doc %}
  Renders one occasion tab panel and its own product picker for Gift Spinel.
  Product cards are kept in this block so product_list values are resolved in
  the same block context as the Theme Editor setting.
{% enddoc %}

{% liquid
  assign path_products = block.settings.products
  assign rendered_product_count = 0
%}

<ul class="gift-spinel__product-cards" role="list" {{ block.shopify_attributes }}>
  {% for card_product in path_products limit: 3 %}
    <li class="gift-spinel__product-card">
      <div class="gift-spinel__product-card-reveal">
        {% render 'product-card',
          product: card_product,
          media_ratio: 'landscape',
          show_badges: false,
          show_variant_dots: false,
          show_media_actions: false,
          show_quick_add: false,
          enable_quick_view: false,
          show_currency_code: false,
          loading: 'lazy',
          sizes: '(min-width: 993px) 30vw, (min-width: 768px) 32vw, 86vw'
        %}
      </div>
    </li>
    {% assign rendered_product_count = rendered_product_count | plus: 1 %}
  {% endfor %}

  {% for placeholder_index in (1..3) %}
    {% if rendered_product_count < 3 %}
      <li class="gift-spinel__product-card" aria-hidden="true">
        <div class="gift-spinel__product-card-reveal">
          {% render 'product-card',
            show_badges: false,
            show_variant_dots: false,
            show_media_actions: false,
            show_quick_add: false,
            enable_quick_view: false,
            show_currency_code: false,
            placeholder_index: placeholder_index,
            media_ratio: 'landscape',
            sizes: '(min-width: 993px) 30vw, (min-width: 768px) 32vw, 86vw'
          %}
        </div>
      </li>
      {% assign rendered_product_count = rendered_product_count | plus: 1 %}
    {% endif %}
  {% endfor %}
</ul>

{% schema %}
{
  "name": "Gift path",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Gift path" },
    { "type": "paragraph", "content": "Select up to 3 products for this occasion's edit." },
    { "type": "text", "id": "occasion_label", "label": "Tab label", "info": "Optional. If blank, the label follows the block order." },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 3, "info": "Products selected here are rendered only for this Gift path." }
  ],
  "presets": [
    {
      "name": "Gift path",
      "category": "Gifting"
    }
  ]
}
{% endschema %}
