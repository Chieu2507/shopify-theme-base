{% doc %}
  Stores one occasion's collection data for the Gift Spinel section.
  The parent section renders this block through the shared Feature Collection
  product-card pattern, so this block intentionally has no legacy Gift Finder
  markup of its own.
{% enddoc %}

{% schema %}
{
  "name": "Gift path",
  "tag": null,
  "blocks": [
    { "type": "label" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" }
  ],
  "settings": [
    { "type": "header", "content": "Gift path" },
    { "type": "paragraph", "content": "Select a featured collection for this occasion's edit." },
    { "type": "header", "content": "Occasion" },
    { "type": "select", "id": "occasion", "label": "Occasion", "options": [{ "value": "birthday", "label": "Birthday" }, { "value": "anniversary", "label": "Anniversary" }, { "value": "engagement", "label": "Engagement" }, { "value": "just-because", "label": "Just Because" }] },
    { "type": "text", "id": "occasion_label", "label": "Occasion label", "info": "Optional label shown in the occasion tabs." },
    { "type": "header", "content": "Legacy recipient" },
    { "type": "select", "id": "recipient", "label": "Recipient", "options": [{ "value": "partner", "label": "Partner" }, { "value": "mother", "label": "Mother" }, { "value": "friend", "label": "Friend" }, { "value": "myself", "label": "Myself" }], "default": "partner", "info": "Retained for compatibility with existing Gift Spinel settings." },
    { "type": "text", "id": "recipient_label", "label": "Legacy display label", "default": "Gift path", "info": "Used as a fallback when Occasion label is blank." },
    { "type": "collection", "id": "collection", "label": "Featured collection", "info": "Rendered by the Gift Spinel feature collection band." },
    { "type": "product_list", "id": "products", "label": "Products fallback", "limit": 4, "info": "Used when no featured collection is selected." },
    { "type": "header", "content": "Legacy bundle settings" },
    { "type": "paragraph", "content": "These settings are retained for compatibility with previously saved Gift Spinel data and are not rendered by the new editorial layout." },
    { "type": "range", "id": "bundle_discount_percentage", "label": "Bundle discount", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 15, "info": "Retained for compatibility." },
    { "type": "text", "id": "bundle_discount_message", "label": "Discount message", "default": "Add this complete gift edit to receive your bundle discount." }
  ],
  "presets": [
    {
      "name": "Gift path",
      "category": "Gifting",
      "blocks": [
        { "type": "label", "settings": { "text": "<p>Your curated gift edit</p>" } },
        { "type": "heading", "settings": { "heading": "<h2>A thoughtful edit, chosen with care.</h2>", "type_preset": "h4" } },
        { "type": "text", "settings": { "text": "<p>Chosen for its quiet symbolism and made to become part of their everyday ritual.</p>", "type_preset": "sm" } },
        { "type": "button", "settings": { "label": "Explore this gift edit", "style": "primary", "icon": "arrow-right" } }
      ]
    }
  ]
}
{% endschema %}
