{% assign product = closest.product | default: product %}
{% if product.description != blank %}<div class="product-description rte product-description--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ product.description }}</div>{% endif %}
{% schema %}
{
  "name": "Product description",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Description style",
      "options": [
        {
          "value": "full",
          "label": "Full description"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ],
      "default": "full"
    }
  ]
}
{% endschema %}
