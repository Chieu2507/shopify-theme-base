{% doc %}
  Renders the article comments list and comment form when comments are enabled.
{% enddoc %}

{% assign comments_heading_tag = block.settings.html_heading_tag | default: 'h2' %}
<section class="article-comments article-comments--{{ block.settings.width | default: 'default' }}" style="--article-comments-padding-top: {{ block.settings.padding_top }}px; --article-comments-padding-bottom: {{ block.settings.padding_bottom }}px; --article-comments-padding-top-mobile: {% if block.settings.custom_mobile_padding %}{{ block.settings.padding_top_mobile }}{% else %}{{ block.settings.padding_top }}{% endif %}px; --article-comments-padding-bottom-mobile: {% if block.settings.custom_mobile_padding %}{{ block.settings.padding_bottom_mobile }}{% else %}{{ block.settings.padding_bottom }}{% endif %}px;" {{ block.shopify_attributes }}>
  {% if blog.comments_enabled? %}
    <div class="article-comments__container">
      <{{ comments_heading_tag }} class="article-comments__title heading-text heading-{{ block.settings.heading_size | default: 'h3' }}">Leave a comment</{{ comments_heading_tag }}>
    {% paginate article.comments by 10 %}
      <div id="comments" class="article-comments__list">
        {% for comment in article.comments %}
          <article class="article-comment">
            <p class="article-comment__author">{{ comment.author | escape }}</p>
            <p class="article-comment__date">{{ comment.created_at | time_tag: format: 'date' }}</p>
            <div class="article-comment__content">{{ comment.content }}</div>
          </article>
        {% endfor %}
      </div>
      {{ paginate | default_pagination: anchor: 'comments' }}
    {% endpaginate %}
    {% form 'new_comment', article, class: 'article-comments__native-form' %}
      {% if form.errors %}<div class="article-comments__error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      {% if form.posted_successfully? %}<p role="status">Comment posted successfully.</p>{% endif %}
      <div class="article-comments__form">
        <div class="article-comments__field">
          <label class="visually-hidden" for="comment-author">{{ 'blog.comment_form_name' | t }}</label>
          <input id="comment-author" type="text" name="comment[author]" value="{{ form.author | escape }}" placeholder="{{ block.settings.name_placeholder | default: 'Name' | escape }}" required>
        </div>
        <div class="article-comments__field">
          <label class="visually-hidden" for="comment-email">{{ 'blog.comment_form_email' | t }}</label>
          <input id="comment-email" type="email" name="comment[email]" value="{{ form.email | escape }}" placeholder="{{ block.settings.email_placeholder | default: 'Email' | escape }}" required>
        </div>
        <div class="article-comments__field article-comments__field--body">
          <label class="visually-hidden" for="comment-body">{{ 'blog.comment_form_body' | t }}</label>
          <textarea id="comment-body" name="comment[body]" placeholder="{{ block.settings.comment_placeholder | default: 'Comment' | escape }}" required>{{ form.body | escape }}</textarea>
        </div>
        <p class="article-comments__note">Please note, comments need to be approved before they are published.</p>
        <button class="btn btn--primary" type="submit">POST COMMENT</button>
      </div>
      {% endform %}
    </div>
  {% elsif request.design_mode %}
    <p class="article-comments__empty">Comments are disabled for this blog.</p>
  {% endif %}
</section>

{% stylesheet %}
  .article-comments { width: 100vw; margin-inline: calc(50% - 50vw); padding-top: var(--article-comments-padding-top, 80px); padding-bottom: var(--article-comments-padding-bottom, 80px); background: var(--color-background, #fff); }
  .article-comments__container { display: flex; flex-direction: column; align-items: center; gap: 40px; width: min(calc(100% - 32px), 1600px); min-height: 283px; margin-inline: auto; }
  .article-comments--default .article-comments__container { width: min(calc(100% - 32px), 1260px); }
  .article-comments--page .article-comments__container { width: min(calc(100% - 32px), var(--page-width, 1600px)); }
  .article-comments--full .article-comments__container { width: calc(100% - 32px); max-width: none; }
  .article-comments--full .article-comments__native-form { width: 100%; }
  .article-comments__title { width: 100%; margin: 0; text-align: center; }
  .article-comments__list { display: grid; gap: 1.5rem; width: 100%; }
  .article-comment { padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); }
  .article-comment p { margin: 0; }
  .article-comment__author { font-weight: 600; }
  .article-comment__date { color: var(--body-color); font-size: var(--font-body-sm); }
  .article-comment__content { margin-top: 0.75rem; }
  .article-comments__native-form { width: min(calc(100% - 32px), 1260px); max-width: 100%; margin: 0; }
  .article-comments__form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 12px; row-gap: 20px; width: 100%; }
  .article-comments__field { display: grid; gap: 8px; }
  .article-comments__field--body { grid-column: 1 / -1; }
  .article-comments__form input, .article-comments__form textarea { box-sizing: border-box; width: 100%; border: 1px solid #e6e6e6; border-radius: 0; background: transparent; }
  .article-comments__form input { border-radius: 0 !important; }
  .article-comments__form input { min-height: 44px; padding: 0 12px; }
  .article-comments__form textarea { min-height: 148px; padding: 12px; resize: vertical; }
  .article-comments__note { grid-column: 1 / -1; margin: 0; color: var(--body-color); font-size: var(--font-body-sm); text-align: left; }
  .article-comments__form .btn { grid-column: 1 / -1; justify-self: center; }
  @media (max-width: 767.98px) {
    .article-comments { width: 100%; margin-inline: 0; padding-top: var(--article-comments-padding-top-mobile, var(--article-comments-padding-top, 80px)); padding-bottom: var(--article-comments-padding-bottom-mobile, var(--article-comments-padding-bottom, 80px)); }
    .article-comments__container { gap: 24px; width: 100%; max-width: 100%; box-sizing: border-box; }
    .article-comments__native-form { width: 100%; min-width: 0; }
    .article-comments__form { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 12px; row-gap: 16px; }
    .article-comments__field { min-width: 0; }
    .article-comments__field--body { grid-column: 1 / -1; }
    .article-comments__form .btn { grid-column: 1 / -1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comments",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "width", "label": "Width", "options": [{ "value": "default", "label": "Default" }, { "value": "page", "label": "Page" }, { "value": "full", "label": "Full" }], "default": "default" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" }, { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "h5", "label": "Heading 5" }, { "value": "h6", "label": "Heading 6" }], "default": "h3" },
    { "type": "select", "id": "html_heading_tag", "label": "HTML Heading tag", "options": [{ "value": "p", "label": "Paragraph" }, { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "h4", "label": "H4" }, { "value": "h5", "label": "H5" }, { "value": "h6", "label": "H6" }], "default": "h2" },
    { "type": "header", "content": "Form fields" },
    { "type": "text", "id": "name_placeholder", "label": "Name placeholder", "default": "Name" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Email" },
    { "type": "text", "id": "comment_placeholder", "label": "Comment placeholder", "default": "Comment" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80 },
    { "type": "checkbox", "id": "custom_mobile_padding", "label": "Custom for mobile", "default": false },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.custom_mobile_padding }}" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.custom_mobile_padding }}" }
  ]
}
{% endschema %}
