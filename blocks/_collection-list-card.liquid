{% doc %}
  Renders one collection card for the theme-block-native Collection list
  section.

  @example
  {% content_for 'block', type: '_collection-list-card', id: 'collection_card' %}
{% enddoc %}

{% liquid
  assign section_layout = section.settings.layout | default: 'grid'
  assign card_collection = block.settings.collection
  assign card_image = block.settings.image
  assign card_title = block.settings.title
  assign card_link = card_collection.url
  assign card_product_count = card_collection.all_products_count
  assign card_overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0

  if section_layout != 'split-promotions' and card_overlay_opacity < 0.45
    assign card_overlay_opacity = 0.45
  endif
  assign card_overlay_color = '#000000' | color_modify: 'alpha', card_overlay_opacity

  if card_image == blank and card_collection != blank
    assign card_image = card_collection.image
    if card_image == blank
      assign first_product = card_collection.products.first
      assign card_image = first_product.featured_image
    endif
  endif

  if card_title == blank
    assign card_title = card_collection.title
  endif
  if card_title == blank
    assign card_title = 'collection_list.collection' | t
  endif

  assign card_color_scheme = section.settings.color_scheme
  if block.settings.override_color_scheme and block.settings.color_scheme != blank
    assign card_color_scheme = block.settings.color_scheme
  endif

  assign card_alt = card_image.alt | default: card_title
  assign columns_desktop = section.settings.columns_desktop | default: 1
  assign columns_tablet = section.settings.columns_desktop | default: 1
  assign columns_mobile = section.settings.columns_mobile | default: 1
  assign desktop_card_width = 100 | divided_by: columns_desktop
  assign tablet_card_width = 100 | divided_by: columns_tablet
  assign mobile_card_width = 100 | divided_by: columns_mobile
  assign card_sizes = '(min-width: 990px) ' | append: desktop_card_width | append: 'vw, (min-width: 750px) ' | append: tablet_card_width | append: 'vw, ' | append: mobile_card_width | append: 'vw'
  if section_layout == 'split-promotions'
    assign card_sizes = '(min-width: 750px) 50vw, 100vw'
  endif

  assign card_loading = 'lazy'
  assign card_fetchpriority = 'auto'
  assign card_preload = false
  assign card_decoding = 'async'
  assign first_collection_card_id = blank
  for section_block in section.blocks
    if section_block.type == '_collection-list-card'
      assign first_collection_card_id = section_block.id
      break
    endif
  endfor
  if request.page_type == 'collection'
    assign card_fetchpriority = 'low'
  endif
  if request.page_type == 'collection' and card_image != blank and first_collection_card_id == block.id
    assign card_loading = 'eager'
    assign card_fetchpriority = 'high'
    assign card_preload = true
    assign card_decoding = 'sync'
  endif
%}

<li
  class="collection-list__item{% if section_layout == 'grid' %} swiper-slide{% endif %}"
  data-block-id="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {% if card_link != blank and section_layout != 'split-promotions' %}
    <a
      class="collection-list__card collection-list__card--{{ section_layout }} color-scheme color-{{ card_color_scheme.id }}"
      href="{{ card_link }}"
      style="--collection-list-image-position: {{ block.settings.focal_point }}; --collection-list-overlay-color: {{ card_overlay_color }};"
    >
  {% else %}
    <div
      class="collection-list__card collection-list__card--{{ section_layout }} color-scheme color-{{ card_color_scheme.id }}"
      style="--collection-list-image-position: {{ block.settings.focal_point }}; --collection-list-overlay-color: {{ card_overlay_color }};"
    >
  {% endif %}

    <div class="collection-list__media collection-list__media--{{ section.settings.image_ratio }}">
      {% if card_image != blank %}
        {% render 'responsive-image',
          image: card_image,
          max_width: 1400,
          widths: '320, 480, 640, 800, 1000, 1200, 1400',
          sizes: card_sizes,
          class: 'collection-list__image',
          loading: card_loading,
          fetchpriority: card_fetchpriority,
          preload: card_preload,
          decoding: card_decoding,
          alt: card_alt
        %}
      {% else %}
        {% render 'media-placeholder', class_name: 'collection-list__placeholder' %}
      {% endif %}
    </div>

    {% if section_layout == 'split-promotions' %}
      <span class="collection-list__overlay" aria-hidden="true"></span>
      <div class="collection-list__content collection-list__content--{{ section.settings.card_alignment }} collection-list__content--position-{{ block.settings.content_position }}">
        {% if block.settings.subheading != blank %}
          <span class="collection-list__eyebrow">{{ block.settings.subheading | escape }}</span>
        {% endif %}
        <{{ section.settings.card_heading_tag | default: 'h3' }} class="collection-list__promotion-heading collection-list__promotion-heading--{{ section.settings.card_heading_size | default: 'h3' }} heading--{{ section.settings.card_heading_size | default: 'h3' }} spinel-heading--{{ section.settings.card_heading_size | default: 'h3' }}">
          {{ card_title | escape }}
        </{{ section.settings.card_heading_tag | default: 'h3' }}>
        {% if block.settings.button_label != blank and card_link != blank %}
          <a
            class="collection-list__button button button--{{ block.settings.button_style | default: 'tertiary' }}"
            href="{{ card_link }}"
          >
            {{ block.settings.button_label | escape }}
          </a>
        {% endif %}
      </div>
    {% else %}
      <span class="collection-list__overlay" aria-hidden="true"></span>
      <span class="collection-list__content collection-list__content--{{ section.settings.card_alignment }} collection-list__content--position-bottom">
        <{{ section.settings.card_heading_tag | default: 'h3' }} class="collection-list__title collection-list__title--{{ section.settings.card_heading_size | default: 'h3' }} heading--{{ section.settings.card_heading_size | default: 'h3' }} spinel-heading--{{ section.settings.card_heading_size | default: 'h3' }}">
          {{ card_title | escape }}
        </{{ section.settings.card_heading_tag | default: 'h3' }}>
        {% if block.settings.show_product_count != false and card_collection != blank %}
          <span class="collection-list__count">
            {{ 'collection.product_count' | t: count: card_product_count }}
          </span>
        {% endif %}
      </span>
    {% endif %}

  {% if card_link != blank and section_layout != 'split-promotions' %}
    </a>
  {% else %}
    </div>
  {% endif %}
</li>

{% schema %}
{
  "name": "t:collection_list_blocks.card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:collection_list_blocks.content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:collection_list_blocks.collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:collection_list_blocks.custom_title"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:collection_list_blocks.show_product_count",
      "info": "t:collection_list_blocks.product_count_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:collection_list_blocks.promotion_content"
    },
    {
      "type": "paragraph",
      "content": "t:collection_list_blocks.promotion_info"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:collection_list_blocks.subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:collection_list_blocks.button_label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:collection_list_blocks.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:collection_list_blocks.primary"
        },
        {
          "value": "secondary",
          "label": "t:collection_list_blocks.secondary"
        },
        {
          "value": "tertiary",
          "label": "t:collection_list_blocks.tertiary"
        }
      ],
      "default": "tertiary"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:collection_list_blocks.content_position",
      "options": [
        {
          "value": "top",
          "label": "t:collection_list_blocks.top"
        },
        {
          "value": "center",
          "label": "t:collection_list_blocks.center"
        },
        {
          "value": "bottom",
          "label": "t:collection_list_blocks.bottom"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "t:collection_list_blocks.media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:collection_list_blocks.custom_image"
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "t:collection_list_blocks.focal_point",
      "options": [
        {
          "value": "left top",
          "label": "t:collection_list_blocks.top_left"
        },
        {
          "value": "center top",
          "label": "t:collection_list_blocks.top_center"
        },
        {
          "value": "right top",
          "label": "t:collection_list_blocks.top_right"
        },
        {
          "value": "left center",
          "label": "t:collection_list_blocks.center_left"
        },
        {
          "value": "center center",
          "label": "t:collection_list_blocks.center"
        },
        {
          "value": "right center",
          "label": "t:collection_list_blocks.center_right"
        },
        {
          "value": "left bottom",
          "label": "t:collection_list_blocks.bottom_left"
        },
        {
          "value": "center bottom",
          "label": "t:collection_list_blocks.bottom_center"
        },
        {
          "value": "right bottom",
          "label": "t:collection_list_blocks.bottom_right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "t:collection_list_blocks.appearance"
    },
    {
      "type": "checkbox",
      "id": "override_color_scheme",
      "label": "t:collection_list_blocks.override_color_scheme",
      "info": "t:collection_list_blocks.override_color_scheme_info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:collection_list_blocks.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.override_color_scheme }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:collection_list_blocks.overlay_opacity",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:collection_list_blocks.card",
      "settings": {
        "title": "t:collection_list_blocks.new_collection"
      }
    }
  ]
}
{% endschema %}
