{% doc %}Renders selected collections with one shared Collection card child. Its internal type avoids colliding with the Collection list section type.{% enddoc %}
{% liquid
  assign card_block = block.blocks | first
  assign layout = block.settings.layout | default: 'carousel'
  assign desktop = block.settings.columns_desktop | default: 4 | plus: 0
  assign mobile = block.settings.columns_mobile | default: 1 | plus: 0
  if block.settings.custom_columns
    assign desktop = block.settings.custom_columns_desktop | default: desktop | plus: 0
    assign mobile = block.settings.custom_columns_mobile | default: mobile | plus: 0
  endif
%}
{% if layout == 'carousel' %}{% render 'swiper-stylesheet' %}<script type="module" src="{{ 'product-collection-carousel.js' | asset_url }}"></script>{% endif %}
{% assign collection_list_aria_label = 'collection_list.default_title' | t %}
<div class="collection-card-list" data-collection-card-list {{ block.shopify_attributes }}>
  {% capture items %}{% if block.settings.collections != blank %}{% for collection in block.settings.collections %}<div class="swiper-slide collection-card-list__item">{% render 'collection-card', collection: collection, card_block: card_block %}</div>{% endfor %}{% elsif request.design_mode %}{% for index in (1..desktop) %}<div class="swiper-slide collection-card-list__item">{% render 'collection-card', card_block: card_block, placeholder: true %}</div>{% endfor %}{% endif %}{% endcapture %}
  {% if layout == 'carousel' %}
    {% capture attrs %}data-product-carousel data-layout="carousel" data-swiper-columns-desktop="{{ desktop }}" data-swiper-columns-mobile="{{ mobile }}" data-swiper-gap-desktop="{{ block.settings.gap_desktop | default: 12 }}" data-swiper-gap-mobile="{{ block.settings.gap_mobile | default: 8 }}" data-swiper-previous-selector="[data-collection-list-previous]" data-swiper-next-selector="[data-collection-list-next]"{% endcapture %}
    {% render 'swiper-carousel', content: items, root_class: 'collection-card-list__carousel', root_attributes: attrs, aria_label: collection_list_aria_label, autoplay: block.settings.autoplay, autoplay_delay: 4000, show_next_slide_preview: block.settings.show_next_slide_preview_on_desktop %}
    {% if block.settings.show_navigation_on_desktop %}<div class="collection-card-list__navigation collection-card-list__navigation--{{ block.settings.navigation_behavior | default: 'show_on_hover' }}"><button class="btn btn-{{ block.settings.navigation_style | default: 'secondary' }} btn--icon swiper-nav-button swiper-nav-button--prev" type="button" data-collection-list-previous>{% render 'carousel-navigation-icon', icon: block.settings.navigation_icon, direction: 'previous' %}</button><button class="btn btn-{{ block.settings.navigation_style | default: 'secondary' }} btn--icon swiper-nav-button swiper-nav-button--next" type="button" data-collection-list-next>{% render 'carousel-navigation-icon', icon: block.settings.navigation_icon, direction: 'next' %}</button></div>{% endif %}
  {% else %}<div class="collection-card-list__grid" style="--cards:{{ desktop }};--cards-mobile:{{ mobile }};--gap:{{ block.settings.gap_desktop | default: 12 }}px;--gap-mobile:{{ block.settings.gap_mobile | default: 8 }}px;">{{ items }}</div>{% endif %}
</div>
{% if false %}{% content_for 'block', type: 'collection-card', id: 'collection-card' %}{% endif %}
{% stylesheet %}.collection-card-list{position:relative;width:100%;min-width:0}.collection-card-list__grid{display:grid;grid-template-columns:repeat(var(--cards),minmax(0,1fr));gap:var(--gap)}.collection-card-list__navigation{position:absolute;z-index:1;inset:50% 0 auto;display:flex;justify-content:space-between;pointer-events:none;transform:translateY(-50%)}.collection-card-list__navigation button{pointer-events:auto}.collection-card-list__navigation--show_on_hover{opacity:0}.collection-card-list:hover .collection-card-list__navigation--show_on_hover,.collection-card-list:focus-within .collection-card-list__navigation--show_on_hover{opacity:1}@media(max-width:767.98px){.collection-card-list__grid{grid-template-columns:repeat(var(--cards-mobile),minmax(0,1fr));gap:var(--gap-mobile)}.collection-card-list__navigation{display:none}}{% endstylesheet %}
