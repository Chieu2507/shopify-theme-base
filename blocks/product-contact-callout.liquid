{% doc %}
  Small inline assistance callout, such as expedited-order help.
{% enddoc %}

{% if block.settings.text != blank or request.design_mode %}
  <div class="product-contact-callout" {{ block.shopify_attributes }}>
    {% render 'icon', icon: block.settings.icon | default: 'truck', bare: true, class: 'product-contact-callout__icon' %}
    <span>{{ block.settings.text | escape }}</span>
    {% if block.settings.link_label != blank %}
      <a href="{{ block.settings.link | default: routes.root_url }}">{{ block.settings.link_label | escape }}</a>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product contact callout",
  "tag": null,
  "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "truck", "label": "Shipping" }, { "value": "document-text", "label": "Document" }, { "value": "share", "label": "Share" }], "default": "truck" },
    { "type": "text", "id": "text", "label": "Text", "default": "Need it sooner?" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Contact us" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Product contact callout" }]
}
{% endschema %}
