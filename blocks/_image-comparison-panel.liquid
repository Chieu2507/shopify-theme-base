{% doc %}
  Renders one fixed image panel for the theme-block image comparison section.
  Nested Group, Subheading, Heading and Button blocks provide the overlay copy.

  @param {string} side - Semantic comparison side: "before" or "after".
  @param {string} image_sizes - Responsive image sizes string supplied by the section.
  @param {string} placeholder_asset - Placeholder asset used when no image is selected.

  @example
  {% content_for 'block',
    type: '_image-comparison-panel',
    id: 'before',
    side: 'before',
    image_sizes: image_sizes,
    placeholder_asset: 'placeholder-image-default-1.svg'
  %}
{% enddoc %}

{% liquid
  assign panel_image = block.settings.image | default: block.settings.mobile_image
  assign panel_side = side | default: 'before'
  assign panel_placeholder = placeholder_asset | default: 'placeholder-image-default-1.svg'
%}

<div
  class="image-comparison__media image-comparison__media--{{ panel_side }}"
  {{ block.shopify_attributes }}
>
  {% if panel_image != blank %}
    <picture>
      {% if block.settings.mobile_image != blank %}
        <source
          media="(max-width: 749px)"
          srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}"
        >
      {% endif %}
      {% render 'responsive-image',
        image: panel_image,
        max_width: 2400,
        widths: '480, 750, 1100, 1500, 1920, 2400',
        sizes: image_sizes,
        class: 'image-comparison__image',
        loading: 'lazy',
        alt: block.settings.image_alt
      %}
    </picture>
  {% else %}
    {% render 'media-placeholder',
      class_name: 'image-comparison__placeholder',
      asset_name: panel_placeholder
    %}
  {% endif %}

  <div
    class="image-comparison__overlay image-comparison__overlay--{{ panel_side }} image-comparison__overlay--{{ block.settings.content_position }}"
    style="--image-comparison-overlay-color: {{ block.settings.text_color }};"
  >
    <span class="image-comparison__overlay-label">{{ panel_side | capitalize }}</span>
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Comparison panel",
  "tag": null,
  "blocks": [
    {
      "type": "group"
    },
    {
      "type": "subheading"
    },
    {
      "type": "heading"
    },
    {
      "type": "button"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "end"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Comparison panel",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "block_style": "group",
            "flow": "vertical",
            "stack_alignment": "flex-start",
            "stack_distribution": "flex-start",
            "gap": 12,
            "phone_flow": "vertical",
            "phone_alignment": "flex-start",
            "phone_distribution": "flex-start",
            "gap_mobile": 12,
            "desktop_width": "stretch",
            "phone_width": "stretch"
          },
          "blocks": [
            {
              "type": "subheading",
              "settings": {
                "text": "<p>Before</p>",
                "type_preset": "subheading",
                "color": "text",
                "width": "fit-content",
                "width_mobile": "fit-content"
              }
            },
            {
              "type": "heading",
              "settings": {
                "heading": "<h3>Original detail</h3>",
                "type_preset": "custom",
                "font": "heading",
                "font_weight": "inherit",
                "font_size": 28,
                "font_size_mobile": 24,
                "line_height": "tight",
                "color": "text",
                "width": "fit-content",
                "width_mobile": "fit-content"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
