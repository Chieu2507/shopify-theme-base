{% doc %}
  Stores one promotional card for the theme-block-native Featured collection
  section. The parent section controls its placement beside the product panels.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% schema %}
{
  "name": "t:featured_collection_blocks.promotion",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:featured_collection_blocks.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:featured_collection_blocks.heading",
      "default": "t:featured_collection_blocks.promotion_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:featured_collection_blocks.text",
      "default": "t:featured_collection_blocks.promotion_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:featured_collection_blocks.button_label",
      "default": "t:featured_collection_blocks.shop_now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:featured_collection_blocks.link"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:featured_collection_blocks.position",
      "options": [
        {
          "value": "before",
          "label": "t:featured_collection_blocks.before"
        },
        {
          "value": "after",
          "label": "t:featured_collection_blocks.after"
        }
      ],
      "default": "before"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:featured_collection_blocks.image_ratio",
      "options": [
        {
          "value": "portrait",
          "label": "t:featured_collection_blocks.portrait"
        },
        {
          "value": "adapt",
          "label": "t:featured_collection_blocks.adapt"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "text_alignment",
      "id": "focal_point",
      "label": "t:featured_collection_blocks.focal_point",
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:featured_collection_blocks.overlay_opacity",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:featured_collection_blocks.promotion"
    }
  ]
}
{% endschema %}
