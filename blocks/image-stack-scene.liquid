{% liquid
  assign panel_image = block.settings.image | default: section.settings.background_image
  assign panel_mobile_image = block.settings.mobile_image | default: section.settings.mobile_background_image
  assign panel_alt = block.settings.alt | default: panel_image.alt
  assign panel_index = 0
  for section_block in section.blocks
    if section_block.id == block.id
      assign panel_index = forloop.index0
      break
    endif
  endfor
  assign panel_number = panel_index | plus: 1
  if panel_number < 10
    assign panel_number = panel_number | prepend: '0'
  endif
%}

<article
  class="sticky-scroll__panel image-stack__scene image-stack__scene--{{ block.settings.content_position }} image-stack__scene--alignment-{{ block.settings.content_alignment }}"
  data-sticky-scroll-panel
  data-sticky-scroll-index="{{ panel_index }}"
  style="--sticky-scroll-content-width: {{ block.settings.content_width }}px; --sticky-scroll-content-gap: {{ block.settings.content_gap }}px; --sticky-scroll-image-position: {{ block.settings.image_position }};"
  {{ block.shopify_attributes }}
>
  <div class="sticky-scroll__media">
    {% render 'responsive-media',
      image: panel_image,
      mobile_image: panel_mobile_image,
      mobile_breakpoint: 767,
      max_width: 2400,
      mobile_max_width: 1280,
      widths: '750, 960, 1200, 1600, 1920, 2400',
      mobile_widths: '375, 550, 750, 960, 1280',
      sizes: '100vw',
      class: 'sticky-scroll__image',
      loading: 'lazy',
      alt: panel_alt,
      placeholder_asset: 'image',
      placeholder_class: 'sticky-scroll__placeholder'
    %}
  </div>

  <div class="sticky-scroll__overlay" aria-hidden="true"></div>

  <div class="sticky-scroll__content-positioner">
    <div class="sticky-scroll__content image-stack__content" data-sticky-scroll-content>
      {% content_for 'blocks' %}
    </div>
  </div>

  <span class="sticky-scroll__ghost-number" aria-hidden="true">{{ panel_number }}</span>
</article>

{% schema %}
{
  "name": "Image stack scene",
  "tag": null,
  "blocks": [
    { "type": "label" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" },
    { "type": "spacer" },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "alt", "label": "Alt text" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    { "type": "text_alignment", "id": "content_alignment", "label": "Alignment", "default": "left" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 280, "max": 720, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "content_gap", "label": "Content gap", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 }
  ]
}
{% endschema %}
