{% doc %}
  Provides collection tab settings for the Featured collection section.
{% enddoc %}

{% schema %}
{
  "name": "Collection tab",
  "settings": [
    {
      "type": "header",
      "content": "Collection tab"
    },
    { "type": "text", "id": "label", "label": "Tab label" },
    {
      "type": "select",
      "id": "source",
      "label": "Product source",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "recently_viewed", "label": "Recently viewed" }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Collection tab"
    }
  ]
}
{% endschema %}
