{% doc %}
  Customer quote / trust proof displayed inside Product information.
{% enddoc %}

{% if block.settings.quote != blank or request.design_mode %}
  <figure class="product-testimonial" {{ block.shopify_attributes }}>
    {% if block.settings.rating > 0 %}
      <div class="product-testimonial__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
        {% for index in (1..5) %}<span aria-hidden="true">{% if index <= block.settings.rating %}★{% else %}☆{% endif %}</span>{% endfor %}
      </div>
    {% endif %}
    {% if block.settings.author != blank %}
      <figcaption class="product-testimonial__author">{{ block.settings.author | escape }}{% if block.settings.verified %}<em>Verified Buyer</em>{% endif %}</figcaption>
    {% endif %}
    {% if block.settings.quote != blank %}<blockquote>{{ block.settings.quote | escape }}</blockquote>{% endif %}
  </figure>
{% endif %}

{% schema %}
{
  "name": "Product testimonial",
  "tag": null,
  "settings": [
    { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "author", "label": "Author", "default": "Customer name" },
    { "type": "checkbox", "id": "verified", "label": "Show verified buyer", "default": true },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Share a customer review of this product." }
  ],
  "presets": [{ "name": "Product testimonial" }]
}
{% endschema %}
