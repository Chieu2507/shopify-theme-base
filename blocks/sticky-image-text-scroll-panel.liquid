{% doc %}
  Renders a reusable panel for Sticky image text scroll. It extends the Sticky
  scroll panel contract with constrained media and right-column content.
{% enddoc %}

{% liquid
  assign panel_image = block.settings.image | default: block.settings.mobile_image
  assign panel_alt = block.settings.alt | default: panel_image.alt
  assign panel_index = 0
  for section_block in section.blocks
    if section_block.id == block.id
      assign panel_index = forloop.index0
      break
    endif
  endfor
  assign panel_number = panel_index | plus: 1
  if panel_number < 10
    assign panel_number = panel_number | prepend: '0'
  endif
%}

<article
  class="sticky-scroll__panel sticky-image-text-scroll__panel"
  data-sticky-scroll-panel
  data-sticky-scroll-index="{{ panel_index }}"
  style="--sticky-scroll-content-width: {{ block.settings.content_width }}px; --sticky-scroll-content-gap: {{ block.settings.content_gap }}px; --sticky-scroll-image-position: {{ block.settings.image_position }}; --sticky-image-text-image-ratio: {{ block.settings.image_ratio | replace: '-', ' / ' }};"
  {{ block.shopify_attributes }}
>
  <div class="sticky-scroll__media">
    {% render 'responsive-media',
      image: panel_image,
      mobile_image: block.settings.mobile_image,
      mobile_breakpoint: 767,
      max_width: 1600,
      mobile_max_width: 1280,
      widths: '480, 640, 800, 960, 1200, 1600',
      mobile_widths: '375, 550, 750, 960, 1280',
      sizes: '(min-width: 768px) 40vw, 100vw',
      class: 'sticky-scroll__image',
      loading: 'lazy',
      alt: panel_alt,
      placeholder_asset: 'lifestyle-1',
      placeholder_class: 'sticky-scroll__placeholder'
    %}
  </div>

  <div class="sticky-scroll__content-positioner">
    <div class="sticky-scroll__content sticky-image-text-scroll__content sticky-image-text-scroll__content--{{ block.settings.content_alignment }}" data-sticky-scroll-content>
      {% content_for 'blocks' %}
    </div>
  </div>

  <span class="sticky-scroll__ghost-number" aria-hidden="true">{{ panel_number }}</span>
</article>

{% schema %}
{
  "name": "Sticky image text panel",
  "tag": null,
  "blocks": [
    { "type": "label" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" },
    { "type": "spacer" },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "alt", "label": "Alt text" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "2-3", "label": "Portrait (2:3)" },
        { "value": "3-4", "label": "Standard (3:4)" },
        { "value": "4-5", "label": "Portrait (4:5)" },
        { "value": "6-7", "label": "Classic (6:7)" },
        { "value": "3-2", "label": "Landscape (3:2)" },
        { "value": "4-3", "label": "Landscape (4:3)" },
        { "value": "16-9", "label": "Wide (16:9)" }
      ],
      "default": "4-5"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 280, "max": 720, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "content_gap", "label": "Content gap", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 }
  ]
}
{% endschema %}
