{% doc %}
  Renders the editorial content card within the Instagram gallery.
{% enddoc %}

<aside class="gallery__content-card color-scheme color-{{ block.settings.color_scheme.id }}" data-reveal-item style="{% if block.settings.background_color != blank %}--gallery-content-background: {{ block.settings.background_color }};{% endif %}" {{ block.shopify_attributes }}>
  <div class="gallery__content-card-top">
    {% content_for 'block', type: 'label', id: 'circle_label' %}
    {% content_for 'block', type: 'heading', id: 'circle_heading' %}
  </div>
  <div class="gallery__content-card-bottom">
    {% content_for 'block', type: 'text', id: 'circle_text' %}
    {% content_for 'block', type: 'button', id: 'circle_button' %}
  </div>
</aside>

{% schema %}
{
  "name": "Instagram content",
  "blocks": [
    { "type": "label" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" }
  ],
  "settings": [
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "color", "id": "background_color", "label": "Background color", "info": "Optional. Overrides the color scheme background." }
  ]
}
{% endschema %}
