{% doc %}
  Renders the static header for the review parallax section.

  @example
  {% content_for 'block', type: '_review-header', id: 'review_header' %}
{% enddoc %}

<header
  class="review-parallax__header"
  {{ block.shopify_attributes }}
>
  <div class="review-parallax__header-content">
    {% content_for 'blocks' %}
  </div>
</header>

{% schema %}
{
  "name": "Section header",
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "heading"
    }
  ],
  "presets": [
    {
      "name": "Section header",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "<p>What customers say</p>",
            "text_size": "small",
            "alignment": "center"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Over 500 Happy Reviews",
            "heading_size": "h1",
            "heading_tag": "h2",
            "alignment": "center"
          }
        }
      ]
    }
  ]
}
{% endschema %}
