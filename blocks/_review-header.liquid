{% doc %}
  Renders the static header for the review parallax section.

  @example
  {% content_for 'block', type: '_review-header', id: 'review_header' %}
{% enddoc %}

<header
  class="review-parallax__header"
  {{ block.shopify_attributes }}
>
  <div class="review-parallax__header-content">
    {% content_for 'blocks' %}
  </div>
</header>

{% schema %}
{
  "name": "Section header",
  "blocks": [
    {
      "type": "subheading"
    },
    {
      "type": "text"
    },
    {
      "type": "heading"
    }
  ],
  "presets": [
    {
      "name": "Section header",
      "blocks": [
        {
          "type": "subheading",
          "settings": {
            "text": "<p>What customers say</p>",
            "type_preset": "custom",
            "font": "body",
            "font_size": 12,
            "font_size_mobile": 12,
            "color": "subtext",
            "alignment": "center"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "<h2>Over 500 Happy Reviews</h2>",
            "type_preset": "h1",
            "alignment": "center"
          }
        }
      ]
    }
  ]
}
{% endschema %}
