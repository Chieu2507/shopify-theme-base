{% doc %}
  Renders the static header for the review parallax section.

  @example
  {% content_for 'block', type: '_review-header', id: 'review_header' %}
{% enddoc %}

<header
  class="review-parallax__header"
  style="--review-header-padding-bottom-desktop: {{ block.settings.padding_bottom_desktop | default: 0 }}px; --review-header-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile | default: 0 }}px;"
  {{ block.shopify_attributes }}
>
  <div class="review-parallax__header-content">
    {% content_for 'blocks' %}
  </div>
</header>

{% schema %}
{
  "name": "Section header",
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "heading"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "select",
      "id": "padding_device",
      "label": "Devices",
      "options": [
        {
          "value": "desktop",
          "label": "Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "Section header",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "<p>What customers say</p>",
            "type_preset": "subheading",
            "color": "subtext",
            "alignment": "center"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "<h2>Over 500 Happy Reviews</h2>",
            "type_preset": "h1",
            "alignment": "center"
          }
        }
      ]
    }
  ]
}
{% endschema %}
