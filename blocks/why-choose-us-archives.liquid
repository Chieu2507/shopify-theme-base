{% doc %}
  Owns the repeatable archive-card stream for Why choose us. Shared card
  composition belongs here so every child card remains visually coherent.
{% enddoc %}

<div
  class="why-choose-us__archives why-choose-us__archives--ratio-{{ block.settings.image_ratio }} why-choose-us__archives--title-font-{{ block.settings.title_font }} why-choose-us__archives--button-{{ block.settings.button_style }}"
  role="list"
  aria-label="{{ block.settings.accessibility_label | escape }}"
  data-reveal-group
  style="--why-choose-us-archive-columns-desktop: {{ block.settings.columns_desktop }}; --why-choose-us-archive-columns-mobile: {{ block.settings.columns_mobile }}; --why-choose-us-archive-gap: {{ block.settings.item_gap }}px; --why-choose-us-archive-image-width: {{ block.settings.image_width }}px; --why-choose-us-archive-title-size: {{ block.settings.title_size }}px; --why-choose-us-archive-title-size-mobile: {{ block.settings.title_size_mobile }}px; --why-choose-us-archive-label-size: {{ block.settings.label_size }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Why choose us archives",
  "tag": null,
  "blocks": [
    { "type": "why-choose-us-archive-card" }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "columns_desktop", "label": "Desktop columns", "options": [{ "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" }, { "value": "3", "label": "3 columns" }, { "value": "4", "label": "4 columns" }], "default": "3" },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "options": [{ "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" }], "default": "1" },
    { "type": "range", "id": "item_gap", "label": "Item gap", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Image" },
    { "type": "range", "id": "image_width", "label": "Image width", "min": 64, "max": 240, "step": 4, "unit": "px", "default": 104 },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [{ "value": "square", "label": "Square (1:1)" }, { "value": "4-3", "label": "Landscape (4:3)" }, { "value": "3-2", "label": "Landscape (3:2)" }, { "value": "2-3", "label": "Portrait (2:3)" }, { "value": "3-4", "label": "Standard (3:4)" }, { "value": "4-5", "label": "Portrait (4:5)" }, { "value": "6-7", "label": "Classic (6:7)" }], "default": "4-3" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "title_font", "label": "Title font", "options": [{ "value": "heading", "label": "Heading" }, { "value": "body", "label": "Body" }], "default": "heading" },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 14, "max": 48, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "title_size_mobile", "label": "Mobile title size", "min": 14, "max": 36, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "label_size", "label": "Label size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 10 },
    { "type": "header", "content": "Button" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [{ "value": "tertiary", "label": "Tertiary" }, { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }], "default": "tertiary" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Explore the collection" }
  ],
  "presets": [
    {
      "name": "Why choose us archives",
      "blocks": [
        { "type": "why-choose-us-archive-card", "settings": { "label": "ARCHIVE N° 01", "title": "The Necklaces", "action_label": "Enter" } },
        { "type": "why-choose-us-archive-card", "settings": { "label": "ARCHIVE N° 02", "title": "The Rings", "action_label": "Enter" } },
        { "type": "why-choose-us-archive-card", "settings": { "label": "ARCHIVE N° 03", "title": "The Art of Giving", "action_label": "Enter" } }
      ]
    }
  ]
}
{% endschema %}
