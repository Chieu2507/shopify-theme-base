{% doc %}
  Stores one product and its desktop and mobile hotspot coordinates for the
  theme-block-native Shop the look section. The parent section renders the
  synchronized hotspot, preview, product slide and indicator.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% schema %}
{
  "name": "Product hotspot",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "range",
      "id": "horizontal_position",
      "label": "Horizontal position",
      "min": 5,
      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "vertical_position",
      "label": "Vertical position",
      "min": 5,
      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile position"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_position",
      "label": "Use a separate mobile position",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_horizontal_position",
      "label": "Mobile horizontal position",
      "min": 5,
      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.enable_mobile_position }}"
    },
    {
      "type": "range",
      "id": "mobile_vertical_position",
      "label": "Mobile vertical position",
      "min": 5,
      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.enable_mobile_position }}"
    }
  ],
  "presets": [
    {
      "name": "Product hotspot"
    }
  ]
}
{% endschema %}
