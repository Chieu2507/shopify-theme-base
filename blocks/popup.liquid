{% doc %}
  Generic modal trigger and content composition block. Used inside a Group for
  product assistance, but intentionally reusable on every supported surface.
{% enddoc %}

<popup-block class="popup-block" data-popup {{ block.shopify_attributes }}>
  <button type="button" class="btn btn-tertiary popup-block__trigger" data-popup-open aria-haspopup="dialog">{{ block.settings.trigger_label | default: 'Open' | escape }}</button>
  <dialog class="popup-block__dialog" data-popup-dialog aria-label="{{ block.settings.trigger_label | default: 'Dialog' | escape }}">
    <div class="popup-block__surface">
      <button type="button" class="popup-block__close" data-popup-close aria-label="Close">{% render 'icon', icon: 'x-mark', bare: true %}</button>
      <div class="popup-block__content">{% content_for 'blocks' %}</div>
    </div>
  </dialog>
</popup-block>

{% schema %}
{
  "name": "Popup",
  "tag": null,
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [{ "type": "text", "id": "trigger_label", "label": "Button label", "default": "Open" }]
}
{% endschema %}
