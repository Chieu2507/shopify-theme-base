{% doc %}
  Generic drawer trigger and content composition block. Used inside a Group for
  product assistance, but intentionally reusable on every supported surface.
{% enddoc %}

{% liquid
  assign popup_id = 'Popup-' | append: section.id | append: '-' | append: block.id
  assign popup_label = block.settings.trigger_label | default: 'Open'
%}

<popup-block class="popup-block" data-popup {{ block.shopify_attributes }}>
  <button type="button" class="btn btn-tertiary popup-block__trigger" data-popup-open data-pdp-drawer-open aria-haspopup="dialog" aria-controls="{{ popup_id }}" aria-expanded="false">{{ popup_label | escape }}</button>
  <div id="{{ popup_id }}" class="pdp-drawer popup-block__drawer" data-pdp-drawer data-popup-dialog hidden aria-hidden="true">
    <button type="button" class="pdp-drawer__backdrop popup-block__backdrop" data-popup-close data-pdp-drawer-close aria-label="Close"></button>
    <aside class="pdp-drawer__panel popup-block__panel" data-pdp-drawer-panel role="dialog" aria-modal="true" aria-label="{{ popup_label | escape }}" tabindex="-1">
      <div class="pdp-drawer__inner popup-block__surface">
        <header class="pdp-drawer__header popup-block__header">
          <button type="button" class="overlay-close popup-block__close" data-popup-close data-pdp-drawer-close aria-label="Close">{% render 'icon', icon: 'x-mark', bare: true, class: 'overlay-close__icon' %}</button>
        </header>
        <div class="pdp-drawer__body popup-block__content">{% content_for 'blocks' %}</div>
      </div>
    </aside>
  </div>
</popup-block>

{% schema %}
{
  "name": "Popup",
  "tag": null,
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "text", "id": "trigger_label", "label": "Button label", "default": "Open" }
  ]
}
{% endschema %}
