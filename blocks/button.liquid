{% doc %}
  Renders a reusable button theme block.

  @example
  {% content_for 'block', type: 'button', id: 'button' %}
{% enddoc %}

{% liquid
  assign button_url = block.settings.link | default: routes.all_products_collection_url
%}

{% if block.settings.label != blank %}
  <div
    class="content-button block-animation"
    style="--block-animation-delay: {{ block.settings.animation_delay | default: 0 }}ms;"
    data-block-animation="{{ block.settings.animation_type | default: 'fade_up' }}"
    {{ block.shopify_attributes }}
  >
    {% render 'cta',
      label: block.settings.label,
      url: button_url,
      style: block.settings.style,
      icon: block.settings.icon,
      open_in_new_tab: block.settings.open_in_new_tab
    %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "tertiary",
          "label": "Text link"
        }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in a new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "arrow-right",
          "label": "Arrow right"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:typography_blocks.animation"
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "t:typography_blocks.type",
      "options": [
        { "value": "none", "label": "t:typography_options.none" },
        { "value": "fade_in", "label": "t:typography_options.fade_in" },
        { "value": "fade_up", "label": "t:typography_options.fade_up" },
        { "value": "slide_in_left", "label": "t:typography_options.slide_in_left" },
        { "value": "slide_in_right", "label": "t:typography_options.slide_in_right" },
        { "value": "zoom_in", "label": "t:typography_options.zoom_in" },
        { "value": "zoom_out", "label": "t:typography_options.zoom_out" }
      ],
      "default": "fade_up"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:typography_blocks.animation_delay",
      "min": 0,
      "max": 1000,
      "step": 25,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "Button"
    }
  ]
}
{% endschema %}
