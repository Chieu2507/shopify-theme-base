{% doc %}
  Renders a reusable button theme block.

  @example
  {% content_for 'block', type: 'button', id: 'button' %}
{% enddoc %}

{% if block.settings.label != blank and block.settings.link != blank %}
  <div class="content-button content-button--{{ block.settings.alignment }}" {{ block.shopify_attributes }}>
    {% render 'cta',
      label: block.settings.label,
      url: block.settings.link,
      style: block.settings.style,
      open_in_new_tab: block.settings.open_in_new_tab
    %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "tertiary",
          "label": "Text link"
        }
      ],
      "default": "primary"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in a new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Button"
    }
  ]
}
{% endschema %}
