{% doc %}
  Product-information trust/USP list. Its children are purpose-specific so the
  merchant can reorder up to six concise icon-and-text assurances.
{% enddoc %}

{% liquid
  assign columns = block.settings.columns | default: '2'
  unless columns == '1' or columns == '2'
    assign columns = '2'
  endunless
%}

<div class="product-icon-list product-icon-list--columns-{{ columns }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Product benefits",
  "tag": null,
  "blocks": [{ "type": "product-icon-text" }],
  "settings": [
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    }
  ],
  "presets": [{
    "name": "Product benefits",
    "blocks": [{ "type": "product-icon-text" }, { "type": "product-icon-text" }, { "type": "product-icon-text" }, { "type": "product-icon-text" }]
  }]
}
{% endschema %}
