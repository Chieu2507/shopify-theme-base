{% doc %}
  Owns the repeatable statistic-item stream for Why choose us. The parent is a
  fixed editorial region; its child items remain merchant-addable and editable.
{% enddoc %}

<div
  class="why-choose-us__stats why-choose-us__stats--value-font-{{ block.settings.value_font }}"
  role="list"
  aria-label="{{ block.settings.accessibility_label | escape }}"
  data-reveal-group
  style="--why-choose-us-stat-columns-desktop: {{ block.settings.columns_desktop }}; --why-choose-us-stat-columns-mobile: {{ block.settings.columns_mobile }}; --why-choose-us-stat-gap: {{ block.settings.item_gap }}px; --why-choose-us-stat-value-size: {{ block.settings.value_size }}px; --why-choose-us-stat-value-size-mobile: {{ block.settings.value_size_mobile }}px; --why-choose-us-stat-description-size: {{ block.settings.description_size }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Why choose us statistics",
  "tag": null,
  "blocks": [
    { "type": "why-choose-us-stat" }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "columns_desktop", "label": "Desktop columns", "options": [{ "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" }, { "value": "3", "label": "3 columns" }, { "value": "4", "label": "4 columns" }], "default": "3" },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "options": [{ "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" }], "default": "1" },
    { "type": "range", "id": "item_gap", "label": "Item gap", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Value typography" },
    { "type": "select", "id": "value_font", "label": "Font", "options": [{ "value": "heading", "label": "Heading" }, { "value": "body", "label": "Body" }], "default": "heading" },
    { "type": "range", "id": "value_size", "label": "Value size", "min": 24, "max": 112, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "value_size_mobile", "label": "Mobile value size", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Text" },
    { "type": "range", "id": "description_size", "label": "Text size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 10 },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Why choose Spinel statistics" }
  ],
  "presets": [
    {
      "name": "Why choose us statistics",
      "blocks": [
        { "type": "why-choose-us-stat", "settings": { "value": "8 MM", "description": "<p>NATURAL, UNTREATED<br>MOGOK, BURMA</p>" } },
        { "type": "why-choose-us-stat", "settings": { "value": "42 HOURS", "description": "<p>SETTING AND HAND-FINISHING<br>18K HALLMARKED</p>" } },
        { "type": "why-choose-us-stat", "settings": { "value": "600 YEARS", "description": "<p>CATALOGUED AS RUBY UNTIL GEMOLOGY SETTLED IT —<br>THE NAME NEVER CAUGHT UP</p>" } }
      ]
    }
  ]
}
{% endschema %}
