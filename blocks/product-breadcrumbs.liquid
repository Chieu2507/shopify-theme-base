{% render 'resource-breadcrumbs', block: block, resource_type: 'product', default_color: 'var(--product-muted)' %}
{% schema %}
{
  "name": "Product breadcrumbs",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumb content"
    },
    {
      "type": "checkbox",
      "id": "show_home",
      "label": "Show home link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection",
      "label": "Show collection link",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Text size",
      "options": [
        { "value": "lg", "label": "Large" },
        { "value": "md", "label": "Medium" },
        { "value": "sm", "label": "Small" },
        { "value": "xs", "label": "Extra small" },
        { "value": "label", "label": "Label" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "label"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Size",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14,
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile size",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Content alignment",
      "default": "left"
    }
  ]
}
{% endschema %}
