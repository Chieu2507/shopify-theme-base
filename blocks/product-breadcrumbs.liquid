{% doc %}
  Renders product breadcrumb navigation.
{% enddoc %}
{% assign product = closest.product | default: product %}
<nav class="product-breadcrumbs" aria-label="Breadcrumb" {{ block.shopify_attributes }}>
  <a href="{{ routes.root_url }}">Home</a>
  {% if collection != blank %}<span aria-hidden="true">/</span><a href="{{ collection.url }}">{{ collection.title | escape }}</a>{% endif %}
  <span aria-hidden="true">/</span><span aria-current="page">{{ product.title | escape }}</span>
</nav>
{% schema %}
{
  "name": "Product breadcrumbs",
  "settings": []
}
{% endschema %}
