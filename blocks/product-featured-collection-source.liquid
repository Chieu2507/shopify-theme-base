{% doc %}
  Configures the product source for the Product collection section.
  This static Theme Block keeps source data separate from the reusable header.
{% enddoc %}

{% schema %}
{
  "name": "Product collection source",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Product source",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "complementary", "label": "Complementary products" },
        { "value": "related", "label": "Related products" }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when Product source is Collection."
    }
  ]
}
{% endschema %}
