{% doc %}
  Renders a footer navigation column with a configurable heading.

  @example
  {% content_for 'block', type: 'footer-menu', id: 'footer_menu' %}
{% enddoc %}

{% liquid
  assign menu_label = block.settings.menu.title
  if menu_label == blank
    assign menu_label = 'footer.menu' | t
  endif
%}

<details
  class="footer-menu{% if block.settings.show_as_accordion_mobile %} footer-menu--accordion-mobile{% endif %}"
  data-footer-menu
  data-footer-mobile-accordion="{{ block.settings.show_as_accordion_mobile }}"
  data-footer-default-open="{{ block.settings.open_accordions_by_default }}"
  style="--footer-menu-max-width: {{ block.settings.maximum_width }}px;"
  open
  {{ block.shopify_attributes }}
>
  <summary class="footer-menu__summary" aria-label="{{ menu_label | escape }}">
    <span class="footer-menu__heading">
      {% render 'content-block',
        block: block,
        content: block.settings.heading,
        kind: 'heading',
        default_preset: 'h2',
        default_font: 'heading',
        include_shopify_attributes: false
      %}
    </span>
    <span class="footer-menu__toggle" aria-hidden="true">
      {% render 'icon', name: 'chevron-down' %}
    </span>
  </summary>

  <div class="footer-menu__content">
    {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
      <ul class="footer-menu__links" role="list">
        {% for link in block.settings.menu.links %}
          <li>
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
              <span>{{ link.title | escape }}</span>
              {% if block.settings.show_external_indicator and link.url contains 'http' %}
                <span class="footer-menu__external" aria-hidden="true">↗</span>
              {% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    {% elsif request.design_mode %}
      <p class="footer-menu__empty">{{ 'footer.choose_menu' | t }}</p>
    {% endif %}
  </div>
</details>

{% schema %}
{
  "name": "Footer menu",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_external_indicator",
      "label": "Show indicator for external links",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "maximum_width",
      "label": "Maximum width",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 190
    },
    {
      "type": "checkbox",
      "id": "show_as_accordion_mobile",
      "label": "Show as accordion on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_accordions_by_default",
      "label": "Open accordions by default",
      "default": false,
      "visible_if": "{{ block.settings.show_as_accordion_mobile }}"
    },
    {
      "type": "header",
      "content": "t:typography_blocks.typography"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:typography_blocks.text",
      "default": "t:typography_defaults.heading"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:typography_blocks.preset",
      "options": [
        { "value": "paragraph", "label": "t:typography_options.paragraph" },
        { "value": "subheading", "label": "t:typography_options.subheading" },
        { "value": "h1", "label": "t:typography_options.h1" },
        { "value": "h2", "label": "t:typography_options.h2" },
        { "value": "h3", "label": "t:typography_options.h3" },
        { "value": "h4", "label": "t:typography_options.h4" },
        { "value": "h5", "label": "t:typography_options.h5" },
        { "value": "h6", "label": "t:typography_options.h6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:typography_blocks.color",
      "options": [
        { "value": "text", "label": "t:typography_options.text" },
        { "value": "subtext", "label": "t:typography_options.subtext" }
      ],
      "default": "text"
    },
    {
      "type": "checkbox",
      "id": "disable_line_break_mobile",
      "label": "t:typography_blocks.disable_line_break_mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "t:typography_blocks.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:typography_blocks.width",
      "options": [
        { "value": "fit-content", "label": "t:typography_options.fit" },
        { "value": "100%", "label": "t:typography_options.fill" }
      ],
      "default": "fit-content"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:typography_blocks.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:typography_options.fit" },
        { "value": "100%", "label": "t:typography_options.fill" }
      ],
      "default": "fit-content"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:typography_blocks.alignment",
      "default": "left",
      "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
    }
  ],
  "presets": [
    {
      "name": "Footer menu",
      "category": "Theme layout",
      "settings": {
        "heading": "<h3>Menu</h3>",
        "type_preset": "subheading"
      }
    }
  ]
}
{% endschema %}
