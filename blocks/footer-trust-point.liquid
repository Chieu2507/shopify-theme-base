{% doc %}
  Renders one compact trust point within the footer icon-with-text component.
{% enddoc %}

<div class="footer__trust-point" role="listitem" data-reveal-item style="--reveal-order: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
  <span class="footer__trust-point-icon" aria-hidden="true">
    {% render 'icon', name: block.settings.icon %}
  </span>
  <div class="footer__trust-point-content">
    {% if block.settings.heading != blank %}
      <h3 class="footer__trust-point-heading heading-text">{{ block.settings.heading | escape }}</h3>
    {% endif %}
    {% if block.settings.text != blank %}
      <div class="footer__trust-point-text rte">{{ block.settings.text }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Trust point",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "box", "label": "Package" },
        { "value": "return", "label": "Returns" },
        { "value": "sparkles", "label": "Care" },
        { "value": "shield", "label": "Shield" },
        { "value": "truck", "label": "Delivery" }
      ],
      "default": "box"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Delivery, clearly stated"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Shipping options and timing are shown before purchase.</p>"
    }
  ]
}
{% endschema %}
