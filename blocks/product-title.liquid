{% assign product = closest.product | default: product %}
<{{ block.settings.html_tag | default: 'h1' }} class="product-title product-title--{{ block.settings.heading_size | default: '2xl' }} spinel-heading--{{ block.settings.heading_size | default: '2xl' }} heading--{{ block.settings.heading_size | default: '2xl' }}" {{ block.shopify_attributes }}>{{ product.title | escape }}</{{ block.settings.html_tag | default: 'h1' }}>
{% schema %}
{
  "name": "Product title",
  "settings": [
    {
      "type": "header",
      "content": "Product title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "XX-large"
        },
        {
          "value": "h2",
          "label": "X-large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "HTML Tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h1"
    }
  ]
}
{% endschema %}
