{% doc %}
  Renders automatic product badges.
{% enddoc %}
{% assign product = closest.product | default: product %}
{% assign variant = product.selected_or_first_available_variant %}
<div class="product-badges" data-product-badges {{ block.shopify_attributes }}>
  {% if product.tags contains 'New' %}<span class="product-badge product-badge--new">New</span>{% endif %}
  {% if settings.show_sale_badge %}<span class="product-badge product-badge--sale" data-product-badge-sale{% unless variant.compare_at_price > variant.price %} hidden{% endunless %}>Sale</span>{% endif %}
  {% if settings.show_sold_out_badge %}<span class="product-badge product-badge--sold-out" data-product-badge-sold-out{% if variant.available %} hidden{% endif %}>Sold out</span>{% endif %}
</div>
{% schema %}
{
  "name": "Product badges",
  "settings": []
}
{% endschema %}
