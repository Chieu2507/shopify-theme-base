{% doc %}
  Renders a reusable text theme block with preset typography.

  @example
  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

{% render 'typography-block',
  block: block,
  content: block.settings.text,
  kind: 'text',
  default_preset: 'paragraph',
  default_font: 'body'
%}

{% schema %}
{
  "name": "t:typography_blocks.text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:typography_blocks.typography"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:typography_blocks.text",
      "default": "t:typography_defaults.text"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:typography_blocks.preset",
      "options": [
        { "value": "default", "label": "t:typography_options.default" },
        { "value": "paragraph", "label": "t:typography_options.paragraph" },
        { "value": "subheading", "label": "t:typography_options.subheading" },
        { "value": "h1", "label": "t:typography_options.h1" },
        { "value": "h2", "label": "t:typography_options.h2" },
        { "value": "h3", "label": "t:typography_options.h3" },
        { "value": "h4", "label": "t:typography_options.h4" },
        { "value": "h5", "label": "t:typography_options.h5" },
        { "value": "h6", "label": "t:typography_options.h6" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:typography_blocks.color",
      "options": [
        { "value": "text", "label": "t:typography_options.text" },
        { "value": "subtext", "label": "t:typography_options.subtext" }
      ],
      "default": "text"
    },
    {
      "type": "checkbox",
      "id": "disable_line_break_mobile",
      "label": "t:typography_blocks.disable_line_break_mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "t:typography_blocks.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:typography_blocks.width",
      "options": [
        { "value": "fit-content", "label": "t:typography_options.fit" },
        { "value": "100%", "label": "t:typography_options.fill" }
      ],
      "default": "fit-content"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:typography_blocks.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:typography_options.fit" },
        { "value": "100%", "label": "t:typography_options.fill" }
      ],
      "default": "fit-content"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:typography_blocks.alignment",
      "default": "left",
      "visible_if": "{{ block.settings.width == '100%' or block.settings.width_mobile == '100%' }}"
    },
    {
      "type": "header",
      "content": "t:typography_blocks.animation"
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "t:typography_blocks.type",
      "options": [
        { "value": "none", "label": "t:typography_options.none" },
        { "value": "fade_in", "label": "t:typography_options.fade_in" },
        { "value": "fade_up", "label": "t:typography_options.fade_up" },
        { "value": "slide_in_left", "label": "t:typography_options.slide_in_left" },
        { "value": "slide_in_right", "label": "t:typography_options.slide_in_right" },
        { "value": "zoom_in", "label": "t:typography_options.zoom_in" },
        { "value": "zoom_out", "label": "t:typography_options.zoom_out" }
      ],
      "default": "fade_up"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:typography_blocks.animation_delay",
      "min": 0,
      "max": 1000,
      "step": 25,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "t:typography_blocks.text",
      "category": "t:typography_blocks.basic",
      "settings": {
        "text": "t:typography_defaults.text",
        "type_preset": "default"
      }
    }
  ]
}
{% endschema %}
