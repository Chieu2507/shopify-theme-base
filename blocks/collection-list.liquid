{% doc %}
  Renders one linked collection card inside a Collection list section.

  @example
  {% content_for 'block', type: 'collection-list', id: 'collection-list-item' %}
{% enddoc %}

{% liquid
  assign collection_list_collection = block.settings.collection
  assign collection_list_title = block.settings.title | strip
  if collection_list_title == blank and collection_list_collection != blank
    assign collection_list_title = collection_list_collection.title
  endif
  if collection_list_title == blank
    assign collection_list_title = 'collection_list.default_title' | t
  endif

  assign collection_list_image = block.settings.image
  if collection_list_image == blank and collection_list_collection != blank
    assign collection_list_image = collection_list_collection.featured_image | default: collection_list_collection.image
  endif

  assign collection_list_url = block.settings.link
  if collection_list_url == blank and collection_list_collection != blank
    assign collection_list_url = collection_list_collection.url
  endif
%}

<article class="collection-list__item" {{ block.shopify_attributes }}>
  {% if collection_list_url != blank %}
    <a class="collection-list__link" href="{{ collection_list_url }}">
  {% else %}
    <div class="collection-list__link">
  {% endif %}
      <div class="collection-list__media{% if collection_list_image == blank %} placeholder-image{% endif %}">
        {% if collection_list_image != blank %}
          {{ collection_list_image | image_url: width: 1200 | image_tag: widths: '320, 480, 640, 800, 1000, 1200', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', alt: collection_list_title }}
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <h3 class="collection-list__title">{{ collection_list_title | escape }}</h3>
  {% if collection_list_url != blank %}
    </a>
  {% else %}
    </div>
  {% endif %}
</article>

{% stylesheet %}
  .collection-list__item {
    min-width: 0;
  }

  .collection-list__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .collection-list__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .collection-list__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--surface-color, var(--background-color));
  }

  .collection-list__media img,
  .collection-list__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-list__title {
    margin: 1.2rem 0 0;
    color: inherit;
    font: var(--font-heading-5);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_list"
    }
  ]
}
{% endschema %}
