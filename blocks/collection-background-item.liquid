{% doc %}
  Renders a selectable collection background panel for Collections with
  background. The shared Tab layout block moves this item's trigger into its
  tablist while this block retains the corresponding panel.
{% enddoc %}

{% liquid
  assign collection_background_collection = block.settings.collection
  assign collection_background_title = block.settings.title | strip
  if collection_background_title == blank and collection_background_collection != blank
    assign collection_background_title = collection_background_collection.title
  endif
  if collection_background_title == blank
    assign collection_background_title = 'collection_list.default_title' | t
  endif

  assign collection_background_image = block.settings.image | default: collection_background_collection.featured_image | default: collection_background_collection.image
  assign collection_background_tab_id = 'CollectionBackground-' | append: section.id | append: '-' | append: block.id
  assign collection_background_trigger_id = collection_background_tab_id | append: '-trigger'
  assign collection_background_panel_id = collection_background_tab_id | append: '-panel'
%}

<div
  class="collection-background-item"
  data-collection-tab
  data-tab-id="{{ collection_background_tab_id | escape }}"
  {{ block.shopify_attributes }}
>
  <button
    id="{{ collection_background_trigger_id | escape }}"
    class="tab-layout__tab collection-background-item__trigger link-underline"
    type="button"
    role="tab"
    aria-selected="false"
    aria-controls="{{ collection_background_panel_id | escape }}"
    tabindex="-1"
    data-collection-tab-trigger
    data-tab-id="{{ collection_background_tab_id | escape }}"
  >
    {{ collection_background_title | escape }}
  </button>

  <div
    id="{{ collection_background_panel_id | escape }}"
    class="collection-background-item__panel"
    role="tabpanel"
    aria-labelledby="{{ collection_background_trigger_id | escape }}"
    data-collection-tab-panel
    data-tab-id="{{ collection_background_tab_id | escape }}"
  >
    {% if collection_background_image != blank %}
      {{ collection_background_image | image_url: width: 2400 | image_tag: class: 'collection-background-item__image', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: collection_background_title }}
    {% elsif request.design_mode %}
      {{ 'collection-1' | placeholder_svg_tag: 'collection-background-item__image placeholder-image' }}
    {% endif %}

    <div class="collection-background-item__overlay" aria-hidden="true"></div>

    <div class="collection-background-item__content">
      <h2 class="collection-background-item__title">{{ collection_background_title | escape }}</h2>
      {% if section.settings.show_product_count and collection_background_collection != blank %}
        <p class="collection-background-item__count">{{ 'collection_list.products_count' | t: count: collection_background_collection.all_products_count }}</p>
      {% endif %}
      {% if collection_background_collection != blank %}
        <a class="collection-background-item__link" href="{{ collection_background_collection.url }}">
          <span class="visually-hidden">{{ collection_background_title | escape }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection",
  "tag": null,
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "image_picker", "id": "image", "label": "Background image" }
  ]
}
{% endschema %}
