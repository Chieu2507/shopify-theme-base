{% assign product = closest.product | default: product %}
{% assign rating = product.metafields.reviews.rating.value %}
{% if rating != blank %}
  <div class="product-rating" {{ block.shopify_attributes }} aria-label="Rated {{ rating.rating }} out of {{ rating.scale_max }}">
    <span aria-hidden="true">★★★★★</span><span class="product-rating__value">{{ rating.rating | round: 1 }}/{{ rating.scale_max }}</span>
  </div>
{% elsif block.settings.show_when_empty %}
  <p class="product-rating product-rating--empty" {{ block.shopify_attributes }}>{{ block.settings.empty_label | escape }}</p>
{% endif %}
{% schema %}
{
  "name": "Product rating",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_when_empty",
      "label": "Show when no rating exists",
      "default": false
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Empty-state label",
      "default": "No reviews yet"
    }
  ]
}
{% endschema %}
