{% doc %}
  A concise icon-and-text item used only in Product benefits.
{% enddoc %}

<div class="product-icon-text" {{ block.shopify_attributes }}>
  {% render 'icon', icon: block.settings.icon | default: 'check', bare: true, class: 'product-icon-text__icon' %}
  <span>{{ block.settings.text | escape }}</span>
</div>

{% schema %}
{
  "name": "Benefit",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "truck", "label": "Shipping" },
        { "value": "check", "label": "Check" },
        { "value": "diamond", "label": "Diamond" },
        { "value": "circle", "label": "Circle" },
        { "value": "arrow-left", "label": "Return" }
      ],
      "default": "check"
    },
    { "type": "text", "id": "text", "label": "Text", "default": "Product benefit" }
  ]
}
{% endschema %}
