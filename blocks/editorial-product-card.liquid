{% liquid
  assign product = block.settings.product
  assign variant = product.selected_or_first_available_variant
  assign title = block.settings.title | default: product.title
  assign product_url = product.url
  assign cta_url = product_url | default: routes.all_products_collection_url
  assign price = block.settings.price
  if variant != blank
    assign price = variant.price
  endif
%}

{% if title != blank or product != blank %}
  <aside class="editorial-slideshow__product-card color-scheme color-{{ block.settings.color_scheme.id }}" aria-label="{{ title | escape }}" {{ block.shopify_attributes }}>
    <div class="editorial-slideshow__product-copy">
      {% if product_url != blank %}<a class="editorial-slideshow__product-title" href="{{ product_url | escape }}">{{ title | escape }}</a>{% else %}<span class="editorial-slideshow__product-title">{{ title | escape }}</span>{% endif %}
      {% if block.settings.meta != blank %}<span class="editorial-slideshow__product-meta">{{ block.settings.meta | escape }}</span>{% endif %}
    </div>
    {% if price != blank %}
      <div class="editorial-slideshow__product-price">
        <span class="editorial-slideshow__product-price-label">{{ block.settings.price_label | escape }}</span>
        <span class="editorial-slideshow__product-price-value">{% if variant != blank %}{% render 'money', amount: price %}{% else %}{{ price | escape }}{% endif %}</span>
      </div>
    {% endif %}
    {% if block.settings.cta_label != blank %}<a class="editorial-slideshow__product-link btn-{{ block.settings.button_style }}" href="{{ cta_url | escape }}"><span>{{ block.settings.cta_label | escape }}</span><span class="button__icon" aria-hidden="true">{% render 'icon', name: 'button-arrow' %}</span></a>{% endif %}
  </aside>
{% endif %}

{% schema %}
{
  "name": "Editorial product card",
  "tag": null,
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "title", "label": "Product title" },
    { "type": "text", "id": "meta", "label": "Product meta" },
    { "type": "text", "id": "price_label", "label": "Price label" },
    { "type": "text", "id": "price", "label": "Product price", "info": "Used when no product is selected." },
    { "type": "text", "id": "cta_label", "label": "Button label", "info": "Links to the selected product, or All products when no product is selected." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
