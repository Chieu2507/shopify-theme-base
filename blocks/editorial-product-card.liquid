{% liquid
  assign product = block.settings.product
  assign variant = product.selected_or_first_available_variant
  assign title = block.settings.title | default: product.title
  assign product_url = product.url
  assign cta_url = product_url | default: routes.all_products_collection_url
  assign price = block.settings.price
  if variant != blank
    assign price = variant.price
  endif
%}

{% if title != blank or product != blank %}
  <aside class="editorial-slideshow__product-card color-scheme color-{{ block.settings.color_scheme.id }} block-animation" style="--block-animation-delay: {{ block.settings.animation_delay | default: 0 }}ms;" data-block-animation="{{ block.settings.animation_type | default: 'fade_up' }}" aria-label="{{ title | escape }}" {{ block.shopify_attributes }}>
    <div class="editorial-slideshow__product-copy">
      {% if product_url != blank %}<a class="editorial-slideshow__product-title" href="{{ product_url }}">{{ title | escape }}</a>{% else %}<span class="editorial-slideshow__product-title">{{ title | escape }}</span>{% endif %}
      {% if block.settings.meta != blank %}<span class="editorial-slideshow__product-meta">{{ block.settings.meta | escape }}</span>{% endif %}
    </div>
    {% if price != blank %}
      <div class="editorial-slideshow__product-price">
        <span class="editorial-slideshow__product-price-label">{{ block.settings.price_label | escape }}</span>
        <span class="editorial-slideshow__product-price-value">{% if variant != blank %}{% render 'money', amount: price %}{% else %}{{ price | escape }}{% endif %}</span>
      </div>
    {% endif %}
    {% if block.settings.cta_label != blank %}<a class="editorial-slideshow__product-link button button--{{ block.settings.button_style }}" href="{{ cta_url }}"><span>{{ block.settings.cta_label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}
  </aside>
{% endif %}

{% schema %}
{
  "name": "Editorial product card",
  "tag": null,
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "title", "label": "Product title", "default": "The Nocturne Collar" },
    { "type": "text", "id": "meta", "label": "Product meta", "default": "CUSHION-CUT · 22.4 CT · ONE OF ONE" },
    { "type": "text", "id": "price_label", "label": "Price label", "default": "PRICE" },
    { "type": "text", "id": "price", "label": "Product price", "default": "$8,600", "info": "Used when no product is selected." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "VIEW PRODUCT", "info": "Links to the selected product, or All products when no product is selected." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:typography_blocks.animation"
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "t:typography_blocks.type",
      "options": [
        { "value": "none", "label": "t:typography_options.none" },
        { "value": "fade_in", "label": "t:typography_options.fade_in" },
        { "value": "fade_up", "label": "t:typography_options.fade_up" },
        { "value": "slide_in_left", "label": "t:typography_options.slide_in_left" },
        { "value": "slide_in_right", "label": "t:typography_options.slide_in_right" },
        { "value": "zoom_in", "label": "t:typography_options.zoom_in" },
        { "value": "zoom_out", "label": "t:typography_options.zoom_out" }
      ],
      "default": "fade_up"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "label": "t:typography_blocks.animation_delay",
      "min": 0,
      "max": 1000,
      "step": 25,
      "unit": "ms",
      "default": 0,
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    }
  ]
}
{% endschema %}
