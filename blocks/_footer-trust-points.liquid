{% doc %}
  Renders the editable icon-with-text trust points inside the footer.
{% enddoc %}

<div class="footer__trust-points" data-reveal-group {{ block.shopify_attributes }}>
  <div class="footer__trust-points-list" role="list">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Icon with text",
  "tag": null,
  "blocks": [
    { "type": "footer-trust-point" }
  ],
  "settings": []
}
{% endschema %}
