<div class="comparison-table__row-value" {{ block.shopify_attributes }}>
  {% render 'comparison-table-value', type: block.settings.type, text: block.settings.text, feature_id: feature_id, product_id: product_id, value_id: value_id %}
</div>
{% stylesheet %}
  .comparison-table__row-value { display: contents; }
{% endstylesheet %}
{% schema %}
{
  "name": "Row value",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "column_key",
      "label": "Column key",
      "info": "Match the key shown in the product column settings.",
      "default": "product-1"
    },
    {
      "type": "select",
      "id": "type",
      "label": "Value type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        },
        {
          "value": "text",
          "label": "Text"
        }
      ],
      "default": "yes"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "visible_if": "{{ block.settings.type == 'text' }}"
    }
  ],
  "presets": [
    {
      "name": "Row value"
    }
  ]
}
{% endschema %}
