{% doc %}
  Renders the grouped house signature content for the footer.

  @example
  {% content_for 'block', type: '_footer-signature', id: 'signature' %}
{% enddoc %}

<section class="footer__signature" {{ block.shopify_attributes }}>
  <div class="footer__eyebrow footer__signature-eyebrow">
    {% content_for 'block', type: 'heading', id: 'signature_eyebrow' %}
  </div>

  <div class="footer__signature-main">
    <footer-wordmark class="footer__wordmark" data-footer-wordmark>
      {% content_for 'block', type: 'heading', id: 'signature_wordmark' %}
    </footer-wordmark>

    <div class="footer__principles">
      <span class="footer__principles-ornament" aria-hidden="true">
        {{ 'footer-house-mark-large.svg' | inline_asset_content }}
      </span>
      {% content_for 'block', type: 'heading', id: 'signature_principles' %}
    </div>
  </div>

  <div class="footer__signature-tagline">
    {% content_for 'block', type: 'heading', id: 'signature_tagline' %}
  </div>
</section>

{% schema %}
{
  "name": "House signature",
  "tag": null,
  "blocks": [
    { "type": "heading" }
  ],
  "settings": []
}
{% endschema %}
