{
  "type": "footer",
  "name": "Footer group",
  "sections": {
    "footer": {
      "type": "footer",
      "blocks": {
        "newsletter": {
          "type": "newsletter",
          "settings": {
            "heading": "The Carry Note",
            "heading_size": "h3",
            "heading_tag": "h2",
            "text": "<p>New silhouettes, considered styling and practical care notes.</p>",
            "text_size": "medium",
            "placeholder": "Enter your email",
            "button_label": "Subscribe",
            "disclaimer": "<p>By subscribing, you agree to receive Noryvelle updates. Review our <a href=\"/policies/privacy-policy\">Privacy Policy</a>; unsubscribe at any time.</p>",
            "facebook_url": "",
            "instagram_url": "",
            "pinterest_url": "",
            "tiktok_url": ""
          }
        },
        "explore": {
          "type": "menu",
          "settings": {
            "heading": "Explore",
            "heading_size": "h4",
            "heading_tag": "h3",
            "menu": "footer"
          }
        },
        "wordmark": {
          "type": "wordmark",
          "settings": {
            "text": "Noryvelle"
          }
        },
        "copyright": {
          "type": "copyright",
          "settings": {
            "text": "All Rights Reserved"
          }
        },
        "localization": {
          "type": "localization",
          "settings": {
            "show_country_selector": true,
            "show_language_selector": true
          }
        },
        "legal": {
          "type": "legal_menu",
          "settings": {
            "menu": ""
          }
        },
        "payments": {
          "type": "payments",
          "settings": {
            "show_payment_icons": true
          }
        }
      },
      "block_order": [
        "newsletter",
        "explore",
        "wordmark",
        "copyright",
        "localization",
        "legal",
        "payments"
      ],
      "settings": {
        "column_gap": 48,
        "section_width": "page",
        "padding_top": 64,
        "padding_bottom": 64,
        "color_scheme": "scheme-2"
      }
    },
    "offer_flyout": {
      "type": "offer-flyout",
      "disabled": true,
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "A private welcome",
            "heading_size": "h3",
            "heading_tag": "h3",
            "alignment": "left"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Enjoy a welcome credit on your first selected piece.</p>",
            "text_size": "small",
            "dim_text": false
          }
        },
        "promo_code": {
          "type": "promo_code",
          "settings": {
            "code": "WELCOME10",
            "button_label": "Copy",
            "copied_label": "Copied"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "promo_code"
      ],
      "settings": {
        "scroll_trigger": "75",
        "frequency": "always",
        "home_only": true,
        "hide_for_customers": true,
        "panel_position": "right",
        "center_text": false,
        "show_image_mobile": false,
        "image_ratio": "original",
        "image_link": "",
        "image_new_tab": false,
        "enable_sticky_tab": true,
        "tab_label": "Private offer",
        "tab_position": "left-center",
        "invert_tab_colors": true,
        "color_scheme": "scheme-2"
      }
    }
  },
  "order": [
    "footer",
    "offer_flyout"
  ]
}
