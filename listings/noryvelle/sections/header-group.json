{
  "type": "header",
  "name": "Header group",
  "sections": {
    "announcement_bar": {
      "type": "announcement-bar",
      "blocks": {
        "shipping": {
          "type": "text_slide",
          "settings": {
            "text": "Complimentary shipping on orders over $250"
          }
        },
        "returns": {
          "type": "text_slide",
          "settings": {
            "text": "Returns accepted within 14 days"
          }
        }
      },
      "block_order": [
        "shipping",
        "returns"
      ],
      "settings": {
        "text_behavior": "rotate",
        "autoplay_interval": 5,
        "navigator_style": "arrows",
        "font_weight": "400",
        "height_desktop": 41,
        "height_mobile": 37,
        "section_width": "full",
        "color_scheme": "scheme-3"
      }
    },
    "header": {
      "type": "header",
      "blocks": {
        "logo": {
          "type": "logo",
          "settings": {
            "text": "Noryvelle",
            "width_desktop": 130,
            "width_mobile": 120
          }
        },
        "shop_mega_menu": {
          "type": "mega_menu",
          "settings": {
            "menu_item": "Bags",
            "menu": "",
            "column_heading": "Shop by silhouette",
            "columns": "3"
          }
        },
        "shop_promo_new": {
          "type": "mega_menu_promo",
          "settings": {
            "menu_item": "Bags",
            "image": "shopify://shop_images/noryvelle-aster-work-tote-espresso-front.png",
            "heading": "New arrivals",
            "heading_size": "h4",
            "heading_tag": "h3",
            "text": "The latest silhouettes, designed around the way you move.",
            "link_label": "SHOP NEW ARRIVALS",
            "link": "shopify://collections/new-arrivals"
          }
        },
        "shop_promo_edit": {
          "type": "mega_menu_promo",
          "settings": {
            "menu_item": "Bags",
            "image": "shopify://shop_images/noryvelle-celeste-mini-bag-champagne-front.png",
            "heading": "The Noryvelle Edit",
            "heading_size": "h4",
            "heading_tag": "h3",
            "text": "A considered selection for workdays, evenings and journeys.",
            "link_label": "EXPLORE THE EDIT",
            "link": "shopify://collections/the-noryvelle-edit"
          }
        }
      },
      "block_order": [
        "logo",
        "shop_mega_menu",
        "shop_promo_new",
        "shop_promo_edit"
      ],
      "settings": {
        "menu": "main-menu",
        "gift_atelier_menu_item": "",
        "sticky_behavior": "always",
        "enable_transparent_header": true,
        "transparent_color_scheme": "scheme-3",
        "show_border": false,
        "height_desktop": 84,
        "height_mobile": 60,
        "mega_menu_animation": "slide_down",
        "mega_menu_animation_duration": 250,
        "show_search": true,
        "show_localization": true,
        "show_country_flag": true,
        "show_account": true,
        "show_cart": true,
        "section_width": "full",
        "color_scheme": "scheme-1"
      }
    }
  },
  "order": [
    "announcement_bar",
    "header"
  ]
}
